// Std imports
import "std/os/os";
import "std/data/vector";
import "std/os/process";
import "std/text/analysis";
import "std/os/env";
import "std/io/file";
import "std/io/filepath";
import "std/iterator/array-iterator";

// Own imports
import "bootstrap/driver";
import "bootstrap/exception/compiler-error";
import "bootstrap/exception/linker-error";

public type ExecResult struct {
    public String output
    public int exitCode
}

public type ExternalBinaryFinderResult struct {
    public string name
    public String path
}

/**
 * Execute an external program without involving a shell.
 *
 * Each argument is passed verbatim to the program (via std/os/process), so file paths and other arguments can never be
 * interpreted as shell syntax. This is the safe variant that must be used for any command whose arguments are
 * influenced by (untrusted) user input, e.g. the linker invocation.
 *
 * @param program Name or path of the program to execute (resolved against PATH if it is a bare name)
 * @param args Arguments passed to the program (without argv[0], which is added automatically)
 * @param redirectStdErrToStdOut Capture stderr into the returned output alongside stdout
 * @return Result struct with the captured output and the process exit code
 */
public f<ExecResult> exec(const String& program, const Vector<String>& args, bool redirectStdErrToStdOut = false) {
    Result<ProcessResult> processResult = runProcessCaptured(program, args, redirectStdErrToStdOut);
    if processResult.isErr() {
        const String message = "Failed to execute '" + program + "'";
        const CompilerError error = CompilerError(CompilerErrorType::IO_ERROR, message.getRaw());
        const String& errorMessage = error.getMessage();
        panic(Error(errorMessage.getRaw()));
    }
    const ProcessResult& process = processResult.unwrap();
    return ExecResult{process.output, process.exitCode};
}

/**
 * Execute an external binary, inheriting the parent's standard streams.
 * Unlike exec(), this does not capture the child's output: its stdin, stdout and stderr are connected directly to ours,
 * so the program behaves as if invoked from the terminal.
 *
 * @param executablePath Path to the executable to run
 * @return Exit code of the executed binary
 */
public f<int> run(const String& executablePath) {
    const Vector<String> noArgs;
    Result<int> exitCode = runProcess(executablePath, noArgs);
    if exitCode.isErr() {
        const String message = "Failed to execute: " + executablePath;
        const CompilerError error = CompilerError(CompilerErrorType::IO_ERROR, message.getRaw());
        const String& errorMessage = error.getMessage();
        panic(Error(errorMessage.getRaw()));
    }
    return exitCode.unwrap();
}

/**
 * Render a program invocation as a human-readable command string. Used for debug output and error messages only - the
 * actual execution happens via an argument vector (no shell), so this rendering is never executed.
 *
 * @param program Program to execute
 * @param args Arguments for the program
 * @return Command string
 */
public f<String> renderCommandForDisplay(const String& program, const Vector<String>& args) {
    String command = program;
    foreach const String& arg : args {
        command += " ";
        command += arg;
    }
    return command;
}

/**
 * Expand a linker flag that may contain environment-variable references ('$VAR' on Unix, '%VAR%' on Windows) or a
 * backtick-quoted command substitution (e.g. "`pkg-config --cflags --libs libcurl`"), mirroring what a shell would have
 * done for these flags. Std bindings rely on both forms (see e.g. std/bindings/llvm/linker-flags.spice and
 * std/bindings/libcurl/libcurl.spice).
 *
 * Unlike a shell, only these two specific substitutions are recognized, and the backtick-quoted command is executed
 * directly (argv-based, whitespace-split) rather than through a shell - no other shell metacharacters (';', '&&', pipes,
 * redirects, quoting, globbing, ...) are interpreted, so this cannot be used to inject additional commands.
 *
 * A plain env-var reference can itself expand to several whitespace-separated flags (e.g. LLVM_INCLUDE_DIRS is set to
 * "-I<dir1> -I<dir2>" by CMake/CI). Since there is no shell to word-split the expanded text, it is split explicitly, so
 * each flag becomes its own argv entry.
 *
 * @param flag Raw linker flag, as configured via a 'core.[os.]linker.flag' attribute
 * @return One or more expanded flags (an expansion can result in several whitespace-separated flags)
 */
public f<Vector<String>> expandLinkerFlag(const String& flag) {
    // Expand environment variable references within the flag ('$VAR' on Unix, '%VAR%' on Windows)
    String expanded;
    unsigned long i = 0l;
    while i < flag.getLength() {
        const char c = flag[i];
        if isWindows() && c == '%' {
            const long end = flag.find('%', i + 1l);
            if end >= 0l {
                const String varName = flag.getSubstring(i + 1l, cast<long>(cast<unsigned long>(end) - i - 1l));
                Result<string> value = getEnv(varName.getRaw());
                if value.isOk() {
                    expanded += value.unwrap();
                }
                i = cast<unsigned long>(end) + 1l;
                continue;
            }
        } else if !isWindows() && c == '$' {
            unsigned long j = i + 1l;
            while j < flag.getLength() && isAlphaNumUnderscore(flag[j]) {
                j++;
            }
            if j > i + 1l {
                const String varName = flag.getSubstring(i + 1l, cast<long>(j - i - 1l));
                Result<string> value = getEnv(varName.getRaw());
                if value.isOk() {
                    expanded += value.unwrap();
                }
                i = j;
                continue;
            }
        }
        expanded += c;
        i++;
    }

    // Backtick command substitution: recognized when the *entire* (env-expanded) flag is a single backtick-quoted command,
    // matching existing std bindings usage. The command is split on whitespace and executed directly (no shell), so shell
    // metacharacters inside the backticks are not interpreted.
    if expanded.getLength() >= 2l && expanded[0l] == '`' && expanded[expanded.getLength() - 1l] == '`' {
        const String innerCommand = expanded.getSubstring(1l, cast<long>(expanded.getLength() - 2l));
        Vector<String> tokens = splitAtWhitespace(innerCommand);
        if tokens.isEmpty() {
            return Vector<String>();
        }
        const String program = tokens.front();
        Vector<String> cmdArgs;
        for unsigned long k = 1l; k < tokens.getSize(); k++ {
            cmdArgs.pushBack(tokens.get(k));
        }
        const ExecResult cmdResult = exec(program, cmdArgs);
        if cmdResult.exitCode != 0 {                                                                // LCOV_EXCL_LINE
            const String message = "Command substitution for linker flag failed: " + innerCommand;  // LCOV_EXCL_LINE
            const LinkerError error = LinkerError(LinkerErrorType::LINKER_ERROR, message.getRaw()); // LCOV_EXCL_LINE
            panic(Error(error.errorMessage.getRaw()));                                              // LCOV_EXCL_LINE
        }                                                                                           // LCOV_EXCL_LINE
        expanded = cmdResult.output;
    }

    // Word-split the (possibly command-substituted) text on whitespace, so an expansion that contains several flags (e.g. a
    // multi-directory LLVM_INCLUDE_DIRS, or a pkg-config command's output) ends up as separate argv entries.
    return splitAtWhitespace(expanded);
}

/**
 * Split a string at whitespace, dropping empty parts
 *
 * @param input Input string
 * @return Non-empty parts
 */
f<Vector<String>> splitAtWhitespace(const String& input) {
    Vector<String> parts;
    String current;
    for unsigned long i = 0l; i < input.getLength(); i++ {
        const char c = input[i];
        if c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\v' || c == '\f' {
            if !current.isEmpty() {
                parts.pushBack(current);
                current = String();
            }
        } else {
            current += c;
        }
    }
    if !current.isEmpty() {
        parts.pushBack(current);
    }
    return parts;
}

/**
 * Checks if a certain command is available on the computer
 *
 * @param cmd Command to search for
 * @return Present or not
 */
public f<bool> isCommandAvailable(const string cmd) {
    // Look the program up on PATH without spawning a shell ('which'/'where')
    const String programPath = findProgram(String(cmd));
    return !programPath.isEmpty();
}

/**
 * Checks if Graphviz is installed on the system
 *
 * @return Present or not
 */
public f<bool> isGraphvizInstalled() {
    return isCommandAvailable("dot");
}

/**
 * Search for a supported linker invoker on the system and return the executable name or path.
 * This function may throw a LinkerError if no linker invoker is found.
 *
 * @return Name of path to the linker invoker executable
 */
public f<ExternalBinaryFinderResult> findLinkerInvoker() {
    foreach const string linkerInvoker : ["clang", "gcc"] {
        if isUnixBased() {
            foreach const string path : ["/usr/bin/", "/usr/local/bin/", "/bin/"] {
                const String linkerInvokerPath = path + linkerInvoker;
                if fileExists(linkerInvokerPath.getRaw()) {
                    return ExternalBinaryFinderResult{linkerInvoker, linkerInvokerPath};
                }
            }
        } else if isWindows() {
            if isCommandAvailable(linkerInvoker) {
                return ExternalBinaryFinderResult{linkerInvoker, String(linkerInvoker)};
            }
        } else {
            panic(Error("Unsupported platform"));
        }
    }
    const LinkerError error = LinkerError(LinkerErrorType::LINKER_INVOKER_NOT_FOUND, "No supported linker invoker was found on the system. Supported are: clang and gcc");
    panic(Error(error.errorMessage.getRaw()));
}

/**
 * Search for a supported linker on the system and return the executable name or path.
 * This function may throw a LinkerError if no linker is found.
 *
 * @return Name of path to the linker executable
 */
public f<ExternalBinaryFinderResult> findLinker(const CliOptions& cliOptions) {
    if isUnixBased() {
        // Use the flavor-specific lld driver, since the generic 'lld' driver refuses to be invoked directly
        foreach const string linkerName : ["mold", "ld.lld", "ld64.lld", "gold", "ld"] {
            // mold does only support linking for unix and darwin
            if linkerName == "mold" && cliOptions.targetTriple.isOSWindows() {
                continue;
            }
            foreach const string path : ["/usr/bin/", "/usr/local/bin/", "/bin/"] {
                String linkerPath = path + linkerName;
                if fileExists(linkerPath.getRaw()) {
                    return ExternalBinaryFinderResult{linkerName, linkerPath};
                }
            }
        }
    } else if isWindows() {
        foreach const string linkerName : ["lld", "ld"] {
            if isCommandAvailable(linkerName) {
                return ExternalBinaryFinderResult{linkerName, String(linkerName)};
            }
        }
    } else {
        panic(Error("Unsupported platform"));
    }
    const LinkerError error = LinkerError(LinkerErrorType::LINKER_NOT_FOUND, "No supported linker was found on the system. Supported are: mold, lld, gold and ld");
    panic(Error(error.errorMessage.getRaw()));
}

/**
 * Search for a supported archiver on the system and return the executable name or path.
 * This function may throw a LinkerError if no archiver is found.
 *
 * @return Name or path to the archiver executable
 */
public f<ExternalBinaryFinderResult> findArchiver() {
    if isUnixBased() {
        foreach const string archiverName : ["llvm-ar", "gcc-ar", "ar"] {
            foreach const string path : ["/usr/bin/", "/usr/local/bin/", "/bin/"] {
                String archiverPath = path + archiverName;
                if fileExists(archiverPath.getRaw()) {
                    return ExternalBinaryFinderResult{archiverName, archiverPath};
                }
            }
        }
    } else if isWindows() {
        foreach const string archiverName : ["llvm-lib", "lib"] {
            if isCommandAvailable(archiverName) {
                return ExternalBinaryFinderResult{archiverName, String(archiverName)};
            }
        }
    } else {
        panic(Error("Unsupported platform"));
    }
    const LinkerError error = LinkerError(LinkerErrorType::ARCHIVER_NOT_FOUND, "No supported archiver was found on the system. Supported are: llvm-ar and ar");
    panic(Error(error.errorMessage.getRaw()));
}

/**
 * Retrieve the dir, where the standard library lives, without failing if it is not installed.
 *
 * @return Std directory, or an empty path if the std was not found
 */
public f<FilePath> findStdDir() {
    if isUnixBased() {
        result = FilePath("/usr/lib/spice/std/");
        if result.exists() { return; }
    }
    Result<string> value = getEnv("SPICE_STD_DIR");
    if value.isOk() {
        result = FilePath(value.unwrap());
        if result.exists() { return; }
    }
    return FilePath();
}

/**
 * Retrieve the dir, where the standard library lives.
 *
 * @return Std directory
 */
public f<FilePath> getStdDir() {
    result = findStdDir();
    if result.isEmpty() {
        const CompilerError error = CompilerError(CompilerErrorType::STD_NOT_FOUND, "Standard library could not be found. Check if the env var SPICE_STD_DIR exists");
        const String& message = error.getMessage();
        panic(Error(message.getRaw()));
    }
}

/**
 * Retrieve the dir, where the std ships the static support libraries that Spice programs link against - currently only the
 * vendored libbacktrace. Missing rather than found is a perfectly normal outcome, hence an empty path instead of a panic.
 *
 * @return Std runtime library directory, or an empty path if there is none
 */
public f<FilePath> getStdRuntimeLibDir() {
    const FilePath stdDir = findStdDir();
    if stdDir.isEmpty() {
        return FilePath();
    }
    result = stdDir / "runtime" / "lib";
    if !result.exists() {
        return FilePath();
    }
}

/**
 * Build the flags for the std TPDE bindings (std/bindings/tpde) from the TPDE headers and static libraries, that the Linux
 * release packages ship with the std. Returns an empty string if the given std does not ship them.
 *
 * @param stdDir Std directory
 * @return Value for the TPDE_FLAGS env var, or an empty string
 */
public f<String> getStdTPDEFlags(const FilePath& stdDir) {
    const FilePath tpdeDir = stdDir / "bindings" / "tpde";
    const FilePath includeDir = tpdeDir / "include";
    const FilePath libDir = tpdeDir / "lib";
    FilePath headerPath = includeDir / "tpde-llvm" / "LLVMCompiler.hpp";
    FilePath tpdeLlvmLibPath = libDir / "libtpde_llvm.a";
    if !headerPath.exists() || !tpdeLlvmLibPath.exists() {
        return String();
    }
    // The libraries reference each other, so they go into a group, that the linker rescans until all references are resolved
    result = String("-I") + includeDir.toString() + " -Wl,--start-group";
    foreach const string libName : ["libtpde_llvm.a", "libtpde.a", "libfadec.a", "libdisarm64.a", "libspdlog.a"] {
        FilePath libPath = libDir / libName;
        if libPath.exists() {
            result += " ";
            result += libPath.toString();
        }
    }
    result += " -Wl,--end-group";
}

/**
 * Point the std TPDE bindings to the TPDE headers and libraries, that the std ships, unless TPDE_FLAGS is set already.
 * The bindings only use TPDE on Linux, and the shipped libraries are built for the host, so this only applies to native
 * builds on Linux. Has to be called before the compilation starts, because it changes the process environment.
 *
 * @param cliOptions Command line options
 */
public p exportStdTPDEFlags(const CliOptions& cliOptions) {
    if !isLinux() || !cliOptions.isNativeTarget {
        return;
    }
    const Result<string> existingFlags = getEnv("TPDE_FLAGS");
    if existingFlags.isOk() {
        return;
    }
    const FilePath stdDir = findStdDir();
    if stdDir.isEmpty() {
        return;
    }
    const String flags = getStdTPDEFlags(stdDir);
    if !flags.isEmpty() {
        const bool exported = setEnv("TPDE_FLAGS", flags.getRaw());
        assert exported;
    }
}

/**
 * Retrieve the dir, where the bootstrap compiler lives.
 *
 * @return Bootstrap compiler directory
 */
public f<FilePath> getBootstrapCompilerDir() {
    Result<string> value = getEnv("SPICE_BOOTSTRAP_DIR");
    if value.isOk() {
        result = FilePath(value.unwrap());
        if result.exists() { return; }
    }
    const CompilerError error = CompilerError(CompilerErrorType::BOOTSTRAP_NOT_FOUND, "Bootstrap compiler could not be found. Check if the env var SPICE_BOOTSTRAP_DIR exists");
    const String& message = error.getMessage();
    panic(Error(message.getRaw()));
}

/**
 * Check if the given target triple has a Darwin based OS. Mirrors llvm::Triple::isOSDarwin(): macOS, iOS (incl. tvOS),
 * watchOS, DriverKit, visionOS, bridgeOS and Apple firmware.
 *
 * @param triple Target triple
 * @return Darwin based or not
 */
f<bool> isDarwinTriple(const String& triple) {
    const string[9] darwinOsNames = ["darwin", "macos", "ios", "tvos", "watchos", "driverkit", "xros", "visionos", "bridgeos"];
    for unsigned int i = 0; i < len(darwinOsNames); i++ {
        if triple.contains(darwinOsNames[i]) {
            return true;
        }
    }
    return triple.contains("apple") && triple.contains("firmware");
}

/**
 * Retrieve the file extension of the output file for a certain output container. It depends on the target, which is derived
 * from the target triple. As long as there is none yet, e.g. because the cli options are not enriched yet, the host is assumed.
 *
 * @param cliOptions Cli options
 * @param outputContainer Output container
 * @return File extension without the leading dot
 */
public f<string> getOutputFileExtension(const CliOptions& cliOptions, OutputContainer outputContainer) {
    // Extensions per output container: executable, object file, static library and shared library
    const string[4] extensionsWasm = ["wasm", "o", "a", "so"];
    const string[4] extensionsMacos = ["", "o", "a", "dylib"];
    const string[4] extensionsWindows = ["exe", "obj", "lib", "dll"];
    const string[4] extensionsLinux = ["", "o", "a", "so"];

    const String triple = String(cliOptions.targetTriple.value);
    if triple.isEmpty() {
        if isWindows() {
            return extensionsWindows[outputContainer];
        } else if isMacOS() {
            return extensionsMacos[outputContainer];
        }
        return extensionsLinux[outputContainer];
    }

    if triple.startsWith("wasm") {
        return extensionsWasm[outputContainer];
    }
    if isDarwinTriple(triple) {
        return extensionsMacos[outputContainer];
    }
    if triple.contains("windows") || triple.contains("win32") || triple.contains("mingw") || triple.contains("cygwin") {
        return extensionsWindows[outputContainer];
    }
    return extensionsLinux[outputContainer];
}

/**
 * Retrieve the dir, where output binaries should go when installing them
 *
 * @return Installation directory
 */
public f<FilePath> getSpiceBinDir() {
    if isWindows() {
        Result<string> userprofile = getEnv("USERPROFILE");
        return FilePath(userprofile.unwrap()) / "spice" / "bin";
    } else if isUnixBased() {
        return FilePath("/usr/local/bin");
    } else {
        panic(Error("Unsupported platform"));
    }
}