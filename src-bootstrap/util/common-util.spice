// Std imports
import "std/text/stringstream";
import "std/bindings/llvm/llvm" as llvm;
import "std/text/json/json-value";
import "std/time/time";
import "std/type/type-conversion";

// External functions
ext f<int> memcmp(string, string, unsigned long);
ext f<int> snprintf(char*, unsigned long, string, ...);

/**
 * Split the given haystack by the needle and return the last fragment
 *
 * @param haystack Input string
 * @param needle String to search
 * @return Last fragment
 */
public f<String> getLastFragment(const String &haystack, const string needle) {
    const unsigned long index = haystack.rfind(needle);
    return index != -1l ? haystack.getSubstring(index + getRawLength(needle)) : haystack;
}

// Which compiler implementation this is. Tells the self-hosted compiler (src-bootstrap/) and the host compiler (src/) apart
public const string COMPILER_IMPLEMENTATION = "self-hosted";

/**
 * Generate the version info string for the Spice driver
 *
 * @return Version info string
 */
public f<String> buildVersionInfo() {
    const string version = __get_build_var<string>("SPICE_VERSION", "dev");
    const string targetOs = __get_build_var<string>("SPICE_TARGET_OS", "dev");
    const string targetArch = __get_build_var<string>("SPICE_TARGET_ARCH", "dev");
    const string gitHash = __get_build_var<string>("SPICE_GIT_HASH", "dev");
    const string builtBy = __get_build_var<string>("SPICE_BUILT_BY", "dev");

    StringStream versionString;
    versionString << "Spice version: " << version << " " << targetOs << "/" << targetArch << endl();
    versionString << "Compiler:      " << COMPILER_IMPLEMENTATION << endl();
    versionString << "Git hash:      " << gitHash << endl();
    versionString << "LLVM version:  " << llvm::getVersionString() << endl();
    versionString << "built by:      " << builtBy << endl() << endl();
    versionString << "(c) Marc Auberer 2021-" << toString(getCurrentYear());
    return versionString.str();
}

/**
 * Checks if the first string sorts lexicographically before the second one. This compares byte-wise, like the comparison
 * operators of std::string in the host compiler.
 *
 * @param lhs First string
 * @param rhs Second string
 * @return Sorts before or not
 */
public f<bool> isStringLess(const String& lhs, const String& rhs) {
    const unsigned long lhsLength = lhs.getLength();
    const unsigned long rhsLength = rhs.getLength();
    const unsigned long commonLength = lhsLength < rhsLength ? lhsLength : rhsLength;
    if commonLength > 0l {
        const int comparison = memcmp(lhs.getRaw(), rhs.getRaw(), commonLength);
        if comparison != 0 {
            return comparison < 0;
        }
    }
    return lhsLength < rhsLength;
}

/**
 * Add a field to a JSON object, keeping the fields sorted by key. This mirrors 'json[key] = value' in the host compiler,
 * where nlohmann::json stores the fields of an object in a map, sorted by key.
 * The object takes ownership of the heap-allocated field value.
 *
 * @param object JSON object
 * @param key Field key
 * @param value Field value
 */
public p setJsonField(JsonValue* object, const String& key, JsonValue* value) {
    const unsigned long size = object.getObjectSize();
    unsigned long idx = 0l;
    while idx < size && isStringLess(object.getObjectKey(idx), key) {
        idx++;
    }
    assert idx == size || object.getObjectKey(idx) != key; // Overwriting fields is not supported
    object.insertObjectField(idx, key, value);
}
