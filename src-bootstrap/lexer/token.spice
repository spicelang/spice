// Imports
import "bootstrap/reader/code-loc";

// Enums
public type TokenType enum {
    INVALID = 0,
    // Keyword tokens
    TYPE_DOUBLE = 1,
    TYPE_INT = 2,
    TYPE_SHORT = 3,
    TYPE_LONG = 4,
    TYPE_BYTE = 5,
    TYPE_CHAR = 6,
    TYPE_STRING = 7,
    TYPE_BOOL = 8,
    TYPE_DYN = 9,
    CONST = 10,
    SIGNED = 11,
    UNSIGNED = 12,
    INLINE = 13,
    PUBLIC = 14,
    HEAP = 15,
    COMPOSE = 16,
    F = 17,
    P = 18,
    IF = 19,
    ELSE = 20,
    SWITCH = 21,
    CASE = 22,
    DEFAULT = 23,
    ASSERT = 24,
    FOR = 25,
    FOREACH = 26,
    DO = 27,
    WHILE = 28,
    IMPORT = 29,
    BREAK = 30,
    CONTINUE = 31,
    FALLTHROUGH = 32,
    RETURN = 33,
    AS = 34,
    STRUCT = 35,
    INTERFACE = 36,
    UNION = 37,
    TYPE = 38,
    ENUM = 39,
    OPERATOR = 40,
    ALIAS = 41,
    UNSAFE = 42,
    NIL = 43,
    MAIN = 44,
    EXT = 45,
    CAST = 46,
    TRUE = 47,
    FALSE = 48,
    // Operator tokens
    LBRACE = 49,
    RBRACE = 50,
    LPAREN = 51,
    RPAREN = 52,
    LBRACKET = 53,
    RBRACKET = 54,
    LOGICAL_OR = 55,
    LOGICAL_AND = 56,
    BITWISE_OR = 57,
    BITWISE_XOR = 58,
    BITWISE_AND = 59,
    PLUS_PLUS = 60,
    MINUS_MINUS = 61,
    PLUS_EQUAL = 62,
    MINUS_EQUAL = 63,
    MUL_EQUAL = 64,
    DIV_EQUAL = 65,
    REM_EQUAL = 66,
    SHL_EQUAL = 67,
    SHR_EQUAL = 68,
    AND_EQUAL = 69,
    OR_EQUAL = 70,
    XOR_EQUAL = 71,
    PLUS = 72,
    MINUS = 73,
    MUL = 74,
    DIV = 75,
    REM = 76,
    NOT = 77,
    BITWISE_NOT = 78,
    GREATER = 79,
    LESS = 80,
    GREATER_EQUAL = 81,
    LESS_EQUAL = 82,
    SHL = 83,
    SHR = 84,
    EQUAL = 85,
    NOT_EQUAL = 86,
    ASSIGN = 87,
    QUESTION_MARK = 88,
    SEMICOLON = 89,
    COLON = 90,
    COMMA = 91,
    DOT = 92,
    ARROW = 93,
    SCOPE_ACCESS = 94,
    ELLIPSIS = 95,
    FCT_ATTR_PREAMBLE = 96,
    MOD_ATTR_PREAMBLE = 97,
    // Regex tokens
    DOUBLE_LIT = 98,
    INT_LIT = 99,
    SHORT_LIT = 100,
    LONG_LIT = 101,
    CHAR_LIT = 102,
    STRING_LIT = 103,
    IDENTIFIER = 104,
    TYPE_IDENTIFIER = 105,
    // Skipped tokens
    DOC_COMMENT = 106,
    BLOCK_COMMENT = 107,
    LINE_COMMENT = 108,
    EOF = 109
}

public type Token struct {
    public TokenType tokenType
    public String text
    public CodeLoc codeLoc
    public unsigned long startOffset = 0l // Offset of the first char of the token within the source code
    public unsigned long endOffset = 0l // Offset after the last char of the token within the source code
}

public p Token.ctor(TokenType tokenType) {
    this.tokenType = tokenType;
}

public p Token.ctor(TokenType tokenType, const String& text, const CodeLoc& codeLoc) {
    this.tokenType = tokenType;
    this.text = text;
    this.codeLoc = codeLoc;
}

public p Token.ctor(TokenType tokenType, string text, const CodeLoc& codeLoc) {
    this.ctor(tokenType, String(text), codeLoc);
}

public p Token.ctor(const Token& other) {
    this.tokenType = other.tokenType;
    this.text = other.text;
    this.codeLoc = other.codeLoc;
    this.startOffset = other.startOffset;
    this.endOffset = other.endOffset;
}

// Copy assignment operator. Defining a copy constructor above suppresses the implicitly
// generated one, so we provide it explicitly to keep the 'text' String deeply copied.
public p operator=(Token& this, const Token& other) {
    this.tokenType = other.tokenType;
    this.text = other.text;
    this.codeLoc = other.codeLoc;
    this.startOffset = other.startOffset;
    this.endOffset = other.endOffset;
}

public p Token.print() {
    printf("Token(type=%d, text=\"%s\", line=%d, col: %d)\n", this.tokenType, this.text, this.codeLoc.line, this.codeLoc.col);
}

#[test, test.name="Token Smoke test"]
public f<bool> testTokenSmoke() {
    // Construct via type-only constructor
    Token t1 = Token(TokenType::PLUS);
    assert t1.tokenType == TokenType::PLUS;

    // Construct via full constructor (string overload)
    CodeLoc loc = CodeLoc(5l, 10l, "input.spice");
    Token t2 = Token(TokenType::IDENTIFIER, "myVar", loc);
    assert t2.tokenType == TokenType::IDENTIFIER;
    assert t2.text == "myVar";
    assert t2.codeLoc.line == 5l;
    assert t2.codeLoc.col == 10l;
    assert t2.codeLoc.sourceFilePath == "input.spice";

    // Construct via full constructor (String overload)
    Token t3 = Token(TokenType::STRING_LIT, String("hello"), loc);
    assert t3.tokenType == TokenType::STRING_LIT;
    assert t3.text == "hello";

    return true;
}