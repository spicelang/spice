// Std imports
import "std/type/types";
import "std/data/vector";
import "std/data/unordered-map";
import "std/data/pair";
import "std/time/timer";
import "std/io/filepath";
import "std/io/file";
import "std/os/system";
import "std/bindings/llvm/llvm" as llvm;
import "std/os/recursive-mutex";
import "std/math/hash";

// Own imports
import "bootstrap/ast/ast-nodes";
import "bootstrap/global/cache-manager";
import "bootstrap/global/runtime-module-manager";
import "bootstrap/global/type-name-disambiguator";
import "bootstrap/global/type-registry";
import "bootstrap/exception/error-manager";
import "bootstrap/linker/external-linker-interface";
import "bootstrap/model/function" as model; // Aliased, because Function clashes with llvm::Function
import "bootstrap/model/interface";
import "bootstrap/model/struct";
import "bootstrap/model/union";
import "bootstrap/typechecker/function-manager";
import "bootstrap/typechecker/interface-manager";
import "bootstrap/typechecker/struct-manager";
import "bootstrap/typechecker/union-manager";
import "bootstrap/util/lookup-cache";
import "bootstrap/util/compile-progress";
import "bootstrap/reader/code-loc";
import "bootstrap/util/memory";
import "bootstrap/util/block-allocator";
import "bootstrap/util/concurrency";
import "bootstrap/source-file";
import "bootstrap/driver";

// Constants
public const string MAIN_FILE_NAME = "root";
public const string LTO_FILE_NAME = "lto-module";

/**
 * The GlobalResourceManager is instantiated at startup of the compiler and serves as distribution point for globally used assets.
 * This component owns all SourceFile instances and AST nodes and therefore is the resource root of the compiler.
 * Other components of the compiler can request the required global resources from the GlobalResourceManager.
 */
public type GlobalResourceManager struct {
    public string cpuName = "generic"
    public string cpuFeatures = ""
    public llvm::LLVMContext ltoContext
    public llvm::Module ltoModule
    public DefaultMemoryManager memoryManager
    public Vector<String> compileTimeStringValues
    public BlockAllocator<ASTNode> astNodeAlloc // Used to allocate all AST nodes
    public UnorderedMap<long, unsigned long> nodeToNodeId // Maps the address of each AST node to its node id
    // The GlobalResourceManager owns all source files. They live in this pool (like the scopes in their parent scope), because
    // a map of owning 'heap' pointers cannot be instantiated: its iterator needs a reference to a heap pointer as field type
    BlockAllocator<SourceFile> sourceFileAlloc
    public UnorderedMap<String, SourceFile*> sourceFiles // Maps the file paths to the source files owned by the pool above
    public Vector<SourceFile*> sourceFilesInCreationOrder // For a deterministic order where it matters (e.g. the test main)
    String rootSourceFilePath // Path of the root source file, which the code locations are pretty-printed relative to
    public Vector<Pair<Struct*, bool>> pendingStructDefaultMemberDecisions
    public CliOptions& cliOptions
    public ExternalLinkerInterface linker
    public CacheManager cacheManager
    public RuntimeModuleManager runtimeModuleManager
    public TypeRegistry typeRegistry // Interns all types and hands out stable `const Type*` handles
    public TypeNameDisambiguator typeNameDisambiguator // Hands out disambiguation suffixes for same-named types
    // Wall times of the front end, middle end and back end over all source files
    public Timer frontEndTimer
    public Timer middleEndTimer
    public Timer backEndTimer
    public ErrorManager errorManager
    public CompileProgress compileProgress // Progress bar on the console, if enabled (see compileProject)
    // Lookup caches of the managers (static members of the managers in the host)
    public LookupCache<model::Function> functionLookupCache
    public LookupCache<Struct> structLookupCache
    public LookupCache<Interface> interfaceLookupCache
    public LookupCache<Union> unionLookupCache
    // Operator functions that were not available for certain operand types (static member of the OpRuleManager in the host)
    public UnorderedMap</*cacheKey=*/Hash, /*registryVersion=*/unsigned long> unavailableOpFctCache
    public RecursiveMutex symbolRegistryMutex // Guards the symbol lookup machinery during the parallel back end
    public bool abortCompilation = false
    unsigned long nextCustomTypeId = BYTE_MAX_VALUE + 1l // Start at 256 because all primitive types come first
    unsigned long nextScopeId = 0l
}

public p GlobalResourceManager.ctor(CliOptions& cliOptions) {
    this.cliOptions = cliOptions;
    this.linker = ExternalLinkerInterface(cliOptions);
    this.cacheManager = CacheManager(cliOptions);
    this.runtimeModuleManager = RuntimeModuleManager(*this);
    this.astNodeAlloc = BlockAllocator<ASTNode>(this.memoryManager);
    this.sourceFileAlloc = BlockAllocator<SourceFile>(this.memoryManager, sizeof<SourceFile>() * 4l);
    // Context-free type creation (e.g. QualType(TY_INT)) interns into the type registry of the resource manager
    setActiveTypeRegistry(&this.typeRegistry);
    // The name disambiguation of types operates on the type name disambiguator of the resource manager
    setActiveTypeNameDisambiguator(&this.typeNameDisambiguator);
    // Hard errors (thrown as SemanticError in the host) are recorded in the error manager of the resource manager
    setActiveErrorManager(&this.errorManager);
    // The lookups of the managers operate on the lookup caches of the resource manager (static members of the managers in
    // the host). Like in the host, they are cleared in the destructor
    setActiveFunctionLookupCache(&this.functionLookupCache);
    setActiveStructLookupCache(&this.structLookupCache);
    setActiveInterfaceLookupCache(&this.interfaceLookupCache);
    setActiveUnionLookupCache(&this.unionLookupCache);
    // The lookups of the managers lock the symbol registry mutex of the resource manager, while the back end runs in parallel
    setActiveSymbolRegistryMutex(&this.symbolRegistryMutex);

    // Initialize the required LLVM targets
    if cliOptions.isNativeTarget {
        llvm::initializeNativeTarget();
        llvm::initializeNativeAsmPrinter();
        llvm::initializeNativeAsmParser();
    } else {
        llvm::initializeAllTargetInfos(); // Unlike the C++ variant, the C variant of initializeAllTargets does not do this
        llvm::initializeAllTargets();
        llvm::initializeAllTargetMCs();
        llvm::initializeAllAsmPrinters();
        llvm::initializeAllAsmParsers();
    }

    // Create target machine for LLVM
    if cliOptions.isNativeTarget & cliOptions.useNativeFeatures {
        // Retrieve native CPU name and the supported CPU features
        this.cpuName = llvm::getHostCPUName();
        this.cpuFeatures = llvm::getHostCPUFeatures();
    }

    // Create lto module
    if cliOptions.useLTO {
        // Discard value names if not required
        this.ltoContext.setDiscardValueNames(!cliOptions.namesForIRValues);
        // Create lto module
        this.ltoModule = llvm::Module(LTO_FILE_NAME, this.ltoContext);
    }
}

public p GlobalResourceManager.dtor() {
    // Destruct all AST nodes as their concrete node types. The node pool could only destruct them as ASTNode
    Vector<ASTNode*> astNodes = this.astNodeAlloc.releaseObjects();
    foreach ASTNode* astNode : astNodes {
        destructASTNode(astNode);
    }

    // Notify all global components to prepare to destroy
    this.typeRegistry.clear();
    this.typeNameDisambiguator.clear();
    this.functionLookupCache.cleanup();
    this.structLookupCache.cleanup();
    this.interfaceLookupCache.cleanup();
    this.unionLookupCache.cleanup();
    this.unavailableOpFctCache.clear();
    // Cleanup all LLVM statics
    llvm::llvm_shutdown();
}

public f<CliOptions&> GlobalResourceManager.getCliOptions() {
    return this.cliOptions;
}

public f<const String&> GlobalResourceManager.getCompileTimeStringValue(unsigned long offset) {
    return this.compileTimeStringValues.get(offset);
}

public p GlobalResourceManager.addLinkerFlag(const String& flag) {
    this.linker.addLinkerFlag(flag);
}

public p GlobalResourceManager.addAdditionalSourcePath(const FilePath& path) {
    this.linker.addAdditionalSourcePath(path);
}

public f<ErrorManager&> GlobalResourceManager.getErrorManager() {
    return this.errorManager;
}

public f<SourceFile*> GlobalResourceManager.createSourceFile(SourceFile* parent, const String& depName, const FilePath& path, bool isStdFile) {
    const String filePathStr = String(path.toString());

    // Register the path of the root source file, which the code locations are pretty-printed relative to
    if parent == nil<SourceFile*> && this.rootSourceFilePath.isEmpty() {
        this.rootSourceFilePath = filePathStr;
        setRootSourceFilePath(this.rootSourceFilePath.getRaw());
    }

    // Key the source files by the canonical path, like the host does (weakly_canonical(absolute(path))). Otherwise, the same
    // file is loaded twice if two callers spell its path differently, e.g. with mixed path separators on Windows (the
    // import collector vs. the runtime module manager), and the linker sees its symbols twice
    FilePath keyPath = path.canonical();
    if keyPath.isEmpty() {
        keyPath = path.lexicallyNormal();
    }
    const String sourceFileKey = String(keyPath.toGenericString());

    // Create the new source file if it was not added yet (e.g. by another source file that imports it)
    if !this.sourceFiles.contains(sourceFileKey) {
        // Reserve stable storage for the source file in the pool and construct it in place
        SourceFile* newSourceFile = this.sourceFileAlloc.reserve<SourceFile>();
        unsafe {
            __placement_new<SourceFile>(newSourceFile, *this, parent, depName, path, isStdFile);
        }
        this.sourceFiles.upsert(sourceFileKey, newSourceFile);
        this.sourceFilesInCreationOrder.pushBack(newSourceFile);
        this.compileProgress.addSourceFile();
    }

    return this.sourceFiles.get(sourceFileKey);
}

public f<unsigned long> GlobalResourceManager.getNextCustomTypeId() {
    return this.nextCustomTypeId++;
}

/**
 * Determine how many source files may be compiled at the same time, based on the --jobs/-j cli option
 *
 * @return Number of compile jobs (always >= 1)
 */
public f<unsigned long> GlobalResourceManager.getCompileJobCount() {
    // An explicit job count always wins
    if this.cliOptions.compileJobCount > 0u {
        return cast<unsigned long>(this.cliOptions.compileJobCount);
    }

    // Otherwise derive the job count from the machine. If it cannot be determined, fall back to a serial back end.
    const long coreCount = getCPUCoreCount();
    return coreCount > 0l ? cast<unsigned long>(coreCount) : 1ul;
}

public f<unsigned long> GlobalResourceManager.getNextScopeId() {
    return this.nextScopeId++;
}

/**
 * Get the id of the given AST node. Node ids are assigned in creation order per source file, so unlike the node address,
 * they are the same in every compiler run
 *
 * @param node AST node
 * @return Node id / 0 if the node was not created by the parser
 */
public f<unsigned long> GlobalResourceManager.getNodeId(const ASTNode* node) {
    const long nodeAddress = getNodeAddress(node);
    if !this.nodeToNodeId.contains(nodeAddress) {
        return 0l;
    }
    return this.nodeToNodeId.get(nodeAddress);
}

public f<unsigned long> GlobalResourceManager.getTotalLineCount() {
    result = 0l;
    foreach Pair<const String&, SourceFile*&> sourceFileEntry : this.sourceFiles {
        SourceFile* sourceFile = sourceFileEntry.getSecond();
        const Result<String> contentResult = readFile(sourceFile.filePath.toGenericString());
        if contentResult.isOk() {
            const String content = contentResult.unwrap();
            const unsigned long size = content.getLength();
            for unsigned long i = 0l; i < size; i++ {
                if content[i] == '\n' { result++; }
            }
            // A non-empty file without a trailing newline has an extra final line
            if size > 0l && content[size - cast<unsigned long>(1)] != '\n' { result++; }
        }
    }
}
