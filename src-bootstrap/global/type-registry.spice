// Std imports
import "std/data/vector";
import "std/data/unordered-map";
import "std/data/map";
import "std/data/pair";
import "std/text/stringstream";
import "std/math/hash";

// Own imports
import "bootstrap/util/block-allocator";
import "bootstrap/util/memory";
import "bootstrap/symboltablebuilder/super-type";
import "bootstrap/symboltablebuilder/qual-type";
import "bootstrap/symboltablebuilder/type-chain";
import "bootstrap/symboltablebuilder/type";

// The TypeRegistry interns every Type and hands back stable `const Type*` pointers, so that type identity can be
// compared by pointer. It replaces the host's static-singleton unordered_map (which cannot be ported, since Spice
// has no usable mutable globals): instead it is a normal struct owned by the GlobalResourceManager and threaded
// into each Type it creates (Type.registry), so the Type derivation methods (toPtr, getBase, ...) can re-enter it.
// Storage is a BlockAllocator<Type> (stable addresses, exactly like the parser's AST node pool) plus a hash ->
// bucket map for deduplication. Buckets (Vector<Type*>) are used instead of a single value per hash so that hash
// collisions are resolved exactly via structural equality.
public type TypeRegistry struct {
    // The memory manager is declared before the allocator so that it outlives it (the allocator keeps a reference).
    DefaultMemoryManager memoryManager
    BlockAllocator<Type> alloc
    UnorderedMap<Hash, Vector<Type*>> types
    unsigned long typeCount = 0ul
}

// Address of the active type registry. The host's TypeRegistry is a static singleton, which context-free type creation like
// QualType(TY_INT) relies on. Spice only supports globals of primitive type, so the address is stored as a long.
long ACTIVE_TYPE_REGISTRY_ADDRESS = 0l;

/**
 * Make the given type registry the active one. Context-free type creation, e.g. QualType(TY_INT), interns into it.
 *
 * @param registry Type registry, which must outlive all types created through it
 */
public p setActiveTypeRegistry(TypeRegistry* registry) {
    unsafe {
        ACTIVE_TYPE_REGISTRY_ADDRESS = cast<long>(cast<byte*>(registry));
    }
}

/**
 * Get the active type registry
 *
 * @return Active type registry or nil if no type registry is active
 */
public f<TypeRegistry*> getActiveTypeRegistry() {
    unsafe {
        return cast<TypeRegistry*>(cast<byte*>(ACTIVE_TYPE_REGISTRY_ADDRESS));
    }
}

public p TypeRegistry.ctor() {
    this.alloc = BlockAllocator<Type>(this.memoryManager);
    this.types = UnorderedMap<Hash, Vector<Type*>>();
}

/**
 * Get or insert a type built from a single super type
 */
public f<const Type*> TypeRegistry.getOrInsert(SuperType superType) {
    Type tmpType = Type(superType);
    return this.getOrInsertType(tmpType);
}

/**
 * Get or insert a type built from a super type and a sub type
 */
public f<const Type*> TypeRegistry.getOrInsertSub(SuperType superType, const String& subType) {
    Type tmpType = Type(superType, subType);
    return this.getOrInsertType(tmpType);
}

/**
 * Get or insert a type built from a super type, a sub type, a type id, type chain element data and template types
 */
public f<const Type*> TypeRegistry.getOrInsert(SuperType superType, const String& subType, unsigned long typeId, const TypeChainElementData& data, const QualTypeList& templateTypes) {
    Type tmpType = Type(superType, subType, typeId, data, templateTypes);
    return this.getOrInsertType(tmpType);
}

/**
 * Get or insert a type built from a full type chain
 */
public f<const Type*> TypeRegistry.getOrInsertChain(const TypeChain& typeChain) {
    Type tmpType = Type(typeChain);
    return this.getOrInsertType(tmpType);
}

/**
 * Get the number of types currently interned
 */
public f<unsigned long> TypeRegistry.getTypeCount() {
    return this.typeCount;
}

/**
 * Dump all types in the type registry
 */
public f<String> TypeRegistry.dump() {
    // Sort to ensure deterministic output. Distinct types can share the same name (e.g. different body scopes), so count
    // the occurrences of each name, to emit duplicates like the sorted list of the host does
    Map<String, unsigned long> typeStrings;
    foreach Pair<const Hash&, Vector<Type*>&> bucket : this.types {
        foreach Type* registryType : bucket.getSecond() {
            const String typeString = registryType.getName(false, true, true);
            if typeStrings.contains(typeString) {
                typeStrings.get(typeString)++;
            } else {
                typeStrings.insert(typeString, 1ul);
            }
        }
    }
    // Serialize type registry
    StringStream typeRegistryString;
    foreach Pair<const String&, unsigned long&> typeString : typeStrings {
        for unsigned long i = 0ul; i < typeString.getSecond(); i++ {
            typeRegistryString << typeString.getFirst() << "\n";
        }
    }
    return typeRegistryString.str();
}

/**
 * Core interning routine: hash the candidate type, return the matching cached instance, otherwise allocate a
 * stable copy in the pool, wire its registry back-reference and remember it in the matching hash bucket.
 */
f<const Type*> TypeRegistry.getOrInsertType(const Type& candidate) {
    const Hash h = this.getTypeHash(candidate);
    const Type* candidatePtr = &candidate;

    if this.types.contains(h) {
        // Search the bucket for a structurally equal type
        Vector<Type*>& bucket = this.types.get(h);
        foreach Type* existing : bucket {
            if existing.matches(candidatePtr, false) && haveSameBodyScopes(existing, candidatePtr) {
                const Type* hit = existing;
                return hit;
            }
        }
        // Hash collision with a different type: allocate it and append to the existing bucket
        Type* collisionType = this.allocateType(candidate);
        bucket.pushBack(collisionType);
        const Type* appended = collisionType;
        return appended;
    }

    // First type with this hash: create a fresh bucket
    Type* newType = this.allocateType(candidate);
    Vector<Type*> bucket;
    bucket.pushBack(newType);
    this.types.upsert(h, bucket);
    const Type* newResult = newType;
    return newResult;
}

/**
 * Allocate a stable copy of the given type in the pool, construct it in place and wire its registry back-reference.
 */
f<Type*> TypeRegistry.allocateType(const Type& candidate) {
    Type* newType = this.alloc.reserve<Type>();
    unsafe {
        __placement_new<Type>(newType, candidate);
    }
    // Wire the non-owning registry back-reference so the type's derivation methods can re-enter the registry
    newType.registry = this;
    this.typeCount++;
    return newType;
}

/**
 * Check if two types with the same structure also have the same body scopes. Type.matches ignores the body scopes of
 * structs, interfaces and unions (like the host's TypeChainElement equality), but two manifestations of a generic type
 * (e.g. the one bound to the generic struct scope and the one bound to the scope of the concrete substantiation) must be
 * interned as distinct types, like the host does by hashing the body scope.
 */
f<bool> haveSameBodyScopes(const Type* lhs, const Type* rhs) {
    assert lhs.typeChain.getSize() == rhs.typeChain.getSize();
    for unsigned long i = 0ul; i < lhs.typeChain.getSize(); i++ {
        const TypeChainElement& lhsElement = lhs.typeChain.get(i);
        const TypeChainElement& rhsElement = rhs.typeChain.get(i);
        const SuperType superType = lhsElement.superType;
        const bool hasBodyScope = superType == SuperType::TY_STRUCT || superType == SuperType::TY_INTERFACE || superType == SuperType::TY_UNION || superType == SuperType::TY_ENUM;
        if hasBodyScope && lhsElement.data.bodyScope != rhsElement.data.bodyScope {
            return false;
        }
    }
    return true;
}

// Address of the body scope of a type chain element, which is used to hash body scopes by pointer identity like the host
// (hashPointer)
f<long> getBodyScopeAddress(const TypeChainElement& tce) {
    long address = 0l;
    unsafe {
        address = cast<long>(cast<byte*>(tce.data.bodyScope));
    }
    return address;
}

/**
 * Compute the hash of a type over its type chain. Template and function param/return sub-types are hashed
 * recursively (they are themselves interned Types).
 */
public f<Hash> TypeRegistry.getTypeHash(const Type& candidate) {
    Hash h = 0ul;
    foreach const TypeChainElement& tce : candidate.typeChain {
        const Hash elementHash = this.hashElement(tce);
        h = combineHashes(h, elementHash);
    }
    return h;
}

f<Hash> TypeRegistry.hashElement(const TypeChainElement& tce) {
    Hash h = hash(cast<long>(tce.superType));
    h = combineHashes(h, hash(tce.subType));
    h = combineHashes(h, hash(tce.typeId));

    // Hash the super-type-specific data payload
    switch tce.superType {
        case SuperType::TY_ARRAY: {
            h = combineHashes(h, hash(cast<long>(tce.data.arraySize)));
        }
        case SuperType::TY_FUNCTION, SuperType::TY_PROCEDURE: {
            h = combineHashes(h, hash(tce.data.hasCaptures));
        }
        case SuperType::TY_STRUCT, SuperType::TY_INTERFACE, SuperType::TY_UNION, SuperType::TY_ENUM: {
            // Hash based on pointer identity of the body scope, like the host compiler
            h = combineHashes(h, hash(getBodyScopeAddress(tce)));
        }
        default: {}
    }

    // Hash template types and function param/return types recursively by their interned content
    foreach const QualType& templateType : tce.templateTypes {
        h = combineHashes(h, this.hashQualType(templateType));
    }
    foreach const QualType& paramType : tce.paramTypes {
        h = combineHashes(h, this.hashQualType(paramType));
    }

    return h;
}

f<Hash> TypeRegistry.hashQualType(const QualType& qt) {
    Hash h = 0ul;

    // Recurse into the (interned) raw type, if present
    if qt.rawType != nil<const Type*> {
        const Type* rawType = qt.rawType;
        h = this.getTypeHash(*rawType);
    }

    // Fold in the qualifier bits (the public qualifier is ignored, like in the host compiler)
    long bits = 0l;
    if qt.qualifiers.isConst { bits = bits | 1l; }
    if qt.qualifiers.isSigned { bits = bits | 2l; }
    if qt.qualifiers.isUnsigned { bits = bits | 4l; }
    if qt.qualifiers.isHeap { bits = bits | 8l; }
    if qt.qualifiers.isInline { bits = bits | 16l; }
    if qt.qualifiers.isComposition { bits = bits | 32l; }
    h = combineHashes(h, hash(bits));

    return h;
}
