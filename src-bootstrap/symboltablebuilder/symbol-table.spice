// Std imports
import "std/data/unordered-map";
import "std/data/map";
import "std/data/vector";
import "std/data/pair";
import "std/type/type-conversion";
import "std/text/json/json-value";

// Own imports
import "bootstrap/ast/ast-nodes";
import "bootstrap/reader/code-loc";
import "bootstrap/symboltablebuilder/qual-type";
import "bootstrap/symboltablebuilder/super-type";
import "bootstrap/symboltablebuilder/scope";
import "bootstrap/symboltablebuilder/symbol-table-entry";
import "bootstrap/symboltablebuilder/type-qualifiers";
import "bootstrap/symboltablebuilder/capture";
import "bootstrap/symboltablebuilder/lifecycle";
import "bootstrap/model/generic-type";
import "bootstrap/model/function";
import "bootstrap/model/struct";
import "bootstrap/model/interface";
import "bootstrap/util/compiler-warning";
import "bootstrap/util/common-util";

// Type aliases
public type CaptureMap alias UnorderedMap</*name=*/String, /*capture*/Capture>;
public type SymbolMap alias UnorderedMap</*name=*/String, /*entry*/SymbolTableEntry>;

/**
 * Class for storing information about symbols of the program.
 * Symbol tables are arranged in a tree structure, so that you can navigate with the .parent property and getChild() method up
 * and down the tree.
 */
public type SymbolTable struct {
    SymbolTable* parent
    Scope* scope
    SymbolMap symbols
    public CaptureMap captures
    bool capturingRequired = false
}

public p SymbolTable.ctor(SymbolTable* parent, Scope* scope) {
    this.parent = parent;
    this.scope = scope;
}

/**
 * Copy the symbols and captures of another symbol table into this one. The parent and scope stay untouched. This mirrors
 * the member-wise copy of the symbol table, that the host performs when copying a scope.
 *
 * @param other Symbol table to copy from
 */
public p SymbolTable.copyContentsFrom(const SymbolTable& other) {
    this.symbols = other.symbols;
    this.captures = other.captures;
    this.capturingRequired = other.capturingRequired;
}

/**
 * Count the number of field symbols in this symbol table (struct scopes). Mirrors the host Scope::getFieldCount:
 * skip anonymous symbols, imports and nested function/struct/union definitions.
 *
 * @return Number of field symbols
 */
public f<unsigned long> SymbolTable.getFieldCount() {
    result = 0ul;
    foreach Pair<const String&, SymbolTableEntry&> symbolPair : this.symbols {
        SymbolTableEntry& symbol = symbolPair.getSecond();
        if symbol.anonymous { continue; }
        const QualType& symbolType = symbol.getQualType();
        if symbolType.is(SuperType::TY_IMPORT) { continue; }
        const ASTNode* declNode = symbol.declNode;
        if declNode.isFctOrProcDef() || declNode.isStructDef() || declNode.isUnionDef() { continue; }
        result++;
    }
}

/**
 * Insert a new symbol into the current symbol table. If it is a parameter, append its name to the paramNames vector
 *
 * @param name Name of the symbol
 * @param declNode AST node where the symbol is declared
 * @return Inserted entry
 */
public f<SymbolTableEntry*> SymbolTable.insert(const String& name, const ASTNode* declNode, bool isAnonymousSymbol = false) {
    const bool isGlobal = this.parent == nil<SymbolTable*>;
    // Anonymous symbols do not get an order index (SIZE_MAX in the host)
    unsigned long orderIndex = 18446744073709551615ul;
    if !isAnonymousSymbol {
        orderIndex = 0ul;
        foreach Pair<const String&, SymbolTableEntry&> symbol : this.symbols {
            const SymbolTableEntry& existingEntry = symbol.getSecond();
            if !existingEntry.anonymous {
                orderIndex++;
            }
        }
    }
    // Insert into symbols map. The type is invalid, because concrete types are determined by the type checker later on
    assert !this.symbols.contains(name);
    const QualType qualType = QualType(SuperType::TY_INVALID);
    ASTNode* mutableDeclNode = cast<ASTNode*>(declNode);
    this.symbols.upsert(name, SymbolTableEntry(name, qualType, this.scope, mutableDeclNode, orderIndex, isGlobal));
    // Set entry to declared
    SymbolTableEntry* entry = &this.symbols.get(name);
    entry.updateState(LifecycleState::DECLARED, mutableDeclNode);

    // Check if shadowed
    if this.parent != nil<SymbolTable*> && this.parent.lookup(name) != nil<SymbolTableEntry*> && !mutableDeclNode.isParam() && name != RETURN_VARIABLE_NAME {
        const String warningMsg = "Variable '" + name + "' shadows a variable in a parent scope";
        const CompilerWarning warning = CompilerWarning(declNode.codeLoc, CompilerWarningType::SHADOWED_VARIABLE, warningMsg.getRaw());
        this.scope.sourceFile.compilerOutput.warnings.pushBack(warning);
    }

    return entry;
}

/**
 * Insert a new anonymous symbol into the current symbol table.
 * The anonymous symbol will be identified via the definition code location
 *
 * @param qualType Type of the symbol
 * @param declNode AST node where the anonymous symbol is declared
 * @return Inserted entry
 */
public f<SymbolTableEntry*> SymbolTable.insertAnonymous(const QualType& qualType, ASTNode* declNode, unsigned long numericSuffix = 0l) {
    // Check if the anonymous entry already exists
    SymbolTableEntry* existingSymbol = this.lookupAnonymous(declNode, numericSuffix);
    if existingSymbol != nil<SymbolTableEntry*> {
        return existingSymbol;
    }
    // Otherwise, create an anonymous entry
    const String name = getAnonymousSymbolName(declNode, numericSuffix);
    SymbolTableEntry* anonSymbol = this.insert(name, declNode, true);
    anonSymbol.updateType(qualType, false);
    anonSymbol.updateState(LifecycleState::DECLARED, declNode);
    anonSymbol.updateState(LifecycleState::INITIALIZED, declNode);
    anonSymbol.anonymous = true;
    anonSymbol.used = true;
    return anonSymbol;
}

/**
 * Build the name of an anonymous symbol. It is unique per declaration node and numeric suffix.
 *
 * @param declNode AST node where the anonymous symbol is declared
 * @param numericSuffix Custom numeric suffix
 * @return Name of the anonymous symbol
 */
f<String> getAnonymousSymbolName(const ASTNode* declNode, unsigned long numericSuffix) {
    long nodeAddress = 0l;
    unsafe {
        nodeAddress = cast<long>(cast<byte*>(declNode));
    }
    String name = String("anon.") + declNode.codeLoc.toString() + "." + toString(nodeAddress);
    if numericSuffix > 0l {
        name += ".";
        name += toString(cast<long>(numericSuffix));
    }
    return name;
}

/**
 * Copy a symbol by its name
 *
 * @param originalName Original symbol name
 * @param newName New symbol name
 * @return Copied entry
 */
public f<SymbolTableEntry*> SymbolTable.copySymbol(const String& originalName, const String& newName) {
    SymbolTableEntry* entryToCopy = this.lookupStrict(originalName);
    assert entryToCopy != nil<SymbolTableEntry*>;
    assert !this.symbols.contains(newName);
    this.symbols.upsert(newName, *entryToCopy);
    return &this.symbols.get(newName);
}

/**
 * Check if a symbol exists in the current or any parent scope and return it if possible
 *
 * @param name Name of the desired symbol
 * @return Desired symbol / nullptr if the symbol was not found
 */
public f<SymbolTableEntry*> SymbolTable.lookup(const String& name) {
    // Check if the symbol exists in the current scope. If yes, take it
    SymbolTableEntry* entry = this.lookupStrict(name);
    if entry == nil<SymbolTableEntry*> { // Symbol was not found in the current scope
        // We reached the root scope, the symbol does not exist at all
        if this.parent == nil<SymbolTable*> {
            return nil<SymbolTableEntry*>;
        }
        // If there is a parent scope, continue the search there
        entry = this.parent.lookup(name);
        // Symbol was also not found in all the parent scopes, return nullptr
        if entry == nil<SymbolTableEntry*> {
            return nil<SymbolTableEntry*>;
        }

        // Check if this scope requires capturing and capture the variable if appropriate
        const QualType entryType = entry.getQualType();
        const dyn captureSkip = [SuperType::TY_IMPORT, SuperType::TY_FUNCTION, SuperType::TY_PROCEDURE];
        if this.capturingRequired && !this.captures.contains(name) && !entryType.isOneOf(captureSkip, len(captureSkip)) {
            // ToDo: Make the symbol volatile if it is captured across an async-scope boundary. This needs the
            // async-scope query exposed on Scope; skipped for now.
            // Add the capture to the current scope
            this.captures.upsert(name, Capture(entry));
        }
    }
    return entry;
}

/**
 * Check if a symbol exists in the current scope and return it if possible
 *
 * @param name Name of the desired symbol
 * @return Desired symbol / nullptr if the symbol was not found
 */
public f<SymbolTableEntry*> SymbolTable.lookupStrict(const String& name) {
    if name.isEmpty() {
        return nil<SymbolTableEntry*>;
    }
    // Check if a symbol with this name exists in this scope
    if this.symbols.contains(name) {
        return &this.symbols.get(name);
    }
    // Check if a capture with this name exists in this scope
    if this.captures.contains(name) {
        Capture& capture = this.captures.get(name);
        return capture.capturedSymbol;
    }
    // Otherwise, return a nullptr
    return nil<SymbolTableEntry*>;
}

/**
 * Check if a symbol exists in one of the composed field scopes of the current scope and return it if possible.
 * This only works if the current scope is a struct scope.
 *
 * @param name Name of the desired symbol
 * @param indexPath How to index the found symbol using order indices (e.g. for GEP)
 * @return Desired symbol / nullptr if the symbol was not found
 */
public f<SymbolTableEntry*> SymbolTable.lookupInComposedFields(const String& name, Vector<unsigned long>& indexPath) {
    assert this.scope.getScopeType() == ScopeType::STRUCT;

    // Check if we have a symbol with this name in the current scope
    SymbolTableEntry* strictResult = this.lookupStrict(name);
    if strictResult != nil<SymbolTableEntry*> {
        indexPath.pushBack(strictResult.orderIndex);
        return strictResult;
    }

    // If it was not found in the current scope, loop through all composed fields in this scope
    const unsigned long fieldCount = this.scope.getFieldCount();
    for unsigned long i = 0l; i < fieldCount; i++ {
        const SymbolTableEntry* fieldEntry = this.lookupStrictByIndex(cast<unsigned int>(i));
        const QualType fieldType = fieldEntry.getQualType();

        // Skip all fields that are not composition fields
        if !fieldType.isComposition() {
            continue;
        }

        // Add the current field's order index to the index path
        indexPath.pushBack(fieldEntry.orderIndex);

        // Search in the composed field's body scope
        Scope* searchScope = fieldType.getBodyScope();
        assert searchScope != nil<Scope*>;
        SymbolTableEntry* composedResult = searchScope.symbolTable.lookupInComposedFields(name, indexPath);
        if composedResult != nil<SymbolTableEntry*> {
            return composedResult;
        }

        // Remove the current field's order index from the index path
        indexPath.popBack();
    }

    // Symbol was not found in current scope, return nullptr
    return nil<SymbolTableEntry*>;
}

/**
 * Check if an order index exists in the current or any parent scope and returns it if possible.
 * Warning: Unlike the `lookup` method, this one doesn't consider the parent scopes
 *
 * @param orderIndex Order index of the desired symbol
 * @return Desired symbol / nullptr if the symbol was not found
 */
public f<SymbolTableEntry*> SymbolTable.lookupStrictByIndex(const unsigned int orderIndex) {
    foreach Pair<const String&, SymbolTableEntry&> symbolPair : this.symbols {
        SymbolTableEntry& symbol = symbolPair.getSecond();
        if symbol.orderIndex == cast<unsigned long>(orderIndex) {
            return &symbol;
        }
    }
    return nil<SymbolTableEntry*>;
}

/**
 * Check if an anonymous symbol exists in the current scope and return it if possible
 *
 * @param codeLoc Definition code loc
 * @param numericSuffix Numeric suffix of the anonymous symbol
 * @return Anonymous symbol
 */
public f<SymbolTableEntry*> SymbolTable.lookupAnonymous(const ASTNode* declNode, unsigned long numericSuffix = 0l) {
    const String name = getAnonymousSymbolName(declNode, numericSuffix);
    return this.lookup(name);
}

/**
 * Check if a symbol exists in the current or any parent scope and return it if possible.
 * If the target symbol is an alias symbol, resolve the alias container entry.
 *
 * @param name Name of the desired symbol
 * @return Desired symbol / nil if the symbol was not found + alias or not
 */
public f<Pair<SymbolTableEntry*, bool>> SymbolTable.lookupWithAliasResolution(const String& name) {
    SymbolTableEntry* entry = this.lookup(name);
    if entry == nil<SymbolTableEntry*> {
        return Pair<SymbolTableEntry*, bool>(entry, false);
    }
    const QualType entryType = entry.getQualType();
    if !entryType.is(SuperType::TY_ALIAS) {
        return Pair<SymbolTableEntry*, bool>(entry, false);
    }

    // We have an alias type here, resolve it
    assert entry.scope.isRootScope();
    entry.used = true;
    const String aliasedContainerEntryName = entry.name + ALIAS_CONTAINER_SUFFIX;
    SymbolTableEntry* aliasedTypeContainerEntry = entry.scope.lookupStrict(aliasedContainerEntryName);
    assert aliasedTypeContainerEntry != nil<SymbolTableEntry*>;
    return Pair<SymbolTableEntry*, bool>(aliasedTypeContainerEntry, true);
}

/**
 * Check if a capture exists in the current or any parent scope scope and return it if possible
 *
 * @param name Name of the desired captured symbol
 * @return Capture / nullptr if the capture was not found
 */
public f<Capture*> SymbolTable.lookupCapture(const String& name) {
    // Check if the capture exists in the current scope. If yes, take it
    Capture* capture = this.lookupCaptureStrict(name);
    if capture != nil<Capture*> {
        return capture;
    }

    // We reached the root scope, the symbol does not exist at all
    if this.parent == nil<SymbolTable*> {
        return nil<Capture*>;
    }

    return this.parent.lookupCapture(name);
}

/**
 * Check if a capture exists in the current scope and return it if possible
 *
 * @param name Name of the desired captured symbol
 * @return Capture / nullptr if the capture was not found
 */
public f<Capture*> SymbolTable.lookupCaptureStrict(const String& captureName) {
    // If available in the current scope, return it
    if this.captures.contains(captureName) {
        return &this.captures.get(captureName);
    }
    // Otherwise, return nullptr
    return nil<Capture*>;
}

/**
 * Set capturing for this scope to required.
 */
public p SymbolTable.setCapturingRequired() {
    this.capturingRequired = true;
}

/**
 * Deletes an existing anonymous symbol
 *
 * @param name Anonymous symbol name
 */
public p SymbolTable.deleteAnonymous(const String& name) {
    if this.symbols.contains(name) {
        this.symbols.remove(name);
    }
}

/**
 * Stringify a symbol table to a human-readable form. This is used to realize dumps of symbol tables
 *
 * Example:
 * {
 *   "name": "<SymbolTableName>"
 *   "symbols": [
 *     ... (SymbolTableEntry)
 *   ],
 *   "children": [
 *     ... (SymbolTable)
 *   ]
 * }
 *
 * The returned heap-allocated JSON value is owned by the caller.
 *
 * @return Symbol table if form of a string
 */
public f<JsonValue*> SymbolTable.toJSON() {
    // Collect all symbols. The host keeps them in an ordered map, so sort them by name
    Map<String, SymbolTableEntry*> sortedSymbols;
    foreach Pair<const String&, SymbolTableEntry&> symbol : this.symbols {
        sortedSymbols.insert(symbol.getFirst(), &symbol.getSecond());
    }
    JsonValue* jsonSymbols = __new<JsonValue>(JsonValueKind::JSON_ARRAY);
    foreach Pair<const String&, SymbolTableEntry*&> symbol : sortedSymbols {
        SymbolTableEntry* entry = symbol.getSecond();
        jsonSymbols.addArrayItem(entry.toJSON());
    }

    // Collect all captures. The host keeps them in an ordered map, so sort them by name
    Map<String, Capture*> sortedCaptures;
    foreach Pair<const String&, Capture&> capture : this.captures {
        sortedCaptures.insert(capture.getFirst(), &capture.getSecond());
    }
    JsonValue* jsonCaptures = __new<JsonValue>(JsonValueKind::JSON_ARRAY);
    foreach Pair<const String&, Capture*&> capture : sortedCaptures {
        Capture* capturePtr = capture.getSecond();
        jsonCaptures.addArrayItem(capturePtr.toJSON());
    }

    // Generate json
    result = __new<JsonValue>(JsonValueKind::JSON_OBJECT);
    setJsonField(result, String("symbols"), jsonSymbols);
    setJsonField(result, String("captures"), jsonCaptures);
    return result;
}
