// Own imports
import "bootstrap/compiler-pass";
import "bootstrap/ast/ast-nodes";
import "bootstrap/symboltablebuilder/scope";

/**
 * This struct is used to change the current scope to a child scope and change it back to the parent scope when the handle
 * object is destroyed. This can be used in visit functions to automatically leave the scope when the function returns.
 *
 * The host implements this via DeferredLogic. The constructors that take an IRGenerator are ported with the IR generator.
 */
public type ScopeHandle struct {
    CompilerPass* pass
    ScopeType scopeType
    bool alreadyExecuted = false
}

public p ScopeHandle.ctor(CompilerPass* pass, Scope* childScope, ScopeType scopeType) {
    this.pass = pass;
    this.scopeType = scopeType;
    this.pass.changeToScope(childScope, scopeType);
}

public p ScopeHandle.ctor(CompilerPass* pass, const String& childScopeId, ScopeType scopeType) {
    this.pass = pass;
    this.scopeType = scopeType;
    Scope* currentScope = this.pass.currentScope;
    this.pass.changeToScope(currentScope.getChildScope(childScopeId), scopeType);
}

public p ScopeHandle.dtor() {
    if !this.alreadyExecuted {
        this.pass.changeToParentScope(this.scopeType);
    }
}

/**
 * Leave the scope before the handle is destroyed
 */
public p ScopeHandle.leaveScopeEarly() {
    this.pass.changeToParentScope(this.scopeType);
    this.alreadyExecuted = true;
}

/**
 * This struct enters the expression scope of an expression, if it has one, and leaves it again when the handle object is
 * destroyed.
 *
 * An expression scope holds the temporaries of an expression that is evaluated as a unit: a condition or an operand that is
 * only evaluated conditionally. This allows destructing the temporaries right after the expression was evaluated, on every
 * path. If the expression has no scope, the handle does nothing and the temporaries stay in the current scope.
 */
public type ExprScopeHandle struct {
    CompilerPass* pass
    Scope* exprScope
}

public p ExprScopeHandle.ctor(CompilerPass* pass, IVisitable* expr) {
    this.pass = pass;
    Scope* currentScope = this.pass.currentScope;
    this.exprScope = currentScope.getChildScope(getExprScopeId(expr));
    if this.exprScope != nil<Scope*> {
        this.pass.changeToScope(this.exprScope, ScopeType::EXPR_BODY);
    }
}

public p ExprScopeHandle.dtor() {
    if this.exprScope != nil<Scope*> {
        this.pass.changeToParentScope(ScopeType::EXPR_BODY);
    }
}

public f<Scope*> ExprScopeHandle.getExprScope() {
    return this.exprScope;
}
