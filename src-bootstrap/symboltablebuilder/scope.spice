// Std imports
import "std/data/unordered-map";
import "std/data/map";
import "std/data/vector";
import "std/data/pair";
import "std/text/json/json-value";

// Own imports
import "bootstrap/ast/ast-nodes";
import "bootstrap/reader/code-loc";
import "bootstrap/exception/semantic-error";
import "bootstrap/symboltablebuilder/super-type";
import "bootstrap/symboltablebuilder/symbol-table";
import "bootstrap/symboltablebuilder/symbol-table-entry";
import "bootstrap/symboltablebuilder/symbol-table-builder";
import "bootstrap/symboltablebuilder/qual-type";
import "bootstrap/model/function";
import "bootstrap/model/generic-type";
import "bootstrap/model/struct";
import "bootstrap/typechecker/function-manager";
import "bootstrap/typechecker/struct-manager";
import "bootstrap/typechecker/interface-manager";
import "bootstrap/typechecker/union-manager";
import "bootstrap/source-file";
import "bootstrap/util/block-allocator";
import "bootstrap/util/memory";
import "bootstrap/util/common-util";
import "bootstrap/util/compiler-warning";

public type ScopeType enum {
    GLOBAL,
    FUNC_PROC_BODY,
    LAMBDA_BODY,
    STRUCT,
    INTERFACE,
    UNION,
    ENUM,
    IF_ELSE_BODY,
    WHILE_BODY,
    FOR_BODY,
    FOREACH_BODY,
    CASE_BODY,
    DEFAULT_BODY,
    UNSAFE_BODY,
    ANONYMOUS_BLOCK_BODY,
    EXPR_BODY
}

/**
 * Represents an enclosed group of instructions, which are semantically separated from other scopes.
 * In the source code, scopes usually are written as curly braces.
 *
 * Following language structures use scopes:
 * - global scope
 * - functions/procedures
 * - structs
 * - enums
 * - interfaces
 * - thread blocks
 * - unsafe blocks
 * - for loops
 * - foreach loops
 * - while loops
 * - if statements
 * - anonymous scopes
 * - conditions, and expressions that are only evaluated conditionally (e.g. the right side of '&&' and '||')
 */
public type Scope struct {
    // Public members
    public Scope* parent
    public SourceFile* sourceFile
    // Child scopes are owned by their parent (mirroring the host's `map<string, shared_ptr<Scope>>`). They are
    // stored as stable pointers into 'childAllocator' rather than by value, so that adding a child never has to
    // copy a Scope (which is not trivially copyable and must never be deep-copied implicitly).
    public UnorderedMap<String, Scope*> children
    public SymbolTable symbolTable
    public CodeLoc* codeLoc = nil<CodeLoc*>
    public ScopeType scopeType
    public bool isGenericScope = false
    public bool isAsyncScope = false
    public bool isDtorScope = false
    // Only for expression scopes: dtor calls for the temporaries of the expression, in the order they are to be generated
    public Vector<Pair<SymbolTableEntry*, Function*>> temporaryDtorsToCall
    // Private members
    FunctionRegistry functions
    StructRegistry structs
    InterfaceRegistry interfaces
    UnionRegistry unions
    UnorderedMap<String, GenericType> genericTypes
    // The memory manager is declared before the allocator so that it outlives it (the allocator keeps a
    // reference to it). Each scope owns the pool its direct child scopes are allocated from.
    DefaultMemoryManager memoryManager
    BlockAllocator<Scope> childAllocator
}

public p Scope.ctor(Scope* parent, SourceFile* sourceFile, ScopeType scopeType, CodeLoc *codeLoc) {
    this.parent = parent;
    this.sourceFile = sourceFile;
    this.scopeType = scopeType;
    this.symbolTable = SymbolTable(parent == nil<Scope*> ? nil<SymbolTable*> : &parent.symbolTable, this);
    this.codeLoc = codeLoc;
    this.childAllocator = BlockAllocator<Scope>(this.memoryManager);
}

// ======================================================== Accessors =========================================================

/**
 * Get the source file this scope belongs to
 */
public f<SourceFile*> Scope.getSourceFile() {
    return this.sourceFile;
}

/**
 * Get the parent scope (nil for the global scope)
 */
public f<Scope*> Scope.getParent() {
    return this.parent;
}

/**
 * Get the kind of this scope
 */
public f<ScopeType> Scope.getScopeType() {
    return this.scopeType;
}

/**
 * Collect all warnings, produced within this scope
 *
 * @param warnings List of warnings
 * @return Collection of warnings
 */
public p Scope.collectWarnings(Vector<CompilerWarning>& warnings) {
    const dyn genericCandidates = [SuperType::TY_FUNCTION, SuperType::TY_PROCEDURE, SuperType::TY_STRUCT, SuperType::TY_INTERFACE, SuperType::TY_UNION];
    const dyn fctOrProc = [SuperType::TY_FUNCTION, SuperType::TY_PROCEDURE];

    // Visit own symbols
    foreach Pair<const String&, SymbolTableEntry&> symbol : this.symbolTable.symbols {
        const SymbolTableEntry& entry = symbol.getSecond();
        // Do not produce a warning if the symbol is used or has a special name
        const String& name = entry.name;
        if entry.used || name.startsWith(UNUSED_VARIABLE_NAME) {
            continue;
        }

        const QualType entryType = entry.getQualType();

        // When compiling a static or shared library, publicly accessible symbols form part of the library's exported
        // API. They may legitimately go unused within the library itself, since external consumers are expected to
        // use them, so do not report them as unused. isPublic() is only defined for the type categories checked here
        // (see the assertion in QualType::isPublic()), so guard the call accordingly.
        const bool isPublicApiCandidate = entryType.isExtendedPrimitive() || entryType.is(SuperType::TY_ENUM);
        if isPublicApiCandidate && entryType.isPublic() && this.sourceFile.isLibraryOutput() {
            continue;
        }

        // Determine warning type and message by the scope type and the symbol type
        CompilerWarningType warningType = CompilerWarningType::UNUSED_VARIABLE;
        String warningMessage;
        switch this.scopeType {
            case ScopeType::GLOBAL: {
                // Skip generic function/procedure/struct/interface/union entries
                const QualTypeList entryTemplateTypes = entryType.getTemplateTypes();
                if entryType.isOneOf(genericCandidates, len(genericCandidates)) && !entryTemplateTypes.isEmpty() {
                    continue;
                }

                if entryType.is(SuperType::TY_FUNCTION) {
                    Vector<Function*>* fctManifestations = entry.declNode.getFctManifestations(name);
                    warningType = CompilerWarningType::UNUSED_FUNCTION;
                    const Function* firstManifestation = fctManifestations.front();
                    warningMessage = "'" + firstManifestation.getSignature() + "' is unused";
                } else if entryType.is(SuperType::TY_PROCEDURE) {
                    Vector<Function*>* fctManifestations = entry.declNode.getFctManifestations(name);
                    warningType = CompilerWarningType::UNUSED_PROCEDURE;
                    const Function* firstManifestation = fctManifestations.front();
                    warningMessage = "'" + firstManifestation.getSignature() + "' is unused";
                } else if entryType.is(SuperType::TY_STRUCT) {
                    warningType = CompilerWarningType::UNUSED_STRUCT;
                    warningMessage = "The struct '" + entry.name + "' is unused";
                } else if entryType.is(SuperType::TY_INTERFACE) {
                    warningType = CompilerWarningType::UNUSED_INTERFACE;
                    warningMessage = "The interface '" + entry.name + "' is unused";
                } else if entryType.is(SuperType::TY_UNION) {
                    warningType = CompilerWarningType::UNUSED_UNION;
                    warningMessage = "The union '" + entry.name + "' is unused";
                } else if entryType.is(SuperType::TY_ENUM) {
                    continue; // Do not report unused enums. Only unused enum items are reported
                } else if entryType.is(SuperType::TY_IMPORT) {
                    warningType = CompilerWarningType::UNUSED_IMPORT;
                    warningMessage = "The import '" + entry.name + "' is unused";
                } else if entryType.is(SuperType::TY_ALIAS) {
                    warningType = CompilerWarningType::UNUSED_ALIAS;
                    warningMessage = "The type alias '" + entry.name + "' is unused";
                } else {
                    warningType = CompilerWarningType::UNUSED_VARIABLE;
                    warningMessage = "The variable '" + entry.name + "' is unused";
                }
            }
            case ScopeType::STRUCT, ScopeType::INTERFACE, ScopeType::UNION: {
                if entry.isField() {
                    warningType = CompilerWarningType::UNUSED_FIELD;
                    warningMessage = "The field '" + entry.name + "' is unused";
                } else if entryType.isOneOf(fctOrProc, len(fctOrProc)) {
                    // Skip implicit method entries and generic templates
                    Vector<Function*>* fctManifestations = entry.declNode.getFctManifestations(name);
                    if fctManifestations.isEmpty() {
                        continue;
                    }
                    const Function* firstManifestation = fctManifestations.front();
                    if firstManifestation.implicitDefault {
                        continue;
                    }

                    warningType = CompilerWarningType::UNUSED_METHOD;
                    warningMessage = "The method '" + firstManifestation.getSignature() + "' is unused";
                }
            }
            case ScopeType::ENUM: {
                warningType = CompilerWarningType::UNUSED_ENUM_ITEM;
                warningMessage = "The enum item '" + entry.name + "' is unused";
            }
            default: {
                warningType = CompilerWarningType::UNUSED_VARIABLE;
                warningMessage = "The variable '" + entry.name + "' is unused";
            }
        }

        // Add warning
        warnings.pushBack(CompilerWarning(entry.getDeclCodeLoc(), warningType, warningMessage.getRaw()));
    }

    // Visit children
    foreach Pair<const String&, Scope*&> childEntry : this.children {
        Scope* childScope = childEntry.getSecond();
        if !childScope.isGenericScope {
            childScope.collectWarnings(warnings);
        }
    }
}

/**
 * Checks if all variables of this and all child scopes are of an explicit type.
 * This is executed after type inference to check that all variables could be inferred correctly.
 */
public p Scope.ensureSuccessfulTypeInference() {
    // Check symbols in this scope
    foreach Pair<const String&, SymbolTableEntry&> symbol : this.symbolTable.symbols {
        const SymbolTableEntry& entry = symbol.getSecond();
        const QualType entryType = entry.getQualType();
        if entryType.is(SuperType::TY_DYN) {
            const String message = "For the variable '" + symbol.getFirst() + "' no type could be inferred";
            panicWithSemanticError(entry.declNode, SemanticErrorType::UNEXPECTED_DYN_TYPE, message.getRaw());
        }
    }

    // Check child scopes
    foreach Pair<const String&, Scope*&> childEntry : this.children {
        Scope* childScope = childEntry.getSecond();
        childScope.ensureSuccessfulTypeInference();
    }
}

/**
 * Get the number of field symbols in this (struct) scope
 */
public f<unsigned long> Scope.getFieldCount() {
    assert this.scopeType == ScopeType::STRUCT || this.scopeType == ScopeType::UNION;
    return this.symbolTable.getFieldCount();
}

/**
 * Insert a new symbol into the current scope
 *
 * @param name Name of the symbol
 * @param declNode AST node where the symbol is declared
 * @return Inserted entry
 */
public f<SymbolTableEntry*> Scope.insert(const String& name, const ASTNode* declNode) {
    return this.symbolTable.insert(name, declNode);
}

/**
 * Check if a symbol exists in the current or any parent scope
 *
 * @param name Name of the symbol
 * @return Entry, or nil if not found
 */
public f<SymbolTableEntry*> Scope.lookup(const String& name) {
    return this.symbolTable.lookup(name);
}

/**
 * Check if a symbol exists in the current scope only (does not walk up to parent scopes)
 *
 * @param name Name of the symbol
 * @return Entry, or nil if not found
 */
public f<SymbolTableEntry*> Scope.lookupStrict(const String& name) {
    return this.symbolTable.lookupStrict(name);
}

/**
 * Look up a field symbol of this (struct or union) scope by its order index
 *
 * @param n Order index of the field
 * @return Field entry, or nil if not found
 */
public f<SymbolTableEntry*> Scope.lookupField(const unsigned int n) {
    assert this.scopeType == ScopeType::STRUCT || this.scopeType == ScopeType::UNION;
    return this.symbolTable.lookupStrictByIndex(n);
}

/**
 * Insert a generic type into the current scope
 *
 * @param typeName Name of the generic type
 * @param genericType Generic type to insert
 */
public p Scope.insertGenericType(const String& typeName, const GenericType& genericType) {
    assert !this.genericTypes.contains(typeName);
    this.genericTypes.upsert(typeName, genericType);
}

/**
 * Look up a generic type by its name in the current scope
 *
 * @param typeName Name of the generic type
 * @return Generic type or nil if not found
 */
public f<GenericType*> Scope.lookupGenericTypeStrict(const String& typeName) {
    if !this.genericTypes.contains(typeName) {
        return nil<GenericType*>;
    }
    return &this.genericTypes.get(typeName);
}

/**
 * Retrieve all struct manifestations in this scope in the order of their declaration
 *
 * @return All struct manifestations in declaration order
 */
public f<Vector<Struct*>> Scope.getAllStructManifestationsInDeclarationOrder() {
    // Retrieve all struct manifestations in this scope
    Vector<Struct*> manifestations;
    foreach Pair<const String&, StructManifestationList&> structEntry : this.structs {
        foreach Pair<const String&, Struct&> manifestationEntry : structEntry.getSecond() {
            manifestations.pushBack(&manifestationEntry.getSecond());
        }
    }

    // Sort manifestations by declaration code location (insertion sort, the lists are small)
    for unsigned long i = 1l; i < manifestations.getSize(); i++ {
        Struct* current = manifestations.get(i);
        const CodeLoc& currentCodeLoc = current.structBase.getDeclCodeLoc();
        unsigned long j = i;
        while j > 0l {
            Struct* previous = manifestations.get(j - 1l);
            const CodeLoc& previousCodeLoc = previous.structBase.getDeclCodeLoc();
            if !currentCodeLoc.isBefore(previousCodeLoc) {
                break;
            }
            Struct*& slot = manifestations.get(j);
            slot = previous;
            j--;
        }
        Struct*& targetSlot = manifestations.get(j);
        targetSlot = current;
    }
    return manifestations;
}

/**
 * Check if this scope is the root scope of its source file
 *
 * @return Root scope or not
 */
public f<bool> Scope.isRootScope() {
    return this.parent == nil<Scope*>;
}

/**
 * Get the number of nested loops, which enclose this scope
 *
 * @return Loop nesting depth
 */
public f<unsigned int> Scope.getLoopNestingDepth() {
    assert !this.isRootScope();
    if this.parent.parent == nil<Scope*> {
        return 0u;
    }
    unsigned int loopCount = this.parent.getLoopNestingDepth();
    if this.scopeType == ScopeType::WHILE_BODY || this.scopeType == ScopeType::FOR_BODY || this.scopeType == ScopeType::FOREACH_BODY {
        loopCount++;
    }
    return loopCount;
}

/**
 * Check if this scope is within a case branch
 *
 * @return Within a case branch or not
 */
public f<bool> Scope.isInCaseBranch() {
    assert !this.isRootScope();
    if this.parent.parent == nil<Scope*> {
        return false;
    }
    if this.scopeType == ScopeType::CASE_BODY {
        return true;
    }
    return this.parent.isInCaseBranch();
}

/**
 * Check if unsafe operations are allowed in this scope. This is the case in unsafe blocks and all scopes within them.
 *
 * @return Allowed or not
 */
public f<bool> Scope.doesAllowUnsafeOperations() {
    if this.scopeType == ScopeType::UNSAFE_BODY {
        return true;
    }
    return !this.isRootScope() && this.parent.doesAllowUnsafeOperations();
}

/**
 * Check if the source file of this scope is imported by the source file of the asking scope
 *
 * @param askingScope Scope, that asks
 * @return Imported or not
 */
public f<bool> Scope.isImportedBy(const Scope* askingScope) {
    return askingScope.sourceFile.imports(this.sourceFile);
}

/**
 * Get JSON representation of the symbol table.
 * The returned heap-allocated JSON value is owned by the caller.
 *
 * @return Symbol table as JSON object
 */
public f<JsonValue*> Scope.getSymbolTableJSON() {
    result = this.symbolTable.toJSON();

    // Collect all children. The host keeps them in an ordered map, so sort them by name
    Map<String, Scope*> sortedChildren;
    foreach Pair<const String&, Scope*&> childEntry : this.children {
        sortedChildren.insert(childEntry.getFirst(), childEntry.getSecond());
    }
    JsonValue* jsonChildren = __new<JsonValue>(JsonValueKind::JSON_ARRAY);
    foreach Pair<const String&, Scope*&> childEntry : sortedChildren {
        Scope* childScope = childEntry.getSecond();
        JsonValue* c = childScope.getSymbolTableJSON();
        setJsonField(c, String("name"), __new<JsonValue>(childEntry.getFirst())); // Inject symbol table name into JSON object
        jsonChildren.addArrayItem(c);
    }
    setJsonField(result, String("children"), jsonChildren);
}

/**
 * Create a child scope and return it
 *
 * @param scopeName Name of the child scope
 * @param scopeType Type of the child scope
 * @param declCodeLoc Code location of the scope
 * @return Child scope (heap allocated)
 */
public f<Scope*> Scope.createChildScope(const String& scopeName, ScopeType scopeType, const CodeLoc *declCodeLoc) {
    // Reserve stable storage for the child in this scope's pool and construct it in place (no Scope copy).
    Scope* child = this.childAllocator.reserve<Scope>();
    unsafe {
        __placement_new<Scope>(child, this, this.sourceFile, scopeType, declCodeLoc);
    }
    this.children.upsert(scopeName, child);
    return child;
}

/**
 * Rename the child scope. This is useful for realizing function overloading by storing a function with not
 * only its name, but also its signature
 *
 * @param oldName Old name of the child table
 * @param newName New name of the child table
 */
public p Scope.renameChildScope(const String& oldName, const String& newName) {
    assert this.children.contains(oldName) && !this.children.contains(newName);
    // Re-key the owning pointer; the pooled Scope itself is not moved or copied.
    Scope* child = this.children.get(oldName);
    this.children.upsert(newName, child);
    this.children.remove(oldName);
}

/**
 * Duplicates the child scope by copying it. The duplicated symbols point to the original ones.
 *
 * @param oldName Old name of the child block
 * @param newName New block name
 * @return New scope
 */
public f<Scope*> Scope.copyChildScope(const String& oldName, const String& newName) {
    assert this.children.contains(oldName) && !this.children.contains(newName);
    // Create copy. The host copy-constructs the scope into a new shared_ptr. Here, the copy is constructed in place in the
    // pool of this scope, which owns it (no Scope copy).
    Scope* oldScope = this.children.get(oldName);
    Scope* newScope = this.childAllocator.reserve<Scope>();
    unsafe {
        __placement_new<Scope>(newScope, this, oldScope.sourceFile, oldScope.scopeType, oldScope.codeLoc);
    }
    oldScope.deepCopyScope(newScope);
    // Save copy under new name
    this.children.upsert(newName, newScope);
    return newScope;
}

/**
 * Deep copy the current scope and all its children into the given scope. The target scope must be freshly constructed with
 * the same parent, source file, scope type and code location as the current scope. The host returns the copy instead, but
 * Spice scopes are owned by the pool of their parent scope, so the caller allocates the target.
 *
 * @param newScope Target scope of the copy
 */
public p Scope.deepCopyScope(Scope* newScope) {
    // Copy the members, like the copy ctor of the host scope does
    newScope.symbolTable.copyContentsFrom(this.symbolTable);
    newScope.isGenericScope = this.isGenericScope;
    newScope.isAsyncScope = this.isAsyncScope;
    newScope.isDtorScope = this.isDtorScope;
    newScope.functions = this.functions;
    newScope.structs = this.structs;
    newScope.interfaces = this.interfaces;
    newScope.unions = this.unions;
    newScope.genericTypes = this.genericTypes;
    // Deep copy the children. Their parent and symbol table parent point to the new scope (set by the ctor)
    foreach Pair<const String&, Scope*&> childEntry : this.children {
        Scope* oldChild = childEntry.getSecond();
        Scope* newChild = newScope.childAllocator.reserve<Scope>();
        unsafe {
            __placement_new<Scope>(newChild, newScope, oldChild.sourceFile, oldChild.scopeType, oldChild.codeLoc);
        }
        oldChild.deepCopyScope(newChild);
        newScope.children.upsert(childEntry.getFirst(), newChild);
    }
}

/**
 * Get a child scope of the current scope by its name
 *
 * @param scopeName Child scope name
 * @return Child scope
 */
public f<Scope*> Scope.getChildScope(const String& scopeName) {
    if this.children.contains(scopeName) {
        return this.children.get(scopeName);
    }
    return nil<Scope*>;
}

/**
 * Retrieve all variables in the current scope, that have reached the end of their lifetime at the end of this scope
 *
 * @return Collection of EOL variables
 */
public f<Vector<SymbolTableEntry*>> Scope.getVarsGoingOutOfScope() {
    assert this.parent != nil<Scope*>; // Should not be called in root scope
    Vector<SymbolTableEntry*> varsGoingOutOfScope;

    // Collect all variables in this scope
    foreach Pair<const String&, SymbolTableEntry&> symbol : this.symbolTable.symbols {
        const String& name = symbol.getFirst();
        SymbolTableEntry& entry = symbol.getSecond();
        // Skip 'this' and result variables
        if name == THIS_VARIABLE_NAME || name == RETURN_VARIABLE_NAME {
            continue;
        }
        // Skip parameters (ToDo: Remove when copy constructors work for by-value argument passing)
        if entry.isParam {
            continue;
        }
        // Found variable, that goes out of scope
        varsGoingOutOfScope.pushBack(&entry);
    }

    // If this is the scope of a dtor, also return all fields of the struct
    if this.isDtorScope {
        assert this.parent != nil<Scope*> && this.parent.scopeType == ScopeType::STRUCT;
        // Get all fields of the struct
        const dyn fctOptions = [SuperType::TY_FUNCTION, SuperType::TY_PROCEDURE];
        foreach Pair<const String&, SymbolTableEntry&> field : this.parent.symbolTable.symbols {
            SymbolTableEntry& entry = field.getSecond();
            const QualType& qualType = entry.getQualType();
            if !qualType.isOneOf(fctOptions, len(fctOptions)) {
                varsGoingOutOfScope.pushBack(&entry);
            }
        }
    }

    return varsGoingOutOfScope;
}
