// Std imports
import "std/type/any";
import "std/data/vector";
import "std/io/filepath";
import "std/bindings/llvm/llvm" as llvm;

// Own imports
import "bootstrap/compiler-pass";
import "bootstrap/driver";
import "bootstrap/ast/ast-nodes";
import "bootstrap/ast/attributes";
import "bootstrap/ast/abstract-ast-visitor-intf";
import "bootstrap/exception/error-manager";
import "bootstrap/exception/semantic-error";
import "bootstrap/global/global-resource-manager";
import "bootstrap/model/struct";
import "bootstrap/model/interface";
import "bootstrap/model/union";
import "bootstrap/reader/code-loc";
import "bootstrap/source-file";
import "bootstrap/symboltablebuilder/qual-type";
import "bootstrap/symboltablebuilder/scope";
import "bootstrap/symboltablebuilder/super-type";
import "bootstrap/symboltablebuilder/symbol-table-entry";
import "bootstrap/symboltablebuilder/type-qualifiers";

// Reserved names (THIS_VARIABLE_NAME, RETURN_VARIABLE_NAME, CTOR_FUNCTION_NAME and DTOR_FUNCTION_NAME live in symbol-table-entry.spice)
const string MAIN_FUNCTION_NAME = "main";
public const string UNUSED_VARIABLE_NAME = "_";
const string ENUM_SCOPE_PREFIX = "enum:";

/**
 * Jobs:
 * - Build symbol table
 *
 * Error handling: the host throws a SemanticError at the first problem. Spice has no exceptions, so this pass records a
 * soft error and returns from the visit method of the offending node instead (SourceFile.checkForSoftErrors() aborts the
 * compilation afterwards).
 */
public type SymbolTableBuilder struct : IAbstractAstVisitor {
    compose public CompilerPass compilerPass
    bool hasMainFunction = false
}

public p SymbolTableBuilder.ctor(GlobalResourceManager& resourceManager, SourceFile* sourceFile) {
    this.compilerPass = CompilerPass(resourceManager, sourceFile);
}

// ─── entry point ──────────────────────────────────────────────────────────────

// Generic double-dispatch entry point required by IAbstractAstVisitor. source-file.spice calls the concrete
// visit(ASTEntryNode*) overload below.
#[ignoreUnusedReturnValue]
public f<Any> SymbolTableBuilder.visit(IVisitable* node) {
    return node.accept(cast<IAbstractAstVisitor*>(this));
}

#[ignoreUnusedReturnValue]
public f<Any> SymbolTableBuilder.visit(ASTEntryNode* node) {
    return this.visitEntry(node);
}

// ─── helpers ──────────────────────────────────────────────────────────────────

// Default behavior of every visit method that is not implemented below: visit all children (like the host's ASTVisitor)
#[ignoreUnusedReturnValue]
f<Any> SymbolTableBuilder.visitChildren(ASTNode* node) {
    return visitChildrenOf(node, cast<IAbstractAstVisitor*>(this));
}

// All errors of the symbol table builder are hard errors (thrown as SemanticError in the host)
p SymbolTableBuilder.reportError(const ASTNode* node, SemanticErrorType errorType, const String& message, bool printErrorMessage = true) {
    ErrorManager& errorManager = this.resourceManager.getErrorManager();
    errorManager.addHardError(node, errorType, message, printErrorMessage);
}

// Entry name of a function/procedure in its symbol table. Mirrors Function::getSymbolTableEntryName of the host, which
// cannot be called here because the model's version is an instance method.
f<String> getFctSymbolTableEntryName(const String& name, const CodeLoc& codeLoc) {
    return name + ":" + codeLoc.toString();
}

/**
 * Build the qualifiers of a definition. 'public' is always allowed, 'inline' and 'const' only if requested.
 *
 * @return True if all qualifiers were allowed. Otherwise, an error was reported
 */
f<bool> SymbolTableBuilder.buildQualifiers(ASTQualifierLstNode* qualifierLst, TypeQualifiers& qualifiers, bool allowInlineAndConst, const String& illegalMessage) {
    if qualifierLst == nil<ASTQualifierLstNode*> {
        return true;
    }
    foreach ASTQualifierNode* qualifier : qualifierLst.qualifiers {
        if qualifier.qualifierType == QualifierType::PUBLIC {
            qualifiers.isPublic = true;
        } else if allowInlineAndConst && qualifier.qualifierType == QualifierType::INLINE {
            qualifiers.isInline = true;
        } else if allowInlineAndConst && qualifier.qualifierType == QualifierType::CONST {
            qualifiers.isConst = true;
        } else {
            this.reportError(cast<ASTNode*>(qualifier), SemanticErrorType::QUALIFIER_AT_ILLEGAL_CONTEXT, illegalMessage);
            return false;
        }
    }
    return true;
}

/**
 * Visit an expression in a scope of its own. That scope holds the temporaries of the expression, which allows destructing
 * them right after the expression was evaluated. This is required for conditions and for operands that are only evaluated
 * conditionally, since a temporary of those must not be destructed if it never was constructed.
 *
 * @param expr Expression to visit
 */
p SymbolTableBuilder.visitInExprScope(IVisitable* expr) {
    // Create scope for the expression
    const CodeLoc& exprCodeLoc = expr.getCodeLoc();
    Scope* exprScope = this.currentScope.createChildScope(getExprScopeId(expr), ScopeType::EXPR_BODY, &exprCodeLoc);
    this.currentScope = exprScope;

    // Visit the expression
    this.visit(expr);

    // Leave expression scope
    this.currentScope = exprScope.parent;
}

// Shared implementation of visitFctDef and visitProcDef
f<Any> SymbolTableBuilder.visitFctOrProcDef(ASTFctDefBaseNode* node, bool isFunction, const String& scopeId) {
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Visit attributes
    if node.attrs != nil<IVisitable*> {
        this.visit(node.attrs);
    }

    // Build function qualifiers
    const String illegalMessage = isFunction ? String("Cannot use this qualifier on a function definition") : String("Cannot use this qualifier on a procedure definition");
    if !this.buildQualifiers(node.qualifierLst, node.qualifiers, true, illegalMessage) {
        return Any();
    }

    // Change to struct scope if this function is a method
    Scope* structScope = nil<Scope*>;
    if node.isMethod {
        const QualTypeList noTemplateTypes;
        const String structScopeName = getStructScopeName(node.name.structName, noTemplateTypes);
        structScope = this.currentScope.getChildScope(structScopeName);
        if structScope == nil<Scope*> {
            this.reportError(baseNode, SemanticErrorType::REFERENCED_UNDEFINED_STRUCT, "Struct '" + node.name.structName + "' could not be found");
            return Any();
        }
        node.structScope = structScope;
        this.currentScope = structScope;
    }

    // Create scope for the function
    Scope* fctScope = this.currentScope.createChildScope(scopeId, ScopeType::FUNC_PROC_BODY, &node.codeLoc);
    node.scope = fctScope;
    this.currentScope = fctScope;
    fctScope.isGenericScope = node.hasTemplateTypes || (structScope != nil<Scope*> && structScope.isGenericScope);
    if !isFunction {
        fctScope.isDtorScope = node.isMethod && node.name.name == DTOR_FUNCTION_NAME;
    }

    // Create symbol for 'this' variable
    if node.isMethod {
        fctScope.insert(String(THIS_VARIABLE_NAME), baseNode);
    }

    // Create symbol for 'result' variable
    if isFunction {
        fctScope.insert(String(RETURN_VARIABLE_NAME), baseNode);
    }

    // Create symbols for the parameters
    if node.hasParams {
        this.visit(node.paramLst);
    }

    // Visit the function body
    this.visit(node.body);

    // Leave function body scope
    this.currentScope = fctScope.parent;

    // Insert symbol for function into the symbol table
    node.entry = this.currentScope.insert(getFctSymbolTableEntryName(node.name.name, node.codeLoc), baseNode);

    // Add to external name registry
    // if a function has overloads, they both refer to the same entry in the registry. So we only register the name once
    if !this.sourceFile.hasNameRegistryTarget(node.name.fqName, node.entry) {
        const unsigned long typeId = isFunction ? cast<unsigned long>(SuperType::TY_FUNCTION) : cast<unsigned long>(SuperType::TY_PROCEDURE);
        this.sourceFile.addNameRegistryEntry(node.name.fqName, typeId, node.entry, this.currentScope, true, nil<SymbolTableEntry*>);
    }

    // Leave the struct scope
    if node.isMethod {
        this.currentScope = structScope.parent;
    }

    return Any();
}

// ─── real logic ───────────────────────────────────────────────────────────────

public f<Any> SymbolTableBuilder.visitEntry(ASTEntryNode* node) {

    // Initialize
    this.currentScope = this.rootScope;

    // Visit children: module attributes, imports (already handled by the import collector) and top level definitions
    foreach IVisitable* modAttr : node.modAttrs {
        this.visit(modAttr);
    }
    foreach IVisitable* importDef : node.importDefs {
        this.visit(importDef);
    }
    foreach IVisitable* topLevelDef : node.topLevelDefs {
        this.visit(topLevelDef);
    }

    // Check if the main function exists
    const bool mainFctRequired = this.cliOptions.outputContainer == OutputContainer::EXECUTABLE && !this.cliOptions.noEntryFct;
    if this.sourceFile.isMainSourceFile() && mainFctRequired && !this.hasMainFunction {
        this.reportError(cast<ASTNode*>(node), SemanticErrorType::MISSING_MAIN_FUNCTION, String("No main function found"), false);
    }

    return Any();
}

public f<Any> SymbolTableBuilder.visitMainFctDef(ASTMainFctDefNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Visit attributes
    if node.attrs != nil<IVisitable*> {
        this.visit(node.attrs);
    }

    // Check if the function is already defined
    if this.rootScope.lookupStrict(String(MAIN_FUNCTION_NAME)) != nil<SymbolTableEntry*> {
        this.reportError(baseNode, SemanticErrorType::FUNCTION_DECLARED_TWICE, String("Main function is declared twice"));
        return Any();
    }

    // Insert symbol for main function
    SymbolTableEntry* mainFctEntry = this.currentScope.insert(String(MAIN_FUNCTION_NAME), baseNode);
    mainFctEntry.used = true;

    // Create scope for main function body
    Scope* bodyScope = this.rootScope.createChildScope(node.getScopeId(), ScopeType::FUNC_PROC_BODY, &node.codeLoc);
    node.bodyScope = bodyScope;
    this.currentScope = bodyScope;
    bodyScope.isGenericScope = false;

    // Declare variable for the return value in the function scope
    SymbolTableEntry* resultVarEntry = bodyScope.insert(String(RETURN_VARIABLE_NAME), baseNode);
    resultVarEntry.used = true;

    // Visit arguments in new scope
    if node.takesArgs {
        this.visit(node.paramLst);
    }

    // Visit function body in new scope
    this.visit(node.body);

    // Return to root scope
    this.currentScope = this.rootScope;

    this.hasMainFunction = true;
    return Any();
}

public f<Any> SymbolTableBuilder.visitFctDef(ASTFctDefNode* node) {
    return this.visitFctOrProcDef(cast<ASTFctDefBaseNode*>(node), true, node.getScopeId());
}

public f<Any> SymbolTableBuilder.visitProcDef(ASTProcDefNode* node) {
    dyn outcome = this.visitFctOrProcDef(cast<ASTFctDefBaseNode*>(node), false, node.getScopeId());

    // Check if this is a constructor (the name is empty if visiting the definition failed early)
    const Vector<String>& fragments = node.name.nameFragments;
    if !fragments.isEmpty() {
        node.isCtor = fragments.get(fragments.getSize() - 1l) == CTOR_FUNCTION_NAME;
    }

    return outcome;
}

public f<Any> SymbolTableBuilder.visitStructDef(ASTStructDefNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Visit attributes
    if node.attrs != nil<IVisitable*> {
        this.visit(node.attrs);
    }

    // Check if this name already exists
    if this.rootScope.lookupStrict(node.structName) != nil<SymbolTableEntry*> {
        this.reportError(baseNode, SemanticErrorType::DUPLICATE_SYMBOL, "Duplicate symbol '" + node.structName + "'");
        return Any();
    }

    // Create scope for the struct
    const QualTypeList noTemplateTypes;
    Scope* structScope = this.rootScope.createChildScope(getStructScopeName(node.structName, noTemplateTypes), ScopeType::STRUCT, &node.codeLoc);
    node.structScope = structScope;
    this.currentScope = structScope;
    structScope.isGenericScope = node.hasTemplateTypes;

    // Insert implicit field for each interface type
    if node.hasInterfaces {
        foreach ASTDataTypeNode* interfaceNode : node.interfaceTypeLst.dataTypes {
            const Vector<String>& fragments = interfaceNode.baseDataType.customDataType.typeNameFragments;
            const String& interfaceName = fragments.get(fragments.getSize() - 1l);
            SymbolTableEntry* interfaceFieldEntry = structScope.insert(String("this.") + interfaceName, cast<ASTNode*>(interfaceNode));
            interfaceFieldEntry.used = true;
            interfaceFieldEntry.isImplicitField = true;
        }
    }

    // Visit fields
    foreach IVisitable* field : node.fields {
        this.visit(field);
    }

    // Leave the struct scope
    this.currentScope = structScope.parent;

    // Build struct qualifiers
    if !this.buildQualifiers(node.qualifierLst, node.qualifiers, false, String("Cannot use this qualifier on a struct definition")) {
        return Any();
    }

    // Add the struct to the symbol table
    node.entry = this.rootScope.insert(node.structName, baseNode);
    // Register the name in the exported name registry
    this.sourceFile.addNameRegistryEntry(node.structName, node.typeId, node.entry, structScope, true, nil<SymbolTableEntry*>);

    return Any();
}

public f<Any> SymbolTableBuilder.visitInterfaceDef(ASTInterfaceDefNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Visit attributes
    if node.attrs != nil<IVisitable*> {
        this.visit(node.attrs);
    }

    // Check if this name already exists
    if this.rootScope.lookupStrict(node.interfaceName) != nil<SymbolTableEntry*> {
        this.reportError(baseNode, SemanticErrorType::DUPLICATE_SYMBOL, "Duplicate symbol '" + node.interfaceName + "'");
        return Any();
    }

    // Create scope for the interface
    const QualTypeList noTemplateTypes;
    Scope* interfaceScope = this.rootScope.createChildScope(getInterfaceScopeName(node.interfaceName, noTemplateTypes), ScopeType::INTERFACE, &node.codeLoc);
    node.interfaceScope = interfaceScope;
    this.currentScope = interfaceScope;

    // Visit signatures
    foreach IVisitable* signature : node.signatures {
        this.visit(signature);
    }

    // Leave the interface scope
    this.currentScope = interfaceScope.parent;

    // Build interface qualifiers
    if !this.buildQualifiers(node.qualifierLst, node.qualifiers, false, String("Cannot use this qualifier on an interface definition")) {
        return Any();
    }

    // Add the interface to the symbol table
    node.entry = this.rootScope.insert(node.interfaceName, baseNode);
    // Register the name in the exported name registry
    this.sourceFile.addNameRegistryEntry(node.interfaceName, node.typeId, node.entry, interfaceScope, true, nil<SymbolTableEntry*>);

    return Any();
}

public f<Any> SymbolTableBuilder.visitUnionDef(ASTUnionDefNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Visit attributes
    if node.attrs != nil<IVisitable*> {
        this.visit(node.attrs);
    }

    // Check if this name already exists
    if this.rootScope.lookupStrict(node.unionName) != nil<SymbolTableEntry*> {
        this.reportError(baseNode, SemanticErrorType::DUPLICATE_SYMBOL, "Duplicate symbol '" + node.unionName + "'");
        return Any();
    }

    // Create scope for the union
    const QualTypeList noTemplateTypes;
    Scope* unionScope = this.rootScope.createChildScope(getUnionScopeName(node.unionName, noTemplateTypes), ScopeType::UNION, &node.codeLoc);
    node.unionScope = unionScope;
    this.currentScope = unionScope;
    unionScope.isGenericScope = node.hasTemplateTypes;

    // Visit fields
    foreach IVisitable* field : node.fields {
        this.visit(field);
    }

    // Leave the union scope
    this.currentScope = unionScope.parent;

    // Build union qualifiers
    if !this.buildQualifiers(node.qualifierLst, node.qualifiers, false, String("Cannot use this qualifier on a union definition")) {
        return Any();
    }

    // Add the union to the symbol table
    node.entry = this.rootScope.insert(node.unionName, baseNode);
    // Register the name in the exported name registry
    this.sourceFile.addNameRegistryEntry(node.unionName, node.typeId, node.entry, unionScope, true, nil<SymbolTableEntry*>);

    return Any();
}

public f<Any> SymbolTableBuilder.visitEnumDef(ASTEnumDefNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Check if this name already exists
    if this.rootScope.lookupStrict(node.enumName) != nil<SymbolTableEntry*> {
        this.reportError(baseNode, SemanticErrorType::DUPLICATE_SYMBOL, "Duplicate symbol '" + node.enumName + "'");
        return Any();
    }

    // Create scope for the enum
    Scope* enumScope = this.rootScope.createChildScope(String(ENUM_SCOPE_PREFIX) + node.enumName, ScopeType::ENUM, &node.codeLoc);
    node.enumScope = enumScope;
    this.currentScope = enumScope;

    // Visit items
    this.visit(node.itemLst);

    // Leave the enum scope
    this.currentScope = enumScope.parent;

    // Build enum qualifiers
    if !this.buildQualifiers(node.qualifierLst, node.qualifiers, false, String("Cannot use this qualifier on an enum definition")) {
        return Any();
    }

    // Add the enum to the symbol table
    node.entry = this.rootScope.insert(node.enumName, baseNode);
    // Register the name in the exported name registry
    this.sourceFile.addNameRegistryEntry(node.enumName, node.typeId, node.entry, enumScope, true, nil<SymbolTableEntry*>);

    return Any();
}

public f<Any> SymbolTableBuilder.visitGenericTypeDef(ASTGenericTypeDefNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Check if this name already exists
    if this.rootScope.lookupStrict(node.typeName) != nil<SymbolTableEntry*> {
        this.reportError(baseNode, SemanticErrorType::DUPLICATE_SYMBOL, "Duplicate symbol '" + node.typeName + "'");
        return Any();
    }

    // Create the generic type to the symbol table
    node.entry = this.rootScope.insert(node.typeName, baseNode);
    node.entry.used = true; // Generic types are always used

    return Any();
}

public f<Any> SymbolTableBuilder.visitAliasDef(ASTAliasDefNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Check if this name already exists
    if this.rootScope.lookupStrict(node.aliasName) != nil<SymbolTableEntry*> {
        this.reportError(baseNode, SemanticErrorType::DUPLICATE_SYMBOL, "Duplicate symbol '" + node.aliasName + "'");
        return Any();
    }

    // Build alias qualifiers
    if !this.buildQualifiers(node.qualifierLst, node.qualifiers, false, String("Cannot use this qualifier on an alias definition")) {
        return Any();
    }

    // Add the alias to the symbol table
    node.entry = this.rootScope.insert(node.aliasName, baseNode);
    // Register the name in the exported name registry
    this.sourceFile.addNameRegistryEntry(node.aliasName, node.typeId, node.entry, this.rootScope, true, nil<SymbolTableEntry*>);

    // Add another symbol for the aliased type container
    node.aliasedTypeContainerEntry = this.rootScope.insert(node.aliasName + ALIAS_CONTAINER_SUFFIX, baseNode);

    return Any();
}

public f<Any> SymbolTableBuilder.visitGlobalVarDef(ASTGlobalVarDefNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Check if this name already exists
    if this.rootScope.lookupStrict(node.varName) != nil<SymbolTableEntry*> {
        this.reportError(baseNode, SemanticErrorType::DUPLICATE_SYMBOL, "Duplicate symbol '" + node.varName + "'");
        return Any();
    }

    // Check if global already exists in an imported source file
    if this.sourceFile.anyDependencyExports(node.varName) {
        this.reportError(baseNode, SemanticErrorType::GLOBAL_DECLARED_TWICE, "Duplicate global variable '" + node.varName + "' in other module");
        return Any();
    }

    // Add the global to the symbol table
    node.entry = this.rootScope.insert(node.varName, baseNode);
    // Register the name in the exported name registry
    this.sourceFile.addNameRegistryEntry(node.varName, cast<unsigned long>(SuperType::TY_INVALID), node.entry, this.currentScope, true, nil<SymbolTableEntry*>);

    return Any();
}

public f<Any> SymbolTableBuilder.visitExtDecl(ASTExtDeclNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Visit attributes
    if node.attrs != nil<IVisitable*> {
        this.visit(node.attrs);
    }

    // Check if this name already exists
    if this.rootScope.lookupStrict(node.extFunctionName) != nil<SymbolTableEntry*> {
        this.reportError(baseNode, SemanticErrorType::DUPLICATE_SYMBOL, "Duplicate symbol '" + node.extFunctionName + "'");
        return Any();
    }

    // Create scope for the external function (this is required in case of forceSubstantiation in FunctionManager::matchFunction)
    this.rootScope.createChildScope(node.getScopeId(), ScopeType::FUNC_PROC_BODY, &node.codeLoc);

    // Add the external declaration to the symbol table
    node.entry = this.rootScope.insert(node.extFunctionName, baseNode);
    // Register the name in the exported name registry
    const unsigned long typeId = node.returnType != nil<ASTDataTypeNode*> ? cast<unsigned long>(SuperType::TY_FUNCTION) : cast<unsigned long>(SuperType::TY_PROCEDURE);
    this.sourceFile.addNameRegistryEntry(node.extFunctionName, typeId, node.entry, this.rootScope, true, nil<SymbolTableEntry*>);

    return Any();
}

public f<Any> SymbolTableBuilder.visitUnsafeBlock(ASTUnsafeBlockNode* node) {
    // Create scope for the unsafe block body
    Scope* bodyScope = this.currentScope.createChildScope(node.getScopeId(), ScopeType::UNSAFE_BODY, &node.codeLoc);
    node.bodyScope = bodyScope;
    this.currentScope = bodyScope;

    // Visit body
    this.visit(node.body);

    // Leave unsafe body scope
    this.currentScope = bodyScope.parent;

    return Any();
}

public f<Any> SymbolTableBuilder.visitForLoop(ASTForLoopNode* node) {

    // Create scope for the loop head. The loop variable lives across all iterations, so it must not go out of scope at the end of
    // each iteration, like the variables of the body scope do
    Scope* headScope = this.currentScope.createChildScope(node.getHeadScopeId(), ScopeType::FOR_HEAD, &node.codeLoc);
    this.currentScope = headScope;

    // Visit loop variable declaration
    this.visit(node.initDecl);

    // Visit condition
    this.visitInExprScope(node.condAssign);

    // Visit incrementer. Its temporaries are destructed after each evaluation, so it gets an expression scope of its own
    this.visitInExprScope(node.incAssign);

    // Create scope for the loop body
    Scope* bodyScope = this.currentScope.createChildScope(node.getScopeId(), ScopeType::FOR_BODY, &node.codeLoc);
    node.bodyScope = bodyScope;
    this.currentScope = bodyScope;

    // Visit body
    this.visit(node.body);

    // Leave for body and head scope
    this.currentScope = headScope.parent;

    return Any();
}

public f<Any> SymbolTableBuilder.visitForeachLoop(ASTForeachLoopNode* node) {

    // Create scope for the loop body
    Scope* bodyScope = this.currentScope.createChildScope(node.getScopeId(), ScopeType::FOREACH_BODY, &node.codeLoc);
    node.bodyScope = bodyScope;
    this.currentScope = bodyScope;

    // Visit index variable declaration
    if node.idxVarDecl != nil<IVisitable*> {
        this.visit(node.idxVarDecl);
    }

    // Visit item variable declaration
    this.visit(node.itemVarDecl);

    // Visit body
    this.visit(node.body);

    // Leave foreach body scope
    this.currentScope = bodyScope.parent;

    return Any();
}

public f<Any> SymbolTableBuilder.visitWhileLoop(ASTWhileLoopNode* node) {

    // Create scope for the loop body
    Scope* bodyScope = this.currentScope.createChildScope(node.getScopeId(), ScopeType::WHILE_BODY, &node.codeLoc);
    node.bodyScope = bodyScope;
    this.currentScope = bodyScope;

    // Visit condition
    this.visitInExprScope(node.condition);

    // Visit body
    this.visit(node.body);

    // Leave while body scope
    this.currentScope = bodyScope.parent;

    return Any();
}

public f<Any> SymbolTableBuilder.visitDoWhileLoop(ASTDoWhileLoopNode* node) {

    // Create scope for the loop body
    Scope* bodyScope = this.currentScope.createChildScope(node.getScopeId(), ScopeType::WHILE_BODY, &node.codeLoc);
    node.bodyScope = bodyScope;
    this.currentScope = bodyScope;

    // Visit condition
    this.visitInExprScope(node.condition);

    // Visit body
    this.visit(node.body);

    // Leave do-while body scope
    this.currentScope = bodyScope.parent;

    return Any();
}

public f<Any> SymbolTableBuilder.visitIfStmt(ASTIfStmtNode* node) {

    // Create scope for the then body
    Scope* thenBodyScope = this.currentScope.createChildScope(node.getScopeId(), ScopeType::IF_ELSE_BODY, &node.codeLoc);
    node.thenBodyScope = thenBodyScope;
    this.currentScope = thenBodyScope;

    // Visit condition
    this.visitInExprScope(node.condition);

    // Visit then body (manifestations do not exist yet, so both branches are always visited here)
    this.visit(node.thenBody);

    // Leave then body scope
    this.currentScope = thenBodyScope.parent;

    // Visit else stmt
    if node.elseStmt != nil<IVisitable*> {
        this.visit(node.elseStmt);
    }

    return Any();
}

public f<Any> SymbolTableBuilder.visitElseStmt(ASTElseStmtNode* node) {

    // Visit if statement in the case of an else if branch
    if node.isElseIf {
        this.visit(node.ifStmt);
        return Any();
    }

    // Create scope for the else body
    Scope* elseBodyScope = this.currentScope.createChildScope(node.getScopeId(), ScopeType::IF_ELSE_BODY, &node.codeLoc);
    node.elseBodyScope = elseBodyScope;
    this.currentScope = elseBodyScope;

    // Visit else body
    this.visit(node.body);

    // Leave else body scope
    this.currentScope = elseBodyScope.parent;

    return Any();
}

public f<Any> SymbolTableBuilder.visitCaseBranch(ASTCaseBranchNode* node) {
    // Create scope for the case branch
    Scope* bodyScope = this.currentScope.createChildScope(node.getScopeId(), ScopeType::CASE_BODY, &node.codeLoc);
    node.bodyScope = bodyScope;
    this.currentScope = bodyScope;

    // Visit case body
    this.visit(node.body);

    // Leave case body scope
    this.currentScope = bodyScope.parent;

    return Any();
}

public f<Any> SymbolTableBuilder.visitDefaultBranch(ASTDefaultBranchNode* node) {
    // Create scope for the default branch
    Scope* bodyScope = this.currentScope.createChildScope(node.getScopeId(), ScopeType::DEFAULT_BODY, &node.codeLoc);
    node.bodyScope = bodyScope;
    this.currentScope = bodyScope;

    // Visit default body
    this.visit(node.body);

    // Leave default body scope
    this.currentScope = bodyScope.parent;

    return Any();
}

public f<Any> SymbolTableBuilder.visitAnonymousBlockStmt(ASTAnonymousBlockStmtNode* node) {
    // Create scope for the anonymous block body
    Scope* bodyScope = this.currentScope.createChildScope(node.getScopeId(), ScopeType::ANONYMOUS_BLOCK_BODY, &node.codeLoc);
    node.bodyScope = bodyScope;
    this.currentScope = bodyScope;

    // Visit body
    this.visit(node.body);

    // Leave anonymous block body scope
    this.currentScope = bodyScope.parent;

    return Any();
}

#[ignoreUnusedReturnValue]
public f<Any> SymbolTableBuilder.visitEnumItem(ASTEnumItemNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Check if enum item already exists in the same scope.
    if this.currentScope.lookupStrict(node.itemName) != nil<SymbolTableEntry*> {
        this.reportError(baseNode, SemanticErrorType::VARIABLE_DECLARED_TWICE, "The enum item '" + node.itemName + "' was declared more than once");
        return Any();
    }

    // Add enum item entry to symbol table
    SymbolTableEntry* enumItemEntry = this.currentScope.insert(node.itemName, baseNode);

    // Add external registry entry
    assert node.enumDef != nil<ASTEnumDefNode*>;
    const String name = node.enumDef.enumName + SCOPE_ACCESS_TOKEN + node.itemName;
    this.sourceFile.addNameRegistryEntry(name, cast<unsigned long>(SuperType::TY_INT), enumItemEntry, this.currentScope, true, nil<SymbolTableEntry*>);

    return Any();
}

public f<Any> SymbolTableBuilder.visitField(ASTFieldNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Check if field already exists in the same scope.
    if this.currentScope.lookupStrict(node.fieldName) != nil<SymbolTableEntry*> {
        this.reportError(baseNode, SemanticErrorType::VARIABLE_DECLARED_TWICE, "The field '" + node.fieldName + "' was declared more than once");
        return Any();
    }

    // Add field entry to symbol table
    this.currentScope.insert(node.fieldName, baseNode);

    return Any();
}

public f<Any> SymbolTableBuilder.visitSignature(ASTSignatureNode* node) {
    // Build signature qualifiers
    if !this.buildQualifiers(node.qualifierLst, node.signatureQualifiers, true, String("Cannot use this qualifier on a signature definition")) {
        return Any();
    }

    // Add signature entry to symbol table. We append the code location to disambiguate overloaded signatures
    // (e.g. an interface declaring `getName()` and `getName(bool)`).
    node.entry = this.currentScope.insert(getFctSymbolTableEntryName(node.methodName, node.codeLoc), cast<ASTNode*>(node));

    return Any();
}

#[ignoreUnusedReturnValue]
public f<Any> SymbolTableBuilder.visitDeclStmt(ASTDeclStmtNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Check if variable already exists in the same scope.
    if this.currentScope.lookupStrict(node.varName) != nil<SymbolTableEntry*> {
        this.reportError(baseNode, SemanticErrorType::VARIABLE_DECLARED_TWICE, "The variable '" + node.varName + "' was declared more than once");
        return Any();
    }

    // Visit the right side
    if node.hasAssignment {
        this.visit(node.assignExpr);
    }

    // Add variable entry to symbol table
    SymbolTableEntry* varEntry = this.currentScope.insert(node.varName, baseNode);
    varEntry.isParam = node.isFctParam;

    return Any();
}

public f<Any> SymbolTableBuilder.visitModAttr(ASTModAttrNode* node) {
    // Visit attributes
    this.visitChildren(cast<ASTNode*>(node));
    // The host throws on an invalid attribute. Stop here, the compilation is aborted after this stage
    const ErrorManager& errorManager = this.resourceManager.getErrorManager();
    if errorManager.hasHardError {
        return Any();
    }

    // Retrieve attributes
    ASTAttrLstNode* attrs = node.attrLst;
    GlobalResourceManager& resourceManager = this.resourceManager;

    // Determine the target OS from the triple of the compilation
    const llvm::Triple& targetTriple = this.cliOptions.targetTriple;
    const bool isLinux = targetTriple.isOSLinux();
    const bool isDarwin = targetTriple.isOSDarwin();
    const bool isWindows = targetTriple.isOSWindows();

    // Collect and register linker flags.
    // On Linux, platform-independent flags (core.linker.flag) are wrapped in --start-group/--end-group
    // so the linker rescans the archive group until all circular symbol references are resolved (e.g.
    // LLVM's core static archives have mutual dependencies that alphabetical ordering cannot satisfy).
    const bool wrapInGroup = isLinux;

    // core.linker.flag - platform-independent; wrapped in a group on Linux
    Vector<CompileTimeValue> coreValues = attrs.getAttrValuesByName(String(ATTR_CORE_LINKER_FLAG));
    if wrapInGroup && !coreValues.isEmpty() {
        resourceManager.addLinkerFlag(String("-Wl,--start-group"));
        this.sourceFile.addSourceLinkerFlag(String("-Wl,--start-group"));
    }
    foreach CompileTimeValue value : coreValues {
        const String& flag = resourceManager.getCompileTimeStringValue(value.getStringValueOffset());
        resourceManager.addLinkerFlag(flag);
        this.sourceFile.addSourceLinkerFlag(flag);
    }
    if wrapInGroup && !coreValues.isEmpty() {
        resourceManager.addLinkerFlag(String("-Wl,--end-group"));
        this.sourceFile.addSourceLinkerFlag(String("-Wl,--end-group"));
    }

    // Platform-specific flags - always come after the (possibly grouped) core flags
    Vector<CompileTimeValue> platformValues;
    if isLinux {
        platformValues = attrs.getAttrValuesByName(String(ATTR_CORE_LINUX_LINKER_FLAG));
    } else if isDarwin {
        platformValues = attrs.getAttrValuesByName(String(ATTR_CORE_DARWIN_LINKER_FLAG));
    } else if isWindows {
        platformValues = attrs.getAttrValuesByName(String(ATTR_CORE_WINDOWS_LINKER_FLAG));
    }
    foreach CompileTimeValue value : platformValues {
        const String& flag = resourceManager.getCompileTimeStringValue(value.getStringValueOffset());
        resourceManager.addLinkerFlag(flag);
        this.sourceFile.addSourceLinkerFlag(flag);
    }

    // core.linker.additionalSource
    const Vector<CompileTimeValue> additionalSourceValues = attrs.getAttrValuesByName(String(ATTR_CORE_LINKER_ADDITIONAL_SOURCE));
    const FilePath& ownFilePath = this.sourceFile.getFilePath();
    foreach CompileTimeValue additionalSourceValue : additionalSourceValues {
        const String& stringValue = resourceManager.getCompileTimeStringValue(additionalSourceValue.getStringValueOffset());
        const FilePath additionalSourcePath = FilePath(ownFilePath.getParentDir()) / stringValue;
        resourceManager.addAdditionalSourcePath(additionalSourcePath);
        this.sourceFile.addSourceAdditionalSourcePath(additionalSourcePath);
    }

    return Any();
}

public f<Any> SymbolTableBuilder.visitAttr(ASTAttrNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Check if this attribute exists
    AttrConfigValue config;
    if !getAttrConfig(node.key, config) {
        this.reportError(baseNode, SemanticErrorType::UNKNOWN_ATTR, "Unknown attribute '" + node.key + "'");
        return Any();
    }

    // Check if the target is correct
    if (cast<unsigned byte>(node.target) & config.target) == cast<unsigned byte>(0) {
        this.reportError(baseNode, SemanticErrorType::INVALID_ATTR_TARGET, "Attribute '" + node.key + "' cannot be used on this target");
        return Any();
    }

    // Check if a value is present
    if node.value == nil<ASTConstantNode*> && config.attrType != AttrType::TYPE_BOOL {
        this.reportError(baseNode, SemanticErrorType::MISSING_ATTR_VALUE, "Attribute '" + node.key + "' requires a value");
        return Any();
    }

    return Any();
}

// Shared by the lambda visit methods: an 'async' lambda attribute marks the lambda scope as async
p SymbolTableBuilder.applyLambdaAttr(ASTLambdaAttrNode* lambdaAttr, Scope* bodyScope) {
    if lambdaAttr != nil<ASTLambdaAttrNode*> && lambdaAttr.attrLst.hasAttr(String(ATTR_ASYNC)) {
        const CompileTimeValue isAsyncScopeAttrValue = lambdaAttr.attrLst.getAttrValueByName(String(ATTR_ASYNC));
        bodyScope.isAsyncScope = isAsyncScopeAttrValue.getBoolValue();
    }
}

public f<Any> SymbolTableBuilder.visitLambdaFunc(ASTLambdaFuncNode* node) {

    // Create scope for the lambda body
    Scope* bodyScope = this.currentScope.createChildScope(node.getScopeId(), ScopeType::LAMBDA_BODY, &node.codeLoc);
    node.bodyScope = bodyScope;
    this.currentScope = bodyScope;
    // Requires capturing because the LLVM IR will end up in a separate function
    bodyScope.symbolTable.setCapturingRequired();
    // Set to async scope if this is an async lambda
    this.applyLambdaAttr(node.lambdaAttr, bodyScope);

    // Create symbol for 'result' variable
    bodyScope.insert(String(RETURN_VARIABLE_NAME), cast<ASTNode*>(node));

    // Create symbols for the parameters
    if node.hasParams {
        this.visit(node.paramLst);
    }

    // Visit body
    this.visit(node.body);

    // Leave lambda body scope
    this.currentScope = bodyScope.parent;

    return Any();
}

public f<Any> SymbolTableBuilder.visitLambdaProc(ASTLambdaProcNode* node) {

    // Create scope for the lambda body
    Scope* bodyScope = this.currentScope.createChildScope(node.getScopeId(), ScopeType::LAMBDA_BODY, &node.codeLoc);
    node.bodyScope = bodyScope;
    this.currentScope = bodyScope;
    // Requires capturing because the LLVM IR will end up in a separate function
    bodyScope.symbolTable.setCapturingRequired();
    // Set to async scope if this is an async lambda
    this.applyLambdaAttr(node.lambdaAttr, bodyScope);

    // Create symbols for the parameters
    if node.hasParams {
        this.visit(node.paramLst);
    }

    // Visit body
    this.visit(node.body);

    // Leave lambda body scope
    this.currentScope = bodyScope.parent;

    return Any();
}

public f<Any> SymbolTableBuilder.visitLambdaExpr(ASTLambdaExprNode* node) {

    // Create scope for the lambda body
    Scope* bodyScope = this.currentScope.createChildScope(node.getScopeId(), ScopeType::LAMBDA_BODY, &node.codeLoc);
    node.bodyScope = bodyScope;
    this.currentScope = bodyScope;
    // Requires capturing because the LLVM IR will end up in a separate function
    bodyScope.symbolTable.setCapturingRequired();

    // Create symbols for the parameters
    if node.hasParams {
        this.visit(node.paramLst);
    }

    // Visit lambda expression
    this.visit(node.lambdaExpr);

    // Leave lambda body scope
    this.currentScope = bodyScope.parent;

    return Any();
}

public f<Any> SymbolTableBuilder.visitTernaryExpr(ASTTernaryExprNode* node) {
    // Visit condition, which is evaluated unconditionally
    this.visit(node.condition);

    // Visit the branches. Only one of them is evaluated, so each one gets its own scope for its temporaries.
    // The true branch does not exist for shortened ternaries, as the condition takes its place.
    if node.trueExpr != nil<IVisitable*> && !node.isShortened {
        this.visitInExprScope(node.trueExpr);
    }
    if node.falseExpr != nil<IVisitable*> {
        this.visitInExprScope(node.falseExpr);
    }

    return Any();
}

// Shared by the logical operators
f<Any> SymbolTableBuilder.visitOperands(const Vector<IVisitable*>& operands) {
    if operands.isEmpty() {
        return Any();
    }

    // Visit the first operand, which is evaluated unconditionally
    IVisitable* first = operands.get(0l);
    this.visit(first);

    // All further operands are only evaluated if the ones before did not short-circuit
    for unsigned long i = 1l; i < operands.getSize(); i++ {
        this.visitInExprScope(operands.get(i));
    }

    return Any();
}

public f<Any> SymbolTableBuilder.visitLogicalOrExpr(ASTLogicalOrExprNode* node) {
    return this.visitOperands(node.operands);
}

public f<Any> SymbolTableBuilder.visitLogicalAndExpr(ASTLogicalAndExprNode* node) {
    return this.visitOperands(node.operands);
}

public f<Any> SymbolTableBuilder.visitStmtLst(ASTStmtLstNode* node) {
    foreach IVisitable* stmt : node.statements {
        this.visit(stmt);
    }
    return Any();
}

public f<Any> SymbolTableBuilder.visitParamLst(ASTParamLstNode* node) {
    foreach ASTDeclStmtNode* param : node.params {
        this.visitDeclStmt(param);
    }
    return Any();
}

public f<Any> SymbolTableBuilder.visitEnumItemLst(ASTEnumItemLstNode* node) {
    foreach ASTEnumItemNode* item : node.items {
        this.visitEnumItem(item);
    }
    return Any();
}

