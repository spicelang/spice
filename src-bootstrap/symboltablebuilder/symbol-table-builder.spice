// ─── tests ────────────────────────────────────────────────────────────────────

// Build the environment every scenario needs: a root scope, a source file and a resource manager (both mocks)
// and the builder under test. The caller keeps ownership of all of them.
p setupMocks(Scope& root, MockSourceFile& file, MockResourceManager& resourceManager) {
    file.filePath = FilePath("/tmp/mock-main.spice");
    file.globalScopePtr = &root;
    resourceManager.cliOptions.targetTriple = llvm::Triple(String("x86_64"), String("unknown"), String("linux"));
}

f<bool> testMainFunctionRules() {
    Scope root = Scope(nil<Scope*>, nil<ISourceFile*>, ScopeType::GLOBAL, nil<CodeLoc*>);
    MockSourceFile file;
    MockResourceManager rm;
    setupMocks(root, file, rm);
    IGlobalResourceManager& resourceManager = rm;
    ISourceFile* sourceFile = &file;
    SymbolTableBuilder builder = SymbolTableBuilder(resourceManager, sourceFile);

    // An executable's main file without a main function is rejected
    ASTEntryNode emptyEntry = ASTEntryNode(CodeLoc(1l, 1l, "t.spice"));
    builder.visit(&emptyEntry);
    assert rm.errorManager.softErrors.getSize() == 1l;
    assert softErrorContains(rm.errorManager, 0l, "No main function found");

    // A file that is not the compilation root does not need one
    Scope root2 = Scope(nil<Scope*>, nil<ISourceFile*>, ScopeType::GLOBAL, nil<CodeLoc*>);
    MockSourceFile file2;
    MockResourceManager rm2;
    setupMocks(root2, file2, rm2);
    file2.isMain = false;
    IGlobalResourceManager& resourceManager2 = rm2;
    ISourceFile* sourceFile2 = &file2;
    SymbolTableBuilder builder2 = SymbolTableBuilder(resourceManager2, sourceFile2);
    ASTEntryNode emptyEntry2 = ASTEntryNode(CodeLoc(1l, 1l, "t.spice"));
    builder2.visit(&emptyEntry2);
    assert rm2.errorManager.softErrors.getSize() == 0l;

    // Declaring main creates its scope with the 'result' symbol, and declaring it twice is rejected
    Scope root3 = Scope(nil<Scope*>, nil<ISourceFile*>, ScopeType::GLOBAL, nil<CodeLoc*>);
    MockSourceFile file3;
    MockResourceManager rm3;
    setupMocks(root3, file3, rm3);
    IGlobalResourceManager& resourceManager3 = rm3;
    ISourceFile* sourceFile3 = &file3;
    SymbolTableBuilder builder3 = SymbolTableBuilder(resourceManager3, sourceFile3);
    ASTStmtLstNode body1 = ASTStmtLstNode(CodeLoc(2l, 1l, "t.spice"));
    ASTMainFctDefNode main1 = ASTMainFctDefNode(CodeLoc(1l, 1l, "t.spice"));
    main1.body = cast<IVisitable*>(&body1);
    ASTStmtLstNode body2 = ASTStmtLstNode(CodeLoc(12l, 1l, "t.spice"));
    ASTMainFctDefNode main2 = ASTMainFctDefNode(CodeLoc(11l, 1l, "t.spice"));
    main2.body = cast<IVisitable*>(&body2);
    ASTEntryNode entry3 = ASTEntryNode(CodeLoc(1l, 1l, "t.spice"));
    entry3.topLevelDefs.pushBack(cast<IVisitable*>(&main1));
    entry3.topLevelDefs.pushBack(cast<IVisitable*>(&main2));
    builder3.visit(&entry3);
    assert rm3.errorManager.softErrors.getSize() == 1l;
    assert softErrorContains(rm3.errorManager, 0l, "Main function is declared twice");
    assert root3.lookupStrict(String("main")) != nil<SymbolTableEntry*>;
    assert root3.lookupStrict(String("main")).used;
    Scope* mainScope = root3.getChildScope(String("fct:main"));
    assert mainScope != nil<Scope*>;
    assert mainScope.scopeType == ScopeType::FUNC_PROC_BODY;
    assert mainScope.lookupStrict(String(RETURN_VARIABLE_NAME)) != nil<SymbolTableEntry*>;
    assert main1.bodyScope == mainScope;
    assert main2.bodyScope == nil<IScope*>; // the duplicate got no scope
    return true;
}

f<bool> testDefinitionRules() {
    Scope root = Scope(nil<Scope*>, nil<ISourceFile*>, ScopeType::GLOBAL, nil<CodeLoc*>);
    MockSourceFile file;
    MockResourceManager rm;
    setupMocks(root, file, rm);
    file.isMain = false;
    IGlobalResourceManager& resourceManager = rm;
    ISourceFile* sourceFile = &file;
    SymbolTableBuilder builder = SymbolTableBuilder(resourceManager, sourceFile);

    // A struct gets a scope, an entry and an exported name registry entry. Its fields become symbols of that scope
    ASTFieldNode widthField = ASTFieldNode(CodeLoc(2l, 5l, "t.spice"));
    widthField.fieldName = String("width");
    ASTFieldNode duplicateField = ASTFieldNode(CodeLoc(3l, 5l, "t.spice"));
    duplicateField.fieldName = String("width");
    ASTStructDefNode rect = ASTStructDefNode(CodeLoc(1l, 1l, "t.spice"));
    rect.structName = String("Rectangle");
    rect.typeId = 300l;
    rect.fields.pushBack(cast<IVisitable*>(&widthField));
    rect.fields.pushBack(cast<IVisitable*>(&duplicateField));
    builder.visitStructDef(&rect);
    assert rm.errorManager.softErrors.getSize() == 1l;
    assert softErrorContains(rm.errorManager, 0l, "The field 'width' was declared more than once");
    assert rect.entry != nil<SymbolTableEntry*>;
    assert rect.entry == root.lookupStrict(String("Rectangle"));
    Scope* rectScope = root.getChildScope(String("struct:Rectangle"));
    assert rectScope != nil<Scope*>;
    assert rectScope.scopeType == ScopeType::STRUCT;
    assert rect.structScope == rectScope;
    assert rectScope.lookupStrict(String("width")) != nil<SymbolTableEntry*>;
    assert file.hasNameRegistryTarget(String("Rectangle"), rect.entry);
    assert file.registeredTypeIds.get(0l) == 300l;
    assert builder.currentScope == &root; // back in the root scope

    // Any other definition may not reuse the name
    ASTStructDefNode duplicateStruct = ASTStructDefNode(CodeLoc(10l, 1l, "t.spice"));
    duplicateStruct.structName = String("Rectangle");
    builder.visitStructDef(&duplicateStruct);
    assert rm.errorManager.softErrors.getSize() == 2l;
    assert softErrorContains(rm.errorManager, 1l, "Duplicate symbol 'Rectangle'");
    assert duplicateStruct.entry == nil<SymbolTableEntry*>;

    ASTGenericTypeDefNode genericDef = ASTGenericTypeDefNode(CodeLoc(11l, 1l, "t.spice"));
    genericDef.typeName = String("Rectangle");
    builder.visitGenericTypeDef(&genericDef);
    assert rm.errorManager.softErrors.getSize() == 3l;
    ASTGenericTypeDefNode okGeneric = ASTGenericTypeDefNode(CodeLoc(12l, 1l, "t.spice"));
    okGeneric.typeName = String("T");
    builder.visitGenericTypeDef(&okGeneric);
    assert okGeneric.entry != nil<SymbolTableEntry*>;
    assert okGeneric.entry.used; // generic types are always used

    // Only 'public' is a legal qualifier on a struct; the definition is not registered then
    ASTQualifierNode inlineQualifier = ASTQualifierNode(CodeLoc(13l, 1l, "t.spice"));
    inlineQualifier.qualifierType = QualifierType::INLINE;
    ASTQualifierLstNode qualifiers = ASTQualifierLstNode(CodeLoc(13l, 1l, "t.spice"));
    qualifiers.qualifiers.pushBack(&inlineQualifier);
    ASTStructDefNode badStruct = ASTStructDefNode(CodeLoc(13l, 1l, "t.spice"));
    badStruct.structName = String("Bad");
    badStruct.qualifierLst = &qualifiers;
    builder.visitStructDef(&badStruct);
    assert rm.errorManager.softErrors.getSize() == 4l;
    assert softErrorContains(rm.errorManager, 3l, "Cannot use this qualifier on a struct definition");
    assert root.lookupStrict(String("Bad")) == nil<SymbolTableEntry*>;
    ASTQualifierNode publicQualifier = ASTQualifierNode(CodeLoc(14l, 1l, "t.spice"));
    publicQualifier.qualifierType = QualifierType::PUBLIC;
    ASTQualifierLstNode publicQualifiers = ASTQualifierLstNode(CodeLoc(14l, 1l, "t.spice"));
    publicQualifiers.qualifiers.pushBack(&publicQualifier);
    ASTStructDefNode publicStruct = ASTStructDefNode(CodeLoc(14l, 1l, "t.spice"));
    publicStruct.structName = String("Public");
    publicStruct.qualifierLst = &publicQualifiers;
    builder.visitStructDef(&publicStruct);
    assert publicStruct.qualifiers.isPublic;
    assert rm.errorManager.softErrors.getSize() == 4l;

    // A method of a struct that does not exist
    ASTFctNameNode missingName = ASTFctNameNode(CodeLoc(20l, 1l, "t.spice"));
    missingName.name = String("run");
    missingName.structName = String("Missing");
    missingName.fqName = String("Missing.run");
    ASTProcDefNode missingMethod = ASTProcDefNode(CodeLoc(20l, 1l, "t.spice"));
    missingMethod.name = &missingName;
    missingMethod.isMethod = true;
    builder.visitProcDef(&missingMethod);
    assert rm.errorManager.softErrors.getSize() == 5l;
    assert softErrorContains(rm.errorManager, 4l, "Struct 'Missing' could not be found");
    assert builder.currentScope == &root;

    // Globals: duplicates within the file and across imported files are both rejected
    ASTGlobalVarDefNode global1 = ASTGlobalVarDefNode(CodeLoc(30l, 1l, "t.spice"));
    global1.varName = String("LIMIT");
    builder.visitGlobalVarDef(&global1);
    assert global1.entry != nil<SymbolTableEntry*>;
    ASTGlobalVarDefNode global2 = ASTGlobalVarDefNode(CodeLoc(31l, 1l, "t.spice"));
    global2.varName = String("LIMIT");
    builder.visitGlobalVarDef(&global2);
    assert rm.errorManager.softErrors.getSize() == 6l;
    assert softErrorContains(rm.errorManager, 5l, "Duplicate symbol 'LIMIT'");
    file.dependencyExportedNames.pushBack(String("SHARED"));
    ASTGlobalVarDefNode global3 = ASTGlobalVarDefNode(CodeLoc(32l, 1l, "t.spice"));
    global3.varName = String("SHARED");
    builder.visitGlobalVarDef(&global3);
    assert rm.errorManager.softErrors.getSize() == 7l;
    assert softErrorContains(rm.errorManager, 6l, "Duplicate global variable 'SHARED' in other module");
    assert global3.entry == nil<SymbolTableEntry*>;

    // Enums: items live in the enum scope and are exported as 'Enum::ITEM'
    ASTEnumDefNode colors = ASTEnumDefNode(CodeLoc(40l, 1l, "t.spice"));
    colors.enumName = String("Color");
    ASTEnumItemNode red = ASTEnumItemNode(CodeLoc(41l, 5l, "t.spice"));
    red.itemName = String("RED");
    red.enumDef = &colors;
    ASTEnumItemNode redAgain = ASTEnumItemNode(CodeLoc(42l, 5l, "t.spice"));
    redAgain.itemName = String("RED");
    redAgain.enumDef = &colors;
    ASTEnumItemLstNode items = ASTEnumItemLstNode(CodeLoc(41l, 1l, "t.spice"));
    items.items.pushBack(&red);
    items.items.pushBack(&redAgain);
    colors.itemLst = cast<IVisitable*>(&items);
    builder.visitEnumDef(&colors);
    assert rm.errorManager.softErrors.getSize() == 8l;
    assert softErrorContains(rm.errorManager, 7l, "The enum item 'RED' was declared more than once");
    Scope* colorScope = root.getChildScope(String("enum:Color"));
    assert colorScope != nil<Scope*>;
    assert colorScope.lookupStrict(String("RED")) != nil<SymbolTableEntry*>;
    assert file.hasNameRegistryTarget(String("Color::RED"), colorScope.lookupStrict(String("RED")));
    assert root.lookupStrict(String("Color")) != nil<SymbolTableEntry*>;

    // Aliases register a second symbol for the aliased type container
    ASTAliasDefNode lengthAlias = ASTAliasDefNode(CodeLoc(50l, 1l, "t.spice"));
    lengthAlias.aliasName = String("Length");
    builder.visitAliasDef(&lengthAlias);
    assert lengthAlias.entry != nil<SymbolTableEntry*>;
    assert lengthAlias.aliasedTypeContainerEntry != nil<SymbolTableEntry*>;
    assert root.lookupStrict(String("Length.container")) == lengthAlias.aliasedTypeContainerEntry;
    return true;
}

f<bool> testAttributeRules() {
    Scope root = Scope(nil<Scope*>, nil<ISourceFile*>, ScopeType::GLOBAL, nil<CodeLoc*>);
    MockSourceFile file;
    MockResourceManager rm;
    setupMocks(root, file, rm);
    IGlobalResourceManager& resourceManager = rm;
    ISourceFile* sourceFile = &file;
    SymbolTableBuilder builder = SymbolTableBuilder(resourceManager, sourceFile);

    // Unknown attribute
    ASTAttrNode unknownAttr = ASTAttrNode(CodeLoc(1l, 1l, "t.spice"));
    unknownAttr.key = String("no.such.attribute");
    unknownAttr.target = AttrTarget::TARGET_MODULE;
    builder.visitAttr(&unknownAttr);
    assert rm.errorManager.softErrors.getSize() == 1l;
    assert softErrorContains(rm.errorManager, 0l, "Unknown attribute 'no.such.attribute'");

    // Attribute on a target it does not support (a module attribute on a struct)
    ASTAttrNode wrongTarget = ASTAttrNode(CodeLoc(2l, 1l, "t.spice"));
    wrongTarget.key = String(ATTR_CORE_COMPILER_WARNINGS_IGNORE);
    wrongTarget.target = AttrTarget::TARGET_STRUCT;
    builder.visitAttr(&wrongTarget);
    assert rm.errorManager.softErrors.getSize() == 2l;
    assert softErrorContains(rm.errorManager, 1l, "cannot be used on this target");

    // Non-bool attributes need a value
    ASTAttrNode missingValue = ASTAttrNode(CodeLoc(3l, 1l, "t.spice"));
    missingValue.key = String(ATTR_CORE_LINKER_FLAG);
    missingValue.target = AttrTarget::TARGET_MODULE;
    builder.visitAttr(&missingValue);
    assert rm.errorManager.softErrors.getSize() == 3l;
    assert softErrorContains(rm.errorManager, 2l, "requires a value");

    // Bool attributes do not, and a fully valid attribute reports nothing
    ASTAttrNode boolAttr = ASTAttrNode(CodeLoc(4l, 1l, "t.spice"));
    boolAttr.key = String(ATTR_CORE_COMPILER_WARNINGS_IGNORE);
    boolAttr.target = AttrTarget::TARGET_MODULE;
    builder.visitAttr(&boolAttr);
    ASTAttrNode asyncOnLambda = ASTAttrNode(CodeLoc(5l, 1l, "t.spice"));
    asyncOnLambda.key = String(ATTR_ASYNC);
    asyncOnLambda.target = AttrTarget::TARGET_LAMBDA;
    builder.visitAttr(&asyncOnLambda);
    assert rm.errorManager.softErrors.getSize() == 3l;

    // Module attributes: linker flags (incl. the ones for the current OS only) and additional sources
    rm.compileTimeStrings.pushBack(String("-lm"));
    rm.compileTimeStrings.pushBack(String("-ldl"));
    rm.compileTimeStrings.pushBack(String("-framework Foo"));
    rm.compileTimeStrings.pushBack(String("extra.c"));
    ASTConstantNode flagValue = ASTConstantNode(CodeLoc(10l, 1l, "t.spice"));
    flagValue.compileTimeValue.stringValueOffset = 0l;
    ASTConstantNode linuxFlagValue = ASTConstantNode(CodeLoc(11l, 1l, "t.spice"));
    linuxFlagValue.compileTimeValue.stringValueOffset = 1l;
    ASTConstantNode darwinFlagValue = ASTConstantNode(CodeLoc(12l, 1l, "t.spice"));
    darwinFlagValue.compileTimeValue.stringValueOffset = 2l;
    ASTConstantNode sourceValue = ASTConstantNode(CodeLoc(13l, 1l, "t.spice"));
    sourceValue.compileTimeValue.stringValueOffset = 3l;
    ASTAttrNode flagAttr = ASTAttrNode(CodeLoc(10l, 1l, "t.spice"));
    flagAttr.key = String(ATTR_CORE_LINKER_FLAG);
    flagAttr.target = AttrTarget::TARGET_MODULE;
    flagAttr.value = &flagValue;
    ASTAttrNode linuxFlagAttr = ASTAttrNode(CodeLoc(11l, 1l, "t.spice"));
    linuxFlagAttr.key = String(ATTR_CORE_LINUX_LINKER_FLAG);
    linuxFlagAttr.target = AttrTarget::TARGET_MODULE;
    linuxFlagAttr.value = &linuxFlagValue;
    ASTAttrNode darwinFlagAttr = ASTAttrNode(CodeLoc(12l, 1l, "t.spice"));
    darwinFlagAttr.key = String(ATTR_CORE_DARWIN_LINKER_FLAG);
    darwinFlagAttr.target = AttrTarget::TARGET_MODULE;
    darwinFlagAttr.value = &darwinFlagValue;
    ASTAttrNode sourceAttr = ASTAttrNode(CodeLoc(13l, 1l, "t.spice"));
    sourceAttr.key = String(ATTR_CORE_LINKER_ADDITIONAL_SOURCE);
    sourceAttr.target = AttrTarget::TARGET_MODULE;
    sourceAttr.value = &sourceValue;
    ASTAttrLstNode attrLst = ASTAttrLstNode(CodeLoc(10l, 1l, "t.spice"));
    attrLst.attributes.pushBack(&flagAttr);
    attrLst.attributes.pushBack(&linuxFlagAttr);
    attrLst.attributes.pushBack(&darwinFlagAttr);
    attrLst.attributes.pushBack(&sourceAttr);
    ASTModAttrNode modAttr = ASTModAttrNode(CodeLoc(10l, 1l, "t.spice"));
    modAttr.attrLst = &attrLst;
    // The attribute list is a child of the module attribute (as the parser builds it), so its attributes get validated too
    modAttr.node.addChild(&attrLst.node);
    attrLst.node.visitable = cast<IVisitable*>(&attrLst);
    attrLst.node.addChild(&flagAttr.node);
    flagAttr.node.visitable = cast<IVisitable*>(&flagAttr);
    builder.visitModAttr(&modAttr);
    assert rm.errorManager.softErrors.getSize() == 3l; // the visited attribute was valid
    assert rm.linkerFlags.getSize() == 2l; // '-lm' (all OSes) and '-ldl' (linux only), but not the darwin flag
    assert rm.linkerFlags.get(0l) == "-lm";
    assert rm.linkerFlags.get(1l) == "-ldl";
    assert file.sourceLinkerFlags.getSize() == 2l;
    assert rm.additionalSourcePaths.getSize() == 1l;
    const FilePath& extraSource = rm.additionalSourcePaths.get(0l);
    assert String(extraSource.toGenericString()) == "/tmp/extra.c"; // relative to the source file
    assert file.sourceAdditionalSourcePaths.getSize() == 1l;
    return true;
}

#[test, test.name="SymbolTableBuilder Smoke test"]
public f<bool> testSymbolTableBuilderSmoke() {
    assert testMainFunctionRules();
    assert testDefinitionRules();
    assert testAttributeRules();
    return true;
}
