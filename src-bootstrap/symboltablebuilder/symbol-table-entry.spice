// Std imports
import "std/text/json/json-value";

// Own imports
import "bootstrap/ast/ast-nodes";
import "bootstrap/symboltablebuilder/scope";
import "bootstrap/symboltablebuilder/super-type";
import "bootstrap/symboltablebuilder/qual-type";
import "bootstrap/symboltablebuilder/lifecycle";
import "bootstrap/reader/code-loc";
import "bootstrap/util/common-util";
import "bootstrap/exception/compiler-error";

// Reserved function names for implicitly generated struct constructors/destructors
public const string CTOR_FUNCTION_NAME = "ctor";
public const string DTOR_FUNCTION_NAME = "dtor";

// Reserved variable names
public const string THIS_VARIABLE_NAME = "this";
public const string RETURN_VARIABLE_NAME = "result";

public type SymbolTableEntry struct {
    // Public fields
    public String name
    public Scope* scope
    public ASTNode* declNode
    public unsigned long orderIndex
    public bool global
    public bool isVolatile = false
    public bool isParam = false
    public bool anonymous = false
    public bool used = false
    public bool omitDtorCall = false
    public bool isImplicitField = false
    // Private fields
    QualType qualType
    Lifecycle lifecycle
}

public p SymbolTableEntry.ctor(const String& name, const QualType& qualType, Scope* scope, ASTNode* declNode, unsigned long orderIndex, bool global) {
    this.name = name;
    this.qualType = qualType;
    this.scope = scope;
    this.declNode = declNode;
    this.orderIndex = orderIndex;
    this.global = global;
}

/**
 * Retrieve the qualified type of this symbol
 *
 * @return Qualified type of this symbol
 */
public f<const QualType&> SymbolTableEntry.getQualType() {
    return this.qualType;
}

/**
 * Update the type of this symbol.
 *
 * @param newType New type of the current symbol
 * @param overwriteExistingType Overwrites the existing type without throwing an error
 */
public p SymbolTableEntry.updateType(const QualType& newType, bool overwriteExistingType) {
    const dyn options = [SuperType::TY_INVALID, SuperType::TY_DYN];
    assert overwriteExistingType || this.qualType.isOneOf(options, len(options));
    this.qualType = newType;
}

/**
 * Update the state of the current symbol
 *
 * @throws CompilerError When the state change is not valid
 *
 * @param newState New state of the current symbol
 * @param node AST node where the update takes place
 */
public p SymbolTableEntry.updateState(const LifecycleState& newState, ASTNode* node) {
    const LifecycleState oldState = this.lifecycle.getCurrentState();
    if newState == LifecycleState::DEAD && oldState == LifecycleState::DECLARED {
        const String message = "Cannot destroy uninitialized variable '" + this.name + "'";
        const CompilerError error = CompilerError(CompilerErrorType::INTERNAL_ERROR, message.getRaw());
        const String& errorMessage = error.getMessage();
        panic(Error(errorMessage.getRaw()));
    }
    if newState == LifecycleState::DEAD && oldState == LifecycleState::DEAD {
        const String message = "Cannot destroy already destroyed variable '" + this.name + "'";
        const CompilerError error = CompilerError(CompilerErrorType::INTERNAL_ERROR, message.getRaw());
        const String& errorMessage = error.getMessage();
        panic(Error(errorMessage.getRaw()));
    }
    this.lifecycle.addEvent(LifecycleEvent{newState, node});
}

/**
 * Retrieve the code location where the symbol was declared
 *
 * @return Declaration code location
 */
public f<const CodeLoc &> SymbolTableEntry.getDeclCodeLoc() {
    return this.declNode.codeLoc;
}

/**
 * Retrieve the lifecycle of this symbol
 *
 * @return Lifecycle
 */
public f<const Lifecycle&> SymbolTableEntry.getLifecycle() {
    return this.lifecycle;
}

/**
 * Check if this symbol is initialized
 *
 * @return Initialized or not
 */
public f<bool> SymbolTableEntry.isInitialized() {
    return this.lifecycle.isInitialized();
}

/**
 * Check if this symbol is a struct field
 *
 * @return Struct field or not
 */
public f<bool> SymbolTableEntry.isField() {
    const ScopeType scopeType = this.scope.getScopeType();
    return (scopeType == ScopeType::STRUCT || scopeType == ScopeType::UNION) && this.orderIndex < this.scope.getFieldCount() && !this.anonymous;
}

/**
 * Stringify the current symbol to a human-readable form. Used to dump whole symbol tables with their contents.
 * The returned heap-allocated JSON value is owned by the caller.
 *
 * Example:
 * {
 *   "name": "testIden",
 *   "type": "int[]*",
 *   "orderIndex": 4,
 *   "state": "initialized",
 *   "qualifiers: [
 *     "const": true,
 *     "signed": false
 *   ],
 *   "isGlobal": false,
 *   "isVolatile": false
 * }
 *
 * @return Symbol table entry as a JSON object
 */
public f<JsonValue*> SymbolTableEntry.toJSON() {
    result = __new<JsonValue>(JsonValueKind::JSON_OBJECT);
    setJsonField(result, String("name"), __new<JsonValue>(this.name));
    setJsonField(result, String("type"), __new<JsonValue>(this.qualType.getName(true)));
    setJsonField(result, String("codeLoc"), __new<JsonValue>(this.declNode.codeLoc.toString()));
    setJsonField(result, String("orderIndex"), __new<JsonValue>(this.orderIndex));
    setJsonField(result, String("state"), __new<JsonValue>(String(this.lifecycle.getCurrentStateName())));
    setJsonField(result, String("isGlobal"), __new<JsonValue>(this.global));
    setJsonField(result, String("isVolatile"), __new<JsonValue>(this.isVolatile));
}
