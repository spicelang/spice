// Std imports
import "std/data/vector";
import "std/text/stringstream";
import "std/bindings/llvm/llvm" as llvm;

// Own imports
import "bootstrap/ast/ast-nodes";
import "bootstrap/symboltablebuilder/type-chain";
import "bootstrap/symboltablebuilder/qual-type";
import "bootstrap/symboltablebuilder/super-type";
import "bootstrap/symboltablebuilder/scope";
import "bootstrap/source-file";
import "bootstrap/global/type-registry";
import "bootstrap/ast/attributes";
import "bootstrap/exception/semantic-error";
import "bootstrap/irgenerator/name-mangling";
import "bootstrap/model/interface";
import "bootstrap/model/struct";
import "bootstrap/model/struct-base";
import "bootstrap/model/union";
import "bootstrap/symboltablebuilder/symbol-table-entry";

public type Type struct {
    Vector<TypeChainElement> typeChain
    // Non-owning back-reference to the registry that interns this type. Set by the registry on creation.
    // It is intentionally excluded from hashing and equality (which are defined over the type chain only).
    TypeRegistry* registry = nil<TypeRegistry*>
}

public p Type.ctor(SuperType superType) {
    this.typeChain.pushBack(TypeChainElement(superType));
}

public p Type.ctor(SuperType superType, const String& subType) {
    this.typeChain.pushBack(TypeChainElement(superType, subType));
}

public p Type.ctor(SuperType superType, const String& subType, unsigned long typeId, const TypeChainElementData& data, const QualTypeList& templateTypes) {
    this.typeChain.pushBack(TypeChainElement(superType, subType, typeId, data, templateTypes));
}

public p Type.ctor(const TypeChain& typeChain) {
    this.typeChain = typeChain;
}

public p Type.ctor(const Type& other) {
    this.typeChain = other.typeChain;
    this.registry = other.registry;
}

/**
 * Get the super type of the current type
 *
 * @return Super type
 */
public f<SuperType> Type.getSuperType() {
    assert !this.typeChain.isEmpty();
    return this.typeChain.back().superType;
}

/**
 * Get the sub type of the current type
 *
 * @return Sub type
 */
public f<const String&> Type.getSubType() {
    assert !this.typeChain.isEmpty();
    const dyn options = [SuperType::TY_STRUCT, SuperType::TY_INTERFACE, SuperType::TY_UNION, SuperType::TY_ENUM, SuperType::TY_GENERIC];
    assert this.isOneOf(options, len(options));
    return this.typeChain.back().subType;
}

/**
 * Get the array size of the current type
 *
 * @return Array size
 */
public f<unsigned int> Type.getArraySize() {
    assert this.isArray();
    return this.typeChain.back().data.arraySize;
}

/**
 * Get the body scope of the current type
 *
 * @return Body scope
 */
public f<Scope*> Type.getBodyScope() {
    const dyn options = [SuperType::TY_STRUCT, SuperType::TY_INTERFACE, SuperType::TY_UNION];
    assert this.isOneOf(options, len(options));
    return this.typeChain.back().data.bodyScope;
}

/**
 * Get the return type of function type
 *
 * @return Function return type
 */
public f<QualType> Type.getFunctionReturnType() {
    assert this.is(SuperType::TY_FUNCTION);
    const TypeChainElement& front = this.typeChain.front();
    assert !front.paramTypes.isEmpty();
    return front.paramTypes.front();
}

/**
 * Get the param types of a function or procedure type
 *
 * @return Function param types
 */
public f<QualTypeList> Type.getFunctionParamTypes() {
    const dyn options = [SuperType::TY_FUNCTION, SuperType::TY_PROCEDURE];
    assert this.isOneOf(options, len(options));
    const TypeChainElement& front = this.typeChain.front();
    QualTypeList paramTypes;
    // The first element is the return type, the params follow
    for unsigned long i = 1ul; i < front.paramTypes.getSize(); i++ {
        paramTypes.pushBack(front.paramTypes.get(i));
    }
    return paramTypes;
}

/**
 * Get the param and return types of a function or procedure base type
 *
 * @return Function param and return types (first is return type, rest are param types)
 */
public f<QualTypeList> Type.getFunctionParamAndReturnTypes() {
    const Type* baseType = this.getBase();
    const dyn options = [SuperType::TY_FUNCTION, SuperType::TY_PROCEDURE];
    assert baseType.isOneOf(options, len(options));
    // Copy explicitly: returning the member directly would hand out a list that shares the storage of the type chain
    const TypeChainElement& front = this.typeChain.front();
    QualTypeList paramAndReturnTypes = front.paramTypes;
    return paramAndReturnTypes;
}

/**
 * Check if a function or procedure type has captures
 *
 * @return Has captures
 */
public f<bool> Type.hasLambdaCaptures() {
    const Type* baseType = this.getBase();
    const dyn options = [SuperType::TY_FUNCTION, SuperType::TY_PROCEDURE];
    assert baseType.isOneOf(options, len(options));
    return this.typeChain.front().data.hasCaptures;
}

/**
 * Retrieve template types of the current type
 *
 * @return Vector of template types
 */
public f<QualTypeList> Type.getTemplateTypes() {
    // Copy explicitly: returning the member directly would hand out a list that shares the storage of the type chain
    const TypeChainElement& back = this.typeChain.back();
    QualTypeList templateTypes = back.templateTypes;
    return templateTypes;
}

/**
 * Get the type chain depth of the current type
 *
 * @return Type chain depth
 */
public const f<unsigned long> Type.getTypeChainDepth() {
    return this.typeChain.getSize();
}

/**
 * Check if the current type is of a certain super type
 *
 * @return Applicable or not
 */
public f<bool> Type.is(SuperType superType) {
    return this.getSuperType() == superType;
}

/**
 * Check if the current type is one of a list of super types
 *
 * @return Applicable or not
 */
public f<bool> Type.isOneOf(SuperType[] superTypes, unsigned long superTypesSize) {
    const SuperType currentSuperType = this.getSuperType();
    for unsigned long i = 0ul; i < superTypesSize; i++ {
        if currentSuperType == superTypes[i] { return true; }
    }
    return false;
}

/**
 * Check if the base type of the current type chain is of a certain super type
 *
 * @param superType Super type to check for
 * @return Applicable or not
 */
public f<bool> Type.isBase(SuperType superType) {
    assert !this.typeChain.isEmpty();
    return this.typeChain.front().superType == superType;
}

/**
 * Check if the current type is a primitive type
 *
 * @return Primitive type or not
 */
public f<bool> Type.isPrimitive() {
    const dyn options = [SuperType::TY_DOUBLE, SuperType::TY_INT, SuperType::TY_SHORT, SuperType::TY_LONG, SuperType::TY_BYTE, SuperType::TY_CHAR, SuperType::TY_STRING, SuperType::TY_BOOL];
    return this.isOneOf(options, len(options));
}

/**
 * Check if the type is an extended primitive type
 * The definition of extended primitive types contains all primitive types plus the following:
 * - structs
 * - interfaces
 * - functions/procedures
 *
 * @return Extended primitive or not
 */
public f<bool> Type.isExtendedPrimitive() {
    const dyn options = [SuperType::TY_STRUCT, SuperType::TY_INTERFACE, SuperType::TY_UNION, SuperType::TY_FUNCTION, SuperType::TY_PROCEDURE];
    return this.isPrimitive() || this.isOneOf(options, len(options));
}

/**
 * Check if the current type is a pointer type
 *
 * @return Pointer type or not
 */
public f<bool> Type.isPtr() {
    return this.getSuperType() == SuperType::TY_PTR;
}

/**
 * Check if the current type is a reference type
 *
 * @return Reference type or not
 */
public f<bool> Type.isRef() {
    return this.getSuperType() == SuperType::TY_REF;
}

/**
 * Check if the current type is an array type
 *
 * @return Array type or not
 */
public f<bool> Type.isArray() {
    return this.getSuperType() == SuperType::TY_ARRAY;
}

/**
 * Checks if the base type is generic itself or has generic parts in its template types
 *
 * @return Contains generic parts or not
 */
public f<bool> Type.hasAnyGenericParts() {
    const Type* baseType = this.getBase();

    // Check if the type itself is generic
    if baseType.is(SuperType::TY_GENERIC) { return true; }

    // Check if the type has generic template types
    foreach const QualType& templateType : baseType.typeChain.back().templateTypes {
        if templateType.rawType.hasAnyGenericParts() { return true; }
    }

    // Check param and return types of functions/procedures
    const dyn fctOptions = [SuperType::TY_FUNCTION, SuperType::TY_PROCEDURE];
    if baseType.isOneOf(fctOptions, len(fctOptions)) {
        foreach const QualType& paramType : baseType.typeChain.front().paramTypes {
            if paramType.rawType.hasAnyGenericParts() { return true; }
        }
    }

    return false; // Does not have generic parts
}

/**
 * Check if the current type is of the same container type like the other type.
 * Only TY_PTR, TY_REF and TY_ARRAY are considered as container types.
 *
 * @param other Other symbol type
 * @return Same container type or not
 */
public f<bool> Type.isSameContainerTypeAs(const Type* other) {
    const bool bothPtr = this.isPtr() && other.isPtr();
    const bool bothRef = this.isRef() && other.isRef();
    const bool bothArray = this.isArray() && other.isArray();
    return bothPtr || bothRef || bothArray;
}

/**
 * Check for the matching compatibility of two types.
 * Useful for struct and function matching as well as assignment type validation and function arg matching.
 *
 * @param otherType Type to compare against
 * @param ignoreArraySize Ignore array sizes
 * @return Matching or not
 */
public f<bool> Type.matches(const Type* otherType, bool ignoreArraySize) {
    // If the size does not match, it is not equal
    if this.typeChain.getSize() != otherType.typeChain.getSize() { return false; }

    // Compare the elements
    for unsigned long i = 0ul; i < this.typeChain.getSize(); i++ {
        const TypeChainElement& lhsElement = this.typeChain.get(i);
        const TypeChainElement& rhsElement = otherType.typeChain.get(i);

        // Ignore differences in array size
        if ignoreArraySize && lhsElement.superType == SuperType::TY_ARRAY && rhsElement.superType == SuperType::TY_ARRAY {
            continue;
        }

        // Not both types are arrays -> compare them as usual
        if lhsElement != rhsElement { return false; }
    }

    return true;
}

/**
 * Get the name of the symbol type as a string
 *
 * @param name Get name of type
 * @param withSize Include the array size for sized types
 * @param ignorePublic Ignore any potential public qualifier
 * @param withAliases Print aliases as is and not decompose them
 * @return Symbol type name
 */
public p Type.getName(StringStream& name, bool withSize, bool ignorePublic, bool withAliases) {
    // Loop through all chain elements
    foreach const TypeChainElement& chainElement : this.typeChain {
        chainElement.getName(name, withSize, ignorePublic, withAliases);
    }
}

/**
 * Get the name of the symbol type as a string
 *
 * @param withSize Include the array size for sized types
 * @param ignorePublic Ignore any potential public qualifier
 * @param withAliases Print aliases as is and not decompose them
 * @return Symbol type name
 */
public f<String> Type.getName(bool withSize, bool ignorePublic, bool withAliases) {
    StringStream name;
    this.getName(name, withSize, ignorePublic, withAliases);
    return name.str();
}

/**
 * Get the pointer type of the current type as a new type
 *
 * @param node AST node for error messages
 * @return Pointer type of the current type
 */
public f<const Type*> Type.toPtr(const ASTNode* node) {
    if this.is(SuperType::TY_DYN) { panicWithSemanticError(node, SemanticErrorType::DYN_POINTERS_NOT_ALLOWED, "Just use the dyn type without '*' instead"); }
    if this.isRef() { panicWithSemanticError(node, SemanticErrorType::REF_POINTERS_ARE_NOT_ALLOWED, "Pointers to references are not allowed. Use pointer instead"); }

    // Create new type chain
    TypeChain newTypeChain = this.typeChain;
    newTypeChain.pushBack(TypeChainElement(SuperType::TY_PTR));

    // Register new type or return if already registered
    return this.registry.getOrInsertChain(newTypeChain);
}

/**
 * Get the reference type of the current type as a new type
 *
 * @param node AST node for error messages
 * @return Reference type of the current type
 */
public f<const Type*> Type.toRef(const ASTNode* node) {
    if this.is(SuperType::TY_DYN) { panicWithSemanticError(node, SemanticErrorType::DYN_REFERENCES_NOT_ALLOWED, "Just use the dyn type without '&' instead"); }
    if this.isRef() { panicWithSemanticError(node, SemanticErrorType::MULTI_REF_NOT_ALLOWED, "References to references are not allowed"); }

    // Create new type chain
    TypeChain newTypeChain = this.typeChain;
    newTypeChain.pushBack(TypeChainElement(SuperType::TY_REF));

    // Register new type or return if already registered
    return this.registry.getOrInsertChain(newTypeChain);
}

/**
 * Get the array type of the current type as a new type
 *
 * @param node AST node for error messages
 * @param size Size of the array
 * @param skipDynCheck Skip check if array base type is dyn
 * @return Array type of the current type
 */
public f<const Type*> Type.toArr(const ASTNode* node, unsigned int size, bool skipDynCheck) {
    if !skipDynCheck && this.typeChain.back().superType == SuperType::TY_DYN {
        panicWithSemanticError(node, SemanticErrorType::DYN_ARRAYS_NOT_ALLOWED, "Just use the dyn type without '[]' instead");
    }

    // Create new type chain
    TypeChain newTypeChain = this.typeChain;
    TypeChainElementData data = TypeChainElementData{/*arraySize=*/ size, /*bodyScope=*/ nil<Scope*>, /*hasCaptures*/ false};
    newTypeChain.pushBack(TypeChainElement(SuperType::TY_ARRAY, data));

    // Register new type or return if already registered
    return this.registry.getOrInsertChain(newTypeChain);
}

/**
 * Retrieve the base type of an array or a pointer
 *
 * @return Base type
 */
public f<const Type*> Type.getContained() {
    if this.is(SuperType::TY_STRING) {
        return this.registry.getOrInsert(SuperType::TY_CHAR);
    }

    // Create new type chain
    TypeChain newTypeChain = this.typeChain;
    assert newTypeChain.getSize() > 1l;
    newTypeChain.removeAt(newTypeChain.getSize() - 1ul);

    // Register new type or return if already registered
    return this.registry.getOrInsertChain(newTypeChain);
}

/**
 * Replace the base type with another one
 *
 * @param newBaseType New base type
 * @return The new type
 */
public f<const Type*> Type.replaceBase(const Type* newBaseType) {
    assert !this.typeChain.isEmpty();

    // Create new type
    TypeChain newTypeChain = newBaseType.typeChain;
    const bool doubleRef = newTypeChain.back().superType == SuperType::TY_REF && this.typeChain.back().superType == SuperType::TY_REF;
    const unsigned long size = this.typeChain.getSize();
    for unsigned long i = 1ul; i < size; i++ {
        if !doubleRef || i > 1ul {
            newTypeChain.pushBack(this.typeChain[i]);
        }
    }

    // Register new type or return if already registered
    return this.registry.getOrInsertChain(newTypeChain);
}

/**
 * Remove reference wrapper from the current type
 *
 * @return Type without reference wrapper
 */
public f<const Type*> Type.removeReferenceWrapper() {
    if this.isRef() { return this.getContained(); }
    const Type* self = this;
    return self;
}

/**
 * Retrieve the base type of the current type
 *
 * @return Base type
 */
public f<const Type*> Type.getBase() {
    assert !this.typeChain.isEmpty();

    // A type chain with a single element is the base type already. All types are interned in the type registry, so there is
    // no need to look it up again
    if this.typeChain.getSize() == 1l {
        const Type* self = this;
        return self;
    }

    // Create new type chain
    TypeChain newTypeChain;
    newTypeChain.pushBack(this.typeChain.front());

    // Register new type or return if already registered
    return this.registry.getOrInsertChain(newTypeChain);
}

/**
 * Retrieve the same type, but with lambda captures
 *
 * @return Type with lambda captures
 */
public f<const Type*> Type.getWithLambdaCaptures(bool enabled) {
    const Type* baseType = this.getBase();
    const dyn options = [SuperType::TY_FUNCTION, SuperType::TY_PROCEDURE];
    assert baseType.isOneOf(options, len(options));

    // Create new type chain
    TypeChain newTypeChain = this.typeChain;
    newTypeChain.front().data.hasCaptures = enabled;

    // Register new type or return if already registered
    return this.registry.getOrInsertChain(newTypeChain);
}

/**
 * Retrieve the same type, but with the body scope removed
 *
 * @return Type with body scope removed
 */
public f<const Type*> Type.getWithBodyScope(Scope* bodyScope) {
    const Type* baseType = this.getBase();
    const dyn options = [SuperType::TY_STRUCT, SuperType::TY_INTERFACE, SuperType::TY_UNION];
    assert baseType.isOneOf(options, len(options));

    // Create new type chain
    TypeChain newTypeChain = this.typeChain;
    newTypeChain.front().data.bodyScope = bodyScope;

    // Register new type or return if already registered
    return this.registry.getOrInsertChain(newTypeChain);
}

/**
 * Retrieve the same type, but with the given base template types
 *
 * @return Type with new base template types
 */
public f<const Type*> Type.getWithTemplateTypes(const QualTypeList& templateTypes) {
    const dyn options = [SuperType::TY_STRUCT, SuperType::TY_INTERFACE, SuperType::TY_UNION];
    assert this.isOneOf(options, len(options));
    return this.getWithBaseTemplateTypes(templateTypes);
}

/**
 * Retrieve the same type, but with the given base template types
 *
 * @return Type with new base template types
 */
public f<const Type*> Type.getWithBaseTemplateTypes(const QualTypeList& templateTypes) {
    const Type* baseType = this.getBase();
    const dyn options = [SuperType::TY_STRUCT, SuperType::TY_INTERFACE, SuperType::TY_UNION];
    assert baseType.isOneOf(options, len(options));

    // Create new type chain
    TypeChain newTypeChain = this.typeChain;
    newTypeChain.front().templateTypes = templateTypes;

    // Register new type or return if already registered
    return this.registry.getOrInsertChain(newTypeChain);
}

/**
 * Retrieve the same type, but with the param and return types removed
 *
 * @return Type with param and return types removed
 */
public f<const Type*> Type.getWithFunctionParamAndReturnTypes(const QualTypeList& paramAndReturnTypes) {
    const Type* baseType = this.getBase();
    const dyn options = [SuperType::TY_FUNCTION, SuperType::TY_PROCEDURE];
    assert baseType.isOneOf(options, len(options));

    // Create new type chain
    TypeChain newTypeChain = this.typeChain;
    newTypeChain.front().paramTypes = paramAndReturnTypes;

    // Register new type or return if already registered
    return this.registry.getOrInsertChain(newTypeChain);
}

/**
 * Return the LLVM type for this symbol type
 *
 * @param sourceFile Referenced source file
 * @return Corresponding LLVM type
 */
public f<llvm::Type> Type.toLLVMType(SourceFile* sourceFile) {
    assert !this.typeChain.isEmpty() && !this.is(SuperType::TY_INVALID);
    const llvm::LLVMContext& context = sourceFile.getLLVMContext();

    const dyn ptrLikeTypes = [SuperType::TY_PTR, SuperType::TY_REF, SuperType::TY_STRING];
    if this.isOneOf(ptrLikeTypes, len(ptrLikeTypes)) || (this.isArray() && this.getArraySize() == 0u) {
        return llvm::getPtrTy(context);
    }

    if this.isArray() {
        assert this.getArraySize() > 0u;
        const llvm::Type containedType = sourceFile.getLLVMType(this.getContained());
        return llvm::getArrayType(containedType, cast<unsigned long>(this.getArraySize()));
    }

    assert !this.hasAnyGenericParts();

    if this.is(SuperType::TY_DOUBLE) {
        return llvm::getDoubleTy(context);
    }

    const dyn int32Types = [SuperType::TY_INT, SuperType::TY_ENUM];
    if this.isOneOf(int32Types, len(int32Types)) {
        return llvm::getInt32Ty(context);
    }

    if this.is(SuperType::TY_SHORT) {
        return llvm::getInt16Ty(context);
    }

    if this.is(SuperType::TY_LONG) {
        return llvm::getInt64Ty(context);
    }

    const dyn int8Types = [SuperType::TY_CHAR, SuperType::TY_BYTE];
    if this.isOneOf(int8Types, len(int8Types)) {
        return llvm::getInt8Ty(context);
    }

    if this.is(SuperType::TY_BOOL) {
        return llvm::getInt1Ty(context);
    }

    const dyn structOrInterface = [SuperType::TY_STRUCT, SuperType::TY_INTERFACE];
    if this.isOneOf(structOrInterface, len(structOrInterface)) {
        const Scope* structBodyScope = this.getBodyScope();
        const String structSignature = getStructSignature(this.getSubType(), this.getTemplateTypes());
        const SymbolTableEntry* structSymbol = structBodyScope.parent.lookupStrict(structSignature);
        assert structSymbol != nil<SymbolTableEntry*>;
        const QualType structSymbolType = structSymbol.getQualType();

        // Collect concrete field types
        String mangledName;
        Vector<llvm::Type> fieldTypes;
        bool isPacked = false;
        if this.is(SuperType::TY_STRUCT) { // Struct
            const Struct* spiceStruct = structSymbolType.getStruct(structSymbol.declNode);
            assert spiceStruct != nil<Struct*>;
            mangledName = mangleStruct(*spiceStruct);

            const unsigned long totalFieldCount = spiceStruct.scope.getFieldCount();
            fieldTypes.reserve(totalFieldCount);

            // If the struct implements interfaces, the first implicit field (added below via lookupField) is an interface
            // type, which already lowers to a { ptr } struct carrying the vtable pointer. Only add an explicit ptr field
            // here for structs without interfaces that still need a vtable (e.g. RTTI root types), to avoid duplicating it.
            assert structSymbol.declNode.kind == ASTNodeKind::STRUCT_DEF;
            const ASTStructDefNode* structDeclNode = downcast<ASTStructDefNode>(structSymbol.declNode);
            if spiceStruct.hasSynthesizedVTablePtr() {
                fieldTypes.pushBack(llvm::getPtrTy(context));
            }

            // Collect all field types
            for unsigned long i = 0l; i < totalFieldCount; i++ {
                const SymbolTableEntry* fieldSymbol = spiceStruct.scope.lookupField(cast<unsigned int>(i));
                assert fieldSymbol != nil<SymbolTableEntry*>;
                const QualType fieldType = fieldSymbol.getQualType();
                fieldTypes.pushBack(sourceFile.getLLVMType(fieldType.getType()));
            }

            // Check if the struct is declared as packed
            if structDeclNode.attrs != nil<IVisitable*> {
                const ASTTopLevelDefAttrNode* attrs = downcast<ASTTopLevelDefAttrNode>(structDeclNode.attrs);
                const String packedAttrName = String(ATTR_CORE_COMPILER_PACKED);
                if attrs.attrLst.hasAttr(packedAttrName) {
                    const CompileTimeValue packedAttrValue = attrs.attrLst.getAttrValueByName(packedAttrName);
                    isPacked = packedAttrValue.getBoolValue();
                }
            }
        } else { // Interface
            const Interface* spiceInterface = structSymbolType.getInterface(structSymbol.declNode);
            assert spiceInterface != nil<Interface*>;
            mangledName = mangleInterface(*spiceInterface);

            // vtable pointer
            fieldTypes.pushBack(llvm::getPtrTy(context));
        }

        return llvm::createStructType(context, fieldTypes, mangledName.getRaw(), isPacked);
    }

    if this.is(SuperType::TY_UNION) {
        // A union is lowered to { i32 tag, [0 x MaxAlignTy] alignPad, [maxSize x i8] payload }. The tag tracks which field
        // is currently active. The zero-length array contributes no bytes but forces the whole struct's (and therefore the
        // payload's) ABI alignment to be at least as strict as the most-aligned field, so that every field can be safely
        // loaded/stored at the payload's address regardless of its own alignment requirement. The payload itself is always
        // a raw byte buffer (not a typed array), so that any field's value can be stored/loaded there directly, and any
        // compile-time constant for it can be built uniformly as packed raw bytes, without needing a legal LLVM constant
        // conversion between the payload's declared element type and a field's unrelated type.
        const Scope* unionBodyScope = this.getBodyScope();
        const String unionSignature = getStructSignature(this.getSubType(), this.getTemplateTypes());
        const SymbolTableEntry* unionSymbol = unionBodyScope.parent.lookupStrict(unionSignature);
        assert unionSymbol != nil<SymbolTableEntry*>;

        const QualType unionSymbolType = unionSymbol.getQualType();
        const Union* spiceUnion = unionSymbolType.getUnion(unionSymbol.declNode);
        assert spiceUnion != nil<Union*>;
        const String mangledName = mangleUnion(*spiceUnion);

        llvm::DataLayout dataLayout = sourceFile.targetMachine.createDataLayout();
        const unsigned long totalFieldCount = spiceUnion.scope.getFieldCount();

        unsigned long maxSize = 0l;
        unsigned long maxAlign = 1l;
        llvm::Type maxAlignFieldType = llvm::getInt8Ty(context);
        for unsigned long i = 0l; i < totalFieldCount; i++ {
            const SymbolTableEntry* fieldSymbol = spiceUnion.scope.lookupField(cast<unsigned int>(i));
            assert fieldSymbol != nil<SymbolTableEntry*>;
            const QualType fieldQualType = fieldSymbol.getQualType();
            const llvm::Type fieldType = sourceFile.getLLVMType(fieldQualType.getType());
            const unsigned long fieldSize = dataLayout.getTypeAllocSize(fieldType);
            const unsigned long fieldAlign = cast<unsigned long>(dataLayout.getABITypeAlign(fieldType));
            if fieldSize > maxSize {
                maxSize = fieldSize;
            }
            if fieldAlign > maxAlign {
                maxAlign = fieldAlign;
                maxAlignFieldType = fieldType;
            }
        }

        Vector<llvm::Type> elementTypes;
        elementTypes.pushBack(llvm::getInt32Ty(context)); // Tag type
        elementTypes.pushBack(llvm::getArrayType(maxAlignFieldType, 0l)); // Align pad type
        elementTypes.pushBack(llvm::getArrayType(llvm::getInt8Ty(context), maxSize)); // Payload type
        return llvm::createStructType(context, elementTypes, mangledName.getRaw());
    }

    const dyn fctOrProc = [SuperType::TY_FUNCTION, SuperType::TY_PROCEDURE];
    if this.isOneOf(fctOrProc, len(fctOrProc)) {
        // Lambda/function values are represented as a fat pointer with three slots:
        // { fctPtr, capturePtr, captureSize }. The capture size (in bytes) travels with
        // the value so that the std Lambda type can take ownership of the captures on the
        // heap regardless of where the lambda came from. It is 0 if there is no owned
        // capture struct (no captures, or a single capture stored inline in capturePtr).
        const llvm::Type ptrTy = llvm::getPtrTy(context);
        Vector<llvm::Type> elementTypes;
        elementTypes.pushBack(ptrTy);
        elementTypes.pushBack(ptrTy);
        elementTypes.pushBack(llvm::getInt64Ty(context));
        return llvm::getStructType(context, elementTypes);
    }

    const String message = "Cannot determine LLVM type of " + this.getName(true, true, true);
    panic(Error(message.getRaw())); // Unhandled branch
}

// The following helpers query the data layout of the target for the LLVM type of this type. The host does this inline, where
// it is needed (e.g. in the type checker for the sizeof builtin). The LLVM bindings cannot be imported there, because their
// type names (e.g. Function, Type) clash with the ones of the compiler.

/**
 * Get the allocation size of this type in bytes, according to the data layout of the target
 *
 * @param sourceFile Source file
 * @return Allocation size in bytes
 */
public f<unsigned long> Type.getTypeAllocSize(SourceFile* sourceFile) {
    const llvm::Type llvmType = sourceFile.getLLVMType(this);
    llvm::DataLayout dataLayout = sourceFile.targetMachine.createDataLayout();
    return dataLayout.getTypeAllocSize(llvmType);
}

/**
 * Get the ABI alignment of this type in bytes, according to the data layout of the target
 *
 * @param sourceFile Source file
 * @return ABI alignment in bytes
 */
public f<unsigned long> Type.getABITypeAlign(SourceFile* sourceFile) {
    const llvm::Type llvmType = sourceFile.getLLVMType(this);
    llvm::DataLayout dataLayout = sourceFile.targetMachine.createDataLayout();
    return cast<unsigned long>(dataLayout.getABITypeAlign(llvmType));
}

/**
 * Get the byte offset of a (possibly composed) field of this struct type, by walking the given index path through the struct
 * layout of the target
 *
 * @param sourceFile Source file
 * @param indexPath Index path of the field, like Struct.lookupInComposedFields returns it
 * @return Byte offset of the field
 */
public f<unsigned long> Type.getFieldOffset(SourceFile* sourceFile, const Vector<unsigned long>& indexPath) {
    llvm::DataLayout dataLayout = sourceFile.targetMachine.createDataLayout();
    unsigned long offset = 0l;
    llvm::Type currentType = sourceFile.getLLVMType(this);
    foreach const unsigned long index : indexPath {
        const unsigned int elementIndex = cast<unsigned int>(index);
        offset += dataLayout.getStructElementOffset(currentType, elementIndex);
        currentType = currentType.getStructElementType(elementIndex);
    }
    return offset;
}

/**
 * Remove pointers / arrays / references if both types have them as far as possible.
 *
 * @param typeA Candidate type
 * @param typeB Requested type
 */
// Named unwrapBothTypes instead of unwrapBoth (like the host's Type::unwrapBoth), because the QualType overload in
// qual-type.spice would shadow it there
public p unwrapBothTypes(const Type*& typeA, const Type*& typeB) {
    // Unwrap both types as far as possible
    while typeA.isSameContainerTypeAs(typeB) {
        typeA = typeA.getContained();
        typeB = typeB.getContained();
    }
}

/**
 * Remove pointers / arrays / references if both types have them as far as possible.
 * Furthermore, remove reference wrappers if possible.
 *
 * @param typeA Candidate type
 * @param typeB Requested type
 */
public p unwrapBothWithReferenceWrappers(const Type*& typeA, const Type*& typeB) {
    // Remove reference wrapper of front type if required
    if typeA.isRef() && !typeB.isRef() {
        typeA = typeA.removeReferenceWrapper();
    }
    if !typeA.isRef() && typeB.isRef() && !typeA.isBase(SuperType::TY_GENERIC) {
        typeB = typeB.removeReferenceWrapper();
    }

    // Unwrap both types as far as possible
    unwrapBothTypes(typeA, typeB);
}

/**
 * Check if two types have the same type chain depth
 *
 * @param typeA First type
 * @param typeB Second type
 * @return Same depth or not
 */
public f<bool> hasSameTypeChainDepth(const Type* typeA, const Type* typeB) {
    return typeA.getTypeChainDepth() == typeB.getTypeChainDepth();
}
