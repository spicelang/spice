// Std imports
import "std/type/any";
import "std/data/vector";

// Own imports
import "bootstrap/compiler-pass";
import "bootstrap/ast/abstract-ast-visitor-intf";
import "bootstrap/ast/ast-nodes";
import "bootstrap/global/global-resource-manager";
import "bootstrap/source-file";
import "bootstrap/linter/lint-finding";
import "bootstrap/linter/rules/naming-convention-rule";
import "bootstrap/linter/rules/too-many-parameters-rule";
import "bootstrap/linter/rules/cyclomatic-complexity-rule";

/**
 * Runs all built-in lint rules over a fully type-checked AST in a single read-only traversal.
 *
 * Modeled on PostTypeCheckingVerifier: each overridden visit method fans out to every rule interested in that
 * node kind, so adding a new rule only requires adding its call to the matching visit method, never a new AST
 * walk. The host keeps the rules behind a polymorphic LintRule registry; the bootstrap has no heap-allocated
 * polymorphic collections, so the rules live in linter/rules/ as free functions that this pass dispatches to.
 */
public type LintPass struct : IAbstractAstVisitor {
    compose public CompilerPass compilerPass
    public Vector<LintFinding> findings
}

/**
 * Construct a lint pass for the given source file
 *
 * @param resourceManager Global resource manager
 * @param sourceFile Source file, whose AST is linted
 */
public p LintPass.ctor(GlobalResourceManager& resourceManager, SourceFile* sourceFile) {
    this.compilerPass = CompilerPass(resourceManager, sourceFile);
}

/**
 * Run all lint rules over the given AST and return the collected findings.
 *
 * @param ast Root node of the AST to lint
 * @return Collected lint findings
 */
public f<Vector<LintFinding>> LintPass.lint(ASTEntryNode* ast) {
    this.visitEntry(ast);
    return this.findings;
}

// Generic double-dispatch entry point required by IAbstractAstVisitor
#[ignoreUnusedReturnValue]
public f<Any> LintPass.visit(IVisitable* node) {
    return node.accept(cast<IAbstractAstVisitor*>(this));
}

// Default behavior of every visit method that is not overridden below: visit all children (like the host's ASTVisitor)
#[ignoreUnusedReturnValue]
f<Any> LintPass.visitChildren(ASTNode* node) {
    foreach ASTNode* child : node.children {
        assert child != nil<ASTNode*>;
        assert child.visitable != nil<IVisitable*>;
        this.visit(child.visitable);
    }
    return Any();
}

// ========================================================== Lint rules =========================================================

public f<Any> LintPass.visitFctDef(ASTFctDefNode* node) {
    checkNamingFctDef(node, this.findings);
    checkParamCountFctDef(node, this.findings);
    checkComplexityFctDef(node, this.findings);
    return this.visitChildren(cast<ASTNode*>(node));
}

public f<Any> LintPass.visitProcDef(ASTProcDefNode* node) {
    checkNamingProcDef(node, this.findings);
    checkParamCountProcDef(node, this.findings);
    checkComplexityProcDef(node, this.findings);
    return this.visitChildren(cast<ASTNode*>(node));
}

public f<Any> LintPass.visitStructDef(ASTStructDefNode* node) {
    checkNamingStructDef(node, this.findings);
    return this.visitChildren(cast<ASTNode*>(node));
}

public f<Any> LintPass.visitInterfaceDef(ASTInterfaceDefNode* node) {
    checkNamingInterfaceDef(node, this.findings);
    return this.visitChildren(cast<ASTNode*>(node));
}

public f<Any> LintPass.visitUnionDef(ASTUnionDefNode* node) {
    checkNamingUnionDef(node, this.findings);
    return this.visitChildren(cast<ASTNode*>(node));
}

public f<Any> LintPass.visitGlobalVarDef(ASTGlobalVarDefNode* node) {
    checkNamingGlobalVarDef(node, this.findings);
    return this.visitChildren(cast<ASTNode*>(node));
}

