}

public f<Any> TypeChecker.visitEqualityExpr(ASTEqualityExprNode* node) {
    // Check if at least one equality operator is applied
    if node.operands.getSize() == 1l {
        return this.visit(node.operands.front());
    }
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Visit right side first, then left side
    const ExprResult rhs = this.visitExpr(node.operands.get(1));
    if rhs.ty.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }
    const ExprResult lhs = this.visitExpr(node.operands.get(0));
    if lhs.ty.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }

    // Check if we need the string runtime to perform a string comparison
    if lhs.ty.is(SuperType::TY_STRING) && rhs.ty.is(SuperType::TY_STRING) && !this.sourceFile.isStringRT() {
        this.sourceFile.requestRuntimeModule(RuntimeModule::STRING_RT);
    }

    // Check operator
    ExprResult equalityResult = ExprResult{QualType(SuperType::TY_INVALID), nil<SymbolTableEntry*>};
    if node.op == EqualityOp::OP_EQUAL { // Operator was equal
        equalityResult = this.opRuleManager.getEqualResultType(baseNode, lhs, rhs);
    } else if node.op == EqualityOp::OP_NOT_EQUAL { // Operator was not equal
        equalityResult = this.opRuleManager.getNotEqualResultType(baseNode, lhs, rhs);
    } else {
        panic(Error("EqualityExpr fall-through")); // UNHANDLED_BRANCH compiler error in the host
    }

    node.node.setEvaluatedSymbolType(equalityResult.ty, this.manIdx);
    return Any(equalityResult);
}

public f<Any> TypeChecker.visitRelationalExpr(ASTRelationalExprNode* node) {
    // Check if a relational operator is applied
    if node.operands.getSize() == 1l {
        return this.visit(node.operands.front());
    }
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Visit right side first, then left side
    const ExprResult rhs = this.visitExpr(node.operands.get(1));
    if rhs.ty.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }
    const ExprResult lhs = this.visitExpr(node.operands.get(0));
    if lhs.ty.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }

    // Check operator
    QualType resultType = QualType(SuperType::TY_INVALID);
    if node.op == RelationalOp::OP_LESS { // Operator was less
        resultType = this.opRuleManager.getLessResultType(baseNode, lhs, rhs);
    } else if node.op == RelationalOp::OP_GREATER { // Operator was greater
        resultType = this.opRuleManager.getGreaterResultType(baseNode, lhs, rhs);
    } else if node.op == RelationalOp::OP_LESS_EQUAL { // Operator was less equal
        resultType = this.opRuleManager.getLessEqualResultType(baseNode, lhs, rhs);
    } else if node.op == RelationalOp::OP_GREATER_EQUAL { // Operator was greater equal
        resultType = this.opRuleManager.getGreaterEqualResultType(baseNode, lhs, rhs);
    } else {
        panic(Error("RelationalExpr fall-through")); // UNHANDLED_BRANCH compiler error in the host
    }

    return Any(ExprResult{node.node.setEvaluatedSymbolType(resultType, this.manIdx), nil<SymbolTableEntry*>});
}

public f<Any> TypeChecker.visitShiftExpr(ASTShiftExprNode* node) {
    // Check if at least one shift operator is applied
    if node.operands.getSize() == 1l {
        return this.visit(node.operands.front());
    }
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Visit leftmost operand
    ExprResult currentResult = this.visitExpr(node.operands.get(0));
    if currentResult.ty.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }

    // Loop through remaining operands
    for unsigned long i = 0l; i < node.opQueue.getSize(); i++ {
        const ExprResult operandResult = this.visitExpr(node.operands.get(i + 1l));
        if operandResult.ty.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }

        // Check operator
        Pair<ShiftOp, QualType>& queueFront = node.opQueue.front();
        const ShiftOp op = queueFront.getFirst();
        if op == ShiftOp::OP_SHIFT_LEFT {
            currentResult = this.opRuleManager.getShiftLeftResultType(baseNode, currentResult, operandResult, i);
        } else if op == ShiftOp::OP_SHIFT_RIGHT {
            currentResult = this.opRuleManager.getShiftRightResultType(baseNode, currentResult, operandResult, i);
        } else {
            panic(Error("ShiftExpr fall-through")); // UNHANDLED_BRANCH compiler error in the host
        }

        // Push the new item and pop the old one on the other side of the queue
        node.opQueue.push(Pair<ShiftOp, QualType>(op, currentResult.ty));
        node.opQueue.pop();
    }

    node.node.setEvaluatedSymbolType(currentResult.ty, this.manIdx);
    return Any(currentResult);
}

public f<Any> TypeChecker.visitAdditiveExpr(ASTAdditiveExprNode* node) {
    // Check if at least one additive operator is applied
    if node.operands.getSize() == 1l {
        return this.visit(node.operands.front());
    }
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Visit leftmost operand
    ExprResult currentResult = this.visitExpr(node.operands.get(0));
    if currentResult.ty.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }

    // Loop through remaining operands
    for unsigned long i = 0l; i < node.opQueue.getSize(); i++ {
        const ExprResult operandResult = this.visitExpr(node.operands.get(i + 1l));
        if operandResult.ty.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }

        // Check operator
        Pair<AdditiveOp, QualType>& queueFront = node.opQueue.front();
        const AdditiveOp op = queueFront.getFirst();
        if op == AdditiveOp::OP_PLUS {
            currentResult = this.opRuleManager.getPlusResultType(baseNode, currentResult, operandResult, i);
        } else if op == AdditiveOp::OP_MINUS {
            currentResult = this.opRuleManager.getMinusResultType(baseNode, currentResult, operandResult, i);
        } else {
            panic(Error("AdditiveExpr fall-through")); // UNHANDLED_BRANCH compiler error in the host
        }

        // Push the new item and pop the old one on the other side of the queue
        node.opQueue.push(Pair<AdditiveOp, QualType>(op, currentResult.ty));
        node.opQueue.pop();
    }

    node.node.setEvaluatedSymbolType(currentResult.ty, this.manIdx);
    return Any(currentResult);
}

public f<Any> TypeChecker.visitMultiplicativeExpr(ASTMultiplicativeExprNode* node) {
    // Check if at least one multiplicative operator is applied
    if node.operands.getSize() == 1l {
        return this.visit(node.operands.front());
    }
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Visit leftmost operand
    ExprResult currentResult = this.visitExpr(node.operands.get(0));
    if currentResult.ty.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }
    // Loop through remaining operands
    for unsigned long i = 0l; i < node.opQueue.getSize(); i++ {
        const ExprResult operandResult = this.visitExpr(node.operands.get(i + 1l));
        if operandResult.ty.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }

        // Check operator
        Pair<MultiplicativeOp, QualType>& queueFront = node.opQueue.front();
        const MultiplicativeOp op = queueFront.getFirst();
        if op == MultiplicativeOp::OP_MUL {
            currentResult = this.opRuleManager.getMulResultType(baseNode, currentResult, operandResult, i);
        } else if op == MultiplicativeOp::OP_DIV {
            currentResult = this.opRuleManager.getDivResultType(baseNode, currentResult, operandResult, i);
        } else if op == MultiplicativeOp::OP_REM {
            currentResult = this.opRuleManager.getRemResultType(baseNode, currentResult, operandResult);
        } else {
            panic(Error("Multiplicative fall-through")); // UNHANDLED_BRANCH compiler error in the host
        }

        // Push the new item and pop the old one on the other side of the queue
        node.opQueue.push(Pair<MultiplicativeOp, QualType>(op, currentResult.ty));
        node.opQueue.pop();
    }

    node.node.setEvaluatedSymbolType(currentResult.ty, this.manIdx);
    return Any(currentResult);
}

public f<Any> TypeChecker.visitCastExpr(ASTCastExprNode* node) {
    // Check if cast is applied
    if !node.isCast {
        return this.visit(node.prefixUnaryExpr);
    }
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Visit destination type
    const QualType dstType = this.getDataType(node.dataType);
    if dstType.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }
    // Visit source type
    const ExprResult src = this.visitExpr(node.assignExpr);
    if src.ty.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }

    // Check for identity cast
    if src.ty == dstType {
        this.addWarning(baseNode.codeLoc, CompilerWarningType::IDENTITY_CAST, String("You cast from a type to itself. Thus, this can be simplified."));
    }

    // Get result type
    const QualType resultType = this.opRuleManager.getCastResultType(baseNode, dstType, src);

    const bool typesMatch = dstType.matches(src.ty, false, true, true);
    const bool sameContainerType = src.ty.isSameContainerTypeAs(dstType);
    SymbolTableEntry* entry = typesMatch || sameContainerType ? src.entry : nil<SymbolTableEntry*>;
    return Any(ExprResult{node.node.setEvaluatedSymbolType(resultType, this.manIdx), entry});
}

public f<Any> TypeChecker.visitPrefixUnaryExpr(ASTPrefixUnaryExprNode* node) {
    // If no operator is applied, simply visit the postfix unary expression
    if node.op == PrefixUnaryOp::OP_NONE {
        return this.visit(node.postfixUnaryExpr);
    }
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Visit the right side
    const ExprResult operand = this.visitExpr(node.prefixUnaryExpr);
    QualType operandType = operand.ty;
    SymbolTableEntry* operandEntry = operand.entry;
    if operandType.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }
    // Determine action, based on the given operator
    switch node.op {
        case PrefixUnaryOp::OP_MINUS: {
            operandType = this.opRuleManager.getPrefixMinusResultType(baseNode, operand);
        }
        case PrefixUnaryOp::OP_PLUS_PLUS: {
            operandType = this.opRuleManager.getPrefixPlusPlusResultType(baseNode, operand);

            if operandEntry != nil<SymbolTableEntry*> {
                // In case the lhs is captured, notify the capture about the write access
                Capture* lhsCapture = this.currentScope.symbolTable.lookupCapture(operandEntry.name);
                if lhsCapture != nil<Capture*> {
                    lhsCapture.setAccessType(CaptureAccessType::READ_WRITE);
                }

                // Update the state of the variable
                operandEntry.updateState(LifecycleState::INITIALIZED, baseNode);
            }
        }
        case PrefixUnaryOp::OP_MINUS_MINUS: {
            operandType = this.opRuleManager.getPrefixMinusMinusResultType(baseNode, operand);

            if operandEntry != nil<SymbolTableEntry*> {
                // In case the lhs is captured, notify the capture about the write access
                Capture* lhsCapture = this.currentScope.symbolTable.lookupCapture(operandEntry.name);
                if lhsCapture != nil<Capture*> {
                    lhsCapture.setAccessType(CaptureAccessType::READ_WRITE);
                }

                // Update the state of the variable
                operandEntry.updateState(LifecycleState::INITIALIZED, baseNode);
            }
        }
        case PrefixUnaryOp::OP_NOT: {
            operandType = this.opRuleManager.getPrefixNotResultType(baseNode, operand);
        }
        case PrefixUnaryOp::OP_BITWISE_NOT: {
            const ExprResult bitwiseNotResult = this.opRuleManager.getPrefixBitwiseNotResultType(baseNode, operand);
            operandType = bitwiseNotResult.ty;
            operandEntry = bitwiseNotResult.entry;
        }
        case PrefixUnaryOp::OP_DEREFERENCE: {
            operandType = this.opRuleManager.getPrefixMulResultType(baseNode, operand);
        }
        case PrefixUnaryOp::OP_ADDRESS_OF: {
            operandType = this.opRuleManager.getPrefixBitwiseAndResultType(baseNode, operand);
        }
        default: {
            panic(Error("PrefixUnaryExpr fall-through")); // UNHANDLED_BRANCH compiler error in the host
        }
    }

    return Any(ExprResult{node.node.setEvaluatedSymbolType(operandType, this.manIdx), operandEntry});
}

public f<Any> TypeChecker.visitPostfixUnaryExpr(ASTPostfixUnaryExprNode* node) {
    // If no operator is applied, simply visit the atomic expression
    if node.op == PostfixUnaryOp::OP_NONE {
        return this.visit(node.atomicExpr);
    }
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Visit left side
    const ExprResult operand = this.visitExpr(node.postfixUnaryExpr);
    QualType operandType = operand.ty;
    SymbolTableEntry* operandEntry = operand.entry;
    if operandType.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }

    switch node.op {
        case PostfixUnaryOp::OP_SUBSCRIPT: {
            // Visit index assignment
            IVisitable* indexAssignExpr = node.subscriptIndexExpr;
            const ExprResult index = this.visitExpr(indexAssignExpr);
            if index.ty.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }

            // Check is there is an overloaded operator function available, if yes accept it
            Vector<ExprResult> operatorOperands;
            operatorOperands.pushBack(operand);
            operatorOperands.pushBack(index);
            const ExprResult overloadResult = this.opRuleManager.isOperatorOverloadingFctAvailable(baseNode, OP_FCT_SUBSCRIPT, operatorOperands, 0l);
            if !overloadResult.ty.is(SuperType::TY_INVALID) {
                operandType = overloadResult.ty;
            } else {
                operandType = operandType.removeReferenceWrapper();

                // Check if the index is of the right type
                const dyn indexOptions = [SuperType::TY_INT, SuperType::TY_LONG];
                if !index.ty.isOneOf(indexOptions, len(indexOptions)) {
                    return this.softErrorER(baseNode, SemanticErrorType::ARRAY_INDEX_NOT_INT_OR_LONG, String("Array index must be of type int or long"));
                }

                // Check if we can apply the subscript operator on the lhs type
                const dyn subscriptOptions = [SuperType::TY_ARRAY, SuperType::TY_PTR, SuperType::TY_STRING];
                if !operandType.isOneOf(subscriptOptions, len(subscriptOptions)) {
                    const String message = String("Can only apply subscript operator on array type, got ") + operandType.getName(true);
                    return this.softErrorER(baseNode, SemanticErrorType::OPERATOR_WRONG_DATA_TYPE, message);
                }

                // Check if we have an unsafe operation
                if operandType.isPtr() && !this.currentScope.doesAllowUnsafeOperations() {
                    return this.softErrorER(baseNode, SemanticErrorType::UNSAFE_OPERATION_IN_SAFE_CONTEXT, String("The subscript operator on pointers is an unsafe operation. Use unsafe blocks if you know what you are doing."));
                }

                // In case of compile time index value and known array size, perform a compile time out-of-bounds check
                ASTNode* indexNode = getASTNode(indexAssignExpr);
                if operandType.isArray() && cast<unsigned long>(operandType.getArraySize()) != ARRAY_SIZE_UNKNOWN && indexNode.hasCompileTimeValue(this.manIdx) {
                    const CompileTimeValue compileTimeValue = indexNode.getCompileTimeValue(this.manIdx);
                    const int constIndex = compileTimeValue.intValue;
                    const unsigned int constSize = operandType.getArraySize();
                    // Check if we are accessing out-of-bounds memory
                    if constIndex >= cast<int>(constSize) {
                        const String idxStr = toString(constIndex);
                        const String sizeStr = toString(cast<long>(constSize));
                        const String message = String("You are trying to access element with index ") + idxStr + " of an array with size " + sizeStr;
                        return this.softErrorER(baseNode, SemanticErrorType::ARRAY_INDEX_OUT_OF_BOUNDS, message);
                    }
                }

                // Get item type
                operandType = operandType.getContained();

                // Remove heap qualifier
                TypeQualifiers& qualifiers = operandType.getQualifiers();
                qualifiers.isHeap = false;
            }
        }
        case PostfixUnaryOp::OP_MEMBER_ACCESS: {
            const String& fieldName = node.identifier;

            // Check if lhs is enum or strobj
            const QualType lhsBaseTy = operandType.autoDereference();

            // Union field access is handled separately: a union field is always a direct, non-composed lookup by name
            // (unlike struct fields, union fields never nest/compose), and reading/writing it requires a runtime tag
            // check/update in the IR generator, which relies on the field entry resolved here.
            if lhsBaseTy.is(SuperType::TY_UNION) {
                const String unionName = lhsBaseTy.getSubType();
                Scope* unionScope = lhsBaseTy.getBodyScope();

                // If we only have the generic union scope, lookup the concrete manifestation scope
                if unionScope.isGenericScope {
                    const Union* spiceUnion = lhsBaseTy.getUnion(baseNode);
                    assert spiceUnion != nil<const Union*>;
                    unionScope = spiceUnion.scope;
                }
                assert !unionScope.isGenericScope; // At this point we always expect a substantiation scope

                // Get accessed field
                SymbolTableEntry* memberEntry = unionScope.symbolTable.lookupStrict(fieldName);
                if memberEntry == nil<SymbolTableEntry*> {
                    const String message = String("Field '") + node.identifier + "' not found in union " + unionName;
                    return this.softErrorER(baseNode, SemanticErrorType::REFERENCED_UNDEFINED_VARIABLE, message);
                }
                const QualType memberType = memberEntry.getQualType();

                // Check for insufficient visibility
                const QualType memberBaseType = memberType.getBase();
                if unionScope.isImportedBy(this.rootScope) && !memberBaseType.isPublic() {
                    const String message = String("Cannot access field '") + fieldName + "' due to its private visibility";
                    return this.softErrorER(baseNode, SemanticErrorType::INSUFFICIENT_VISIBILITY, message);
                }

                // Set field to used
                memberEntry.used = true;

                // A read of an inactive field panics, which prints the stack trace, so the runtime that does that has to be loaded
                if this.cliOptions.printsStackTraceOnAbort() && !this.sourceFile.isRT(RuntimeModule::STACK_TRACE_RT) {
                    this.sourceFile.requestRuntimeModule(RuntimeModule::STACK_TRACE_RT);
                }

                // Overwrite type and entry of left side with member type and entry
                operandType = memberType;
                operandEntry = memberEntry;
            } else {
                if !lhsBaseTy.is(SuperType::TY_STRUCT) {
                    const String message = String("Cannot apply member access operator on ") + operandType.getName(false);
                    return this.softErrorER(baseNode, SemanticErrorType::INVALID_MEMBER_ACCESS, message);
                }

                // Retrieve registry entry
                const String structName = lhsBaseTy.getSubType();
                Scope* structScope = lhsBaseTy.getBodyScope();

                // If we only have the generic struct scope, lookup the concrete manifestation scope
                if structScope.isGenericScope {
                    const Struct* spiceStruct = lhsBaseTy.getStruct(baseNode);
                    assert spiceStruct != nil<const Struct*>;
                    structScope = spiceStruct.scope;
                }
                assert !structScope.isGenericScope; // At this point we always expect a substantiation scope

                // Get accessed field
                Vector<unsigned long> indexPath;
                SymbolTableEntry* memberEntry = structScope.symbolTable.lookupInComposedFields(fieldName, indexPath);
                if memberEntry == nil<SymbolTableEntry*> {
                    const String message = String("Field '") + node.identifier + "' not found in struct " + structName;
                    return this.softErrorER(baseNode, SemanticErrorType::REFERENCED_UNDEFINED_VARIABLE, message);
                }
                const QualType memberType = memberEntry.getQualType();

                // Check for insufficient visibility
                const QualType memberBaseType = memberType.getBase();
                if structScope.isImportedBy(this.rootScope) && !memberBaseType.isPublic() {
                    const String message = String("Cannot access field '") + fieldName + "' due to its private visibility";
                    return this.softErrorER(baseNode, SemanticErrorType::INSUFFICIENT_VISIBILITY, message);
                }

                // Set field to used
                memberEntry.used = true;

                // Overwrite type and entry of left side with member type and entry
                operandType = memberType;
                operandEntry = memberEntry;
            }
        }
        case PostfixUnaryOp::OP_PLUS_PLUS: {
            const ExprResult plusPlusResult = this.opRuleManager.getPostfixPlusPlusResultType(baseNode, operand);
            operandType = plusPlusResult.ty;

            if operandEntry != nil<SymbolTableEntry*> {
                // In case the lhs is captured, notify the capture about the write access
                Capture* lhsCapture = this.currentScope.symbolTable.lookupCapture(operandEntry.name);
                if lhsCapture != nil<Capture*> {
                    lhsCapture.setAccessType(CaptureAccessType::READ_WRITE);
                }

                // Update the state of the variable
                operandEntry.updateState(LifecycleState::INITIALIZED, baseNode);
            }
        }
        case PostfixUnaryOp::OP_MINUS_MINUS: {
            const ExprResult minusMinusResult = this.opRuleManager.getPostfixMinusMinusResultType(baseNode, operand);
            operandType = minusMinusResult.ty;

            if operandEntry != nil<SymbolTableEntry*> {
                // In case the lhs is captured, notify the capture about the write access
                Capture* lhsCapture = this.currentScope.symbolTable.lookupCapture(operandEntry.name);
                if lhsCapture != nil<Capture*> {
                    lhsCapture.setAccessType(CaptureAccessType::READ_WRITE);
                }

                // Update the state of the variable
                operandEntry.updateState(LifecycleState::INITIALIZED, baseNode);
            }
        }
        case PostfixUnaryOp::OP_ERR_PROPAGATION: {
            // Check if the operand is of type Result<T>
            const QualType resultType = operandType.removeReferenceWrapper();
            if !resultType.isResultObj() {
                const String message = String("The error propagation operator '!' can only be applied to a value of type Result<T>, got ") + operandType.getName(false);
                return this.softErrorER(baseNode, SemanticErrorType::ERR_PROPAGATION_INVALID_OPERAND, message);
            }

            // Check if the enclosing function/procedure/lambda itself returns Result<U>
            const SymbolTableEntry* enclosingReturnVar = this.currentScope.lookup(String(RETURN_VARIABLE_NAME));
            QualType enclosingReturnType = QualType(SuperType::TY_DYN);
            if enclosingReturnVar != nil<const SymbolTableEntry*> {
                enclosingReturnType = enclosingReturnVar.getQualType();
            }
            if enclosingReturnVar == nil<const SymbolTableEntry*> || !enclosingReturnType.isResultObj() {
                return this.softErrorER(baseNode, SemanticErrorType::ERR_PROPAGATION_INVALID_CONTEXT, String("The error propagation operator '!' can only be used inside a function that itself returns Result<U>"));
            }

            // Retrieve the substantiation scope of the operand's Result<T>
            Scope* resultScope = resultType.getBodyScope();
            if resultScope.isGenericScope {
                const Struct* resultStruct = resultType.getStruct(baseNode);
                assert resultStruct != nil<const Struct*>;
                resultScope = resultStruct.scope;
            }
            assert !resultScope.isGenericScope;

            // Resolve Result<T>.isErr(), Result<T>.unwrap() and Result<T>.getErr()
            const ArgList noArgs;
            const QualTypeList noTemplateTypeHints;
            node.errPropIsErrFct = matchFunction(resultScope, String("isErr"), resultType, noArgs, noTemplateTypeHints, false, baseNode);
            node.errPropUnwrapFct = matchFunction(resultScope, String("unwrap"), resultType, noArgs, noTemplateTypeHints, false, baseNode);
            node.errPropGetErrFct = matchFunction(resultScope, String("getErr"), resultType, noArgs, noTemplateTypeHints, false, baseNode);
            if node.errPropIsErrFct == nil<const Function*> || node.errPropUnwrapFct == nil<const Function*> || node.errPropGetErrFct == nil<const Function*> {
                return this.softErrorER(baseNode, SemanticErrorType::ERR_PROPAGATION_INVALID_CONTEXT, String("Failed to resolve the Result<T> helper methods required for the error propagation operator"));
            }

            // Resolve err<U>(const Error&), located next to Result in the same module
            const NameRegistryEntry* resultRegistryEntry = this.sourceFile.getNameRegistryEntry(String(RESULTOBJ_NAME));
            assert resultRegistryEntry != nil<const NameRegistryEntry*>;
            Scope* resultStructScope = resultRegistryEntry.targetScope;
            Scope* resultModuleScope = resultStructScope.parent;
            const QualTypeList enclosingTemplateTypes = enclosingReturnType.getTemplateTypes();
            const Function* getErrFct = node.errPropGetErrFct;
            ArgList errArgs;
            errArgs.pushBack(Pair<QualType, bool>(getErrFct.returnType, false));
            node.errPropCtorFct = matchFunction(resultModuleScope, String("err"), QualType(SuperType::TY_DYN), errArgs, enclosingTemplateTypes, false, baseNode);
            if node.errPropCtorFct == nil<const Function*> {
                return this.softErrorER(baseNode, SemanticErrorType::ERR_PROPAGATION_INVALID_CONTEXT, String("Failed to resolve 'err<U>(const Error&)' required for the error propagation operator"));
            }

            // The whole expression evaluates to the unwrapped payload
            const Function* unwrapFct = node.errPropUnwrapFct;
            operandType = unwrapFct.returnType;
            operandEntry = nil<SymbolTableEntry*>;
        }
        default: {
            panic(Error("PostfixUnaryExpr fall-through")); // UNHANDLED_BRANCH compiler error in the host
        }
    }

    if operandType.is(SuperType::TY_INVALID) {
        String varName = String("");
        if operandEntry != nil<SymbolTableEntry*> {
            varName = operandEntry.name;
        }
        const String message = String("Variable '") + varName + "' was referenced before declared";
        return this.softErrorER(baseNode, SemanticErrorType::REFERENCED_UNDEFINED_VARIABLE, message);
    }

    return Any(ExprResult{node.node.setEvaluatedSymbolType(operandType, this.manIdx), operandEntry});
}

public f<Any> TypeChecker.visitAtomicExpr(ASTAtomicExprNode* node) {
    // Check if constant
    if node.constant != nil<ASTConstantNode*> {
        return this.visitConstant(node.constant);
    }

    // Check if value
    if node.value != nil<IVisitable*> {
        return this.visit(node.value);
    }

    // Check for assign expression within parentheses
    if node.assignExpr != nil<IVisitable*> {
        return this.visit(node.assignExpr);
    }

    // Identifier (local or global variable access)
    assert !node.fqIdentifier.isEmpty();
    ASTNode* baseNode = cast<ASTNode*>(node);

    VarAccessData& accessData = node.data.get(this.manIdx);
    accessData.accessScope = this.currentScope;

    // Check if a local or global variable can be found by searching for the name
    if node.identifierFragments.getSize() == 1l {
        accessData.entry = accessData.accessScope.lookup(node.identifierFragments.back());
    }

    // If no local or global was found, search in the name registry
    if accessData.entry == nil<SymbolTableEntry*> {
        const NameRegistryEntry* registryEntry = this.sourceFile.getNameRegistryEntry(node.fqIdentifier);
        if registryEntry == nil<const NameRegistryEntry*> {
            const String message = String("The variable '") + node.fqIdentifier + "' could not be found";
            return this.softErrorER(baseNode, SemanticErrorType::REFERENCED_UNDEFINED_VARIABLE, message);
        }
        accessData.entry = registryEntry.targetEntry;
        accessData.accessScope = registryEntry.targetScope;
    }
    assert accessData.entry != nil<SymbolTableEntry*>;
    SymbolTableEntry* entry = accessData.entry;
    entry.used = true;
    accessData.capture = accessData.accessScope.symbolTable.lookupCapture(entry.name);

    const QualType varType = entry.getQualType();
    if varType.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }
    if varType.is(SuperType::TY_INVALID) {
        const String message = String("Symbol '") + entry.name + "' was used before declared.";
        return this.softErrorER(baseNode, SemanticErrorType::USED_BEFORE_DECLARED, message);
    }

    const dyn fctOptions = [SuperType::TY_FUNCTION, SuperType::TY_PROCEDURE];
    if varType.isOneOf(fctOptions, len(fctOptions)) && entry.global {
        // Check if overloaded function was referenced
        Vector<Function*>* manifestations = entry.declNode.getFctManifestations(entry.name);
        if manifestations.getSize() > 1l {
            return this.softErrorER(baseNode, SemanticErrorType::REFERENCED_OVERLOADED_FCT, String("Overloaded functions / functions with optional params cannot be referenced"));
        }
        // Set referenced function to used
        Function* referencedFunction = manifestations.front();
        if !referencedFunction.templateTypes.isEmpty() {
            return this.softErrorER(baseNode, SemanticErrorType::REFERENCED_OVERLOADED_FCT, String("Generic functions cannot be referenced"));
        }
        referencedFunction.used = true;
        referencedFunction.entry.used = true;
    }

    // The base type should be an extended primitive
    const QualType baseType = varType.getBase();
    if !baseType.isExtendedPrimitive() && !baseType.is(SuperType::TY_DYN) {
        const String message = String("A symbol of type ") + varType.getName(false) + " cannot be accessed here";
        return this.softErrorER(baseNode, SemanticErrorType::INVALID_SYMBOL_ACCESS, message);
    }

    // Check if we have seen a 'this.' prefix, because the generator needs that
    const String& firstFragment = node.identifierFragments.front();
    if entry.scope.scopeType == ScopeType::STRUCT && firstFragment != THIS_VARIABLE_NAME {
        const String message = String("The symbol '") + node.fqIdentifier + "' could not be found. Missing 'this.' prefix?";
        return this.softErrorER(baseNode, SemanticErrorType::REFERENCED_UNDEFINED_VARIABLE, message);
    }

    // Ensure that the entry is public, if the symbol is imported.
    // An exception are enum items. There it is sufficient, that the enum itself is public.
    if accessData.accessScope.isImportedBy(this.rootScope) && accessData.accessScope.scopeType != ScopeType::ENUM {
        if !baseType.isPublic() {
            const String message = String("Cannot access '") + entry.name + "' due to its private visibility";
            return this.softErrorER(baseNode, SemanticErrorType::INSUFFICIENT_VISIBILITY, message);
        }
    }

    // For enum item access, use access scope of the enum
    if entry.scope.scopeType == ScopeType::ENUM {
        accessData.accessScope = entry.scope;
    }

    // For struct access, use access scope of the struct
    if baseType.is(SuperType::TY_STRUCT) {
        const String structName = baseType.getSubType();
        const NameRegistryEntry* nameRegistryEntry = this.sourceFile.getNameRegistryEntry(structName);
        // The struct may only be reachable transitively (i.e. it is not present in this file's name registry under
        // its unqualified name). In that case, fall back to the struct's body scope, which is exactly what the
        // registry entry's targetScope would point to (see SymbolTableBuilder struct registration). This keeps
        // member access working across deep transitive imports instead of crashing.
        if nameRegistryEntry != nil<const NameRegistryEntry*> {
            accessData.accessScope = nameRegistryEntry.targetScope;
        } else {
            accessData.accessScope = baseType.getBodyScope();
        }
        assert accessData.accessScope != nil<Scope*>;
    }

    return Any(ExprResult{node.node.setEvaluatedSymbolType(varType, this.manIdx), entry});
}

// ============================================================== TypeCheckerValues.cpp ===========================================

public f<Any> TypeChecker.visitValue(ASTValueNode* node) {
    // Function call
    if node.fctCall != nil<IVisitable*> {
        return this.visit(node.fctCall);
    }

    // Array initialization
    if node.arrayInitialization != nil<IVisitable*> {
        return this.visit(node.arrayInitialization);
    }

    // Struct instantiation
    if node.structInstantiation != nil<IVisitable*> {
        return this.visit(node.structInstantiation);
    }

    // Lambda function
    if node.lambdaFunc != nil<IVisitable*> {
        return this.visit(node.lambdaFunc);
    }

    // Lambda procedure
    if node.lambdaProc != nil<IVisitable*> {
        return this.visit(node.lambdaProc);
    }

    // Lambda expression
    if node.lambdaExpr != nil<IVisitable*> {
        return this.visit(node.lambdaExpr);
    }

    // Typed nil
    if node.isNil {
        const QualType nilType = this.getDataType(node.nilType);
        if nilType.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }
        if nilType.is(SuperType::TY_DYN) {
            return this.softErrorER(cast<ASTNode*>(node.nilType), SemanticErrorType::UNEXPECTED_DYN_TYPE, String("Nil must have an explicit type"));
        }
        return Any(ExprResult{node.node.setEvaluatedSymbolType(nilType, this.manIdx), nil<SymbolTableEntry*>});
    }

    panic(Error("Value fall-through")); // UNHANDLED_BRANCH compiler error in the host
    return Any();
}

public f<Any> TypeChecker.visitConstant(ASTConstantNode* node) {
    SuperType superType = SuperType::TY_INVALID;
    switch node.primitiveValueType {
        case PrimitiveValueType::TYPE_DOUBLE: {
            superType = SuperType::TY_DOUBLE;
        }
        case PrimitiveValueType::TYPE_INT: {
            superType = SuperType::TY_INT;
        }
        case PrimitiveValueType::TYPE_SHORT: {
            superType = SuperType::TY_SHORT;
        }
        case PrimitiveValueType::TYPE_LONG: {
            superType = SuperType::TY_LONG;
        }
        case PrimitiveValueType::TYPE_CHAR: {
            superType = SuperType::TY_CHAR;
        }
        case PrimitiveValueType::TYPE_STRING: {
            superType = SuperType::TY_STRING;
        }
        case PrimitiveValueType::TYPE_BOOL: {
            superType = SuperType::TY_BOOL;
        }
        default: {
            panic(Error("Constant fall-through")); // UNHANDLED_BRANCH compiler error in the host
        }
    }
    return Any(ExprResult{node.node.setEvaluatedSymbolType(QualType(superType), this.manIdx), nil<SymbolTableEntry*>});
}

public f<Any> TypeChecker.visitFctCall(ASTFctCallNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);
    FctCallData& data = node.data.get(this.manIdx);

    // Retrieve arg types
    data.args.clear();
    if node.hasArgs {
        ASTArgLstNode* argLst = node.argLst;
        data.args.reserve(cast<unsigned long>(argLst.args.getSize()));
        foreach IVisitable* arg : argLst.args {
            // Visit argument
            const ExprResult argResult = this.visitExpr(arg);
            if argResult.ty.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }
            assert !argResult.ty.hasAnyGenericParts();
            // Save arg type to arg types list
            data.args.pushBack(Pair<QualType, bool>(argResult.ty, argResult.isTemporary()));
        }
    }

    // Retrieve template types
    data.templateTypes.clear();
    if node.hasTemplateTypes {
        foreach ASTDataTypeNode* templateTypeNode : node.templateTypeLst.dataTypes {
            const QualType templateType = this.getDataType(templateTypeNode);
            assert !templateType.is(SuperType::TY_INVALID);

            // Abort if the type is unresolved
            if templateType.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }

            // Check if the given type is generic
            if templateType.is(SuperType::TY_GENERIC) {
                return this.softErrorER(cast<ASTNode*>(templateTypeNode), SemanticErrorType::EXPECTED_NON_GENERIC_TYPE, String("You must specify a concrete type here"));
            }

            data.templateTypes.pushBack(templateType);
        }
    }

    // Check if this is a builtin call
    BuiltinFunctionInfo builtinFunctionInfo;
    if lookupBuiltinFunction(node.fqFunctionName, builtinFunctionInfo) {
        return this.visitBuiltinCall(node);
    }

    // Retrieve entry of the first fragment
    const dyn structOrInterface = [SuperType::TY_STRUCT, SuperType::TY_INTERFACE];
    const dyn fctOrProc = [SuperType::TY_FUNCTION, SuperType::TY_PROCEDURE];
    const String& firstFrag = node.functionNameFragments.front();
    SymbolTableEntry* firstFragEntry = this.currentScope.lookup(firstFrag);
    if firstFragEntry != nil<SymbolTableEntry*> {
        // Check if we have seen a 'this.' prefix, because the generator needs that
        if firstFragEntry.scope.scopeType == ScopeType::STRUCT && firstFrag != THIS_VARIABLE_NAME {
            const String message = String("The symbol '") + firstFrag + "' could not be found. Missing 'this.' prefix?";
            return this.softErrorER(baseNode, SemanticErrorType::REFERENCED_UNDEFINED_VARIABLE, message);
        }

        firstFragEntry.used = true;
        // Decide of which type the function call is
        const QualType firstFragType = firstFragEntry.getQualType();
        const QualType baseType = firstFragType.getBase();
        if baseType.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }
        if baseType.isOneOf(structOrInterface, len(structOrInterface)) {
            if firstFragEntry.scope.scopeType == ScopeType::GLOBAL {
                data.callType = FctCallType::TYPE_CTOR;
            } else {
                data.callType = FctCallType::TYPE_METHOD;
            }
        } else if baseType.isOneOf(fctOrProc, len(fctOrProc)) && firstFragEntry.scope.scopeType != ScopeType::GLOBAL {
            data.callType = FctCallType::TYPE_FCT_PTR;
        }
    }

    // Get struct name. Retrieve it from alias if required
    Pair<SymbolTableEntry*, bool> aliasResolution = this.rootScope.symbolTable.lookupWithAliasResolution(node.fqFunctionName);
    SymbolTableEntry* structEntry = aliasResolution.getFirst();
    const bool isAlias = aliasResolution.getSecond();
    String fqFunctionName = node.fqFunctionName;

    // Get the concrete template types
    if isAlias {
        const QualType aliasedType = structEntry.getQualType();
        fqFunctionName = aliasedType.getSubType();
        // Retrieve concrete template types from type alias
        data.templateTypes = aliasedType.getTemplateTypes();
        // Check if the aliased type specified template types and the struct instantiation does
        if !data.templateTypes.isEmpty() && node.hasTemplateTypes {
            return this.softErrorER(cast<ASTNode*>(node.templateTypeLst), SemanticErrorType::ALIAS_WITH_TEMPLATE_LIST, String("The aliased type already has a template list"));
        }
    }

    // Check if this is a method call or a normal function call
    if data.isMethodCall() {
        // This is a method call
        data.thisType = firstFragEntry.getQualType();
        const QualType thisBaseType = data.thisType.getBase();
        Scope* structBodyScope = thisBaseType.getBodyScope();
        assert structBodyScope != nil<Scope*>;
        if !this.visitMethodCall(node, structBodyScope) { // Check if soft errors occurred
            return Any(ExprResult{node.node.setEvaluatedSymbolType(QualType(SuperType::TY_UNRESOLVED), this.manIdx), nil<SymbolTableEntry*>});
        }
        assert data.calleeParentScope != nil<Scope*>;
    } else if data.isFctPtrCall() {
        // This is a function pointer call
        const QualType firstFragType = firstFragEntry.getQualType();
        const QualType functionType = firstFragType.getBase();
        assert functionType.isOneOf(fctOrProc, len(fctOrProc));
        if !this.visitFctPtrCall(node, functionType) { // Check if soft errors occurred
            return Any(ExprResult{node.node.setEvaluatedSymbolType(QualType(SuperType::TY_UNRESOLVED), this.manIdx), nil<SymbolTableEntry*>});
        }
    } else {
        // This is an ordinary function call
        assert data.isOrdinaryCall() || data.isCtorCall();
        if !this.visitOrdinaryFctCall(node, fqFunctionName) { // Check if soft errors occurred
            return Any(ExprResult{node.node.setEvaluatedSymbolType(QualType(SuperType::TY_UNRESOLVED), this.manIdx), nil<SymbolTableEntry*>});
        }
        assert data.calleeParentScope != nil<Scope*>;

        // If the call is no ordinary call, it must be a constructor, which takes a struct as this type.
        assert data.isOrdinaryCall() || data.thisType.is(SuperType::TY_STRUCT);
    }

    const Function* callee = data.callee;
    if !data.isFctPtrCall() {
        // Check if we were able to find a function
        if callee == nil<const Function*> {
            // Build error message
            String functionName = node.functionNameFragments.back();
            if data.isCtorCall() {
                functionName = String(CTOR_FUNCTION_NAME);
            }
            ParamList errArgTypes;
            errArgTypes.reserve(cast<unsigned long>(data.args.getSize()));
            foreach const Arg& arg : data.args {
                // The host compiler aborts on a struct literal field, initialized with a reference to a type with an
                // overloaded assign operator, so the arg type is copied into a local first
                const QualType argType = arg.getFirst();
                errArgTypes.pushBack(Param{argType, false});
            }
            const QualTypeList noTemplateTypes;
            const String signature = getFunctionSignature(functionName, data.thisType, QualType(SuperType::TY_DYN), errArgTypes, noTemplateTypes, false);
            // Throw error
            return this.softErrorER(baseNode, SemanticErrorType::REFERENCED_UNDEFINED_FUNCTION, String("Function/procedure '") + signature + "' could not be found");
        }

        // Check if we need to request a re-visit, because the function body was not type-checked yet
        requestRevisitIfRequired(callee);

        // Get function entry from function object
        SymbolTableEntry* functionEntry = callee.entry;

        // Check if the called function has sufficient visibility
        data.isImported = data.calleeParentScope.isImportedBy(this.rootScope);
        const QualType functionEntryType = functionEntry.getQualType();
        if data.isImported && !functionEntryType.isPublic() {
            const String signature = callee.getSignature();
            if functionEntryType.is(SuperType::TY_FUNCTION) {
                return this.softErrorER(baseNode, SemanticErrorType::INSUFFICIENT_VISIBILITY, String("Function '") + signature + "' has insufficient visibility");
            } else {
                return this.softErrorER(baseNode, SemanticErrorType::INSUFFICIENT_VISIBILITY, String("Procedure '") + signature + "' has insufficient visibility");
            }
        }

        // Mark direct calls to err<T>(...) as an error-return-trace origin site when tracing is enabled for this file.
        // err<T>'s own internal delegation to Result<T>'s error ctor is a distinct ctor call and is never matched here,
        // so this only ever fires for the user's own call site, not for that nested one.
        if this.sourceFile.errorReturnTracing && callee.bodyScope != nil<Scope*> && callee.name == "err" {
            Scope* calleeBodyScope = callee.bodyScope;
            SourceFile* calleeSourceFile = calleeBodyScope.sourceFile;
            if calleeSourceFile.isResultRT() {
                node.isErrorTraceOrigin = true;
            }
        }
    }

    // Generate arg infos
    if node.hasArgs {
        QualTypeList paramTypes;
        if data.isFctPtrCall() {
            const QualType firstFragType = firstFragEntry.getQualType();
            const QualType functionType = firstFragType.getBase();
            paramTypes = functionType.getFunctionParamTypes();
        } else {
            assert callee != nil<const Function*>;
            paramTypes = callee.getParamTypes();
        }

        ASTArgLstNode* argLst = node.argLst;
        argLst.argInfos.clear();
        for unsigned long argIdx = 0l; argIdx < data.args.getSize(); argIdx++ {
            const QualType& expectedType = paramTypes.get(argIdx);
            const Arg& arg = data.args.get(argIdx);
            const QualType& actualType = arg.getFirst();

            Function* copyCtor = nil<Function*>;
            if expectedType.is(SuperType::TY_STRUCT) && actualType.is(SuperType::TY_STRUCT) && !actualType.isTriviallyCopyable(baseNode) {
                copyCtor = this.matchCopyCtor(actualType, baseNode);
                // Insert anonymous symbol to track the dtor call of the copy
                ASTNode* argNode = getASTNode(argLst.args.get(argIdx));
                this.currentScope.symbolTable.insertAnonymous(actualType, argNode, SIZE_MAX);
            }

            argLst.argInfos.pushBack(ArgInfo{copyCtor});
        }
        assert argLst.argInfos.getSize() == argLst.args.getSize();
    }

    // Retrieve return type
    bool isFct = false;
    QualType returnType = QualType(SuperType::TY_DYN);
    if data.isFctPtrCall() {
        const QualType firstFragType = firstFragEntry.getQualType();
        const QualType functionType = firstFragType.getBase();
        isFct = functionType.is(SuperType::TY_FUNCTION);
        if isFct {
            returnType = functionType.getFunctionReturnType();
        } else {
            returnType = QualType(SuperType::TY_BOOL);
        }
    } else {
        isFct = callee.isFunction();
        if data.isCtorCall() {
            returnType = data.thisType;
        } else if callee.isProcedure() {
            returnType = QualType(SuperType::TY_DYN);
        } else {
            returnType = callee.returnType;
        }
    }

    const QualType returnBaseType = returnType.getBase();

    // Make sure this source file knows about the return type
    if returnBaseType.is(SuperType::TY_STRUCT) {
        returnType = this.mapImportedScopeTypeToLocalType(returnBaseType.getBodyScope(), returnType);
    }

    // Add anonymous symbol to keep track of dtor call, if non-trivially destructible
    SymbolTableEntry* anonymousSymbol = nil<SymbolTableEntry*>;
    if returnType.is(SuperType::TY_STRUCT) && !returnType.isTriviallyDestructible(baseNode) {
        anonymousSymbol = this.currentScope.symbolTable.insertAnonymous(returnType, baseNode);
    }

    // Remove public qualifier to not have public local variables
    TypeQualifiers& returnTypeQualifiers = returnType.getQualifiers();
    returnTypeQualifiers.isPublic = false;

    // Check if the return value gets discarded
    if isFct && !node.hasReturnValueReceiver() {
        // Discarding a Result<T> is always a hard error when explicit error handling is enabled for this module,
        // regardless of ignoreUnusedReturnValue (which only ever weakens the generic warning below).
        const QualType unwrappedReturnType = returnType.removeReferenceWrapper();
        if this.sourceFile.explicitErrorHandling && unwrappedReturnType.isResultObj() {
            const String message = String("A Result<T> returned from a call must be handled: bind it to a variable, propagate it with the '!' operator, handle it with '.unwrapOr(...)'/'.unwrapOrElse(...)', or explicitly discard it by binding it to a variable with a name starting with '_'");
            return this.softErrorER(baseNode, SemanticErrorType::DISCARDED_RESULT_VALUE, message);
        }

        // Check if we want to ignore the discarded return value
        bool ignoreUnusedReturnValue = false;
        if !data.isFctPtrCall() {
            assert callee != nil<const Function*>;
            ASTNode* calleeDeclNode = callee.declNode;
            if calleeDeclNode.kind == ASTNodeKind::FCT_DEF {
                ASTFctDefNode* fctDef = downcast<ASTFctDefNode>(calleeDeclNode);
                if fctDef.node.attrs != nil<IVisitable*> {
                    ASTTopLevelDefAttrNode* attrs = downcast<ASTTopLevelDefAttrNode>(fctDef.node.attrs);
                    ASTAttrLstNode* attrLst = attrs.attrLst;
                    ignoreUnusedReturnValue = attrLst.hasAttr(String(ATTR_IGNORE_UNUSED_RETURN_VALUE));
                }
            }
        }

        if !ignoreUnusedReturnValue {
            this.addWarning(baseNode.codeLoc, CompilerWarningType::UNUSED_RETURN_VALUE, String("The return value of the function call is unused"));
        }
    }

    return Any(ExprResult{node.node.setEvaluatedSymbolType(returnType, this.manIdx), anonymousSymbol});
}

f<bool> TypeChecker.visitOrdinaryFctCall(ASTFctCallNode* node, String fqFunctionName) {
    ASTNode* baseNode = cast<ASTNode*>(node);
    FctCallData& data = node.data.get(this.manIdx);

    // Check if this is a well-known ctor/fct call
    if node.functionNameFragments.getSize() == 1l {
        this.ensureLoadedRuntimeForTypeName(fqFunctionName);
        this.ensureLoadedRuntimeForFunctionName(fqFunctionName);
    }

    // Check if the type is generic (possible in case of ctor call)
    const GenericType* genericType = this.rootScope.lookupGenericTypeStrict(fqFunctionName);
    if genericType != nil<const GenericType*> && this.typeMapping.contains(fqFunctionName) {
        const QualType& replacementType = this.typeMapping.get(fqFunctionName);
        if replacementType.is(SuperType::TY_STRUCT) {
            fqFunctionName = replacementType.getSubType();
        }
    }

    // Check if the exported name registry contains that function name
    const NameRegistryEntry* functionRegistryEntry = this.sourceFile.getNameRegistryEntry(fqFunctionName);
    if functionRegistryEntry == nil<const NameRegistryEntry*> {
        const String message = String("Function/procedure/struct '") + node.functionNameFragments.back() + "' could not be found";
        this.softError(baseNode, SemanticErrorType::REFERENCED_UNDEFINED_FUNCTION, message);
        return false;
    }
    const SymbolTableEntry* functionEntry = functionRegistryEntry.targetEntry;
    data.calleeParentScope = functionRegistryEntry.targetScope;

    // Check if the target symbol is a struct -> this must be a constructor call
    String functionName = node.functionNameFragments.back();
    if functionEntry != nil<const SymbolTableEntry*> {
        const QualType structEntryType = functionEntry.getQualType();
        if structEntryType.is(SuperType::TY_STRUCT) {
            data.callType = FctCallType::TYPE_CTOR;
            functionName = String(CTOR_FUNCTION_NAME);

            // Substantiate potentially generic this struct
            const Struct* thisStruct = structEntryType.getStruct(baseNode, data.templateTypes);
            if thisStruct == nil<const Struct*> {
                const SymbolTableEntry* structEntry = functionRegistryEntry.targetEntry;
                const String signature = getStructSignature(structEntry.name, data.templateTypes);
                this.softError(baseNode, SemanticErrorType::UNKNOWN_DATATYPE, String("Could not find struct candidate for struct '") + signature + "'. Do the template types match?");
                return false;
            }

            // Set the 'this' type of the function to the struct type
            data.thisType = structEntryType.getWithBodyScope(thisStruct.scope);
            data.calleeParentScope = thisStruct.scope;
        }
    }

    // Attach the concrete template types to the 'this' type
    if !data.thisType.is(SuperType::TY_DYN) && !data.templateTypes.isEmpty() {
        data.thisType = data.thisType.getWithTemplateTypes(data.templateTypes);
    }

    // Map local arg types to imported types
    for unsigned long i = 0l; i < data.args.getSize(); i++ {
        Arg& arg = data.args.get(i);
        QualType& argType = arg.getFirst();
        argType = this.mapLocalTypeToImportedScopeType(data.calleeParentScope, argType);
    }

    // Map local template types to imported types
    for unsigned long i = 0l; i < data.templateTypes.getSize(); i++ {
        QualType& templateType = data.templateTypes.get(i);
        templateType = this.mapLocalTypeToImportedScopeType(data.calleeParentScope, templateType);
    }

    // Retrieve function object
    Scope* matchScope = data.calleeParentScope;
    data.callee = matchFunction(matchScope, functionName, data.thisType, data.args, data.templateTypes, false, baseNode);

    return true;
}

f<bool> TypeChecker.visitFctPtrCall(ASTFctCallNode* node, const QualType& functionType) {
    const FctCallData& data = node.data.get(this.manIdx);

    // Check if the given argument types match the type
    const QualTypeList expectedArgTypes = functionType.getFunctionParamTypes();
    if data.args.getSize() != expectedArgTypes.getSize() {
        this.softError(cast<ASTNode*>(node), SemanticErrorType::REFERENCED_UNDEFINED_FUNCTION, String("Expected and actual number of arguments do not match"));
        return false;
    }

    // The host passes a resolver function, that never resolves a generic type. The equivalent is an empty list of candidate
    // template types
    const Vector<GenericType> noCandidateTemplateTypes;

    for unsigned long i = 0l; i < data.args.getSize(); i++ {
        const Arg& arg = data.args.get(i);
        const QualType& actualType = arg.getFirst();
        const QualType& expectedType = expectedArgTypes.get(i);
        TypeMapping typeMapping;
        if !matchRequestedToCandidateType(expectedType, actualType, typeMapping, noCandidateTemplateTypes, false, false) {
            const String message = String("Expected ") + expectedType.getName(false) + " but got " + actualType.getName(false);
            this.softError(getASTNode(node.argLst.args.get(i)), SemanticErrorType::REFERENCED_UNDEFINED_FUNCTION, message);
            return false;
        }
    }
    return true;
}

f<bool> TypeChecker.visitMethodCall(ASTFctCallNode* node, Scope* structScope) {
    ASTNode* baseNode = cast<ASTNode*>(node);
    FctCallData& data = node.data.get(this.manIdx);
    Scope* currentStructScope = structScope;

    // Traverse through structs - the first fragment is already looked up and the last one is the method name
    for unsigned long i = 1l; i < node.functionNameFragments.getSize() - 1l; i++ {
        const String& identifier = node.functionNameFragments.get(i);

        // Retrieve field entry, also looking through composed fields
        Vector<unsigned long> indexPath;
        SymbolTableEntry* fieldEntry = currentStructScope.symbolTable.lookupInComposedFields(identifier, indexPath);
        if fieldEntry == nil<SymbolTableEntry*> {
            const QualType thisBaseType = data.thisType.getBase();
            const String errorMsg = String("The type '") + thisBaseType.getName(false, true) + "' does not have a member with the name '" + identifier + "'";
            this.softError(baseNode, SemanticErrorType::ACCESS_TO_NON_EXISTING_MEMBER, errorMsg);
            return false;
        }
        const QualType fieldType = fieldEntry.getQualType();
        const QualType fieldBaseType = fieldType.getBase();
        const dyn structOrInterface = [SuperType::TY_STRUCT, SuperType::TY_INTERFACE];
        if !fieldBaseType.isOneOf(structOrInterface, len(structOrInterface)) {
            const String message = String("Cannot call a method on '") + identifier + "', since it is no struct or interface";
            this.softError(baseNode, SemanticErrorType::INVALID_MEMBER_ACCESS, message);
            return false;
        }
        fieldEntry.used = true;

        // Get struct type and scope
        data.thisType = fieldType;
        currentStructScope = fieldBaseType.getBodyScope();
        assert currentStructScope != nil<Scope*>;
    }

    if data.thisType.is(SuperType::TY_INTERFACE) {
        this.softError(baseNode, SemanticErrorType::INVALID_MEMBER_ACCESS, String("Cannot call a method on an interface"));
        return false;
    }

    // Map local arg types to imported types
    data.calleeParentScope = currentStructScope;
    Scope* matchScope = currentStructScope;
    for unsigned long i = 0l; i < data.args.getSize(); i++ {
        Arg& arg = data.args.get(i);
        QualType& argType = arg.getFirst();
        argType = this.mapLocalTypeToImportedScopeType(data.calleeParentScope, argType);
    }

    // Map local template types to imported types
    for unsigned long i = 0l; i < data.templateTypes.getSize(); i++ {
        QualType& templateType = data.templateTypes.get(i);
        templateType = this.mapLocalTypeToImportedScopeType(data.calleeParentScope, templateType);
    }

    // 'this' type
    data.thisType = data.thisType.autoDereference();
    data.thisType = this.mapLocalTypeToImportedScopeType(data.calleeParentScope, data.thisType);

    // Retrieve function object
    const String& functionName = node.functionNameFragments.back();
    data.callee = matchFunction(matchScope, functionName, data.thisType, data.args, data.templateTypes, false, baseNode);

    return true;
}

public f<Any> TypeChecker.visitArrayInitialization(ASTArrayInitializationNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);
    if node.itemLst == nil<ASTArgLstNode*> || node.itemLst.args.isEmpty() {
        return this.softErrorER(baseNode, SemanticErrorType::ARRAY_SIZE_INVALID, String("Array initializers must at least contain one value"));
    }
    node.actualSize = cast<unsigned long>(node.itemLst.args.getSize());

    QualType actualItemType = QualType(SuperType::TY_DYN);
    // Check if all values have the same type
    foreach IVisitable* arg : node.itemLst.args {
        const ExprResult itemResult = this.visitExpr(arg);
        const QualType itemType = itemResult.ty;
        if itemType.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }
        if actualItemType.is(SuperType::TY_DYN) { // Perform type inference
            actualItemType = itemType;
        } else if itemType != actualItemType { // Check if types are matching
            const String message = String("All provided values have to be of the same data type. You provided ") + actualItemType.getName(false) + " and " + itemType.getName(false);
            return this.softErrorER(getASTNode(arg), SemanticErrorType::ARRAY_ITEM_TYPE_NOT_MATCHING, message);
        }
    }
    assert !actualItemType.is(SuperType::TY_DYN);

    const QualType arrayType = actualItemType.toArr(baseNode, cast<unsigned int>(node.actualSize), true);
    return Any(ExprResult{node.node.setEvaluatedSymbolType(arrayType, this.manIdx), nil<SymbolTableEntry*>});
}

public f<Any> TypeChecker.visitStructInstantiation(ASTStructInstantiationNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Retrieve struct name
    Pair<SymbolTableEntry*, bool> aliasResolution = this.rootScope.symbolTable.lookupWithAliasResolution(node.fqStructName);
    SymbolTableEntry* aliasedEntry = aliasResolution.getFirst();
    const bool isAlias = aliasResolution.getSecond();
    String structName = node.fqStructName;
    if isAlias {
        const QualType aliasedType = aliasedEntry.getQualType();
        structName = aliasedType.getSubType();
    }

    // Check if the struct type is generic
    const GenericType* genericType = this.rootScope.lookupGenericTypeStrict(structName);
    if genericType != nil<const GenericType*> && this.typeMapping.contains(structName) {
        const QualType& replacementType = this.typeMapping.get(structName);
        if replacementType.is(SuperType::TY_STRUCT) {
            structName = replacementType.getSubType();
        }
    }

    // Retrieve struct
    const NameRegistryEntry* registryEntry = this.sourceFile.getNameRegistryEntry(structName);
    if registryEntry == nil<const NameRegistryEntry*> {
        return this.softErrorER(baseNode, SemanticErrorType::REFERENCED_UNDEFINED_STRUCT, String("Cannot find struct '") + structName + "'");
    }
    assert registryEntry.targetEntry != nil<SymbolTableEntry*> && registryEntry.targetScope != nil<Scope*>;
    SymbolTableEntry* structEntry = registryEntry.targetEntry;

    // Check visibility
    const QualType structEntryType = structEntry.getQualType();
    if !structEntryType.isPublic() && structEntry.scope.isImportedBy(this.currentScope) {
        return this.softErrorER(baseNode, SemanticErrorType::INSUFFICIENT_VISIBILITY, String("Struct '") + structName + "' has insufficient visibility");
    }

    // Get struct type
    QualType structType = structEntryType;

    // Get the concrete template types
    QualTypeList concreteTemplateTypes;
    if isAlias {
        // Retrieve concrete template types from type alias
        const QualType aliasedType = aliasedEntry.getQualType();
        concreteTemplateTypes = aliasedType.getTemplateTypes();
        // Check if the aliased type specified template types and the struct instantiation does
        if !concreteTemplateTypes.isEmpty() && node.templateTypeLst != nil<ASTTypeLstNode*> {
            return this.softErrorER(cast<ASTNode*>(node.templateTypeLst), SemanticErrorType::ALIAS_WITH_TEMPLATE_LIST, String("The aliased type already has a template list"));
        }
    }

    if node.templateTypeLst != nil<ASTTypeLstNode*> {
        concreteTemplateTypes.reserve(cast<unsigned long>(node.templateTypeLst.dataTypes.getSize()));
        foreach ASTDataTypeNode* dataType : node.templateTypeLst.dataTypes {
            const QualType concreteType = this.getDataType(dataType);
            if concreteType.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }
            // Check if generic type
            if concreteType.is(SuperType::TY_GENERIC) {
                return this.softErrorER(cast<ASTNode*>(dataType), SemanticErrorType::EXPECTED_NON_GENERIC_TYPE, String("Struct instantiations may only take concrete template types"));
            }
            concreteTemplateTypes.pushBack(concreteType);
        }
    }

    // Get the struct instance
    Struct* spiceStruct = structType.getStructAndAdjustType(baseNode, concreteTemplateTypes);
    Struct*& instantiatedStruct = node.instantiatedStructs.get(this.manIdx);
    instantiatedStruct = spiceStruct;
    if spiceStruct == nil<Struct*> {
        const String message = String("Struct '") + getStructSignature(structName, concreteTemplateTypes) + "' could not be found";
        return this.softErrorER(baseNode, SemanticErrorType::REFERENCED_UNDEFINED_STRUCT, message);
    }

    // Struct instantiation for an inheriting struct is forbidden, because the vtable needs to be initialized and this is done in
    // the ctor of the struct, which is never called in case of struct instantiation
    if !spiceStruct.interfaceTypes.isEmpty() {
        return this.softErrorER(baseNode, SemanticErrorType::INVALID_STRUCT_INSTANTIATION, String("Struct instantiations for inheriting structs are forbidden"));
    }

    // Check if the number of fields matches
    if node.fieldLst != nil<ASTArgLstNode*> { // Check if any fields are passed. Empty braces are also allowed
        ASTArgLstNode* fieldLst = node.fieldLst;
        if spiceStruct.fieldTypes.getSize() != fieldLst.args.getSize() {
            return this.softErrorER(cast<ASTNode*>(fieldLst), SemanticErrorType::NUMBER_OF_FIELDS_NOT_MATCHING, String("You've passed too less/many field values. Pass either none or all of them"));
        }

        // Check if the field types are matching
        const unsigned long fieldCount = cast<unsigned long>(spiceStruct.fieldTypes.getSize());
        Scope* structScope = spiceStruct.scope;
        const unsigned long explicitFieldsStartIdx = structScope.getFieldCount() - fieldCount;
        // Per-manifestation: a struct literal inside a generic function is re-type-checked once per manifestation of
        // that function, and the struct itself may resolve to a different concrete type each time (e.g. HashEntry<K,
        // V> inside HashTable<K, V>.upsert()), so the copy-ctor set from one manifestation must not leak into another.
        Vector<Function*>& fieldCopyCtors = node.fieldCopyCtors.get(this.manIdx);
        fieldCopyCtors.clear();
        for unsigned long i = 0l; i < fieldLst.args.getSize(); i++ {
            // Get actual type
            IVisitable* assignExpr = fieldLst.args.get(i);
            ASTNode* assignExprNode = getASTNode(assignExpr);
            ExprResult fieldResult = this.visitExpr(assignExpr);
            if fieldResult.ty.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }
            // Get expected type
            SymbolTableEntry* expectedField = structScope.lookupField(cast<unsigned int>(explicitFieldsStartIdx + i));
            assert expectedField != nil<SymbolTableEntry*>;
            // The host compiler aborts on a struct literal field, initialized with a reference to a type with an overloaded
            // assign operator, so the field type is copied into a local first
            const QualType expectedFieldType = expectedField.getQualType();
            const ExprResult expected = ExprResult{expectedFieldType, expectedField};
            const bool rhsIsImmediate = assignExprNode.hasCompileTimeValue(this.manIdx);

            // Capture anonymous info up front: getFieldAssignResultType may delete the anonymous entry (temp stealing
            // in performStructAssign), turning fieldResult.entry into a dangling pointer.
            const bool rhsIsAnonymous = fieldResult.entry != nil<SymbolTableEntry*> && fieldResult.entry.anonymous;
            String rhsEntryName = String("");
            if rhsIsAnonymous {
                rhsEntryName = fieldResult.entry.name;
            }

            // Check if actual type matches expected type. A non-anonymous, non-trivially-copyable rhs (e.g. a plain
            // local variable) needs its value deep-copied into the field: the struct instantiation does not
            // consume/move it, so the caller keeps its own copy alive and destructs it independently.
            Pair<QualType, Function*> fieldAssignResult = this.opRuleManager.getFieldAssignResultType(assignExprNode, expected, fieldResult, rhsIsImmediate, true);
            fieldCopyCtors.pushBack(fieldAssignResult.getSecond());

            // If there is an anonymous entry attached (e.g. for struct instantiation), delete it.
            // Safe to call even if performStructAssign already deleted it: erasing by key is a no-op when absent.
            if rhsIsAnonymous {
                this.currentScope.symbolTable.deleteAnonymous(rhsEntryName);
                fieldResult.entry = nil<SymbolTableEntry*>;
            }
        }
        assert fieldCopyCtors.getSize() == fieldLst.args.getSize();
    } else {
        bool hasReferenceField = false;
        foreach const QualType& fieldType : spiceStruct.fieldTypes {
            if fieldType.isRef() {
                hasReferenceField = true;
            }
        }
        if hasReferenceField {
            return this.softErrorER(baseNode, SemanticErrorType::REFERENCE_WITHOUT_INITIALIZER, String("The struct takes at least one reference field. You need to instantiate it with all fields."));
        }
    }

    // Update type of struct entry
    structEntry.updateType(structType, true);

    // Add anonymous symbol to keep track of dtor call, if non-trivially destructible
    SymbolTableEntry* anonymousEntry = nil<SymbolTableEntry*>;
    if !structType.isTriviallyDestructible(baseNode) {
        anonymousEntry = this.currentScope.symbolTable.insertAnonymous(structType, baseNode);
    }

    // Remove public qualifier to not have public local variables
    TypeQualifiers& structTypeQualifiers = structType.getQualifiers();
    structTypeQualifiers.isPublic = false;

    return Any(ExprResult{node.node.setEvaluatedSymbolType(structType, this.manIdx), anonymousEntry});
}

public f<Any> TypeChecker.visitLambdaFunc(ASTLambdaFuncNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Check if all control paths in the lambda body return
    bool returnsOnAllControlPaths = true;
    if !baseNode.returnsOnAllControlPaths(&returnsOnAllControlPaths, this.manIdx) {
        return this.softErrorER(baseNode, SemanticErrorType::MISSING_RETURN_STMT, String("Not all control paths of this lambda function have a return statement"));
    }

    // Change to function scope
    Scope* bodyScope = this.currentScope.getChildScope(node.getScopeId());
    ScopeHandle scopeHandle = ScopeHandle(&this.compilerPass, bodyScope, ScopeType::LAMBDA_BODY);

    // Visit return type
    const QualType returnType = this.getDataType(node.returnType);
    if returnType.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }
    if returnType.is(SuperType::TY_DYN) {
        return this.softErrorER(baseNode, SemanticErrorType::UNEXPECTED_DYN_TYPE, String("Dyn return types are not allowed"));
    }

    // Set the type of the result variable
    SymbolTableEntry* resultVarEntry = this.currentScope.lookupStrict(String(RETURN_VARIABLE_NAME));
    assert resultVarEntry != nil<SymbolTableEntry*>;
    resultVarEntry.updateType(returnType, true);
    resultVarEntry.used = true;

    // Visit parameters
    QualTypeList paramTypes;
    ParamList paramList;
    if node.hasParams {
        this.visitLambdaParams(baseNode, node.paramLst, paramTypes, paramList);
    }

    // Visit lambda body
    this.visit(node.body);

    // Leave function body scope
    scopeHandle.leaveScopeEarly();

    // Prepare type of function
    const QualType functionTypeBase = QualType(SuperType::TY_FUNCTION);
    const QualType functionTypeWithSignature = functionTypeBase.getWithFunctionParamAndReturnTypes(returnType, paramTypes);
    const QualType functionType = functionTypeWithSignature.getWithLambdaCaptures(!bodyScope.symbolTable.captures.isEmpty());

    // Create function object
    this.createLambdaManifestation(baseNode, bodyScope, returnType, paramList);

    // Check special requirements if this is an async lambda
    this.checkAsyncLambdaCaptureRules(baseNode, node.lambdaAttr);

    return Any(ExprResult{node.node.node.setEvaluatedSymbolType(functionType, this.manIdx), nil<SymbolTableEntry*>});
}

public f<Any> TypeChecker.visitLambdaProc(ASTLambdaProcNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Mark unreachable statements
    bool doSetPredecessorsUnreachable = true;
    baseNode.returnsOnAllControlPaths(&doSetPredecessorsUnreachable, this.manIdx);

    // Change to function scope
    Scope* bodyScope = this.currentScope.getChildScope(node.getScopeId());
    ScopeHandle scopeHandle = ScopeHandle(&this.compilerPass, bodyScope, ScopeType::LAMBDA_BODY);

    // Visit parameters
    QualTypeList paramTypes;
    ParamList paramList;
    if node.hasParams {
        this.visitLambdaParams(baseNode, node.paramLst, paramTypes, paramList);
    }

    // Visit lambda body
    this.visit(node.body);

    // Leave function body scope
    scopeHandle.leaveScopeEarly();

    // Prepare type of function
    const QualType functionTypeBase = QualType(SuperType::TY_PROCEDURE);
    const QualType functionTypeWithSignature = functionTypeBase.getWithFunctionParamAndReturnTypes(QualType(SuperType::TY_DYN), paramTypes);
    const QualType functionType = functionTypeWithSignature.getWithLambdaCaptures(!bodyScope.symbolTable.captures.isEmpty());

    // Create function object
    this.createLambdaManifestation(baseNode, bodyScope, QualType(SuperType::TY_DYN), paramList);

    // Check special requirements if this is an async lambda
    this.checkAsyncLambdaCaptureRules(baseNode, node.lambdaAttr);

    return Any(ExprResult{node.node.node.setEvaluatedSymbolType(functionType, this.manIdx), nil<SymbolTableEntry*>});
}

public f<Any> TypeChecker.visitLambdaExpr(ASTLambdaExprNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Change to function scope
    Scope* bodyScope = this.currentScope.getChildScope(node.getScopeId());
    ScopeHandle scopeHandle = ScopeHandle(&this.compilerPass, bodyScope, ScopeType::LAMBDA_BODY);

    // Visit parameters
    QualTypeList paramTypes;
    ParamList paramList;
    if node.hasParams {
        this.visitLambdaParams(baseNode, node.paramLst, paramTypes, paramList);
    }

    // Visit lambda expression
    const ExprResult lambdaExprResult = this.visitExpr(node.lambdaExpr);
    const QualType returnType = lambdaExprResult.ty;
    if returnType.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }
    if returnType.is(SuperType::TY_DYN) {
        return this.softErrorER(baseNode, SemanticErrorType::UNEXPECTED_DYN_TYPE, String("Dyn return types are not allowed"));
    }

    // Leave function body scope
    scopeHandle.leaveScopeEarly();

    // Prepare type of function
    const SuperType superType = returnType.is(SuperType::TY_DYN) ? SuperType::TY_PROCEDURE : SuperType::TY_FUNCTION;
    const QualType functionTypeBase = QualType(superType);
    const QualType functionTypeWithSignature = functionTypeBase.getWithFunctionParamAndReturnTypes(returnType, paramTypes);
    const QualType functionType = functionTypeWithSignature.getWithLambdaCaptures(!bodyScope.symbolTable.captures.isEmpty());

    // Create function object
    this.createLambdaManifestation(baseNode, bodyScope, returnType, paramList);

    return Any(ExprResult{node.node.node.setEvaluatedSymbolType(functionType, this.manIdx), nil<SymbolTableEntry*>});
}

/**
 * Visit the param list of a lambda and collect the param types (shared part of the host's visitLambdaFunc/Proc/Expr)
 *
 * @param node Lambda node
 * @param paramLst Param list node
 * @param paramTypes Param types
 * @param paramList Params
 */
p TypeChecker.visitLambdaParams(ASTNode* node, IVisitable* paramLst, QualTypeList& paramTypes, ParamList& paramList) {
    // Visit param list to retrieve the param names
    Any paramLstResult = this.visit(paramLst);
    const NamedParamList namedParamList = paramLstResult.get<NamedParamList>();
    foreach const NamedParam& param : namedParamList {
        if param.isOptional {
            this.softError(node, SemanticErrorType::LAMBDA_WITH_OPTIONAL_PARAMS, String("Lambdas cannot have optional parameters"));
        }

        paramTypes.pushBack(param.qualType);
        paramList.pushBack(Param{param.qualType, param.isOptional});
    }
}

/**
 * Create the function object of a lambda for the current manifestation (shared part of the host's visitLambdaFunc/Proc/Expr)
 *
 * @param node Lambda node
 * @param bodyScope Body scope of the lambda
 * @param returnType Return type of the lambda
 * @param paramList Params of the lambda
 */
p TypeChecker.createLambdaManifestation(ASTNode* node, Scope* bodyScope, const QualType& returnType, const ParamList& paramList) {
    const String fctName = String("lambda.") + node.codeLoc.toPrettyLineAndColumn();
    ASTLambdaBaseNode* lambdaBaseNode = asLambdaBaseNode(node);
    Function& manifestation = lambdaBaseNode.manifestations.get(this.manIdx);
    const Vector<GenericType> noTemplateTypes;
    manifestation = Function(fctName, nil<SymbolTableEntry*>, QualType(SuperType::TY_DYN), returnType, paramList, noTemplateTypes, node);
    manifestation.bodyScope = bodyScope;
    manifestation.mangleSuffix = String(".") + toString(cast<long>(this.manIdx));
}

