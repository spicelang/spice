// Constants
const string FCT_NAME_DEALLOC = "sDealloc";
const unsigned long UNION_NO_DEFAULT_FIELD_INDEX = 18446744073709551615ul; // SIZE_MAX in the host
const unsigned long SIZE_MAX = 18446744073709551615ul;

/**
 * Global switch that tells matchStruct whether a freshly substantiated struct manifestation may still be given its
 * compiler-generated default members (ctor, copy ctor, move ctor, dtor).
 *
 * Creating those mutates the symbol table and registers new functions, which is only valid while the middle end runs.
 * The back end reaches matchStruct as well - through QualType.getStruct - but by then every manifestation exists
 * already, so those calls never take the creation path anyway. The switch makes that an invariant instead of an
 * assumption.
 */
public bool STRUCT_DEFAULT_MEMBERS_DECIDABLE = false;

/**
 * RAII marker for the section of the compiler in which struct manifestations are still allowed to receive their
 * compiler-generated default members, i.e. the middle end.
 */
public type DefaultMemberCreationSection struct {}

public p DefaultMemberCreationSection.ctor() {
    STRUCT_DEFAULT_MEMBERS_DECIDABLE = true;
}

public p DefaultMemberCreationSection.dtor() {
    STRUCT_DEFAULT_MEMBERS_DECIDABLE = false;
}

public type TypeCheckerMode enum {
    TC_MODE_PRE,
    TC_MODE_POST
}

/**
 * Jobs:
 * - Ensure that all actual types match the expected types
 * - Perform type inference
 *
 * This file mirrors the host TypeChecker, which is split over several files (TypeChecker.cpp, TypeCheckerMeta.cpp, ...).
 * Spice requires all methods of a struct to live in the file of the struct, so the sections below are named after them.
 *
 * Error handling: the host throws a SemanticError for some problems. Spice has no exceptions, so this pass records a soft
 * error and returns from the visit method of the offending node instead (SourceFile.checkForSoftErrors() aborts the
 * compilation afterwards).
 */
public type TypeChecker struct : IAbstractAstVisitor {
    compose public CompilerPass compilerPass
    OpRuleManager opRuleManager
    TypeCheckerMode typeCheckerMode
    Vector<CompilerWarning>* warnings
    TypeMapping typeMapping
    bool typeCheckedMainFct = false
}

public p TypeChecker.ctor(GlobalResourceManager& resourceManager, SourceFile* sourceFile, TypeCheckerMode typeCheckerMode) {
    this.compilerPass = CompilerPass(resourceManager, sourceFile);
    this.opRuleManager = OpRuleManager(this);
    this.typeCheckerMode = typeCheckerMode;
    this.warnings = &sourceFile.compilerOutput.warnings;
}

// Generic double-dispatch entry point required by IAbstractAstVisitor. source-file.spice calls the concrete
// visit(ASTEntryNode*) overload below.
#[ignoreUnusedReturnValue]
public f<Any> TypeChecker.visit(IVisitable* node) {
    return node.accept(cast<IAbstractAstVisitor*>(this));
}

#[ignoreUnusedReturnValue]
public f<Any> TypeChecker.visit(ASTEntryNode* node) {
    return this.visitEntry(node);
}

// Default behavior of every visit method that is not implemented below: visit all children (like the host's ASTVisitor).
// The host aborts the whole visitor by throwing on a hard error. The bootstrap records the hard error instead and stops
// visiting further children here, because the following nodes may depend on what the erroneous node failed to set up.
#[ignoreUnusedReturnValue]
f<Any> TypeChecker.visitChildren(ASTNode* node) {
    const ErrorManager& errorManager = this.resourceManager.getErrorManager();
    foreach ASTNode* child : node.children {
        if errorManager.hasHardError {
            break;
        }
        assert child != nil<ASTNode*>;
        assert child.visitable != nil<IVisitable*>;
        this.visit(child.visitable);
    }
    return Any();
}

// Visit a node, which evaluates to a type (e.g. a data type node)
f<QualType> TypeChecker.visitType(IVisitable* node) {
    Any visitResult = this.visit(node);
    return visitResult.get<QualType>();
}

// Shorthand for visitType, for data type nodes
f<QualType> TypeChecker.getDataType(ASTDataTypeNode* node) {
    return this.visitType(cast<IVisitable*>(node));
}

// Visit a node, which evaluates to an expression result (e.g. an expression node)
f<ExprResult> TypeChecker.visitExpr(IVisitable* node) {
    Any visitResult = this.visit(node);
    return visitResult.get<ExprResult>();
}

// Return value of a visit method, that evaluates to an unresolved type after a soft error (SOFT_ERROR_QT in the host)
f<Any> TypeChecker.softErrorQT(const ASTNode* node, SemanticErrorType errorType, const String& message) {
    this.softError(node, errorType, message);
    return Any(QualType(SuperType::TY_UNRESOLVED));
}

// Return value of a visit method, that evaluates to an expression result, after a soft error (SOFT_ERROR_ER in the host)
f<Any> TypeChecker.softErrorER(const ASTNode* node, SemanticErrorType errorType, const String& message) {
    this.softError(node, errorType, message);
    return unresolvedER();
}

// Return value of a visit method, that evaluates to an unresolved expression result (HANDLE_UNRESOLVED_TYPE_ER in the host)
f<Any> unresolvedER() {
    return Any(ExprResult{QualType(SuperType::TY_UNRESOLVED), nil<SymbolTableEntry*>});
}

// ======================================================== TypeChecker.cpp ======================================================

public f<Any> TypeChecker.visitEntry(ASTEntryNode* node) {
    // Initialize
    this.currentScope = this.rootScope;

    // Initialize AST nodes with size of 1
    const bool isPrepare = this.typeCheckerMode == TypeCheckerMode::TC_MODE_PRE;
    ASTNode* baseNode = cast<ASTNode*>(node);
    if isPrepare {
        baseNode.resizeToNumberOfManifestations(1l);
    }

    // Find switch statements, that cover all items of an enum. This has to be done before visiting the children, because
    // the control flow analysis of functions and procedures in the prepare stage relies on it
    if isPrepare {
        foreach IVisitable* switchStmt : node.switchStmts {
            ASTSwitchStmtNode* switchStmtNode = downcast<ASTSwitchStmtNode>(getASTNode(switchStmt));
            switchStmtNode.coversAllEnumItems = this.coversAllEnumItems(switchStmtNode);
        }
    }

    // Visit children
    this.visitChildren(baseNode);
    // The host would have thrown on a hard error, so skip the rest (the compilation is aborted after this stage)
    const ErrorManager& errorManager = this.resourceManager.getErrorManager();
    if errorManager.hasHardError {
        return Any();
    }

    // Check which implicit structures we need for each struct, defined in this source file. Manifestations that are
    // substantiated after this point are decided on directly at their creation (see createImplicitDefaultMembers).
    if isPrepare {
        Vector<Struct*> manifestations = this.rootScope.getAllStructManifestationsInDeclarationOrder();
        foreach Struct* manifestation : manifestations {
            createImplicitDefaultMembers(*manifestation, baseNode);
        }
    }

    return Any();
}

/**
 * Check if the case constants of a switch statement cover all items of a single enum
 *
 * @param node Switch statement node
 * @return All enum items covered or not
 */
f<bool> TypeChecker.coversAllEnumItems(ASTSwitchStmtNode* node) {
    ASTEnumDefNode* enumDef = nil<ASTEnumDefNode*>;
    Vector<ASTEnumItemNode*> coveredItems;
    foreach IVisitable* caseBranch : node.caseBranches {
        ASTCaseBranchNode* caseBranchNode = downcast<ASTCaseBranchNode>(caseBranch);
        foreach IVisitable* constant : caseBranchNode.caseConstants {
            ASTCaseConstantNode* constantNode = downcast<ASTCaseConstantNode>(constant);
            // Literal constants can never be enum items
            if constantNode.constant != nil<ASTConstantNode*> {
                return false;
            }

            // Resolve the enum item via the name registry, since enum items are always referenced by their qualified name
            const NameRegistryEntry* registryEntry = this.sourceFile.getNameRegistryEntry(constantNode.fqIdentifier);
            if registryEntry == nil<const NameRegistryEntry*> || registryEntry.targetEntry == nil<SymbolTableEntry*> {
                return false;
            }
            ASTNode* declNode = registryEntry.targetEntry.declNode;
            if declNode == nil<ASTNode*> || declNode.kind != ASTNodeKind::ENUM_ITEM {
                return false;
            }
            ASTEnumItemNode* enumItemNode = downcast<ASTEnumItemNode>(declNode);

            // All case constants have to be items of the same enum
            if enumDef != nil<ASTEnumDefNode*> && enumItemNode.enumDef != enumDef {
                return false;
            }
            enumDef = enumItemNode.enumDef;
            bool alreadyCovered = false;
            foreach ASTEnumItemNode* coveredItem : coveredItems {
                if coveredItem == enumItemNode {
                    alreadyCovered = true;
                }
            }
            if !alreadyCovered {
                coveredItems.pushBack(enumItemNode);
            }
        }
    }
    if enumDef == nil<ASTEnumDefNode*> {
        return false;
    }
    ASTEnumItemLstNode* itemLst = downcast<ASTEnumItemLstNode>(enumDef.itemLst);
    return coveredItems.getSize() == itemLst.items.getSize();
}

/**
 * Check if the capture rules for async lambdas are enforced if the async attribute is set
 *
 * Only one capture with pointer type, pass-by-val is allowed, since only then we can store it in the second field of the
 * fat pointer and can ensure, that no stack variable is referenced inside the lambda.
 *
 * @param node Lambda node
 * @param attrs Lambda attributes
 * @return False if the rules are violated, true otherwise
 */
#[ignoreUnusedReturnValue]
f<bool> TypeChecker.checkAsyncLambdaCaptureRules(ASTNode* node, const ASTLambdaAttrNode* attrs) {
    // If the async attribute is not set, we can return early
    if attrs == nil<const ASTLambdaAttrNode*> {
        return true; // Not violated
    }
    ASTAttrLstNode* attrLst = attrs.attrLst;
    if !attrLst.hasAttr(String(ATTR_ASYNC)) {
        return true; // Not violated
    }
    const CompileTimeValue asyncValue = attrLst.getAttrValueByName(String(ATTR_ASYNC));
    if !asyncValue.getBoolValue() {
        return true; // Not violated
    }

    // If we don't have any captures, we can return early
    ASTLambdaBaseNode* lambdaBaseNode = asLambdaBaseNode(node);
    Scope* bodyScope = lambdaBaseNode.bodyScope;
    CaptureMap& captures = bodyScope.symbolTable.captures;
    if captures.isEmpty() {
        return true; // Not violated
    }

    // Check for the capture rules
    bool violated = captures.getSize() > 1ul;
    foreach Pair<const String&, Capture&> captureEntry : captures {
        // Only the first capture is inspected
        Capture& capture = captureEntry.getSecond();
        const QualType capturedType = capture.capturedSymbol.getQualType();
        violated = violated || !capturedType.isPtr() || capture.getMode() != CapturePassMode::BY_VALUE;
        break;
    }
    if violated {
        const String warningMessage = String("Async lambdas can only capture one pointer by value without storing captures in the caller stack frame, which can lead to bugs due to references, outliving the validity scope of the referenced variable.");
        this.addWarning(node.codeLoc, CompilerWarningType::ASYNC_LAMBDA_CAPTURE_RULE_VIOLATION, warningMessage);
    }

    return false; // Violated
}

/**
 * Match the copy ctor of the given struct type
 *
 * @param thisType Struct type
 * @param node Current AST node
 * @return Copy ctor, or nil if there is none
 */
f<Function*> TypeChecker.matchCopyCtor(const QualType& thisType, const ASTNode* node) {
    Scope* matchScope = thisType.getBodyScope();
    assert matchScope != nil<Scope*>;
    const QualType argType = thisType.toConstRef(node);
    ArgList args;
    args.pushBack(Pair<QualType, bool>(argType, false));
    // The new instance being constructed is never const, regardless of whether the copy source (thisType) is const
    const QualType nonConstThisType = thisType.toNonConst();
    const QualTypeList noTemplateTypeHints;
    return matchFunction(matchScope, String(CTOR_FUNCTION_NAME), nonConstThisType, args, noTemplateTypeHints, true, node);
}

/**
 * Match the move ctor of the given struct type
 *
 * @param thisType Struct type
 * @param node Current AST node
 * @return Move ctor, or nil if there is none
 */
f<Function*> TypeChecker.matchMoveCtor(const QualType& thisType, const ASTNode* node) {
    Scope* matchScope = thisType.getBodyScope();
    assert matchScope != nil<Scope*>;
    const QualType nonConstThisType = thisType.toNonConst();
    const QualType argType = nonConstThisType.toRef(node);
    ArgList args;
    args.pushBack(Pair<QualType, bool>(argType, false));
    // The new instance being constructed is never const, regardless of whether the move source (thisType) is const
    const QualTypeList noTemplateTypeHints;
    return matchFunction(matchScope, String(CTOR_FUNCTION_NAME), nonConstThisType, args, noTemplateTypeHints, true, node);
}

/**
 * Map a local type to the type in an imported scope. If the target file does not know about the struct, it is shown how to
 * find the struct.
 *
 * @param targetScope Scope of the imported source file
 * @param symbolType Local type
 * @return Type in the imported scope
 */
public f<QualType> TypeChecker.mapLocalTypeToImportedScopeType(const Scope* targetScope, const QualType& symbolType) {
    // Skip all types, except structs
    if !symbolType.isBase(SuperType::TY_STRUCT) {
        return symbolType;
    }

    // If the target scope is in the current source file, we can return the symbol type as is
    SourceFile* targetSourceFile = targetScope.sourceFile;
    if targetSourceFile == this.sourceFile {
        return symbolType;
    }

    // Match the scope of the symbol type against all scopes in the name registry of the target file
    const QualType baseType = symbolType.getBase();
    if isStructKnownByNameRegistry(targetSourceFile, baseType.getBodyScope()) {
        return symbolType;
    }

    // The target file does not know about the struct at all
    // -> show it how to find the struct
    const String structName = baseType.getSubType();
    const NameRegistryEntry* origRegistryEntry = this.sourceFile.getNameRegistryEntry(structName);
    // If even this file does not know the struct by its unqualified name (deep transitive import), there is
    // nothing to copy over. Skip teaching the target file; the type identity itself is unaffected, and member
    // access falls back to the resolved body scope.
    if origRegistryEntry == nil<const NameRegistryEntry*> {
        return symbolType;
    }
    // Do not clobber an entry the target file already has under this name (e.g. its OWN same-named struct). Teaching
    // uses keepNewOnCollision=false, which would otherwise ERASE the target's existing entry and break resolution of
    // its own type. The struct's QualType identity is carried by pointer regardless.
    if targetSourceFile.exportedNameRegistry.contains(structName) {
        return symbolType;
    }
    const unsigned long targetTypeId = origRegistryEntry.typeId;
    SymbolTableEntry* targetEntry = origRegistryEntry.targetEntry;
    targetSourceFile.addNameRegistryEntry(structName, targetTypeId, targetEntry, origRegistryEntry.targetScope, false, nil<SymbolTableEntry*>);

    return symbolType;
}

/**
 * Map a type from an imported scope to the local type. If this source file does not know about the struct, it is shown how
 * to find the struct.
 *
 * @param sourceScope Scope of the imported source file
 * @param symbolType Type in the imported scope
 * @return Local type
 */
public f<QualType> TypeChecker.mapImportedScopeTypeToLocalType(const Scope* sourceScope, const QualType& symbolType) {
    // Skip all types, except structs
    if !symbolType.isBase(SuperType::TY_STRUCT) {
        return symbolType;
    }

    // If the given source file is in the current one, we can return the symbol type as is
    SourceFile* sourceSourceFile = sourceScope.sourceFile;
    if sourceSourceFile == this.sourceFile {
        return symbolType;
    }

    // Match the scope of the symbol type against all scopes in the name registry of this source file
    const QualType baseType = symbolType.getBase();
    if isStructKnownByNameRegistry(this.sourceFile, baseType.getBodyScope()) {
        return symbolType;
    }

    // This source file does not know about the struct at all
    // -> show it how to find the struct
    const String structName = baseType.getSubType();
    const NameRegistryEntry* origRegistryEntry = sourceSourceFile.getNameRegistryEntry(structName);
    // If even the source file does not know the struct by its unqualified name (deep transitive import), there is
    // nothing to copy over. Skip teaching this file; the type identity itself is unaffected, and member access
    // falls back to the resolved body scope.
    if origRegistryEntry == nil<const NameRegistryEntry*> {
        return symbolType;
    }
    // Do not clobber an entry this file already has under this name (see mapLocalTypeToImportedScopeType): teaching
    // with keepNewOnCollision=false would ERASE this file's own same-named struct entry. The QualType identity is
    // carried by pointer, so an already-taken name needs no (re-)teaching here.
    if this.sourceFile.exportedNameRegistry.contains(structName) {
        return symbolType;
    }
    const unsigned long typeId = origRegistryEntry.typeId;
    SymbolTableEntry* targetEntry = origRegistryEntry.targetEntry;
    this.sourceFile.addNameRegistryEntry(structName, typeId, targetEntry, origRegistryEntry.targetScope, false, nil<SymbolTableEntry*>);

    return symbolType;
}

/**
 * Check if the name registry of the given source file knows a struct manifestation with the given body scope
 *
 * @param sourceFile Source file to check
 * @param bodyScope Body scope of the struct manifestation
 * @return Known or not
 */
f<bool> isStructKnownByNameRegistry(SourceFile* sourceFile, Scope* bodyScope) {
    foreach Pair<const String&, NameRegistryEntry&> registryEntry : sourceFile.exportedNameRegistry {
        const NameRegistryEntry& entry = registryEntry.getSecond();
        if entry.targetEntry == nil<SymbolTableEntry*> {
            continue;
        }
        const QualType entryType = entry.targetEntry.getQualType();
        if !entryType.isBase(SuperType::TY_STRUCT) {
            continue;
        }
        ASTNode* declNode = entry.targetEntry.declNode;
        if declNode.kind != ASTNodeKind::STRUCT_DEF {
            continue;
        }
        ASTStructDefNode* structDefNode = downcast<ASTStructDefNode>(declNode);
        foreach Struct* manifestation : structDefNode.structManifestations {
            if manifestation.scope == bodyScope {
                return true;
            }
        }
    }
    return false;
}

/**
 * Check type name against well-known type names that require a runtime import. If found one, auto-import the runtime module.
 *
 * @param typeName Given type name
 */
p TypeChecker.ensureLoadedRuntimeForTypeName(const String& typeName) {
    RuntimeModule runtimeModule = RuntimeModule::STRING_RT;
    if getRuntimeModuleForTypeName(typeName, runtimeModule) && !this.sourceFile.isRT(runtimeModule) {
        this.sourceFile.requestRuntimeModule(runtimeModule);
    }
}

/**
 * Check function name against well-known function names that require a runtime import. If found one, auto-import the runtime
 * module.
 *
 * @param functionName Given function name
 */
p TypeChecker.ensureLoadedRuntimeForFunctionName(const String& functionName) {
    RuntimeModule runtimeModule = RuntimeModule::STRING_RT;
    if getRuntimeModuleForFunctionName(functionName, runtimeModule) && !this.sourceFile.isRT(runtimeModule) {
        this.sourceFile.requestRuntimeModule(runtimeModule);
    }
}

/**
 * Get the operator overloading functions of the given node for the current manifestation
 *
 * @param node AST node, that supports operator overloading
 * @return Operator overloading functions
 */
public f<Vector<const Function*>&> TypeChecker.getOpFctPointers(ASTNode* node) {
    Vector<Vector<const Function*>>* opFctPointers = node.getOpFctPointers();
    assert opFctPointers.getSize() > cast<long>(this.manIdx);
    return opFctPointers.get(this.manIdx);
}

/**
 * Request a re-visit of the source file of the given function, if the function body was not type-checked yet
 *
 * @param fct Function to check
 */
public p requestRevisitIfRequired(const Function* fct) {
    if fct != nil<const Function*> && !fct.alreadyTypeChecked {
        SourceFile* sourceFile = fct.entry.scope.sourceFile;
        sourceFile.reVisitRequested = true;
    }
}

/**
 * Add a soft error to the error list
 */
p TypeChecker.softError(const ASTNode* node, SemanticErrorType errorType, const String& message) {
    ErrorManager& errorManager = this.resourceManager.getErrorManager();
    errorManager.addSoftError(node, errorType, message);
}

// Add a warning to the warning list of the current source file
p TypeChecker.addWarning(const CodeLoc& codeLoc, CompilerWarningType warningType, const String& message) {
    this.warnings.pushBack(CompilerWarning(codeLoc, warningType, message.getRaw()));
}

/**
 * Check if the given ctor args denote a copy ctor call (like __new<T>(other) or __placement_new<T>(ptr, other)), i.e. there
 * is exactly one ctor arg and it has the same type as the struct to construct
 *
 * @param ctorArgs Ctor args (without the target pointer of __placement_new)
 * @param thisType Type of the struct to construct
 * @return Copy ctor call or not
 */
f<bool> TypeChecker.isCopyCtorCall(const ArgList& ctorArgs, const QualType& thisType) {
    if ctorArgs.getSize() != 1l {
        return false;
    }
    const Pair<QualType, bool>& arg = ctorArgs.front();
    QualType argType = arg.getFirst();
    argType = argType.removeReferenceWrapper();
    argType = argType.toNonConst();
    return thisType.matches(argType, false, false, true);
}

/**
 * Collect the generic types of a template type list (used by the prepare visitors of functions, procedures, structs and
 * unions). Mirrors the loop, that the host has in each of these visitors.
 *
 * @param templateTypeLst Template type list node
 * @param genericTypes Receives the generic types
 * @return False if an error occurred (the host throws a SemanticError in this case)
 */
f<bool> TypeChecker.collectTemplateTypes(ASTTypeLstNode* templateTypeLst, Vector<GenericType>& genericTypes) {
    foreach ASTDataTypeNode* dataType : templateTypeLst.dataTypes {
        // Visit template type
        const QualType templateType = this.getDataType(dataType);
        if templateType.is(SuperType::TY_UNRESOLVED) {
            continue;
        }
        // Check if it is a generic type
        if !templateType.is(SuperType::TY_GENERIC) {
            throwSemanticError(cast<ASTNode*>(dataType), SemanticErrorType::EXPECTED_GENERIC_TYPE, String("A template list can only contain generic types"));
            return false;
        }
        // Convert generic symbol type to generic type
        GenericType* genericType = this.rootScope.lookupGenericTypeStrict(templateType.getSubType());
        assert genericType != nil<GenericType*>;
        genericTypes.pushBack(*genericType);
    }
    return true;
}

/**
 * Add a template type of the 'this' type to the given generic types, if it is not included yet, and mark the last generic type
 * as used. Mirrors the lambda based loop over the template types of the 'this' type in the host.
 *
 * @param genericTypes Generic types
 * @param templateType Template type of the 'this' type
 */
p addUsedTemplateType(Vector<GenericType>& genericTypes, const QualType& templateType) {
    bool isContained = false;
    foreach const GenericType& genericType : genericTypes {
        if genericType.qualType == templateType {
            isContained = true;
            break;
        }
    }
    if !isContained {
        genericTypes.pushBack(GenericType(templateType));
    }
    GenericType& lastGenericType = genericTypes.back();
    lastGenericType.used = true;
}

// ================================================= TypeCheckerTopLevelDefinitions.cpp ==========================================

public f<Any> TypeChecker.visitMainFctDef(ASTMainFctDefNode* node) {
    if this.typeCheckerMode == TypeCheckerMode::TC_MODE_PRE {
        return this.visitMainFctDefPrepare(node);
    }
    return this.visitMainFctDefCheck(node);
}

public f<Any> TypeChecker.visitFctDef(ASTFctDefNode* node) {
    if this.typeCheckerMode == TypeCheckerMode::TC_MODE_PRE {
        return this.visitFctDefPrepare(node);
    }
    return this.visitFctDefCheck(node);
}

public f<Any> TypeChecker.visitProcDef(ASTProcDefNode* node) {
    if this.typeCheckerMode == TypeCheckerMode::TC_MODE_PRE {
        return this.visitProcDefPrepare(node);
    }
    return this.visitProcDefCheck(node);
}

public f<Any> TypeChecker.visitStructDef(ASTStructDefNode* node) {
    if this.typeCheckerMode == TypeCheckerMode::TC_MODE_PRE {
        return this.visitStructDefPrepare(node);
    }
    return this.visitStructDefCheck(node);
}

public f<Any> TypeChecker.visitInterfaceDef(ASTInterfaceDefNode* node) {
    if this.typeCheckerMode == TypeCheckerMode::TC_MODE_PRE {
        return this.visitInterfaceDefPrepare(node);
    }
    return Any();
}

public f<Any> TypeChecker.visitUnionDef(ASTUnionDefNode* node) {
    if this.typeCheckerMode == TypeCheckerMode::TC_MODE_PRE {
        return this.visitUnionDefPrepare(node);
    }
    return this.visitUnionDefCheck(node);
}

/**
 * Assign the opaque type to a struct, interface, enum or alias that is referenced before it has been prepared. This
 * effectively acts as an implicit forward declaration and is what makes circular imports work: two types in mutually
 * importing files can reference each other, so neither can be prepared strictly before the other. The full prepare pass
 * (visitStructDefPrepare / visitInterfaceDefPrepare / visitEnumDefPrepare / visitAliasDefPrepare) assigns the identical
 * interned type later and additionally fills in the body scope and manifestations.
 *
 * Only non-generic structs/interfaces can be pre-declared this way, since the opaque type carries no template types.
 *
 * @param entry Symbol table entry of the referenced struct, interface, enum or alias (its type must still be invalid)
 */
p TypeChecker.assignDeferredOpaqueType(SymbolTableEntry* entry) {
    const QualType entryType = entry.getQualType();
    assert entryType.is(SuperType::TY_INVALID);
    ASTNode* declNode = entry.declNode;
    TypeRegistry& typeRegistry = this.resourceManager.typeRegistry;
    const QualTypeList noTemplateTypes;
    TypeChainElementData data;
    switch declNode.kind {
        case ASTNodeKind::STRUCT_DEF: {
            ASTStructDefNode* structDef = downcast<ASTStructDefNode>(declNode);
            if structDef.hasTemplateTypes {
                return;
            }
            data.bodyScope = structDef.structScope;
            const Type* rawType = typeRegistry.getOrInsert(SuperType::TY_STRUCT, structDef.structName, structDef.typeId, data, noTemplateTypes);
            entry.updateType(QualType(rawType, structDef.qualifiers), false);
        }
        case ASTNodeKind::INTERFACE_DEF: {
            ASTInterfaceDefNode* interfaceDef = downcast<ASTInterfaceDefNode>(declNode);
            if interfaceDef.hasTemplateTypes {
                return;
            }
            data.bodyScope = interfaceDef.interfaceScope;
            const Type* rawType = typeRegistry.getOrInsert(SuperType::TY_INTERFACE, interfaceDef.interfaceName, interfaceDef.typeId, data, noTemplateTypes);
            entry.updateType(QualType(rawType, interfaceDef.qualifiers), false);
        }
        case ASTNodeKind::UNION_DEF: {
            ASTUnionDefNode* unionDef = downcast<ASTUnionDefNode>(declNode);
            if unionDef.hasTemplateTypes {
                return;
            }
            data.bodyScope = unionDef.unionScope;
            const Type* rawType = typeRegistry.getOrInsert(SuperType::TY_UNION, unionDef.unionName, unionDef.typeId, data, noTemplateTypes);
            entry.updateType(QualType(rawType, unionDef.qualifiers), false);
        }
        case ASTNodeKind::ENUM_DEF: {
            ASTEnumDefNode* enumDef = downcast<ASTEnumDefNode>(declNode);
            data.bodyScope = enumDef.enumScope;
            const Type* rawType = typeRegistry.getOrInsert(SuperType::TY_ENUM, enumDef.enumName, enumDef.typeId, data, noTemplateTypes);
            entry.updateType(QualType(rawType, enumDef.qualifiers), false);
        }
        case ASTNodeKind::ALIAS_DEF: {
            // An alias additionally needs its aliased type resolved, so prepare it fully on demand. visitAliasDefPrepare is
            // idempotent: the real prepare pass for the alias's own file skips it once the type is no longer invalid.
            this.visitAliasDefPrepare(downcast<ASTAliasDefNode>(declNode));
        }
        default: {}
    }
}

public f<Any> TypeChecker.visitEnumDef(ASTEnumDefNode* node) {
    if this.typeCheckerMode == TypeCheckerMode::TC_MODE_PRE {
        return this.visitEnumDefPrepare(node);
    }
    return Any();
}

public f<Any> TypeChecker.visitGenericTypeDef(ASTGenericTypeDefNode* node) {
    if this.typeCheckerMode == TypeCheckerMode::TC_MODE_PRE {
        return this.visitGenericTypeDefPrepare(node);
    }
    return Any();
}

public f<Any> TypeChecker.visitAliasDef(ASTAliasDefNode* node) {
    if this.typeCheckerMode == TypeCheckerMode::TC_MODE_PRE {
        return this.visitAliasDefPrepare(node);
    }
    return Any();
}

public f<Any> TypeChecker.visitGlobalVarDef(ASTGlobalVarDefNode* node) {
    if this.typeCheckerMode == TypeCheckerMode::TC_MODE_PRE {
        return this.visitGlobalVarDefPrepare(node);
    }
    return Any();
}

public f<Any> TypeChecker.visitExtDecl(ASTExtDeclNode* node) {
    if this.typeCheckerMode == TypeCheckerMode::TC_MODE_PRE {
        return this.visitExtDeclPrepare(node);
    }
    return Any();
