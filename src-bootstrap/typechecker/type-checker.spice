public f<Any> TypeChecker.visitImportDef(ASTImportDefNode* node) {
    if this.typeCheckerMode == TypeCheckerMode::TC_MODE_PRE {
        return this.visitImportDefPrepare(node);
    }
    return Any();
}

// =============================================== TypeCheckerTopLevelDefinitionsCheck.cpp =======================================

f<Any> TypeChecker.visitMainFctDefCheck(ASTMainFctDefNode* node) {
    // Skip if already type-checked
    if this.typeCheckedMainFct {
        return Any();
    }

    ASTNode* baseNode = cast<ASTNode*>(node);
    baseNode.resizeToNumberOfManifestations(1l);

    // Change to function body scope
    this.currentScope = node.bodyScope;
    // Visit statements in new scope
    this.visit(node.body);
    // Leave main function body scope
    this.currentScope = this.rootScope;

    // Set to type-checked
    this.typeCheckedMainFct = true;
    return Any();
}

f<Any> TypeChecker.visitFctDefCheck(ASTFctDefNode* node) {
    ASTFctDefBaseNode* fctDefBase = &node.node;
    ASTNode* baseNode = cast<ASTNode*>(node);
    baseNode.resizeToNumberOfManifestations(cast<unsigned long>(fctDefBase.manifestations.getSize()));
    this.manIdx = 0l; // Reset the manifestation index

    // Get all manifestations for this function definition
    // Only visit the manifestations, that exist at this point, like the host does (manifestations inserted during the loop are
    // not covered by the resize above and get checked in a revisit)
    const unsigned long manifestationCount = fctDefBase.manifestations.getSize();
    for unsigned long manifestationIdx = 0l; manifestationIdx < manifestationCount; manifestationIdx++ {
        Function* manifestation = fctDefBase.manifestations.get(manifestationIdx);
        // Skip non-substantiated or already checked functions
        if !manifestation.isFullySubstantiated() || manifestation.alreadyTypeChecked {
            this.manIdx++; // Increase the manifestation index
            continue;
        }

        // Change scope to concrete struct specialization scope
        if fctDefBase.isMethod {
            const QualTypeList thisTemplateTypes = manifestation.thisType.getTemplateTypes();
            const String scopeName = getStructScopeName(fctDefBase.name.structName, thisTemplateTypes);
            this.compilerPass.changeToScope(scopeName, ScopeType::STRUCT);
        }

        // Change to function scope
        this.compilerPass.changeToScope(manifestation.bodyScope, ScopeType::FUNC_PROC_BODY);

        // Mount type mapping for this manifestation
        assert this.typeMapping.isEmpty();
        this.typeMapping = manifestation.typeMapping;

        // Set return type to the result variable
        SymbolTableEntry* resultVarEntry = this.currentScope.lookupStrict(String(RETURN_VARIABLE_NAME));
        assert resultVarEntry != nil<SymbolTableEntry*>;
        resultVarEntry.updateType(manifestation.returnType, false);
        resultVarEntry.used = true;

        // Visit parameters
        // This happens once in the type checker prepare stage. This second time is only required if we have a generic function
        if fctDefBase.hasParams {
            this.visit(fctDefBase.paramLst);
            this.annotateLambdaCaptureParams(fctDefBase, manifestation);
        }

        // Visit statements in new scope
        this.visit(fctDefBase.body);

        // Clear type mapping
        this.typeMapping.clear();

        // Change to root scope
        this.currentScope = this.rootScope;
        assert this.currentScope.scopeType == ScopeType::GLOBAL;

        // Do not type-check this manifestation again
        manifestation.alreadyTypeChecked = true;

        this.manIdx++; // Increase the manifestation index
    }
    this.manIdx = 0l; // Reset the manifestation index

    return Any();
}

f<Any> TypeChecker.visitProcDefCheck(ASTProcDefNode* node) {
    ASTFctDefBaseNode* fctDefBase = &node.node;
    ASTNode* baseNode = cast<ASTNode*>(node);
    baseNode.resizeToNumberOfManifestations(cast<unsigned long>(fctDefBase.manifestations.getSize()));
    this.manIdx = 0l; // Reset the manifestation index

    // Get all manifestations for this procedure definition
    // Only visit the manifestations, that exist at this point, like the host does (manifestations inserted during the loop are
    // not covered by the resize above and get checked in a revisit)
    const unsigned long manifestationCount = fctDefBase.manifestations.getSize();
    for unsigned long manifestationIdx = 0l; manifestationIdx < manifestationCount; manifestationIdx++ {
        Function* manifestation = fctDefBase.manifestations.get(manifestationIdx);
        // Skip non-substantiated or already checked procedures
        if !manifestation.isFullySubstantiated() || manifestation.alreadyTypeChecked {
            this.manIdx++; // Increase the manifestation index
            continue;
        }

        // Change scope to concrete struct specialization scope
        if fctDefBase.isMethod {
            const QualTypeList thisTemplateTypes = manifestation.thisType.getTemplateTypes();
            const String scopeName = getStructScopeName(fctDefBase.name.structName, thisTemplateTypes);
            this.compilerPass.changeToScope(scopeName, ScopeType::STRUCT);
        }

        // Change to procedure scope
        this.compilerPass.changeToScope(manifestation.bodyScope, ScopeType::FUNC_PROC_BODY);

        // Mount type mapping for this manifestation
        assert this.typeMapping.isEmpty();
        this.typeMapping = manifestation.typeMapping;

        // Visit parameters
        // This happens once in the type checker prepare stage. This second time is only required if we have a generic procedure
        if fctDefBase.hasParams {
            this.visit(fctDefBase.paramLst);
            this.annotateLambdaCaptureParams(fctDefBase, manifestation);
        }

        // Prepare generation of special ctor preamble to store VTable, default field values, etc. if required
        if node.isCtor {
            this.createCtorBodyPreamble(manifestation.bodyScope);
        }

        // Visit statements in new scope
        this.visit(fctDefBase.body);

        // Clear type mapping
        this.typeMapping.clear();

        // Change to root scope
        this.currentScope = this.rootScope;
        assert this.currentScope != nil<Scope*> && this.currentScope.scopeType == ScopeType::GLOBAL;

        // Do not type-check this manifestation again
        manifestation.alreadyTypeChecked = true;

        this.manIdx++; // Increase the manifestation index
    }
    this.manIdx = 0l; // Reset the manifestation index

    return Any();
}

/**
 * Annotate function/procedure-typed params with lambda-capture info from the resolved manifestation type.
 * This must happen in the TypeChecker so that the IRGenerator can treat SymbolTableEntry as immutable.
 * The host has this loop inline in visitFctDefCheck and visitProcDefCheck.
 *
 * @param fctDefBase Function or procedure definition node
 * @param manifestation Manifestation, whose params to annotate
 */
p TypeChecker.annotateLambdaCaptureParams(ASTFctDefBaseNode* fctDefBase, const Function* manifestation) {
    ASTParamLstNode* paramLst = downcast<ASTParamLstNode>(getASTNode(fctDefBase.paramLst));
    const QualTypeList paramTypes = manifestation.getParamTypes();
    const dyn fctOptions = [SuperType::TY_FUNCTION, SuperType::TY_PROCEDURE];
    for unsigned long i = 0l; i < manifestation.paramList.getSize(); i++ {
        const ASTDeclStmtNode* param = paramLst.params.get(i);
        const QualType& paramType = paramTypes.get(i);
        if paramType.isOneOf(fctOptions, len(fctOptions)) && paramType.hasLambdaCaptures() {
            SymbolTableEntry* paramSymbol = this.currentScope.lookupStrict(param.varName);
            assert paramSymbol != nil<SymbolTableEntry*>;
            const QualType paramSymbolType = paramSymbol.getQualType();
            paramSymbol.updateType(paramSymbolType.getWithLambdaCaptures(), true);
        }
    }
}

f<Any> TypeChecker.visitStructDefCheck(ASTStructDefNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);
    baseNode.resizeToNumberOfManifestations(cast<unsigned long>(node.structManifestations.getSize()));
    this.manIdx = 0l; // Reset the manifestation index

    // Get all manifestations for this procedure definition
    // Only visit the manifestations, that exist at this point, like the host does (manifestations inserted during the loop are
    // not covered by the resize above and get checked in a revisit)
    const unsigned long manifestationCount = node.structManifestations.getSize();
    for unsigned long manifestationIdx = 0l; manifestationIdx < manifestationCount; manifestationIdx++ {
        Struct* manifestation = node.structManifestations.get(manifestationIdx);
        // Skip non-substantiated or already checked procedures
        if !manifestation.structBase.isFullySubstantiated() {
            this.manIdx++; // Increase the manifestation index
            continue;
        }

        // Fallback for manifestations that could not be decided on when they were created, because a by-value struct field
        // was not manifested yet at that point (circular import). By now the whole import graph is prepared, so the
        // decision can be taken - late, but still before the struct's own default member bodies are prepared below.
        createImplicitDefaultMembers(*manifestation, baseNode, /*withMoveCtor=*/false);

        // Change to struct scope
        this.compilerPass.changeToScope(manifestation.structBase.scope, ScopeType::STRUCT);

        // Mount type mapping for this manifestation, so that the body preamble helpers below can substantiate
        // generic field types (e.g. `heap T*` on `Vector<T>`). Without this, an auto-generated body preamble that
        // touches a still-generic field would assert in substantiateTypeWithTypeMapping.
        assert this.typeMapping.isEmpty();
        this.typeMapping = manifestation.structBase.typeMapping;

        // Re-visit all default values. This is required, since the type of the default value might vary for different manifestations
        foreach IVisitable* fieldVisitable : node.fields {
            ASTFieldNode* field = downcast<ASTFieldNode>(getASTNode(fieldVisitable));
            if field.defaultValue != nil<IVisitable*> {
                this.visit(field.defaultValue);
                SymbolTableEntry* fieldEntry = manifestation.structBase.scope.lookupStrict(field.fieldName);
                assert fieldEntry != nil<SymbolTableEntry*>;
                fieldEntry.updateState(LifecycleState::INITIALIZED, cast<ASTNode*>(field));
            }
        }

        // Build struct type
        const QualType structType = manifestation.structBase.entry.getQualType();

        // Check if the struct implements all methods of all attached interfaces
        unsigned long vtableIndex = 0l;
        foreach const QualType& interfaceType : manifestation.interfaceTypes {
            const Interface* spiceInterface = interfaceType.getInterface(baseNode);
            assert spiceInterface != nil<const Interface*>;

            // Check for all methods, that it is implemented by the struct
            foreach const Function* expMethod : spiceInterface.methods {
                const String methodName = expMethod.name;
                QualTypeList params = expMethod.getParamTypes();
                QualType returnType = expMethod.returnType;

                // Substantiate param and return types
                substantiateTypesWithTypeMapping(params, spiceInterface.structBase.typeMapping, baseNode);
                if returnType.hasAnyGenericParts() {
                    substantiateTypeWithTypeMapping(returnType, spiceInterface.structBase.typeMapping, baseNode);
                }

                // Build args list
                ArgList args;
                args.reserve(params.getSize());
                foreach const QualType& param : params {
                    args.pushBack(Pair<QualType, bool>(param, false));
                }

                // Search for method that has the required signature
                const QualTypeList noTemplateTypeHints;
                Function* spiceFunction = matchFunction(this.currentScope, methodName, structType, args, noTemplateTypeHints, true, baseNode);
                if spiceFunction == nil<Function*> {
                    this.softError(baseNode, SemanticErrorType::INTERFACE_METHOD_NOT_IMPLEMENTED, "The struct '" + node.structName + "' does not implement method '" + expMethod.getSignature() + "'.");
                    continue;
                }

                // Check return type
                if spiceFunction.returnType != returnType && !returnType.matchesInterfaceImplementedByStruct(spiceFunction.returnType) {
                    this.softError(baseNode, SemanticErrorType::INTERFACE_METHOD_NOT_IMPLEMENTED, "The struct '" + node.structName + "' does not implement method '" + expMethod.getSignature() + "'. The return type does not match.");
                    continue;
                }
                // Set to virtual, since it overrides the interface method
                spiceFunction.isVirtual = true;
                spiceFunction.vtableIndex = vtableIndex++;
            }
        }

        // Check default ctor body if required
        const ArgList noArgs;
        const Function* ctorFunc = lookupFunction(this.currentScope, String(CTOR_FUNCTION_NAME), structType, noArgs, true);
        if ctorFunc != nil<const Function*> && ctorFunc.implicitDefault {
            this.createCtorBodyPreamble(ctorFunc.bodyScope);
            assert manifestation.areAllFieldsInitialized() == nil<SymbolTableEntry*>;
        }

        // Check default copy ctor body if required
        ArgList args;
        args.pushBack(Pair<QualType, bool>(structType.toConstRef(baseNode), false /* always non-temporary */));
        const Function* copyCtorFunc = lookupFunction(this.currentScope, String(CTOR_FUNCTION_NAME), structType, args, true);
        if copyCtorFunc != nil<const Function*> && copyCtorFunc.implicitDefault {
            this.createCopyCtorBodyPreamble(copyCtorFunc.bodyScope);
            assert manifestation.areAllFieldsInitialized() == nil<SymbolTableEntry*>;
        }

        // Check default move ctor body if required. findMoveCtor scans the manifestations directly to avoid the
        // constify-based false-positive that lookupFunction with a non-const ref arg can produce.
        const Function* moveCtorFunc = findMoveCtor(this.currentScope);
        if moveCtorFunc != nil<const Function*> && moveCtorFunc.implicitDefault {
            this.createMoveCtorBodyPreamble(moveCtorFunc.bodyScope);
            assert manifestation.areAllFieldsInitialized() == nil<SymbolTableEntry*>;
        }

        // Check default dtor body if required
        const Function* dtorFunc = lookupFunction(this.currentScope, String(DTOR_FUNCTION_NAME), structType, noArgs, true);
        if dtorFunc != nil<const Function*> && dtorFunc.implicitDefault {
            this.createDtorBodyPreamble(dtorFunc.bodyScope, baseNode);
        }

        // Reset field symbols to declared state for the next manifestation
        manifestation.resetFieldSymbolsToDeclared(baseNode);

        // Clear type mapping
        this.typeMapping.clear();

        // Return to the root scope
        this.currentScope = this.rootScope;
        assert this.currentScope != nil<Scope*> && this.currentScope.scopeType == ScopeType::GLOBAL;

        this.manIdx++; // Increase the manifestation index
    }
    this.manIdx = 0l; // Reset the manifestation index

    return Any();
}

f<Any> TypeChecker.visitUnionDefCheck(ASTUnionDefNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);
    baseNode.resizeToNumberOfManifestations(cast<unsigned long>(node.unionManifestations.getSize()));
    this.manIdx = 0l; // Reset the manifestation index

    // Get all manifestations for this union definition
    // Only visit the manifestations, that exist at this point, like the host does (manifestations inserted during the loop are
    // not covered by the resize above and get checked in a revisit)
    const unsigned long manifestationCount = node.unionManifestations.getSize();
    for unsigned long manifestationIdx = 0l; manifestationIdx < manifestationCount; manifestationIdx++ {
        Union* manifestation = node.unionManifestations.get(manifestationIdx);
        // Skip non-substantiated manifestations
        if !manifestation.structBase.isFullySubstantiated() {
            this.manIdx++; // Increase the manifestation index
            continue;
        }

        // Change to union scope
        this.compilerPass.changeToScope(manifestation.structBase.scope, ScopeType::UNION);

        // Mount type mapping for this manifestation, so that the default value below can substantiate generic field types
        assert this.typeMapping.isEmpty();
        this.typeMapping = manifestation.structBase.typeMapping;

        // Re-visit the default value (at most one field may have one). This is required, since the type of the default
        // value might vary for different manifestations
        foreach IVisitable* fieldVisitable : node.fields {
            ASTFieldNode* field = downcast<ASTFieldNode>(getASTNode(fieldVisitable));
            if field.defaultValue != nil<IVisitable*> {
                this.visit(field.defaultValue);
                SymbolTableEntry* fieldEntry = manifestation.structBase.scope.lookupStrict(field.fieldName);
                assert fieldEntry != nil<SymbolTableEntry*>;
                fieldEntry.updateState(LifecycleState::INITIALIZED, cast<ASTNode*>(field));
            }
        }

        // Clear type mapping
        this.typeMapping.clear();

        // Return to the root scope
        this.currentScope = this.rootScope;
        assert this.currentScope != nil<Scope*> && this.currentScope.scopeType == ScopeType::GLOBAL;

        this.manIdx++; // Increase the manifestation index
    }
    this.manIdx = 0l; // Reset the manifestation index

    return Any();
}

// ============================================== TypeCheckerTopLevelDefinitionsPrepare.cpp ======================================

f<Any> TypeChecker.visitMainFctDefPrepare(ASTMainFctDefNode* node) {
    // Mark unreachable statements
    ASTNode* baseNode = cast<ASTNode*>(node);
    bool doSetPredecessorsUnreachable = true;
    const bool _ = baseNode.returnsOnAllControlPaths(&doSetPredecessorsUnreachable, this.manIdx);

    // Retrieve return type
    const QualType returnType = QualType(SuperType::TY_INT);

    // Change to function body scope
    this.currentScope = node.bodyScope;

    // Set type of 'result' variable to int
    SymbolTableEntry* resultEntry = this.currentScope.lookupStrict(String(RETURN_VARIABLE_NAME));
    assert resultEntry != nil<SymbolTableEntry*>;
    resultEntry.updateType(returnType, false);
    resultEntry.used = true;

    // Retrieve param types
    QualTypeList paramTypes;
    if node.takesArgs {
        Any paramLstResult = this.visit(node.paramLst);
        NamedParamList namedParamList = paramLstResult.get<NamedParamList>();
        foreach const NamedParam& namedParam : namedParamList {
            paramTypes.pushBack(namedParam.qualType);
        }
    }

    // Prepare type of function
    const QualType functionTypeBase = QualType(SuperType::TY_FUNCTION);
    const QualType functionType = functionTypeBase.getWithFunctionParamAndReturnTypes(returnType, paramTypes);

    // Update main function symbol type
    SymbolTableEntry* functionEntry = this.rootScope.lookupStrict(String(MAIN_FUNCTION_NAME));
    assert functionEntry != nil<SymbolTableEntry*>;
    functionEntry.updateType(functionType, false);
    functionEntry.used = true;

    // Leave main function body scope
    this.currentScope = this.rootScope;

    return Any();
}

f<Any> TypeChecker.visitFctDefPrepare(ASTFctDefNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);
    ASTFctDefBaseNode* fctDefBase = &node.node;

    // Check if name is dtor
    if fctDefBase.name.name == DTOR_FUNCTION_NAME {
        this.softError(baseNode, SemanticErrorType::DTOR_MUST_BE_PROCEDURE, String("Destructors are not allowed to be of type function"));
        return Any();
    }

    // Check if all control paths in the function return
    bool doSetPredecessorsUnreachable = true;
    if !baseNode.returnsOnAllControlPaths(&doSetPredecessorsUnreachable, this.manIdx) {
        this.softError(baseNode, SemanticErrorType::MISSING_RETURN_STMT, String("Not all control paths of this function have a return statement"));
        return Any();
    }

    // Change to function scope
    this.currentScope = fctDefBase.scope;
    assert this.currentScope.scopeType == ScopeType::FUNC_PROC_BODY;

    // Retrieve function template types
    Vector<GenericType> usedGenericTypes;
    if fctDefBase.hasTemplateTypes {
        if !this.collectTemplateTypes(fctDefBase.templateTypeLst, usedGenericTypes) {
            return Any();
        }
    }

    // Retrieve 'this' type
    QualType thisType = QualType(SuperType::TY_DYN); // If the function is not a method, the default this type is TY_DYN
    if fctDefBase.isMethod {
        Scope* structParentScope = fctDefBase.structScope.parent;
        SymbolTableEntry* structEntry = structParentScope.lookupStrict(fctDefBase.name.structName);
        assert structEntry != nil<SymbolTableEntry*>;
        // Set struct to used
        structEntry.used = true;
        // Get type and ptr type
        thisType = structEntry.getQualType();
        const QualType thisPtrType = thisType.toPtr(baseNode);
        // Collect template types of 'this' type
        const QualTypeList thisTemplateTypes = thisType.getTemplateTypes();
        foreach const QualType& templateType : thisTemplateTypes {
            addUsedTemplateType(usedGenericTypes, templateType);
        }

        // Set type of 'this' variable
        SymbolTableEntry* thisEntry = this.currentScope.lookupStrict(String(THIS_VARIABLE_NAME));
        assert thisEntry != nil<SymbolTableEntry*>;
        thisEntry.updateType(thisPtrType, false);
    }

    // Visit parameters
    QualTypeList paramTypes;
    ParamList paramList;
    if fctDefBase.hasParams {
        // Visit param list to retrieve the param names
        Any paramLstResult = this.visit(fctDefBase.paramLst);
        NamedParamList namedParamList = paramLstResult.get<NamedParamList>();
        foreach const NamedParam& namedParam : namedParamList {
            const QualType qualType = namedParam.qualType;
            if qualType.is(SuperType::TY_UNRESOLVED) {
                return Any();
            }
            paramTypes.pushBack(qualType);
            paramList.pushBack(Param{qualType, namedParam.isOptional});
            // Check if the type is present in the template for generic types
            if !qualType.isCoveredByGenericTypeList(usedGenericTypes) {
                throwSemanticError(getASTNode(fctDefBase.paramLst), SemanticErrorType::GENERIC_TYPE_NOT_IN_TEMPLATE, String("Generic param type not included in the template type list of the function"));
                return Any();
            }
        }
    }

    // Retrieve return type
    const QualType returnType = this.getDataType(node.returnType);
    if returnType.is(SuperType::TY_UNRESOLVED) {
        return Any();
    }
    if returnType.is(SuperType::TY_DYN) {
        this.softError(baseNode, SemanticErrorType::UNEXPECTED_DYN_TYPE, String("Dyn return types are not allowed"));
        return Any();
    }
    if !returnType.isCoveredByGenericTypeList(usedGenericTypes) {
        this.softError(cast<ASTNode*>(node.returnType), SemanticErrorType::GENERIC_TYPE_NOT_IN_TEMPLATE, String("Generic return type not included in the template type list of the function"));
        return Any();
    }

    // Leave function body scope
    this.currentScope = fctDefBase.scope.parent;
    assert this.currentScope.scopeType == ScopeType::GLOBAL || this.currentScope.scopeType == ScopeType::STRUCT;

    // Prepare type of function
    const QualType functionTypeBase = QualType(SuperType::TY_FUNCTION);
    QualType functionType = functionTypeBase.getWithFunctionParamAndReturnTypes(returnType, paramTypes);
    functionType.setQualifiers(fctDefBase.qualifiers);

    // Update type of function entry
    const String entryName = fctDefBase.getSymbolTableEntryName();
    SymbolTableEntry* functionEntry = this.currentScope.lookupStrict(entryName);
    assert functionEntry != nil<SymbolTableEntry*>;
    functionEntry.updateType(functionType, false);

    // Build function object
    Function spiceFunc = Function(fctDefBase.name.name, functionEntry, thisType, returnType, paramList, usedGenericTypes, baseNode);
    spiceFunc.bodyScope = fctDefBase.scope;
    insertFunction(this.currentScope, spiceFunc, &fctDefBase.manifestations);
    // The host throws on a duplicate declaration. Stop here, the compilation is aborted after this stage
    const ErrorManager& errorManager = this.resourceManager.getErrorManager();
    if errorManager.hasHardError {
        this.currentScope = this.rootScope;
        return Any();
    }

    // Check function attributes
    if fctDefBase.attrs != nil<IVisitable*> {
        ASTTopLevelDefAttrNode* attrs = downcast<ASTTopLevelDefAttrNode>(fctDefBase.attrs);
        ASTAttrLstNode* attrLst = attrs.attrLst;
        Function* firstManifestation = fctDefBase.manifestations.front();
        if attrLst.hasAttr(String(ATTR_CORE_COMPILER_MANGLE)) {
            const CompileTimeValue value = attrLst.getAttrValueByName(String(ATTR_CORE_COMPILER_MANGLE));
            firstManifestation.mangleFunctionName = value.getBoolValue();
        }
        if attrLst.hasAttr(String(ATTR_CORE_COMPILER_MANGLED_NAME)) {
            const CompileTimeValue value = attrLst.getAttrValueByName(String(ATTR_CORE_COMPILER_MANGLED_NAME));
            firstManifestation.predefinedMangledName = this.resourceManager.getCompileTimeStringValue(value.getStringValueOffset());
        }
        if attrLst.hasAttr(String(ATTR_TEST)) {
            const CompileTimeValue value = attrLst.getAttrValueByName(String(ATTR_TEST));
            if value.getBoolValue() {
                // Make sure that the function has the correct signature
                if fctDefBase.hasParams {
                    throwSemanticError(getASTNode(fctDefBase.paramLst), SemanticErrorType::TEST_FUNCTION_WITH_PARAMS, String("Test function may not have parameters"));
                    return Any();
                }
                if !returnType.is(SuperType::TY_BOOL) {
                    throwSemanticError(cast<ASTNode*>(node.returnType), SemanticErrorType::TEST_FUNCTION_WRONG_RETURN_TYPE, String("Test function must return a bool"));
                    return Any();
                }
                // Add to test function list
                firstManifestation.entry.used = true; // Avoid printing unused warnings
                firstManifestation.used = true;       // Always keep test functions, because they are called implicitly by the test main
                const Function* testFunction = firstManifestation;
                this.sourceFile.testFunctions.pushBack(testFunction);
            }
        }
    }

    // Duplicate / rename the original child scope to reflect the substantiated versions of the function
    const String scopeId = node.getScopeId();
    for unsigned long i = 1l; i < fctDefBase.manifestations.getSize(); i++ {
        Function* manifestation = fctDefBase.manifestations.get(i);
        manifestation.bodyScope = this.currentScope.copyChildScope(scopeId, manifestation.getScopeName());
    }
    Function* firstManifestation = fctDefBase.manifestations.front();
    this.currentScope.renameChildScope(scopeId, firstManifestation.getScopeName());

    // Change to the root scope
    this.currentScope = this.rootScope;
    assert this.currentScope.scopeType == ScopeType::GLOBAL;

    return Any();
}

f<Any> TypeChecker.visitProcDefPrepare(ASTProcDefNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);
    ASTFctDefBaseNode* fctDefBase = &node.node;

    // Mark unreachable statements
    bool doSetPredecessorsUnreachable = true;
    const bool _ = baseNode.returnsOnAllControlPaths(&doSetPredecessorsUnreachable, this.manIdx);

    // Check if dtor and has params
    if fctDefBase.hasParams && fctDefBase.name.name == DTOR_FUNCTION_NAME {
        throwSemanticError(baseNode, SemanticErrorType::DTOR_WITH_PARAMS, String("It is not allowed to specify parameters for destructors"));
        return Any();
    }

    // Change to procedure scope
    this.currentScope = fctDefBase.scope;
    assert this.currentScope.scopeType == ScopeType::FUNC_PROC_BODY;

    // Retrieve procedure template types
    Vector<GenericType> usedGenericTypes;
    if fctDefBase.hasTemplateTypes {
        if !this.collectTemplateTypes(fctDefBase.templateTypeLst, usedGenericTypes) {
            return Any();
        }
    }

    // Retrieve 'this' type
    QualType thisType = QualType(SuperType::TY_DYN); // If the procedure is not a method, the default this type is TY_DYN
    if fctDefBase.isMethod {
        Scope* structParentScope = fctDefBase.structScope.parent;
        SymbolTableEntry* structEntry = structParentScope.lookupStrict(fctDefBase.name.structName);
        assert structEntry != nil<SymbolTableEntry*>;
        // Set struct to used
        structEntry.used = true;
        // Get type and ptr type
        thisType = structEntry.getQualType();
        const QualType thisPtrType = thisType.toPtr(baseNode);
        // Collect template types of 'this' type
        const QualTypeList thisTemplateTypes = thisType.getTemplateTypes();
        foreach const QualType& templateType : thisTemplateTypes {
            addUsedTemplateType(usedGenericTypes, templateType);
        }

        // Set type of 'this' variable
        SymbolTableEntry* thisEntry = this.currentScope.lookupStrict(String(THIS_VARIABLE_NAME));
        assert thisEntry != nil<SymbolTableEntry*>;
        thisEntry.updateType(thisPtrType, false);
    }

    // Visit parameters
    QualTypeList paramTypes;
    ParamList paramList;
    if fctDefBase.hasParams {
        // Visit param list to retrieve the param names
        Any paramLstResult = this.visit(fctDefBase.paramLst);
        NamedParamList namedParamList = paramLstResult.get<NamedParamList>();
        foreach const NamedParam& namedParam : namedParamList {
            const QualType qualType = namedParam.qualType;
            paramTypes.pushBack(qualType);
            if qualType.is(SuperType::TY_UNRESOLVED) {
                return Any();
            }
            paramList.pushBack(Param{qualType, namedParam.isOptional});
            // Check if the type is present in the template for generic types
            if !qualType.isCoveredByGenericTypeList(usedGenericTypes) {
                throwSemanticError(getASTNode(fctDefBase.paramLst), SemanticErrorType::GENERIC_TYPE_NOT_IN_TEMPLATE, String("Generic param type not included in the template type list of the procedure"));
                return Any();
            }
        }
    }

    // Leave procedure body scope
    this.currentScope = fctDefBase.scope.parent;
    assert this.currentScope.scopeType == ScopeType::GLOBAL || this.currentScope.scopeType == ScopeType::STRUCT;

    // Prepare type of procedure
    const QualType procedureTypeBase = QualType(SuperType::TY_PROCEDURE);
    QualType procedureType = procedureTypeBase.getWithFunctionParamAndReturnTypes(QualType(SuperType::TY_DYN), paramTypes);
    procedureType.setQualifiers(fctDefBase.qualifiers);

    // Update type of procedure entry
    const String entryName = fctDefBase.getSymbolTableEntryName();
    SymbolTableEntry* procedureEntry = this.currentScope.lookupStrict(entryName);
    assert procedureEntry != nil<SymbolTableEntry*>;
    procedureEntry.updateType(procedureType, false);

    // Build procedure object
    Function spiceProc = Function(fctDefBase.name.name, procedureEntry, thisType, QualType(SuperType::TY_DYN), paramList, usedGenericTypes, baseNode);
    spiceProc.bodyScope = fctDefBase.scope;
    insertFunction(this.currentScope, spiceProc, &fctDefBase.manifestations);
    // The host throws on a duplicate declaration. Stop here, the compilation is aborted after this stage
    const ErrorManager& errorManager = this.resourceManager.getErrorManager();
    if errorManager.hasHardError {
        this.currentScope = this.rootScope;
        return Any();
    }

    // Check procedure attributes
    if fctDefBase.attrs != nil<IVisitable*> {
        ASTTopLevelDefAttrNode* attrs = downcast<ASTTopLevelDefAttrNode>(fctDefBase.attrs);
        ASTAttrLstNode* attrLst = attrs.attrLst;
        Function* firstManifestation = fctDefBase.manifestations.front();
        if attrLst.hasAttr(String(ATTR_CORE_COMPILER_MANGLE)) {
            const CompileTimeValue value = attrLst.getAttrValueByName(String(ATTR_CORE_COMPILER_MANGLE));
            firstManifestation.mangleFunctionName = value.getBoolValue();
        }
        if attrLst.hasAttr(String(ATTR_CORE_COMPILER_MANGLED_NAME)) {
            const CompileTimeValue value = attrLst.getAttrValueByName(String(ATTR_CORE_COMPILER_MANGLED_NAME));
            firstManifestation.predefinedMangledName = this.resourceManager.getCompileTimeStringValue(value.getStringValueOffset());
        }
    }

    // Duplicate / rename the original child scope to reflect the substantiated versions of the procedure
    const String scopeId = node.getScopeId();
    for unsigned long i = 1l; i < fctDefBase.manifestations.getSize(); i++ {
        Function* manifestation = fctDefBase.manifestations.get(i);
        manifestation.bodyScope = this.currentScope.copyChildScope(scopeId, manifestation.getScopeName());
    }
    Function* firstManifestation = fctDefBase.manifestations.front();
    this.currentScope.renameChildScope(scopeId, firstManifestation.getScopeName());

    // Change to the root scope
    this.currentScope = this.rootScope;
    assert this.currentScope.scopeType == ScopeType::GLOBAL;

    return Any();
}

/**
 * Determine whether a field type (transitively) contains a struct or union with the given origin body scope by value,
 * which would give the origin struct/union an infinite size. Only by-value struct/union fields are followed, including
 * through fixed-size arrays thereof (e.g. `T[3]`), since those embed their element by value as well. Dynamic arrays,
 * pointers and references break the cycle and have a fixed size. Struct/union types that are not manifested yet (e.g.
 * still being prepared as part of a circular import) end a branch - such a cycle is still detected once the last one
 * in it is prepared, when all the others are manifested.
 *
 * @param fieldType Type of the field to inspect
 * @param originScope Body scope of the struct/union whose infinite size we are checking for
 * @param node Accessing AST node (for struct/union lookup diagnostics)
 * @param visited Already-visited struct/union scopes, to keep the walk finite (a set in the host)
 * @return true if the origin struct/union is reachable by value, i.e. it has infinite size
 */
f<bool> fieldContainsAggregateByValue(const QualType& fieldType, const Scope* originScope, const ASTNode* node, Vector<const Scope*>& visited) {
    // Unwrap fixed-size arrays, so that e.g. a `T[3]` field is treated like a `T` field for cycle detection. Dynamic
    // arrays, pointers and references keep breaking the cycle, since they do not embed the element by value.
    if fieldType.isArray() && fieldType.getArraySize() > 0u {
        const QualType containedType = fieldType.getContained();
        return fieldContainsAggregateByValue(containedType, originScope, node, visited);
    }
    const dyn aggregateTypes = [SuperType::TY_STRUCT, SuperType::TY_UNION];
    if !fieldType.isOneOf(aggregateTypes, len(aggregateTypes)) {
        return false;
    }
    const Scope* fieldScope = fieldType.getBodyScope();
    if fieldScope == originScope {
        return true;
    }
    if fieldScope == nil<const Scope*> {
        return false;
    }
    foreach const Scope* visitedScope : visited {
        if visitedScope == fieldScope {
            return false;
        }
    }
    visited.pushBack(fieldScope);

    QualTypeList memberTypes;
    if fieldType.is(SuperType::TY_STRUCT) {
        const Struct* spiceStruct = fieldType.getStruct(node);
        if spiceStruct == nil<const Struct*> {
            return false; // Not manifested yet; the cycle is caught once the last aggregate in it is prepared
        }
        memberTypes = spiceStruct.fieldTypes;
    } else {
        const Union* spiceUnion = fieldType.getUnion(node);
        if spiceUnion == nil<const Union*> {
            return false; // Not manifested yet; the cycle is caught once the last aggregate in it is prepared
        }
        memberTypes = spiceUnion.fieldTypes;
    }

    foreach const QualType& memberType : memberTypes {
        if fieldContainsAggregateByValue(memberType, originScope, node, visited) {
            return true;
        }
    }
    return false;
}

f<Any> TypeChecker.visitStructDefPrepare(ASTStructDefNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);
    QualTypeList usedTemplateTypes;
    Vector<GenericType> templateTypesGeneric;

    // Retrieve struct template types
    if node.hasTemplateTypes {
        if !this.collectTemplateTypes(node.templateTypeLst, templateTypesGeneric) {
            return Any();
        }
        foreach const GenericType& genericType : templateTypesGeneric {
            usedTemplateTypes.pushBack(genericType.qualType);
        }
    }

    // Retrieve implemented interfaces
    QualTypeList interfaceTypes;
    if node.hasInterfaces {
        foreach ASTDataTypeNode* interfaceNode : node.interfaceTypeLst.dataTypes {
            // Visit interface type
            const QualType interfaceType = this.getDataType(interfaceNode);
            if interfaceType.is(SuperType::TY_UNRESOLVED) {
                continue;
            }
            // Check if it is an interface type
            if !interfaceType.is(SuperType::TY_INTERFACE) {
                throwSemanticError(cast<ASTNode*>(interfaceNode), SemanticErrorType::EXPECTED_INTERFACE_TYPE, "Expected interface type, got " + interfaceType.getName(false));
                return Any();
            }
            // Check for visibility
            Scope* interfaceScope = interfaceType.getBodyScope();
            if interfaceScope.isImportedBy(this.rootScope) && !interfaceType.isPublic() {
                throwSemanticError(baseNode, SemanticErrorType::INSUFFICIENT_VISIBILITY, "Cannot access interface '" + interfaceType.getSubType() + "' due to its private visibility");
                return Any();
            }
            // Add to interface types
            interfaceTypes.pushBack(interfaceType);
            // Update the type of the entry for that interface field
            ASTCustomDataTypeNode* customDataType = interfaceNode.baseDataType.customDataType;
            const String& interfaceName = customDataType.typeNameFragments.back();
            SymbolTableEntry* interfaceEntry = node.structScope.lookupStrict("this." + interfaceName);
            assert interfaceEntry != nil<SymbolTableEntry*>;
            interfaceEntry.updateType(interfaceType, false);
        }
    }

    // Update type of struct entry
    assert node.entry != nil<SymbolTableEntry*>;
    TypeChainElementData data;
    data.bodyScope = node.structScope;
    const Type* rawType = this.resourceManager.typeRegistry.getOrInsert(SuperType::TY_STRUCT, node.structName, node.typeId, data, usedTemplateTypes);
    // If the entry was implicitly forward-declared because it is referenced across a circular import
    // (assignDeferredOpaqueType), the existing type was already set to the opaque struct type. Overwriting it with the
    // identical interned type is expected here.
    const QualType existingType = node.entry.getQualType();
    const bool overwrite = existingType.is(SuperType::TY_STRUCT);
    node.entry.updateType(QualType(rawType, node.qualifiers), overwrite);

    // Change to struct scope
    this.currentScope = node.structScope;
    assert this.currentScope.scopeType == ScopeType::STRUCT;

    // Retrieve field types
    QualTypeList fieldTypes;
    // Shared across all fields: the origin (node.structScope) is constant, so a struct already proven not to reach it
    // via one field need not be re-walked for another.
    Vector<const Scope*> visitedScopes;
    foreach IVisitable* fieldVisitable : node.fields {
        ASTFieldNode* field = downcast<ASTFieldNode>(fieldVisitable);
        ASTNode* fieldBaseNode = cast<ASTNode*>(field);

        // Visit field type
        const QualType fieldType = this.visitType(fieldVisitable);
        if fieldType.is(SuperType::TY_UNRESOLVED) {
            this.sourceFile.checkForSoftErrors(); // We get into trouble if we continue without the field type -> abort
        }

        // Check for struct with infinite size. This happens if a struct (transitively, through by-value struct fields)
        // contains itself - either directly (struct A has a field of type A) or through a cycle of structs in mutually
        // importing files (A has a field of type B and B has a field of type A).
        if fieldContainsAggregateByValue(fieldType, node.structScope, fieldBaseNode, visitedScopes) {
            throwSemanticError(fieldBaseNode, SemanticErrorType::STRUCT_INFINITE_SIZE, String("Struct with infinite size detected"));
            return Any();
        }

        // Add to field types
        fieldTypes.pushBack(fieldType);

        // Update type of field entry
        SymbolTableEntry* fieldEntry = this.currentScope.lookupStrict(field.fieldName);
        assert fieldEntry != nil<SymbolTableEntry*>;
        fieldEntry.updateType(fieldType, false);

        // Check if the template type list contains this type
        if !fieldType.isCoveredByGenericTypeList(templateTypesGeneric) {
            throwSemanticError(cast<ASTNode*>(field.dataType), SemanticErrorType::GENERIC_TYPE_NOT_IN_TEMPLATE, String("Generic field type not included in struct template"));
            return Any();
        }
    }

    // Change to the root scope
    this.currentScope = this.rootScope;
    assert this.currentScope.scopeType == ScopeType::GLOBAL;

    // Build struct object
    Struct spiceStruct = Struct(node.structName, node.entry, node.structScope, fieldTypes, templateTypesGeneric, interfaceTypes, baseNode);
    insertStruct(this.currentScope, spiceStruct, &node.structManifestations);
    spiceStruct.scope = node.structScope;

    // Request RTTI runtime if the struct is polymorphic
    node.emitVTable = node.emitVTable || node.hasInterfaces;
    if node.attrs != nil<IVisitable*> {
        ASTTopLevelDefAttrNode* attrs = downcast<ASTTopLevelDefAttrNode>(node.attrs);
        ASTAttrLstNode* attrLst = attrs.attrLst;
        if attrLst.hasAttr(String(ATTR_CORE_COMPILER_EMIT_VTABLE)) {
            const CompileTimeValue value = attrLst.getAttrValueByName(String(ATTR_CORE_COMPILER_EMIT_VTABLE));
            node.emitVTable = node.emitVTable || value.getBoolValue();
        }
    }
    if node.emitVTable && !this.sourceFile.isRttiRT() {
        this.sourceFile.requestRuntimeModule(RuntimeModule::RTTI_RT);
    }

    return Any();
}

f<Any> TypeChecker.visitInterfaceDefPrepare(ASTInterfaceDefNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);
    QualTypeList usedTemplateTypes;
    Vector<GenericType> templateTypesGeneric;

    // Retrieve interface template types
    if node.hasTemplateTypes {
        foreach ASTDataTypeNode* dataType : node.templateTypeLst.dataTypes {
            // Visit template type
            const QualType templateType = this.getDataType(dataType);
            if templateType.is(SuperType::TY_UNRESOLVED) {
                return Any();
            }
            // Check if it is a generic type
            if !templateType.is(SuperType::TY_GENERIC) {
                this.softError(cast<ASTNode*>(dataType), SemanticErrorType::EXPECTED_GENERIC_TYPE, String("A template list can only contain generic types"));
                continue;
            }
            // Convert generic symbol type to generic type
            GenericType* genericType = this.rootScope.lookupGenericTypeStrict(templateType.getSubType());
            assert genericType != nil<GenericType*>;
            usedTemplateTypes.pushBack(genericType.qualType);
            templateTypesGeneric.pushBack(*genericType);
        }
    }

    // Update type of interface entry
    TypeChainElementData data;
    data.bodyScope = node.interfaceScope;
    const Type* rawType = this.resourceManager.typeRegistry.getOrInsert(SuperType::TY_INTERFACE, node.interfaceName, node.typeId, data, usedTemplateTypes);
    const QualType interfaceType = QualType(rawType, node.qualifiers);
    assert node.entry != nil<SymbolTableEntry*>;
    // If the entry was implicitly forward-declared because it is referenced across a circular import
    // (assignDeferredOpaqueType), the existing type was already set to the opaque interface type. Overwriting it with the
    // identical interned type is expected here.
    const QualType existingType = node.entry.getQualType();
    const bool overwrite = existingType.is(SuperType::TY_INTERFACE);
    node.entry.updateType(interfaceType, overwrite);

    // Change to interface scope
    this.currentScope = node.interfaceScope;
    assert this.currentScope.scopeType == ScopeType::INTERFACE;

    // Visit methods
    unsigned long vtableIndex = 0l;
    Vector<Function*> methods;
    const QualTypeList interfaceTemplateTypes = interfaceType.getTemplateTypes();
    foreach IVisitable* signature : node.signatures {
        Any signatureResult = this.visit(signature);
        Vector<Function*>* method = signatureResult.get<Vector<Function*>*>();
        if method == nil<Vector<Function*>*> {
            return Any();
        }

        // Set 'this' type
        foreach Function* m : *method {
            m.isVirtual = true; // Interface methods are always virtual
            m.vtableIndex = vtableIndex;
            m.thisType = interfaceType;

            // Merge the enclosing interface's own template types into the method's template types, mirroring how struct
            // methods inherit the struct's generic params in visitFctDefPrepare. Without this, a method that does not
            // redeclare its own template list (e.g. isValid() inside IIterator<T>) ends up with an empty templateTypes
            // list, even though its thisType references the interface's generic type - so generic type resolution fails
            // while matching the 'this' type of a call through an interface reference.
            foreach const QualType& templateType : interfaceTemplateTypes {
                addUsedTemplateType(m.templateTypes, templateType);
            }
        }

        foreach Function* m : *method {
            methods.pushBack(m);
        }
        vtableIndex++;
    }

    // Change to root scope
    this.currentScope = this.rootScope;
    assert this.currentScope.scopeType == ScopeType::GLOBAL;

    // Build interface object
    Interface spiceInterface = Interface(node.interfaceName, node.entry, node.interfaceScope, methods, templateTypesGeneric, baseNode);
    insertInterface(this.currentScope, spiceInterface, &node.interfaceManifestations);
    spiceInterface.scope = node.interfaceScope;

    // Request RTTI runtime, that is always required when dealing with interfaces due to polymorphism
    if !this.sourceFile.isRttiRT() {
        this.sourceFile.requestRuntimeModule(RuntimeModule::RTTI_RT);
    }

    return Any();
}

f<Any> TypeChecker.visitUnionDefPrepare(ASTUnionDefNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);
    QualTypeList usedTemplateTypes;
    Vector<GenericType> templateTypesGeneric;

    // Retrieve union template types
    if node.hasTemplateTypes {
        if !this.collectTemplateTypes(node.templateTypeLst, templateTypesGeneric) {
            return Any();
        }
        foreach const GenericType& genericType : templateTypesGeneric {
            usedTemplateTypes.pushBack(genericType.qualType);
        }
    }

    // Update type of union entry
    assert node.entry != nil<SymbolTableEntry*>;
    TypeChainElementData data;
    data.bodyScope = node.unionScope;
    const Type* rawType = this.resourceManager.typeRegistry.getOrInsert(SuperType::TY_UNION, node.unionName, node.typeId, data, usedTemplateTypes);
    // If the entry was implicitly forward-declared because it is referenced across a circular import
    // (assignDeferredOpaqueType), the existing type was already set to the opaque union type. Overwriting it with the
    // identical interned type is expected here.
    const QualType existingType = node.entry.getQualType();
    const bool overwrite = existingType.is(SuperType::TY_UNION);
    node.entry.updateType(QualType(rawType, node.qualifiers), overwrite);

    // Change to union scope
    this.currentScope = node.unionScope;
    assert this.currentScope.scopeType == ScopeType::UNION;

    // Retrieve field types
    QualTypeList fieldTypes;
    // Shared across all fields: the origin (node.unionScope) is constant, so an aggregate already proven not to reach
    // it via one field need not be re-walked for another.
    Vector<const Scope*> visitedScopes;
    unsigned long defaultFieldIndex = UNION_NO_DEFAULT_FIELD_INDEX;
    for unsigned long i = 0l; i < node.fields.getSize(); i++ {
        IVisitable* fieldVisitable = node.fields.get(i);
        ASTFieldNode* field = downcast<ASTFieldNode>(fieldVisitable);
        ASTNode* fieldBaseNode = cast<ASTNode*>(field);

        // Visit field type
        const QualType fieldType = this.visitType(fieldVisitable);
        if fieldType.is(SuperType::TY_UNRESOLVED) {
            this.sourceFile.checkForSoftErrors(); // We get into trouble if we continue without the field type -> abort
        }

        // Check for union/struct with infinite size. This happens if the union (transitively, through by-value
        // struct/union fields) contains itself - either directly or through a cycle of aggregates in mutually
        // importing files.
        if fieldContainsAggregateByValue(fieldType, node.unionScope, fieldBaseNode, visitedScopes) {
            throwSemanticError(fieldBaseNode, SemanticErrorType::UNION_INFINITE_SIZE, String("Union with infinite size detected"));
            return Any();
        }

        // Union fields must not be references
        if fieldType.isRef() {
            this.softError(fieldBaseNode, SemanticErrorType::UNION_FIELD_MUST_NOT_BE_REFERENCE, String("A union field must not be a reference"));
        }

        // Union fields must be trivially constructible, copyable and destructible, since the union does not know which
        // field is currently active and therefore cannot run any non-trivial special member on its own.
        if !fieldType.isRef() && (!fieldType.isTriviallyConstructible(fieldBaseNode) || !fieldType.isTriviallyCopyable(fieldBaseNode) || !fieldType.isTriviallyDestructible(fieldBaseNode)) {
            this.softError(fieldBaseNode, SemanticErrorType::UNION_FIELD_TYPE_NOT_TRIVIAL, "The type of the union field '" + field.fieldName + "' is not trivial. Only trivial types are allowed as union fields");
        }

        // At most one field may carry a default value
        if field.defaultValue != nil<IVisitable*> {
            if defaultFieldIndex != UNION_NO_DEFAULT_FIELD_INDEX {
                this.softError(fieldBaseNode, SemanticErrorType::DUPLICATE_UNION_DEFAULT_VALUE, String("A union may only have one field with a default value"));
            } else {
                defaultFieldIndex = i;
            }
        }

        // Add to field types
        fieldTypes.pushBack(fieldType);

        // Update type of field entry
        SymbolTableEntry* fieldEntry = this.currentScope.lookupStrict(field.fieldName);
        assert fieldEntry != nil<SymbolTableEntry*>;
        fieldEntry.updateType(fieldType, false);

        // Check if the template type list contains this type
        if !fieldType.isCoveredByGenericTypeList(templateTypesGeneric) {
            throwSemanticError(cast<ASTNode*>(field.dataType), SemanticErrorType::GENERIC_TYPE_NOT_IN_TEMPLATE, String("Generic field type not included in union template"));
            return Any();
        }
    }

    // Change to the root scope
    this.currentScope = this.rootScope;
    assert this.currentScope.scopeType == ScopeType::GLOBAL;

    // Build union object
    Union spiceUnion = Union(node.unionName, node.entry, node.unionScope, fieldTypes, templateTypesGeneric, baseNode);
    spiceUnion.defaultFieldIndex = defaultFieldIndex;
    insertUnion(this.currentScope, spiceUnion, &node.unionManifestations);

    return Any();
}

f<Any> TypeChecker.visitEnumDefPrepare(ASTEnumDefNode* node) {
    // Update type of enum entry
    TypeChainElementData data;
    data.bodyScope = node.enumScope;
    const QualTypeList noTemplateTypes;
    const Type* rawType = this.resourceManager.typeRegistry.getOrInsert(SuperType::TY_ENUM, node.enumName, node.typeId, data, noTemplateTypes);
    assert node.entry != nil<SymbolTableEntry*>;
    // The enum may already carry its opaque type if it was referenced across a circular import before being prepared
    // (assignDeferredOpaqueType). Overwriting it with the identical interned type is expected here.
    const QualType existingType = node.entry.getQualType();
    const bool overwrite = existingType.is(SuperType::TY_ENUM);
    node.entry.updateType(QualType(rawType, node.qualifiers), overwrite);

    // Change to enum scope
    this.currentScope = node.enumScope;
    assert this.currentScope.scopeType == ScopeType::ENUM;

    // Loop through all items with values
    ASTEnumItemLstNode* itemLst = downcast<ASTEnumItemLstNode>(node.itemLst);
    Vector<String> names;
    Vector<unsigned int> values;
    foreach ASTEnumItemNode* enumItem : itemLst.items {
        // Save name
        names.pushBack(enumItem.itemName);
        // Check for duplicate value
        if enumItem.hasValue {
            if containsValue(values, enumItem.itemValue) {
                this.softError(cast<ASTNode*>(enumItem), SemanticErrorType::DUPLICATE_ENUM_ITEM_VALUE, String("Duplicate enum item value, please use another"));
                continue;
            }
            values.pushBack(enumItem.itemValue);
        }
    }

    // Loop through all items without values
    unsigned int nextValue = 0u;
    const QualType intSymbolType = QualType(SuperType::TY_INT);
    foreach ASTEnumItemNode* enumItem : itemLst.items {
        // Update type of enum item entry
        SymbolTableEntry* itemEntry = this.currentScope.lookupStrict(enumItem.itemName);
        assert itemEntry != nil<SymbolTableEntry*>;
        itemEntry.updateType(intSymbolType, false);
        // Fill in value if not filled yet
        if !enumItem.hasValue {
            while containsValue(values, nextValue) {
                nextValue++;
            }
            enumItem.itemValue = nextValue;
            values.pushBack(nextValue);
        }
    }

    // Change to root scope
    this.currentScope = this.rootScope;
    assert this.currentScope.scopeType == ScopeType::GLOBAL;

    return Any();
}

// Check if the given list of enum item values contains the given value (std::ranges::find in the host)
f<bool> containsValue(const Vector<unsigned int>& values, unsigned int value) {
    foreach const unsigned int existingValue : values {
        if existingValue == value {
            return true;
        }
    }
    return false;
}

f<Any> TypeChecker.visitGenericTypeDefPrepare(ASTGenericTypeDefNode* node) {
    // Retrieve type conditions
    ASTTypeAltsLstNode* typeAltsLst = downcast<ASTTypeAltsLstNode>(node.typeAltsLst);
    QualTypeList typeConditions;
    foreach ASTDataTypeNode* typeAlt : typeAltsLst.dataTypes {
        const QualType typeCondition = this.getDataType(typeAlt);
        if typeCondition.is(SuperType::TY_UNRESOLVED) {
            return Any();
        }
        typeConditions.pushBack(typeCondition);
    }

    // Add generic type to the scope
    const GenericType genericType = GenericType(node.typeName, typeConditions);
    this.rootScope.insertGenericType(node.typeName, genericType);

    // Check if only one type condition is set
    if typeConditions.getSize() == 1l {
        const QualType& typeCondition = typeConditions.front();
        if !typeCondition.is(SuperType::TY_DYN) {
            this.addWarning(typeAltsLst.codeLoc, CompilerWarningType::SINGLE_GENERIC_TYPE_CONDITION, String("Generic type is locked to one type"));
        }
    }

    // Check if the list contains the dyn type, along with other types
    bool containsDynType = false;
    foreach const QualType& typeCondition : typeConditions {
        if typeCondition.is(SuperType::TY_DYN) {
            containsDynType = true;
        }
    }
    if containsDynType && typeConditions.getSize() > 1l {
        this.addWarning(typeAltsLst.codeLoc, CompilerWarningType::INEFFECTIVE_GENERIC_TYPE_CONDITION, String("One or several type conditions are superfluous, because the dyn type condition is given"));
    }

    return Any();
}

#[ignoreUnusedReturnValue]
f<Any> TypeChecker.visitAliasDefPrepare(ASTAliasDefNode* node) {
    assert node.entry != nil<SymbolTableEntry*> && node.aliasedTypeContainerEntry != nil<SymbolTableEntry*>;

    // The alias may already have been prepared on demand because it was referenced across a circular import
    // (assignDeferredOpaqueType). In that case there is nothing left to do.
    const QualType existingType = node.entry.getQualType();
    if existingType.is(SuperType::TY_ALIAS) {
        return Any();
    }

    // Ensure the aliased-type subtree is sized for manifestations before it is visited below. On the normal path
    // visitEntry already sized the whole file to 1, so this is a no-op; on the on-demand path (a cross-import reference
    // reaching this alias before its own file's visitEntry ran) it establishes the precondition setEvaluatedSymbolType
    // requires.
    ASTNode* dataTypeBaseNode = cast<ASTNode*>(node.dataType);
    dataTypeBaseNode.resizeToNumberOfManifestations(1l);

    // Update type of alias entry
    const TypeChainElementData noData;
    const QualTypeList noTemplateTypes;
    const Type* rawType = this.resourceManager.typeRegistry.getOrInsert(SuperType::TY_ALIAS, node.aliasName, node.typeId, noData, noTemplateTypes);
    node.entry.updateType(QualType(rawType, node.qualifiers), false);

    // Update type of the aliased type container entry
    const QualType aliasedType = this.getDataType(node.dataType);
    if aliasedType.is(SuperType::TY_UNRESOLVED) {
        return Any();
    }
    node.aliasedTypeContainerEntry.updateType(aliasedType, false);
    node.aliasedTypeContainerEntry.used = true; // The container type is always used per default

    return Any();
}

f<Any> TypeChecker.visitGlobalVarDefPrepare(ASTGlobalVarDefNode* node) {
    // Insert variable name to symbol table
    QualType globalVarType = this.getDataType(node.dataType);
    if globalVarType.is(SuperType::TY_UNRESOLVED) {
        return Any();
    }

    if node.constant != nil<ASTConstantNode*> { // Variable is initialized here
        const ExprResult constantResult = this.visitExpr(cast<IVisitable*>(node.constant));
        const QualType rhsType = constantResult.ty;
        if rhsType.is(SuperType::TY_UNRESOLVED) {
            return Any();
        }
        if globalVarType.is(SuperType::TY_DYN) { // Perform type inference
            globalVarType = rhsType;
        } else if !globalVarType.matches(rhsType, false, true, true) { // Check if types are matching
            this.softError(cast<ASTNode*>(node.constant), SemanticErrorType::OPERATOR_WRONG_DATA_TYPE, "Expected " + globalVarType.getName(false) + ", but got " + rhsType.getName(false));
            return Any();
        }
    }

    // Check if the type is still missing
    if globalVarType.is(SuperType::TY_DYN) {
        this.softError(cast<ASTNode*>(node.dataType), SemanticErrorType::GLOBAL_OF_TYPE_DYN, String("Global variables must have an explicit data type"));
        return Any();
    }

    // Check if we would need to insert instructions in the global scope to initialize the variable
    if !globalVarType.isPrimitive() {
        this.softError(cast<ASTNode*>(node.dataType), SemanticErrorType::GLOBAL_OF_INVALID_TYPE, String("Spice does only support global variables of primitive type"));
        return Any();
    }

    // Update type of global var entry
    assert node.entry != nil<SymbolTableEntry*>;
    node.entry.updateType(globalVarType, false);

    // Check if a value is attached
    if node.constant == nil<ASTConstantNode*> && globalVarType.isConst() {
        this.softError(cast<ASTNode*>(node), SemanticErrorType::GLOBAL_CONST_WITHOUT_VALUE, String("You must specify a value for constant global variables"));
        return Any();
    }

    return Any();
}

f<Any> TypeChecker.visitExtDeclPrepare(ASTExtDeclNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Collect argument types
    QualTypeList argTypes;
    ParamList argList;
    ASTTypeLstWithEllipsisNode* argTypeLst = nil<ASTTypeLstWithEllipsisNode*>;
    if node.argTypeLst != nil<IVisitable*> {
        argTypeLst = downcast<ASTTypeLstWithEllipsisNode>(node.argTypeLst);
    }
    if node.hasArgs {
        foreach ASTDataTypeNode* arg : argTypeLst.typeLst.dataTypes {
            // Visit argument
            const QualType argType = this.getDataType(arg);
            if argType.is(SuperType::TY_UNRESOLVED) {
                return Any();
            }
            // Check if the argument type is 'dyn'
            if argType.is(SuperType::TY_DYN) {
                this.softError(cast<ASTNode*>(arg), SemanticErrorType::UNEXPECTED_DYN_TYPE, String("Dyn data type is not allowed as arg type for external functions"));
                continue;
            }
            // Save argument
            argTypes.pushBack(argType);
            argList.pushBack(Param{argType, false});
        }
    }

    // Retrieve return type
    QualType returnType = QualType(SuperType::TY_DYN);
    const bool isFunction = node.returnType != nil<ASTDataTypeNode*>;
    if isFunction { // External function
        returnType = this.getDataType(node.returnType);
        if returnType.is(SuperType::TY_UNRESOLVED) {
            return Any();
        }
        // Check if return type is dyn
        if returnType.is(SuperType::TY_DYN) {
            this.softError(cast<ASTNode*>(node.returnType), SemanticErrorType::UNEXPECTED_DYN_TYPE, String("dyn is not allowed as return type for external functions"));
            return Any();
        }
    }

    // Add function to current scope
    const Vector<GenericType> noTemplateTypes;
    const Function spiceFunc = Function(node.extFunctionName, node.entry, QualType(SuperType::TY_DYN), returnType, argList, noTemplateTypes, baseNode);
    node.extFunction = insertFunction(this.currentScope, spiceFunc, &node.extFunctionManifestations);
    node.extFunction.mangleFunctionName = false;
    node.extFunction.alreadyTypeChecked = true;
    node.extFunction.isVararg = argTypeLst != nil<ASTTypeLstWithEllipsisNode*> && argTypeLst.hasEllipsis;

    // Check procedure attributes
    if node.attrs != nil<IVisitable*> {
        ASTTopLevelDefAttrNode* attrs = downcast<ASTTopLevelDefAttrNode>(node.attrs);
        ASTAttrLstNode* attrLst = attrs.attrLst;
        if attrLst.hasAttr(String(ATTR_CORE_COMPILER_MANGLE)) {
            const CompileTimeValue value = attrLst.getAttrValueByName(String(ATTR_CORE_COMPILER_MANGLE));
            node.extFunction.mangleFunctionName = value.getBoolValue();
        }
        if attrLst.hasAttr(String(ATTR_CORE_COMPILER_MANGLED_NAME)) {
            const CompileTimeValue value = attrLst.getAttrValueByName(String(ATTR_CORE_COMPILER_MANGLED_NAME));
            node.extFunction.predefinedMangledName = this.resourceManager.getCompileTimeStringValue(value.getStringValueOffset());
        }
    }

    // Prepare ext function type
    const SuperType superType = isFunction ? SuperType::TY_FUNCTION : SuperType::TY_PROCEDURE;
    const QualType extFunctionTypeBase = QualType(superType);
    const QualType extFunctionType = extFunctionTypeBase.getWithFunctionParamAndReturnTypes(returnType, argTypes);

    // Set type of external function
    node.entry.updateType(extFunctionType, false);

    // Rename the original child scope to reflect the substantiated versions of the external function
    this.currentScope.renameChildScope(node.getScopeId(), spiceFunc.getScopeName());

    return Any();
}

f<Any> TypeChecker.visitImportDefPrepare(ASTImportDefNode* node) {
    // Set entry to import type
    const QualType importType = QualType(SuperType::TY_IMPORT, node.importName);
    assert node.entry != nil<SymbolTableEntry*>;
    node.entry.updateType(importType, false);

    return Any();
}

// ================================================================ TypeCheckerMeta.cpp ==========================================

public f<Any> TypeChecker.visitParamLst(ASTParamLstNode* node) {
    NamedParamList namedParams;
    bool metOptional = false;

    foreach ASTDeclStmtNode* param : node.params {
        ASTNode* paramBaseNode = cast<ASTNode*>(param);

        // Visit param
        const QualType paramType = this.visitType(cast<IVisitable*>(param));

        // Check if the type could be inferred. Dyn without a default value is forbidden
        if paramType.is(SuperType::TY_DYN) {
            this.softError(cast<ASTNode*>(node), SemanticErrorType::FCT_PARAM_IS_TYPE_DYN, "Type of parameter '" + param.varName + "' is invalid");
            continue;
        }

        // Ensure that no optional param comes after a mandatory param
        if param.hasAssignment {
            metOptional = true;
        } else if metOptional {
            this.softError(paramBaseNode, SemanticErrorType::INVALID_PARAM_ORDER, String("Mandatory parameters must go before any optional parameters"));
            continue;
        }

        // Warn about non-trivially copyable types being passed by value, since that requires an implicit copy on every call.
        // Only check in the check stage (not the prepare stage), because generic param types are not substantiated yet there.
        if this.typeCheckerMode == TypeCheckerMode::TC_MODE_POST && !paramType.isTriviallyCopyable(paramBaseNode) {
            const String message = "Parameter '" + param.varName + "' has the non-trivially copyable type '" + paramType.getName() + "' and is passed by value, which requires an implicit copy on every call. Consider passing it by reference instead.";
            this.addWarning(param.codeLoc, CompilerWarningType::NON_TRIVIAL_TYPE_PASSED_BY_VALUE, message);
        }

        // Add parameter to named param list
        namedParams.pushBack(NamedParam{param.varName.getRaw(), paramType, metOptional});
    }

    return Any(namedParams);
}

public f<Any> TypeChecker.visitField(ASTFieldNode* node) {
    const QualType fieldType = this.getDataType(node.dataType);
    if fieldType.is(SuperType::TY_UNRESOLVED) {
        return Any(fieldType);
    }

    if node.defaultValue != nil<IVisitable*> {
        const ExprResult defaultValueResult = this.visitExpr(node.defaultValue);
        const QualType defaultValueType = defaultValueResult.ty;
        if defaultValueType.is(SuperType::TY_UNRESOLVED) {
            return Any(defaultValueType);
        }
        if !fieldType.matches(defaultValueType, false, true, true) {
            return this.softErrorQT(cast<ASTNode*>(node), SemanticErrorType::FIELD_TYPE_NOT_MATCHING, String("Type of the default values does not match the field type"));
        }
    }

    return Any(fieldType);
}

public f<Any> TypeChecker.visitSignature(ASTSignatureNode* node) {
    const bool isFunction = node.signatureType == SignatureType::TYPE_FUNCTION;
    const Any noSignatureManifestations = Any(nil<Vector<Function*>*>);

    // Retrieve function template types
    Vector<GenericType> usedGenericTypes;
    if node.hasTemplateTypes {
        foreach ASTDataTypeNode* dataType : node.templateTypeLst.dataTypes {
            // Visit template type
            const QualType templateType = this.getDataType(dataType);
            if templateType.is(SuperType::TY_UNRESOLVED) {
                return noSignatureManifestations;
            }
            // Check if it is a generic type
            if !templateType.is(SuperType::TY_GENERIC) {
                this.softError(cast<ASTNode*>(dataType), SemanticErrorType::EXPECTED_GENERIC_TYPE, String("A template list can only contain generic types"));
                return noSignatureManifestations;
            }
            // Convert generic symbol type to generic type
            GenericType* genericType = this.rootScope.lookupGenericTypeStrict(templateType.getSubType());
            assert genericType != nil<GenericType*>;
            usedGenericTypes.pushBack(*genericType);
        }
    }

    // Visit return type
    QualType returnType = QualType(SuperType::TY_DYN);
    if isFunction {
        returnType = this.getDataType(node.returnType);
        if returnType.is(SuperType::TY_UNRESOLVED) {
            return noSignatureManifestations;
        }

        if !returnType.isCoveredByGenericTypeList(usedGenericTypes) {
            this.softError(cast<ASTNode*>(node.returnType), SemanticErrorType::GENERIC_TYPE_NOT_IN_TEMPLATE, String("Generic return type not included in the template type list of the function"));
        }
    }

    // Visit params
    QualTypeList paramTypes;
    ParamList paramList;
    if node.hasParams {
        foreach ASTDataTypeNode* param : node.paramTypeLst.dataTypes {
            const QualType paramType = this.getDataType(param);
            if paramType.is(SuperType::TY_UNRESOLVED) {
                return noSignatureManifestations;
            }

            // Check if the type is present in the template for generic types
            if !paramType.isCoveredByGenericTypeList(usedGenericTypes) {
                this.softError(cast<ASTNode*>(node.paramTypeLst), SemanticErrorType::GENERIC_TYPE_NOT_IN_TEMPLATE, String("Generic param type not included in the template type list of the function"));
                continue;
            }

            paramTypes.pushBack(paramType);
            paramList.pushBack(Param{paramType, false});
        }
    }

    // Build signature object
    const Function signature = Function(node.methodName, nil<SymbolTableEntry*>, QualType(SuperType::TY_DYN), returnType, paramList, usedGenericTypes, cast<ASTNode*>(node));

    // Add signature to current scope
    Function* manifestation = insertFunction(this.currentScope, signature, &node.signatureManifestations);
    manifestation.entry = node.entry;
    manifestation.used = true;

    // Prepare signature type
    const SuperType superType = isFunction ? SuperType::TY_FUNCTION : SuperType::TY_PROCEDURE;
    const QualType signatureTypeBase = QualType(superType);
    QualType signatureType = signatureTypeBase.getWithFunctionParamAndReturnTypes(returnType, paramTypes);
    signatureType.setQualifiers(node.signatureQualifiers);

    // Set entry to signature type
    assert node.entry != nil<SymbolTableEntry*>;
    node.entry.updateType(signatureType, false);
    node.entry.used = true;

    return Any(&node.signatureManifestations);
}

public f<Any> TypeChecker.visitDataType(ASTDataTypeNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Visit base data type
    QualType qualType = this.visitType(cast<IVisitable*>(node.baseDataType));
    if qualType.is(SuperType::TY_UNRESOLVED) {
        return Any(qualType);
    }

    Queue<TypeModifier> tmQueue = node.tmQueue;
    while tmQueue.getSize() > 0l {
        const TypeModifier typeModifier = tmQueue.front();

        // Only the outermost array can have an unknown size
        if qualType.isArray() && qualType.getArraySize() == ARRAY_SIZE_UNKNOWN {
            return this.softErrorQT(baseNode, SemanticErrorType::ARRAY_SIZE_INVALID, String("Usage of incomplete array type. Only the outermost array type may have unknown size"));
        }

        switch typeModifier.modifierType {
            case TypeModifierType::TYPE_PTR: {
                qualType = qualType.toPtr(baseNode);
            }
            case TypeModifierType::TYPE_REF: {
                qualType = qualType.toRef(baseNode);
            }
            case TypeModifierType::TYPE_ARRAY: {
                unsigned int hardcodedSize = typeModifier.hardcodedSize;
                const String& varName = typeModifier.sizeVarName;
                if !varName.isEmpty() {
                    const SymbolTableEntry* globalVar = this.rootScope.lookupStrict(varName);
                    if globalVar == nil<const SymbolTableEntry*> {
                        return this.softErrorQT(baseNode, SemanticErrorType::REFERENCED_UNDEFINED_VARIABLE, "Could not find global variable '" + varName + "' ");
                    }
                    const QualType globalVarType = globalVar.getQualType();
                    if !globalVarType.isConst() {
                        return this.softErrorQT(baseNode, SemanticErrorType::EXPECTED_CONST_VARIABLE, String("The size of the array must be known at compile time"));
                    }
                    if !globalVarType.is(SuperType::TY_INT) {
                        return this.softErrorQT(baseNode, SemanticErrorType::OPERATOR_WRONG_DATA_TYPE, String("Expected variable of type int"));
                    }
                    const CompileTimeValue globalVarValue = globalVar.declNode.getCompileTimeValue(this.manIdx);
                    hardcodedSize = cast<unsigned int>(globalVarValue.getIntValue());
                }

                if typeModifier.hasSize && hardcodedSize <= 1u {
                    return this.softErrorQT(baseNode, SemanticErrorType::ARRAY_SIZE_INVALID, String("The size of an array must be > 1 and explicitly stated"));
                }
                qualType = qualType.toArr(baseNode, hardcodedSize);
            }
        }
        tmQueue.pop();
    }

    // Attach the qualifiers to the type
    if node.qualifierLst != nil<ASTQualifierLstNode*> {
        const QualType baseType = qualType.getBase();
        const dyn signableTypes = [SuperType::TY_INT, SuperType::TY_LONG, SuperType::TY_SHORT, SuperType::TY_BYTE, SuperType::TY_CHAR, SuperType::TY_GENERIC];
        foreach ASTQualifierNode* qualifier : node.qualifierLst.qualifiers {
            ASTNode* qualifierBaseNode = cast<ASTNode*>(qualifier);
            TypeQualifiers& qualifiers = qualType.getQualifiers();
            if qualifier.qualifierType == QualifierType::CONST {
                qualifiers.isConst = true;
            } else if qualifier.qualifierType == QualifierType::SIGNED {
                if !baseType.isOneOf(signableTypes, len(signableTypes)) {
                    return this.softErrorQT(qualifierBaseNode, SemanticErrorType::QUALIFIER_AT_ILLEGAL_CONTEXT, "Cannot use this qualifier on type " + baseType.getName(false));
                }
                qualifiers.isSigned = true;
                qualifiers.isUnsigned = false;
            } else if qualifier.qualifierType == QualifierType::UNSIGNED {
                if !baseType.isOneOf(signableTypes, len(signableTypes)) {
                    return this.softErrorQT(qualifierBaseNode, SemanticErrorType::QUALIFIER_AT_ILLEGAL_CONTEXT, "Cannot use this qualifier on type " + baseType.getName(false));
                }
                qualifiers.isSigned = false;
                qualifiers.isUnsigned = true;
            } else if qualifier.qualifierType == QualifierType::HEAP {
                // Heap variables can only be pointers
                const QualType unwrappedType = qualType.removeReferenceWrapper();
                const dyn heapTypes = [SuperType::TY_PTR, SuperType::TY_ARRAY, SuperType::TY_STRING];
                if !unwrappedType.isOneOf(heapTypes, len(heapTypes)) {
                    return this.softErrorQT(qualifierBaseNode, SemanticErrorType::QUALIFIER_AT_ILLEGAL_CONTEXT, "The heap qualifier can only be applied to symbols of pointer type, you provided " + baseType.getName(false));
                }
                qualifiers.isHeap = true;
            } else if qualifier.qualifierType == QualifierType::COMPOSE && node.isFieldType {
                if !qualType.is(SuperType::TY_STRUCT) {
                    return this.softErrorQT(qualifierBaseNode, SemanticErrorType::QUALIFIER_AT_ILLEGAL_CONTEXT, String("The compose qualifier can only be used on plain struct fields"));
                }
                qualifiers.isComposition = true;
            } else if qualifier.qualifierType == QualifierType::PUBLIC && (node.isFieldType || node.isGlobalType) {
                qualifiers.isPublic = true;
            } else {
                String entryName = String("local variable");
                if node.isGlobalType {
                    entryName = String("global variable");
                } else if node.isFieldType {
                    entryName = String("field");
                } else if node.isParamType {
                    entryName = String("param");
                } else if node.isReturnType {
                    entryName = String("return variable");
                }
                return this.softErrorQT(qualifierBaseNode, SemanticErrorType::QUALIFIER_AT_ILLEGAL_CONTEXT, "Cannot use this qualifier on a " + entryName + " definition");
            }
        }
    }

    return Any(node.node.setEvaluatedSymbolType(qualType, this.manIdx));
}

public f<Any> TypeChecker.visitBaseDataType(ASTBaseDataTypeNode* node) {
    // Note: The host returns from within each case. Here, the type is assigned in the cases and returned afterwards
    QualType qualType = QualType(SuperType::TY_DYN);
    switch node.baseType {
        case BaseDataTypeType::TYPE_DOUBLE: {
            qualType = QualType(SuperType::TY_DOUBLE);
        }
        case BaseDataTypeType::TYPE_INT: {
            qualType = QualType(SuperType::TY_INT);
        }
        case BaseDataTypeType::TYPE_SHORT: {
            qualType = QualType(SuperType::TY_SHORT);
        }
        case BaseDataTypeType::TYPE_LONG: {
            qualType = QualType(SuperType::TY_LONG);
        }
        case BaseDataTypeType::TYPE_BYTE: {
            qualType = QualType(SuperType::TY_BYTE);
        }
        case BaseDataTypeType::TYPE_CHAR: {
            qualType = QualType(SuperType::TY_CHAR);
        }
        case BaseDataTypeType::TYPE_STRING: {
            qualType = QualType(SuperType::TY_STRING);
        }
        case BaseDataTypeType::TYPE_BOOL: {
            qualType = QualType(SuperType::TY_BOOL);
        }
        case BaseDataTypeType::TYPE_CUSTOM: {
            qualType = this.visitType(cast<IVisitable*>(node.customDataType));
            if qualType.is(SuperType::TY_UNRESOLVED) {
                return Any(qualType);
            }
        }
        case BaseDataTypeType::TYPE_FUNCTION: {
            qualType = this.visitType(node.functionDataType);
            if qualType.is(SuperType::TY_UNRESOLVED) {
                return Any(qualType);
            }
        }
    }
    return Any(node.node.setEvaluatedSymbolType(qualType, this.manIdx));
}

public f<Any> TypeChecker.visitCustomDataType(ASTCustomDataTypeNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);

    // It is a struct type -> get the access scope
    const String firstFragment = node.typeNameFragments.front();

    // Check this type requires a runtime module
    if node.typeNameFragments.getSize() == 1l {
        this.ensureLoadedRuntimeForTypeName(firstFragment);
    }

    // A type can either be a single fragment like "Test" or multiple fragments "a.b.Test", which means it is imported.
    bool isImported = node.typeNameFragments.getSize() > 1l;
    GenericType* genericType = this.rootScope.lookupGenericTypeStrict(firstFragment);
    if genericType != nil<GenericType*> {
        assert !isImported;
        // Take the concrete replacement type for the name of this generic type if available
        QualType symbolType = genericType.qualType;
        if this.typeMapping.contains(firstFragment) {
            symbolType = this.typeMapping.get(firstFragment);
        }

        // Check if the replacement requires a runtime module
        if symbolType.is(SuperType::TY_STRUCT) {
            this.ensureLoadedRuntimeForTypeName(symbolType.getSubType());
        }

        return Any(node.node.setEvaluatedSymbolType(symbolType, this.manIdx));
    }

    // Check if the type exists in the exported names registry
    const NameRegistryEntry* registryEntry = this.sourceFile.getNameRegistryEntry(node.fqTypeName);
    if registryEntry == nil<const NameRegistryEntry*> {
        if this.sourceFile.isAmbiguousName(node.fqTypeName) {
            return this.softErrorQT(baseNode, SemanticErrorType::AMBIGUOUS_SYMBOL, this.sourceFile.getAmbiguousNameMessage(node.fqTypeName));
        }
        return this.softErrorQT(baseNode, SemanticErrorType::UNKNOWN_DATATYPE, "Unknown datatype '" + node.fqTypeName + "'");
    }
    assert registryEntry.targetEntry != nil<SymbolTableEntry*> && registryEntry.targetScope != nil<Scope*>;
    SymbolTableEntry* entry = registryEntry.targetEntry;
    entry.used = true;
    Scope* defScope = registryEntry.targetScope.parent;
    QualType entryType = entry.getQualType();

    // With circular imports, two structs/interfaces in mutually importing files can reference each other, so neither can be
    // prepared strictly before the other. If we reach one here before it has been prepared (its type is still invalid),
    // assign its opaque type now - an implicit forward declaration. The full prepare pass assigns the identical interned
    // type later and additionally fills in the body and manifestations.
    if entryType.is(SuperType::TY_INVALID) {
        this.assignDeferredOpaqueType(entry);
        entryType = entry.getQualType();
    }

    // Enums can early-return
    if entryType.is(SuperType::TY_ENUM) {
        return Any(QualType(SuperType::TY_INT));
    }

    const dyn aggregateTypes = [SuperType::TY_STRUCT, SuperType::TY_INTERFACE, SuperType::TY_UNION];
    if entryType.isOneOf(aggregateTypes, len(aggregateTypes)) {
        assert baseNode.parent.parent.kind == ASTNodeKind::DATA_TYPE;

        // Remember how many template types this struct/interface/union actually declares, before it gets overwritten below
        const QualTypeList declaredTemplateTypes = entryType.getTemplateTypes();
        const long requiredTemplateTypeCount = declaredTemplateTypes.getSize();

        // Collect the concrete template types
        bool allTemplateTypesConcrete = true;
        QualTypeList templateTypes;
        if node.templateTypeLst != nil<IVisitable*> {
            assert defScope != nil<Scope*>;
            isImported = defScope.isImportedBy(this.rootScope);

            ASTTypeLstNode* templateTypeLst = downcast<ASTTypeLstNode>(node.templateTypeLst);
            foreach ASTDataTypeNode* dataType : templateTypeLst.dataTypes {
                const QualType templateType = this.getDataType(dataType);
                if templateType.is(SuperType::TY_UNRESOLVED) {
                    return Any(templateType);
                }
                if entryType.is(SuperType::TY_GENERIC) {
                    allTemplateTypesConcrete = false;
                } else if isImported {
                    // Introduce the local type to the imported source file
                    const QualType importedType = this.mapLocalTypeToImportedScopeType(defScope, templateType);
                    assert importedType.is(templateType.getSuperType());
                }
                templateTypes.pushBack(templateType);
            }
            entryType = entryType.getWithTemplateTypes(templateTypes);
        }

        // Reject usage with a wrong number of template type arguments (including none, if some are required)
        if templateTypes.getSize() != requiredTemplateTypeCount {
            String kind = String("Union");
            if entryType.is(SuperType::TY_STRUCT) {
                kind = String("Struct");
            } else if entryType.is(SuperType::TY_INTERFACE) {
                kind = String("Interface");
            }
            const String errorMessage = kind + " '" + node.fqTypeName + "' requires " + toString(requiredTemplateTypeCount) + " template type argument(s), but got " + toString(templateTypes.getSize());
            return this.softErrorQT(baseNode, SemanticErrorType::INVALID_TEMPLATE_TYPES, errorMessage);
        }

        // Check if struct is defined before the current code location, if defined in the same source file. Across files
        // (e.g. circular imports) the order does not matter, so the check only applies within the same source file.
        const CodeLoc& declCodeLoc = entry.declNode.codeLoc;
        const CodeLoc& codeLoc = node.codeLoc;
        if String(declCodeLoc.sourceFilePath) == String(codeLoc.sourceFilePath) && declCodeLoc.isAfter(codeLoc) {
            if entryType.is(SuperType::TY_STRUCT) {
                return this.softErrorQT(baseNode, SemanticErrorType::REFERENCED_UNDEFINED_STRUCT, String("Structs must be defined before usage"));
            }
            if entryType.is(SuperType::TY_INTERFACE) {
                return this.softErrorQT(baseNode, SemanticErrorType::REFERENCED_UNDEFINED_INTERFACE, String("Interfaces must be defined before usage"));
            }
            if entryType.is(SuperType::TY_UNION) {
                return this.softErrorQT(baseNode, SemanticErrorType::REFERENCED_UNDEFINED_UNION, String("Unions must be defined before usage"));
            }
            assert false; // Unexpected entry type
        }

        if allTemplateTypesConcrete { // Only do the next step, if we have concrete template types
            // Set the struct/interface/union instance to used, if found
            // Here, it is allowed to accept, that the struct/interface/union cannot be found, because there are
            // self-referencing ones
            const String& typeName = node.typeNameFragments.back();
            if entryType.is(SuperType::TY_STRUCT) {
                const Struct* spiceStruct = matchStruct(defScope, typeName, templateTypes, baseNode);
                if spiceStruct != nil<const Struct*> {
                    entryType = entryType.getWithBodyScope(spiceStruct.scope);
                }
            } else if entryType.is(SuperType::TY_INTERFACE) {
                const Interface* spiceInterface = matchInterface(defScope, typeName, templateTypes, baseNode);
                if spiceInterface != nil<const Interface*> {
                    entryType = entryType.getWithBodyScope(spiceInterface.scope);
                }
            } else {
                assert entryType.is(SuperType::TY_UNION);
                const Union* spiceUnion = matchUnion(defScope, typeName, templateTypes, baseNode);
                if spiceUnion != nil<const Union*> {
                    entryType = entryType.getWithBodyScope(spiceUnion.scope);
                }
            }
        }

        return Any(node.node.setEvaluatedSymbolType(entryType, this.manIdx));
    }

    if entryType.is(SuperType::TY_ALIAS) {
        const QualType aliasedType = entryType.getAliased(entry);
        return Any(node.node.setEvaluatedSymbolType(aliasedType, this.manIdx));
    }

    // We tried everything to resolve it, but this type is still unknown
    if entryType.is(SuperType::TY_INVALID) {
        return this.softErrorQT(baseNode, SemanticErrorType::EXPECTED_TYPE, String("Used type before declared"));
    }
    return this.softErrorQT(baseNode, SemanticErrorType::EXPECTED_TYPE, "Expected type, but got " + entryType.getName());
}

public f<Any> TypeChecker.visitFunctionDataType(ASTFunctionDataTypeNode* node) {
    // Visit return type
    QualType returnType = QualType(SuperType::TY_DYN);
    if node.isFunction {
        returnType = this.getDataType(node.returnType);
        if returnType.is(SuperType::TY_UNRESOLVED) {
            return Any(returnType);
        }
        if returnType.is(SuperType::TY_DYN) {
            // Note: The host returns an ExprResult here (SOFT_ERROR_ER), but the callers expect a type
            return this.softErrorQT(cast<ASTNode*>(node.returnType), SemanticErrorType::UNEXPECTED_DYN_TYPE, String("Function types cannot have return type dyn"));
        }
    }

    // Visit param types
    QualTypeList paramTypes;
    if node.paramTypeLst != nil<ASTTypeLstNode*> {
        foreach ASTDataTypeNode* paramTypeNode : node.paramTypeLst.dataTypes {
            const QualType paramType = this.getDataType(paramTypeNode);
            if paramType.is(SuperType::TY_UNRESOLVED) {
                return Any(paramType);
            }
            paramTypes.pushBack(paramType);
        }
    }

    // Build function type
    const SuperType superType = node.isFunction ? SuperType::TY_FUNCTION : SuperType::TY_PROCEDURE;
    const QualType functionTypeBase = QualType(superType);
    const QualType functionType = functionTypeBase.getWithFunctionParamAndReturnTypes(returnType, paramTypes);

    return Any(node.node.setEvaluatedSymbolType(functionType, this.manIdx));
}

// ============================================================ TypeCheckerStatements.cpp =========================================

public f<Any> TypeChecker.visitStmtLst(ASTStmtLstNode* node) {
    // Visit nodes in this scope
    foreach IVisitable* stmt : node.statements {
        if stmt == nil<IVisitable*> {
            continue;
        }
        // Print warning if statement is unreachable
        ASTStmtNode* stmtNode = asStmtNode(getASTNode(stmt));
        if stmtNode.unreachable {
            this.addWarning(stmtNode.codeLoc, CompilerWarningType::UNREACHABLE_CODE, String("This statement is unreachable"));
            continue;
        }
        // Visit the statement
        this.visit(stmt);
    }

    // Do cleanup of this scope, e.g. dtor calls for struct instances
    this.doScopeCleanup(node);

    return Any();
}

public f<Any> TypeChecker.visitDeclStmt(ASTDeclStmtNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Retrieve entry of the lhs variable
    SymbolTableEntry* localVarEntry = this.currentScope.lookupStrict(node.varName);
    assert localVarEntry != nil<SymbolTableEntry*>;

    QualType localVarType = QualType(SuperType::TY_INVALID);
    if node.hasAssignment {
        // Visit the right side
        const ExprResult rhs = this.visitExpr(node.assignExpr);
        const QualType rhsTy = rhs.ty;
        SymbolTableEntry* rhsEntry = rhs.entry;

        // Capture anonymous info up front: getAssignResultType may delete the anonymous entry (temp stealing
        // in performStructAssign), turning rhsEntry into a dangling pointer.
        const bool rhsIsAnonymous = rhsEntry != nil<SymbolTableEntry*> && rhsEntry.anonymous;
        String rhsEntryName = String("");
        if rhsIsAnonymous {
            rhsEntryName = rhsEntry.name;
        }

        // Visit data type
        localVarType = this.getDataType(node.dataType);

        // Check if type has to be inferred or both types are fixed
        if !localVarType.is(SuperType::TY_UNRESOLVED) && !rhsTy.is(SuperType::TY_UNRESOLVED) {
            const ExprResult lhsResult = ExprResult{localVarType, localVarEntry};
            Pair<QualType, Function*> assignResult = this.opRuleManager.getAssignResultType(baseNode, lhsResult, rhs, true);
            localVarType = assignResult.getFirst();
            node.calledCopyCtor = assignResult.getSecond();

            // If this is a struct type, check if the type is known. If not, error out. A type that already carries a
            // body scope is genuinely resolved (e.g. it reached here through a generic substantiation or a deep
            // transitive import); only its unqualified name happens to be absent from this file's name registry, which
            // is not an error.
            if localVarType.isBase(SuperType::TY_STRUCT) {
                const QualType localVarBaseType = localVarType.getBase();
                const String structName = localVarBaseType.getSubType();
                if this.sourceFile.getNameRegistryEntry(structName) == nil<const NameRegistryEntry*> && localVarBaseType.getBodyScope() == nil<Scope*> {
                    this.softError(cast<ASTNode*>(node.dataType), SemanticErrorType::UNKNOWN_DATATYPE, String("Unknown struct type '") + structName + "'. Forgot to import?");
                    localVarType = QualType(SuperType::TY_UNRESOLVED);
                }
            }
        } else {
            localVarType = QualType(SuperType::TY_UNRESOLVED);
        }

        // If there is an anonymous entry attached (e.g. for struct instantiation) and we take over ownership, delete it.
        // Safe to call even if performStructAssign already deleted it: erasing by key is a no-op when absent.
        if !localVarType.isRef() && rhsIsAnonymous {
            this.currentScope.symbolTable.deleteAnonymous(rhsEntryName);
        }
    } else {
        // Visit data type
        localVarType = this.getDataType(node.dataType);

        // References with no initialization are illegal
        if localVarType.isRef() && !node.isFctParam && !node.isForEachItem {
            this.softError(baseNode, SemanticErrorType::REFERENCE_WITHOUT_INITIALIZER, String("References must always be initialized directly"));
        }

        // If this is a struct, check for the default ctor
        if localVarType.is(SuperType::TY_STRUCT) && !node.isFctParam && !node.isForEachItem {
            Scope* matchScope = localVarType.getBodyScope();
            assert matchScope != nil<Scope*>;
            // Check if we are required to call a ctor
            node.isCtorCallRequired = !localVarType.isTriviallyConstructible(baseNode);
            // Check if we have a no-args ctor to call
            const QualType& thisType = localVarType;
            const ArgList noArgs;
            const QualTypeList noTemplateTypeHints;
            node.calledInitCtor = matchFunction(matchScope, String(CTOR_FUNCTION_NAME), thisType, noArgs, noTemplateTypeHints, false, baseNode);
            if node.calledInitCtor == nil<Function*> && node.isCtorCallRequired {
                const String& structName = localVarType.getSubType();
                return this.softErrorQT(baseNode, SemanticErrorType::NO_MATCHING_CTOR_FOUND, "Struct '" + structName + "' is not trivially constructible and has no no-args constructor.");
            }
        }
    }

    // Update the type of the variable
    localVarEntry.updateType(localVarType, true);
    SymbolTableEntry*& entrySlot = node.entries.get(this.manIdx);
    entrySlot = localVarEntry;

    // Update the state of the variable
    localVarEntry.updateState(LifecycleState::INITIALIZED, baseNode);

    return Any(localVarType);
}

public f<Any> TypeChecker.visitReturnStmt(ASTReturnStmtNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Retrieve return variable entry
    SymbolTableEntry* returnVar = this.currentScope.lookup(String(RETURN_VARIABLE_NAME));
    const bool isFunction = returnVar != nil<SymbolTableEntry*>;
    QualType returnType = QualType(SuperType::TY_DYN);
    if isFunction {
        returnType = returnVar.getQualType();
    }

    // Check if procedure with return value
    if !isFunction {
        if node.hasReturnValue {
            return this.softErrorER(getASTNode(node.assignExpr), SemanticErrorType::RETURN_WITH_VALUE_IN_PROCEDURE, String("Return with value in procedure is not allowed"));
        }
        return Any();
    }

    if !node.hasReturnValue && !returnVar.isInitialized() {
        return this.softErrorQT(baseNode, SemanticErrorType::RETURN_WITHOUT_VALUE_RESULT, String("Return without value, but result variable is not initialized yet"));
    }

    if !node.hasReturnValue {
        return Any();
    }

    // Visit right side
    const ExprResult rhs = this.visitExpr(node.assignExpr);
    if rhs.ty.is(SuperType::TY_UNRESOLVED) { return Any(rhs.ty); }

    // A native lambda stores its captures in this frame, so returning a capturing lambda would let it outlive its
    // captures. Direct the user to the owning std Lambda wrapper. Non-capturing lambdas (plain function pointers)
    // are safe to return. The std Lambda wrapper hands its captures-flagged lambda back from get(), so std is exempt.
    const QualType rhsBaseType = rhs.ty.getBase();
    const dyn fctOptions = [SuperType::TY_FUNCTION, SuperType::TY_PROCEDURE];
    if rhsBaseType.isOneOf(fctOptions, len(fctOptions)) && rhs.ty.hasLambdaCaptures() && !this.sourceFile.isStdFile {
        const QualType nonCapturingType = rhsBaseType.getWithLambdaCaptures(false);
        const String message = String("A capturing lambda cannot be returned, because its captures live in this frame and would dangle. Wrap it in 'Lambda<") + nonCapturingType.getName(false) + ">' from std/type/lambda instead.";
        return this.softErrorER(getASTNode(node.assignExpr), SemanticErrorType::LAMBDA_CAPTURE_ESCAPE, message);
    }

    // Capture anonymous info up front: getAssignResultType may delete the anonymous entry (temp stealing
    // in performStructAssign), turning rhs.entry into a dangling pointer.
    SymbolTableEntry* rhsEntry = rhs.entry;
    const bool rhsIsAnonymous = rhsEntry != nil<SymbolTableEntry*> && rhsEntry.anonymous;
    String rhsEntryName = String("");
    if rhsIsAnonymous {
        rhsEntryName = rhsEntry.name;
    }
    const bool rhsIsOptimizable = this.isReturnValueOptimizable(rhs);

    // Check if types match
    const ExprResult returnResult = ExprResult{returnType, returnVar};
    Pair<QualType, Function*> assignResult = this.opRuleManager.getAssignResultType(getASTNode(node.assignExpr), returnResult, rhs, false, true, ERROR_MSG_RETURN);
    node.calledCopyCtor = assignResult.getSecond();

    // Check if the dtor call on the return value can be skipped
    SymbolTableEntry*& returnedLocal = node.returnedLocals.get(this.manIdx);
    returnedLocal = nil<SymbolTableEntry*>;
    if rhsEntry != nil<SymbolTableEntry*> {
        if rhsIsAnonymous {
            // If there is an anonymous entry attached (e.g. for struct instantiation), delete it.
            // Safe even if performStructAssign already deleted it: erasing by key is a no-op when absent.
            this.currentScope.symbolTable.deleteAnonymous(rhsEntryName);
        } else if rhsIsOptimizable {
            // Otherwise omit the destructor call of the local variable on the path of this return statement, because the caller
            // destructs the value. Other paths out of the scope of the variable (e.g. other returns) still have to destruct it.
            returnedLocal = rhsEntry;
        }
    }

    node.returnType = returnType;
    return Any(returnType);
}

public f<Any> TypeChecker.visitBreakStmt(ASTBreakStmtNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Check if the stated number is valid
    if node.breakTimes < 1 {
        return this.softErrorER(baseNode, SemanticErrorType::INVALID_BREAK_NUMBER, String("Break count must be >= 1, you provided ") + toString(node.breakTimes));
    }

    // Check if we can break this often
    const unsigned int maxBreaks = this.currentScope.getLoopNestingDepth();
    if cast<unsigned int>(node.breakTimes) > maxBreaks {
        return this.softErrorER(baseNode, SemanticErrorType::INVALID_BREAK_NUMBER, String("We can only break ") + toString(cast<long>(maxBreaks)) + " time(s) here");
    }

    return Any();
}

public f<Any> TypeChecker.visitContinueStmt(ASTContinueStmtNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Check if the stated number is valid
    if node.continueTimes < 1 {
        return this.softErrorER(baseNode, SemanticErrorType::INVALID_CONTINUE_NUMBER, String("Continue count must be >= 1, you provided ") + toString(node.continueTimes));
    }

    // Check if we can continue this often
    const unsigned int maxContinues = this.currentScope.getLoopNestingDepth();
    if cast<unsigned int>(node.continueTimes) > maxContinues {
        return this.softErrorER(baseNode, SemanticErrorType::INVALID_CONTINUE_NUMBER, String("We can only continue ") + toString(cast<long>(maxContinues)) + " time(s) here");
    }

    return Any();
}

public f<Any> TypeChecker.visitFallthroughStmt(ASTFallthroughStmtNode* node) {
    // Check if we can do a fallthrough here
    if !this.currentScope.isInCaseBranch() {
        return this.softErrorER(cast<ASTNode*>(node), SemanticErrorType::FALLTHROUGH_NOT_ALLOWED, String("Fallthrough is only allowed in case branches"));
    }

    return Any();
}

public f<Any> TypeChecker.visitAssertStmt(ASTAssertStmtNode* node) {
    // Visit condition
    const ExprResult condition = this.visitExpr(node.assignExpr);
    const QualType conditionType = condition.ty;
    if conditionType.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }

    // Check if condition evaluates to bool
    if !conditionType.is(SuperType::TY_BOOL) {
        return this.softErrorER(getASTNode(node.assignExpr), SemanticErrorType::ASSERTION_CONDITION_BOOL, String("The asserted condition must be of type bool"));
    }

    // A failed assertion prints the stack trace, so the runtime that does that has to be loaded. Assertions are not
    // generated in release builds, so nothing needs to be loaded for them there
    if this.cliOptions.printsStackTraceOnAbort() && this.cliOptions.buildMode != BuildMode::RELEASE && !this.sourceFile.isRT(RuntimeModule::STACK_TRACE_RT) {
        this.sourceFile.requestRuntimeModule(RuntimeModule::STACK_TRACE_RT);
    }

    return Any();
}

// ======================================================= TypeCheckerControlStructures.cpp ========================================

public f<Any> TypeChecker.visitUnsafeBlock(ASTUnsafeBlockNode* node) {
    // Change to unsafe block body scope
    ScopeHandle _ = ScopeHandle(&this.compilerPass, node.getScopeId(), ScopeType::UNSAFE_BODY);

    // Visit body
    this.visit(node.body);

    return Any();
}

public f<Any> TypeChecker.visitForLoop(ASTForLoopNode* node) {
    // Change to for body scope
    ScopeHandle _ = ScopeHandle(&this.compilerPass, node.getScopeId(), ScopeType::FOR_BODY);

    // Visit loop variable declaration
    this.visit(node.initDecl);

    // Visit condition
    const ExprResult condition = this.visitInExprScope(node.condAssign);
    const QualType conditionType = condition.ty;
    if conditionType.is(SuperType::TY_UNRESOLVED) { return Any(); }
    // Check if condition evaluates to bool
    if !conditionType.is(SuperType::TY_BOOL) {
        return this.softErrorER(getASTNode(node.condAssign), SemanticErrorType::CONDITION_MUST_BE_BOOL, String("For loop condition must be of type bool"));
    }

    // Visit incrementer
    this.visit(node.incAssign);

    // Visit body
    this.visit(node.body);

    return Any();
}

public f<Any> TypeChecker.visitForeachLoop(ASTForeachLoopNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Visit iterator assignment
    IVisitable* iteratorNode = node.iteratorAssign;
    ASTNode* iteratorBaseNode = getASTNode(iteratorNode);
    const ExprResult iteratorResult = this.visitExpr(iteratorNode);
    QualType iteratorOrIterableType = iteratorResult.ty;
    if iteratorOrIterableType.is(SuperType::TY_UNRESOLVED) { return Any(); }
    iteratorOrIterableType = iteratorOrIterableType.removeReferenceWrapper();

    // Retrieve iterator type
    QualType iteratorType = iteratorOrIterableType;

    const ArgList noArgs;
    const QualTypeList noTemplateTypeHints;
    if iteratorOrIterableType.isIterable(baseNode) {
        const QualType& iterableType = iteratorOrIterableType;
        if iteratorOrIterableType.isArray() { // Array
            const NameRegistryEntry* nameRegistryEntry = this.sourceFile.getNameRegistryEntry(String(ARRAY_ITERATOR_NAME));
            if nameRegistryEntry == nil<const NameRegistryEntry*> {
                this.softError(baseNode, SemanticErrorType::UNKNOWN_DATATYPE, String("Forgot to import \"std/iterator/array-iterator\"?"));
                return Any();
            }
            nameRegistryEntry.targetEntry.used = true;
            nameRegistryEntry.importEntry.used = true;
            Scope* arrayIteratorScope = nameRegistryEntry.targetScope;
            Scope* matchScope = arrayIteratorScope.parent;
            assert matchScope.scopeType == ScopeType::GLOBAL;
            QualType unsignedLongType = QualType(SuperType::TY_LONG);
            unsignedLongType.makeUnsigned(true);
            ArgList argTypes;
            argTypes.pushBack(Pair<QualType, bool>(iterableType, false));
            argTypes.pushBack(Pair<QualType, bool>(unsignedLongType, false));
            const QualType thisType = QualType(SuperType::TY_DYN);
            node.getIteratorFct = matchFunction(matchScope, String("iterate"), thisType, argTypes, noTemplateTypeHints, true, iteratorBaseNode);
        } else { // Struct, implementing Iterator interface
            Scope* matchScope = iterableType.getBodyScope();
            node.getIteratorFct = matchFunction(matchScope, String("getIterator"), iterableType, noArgs, noTemplateTypeHints, true, iteratorBaseNode);
        }
        if node.getIteratorFct == nil<Function*> {
            // The host throws a SemanticError here
            throwSemanticError(iteratorBaseNode, SemanticErrorType::INVALID_ITERATOR, String("No getIterator() function found for the given iterable type"));
            return Any();
        }

        const Function* getIteratorFct = node.getIteratorFct;
        iteratorType = getIteratorFct.returnType;
        // Add anonymous symbol to keep track of dtor call, if non-trivially destructible
        if !iteratorType.isTriviallyDestructible(iteratorBaseNode) {
            this.currentScope.symbolTable.insertAnonymous(iteratorType, iteratorBaseNode);
        }
    }

    // Change to foreach body scope
    ScopeHandle _ = ScopeHandle(&this.compilerPass, node.getScopeId(), ScopeType::FOREACH_BODY);

    // Check iterator type
    if !iteratorType.isIterator(baseNode) {
        const String errMsg = String("Can only iterate over arrays or data structures, inheriting from IIterator or IIterable. You provided ") + iteratorType.getName(false, true);
        this.softError(getASTNode(node.iteratorAssign), SemanticErrorType::OPERATOR_WRONG_DATA_TYPE, errMsg);
        return Any();
    }
    const QualTypeList iteratorTemplateTypes = iteratorType.getTemplateTypes();
    if iteratorTemplateTypes.isEmpty() {
        return this.softErrorER(getASTNode(node.iteratorAssign), SemanticErrorType::INVALID_ITERATOR, String("Iterator has no generic arguments so that the item type could not be inferred"));
    }

    const bool hasIdx = node.idxVarDecl != nil<IVisitable*>;
    if hasIdx {
        // Visit index declaration or assignment
        const QualType indexType = this.visitType(node.idxVarDecl);
        if indexType.is(SuperType::TY_UNRESOLVED) { return Any(); }
        // Check if index type is int
        if !indexType.is(SuperType::TY_LONG) {
            const String message = String("Index in foreach loop must be of type long. You provided ") + indexType.getName(false);
            return this.softErrorER(getASTNode(node.idxVarDecl), SemanticErrorType::FOREACH_IDX_NOT_LONG, message);
        }
    }

    // Retrieve .get(), .getIdx(), .isValid() and .next() functions
    Scope* matchScope = iteratorType.getBodyScope();
    QualType iteratorItemType = QualType(SuperType::TY_INVALID);
    if hasIdx {
        node.getIdxFct = matchFunction(matchScope, String("getIdx"), iteratorType, noArgs, noTemplateTypeHints, false, baseNode);
        if node.getIdxFct == nil<Function*> { return Any(); }
        const Function* getIdxFct = node.getIdxFct;
        const QualTypeList idxTemplateTypes = getIdxFct.returnType.getTemplateTypes();
        iteratorItemType = idxTemplateTypes.back();
    } else {
        node.getFct = matchFunction(matchScope, String("get"), iteratorType, noArgs, noTemplateTypeHints, false, baseNode);
        if node.getFct == nil<Function*> { return Any(); }
        const Function* getFct = node.getFct;
        iteratorItemType = getFct.returnType;
    }
    node.isValidFct = matchFunction(matchScope, String("isValid"), iteratorType, noArgs, noTemplateTypeHints, false, baseNode);
    if node.isValidFct == nil<Function*> { return Any(); }
    node.nextFct = matchFunction(matchScope, String("next"), iteratorType, noArgs, noTemplateTypeHints, false, baseNode);
    if node.nextFct == nil<Function*> { return Any(); }

    // Retrieve item variable entry
    ASTDeclStmtNode* itemVarDecl = downcast<ASTDeclStmtNode>(node.itemVarDecl);
    SymbolTableEntry* itemVarSymbol = this.currentScope.lookupStrict(itemVarDecl.varName);
    assert itemVarSymbol != nil<SymbolTableEntry*>;

    // Check type of the item
    QualType itemType = this.visitType(node.itemVarDecl);
    if itemType.is(SuperType::TY_UNRESOLVED) { return Any(); }
    if itemType.is(SuperType::TY_DYN) { // Perform type inference
        // Update evaluated symbol type of the declaration data type
        itemVarDecl.dataType.node.setEvaluatedSymbolType(iteratorItemType, this.manIdx);
        // Update item type
        itemType = iteratorItemType;
    }

    // Check result type. This is important, also for copy ctor calls, etc.
    const ExprResult itemResult = ExprResult{itemType, itemVarSymbol};
    const ExprResult iteratorItemResult = ExprResult{iteratorItemType, nil<SymbolTableEntry*> /* always a temporary */};
    Pair<QualType, Function*> assignResult = this.opRuleManager.getAssignResultType(cast<ASTNode*>(itemVarDecl), itemResult, iteratorItemResult, true, false, ERROR_FOREACH_ITEM);
    node.calledItemCopyCtor = assignResult.getSecond();

    // Update type of item
    itemVarSymbol.updateType(itemType, true);

    // Visit body
    this.visit(node.body);

    return Any();
}

public f<Any> TypeChecker.visitWhileLoop(ASTWhileLoopNode* node) {
    // Change to while body scope
    ScopeHandle _ = ScopeHandle(&this.compilerPass, node.getScopeId(), ScopeType::WHILE_BODY);

    // Visit condition
    const ExprResult condition = this.visitInExprScope(node.condition);
    const QualType conditionType = condition.ty;
    if conditionType.is(SuperType::TY_UNRESOLVED) { return Any(); }
    // Check if condition evaluates to bool
    if !conditionType.is(SuperType::TY_BOOL) {
        return this.softErrorER(getASTNode(node.condition), SemanticErrorType::CONDITION_MUST_BE_BOOL, String("While loop condition must be of type bool"));
    }

    // Visit body
    this.visit(node.body);

    return Any();
}

public f<Any> TypeChecker.visitDoWhileLoop(ASTDoWhileLoopNode* node) {
    // Change to while body scope
    ScopeHandle _ = ScopeHandle(&this.compilerPass, node.getScopeId(), ScopeType::WHILE_BODY);

    // Visit body
    this.visit(node.body);

    // Visit condition
    const ExprResult condition = this.visitInExprScope(node.condition);
    const QualType conditionType = condition.ty;
    if conditionType.is(SuperType::TY_UNRESOLVED) { return Any(); }
    // Check if condition evaluates to bool
    if !conditionType.is(SuperType::TY_BOOL) {
        return this.softErrorER(getASTNode(node.condition), SemanticErrorType::CONDITION_MUST_BE_BOOL, String("Do-While loop condition must be of type bool"));
    }

    return Any();
}

public f<Any> TypeChecker.visitIfStmt(ASTIfStmtNode* node) {
    // Change to then body scope
    ScopeHandle scopeHandle = ScopeHandle(&this.compilerPass, node.getScopeId(), ScopeType::IF_ELSE_BODY);

    // Visit condition
    const ExprResult condition = this.visitInExprScope(node.condition);
    const QualType conditionType = condition.ty;
    if conditionType.is(SuperType::TY_UNRESOLVED) { return Any(); }
    // Check if condition evaluates to bool
    ASTNode* conditionNode = getASTNode(node.condition);
    if !conditionType.is(SuperType::TY_BOOL) {
        return this.softErrorER(conditionNode, SemanticErrorType::CONDITION_MUST_BE_BOOL, String("If condition must be of type bool"));
    }

    // Warning for bool assignment
    if conditionNode.kind == ASTNodeKind::ASSIGN_EXPR {
        ASTAssignExprNode* assignExprNode = downcast<ASTAssignExprNode>(conditionNode);
        if assignExprNode.op == AssignOp::OP_ASSIGN {
            this.addWarning(conditionNode.codeLoc, CompilerWarningType::BOOL_ASSIGN_AS_CONDITION, String("If you want to compare the values, use '=='"));
        }
    }

    // Update the information, if one of the branches should be skipped.
    // This is important to check again here, because the constness of the condition can have changed after type checking.
    const bool constantCondition = conditionNode.hasCompileTimeValue(this.manIdx);
    bool compileThenBranch = true;
    bool compileElseBranch = true;
    if constantCondition {
        const CompileTimeValue compileTimeValue = conditionNode.getCompileTimeValue(this.manIdx);
        compileThenBranch = compileTimeValue.getBoolValue();
        compileElseBranch = !compileTimeValue.getBoolValue();
    }
    bool& compileThenBranchSlot = node.compileThenBranch.get(this.manIdx);
    compileThenBranchSlot = compileThenBranch;
    bool& compileElseBranchSlot = node.compileElseBranch.get(this.manIdx);
    compileElseBranchSlot = compileElseBranch;

    // Visit body
    if compileThenBranch {
        this.visit(node.thenBody);
    }

    // Leave then body scope
    scopeHandle.leaveScopeEarly();

    // Visit else statement if existing
    if compileElseBranch && node.elseStmt != nil<IVisitable*> {
        this.visit(node.elseStmt);
    }

    return Any();
}

public f<Any> TypeChecker.visitElseStmt(ASTElseStmtNode* node) {
    // Visit if statement in the case of an else if branch
    if node.isElseIf {
        this.visit(node.ifStmt);
        return Any();
    }

    // Change to else body scope
    ScopeHandle _ = ScopeHandle(&this.compilerPass, node.getScopeId(), ScopeType::IF_ELSE_BODY);

    // Visit body
    this.visit(node.body);

    return Any();
}

public f<Any> TypeChecker.visitSwitchStmt(ASTSwitchStmtNode* node) {
    // Check expression type
    const ExprResult switchExpr = this.visitExpr(node.assignExpr);
    const QualType exprType = switchExpr.ty;
    if exprType.is(SuperType::TY_UNRESOLVED) { return Any(); }
    const dyn switchOptions = [SuperType::TY_INT, SuperType::TY_SHORT, SuperType::TY_LONG, SuperType::TY_BYTE, SuperType::TY_CHAR, SuperType::TY_BOOL];
    if !exprType.isOneOf(switchOptions, len(switchOptions)) {
        return this.softErrorER(getASTNode(node.assignExpr), SemanticErrorType::SWITCH_EXPR_MUST_BE_PRIMITIVE, String("Switch expression must be of int, short, long, byte, char or bool type"));
    }

    // Visit children
    this.visitChildren(cast<ASTNode*>(node));

    // Check if case constant types match switch expression type
    foreach IVisitable* caseBranch : node.caseBranches {
        ASTCaseBranchNode* caseBranchNode = downcast<ASTCaseBranchNode>(caseBranch);
        foreach IVisitable* constantNode : caseBranchNode.caseConstants {
            const ExprResult constantResult = this.visitExpr(constantNode);
            const QualType constantType = constantResult.ty;
            if !constantType.matches(exprType, false, true, true) {
                return this.softErrorER(getASTNode(constantNode), SemanticErrorType::SWITCH_CASE_TYPE_MISMATCH, String("Case value type does not match the switch expression type"));
            }
        }
    }

    return Any();
}

public f<Any> TypeChecker.visitCaseBranch(ASTCaseBranchNode* node) {
    // Change to case body scope
    ScopeHandle _ = ScopeHandle(&this.compilerPass, node.getScopeId(), ScopeType::CASE_BODY);

    // Visit constant list
    foreach IVisitable* constant : node.caseConstants {
        this.visit(constant);
    }

    // Visit body
    this.visit(node.body);

    return Any();
}

public f<Any> TypeChecker.visitCaseConstant(ASTCaseConstantNode* node) {
    // If we have a normal constant, we can take the symbol type from there
    if node.constant != nil<ASTConstantNode*> {
        return this.visitConstant(node.constant);
    }
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Check if a local or global variable can be found by searching for the name
    if node.identifierFragments.getSize() == 1l {
        node.entry = this.currentScope.lookup(node.identifierFragments.back());
    }

    // If no local or global was found, search in the name registry
    if node.entry == nil<const SymbolTableEntry*> {
        const NameRegistryEntry* registryEntry = this.sourceFile.getNameRegistryEntry(node.fqIdentifier);
        if registryEntry == nil<const NameRegistryEntry*> {
            if this.sourceFile.isAmbiguousName(node.fqIdentifier) {
                return this.softErrorER(baseNode, SemanticErrorType::AMBIGUOUS_SYMBOL, this.sourceFile.getAmbiguousNameMessage(node.fqIdentifier));
            }
            const String message = String("The variable '") + node.fqIdentifier + "' could not be found";
            return this.softErrorER(baseNode, SemanticErrorType::REFERENCED_UNDEFINED_VARIABLE, message);
        }
        node.entry = registryEntry.targetEntry;
    }
    assert node.entry != nil<const SymbolTableEntry*>;

    // Check for the correct type
    const QualType qualType = node.entry.getQualType();
    const dyn caseConstantOptions = [SuperType::TY_INT, SuperType::TY_SHORT, SuperType::TY_LONG, SuperType::TY_BYTE, SuperType::TY_CHAR, SuperType::TY_BOOL];
    if !qualType.isOneOf(caseConstantOptions, len(caseConstantOptions)) {
        return this.softErrorER(baseNode, SemanticErrorType::CASE_CONSTANT_INVALID_TYPE, String("Case constants must be of type int, short, long, byte, char, bool or enum"));
    }

    return Any(ExprResult{node.node.setEvaluatedSymbolType(qualType, this.manIdx), nil<SymbolTableEntry*>});
}

public f<Any> TypeChecker.visitDefaultBranch(ASTDefaultBranchNode* node) {
    // Change to default body scope
    ScopeHandle _ = ScopeHandle(&this.compilerPass, node.getScopeId(), ScopeType::DEFAULT_BODY);

    // Visit body
    this.visit(node.body);

    return Any();
}

public f<Any> TypeChecker.visitAnonymousBlockStmt(ASTAnonymousBlockStmtNode* node) {
    // Change to anonymous scope body scope
    ScopeHandle _ = ScopeHandle(&this.compilerPass, node.getScopeId(), ScopeType::ANONYMOUS_BLOCK_BODY);

    // Visit body
    this.visit(node.body);

    return Any();
}

// ========================================================== TypeCheckerExpressions.cpp ==========================================

/**
 * Check if a temporary struct is moved into the lhs of an assignment (temp stealing) and the old value of the lhs can
 * safely be destructed before it gets overwritten.
 *
 * @param node Assign expression node
 * @param rhsType Type of the right side of the assignment
 * @param isRhsTemporary Whether the right side of the assignment is a temporary
 * @return Destructible temp steal target or not
 */
f<bool> TypeChecker.isDestructibleTempStealTarget(ASTAssignExprNode* node, const QualType& rhsType, bool isRhsTemporary) {
    // The rhs must be a temporary struct value, that is moved into the lhs, and no assign operator overload may take over
    if rhsType.isRef() || !rhsType.is(SuperType::TY_STRUCT) || !isRhsTemporary {
        return false;
    }
    const Vector<const Function*>& opFcts = this.getOpFctPointers(cast<ASTNode*>(node));
    if opFcts.front() != nil<const Function*> {
        return false;
    }
    // The initialization state of the lhs entry does not tell, whether the overwritten value was actually constructed at
    // runtime (e.g. for '*ptr = ...', 'array[i] = ...' or 'result.field = ...'), so check the lhs expression itself
    return this.isAlwaysConstructedLvalue(getASTNode(node.lhs));
}

/**
 * Check if the value, that an lvalue expression denotes, has always been constructed at runtime, when it is accessed.
 * This is the case for variables (except the result variable) and chains of field accesses on them or on 'this', as long
 * as each involved struct value is referenced or its struct has a no-args ctor. Values of structs with a no-args ctor are
 * always constructed before they can be accessed: locals at their declaration and fields in the ctor preamble. Values of
 * other structs might still be uninitialized memory, e.g. fields of such a struct type in a ctor body.
 *
 * @param node Lvalue expression
 * @return Always constructed or not
 */
f<bool> TypeChecker.isAlwaysConstructedLvalue(ASTNode* node) {
    // Check the accessed value itself
    ASTExprNode* exprNode = asExprNode(node);
    const QualType lvalueType = exprNode.getEvaluatedSymbolType(this.manIdx);
    ASTAtomicExprNode* atomicExpr = nil<ASTAtomicExprNode*>;
    if node.kind == ASTNodeKind::ATOMIC_EXPR {
        atomicExpr = downcast<ASTAtomicExprNode>(node);
    }
    const bool isThis = atomicExpr != nil<ASTAtomicExprNode*> && atomicExpr.fqIdentifier == THIS_VARIABLE_NAME;
    if !isThis && !lvalueType.isRef() {
        if !lvalueType.is(SuperType::TY_STRUCT) {
            return false;
        }
        const QualType structType = lvalueType.toNonConst();
        const ArgList noArgs;
        if lookupFunction(structType.getBodyScope(), String(CTOR_FUNCTION_NAME), structType, noArgs, false) == nil<const Function*> {
            return false;
        }
    }

    // Variables are constructed, except the result variable, which is only constructed by assigning it
    if atomicExpr != nil<ASTAtomicExprNode*> {
        return atomicExpr.fqIdentifier != RETURN_VARIABLE_NAME;
    }

    // Fields are constructed, if the value they are accessed on is constructed
    if node.kind != ASTNodeKind::POSTFIX_UNARY_EXPR {
        return false;
    }
    ASTPostfixUnaryExprNode* postfixUnaryExpr = downcast<ASTPostfixUnaryExprNode>(node);
    if postfixUnaryExpr.op != PostfixUnaryOp::OP_MEMBER_ACCESS {
        return false;
    }
    return this.isAlwaysConstructedLvalue(getASTNode(postfixUnaryExpr.postfixUnaryExpr));
}

/**
 * Check if the value of a return statement can be returned without copying it (RVO). This is only the case for local
 * variables of the current function/procedure/lambda, because their dtor call can be omitted and the caller takes over
 * the ownership. Fields, globals, captured variables and values that are reached through a variable (e.g. by
 * dereferencing a pointer) are still owned by someone else, so they have to be copied.
 *
 * @param returnValue Value of the return statement
 * @return Return value optimizable or not
 */
public f<bool> TypeChecker.isReturnValueOptimizable(const ExprResult& returnValue) {
    // The return value must be a variable, not a temporary or a reference
    if returnValue.isTemporary() || returnValue.ty.isRef() {
        return false;
    }
    // The return value must be the variable itself, not a value that is reached through it
    const SymbolTableEntry* entry = returnValue.entry;
    const QualType entryType = entry.getQualType();
    if !entryType.matches(returnValue.ty, false, true, true) {
        return false;
    }
    // The variable must be declared in the current function/procedure/lambda
    const Scope* functionScope = this.currentScope.getFunctionScope();
    const Scope* scope = entry.scope;
    while scope != nil<const Scope*> {
        if scope.scopeType == ScopeType::FUNC_PROC_BODY || scope.scopeType == ScopeType::LAMBDA_BODY {
            return scope == functionScope;
        }
        scope = scope.parent;
    }
    return false;
}

public f<Any> TypeChecker.visitAssignExpr(ASTAssignExprNode* node) {
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Check if ternary
    if node.ternaryExpr != nil<IVisitable*> {
        const ExprResult ternaryResult = this.visitExpr(node.ternaryExpr);
        node.node.setEvaluatedSymbolType(ternaryResult.ty, this.manIdx);
        return Any(ternaryResult);
    }

    // Check if assignment
    if node.op == AssignOp::OP_NONE {
        panic(Error("AssignExpr fall-through")); // UNHANDLED_BRANCH compiler error in the host
    }

    // Visit the right side first
    const ExprResult rhs = this.visitExpr(node.rhs);
    QualType rhsType = rhs.ty;
    if rhsType.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }
    // Then visit the left side
    const ExprResult lhs = this.visitExpr(node.lhs);
    const QualType lhsType = lhs.ty;
    SymbolTableEntry* lhsVar = lhs.entry;
    if lhsType.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }

    // A native lambda stores its captures in the stack frame that created it. Storing a capturing lambda in a
    // struct field lets it outlive those captures, so the captures would dangle. Reject this and direct the user
    // to the owning std Lambda wrapper. Non-capturing lambdas (plain function pointers) are safe to store and are
    // not affected. The std Lambda wrapper itself stores the captures-flagged lambda in its own field, so std
    // files are exempt.
    if node.op == AssignOp::OP_ASSIGN && lhs.entry != nil<SymbolTableEntry*> && lhs.entry.isField() {
        const QualType rhsBaseType = rhsType.getBase();
        const dyn fctOptions = [SuperType::TY_FUNCTION, SuperType::TY_PROCEDURE];
        if rhsBaseType.isOneOf(fctOptions, len(fctOptions)) && rhsType.hasLambdaCaptures() && !this.sourceFile.isStdFile {
            const QualType nonCapturingType = rhsBaseType.getWithLambdaCaptures(false);
            const String typeName = nonCapturingType.getName(false);
            const String message = String("A capturing lambda cannot be stored in a field, because its captures live in the frame that created it and would dangle. Wrap it in 'Lambda<") + typeName + ">' from std/type/lambda instead.";
            return this.softErrorER(getASTNode(node.rhs), SemanticErrorType::LAMBDA_CAPTURE_ESCAPE, message);
        }
    }

    // Take a look at the operator
    if node.op == AssignOp::OP_ASSIGN {
        const bool isDecl = lhs.entry != nil<SymbolTableEntry*> && lhs.entry.isField() && !lhs.entry.isInitialized();
        // Save this before checking the assignment, because stealing a temporary deletes its anonymous symbol table entry
        const bool isRhsTemporary = rhs.isTemporary();
        Pair<QualType, Function*> assignResult = this.opRuleManager.getAssignResultType(baseNode, lhs, rhs, isDecl);
        rhsType = assignResult.getFirst();
        const Function* copyCtor = assignResult.getSecond();
        // If the assignment overwrites an already initialized struct, the old value of the lhs must be destructed first.
        // Otherwise its owning members (heap pointers, strings, ...) would leak. This applies when a new value is copied
        // into the lhs (non-null copy ctor) and when a temporary is moved into it (temp stealing).
        // 'isInitialized()' is false for declarations, uninitialized fields and moved-from values, so those are skipped.
        // Unsafe blocks are excluded on purpose: code that manually manages object lifetimes there (e.g. the raw
        // element shifts in container implementations) relies on assignments not implicitly destructing the lhs.
        if !isDecl && lhs.entry != nil<SymbolTableEntry*> && lhs.entry.isInitialized() && !this.currentScope.doesAllowUnsafeOperations() {
            const QualType lhsUnwrappedType = lhs.ty.removeReferenceWrapper();
            const QualType lhsSType = lhsUnwrappedType.toNonConst();
            if lhsSType.is(SuperType::TY_STRUCT) && !lhsSType.isTriviallyDestructible(baseNode) && (copyCtor != nil<const Function*> || this.isDestructibleTempStealTarget(node, rhs.ty, isRhsTemporary)) {
                const ArgList noArgs;
                const Function*& lhsDtorFct = node.lhsDtorFct.get(this.manIdx);
                lhsDtorFct = this.implicitlyCallStructMethod(lhsSType, String(DTOR_FUNCTION_NAME), noArgs, baseNode);
            }
        }
    } else if node.op == AssignOp::OP_PLUS_EQUAL {
        const ExprResult plusEqualResult = this.opRuleManager.getPlusEqualResultType(baseNode, lhs, rhs);
        rhsType = plusEqualResult.ty;
    } else if node.op == AssignOp::OP_MINUS_EQUAL {
        const ExprResult minusEqualResult = this.opRuleManager.getMinusEqualResultType(baseNode, lhs, rhs);
        rhsType = minusEqualResult.ty;
    } else if node.op == AssignOp::OP_MUL_EQUAL {
        const ExprResult mulEqualResult = this.opRuleManager.getMulEqualResultType(baseNode, lhs, rhs);
        rhsType = mulEqualResult.ty;
    } else if node.op == AssignOp::OP_DIV_EQUAL {
        const ExprResult divEqualResult = this.opRuleManager.getDivEqualResultType(baseNode, lhs, rhs);
        rhsType = divEqualResult.ty;
    } else if node.op == AssignOp::OP_REM_EQUAL {
        rhsType = this.opRuleManager.getRemEqualResultType(baseNode, lhs, rhs);
    } else if node.op == AssignOp::OP_SHL_EQUAL {
        rhsType = this.opRuleManager.getSHLEqualResultType(baseNode, lhs, rhs);
    } else if node.op == AssignOp::OP_SHR_EQUAL {
        rhsType = this.opRuleManager.getSHREqualResultType(baseNode, lhs, rhs);
    } else if node.op == AssignOp::OP_AND_EQUAL {
        rhsType = this.opRuleManager.getAndEqualResultType(baseNode, lhs, rhs);
    } else if node.op == AssignOp::OP_OR_EQUAL {
        rhsType = this.opRuleManager.getOrEqualResultType(baseNode, lhs, rhs);
    } else if node.op == AssignOp::OP_XOR_EQUAL {
        rhsType = this.opRuleManager.getXorEqualResultType(baseNode, lhs, rhs);
    }

    if lhsVar != nil<SymbolTableEntry*> { // Variable is involved on the left side
        // Perform type inference
        if lhsType.is(SuperType::TY_DYN) {
            lhsVar.updateType(rhsType, false);
        }

        // In case the lhs variable is captured, notify the capture about the write access
        Capture* lhsCapture = this.currentScope.symbolTable.lookupCapture(lhsVar.name);
        if lhsCapture != nil<Capture*> {
            lhsCapture.setAccessType(CaptureAccessType::READ_WRITE);
        }

        // Update the state of the variable
        lhsVar.updateState(LifecycleState::INITIALIZED, baseNode);
    }

    return Any(ExprResult{node.node.setEvaluatedSymbolType(rhsType, this.manIdx), nil<SymbolTableEntry*>});
}

public f<Any> TypeChecker.visitTernaryExpr(ASTTernaryExprNode* node) {
    // Check if there is a ternary operator applied
    if node.falseExpr == nil<IVisitable*> {
        return this.visit(node.condition);
    }
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Visit condition
    const ExprResult condition = this.visitExpr(node.condition);
    if condition.ty.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }
    // Visit the branches. Only one of them is evaluated, so each one has a scope of its own for its temporaries. The dtor calls for
    // those are considered further down, once it is clear which temporaries the result takes over.
    Pair<ExprResult, Scope*> trueBranch = Pair<ExprResult, Scope*>(condition, nil<Scope*>);
    if !node.isShortened {
        trueBranch = this.visitTernaryBranch(node.trueExpr);
    }
    const ExprResult trueExpr = trueBranch.getFirst();
    Scope* trueScope = trueBranch.getSecond();
    const QualType trueType = trueExpr.ty;
    SymbolTableEntry* trueEntry = trueExpr.entry;
    if trueType.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }
    Pair<ExprResult, Scope*> falseBranch = this.visitTernaryBranch(node.falseExpr);
    const ExprResult falseExpr = falseBranch.getFirst();
    Scope* falseScope = falseBranch.getSecond();
    const QualType falseType = falseExpr.ty;
    SymbolTableEntry* falseEntry = falseExpr.entry;
    if falseType.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }

    // Check if the condition evaluates to bool
    if !condition.ty.is(SuperType::TY_BOOL) {
        return this.softErrorER(getASTNode(node.condition), SemanticErrorType::OPERATOR_WRONG_DATA_TYPE, String("Condition operand in ternary must be a bool"));
    }

    // Check if trueType and falseType are matching
    const QualType trueTypeModified = trueType.removeReferenceWrapper();
    const QualType falseTypeModified = falseType.removeReferenceWrapper();
    if !trueTypeModified.matches(falseTypeModified, false, true, false) {
        const String message = String("True and false operands in ternary must be of same data type. Got ") + trueType.getName(true) + " and " + falseType.getName(true);
        return this.softErrorER(baseNode, SemanticErrorType::OPERATOR_WRONG_DATA_TYPE, message);
    }

    // An anonymous entry marks a temporary (e.g. a fresh struct instantiation or a non-trivial function-call
    // result), whose storage does not outlive this expression. The only exception is an anonymous entry of reference type. It
    // belongs to a nested ternary with a reference result, which just refers to the storage of one of its operands.
    const bool trueIsTemporary = isTemporaryTernaryOperand(trueEntry);
    const bool falseIsTemporary = isTemporaryTernaryOperand(falseEntry);

    // The result type must be a reference if one of true/false branch is of reference type. Otherwise,
    // the copy ctor is not called correctly. This can only be done if neither branch is a temporary though:
    // a temporary's storage ends with this expression, so the result must take a copy of it instead of
    // referencing it, or the copy ctor call for the temporary would end up being skipped further down,
    // leaking it.
    QualType resultType = trueTypeModified;
    // If both branches are lvalues, the result is one as well, so it can be bound to a non-const reference.
    const bool bothLvalues = trueEntry != nil<SymbolTableEntry*> && falseEntry != nil<SymbolTableEntry*> && !trueIsTemporary && !falseIsTemporary;
    if !trueIsTemporary && !falseIsTemporary && (trueType.isRef() || falseType.isRef()) {
        resultType = trueType.isRef() ? trueType : falseType;
    } else if bothLvalues {
        resultType = trueTypeModified.toRef(baseNode);
    }
    // Infer the const-ness from the more restrictive operand
    resultType.makeConst(trueType.isConst() || falseType.isConst());

    // If there is an anonymous symbol attached to left or right, remove it,
    // since the result takes over the ownership of any destructible object.
    // The symbol lives in the scope of its branch, or in the current scope if the branch has no scope of its own.
    bool removedAnonymousSymbols = false;
    if trueEntry != nil<SymbolTableEntry*> {
        if trueIsTemporary {
            Scope* anonymousSymbolScope = trueScope != nil<Scope*> ? trueScope : this.currentScope;
            const String anonymousSymbolName = trueEntry.name;
            anonymousSymbolScope.symbolTable.deleteAnonymous(anonymousSymbolName);
            removedAnonymousSymbols = true;
        } else if !resultType.isRef() && !trueTypeModified.isTriviallyCopyable(baseNode) {
            node.trueSideCallsCopyCtor = true;
        }
    }
    if falseEntry != nil<SymbolTableEntry*> {
        if falseIsTemporary {
            Scope* anonymousSymbolScope = falseScope != nil<Scope*> ? falseScope : this.currentScope;
            const String anonymousSymbolName = falseEntry.name;
            anonymousSymbolScope.symbolTable.deleteAnonymous(anonymousSymbolName);
            removedAnonymousSymbols = true;
        } else if !resultType.isRef() && !falseTypeModified.isTriviallyCopyable(baseNode) {
            node.falseSideCallsCopyCtor = true;
        }
    }

    // Create a new anonymous symbol for the result if required
    SymbolTableEntry* anonymousSymbol = nil<SymbolTableEntry*>;
    const bool calledCopyCtor = node.trueSideCallsCopyCtor || node.falseSideCallsCopyCtor;
    if removedAnonymousSymbols || calledCopyCtor || resultType.isRef() {
        anonymousSymbol = this.currentScope.symbolTable.insertAnonymous(resultType, baseNode);
    }

    // Look up the copy ctor if at least one side needs it
    if node.trueSideCallsCopyCtor || node.falseSideCallsCopyCtor {
        node.calledCopyCtor = this.matchCopyCtor(trueTypeModified, baseNode);
    }

    // Consider the dtor calls for the temporaries of the branches. A result of reference type may refer to a temporary of its
    // branch, so those must not be destructed. Not destructing them is the safe choice here, as it only leaks the temporary.
    const bool resultIsRef = resultType.isRef();
    if !node.isShortened {
        this.doTernaryBranchCleanup(node.trueExpr, trueScope, resultIsRef);
    }
    this.doTernaryBranchCleanup(node.falseExpr, falseScope, resultIsRef);

    return Any(ExprResult{node.node.setEvaluatedSymbolType(resultType, this.manIdx), anonymousSymbol});
}

// Visit a ternary branch in its expression scope (visitBranch lambda in the host's visitTernaryExpr)
f<Pair<ExprResult, Scope*>> TypeChecker.visitTernaryBranch(IVisitable* branch) {
    ExprScopeHandle exprScopeHandle = ExprScopeHandle(&this.compilerPass, branch);
    const ExprResult branchResult = this.visitExpr(branch);
    return Pair<ExprResult, Scope*>(branchResult, exprScopeHandle.getExprScope());
}

// Consider the dtor calls for the temporaries of a ternary branch (doBranchCleanup lambda in the host's visitTernaryExpr)
p TypeChecker.doTernaryBranchCleanup(IVisitable* branch, const Scope* branchScope, bool resultIsRef) {
    if branchScope == nil<const Scope*> {
        return;
    }
    ExprScopeHandle exprScopeHandle = ExprScopeHandle(&this.compilerPass, branch);
    if resultIsRef {
        Scope* exprScope = exprScopeHandle.getExprScope();
        exprScope.temporaryDtorsToCall.clear();
    } else {
        this.doExprScopeCleanup(branch);
    }
}

// Check if a ternary operand is a temporary (isTemporary lambda in the host's visitTernaryExpr)
f<bool> isTemporaryTernaryOperand(const SymbolTableEntry* entry) {
    if entry == nil<const SymbolTableEntry*> || !entry.anonymous {
        return false;
    }
    const QualType entryType = entry.getQualType();
    return !entryType.isRef();
}

public f<Any> TypeChecker.visitLogicalOrExpr(ASTLogicalOrExprNode* node) {
    // Check if a logical or operator is applied
    if node.operands.getSize() == 1l {
        return this.visit(node.operands.front());
    }
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Visit leftmost operand
    ExprResult currentOperand = this.visitExpr(node.operands.get(0));
    if currentOperand.ty.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }

    // Loop through all remaining operands
    for unsigned long i = 1l; i < node.operands.getSize(); i++ {
        // The operand is only evaluated if the ones before did not short-circuit, so it gets its temporaries destructed on its own
        const ExprResult rhsOperand = this.visitInExprScope(node.operands.get(i));
        if rhsOperand.ty.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }
        currentOperand = ExprResult{this.opRuleManager.getLogicalOrResultType(baseNode, currentOperand, rhsOperand), nil<SymbolTableEntry*>};
    }

    node.node.setEvaluatedSymbolType(currentOperand.ty, this.manIdx);
    return Any(currentOperand);
}

public f<Any> TypeChecker.visitLogicalAndExpr(ASTLogicalAndExprNode* node) {
    // Check if a logical and operator is applied
    if node.operands.getSize() == 1l {
        return this.visit(node.operands.front());
    }
    ASTNode* baseNode = cast<ASTNode*>(node);

    // Visit leftmost operand
    ExprResult currentOperand = this.visitExpr(node.operands.get(0));
    if currentOperand.ty.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }

    // Loop through all remaining operands
    for unsigned long i = 1l; i < node.operands.getSize(); i++ {
        // The operand is only evaluated if the ones before did not short-circuit, so it gets its temporaries destructed on its own
        const ExprResult rhsOperand = this.visitInExprScope(node.operands.get(i));
        if rhsOperand.ty.is(SuperType::TY_UNRESOLVED) { return unresolvedER(); }
        currentOperand = ExprResult{this.opRuleManager.getLogicalAndResultType(baseNode, currentOperand, rhsOperand), nil<SymbolTableEntry*>};
    }

    node.node.setEvaluatedSymbolType(currentOperand.ty, this.manIdx);
    return Any(currentOperand);
}

public f<Any> TypeChecker.visitBitwiseOrExpr(ASTBitwiseOrExprNode* node) {
