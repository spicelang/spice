// ToDo: Port TypeCheckerBuiltinFunctions.cpp
f<Any> TypeChecker.visitBuiltinCall(ASTFctCallNode* node) {
    return this.notPortedYet(cast<ASTNode*>(node));
}

// ======================================================= Not overridden by the host TypeChecker =================================

// The host TypeChecker does not override these visit methods, so they visit all children (AbstractASTVisitor default)
public f<Any> TypeChecker.visitFctName(ASTFctNameNode* node) { return this.visitChildren(cast<ASTNode*>(node)); }
public f<Any> TypeChecker.visitTypeLst(ASTTypeLstNode* node) { return this.visitChildren(cast<ASTNode*>(node)); }
public f<Any> TypeChecker.visitTypeLstWithEllipsis(ASTTypeLstWithEllipsisNode* node) { return this.visitChildren(cast<ASTNode*>(node)); }
public f<Any> TypeChecker.visitTypeAltsLst(ASTTypeAltsLstNode* node) { return this.visitChildren(cast<ASTNode*>(node)); }
public f<Any> TypeChecker.visitArgLst(ASTArgLstNode* node) { return this.visitChildren(cast<ASTNode*>(node)); }
public f<Any> TypeChecker.visitEnumItemLst(ASTEnumItemLstNode* node) { return this.visitChildren(cast<ASTNode*>(node)); }
public f<Any> TypeChecker.visitEnumItem(ASTEnumItemNode* node) { return this.visitChildren(cast<ASTNode*>(node)); }
public f<Any> TypeChecker.visitExprStmt(ASTExprStmtNode* node) { return this.visitChildren(cast<ASTNode*>(node)); }
public f<Any> TypeChecker.visitQualifierLst(ASTQualifierLstNode* node) { return this.visitChildren(cast<ASTNode*>(node)); }
public f<Any> TypeChecker.visitQualifier(ASTQualifierNode* node) { return this.visitChildren(cast<ASTNode*>(node)); }
public f<Any> TypeChecker.visitModAttr(ASTModAttrNode* node) { return this.visitChildren(cast<ASTNode*>(node)); }
public f<Any> TypeChecker.visitTopLevelDefinitionAttr(ASTTopLevelDefAttrNode* node) { return this.visitChildren(cast<ASTNode*>(node)); }
public f<Any> TypeChecker.visitLambdaAttr(ASTLambdaAttrNode* node) { return this.visitChildren(cast<ASTNode*>(node)); }
public f<Any> TypeChecker.visitAttrLst(ASTAttrLstNode* node) { return this.visitChildren(cast<ASTNode*>(node)); }
public f<Any> TypeChecker.visitAttr(ASTAttrNode* node) { return this.visitChildren(cast<ASTNode*>(node)); }

// ============================================================== TypeCheckerImplicit.cpp ========================================

// ToDo: Port the rest of TypeCheckerImplicit.cpp (implicit default ctors/dtors, body preambles)

/**
 * Prepare the generation of a call to a method of a given struct
 *
 * @param entry Symbol entry to use as 'this' pointer for the method call
 * @param methodName Name of the method to call
 * @param args Provided arguments by the caller
 * @param node AST node
 */
public f<Function*> TypeChecker.implicitlyCallStructMethod(const SymbolTableEntry* entry, const String& methodName, const ArgList& args, const ASTNode* node) {
    const QualType entryType = entry.getQualType();
    const QualType unwrappedType = entryType.removeReferenceWrapper();
    const QualType thisType = unwrappedType.toNonConst();
    return this.implicitlyCallStructMethod(thisType, methodName, args, node);
}

/**
 * Prepare the generation of a call to a method of a given struct
 *
 * @param thisType Struct type to call the method on
 * @param methodName Name of the method to call
 * @param args Provided arguments by the caller
 * @param node AST node
 */
public f<Function*> TypeChecker.implicitlyCallStructMethod(QualType thisType, const String& methodName, const ArgList& args, const ASTNode* node) {
    assert thisType.is(SuperType::TY_STRUCT);
    Scope* matchScope = thisType.getBodyScope();
    assert matchScope.scopeType == ScopeType::STRUCT;

    // Search for dtor
    if matchScope.isImportedBy(this.rootScope) {
        thisType = this.mapLocalTypeToImportedScopeType(matchScope, thisType);
    }
    const QualTypeList noTemplateTypeHints;
    return matchFunction(matchScope, methodName, thisType, args, noTemplateTypeHints, true, node);
}

/**
 * Prepare the generation of a call to the copy ctor of a given struct
 *
 * @param entry Symbol entry to use as 'this' pointer for the copy ctor call
 * @param node Current AST node
 */
public f<Function*> TypeChecker.implicitlyCallStructCopyCtor(const SymbolTableEntry* entry, const ASTNode* node) {
    assert entry != nil<const SymbolTableEntry*>;
    const QualType entryType = entry.getQualType();
    const QualType unwrappedType = entryType.removeReferenceWrapper();
    const QualType thisType = unwrappedType.toNonConst();
    assert thisType.is(SuperType::TY_STRUCT);
    return this.implicitlyCallStructCopyCtor(thisType, node);
}

/**
 * Prepare the generation of a call to the copy ctor of a given struct
 *
 * @param thisType Struct type to call the copy ctor on
 * @param node Current AST node
 */
public f<Function*> TypeChecker.implicitlyCallStructCopyCtor(const QualType& thisType, const ASTNode* node) {
    const QualType unwrappedType = thisType.removeReferenceWrapper();
    const QualType argType = unwrappedType.toConstRef(node);
    ArgList args;
    args.pushBack(Pair<QualType, bool>(argType, false /* we always have an entry here */));
    return this.implicitlyCallStructMethod(thisType, String(CTOR_FUNCTION_NAME), args, node);
}

/**
 * Prepare the generation of a call to the move ctor of a given struct
 *
 * @param entry Symbol entry to use as 'this' pointer for the move ctor call
 * @param node Current AST node
 */
public f<Function*> TypeChecker.implicitlyCallStructMoveCtor(const SymbolTableEntry* entry, const ASTNode* node) {
    assert entry != nil<const SymbolTableEntry*>;
    const QualType entryType = entry.getQualType();
    const QualType unwrappedType = entryType.removeReferenceWrapper();
    const QualType thisType = unwrappedType.toNonConst();
    assert thisType.is(SuperType::TY_STRUCT);
    return this.implicitlyCallStructMoveCtor(thisType, node);
}

/**
 * Prepare the generation of a call to the move ctor of a given struct
 *
 * @param thisType Struct type to call the move ctor on
 * @param node Current AST node
 */
public f<Function*> TypeChecker.implicitlyCallStructMoveCtor(const QualType& thisType, const ASTNode* node) {
    const QualType unwrappedType = thisType.removeReferenceWrapper();
    const QualType nonConstType = unwrappedType.toNonConst();
    const QualType argType = nonConstType.toRef(node);
    ArgList args;
    args.pushBack(Pair<QualType, bool>(argType, false /* we always have an entry here */));
    return this.implicitlyCallStructMethod(thisType, String(CTOR_FUNCTION_NAME), args, node);
}

/**
 * Prepare the generation of a call to the dtor of a given struct
 *
 * @param entry Symbol entry to use as 'this' pointer for the dtor call
 * @param node StmtLstNode for the current scope
 */
p TypeChecker.implicitlyCallStructDtor(SymbolTableEntry* entry, ASTStmtLstNode* node) {
    // Add the dtor to the stmt list node to call it later in codegen
    const ArgList noArgs;
    Function* dtor = this.implicitlyCallStructMethod(entry, String(DTOR_FUNCTION_NAME), noArgs, cast<ASTNode*>(node));
    if dtor != nil<Function*> {
        ResourcesForManifestationToCleanup& resources = node.resourcesToCleanup.get(this.manIdx);
        resources.dtorFunctionsToCall.pushBack(Pair<SymbolTableEntry*, Function*>(entry, dtor));
    }
}

/**
 * Prepare the generation of a call to the deallocate function for a heap-allocated variable
 *
 * @param node Current AST node for error messages
 */
p TypeChecker.implicitlyCallDeallocate(const ASTNode* node) {
    SourceFile* memoryRT = this.sourceFile.requestRuntimeModule(RuntimeModule::MEMORY_RT);
    assert memoryRT != nil<SourceFile*>;
    Scope* matchScope = memoryRT.getGlobalScope();
    // Set dealloc function to used
    const QualType thisType = QualType(SuperType::TY_DYN);
    const QualType byteType = QualType(SuperType::TY_BYTE);
    const QualType bytePtrType = byteType.toPtr(node);
    QualType bytePtrRefType = bytePtrType.toRef(node);
    bytePtrRefType.makeHeap();
    ArgList args;
    args.pushBack(Pair<QualType, bool>(bytePtrRefType, false /* we always have the field as storage */));
    const QualTypeList noTemplateTypeHints;
    Function* deallocFct = matchFunction(matchScope, String(FCT_NAME_DEALLOC), thisType, args, noTemplateTypeHints, true, node);
    assert deallocFct != nil<Function*>;
    deallocFct.used = true;
}

/**
 * Sort the given variables in reverse declaration order. This is the order in which their dtors are called.
 *
 * @param vars Variables to sort
 */
p TypeChecker.sortByReverseDeclarationOrder(Vector<SymbolTableEntry*>& vars) {
    // Stable insertion sort (std::ranges::stable_sort in the host)
    for unsigned long i = 1l; i < vars.getSize(); i++ {
        SymbolTableEntry* current = vars.get(i);
        unsigned long j = i;
        while j > 0l && this.isDeclaredAfter(current, vars.get(j - 1l)) {
            SymbolTableEntry*& slot = vars.get(j);
            slot = vars.get(j - 1l);
            j--;
        }
        SymbolTableEntry*& targetSlot = vars.get(j);
        targetSlot = current;
    }
}

// Comparator of sortByReverseDeclarationOrder (comp lambda in the host)
f<bool> TypeChecker.isDeclaredAfter(const SymbolTableEntry* a, const SymbolTableEntry* b) {
    const ASTNode* aDeclNode = a.declNode;
    const ASTNode* bDeclNode = b.declNode;
    // Primary sort criteria is the code location
    if !(aDeclNode.codeLoc == bDeclNode.codeLoc) {
        return aDeclNode.codeLoc.isAfter(bDeclNode.codeLoc);
    }
    // Secondary sort criteria is the node id
    return this.getNodeId(aDeclNode) > this.getNodeId(bDeclNode);
}

// Node id of the given AST node. Like the host's nodeToNodeId[node], nodes that were not created by the parser get the id 0
f<unsigned long> TypeChecker.getNodeId(const ASTNode* node) {
    const long nodeAddress = getNodeAddress(node);
    if !this.resourceManager.nodeToNodeId.contains(nodeAddress) {
        return 0l;
    }
    return this.resourceManager.nodeToNodeId.get(nodeAddress);
}

/**
 * Consider calls to destructors for the given scope
 *
 * @param node StmtLstNode for the current scope
 */
p TypeChecker.doScopeCleanup(ASTStmtLstNode* node) {
    // Get all variables, that are approved for de-allocation
    Vector<SymbolTableEntry*> vars = this.currentScope.getVarsGoingOutOfScope();
    // Sort by reverse declaration order
    this.sortByReverseDeclarationOrder(vars);
    // Call the dtor of each variable. We call the dtor in reverse declaration order
    foreach SymbolTableEntry* varEntry : vars {
        const QualType varType = varEntry.getQualType();
        // Check if we have a heap-allocated pointer
        const dyn heapOptions = [SuperType::TY_PTR, SuperType::TY_STRING, SuperType::TY_FUNCTION, SuperType::TY_PROCEDURE];
        if varType.isHeap() && varType.isOneOf(heapOptions, len(heapOptions)) {
            // The memory runtime is ignored, because it manually allocates to avoid circular dependencies.
            // Same goes for the string runtime.
            if this.sourceFile.isMemoryRT() || this.sourceFile.isStringRT() {
                continue;
            }
            // If the local variable currently does not have the ownership, we must not deallocate its memory
            const Lifecycle& lifecycle = varEntry.getLifecycle();
            if !lifecycle.isInOwningState() {
                continue;
            }

            this.implicitlyCallDeallocate(cast<ASTNode*>(node)); // Required to request the memory runtime
            ResourcesForManifestationToCleanup& resources = node.resourcesToCleanup.get(this.manIdx);
            resources.heapVarsToFree.pushBack(varEntry);
        }
        // Only generate dtor call for structs and if not omitted
        if !varType.is(SuperType::TY_STRUCT) || varEntry.omitDtorCall {
            continue;
        }
        // Variable must be either initialized or a struct field
        if !varEntry.isInitialized() && varEntry.scope.scopeType != ScopeType::STRUCT {
            continue;
        }
        // Call dtor
        this.implicitlyCallStructDtor(varEntry, node);
    }
}

/**
 * Consider calls to the destructors of the temporaries of the current expression scope
 *
 * @param node Expression, that owns the current expression scope
 */
p TypeChecker.doExprScopeCleanup(IVisitable* node) {
    assert this.currentScope.scopeType == ScopeType::EXPR_BODY;

    // Get all temporaries that go out of scope. This is executed again if the expression is type-checked again
    Vector<SymbolTableEntry*> temporaries = this.currentScope.getVarsGoingOutOfScope();
    this.sortByReverseDeclarationOrder(temporaries);
    this.currentScope.temporaryDtorsToCall.clear();

    // Call the dtor of each temporary. We call the dtor in reverse declaration order
    ASTNode* baseNode = getASTNode(node);
    foreach SymbolTableEntry* temporary : temporaries {
        // Only generate dtor call for initialized structs and if not omitted
        const QualType temporaryType = temporary.getQualType();
        if !temporaryType.is(SuperType::TY_STRUCT) || temporary.omitDtorCall || !temporary.isInitialized() {
            continue;
        }
        const ArgList noArgs;
        Function* dtor = this.implicitlyCallStructMethod(temporary, String(DTOR_FUNCTION_NAME), noArgs, baseNode);
        if dtor != nil<Function*> {
            this.currentScope.temporaryDtorsToCall.pushBack(Pair<SymbolTableEntry*, Function*>(temporary, dtor));
        }
    }
}

/**
 * Visit an expression in its expression scope, if it has one, and consider calls to the destructors of its temporaries
 *
 * @param expr Expression to visit
 * @return Result of the expression
 */
f<ExprResult> TypeChecker.visitInExprScope(IVisitable* expr) {
    ExprScopeHandle exprScopeHandle = ExprScopeHandle(&this.compilerPass, expr);
    const ExprResult exprResult = this.visitExpr(expr);
    // If the expression is not resolved yet, it is visited again later on, which is when the temporaries are known
    if exprScopeHandle.getExprScope() != nil<Scope*> && !exprResult.ty.is(SuperType::TY_UNRESOLVED) {
        this.doExprScopeCleanup(expr);
    }
    return exprResult;
}
