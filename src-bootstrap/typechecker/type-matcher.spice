// Std imports
import "std/data/unordered-map";
import "std/data/vector";

// Own imports
import "bootstrap/exception/error-manager";
import "bootstrap/model/struct-base";
import "bootstrap/exception/semantic-error";
import "bootstrap/ast/ast-nodes";
import "bootstrap/model/generic-type";
import "bootstrap/model/struct";
import "bootstrap/model/interface";
import "bootstrap/model/union";
import "bootstrap/symboltablebuilder/super-type";
import "bootstrap/symboltablebuilder/qual-type";

/**
 * Helper functions for FunctionManager, StructManager, InterfaceManager and UnionManager to match generic types.
 * This is a tricky task, because the types can be indirect or/and nested.
 */

/**
 * Search the given candidate template types for a generic type with a certain name
 *
 * @param candidateTemplateTypes Template types of the candidate
 * @param genericTypeName Name of the generic type
 * @param genericOnly Skip template types that are not generic (anymore)
 * @return Generic type, or nil if not found
 */
public f<const GenericType*> resolveGenericTypeByName(const Vector<GenericType>& candidateTemplateTypes, const String& genericTypeName, bool genericOnly) {
    foreach const GenericType& templateType : candidateTemplateTypes {
        if genericOnly && !templateType.qualType.is(SuperType::TY_GENERIC) {
            continue;
        }
        if templateType.qualType.getSubType() == genericTypeName {
            return &templateType;
        }
    }
    return nil<const GenericType*>;
}

/**
 * Match a list of requested types against a list of candidate types, extending the type mapping as needed.
 *
 * @param candidateTypes Candidate types
 * @param reqTypes Requested types
 * @param typeMapping Concrete template type mapping
 * @param candidateTemplateTypes Template types of the candidate, used to look up generic types by their name
 * @param genericOnly Only consider template types that are (still) generic when looking them up by name
 * @param strictQualifiers Match qualifiers strictly
 * @return Fulfilled or not
 */
public f<bool> matchRequestedToCandidateTypes(const QualTypeList& candidateTypes, const QualTypeList& reqTypes, TypeMapping& typeMapping, const Vector<GenericType>& candidateTemplateTypes, bool genericOnly, bool strictQualifiers) {
    // Check if the size of template types matches
    if reqTypes.getSize() != candidateTypes.getSize() {
        return false;
    }

    // Loop through both lists at the same time and match each pair of template types individually
    foreach unsigned long i, const QualType& candidateType : candidateTypes {
        const QualType& reqType = reqTypes.get(i);

        // Match the pair of template types
        if !matchRequestedToCandidateType(candidateType, reqType, typeMapping, candidateTemplateTypes, genericOnly, strictQualifiers) {
            return false;
        }
    }
    return true;
}

/**
 * Check if a requested type matches a candidate type, which may be generic. The type mapping may be extended.
 *
 * @param candidateTypeIn Candidate type
 * @param requestedTypeIn Requested type
 * @param typeMapping Concrete template type mapping
 * @param candidateTemplateTypes Template types of the candidate, used to look up generic types by their name
 * @param genericOnly Only consider template types that are (still) generic when looking them up by name
 * @param strictQualifierMatching Match qualifiers strictly
 * @return Fulfilled or not
 */
public f<bool> matchRequestedToCandidateType(const QualType& candidateTypeIn, const QualType& requestedTypeIn, TypeMapping& typeMapping, const Vector<GenericType>& candidateTemplateTypes, bool genericOnly, bool strictQualifierMatching) {
    QualType candidateType = candidateTypeIn;
    QualType requestedType = requestedTypeIn;

    // Unwrap as far as possible and remove reference wrappers if possible
    unwrapBothWithRefWrappers(candidateType, requestedType);

    // If the candidate does not contain any generic parts, we can simply check for type equality
    if !candidateType.hasAnyGenericParts() {
        // Check if the right one is a struct that implements the interface on the left
        if candidateType.matchesInterfaceImplementedByStruct(requestedType) {
            return true;
        }
        // Normal equality check
        return candidateType.matches(requestedType, true, !strictQualifierMatching, true);
    }

    // Check if the candidate type itself is generic
    if candidateType.isBase(SuperType::TY_GENERIC) { // The candidate type itself is generic
        const QualType candidateBaseType = candidateType.getBase();
        const String& genericTypeName = candidateBaseType.getSubType();

        // Check if we know the concrete type for that generic type name already
        if typeMapping.contains(genericTypeName) { // This is a known generic type
            QualType knownConcreteType = typeMapping.get(genericTypeName);

            // Merge qualifiers of candidate type and known concrete type together
            knownConcreteType.qualifiers = knownConcreteType.qualifiers.merge(candidateType.qualifiers);

            // Remove reference wrapper of candidate type if required
            if !requestedType.isRef() {
                knownConcreteType = knownConcreteType.removeReferenceWrapper();
            }

            if requestedType.isRef() && !knownConcreteType.isRef() {
                const QualType containedType = requestedType.getContained();
                requestedType = containedType.toNonConst();
            }

            // Check if the known concrete type matches the requested type
            return knownConcreteType.matches(requestedType, true, !strictQualifierMatching, true);
        } else { // This is an unknown generic type
            // Retrieve generic candidate type by its name
            const GenericType* genericCandidateBaseType = resolveGenericTypeByName(candidateTemplateTypes, genericTypeName, genericOnly);
            assert genericCandidateBaseType != nil<const GenericType*>;

            // Check if the requested type fulfills all conditions of the generic candidate type
            QualType newBaseType = QualType(SuperType::TY_DYN); // Overwritten by checkConditionsOf
            if !genericCandidateBaseType.checkConditionsOf(requestedType, newBaseType, true, !strictQualifierMatching) {
                return false;
            }

            QualType substantiatedCandidateType = candidateType.replaceBaseType(newBaseType);

            // Remove reference wrapper of candidate type if required
            if !requestedType.isRef() {
                substantiatedCandidateType = substantiatedCandidateType.removeReferenceWrapper();
            }

            if requestedType.isRef() && !substantiatedCandidateType.isRef() {
                const QualType containedType = requestedType.getContained();
                requestedType = containedType.toNonConst();
            }

            if !substantiatedCandidateType.matches(requestedType, true, !strictQualifierMatching, true) {
                return false;
            }

            // Zero out all qualifiers in the requested type, that are present in the candidate type
            // This is to set all qualifiers that are not present in the candidate type to the generic type replacement
            requestedType.qualifiers.eraseWithMask(substantiatedCandidateType.qualifiers);

            // Add to type mapping
            const QualType newMappingType = requestedType.hasAnyGenericParts() ? candidateBaseType : newBaseType;
            typeMapping.upsert(genericTypeName, newMappingType);

            return true; // The type was successfully matched, by enriching the type mapping
        }
    } else { // The candidate type itself is non-generic, but one or several template or param types are
        // Check if supertype and subtype are equal
        if requestedType.getSuperType() != candidateType.getSuperType() {
            return false;
        }

        // If we have a function/procedure type, check the param and return types. Otherwise, check the template types
        const dyn fctOptions = [SuperType::TY_FUNCTION, SuperType::TY_PROCEDURE];
        if candidateType.isOneOf(fctOptions, len(fctOptions)) {
            // Check param and return types
            const QualTypeList candidatePRTypes = candidateType.getFunctionParamAndReturnTypes();
            const QualTypeList requestedPRTypes = requestedType.getFunctionParamAndReturnTypes();
            if !matchRequestedToCandidateTypes(candidatePRTypes, requestedPRTypes, typeMapping, candidateTemplateTypes, genericOnly, strictQualifierMatching) {
                return false;
            }
        } else {
            if requestedType.getSubType() != candidateType.getSubType() {
                return false;
            }
            if requestedType.getBodyScope().parent != candidateType.getBodyScope().parent {
                return false;
            }

            // Check template types
            const QualTypeList candidateTTypes = candidateType.getTemplateTypes();
            const QualTypeList requestedTTypes = requestedType.getTemplateTypes();
            if !matchRequestedToCandidateTypes(candidateTTypes, requestedTTypes, typeMapping, candidateTemplateTypes, genericOnly, strictQualifierMatching) {
                return false;
            }
        }

        return true; // All requested template types match to their respective candidate template type -> successfully matched
    }
}

/**
 * Substantiate a list of types with a type mapping in place.
 *
 * @param qualTypes Types to substantiate
 * @param typeMapping Concrete template type mapping
 * @param node AST node for error messages
 */
public p substantiateTypesWithTypeMapping(QualTypeList& qualTypes, const TypeMapping& typeMapping, const ASTNode* node) {
    foreach QualType& qualType : qualTypes {
        if qualType.hasAnyGenericParts() {
            substantiateTypeWithTypeMapping(qualType, typeMapping, node);
        }
    }
}

/**
 * Substantiate a single (possibly nested) generic type with a type mapping in place.
 *
 * @param type Type to substantiate
 * @param typeMapping Concrete template type mapping
 * @param node AST node for error messages
 */
public p substantiateTypeWithTypeMapping(QualType& qualType, const TypeMapping& typeMapping, const ASTNode* node) {
    assert qualType.hasAnyGenericParts();
    const QualType baseType = qualType.getBase();

    // Check if the type itself is generic
    if baseType.is(SuperType::TY_GENERIC) { // The symbol type itself is generic
        const String& genericTypeName = baseType.getSubType();
        assert typeMapping.contains(genericTypeName);
        const QualType& replacementType = typeMapping.get(genericTypeName);
        qualType = qualType.replaceBaseType(replacementType);
        return;
    }

    const dyn fctOptions = [SuperType::TY_FUNCTION, SuperType::TY_PROCEDURE];
    if baseType.isOneOf(fctOptions, len(fctOptions)) { // The base type is a function or procedure
        // Substantiate each param or return type
        QualTypeList paramAndReturnTypes = qualType.getFunctionParamAndReturnTypes();
        foreach QualType& paramOrReturnType : paramAndReturnTypes {
            if paramOrReturnType.hasAnyGenericParts() {
                substantiateTypeWithTypeMapping(paramOrReturnType, typeMapping, node);
            }
        }
        // Attach the list of concrete param types to the symbol type
        qualType = qualType.getWithFunctionParamAndReturnTypes(paramAndReturnTypes);
        return;
    }

    // The base type is a struct, interface or union
    assert baseType.is(SuperType::TY_STRUCT) || baseType.is(SuperType::TY_INTERFACE) || baseType.is(SuperType::TY_UNION);
    // Substantiate each template type
    QualTypeList templateTypes = baseType.getTemplateTypes();
    foreach QualType& templateType : templateTypes {
        if templateType.hasAnyGenericParts() {
            substantiateTypeWithTypeMapping(templateType, typeMapping, node);
        }
    }
    // Attach the list of concrete template types to the symbol type
    qualType = qualType.getWithBaseTemplateTypes(templateTypes);
    // Lookup the scope of the concrete struct or interface type
    // Only do this, if the struct or interface is not self-referencing, because in that case we'd end up in an infinite recursion
    if !baseType.isSelfReferencingStructType(nil<const QualType*>) {
        if baseType.is(SuperType::TY_STRUCT) { // Struct
            Struct* spiceStruct = baseType.getStruct(node, templateTypes);
            if spiceStruct == nil<Struct*> {
                assert node != nil<ASTNode*>;
                const String signature = getStructSignature(baseType.getSubType(), templateTypes);
                throwSemanticError(node, SemanticErrorType::UNKNOWN_DATATYPE, "Could not find struct '" + signature + "'");
                // The compilation is aborted after this stage. Until then, leave the type as is
                return;
            }
            qualType = qualType.getWithBodyScope(spiceStruct.scope);
        } else if baseType.is(SuperType::TY_UNION) { // Union
            Union* spiceUnion = baseType.getUnion(node, templateTypes);
            if spiceUnion != nil<Union*> {
                qualType = qualType.getWithBodyScope(spiceUnion.scope);
            }
        } else { // Interface
            Interface* spiceInterface = baseType.getInterface(node, templateTypes);
            if spiceInterface == nil<Interface*> {
                assert node != nil<ASTNode*>;
                const String signature = getStructSignature(baseType.getSubType(), templateTypes);
                throwSemanticError(node, SemanticErrorType::UNKNOWN_DATATYPE, "Could not find interface '" + signature + "'");
                // The compilation is aborted after this stage. Until then, leave the type as is
                return;
            }
            qualType = qualType.getWithBodyScope(spiceInterface.scope);
        }
    }
}
