// Std imports
import "std/data/map";
import "std/data/unordered-map";
import "std/data/vector";
import "std/data/pair";

// Own imports
import "bootstrap/ast/ast-nodes";
import "bootstrap/model/struct";
import "bootstrap/model/generic-type";
import "bootstrap/symboltablebuilder/qual-type";
import "bootstrap/symboltablebuilder/super-type";
import "bootstrap/symboltablebuilder/scope";
import "bootstrap/symboltablebuilder/symbol-table-entry";
import "bootstrap/typechecker/type-matcher";

// Type aliases
public type StructManifestationList alias UnorderedMap</*mangledName=*/String, Struct>;
public type StructRegistry alias Map</*structId=*/String, /*manifestationList=*/StructManifestationList>;

/**
 * Insert a struct declaration into the given scope
 *
 * @param insertScope Scope to insert the struct into
 * @param spiceStruct Struct to insert
 * @param nodeStructList List to collect the inserted manifestation into (owned by the declaration node)
 * @return Inserted struct manifestation
 */
public f<Struct*> insert(Scope* insertScope, Struct& spiceStruct, Vector<Struct*>* nodeStructList) {
    // Open a new manifestation list. Which gets filled by the substantiated manifestations of the struct
    const String structId = spiceStruct.name + ":" + spiceStruct.declNode.codeLoc.toString();
    insertScope.structs.insert(structId, StructManifestationList());

    // Save substantiation in declaration node
    Struct* substantiation = insertSubstantiation(insertScope, spiceStruct, spiceStruct.declNode);
    nodeStructList.pushBack(substantiation);

    return substantiation;
}

f<Struct*> insertSubstantiation(Scope* insertScope, Struct& newManifestation, const ASTNode* declNode) {
    const String signature = newManifestation.structBase.getSignature();

    // Retrieve the matching manifestation list of the scope
    const String structId = newManifestation.name + ":" + declNode.codeLoc.toString();
    assert insertScope.structs.contains(structId);
    StructManifestationList& manifestationList = insertScope.structs.get(structId);

    // Add substantiated struct
    newManifestation.manifestationIndex = manifestationList.getSize();
    manifestationList.upsert(signature, newManifestation);
    return &manifestationList.get(signature);
}

/**
 * Check if there is a struct in this scope, fulfilling all given requirements and if found, return it.
 * If more than one struct matches the requirement, this is reported (see ToDo below).
 *
 * @param matchScope Scope to match against
 * @param qt Struct name requirement
 * @param reqTemplateTypes Template types to substantiate generic types
 * @param node Instantiation AST node for printing error messages
 * @return Matched struct or nil
 */
public f<Struct*> match(Scope* matchScope, const String& qt, const QualTypeList& reqTemplateTypes, const ASTNode* node) {
    // Loop over struct registry to find structs, that match the requirements of the instantiation
    Vector<Struct*> matches;
    foreach Pair<const String&, StructManifestationList&> defEntry : matchScope.structs {
        const String& structId = defEntry.getFirst();
        foreach Pair<const String&, Struct&> manEntry : defEntry.getSecond() {
            const String& mangledName = manEntry.getFirst();
            const Struct& presetStruct = manEntry.getSecond();
            // Skip generic and newly inserted substantiations to prevent double matching of a struct
            if presetStruct.structBase.isGenericSubstantiation() || presetStruct.isNewlyInserted {
                continue;
            }

            // Copy the struct to be able to substantiate types
            Struct candidate = presetStruct;

            // Check name requirement
            if !matchName(candidate, qt) {
                break; // Leave the whole manifestation list, because all manifestations in this list have the same name
            }

            // Prepare mapping table from generic type name to concrete type
            candidate.typeMapping.clear();

            // Check template types requirement
            if !matchTemplateTypes(candidate, reqTemplateTypes, candidate.typeMapping, node) {
                continue; // Leave this manifestation and continue with the next one
            }

            // Map field types from generic to concrete
            substantiateFieldTypes(candidate, candidate.typeMapping, node);

            // We found a match! -> Set the actual candidate and its entry to used
            candidate.used = true;
            candidate.entry.used = true;

            // Check if it needs to be substantiated
            if presetStruct.templateTypes.isEmpty() {
                assert matchScope.structs.contains(structId) && matchScope.structs.get(structId).contains(mangledName);
                Struct* structMatch = &matchScope.structs.get(structId).get(mangledName);
                structMatch.used = true;
                matches.pushBack(structMatch);
                continue; // Match was successful -> match the next struct
            }

            // Check if we already have this manifestation and can simply re-use it
            const String candidateSignature = candidate.structBase.getSignature();
            if defEntry.getSecond().contains(candidateSignature) {
                Struct& existingManifestation = defEntry.getSecond().get(candidateSignature);
                existingManifestation.used = true;
                matches.pushBack(&existingManifestation);
                break; // Leave the whole manifestation list to not double-match the manifestation
            }

            // Insert the substantiated version if required
            Struct* substantiatedStruct = insertSubstantiation(matchScope, candidate, presetStruct.declNode);
            substantiatedStruct.genericPreset = &matchScope.structs.get(structId).get(mangledName);
            // ToDo: Register the substantiation with declNode->getStructManifestations() once the AST node
            // exposes a per-declaration manifestation list (see ast-nodes.spice).
            substantiatedStruct.isNewlyInserted = true; // To not iterate over it in the same matching

            // Copy struct entry
            const String newSignature = substantiatedStruct.structBase.getSignature();
            matchScope.lookupStrict(substantiatedStruct.name).used = true;
            substantiatedStruct.entry = matchScope.symbolTable.copySymbol(substantiatedStruct.name, newSignature);
            assert substantiatedStruct.entry != nil<SymbolTableEntry*>;

            // Copy struct scope
            const String oldScopeName = presetStruct.getScopeName();
            const String newScopeName = substantiatedStruct.getScopeName();
            matchScope.copyChildScope(oldScopeName, newScopeName);
            substantiatedStruct.scope = matchScope.getChildScope(newScopeName);
            assert substantiatedStruct.scope != nil<Scope*>;
            substantiatedStruct.scope.isGenericScope = false;

            // Attach the template types to the new struct entry
            QualType entryType = substantiatedStruct.entry.getQualType().getWithTemplateTypes(substantiatedStruct.structBase.getTemplateTypes()).getWithBodyScope(substantiatedStruct.scope);
            substantiatedStruct.entry.updateType(entryType, true);

            // Replace symbol types of field entries with concrete types
            assert substantiatedStruct.scope != nil<Scope*>;
            const unsigned long fieldCount = cast<unsigned long>(substantiatedStruct.fieldTypes.getSize());
            const unsigned long explicitFieldsStartIdx = substantiatedStruct.scope.getFieldCount() - fieldCount;
            unsigned long i = 0ul;
            while i < fieldCount {
                // Replace field type with concrete template type
                SymbolTableEntry* fieldEntry = substantiatedStruct.scope.lookupField(cast<unsigned int>(explicitFieldsStartIdx + i));
                assert fieldEntry != nil<SymbolTableEntry*> && fieldEntry.isField();
                QualType& fieldType = substantiatedStruct.fieldTypes.get(i);
                QualType baseType = fieldType.getBase();

                // Set the body scope of fields that are of type <candidate-struct>*
                if baseType.matches(substantiatedStruct.entry.getQualType(), false, true, true) {
                    fieldType = fieldType.replaceBaseType(baseType.getWithBodyScope(substantiatedStruct.scope));
                }

                fieldEntry.updateType(fieldType, /*overwriteExistingType=*/true);

                // Instantiate structs
                if baseType.is(SuperType::TY_STRUCT) {
                    baseType.getStruct(node);
                }

                i++;
            }

            // Instantiate implemented interfaces if required
            foreach unsigned long j, QualType& interfaceType : substantiatedStruct.interfaceTypes {
                // Skip non-generic interfaces
                if !interfaceType.hasAnyGenericParts() {
                    continue;
                }

                // Build template types
                QualTypeList templateTypes = interfaceType.getTemplateTypes();
                substantiateTypesWithTypeMapping(templateTypes, candidate.typeMapping, node);

                // Instantiate interface
                Interface* spiceInterface = interfaceType.getInterface(node, templateTypes);
                if spiceInterface != nil<Interface*> {
                    interfaceType = spiceInterface.entry.getQualType();
                }
            }

            // Decide which compiler-generated default members this brand-new manifestation needs.
            // ToDo: Call TypeChecker::createImplicitDefaultMembers once the type checker pass is ported.

            // Add to matched structs
            matches.pushBack(substantiatedStruct);
        }
    }

    // If no matches were found, return a nil
    if matches.isEmpty() {
        return nil<Struct*>;
    }

    // Check if more than one struct matches the requirements
    if matches.getSize() > 1l {
        // ToDo: Report as a hard error (STRUCT_AMBIGUITY) once error propagation for typechecker passes is
        // designed. For now, deterministically pick the first candidate.
    }
    Struct* matchedStruct = matches.front();
    matchedStruct.isNewlyInserted = false;

    return matchedStruct;
}

/**
 * Checks if the matching candidate fulfills the name requirement
 */
f<bool> matchName(const Struct& candidate, const String& reqName) {
    return candidate.name == reqName;
}

/**
 * Checks if the matching candidate fulfills the template types requirement
 */
f<bool> matchTemplateTypes(Struct& candidate, const QualTypeList& reqTemplateTypes, TypeMapping& typeMapping, const ASTNode* node) {
    // Check if the number of types match
    if reqTemplateTypes.getSize() != candidate.templateTypes.getSize() {
        return false;
    }

    // Give the type matcher a way to retrieve instances of GenericType by their name
    GenericTypeResolverFct genericTypeResolver = f<const GenericType*>(const String& genericTypeName) {
        return getGenericTypeOfCandidateByName(candidate, genericTypeName);
    };

    // Loop over all template types
    foreach unsigned long i, QualType& candidateType : candidate.templateTypes {
        const QualType& reqType = reqTemplateTypes.get(i);

        // Check if the requested template type matches the candidate template type. The type mapping may be extended
        if !matchRequestedToCandidateType(candidateType, reqType, typeMapping, genericTypeResolver, false) {
            return false;
        }

        // Substantiate the candidate param type, based on the type mapping
        if candidateType.hasAnyGenericParts() {
            substantiateTypeWithTypeMapping(candidateType, typeMapping, node);
        }
    }

    return true;
}

/**
 * Come up with the concrete field types, by applying the type mapping onto the generic field types
 */
p substantiateFieldTypes(Struct& candidate, const TypeMapping& typeMapping, const ASTNode* node) {
    // Loop over all implicit fields and substantiate the generic ones
    const unsigned long implicitFieldCount = candidate.scope.getFieldCount() - cast<unsigned long>(candidate.fieldTypes.getSize());
    unsigned long i = 0ul;
    while i < implicitFieldCount {
        SymbolTableEntry* fieldEntry = candidate.scope.lookupField(cast<unsigned int>(i));
        QualType fieldType = fieldEntry.getQualType();
        if fieldType.hasAnyGenericParts() {
            substantiateTypeWithTypeMapping(fieldType, typeMapping, node);
            fieldEntry.updateType(fieldType, true);
        }
        i++;
    }

    // Loop over all explicit field types and substantiate the generic ones
    foreach unsigned long j, QualType& fieldType : candidate.fieldTypes {
        if fieldType.hasAnyGenericParts() {
            substantiateTypeWithTypeMapping(fieldType, typeMapping, node);
        }
    }
}

/**
 * Searches the candidate template types for a generic type object with a certain name and return it
 */
f<const GenericType*> getGenericTypeOfCandidateByName(const Struct& candidate, const String& templateTypeName) {
    foreach const GenericType& templateType : candidate.templateTypes {
        if !templateType.qualType.is(SuperType::TY_GENERIC) {
            continue;
        }
        if templateType.qualType.getSubType() == templateTypeName {
            return &templateType;
        }
    }
    return nil<const GenericType*>;
}
