// Std imports
import "std/data/vector";
import "std/data/unordered-map";
import "std/data/pair";
import "std/text/stringstream";
import "std/math/hash";

// Own imports
import "bootstrap/source-file";
import "bootstrap/ast/ast-nodes";
import "bootstrap/exception/error-manager";
import "bootstrap/exception/semantic-error";
import "bootstrap/model/function";
import "bootstrap/symboltablebuilder/lifecycle";
import "bootstrap/symboltablebuilder/qual-type";
import "bootstrap/symboltablebuilder/scope";
import "bootstrap/symboltablebuilder/super-type";
import "bootstrap/symboltablebuilder/symbol-table-entry";
import "bootstrap/symboltablebuilder/type";
import "bootstrap/symboltablebuilder/type-qualifiers";
import "bootstrap/typechecker/expr-result";
import "bootstrap/typechecker/function-manager";
import "bootstrap/typechecker/type-checker";
import "bootstrap/util/custom-hash-functions";

// Custom error message prefixes
public const string ERROR_MSG_RETURN = "Passed wrong data type to return statement";
public const string ERROR_FOREACH_ITEM = "Passed wrong data type to foreach item";
public const string ERROR_FIELD_ASSIGN = "Given type of the field value does not match declaration";

// Unary operator rule: lhs type, result type, unsafe
public type UnaryOpRule struct {
    public SuperType lhsType
    public SuperType resultType
    public bool isUnsafe
}

// Binary operator rule: lhs type, rhs type, result type, unsafe
public type BinaryOpRule struct {
    public SuperType lhsType
    public SuperType rhsType
    public SuperType resultType
    public bool isUnsafe
}

public type UnaryOpRules alias Vector<UnaryOpRule>;
public type BinaryOpRules alias Vector<BinaryOpRule>;

/**
 * Helper class for the TypeChecker to check whether certain operator/type combinations are valid or not and which result type
 * is produced.
 *
 * The host keeps the operator rules in static constexpr arrays. Spice only supports globals of primitive type, so the rules
 * are stored in the OpRuleManager instead and filled once by its constructor (see initRules).
 *
 * Error handling: the host throws a SemanticError for invalid operator/type combinations. Here, a soft error is recorded and
 * the unresolved type is returned instead, which the visit methods of the TypeChecker propagate.
 */
public type OpRuleManager struct {
    TypeChecker* typeChecker = nil<TypeChecker*>
    BinaryOpRules assignOpRules
    BinaryOpRules plusEqualOpRules
    BinaryOpRules minusEqualOpRules
    BinaryOpRules mulEqualOpRules
    BinaryOpRules divEqualOpRules
    BinaryOpRules remEqualOpRules
    BinaryOpRules shlEqualOpRules
    BinaryOpRules shrEqualOpRules
    BinaryOpRules andEqualOpRules
    BinaryOpRules orEqualOpRules
    BinaryOpRules xorEqualOpRules
    BinaryOpRules logicalAndOpRules
    BinaryOpRules logicalOrOpRules
    BinaryOpRules bitwiseOrOpRules
    BinaryOpRules bitwiseXorOpRules
    BinaryOpRules bitwiseAndOpRules
    BinaryOpRules equalOpRules
    BinaryOpRules notEqualOpRules
    BinaryOpRules lessOpRules
    BinaryOpRules greaterOpRules
    BinaryOpRules lessEqualOpRules
    BinaryOpRules greaterEqualOpRules
    BinaryOpRules shiftLeftOpRules
    BinaryOpRules shiftRightOpRules
    BinaryOpRules plusOpRules
    BinaryOpRules minusOpRules
    BinaryOpRules mulOpRules
    BinaryOpRules divOpRules
    BinaryOpRules remOpRules
    UnaryOpRules prefixMinusOpRules
    UnaryOpRules prefixPlusPlusOpRules
    UnaryOpRules prefixMinusMinusOpRules
    UnaryOpRules prefixNotOpRules
    UnaryOpRules prefixBitwiseNotOpRules
    UnaryOpRules postfixPlusPlusOpRules
    UnaryOpRules postfixMinusMinusOpRules
    BinaryOpRules castOpRules
}

// Only default-initializes the field of the TypeChecker, whose ctor replaces it with a manager created by the ctor below. It does
// not fill the rule tables, because those would be leaked by that replacement.
public p OpRuleManager.ctor() {}

public p OpRuleManager.ctor(TypeChecker* typeChecker) {
    this.typeChecker = typeChecker;
    this.initRules();
}

// Fill the operator rule tables. Generated from the static rule arrays in the host's OpRuleManager.h
p OpRuleManager.initRules() {
    // Assign op rules
    this.assignOpRules.pushBack(BinaryOpRule{SuperType::TY_DOUBLE, SuperType::TY_DOUBLE, SuperType::TY_DOUBLE, false}); // double = double -> double
    this.assignOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_INT, SuperType::TY_INT, false}); // int = int -> int
    this.assignOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_SHORT, SuperType::TY_SHORT, false}); // short = short -> short
    this.assignOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_LONG, SuperType::TY_LONG, false}); // long = long -> long
    this.assignOpRules.pushBack(BinaryOpRule{SuperType::TY_BYTE, SuperType::TY_BYTE, SuperType::TY_BYTE, false}); // byte = byte -> byte
    this.assignOpRules.pushBack(BinaryOpRule{SuperType::TY_CHAR, SuperType::TY_CHAR, SuperType::TY_CHAR, false}); // char = char -> char
    this.assignOpRules.pushBack(BinaryOpRule{SuperType::TY_STRING, SuperType::TY_STRING, SuperType::TY_STRING, false}); // string = string -> string
    this.assignOpRules.pushBack(BinaryOpRule{SuperType::TY_BOOL, SuperType::TY_BOOL, SuperType::TY_BOOL, false}); // bool = bool -> bool

    // Plus equal op rules
    this.plusEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_DOUBLE, SuperType::TY_DOUBLE, SuperType::TY_DOUBLE, false}); // double += double -> double
    this.plusEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_INT, SuperType::TY_INT, false}); // int += int -> int
    this.plusEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_SHORT, SuperType::TY_INT, false}); // int += short -> int
    this.plusEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_LONG, SuperType::TY_INT, false}); // int += long -> int
    this.plusEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_INT, SuperType::TY_SHORT, false}); // short += int -> short
    this.plusEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_SHORT, SuperType::TY_SHORT, false}); // short += short -> short
    this.plusEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_LONG, SuperType::TY_SHORT, false}); // short += long -> short
    this.plusEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_INT, SuperType::TY_LONG, false}); // long += int -> long
    this.plusEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_SHORT, SuperType::TY_LONG, false}); // long += short -> long
    this.plusEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_LONG, SuperType::TY_LONG, false}); // long += long -> long
    this.plusEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_CHAR, SuperType::TY_INT, SuperType::TY_CHAR, false}); // char += int -> char

    // Minus equal op rules
    this.minusEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_DOUBLE, SuperType::TY_DOUBLE, SuperType::TY_DOUBLE, false}); // double -= double -> double
    this.minusEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_INT, SuperType::TY_INT, false}); // int -= int -> int
    this.minusEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_SHORT, SuperType::TY_INT, false}); // int -= short -> int
    this.minusEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_LONG, SuperType::TY_INT, false}); // int -= long -> int
    this.minusEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_INT, SuperType::TY_SHORT, false}); // short -= int -> short
    this.minusEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_SHORT, SuperType::TY_SHORT, false}); // short -= short -> short
    this.minusEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_LONG, SuperType::TY_SHORT, false}); // short -= long -> short
    this.minusEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_INT, SuperType::TY_LONG, false}); // long -= int -> long
    this.minusEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_SHORT, SuperType::TY_LONG, false}); // long -= short -> long
    this.minusEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_LONG, SuperType::TY_LONG, false}); // long -= long -> long
    this.minusEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_CHAR, SuperType::TY_INT, SuperType::TY_CHAR, false}); // char -= int -> char

    // Mul equal op rules
    this.mulEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_DOUBLE, SuperType::TY_DOUBLE, SuperType::TY_DOUBLE, false}); // double *= double -> double
    this.mulEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_INT, SuperType::TY_INT, false}); // int *= int -> int
    this.mulEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_SHORT, SuperType::TY_INT, false}); // int *= short -> int
    this.mulEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_LONG, SuperType::TY_INT, false}); // int *= long -> int
    this.mulEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_INT, SuperType::TY_SHORT, false}); // short *= int -> short
    this.mulEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_SHORT, SuperType::TY_SHORT, false}); // short *= short -> short
    this.mulEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_LONG, SuperType::TY_SHORT, false}); // short *= long -> short
    this.mulEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_INT, SuperType::TY_LONG, false}); // long *= int -> long
    this.mulEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_SHORT, SuperType::TY_LONG, false}); // long *= short -> long
    this.mulEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_LONG, SuperType::TY_LONG, false}); // long *= long -> long

    // Div equal op rules
    this.divEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_DOUBLE, SuperType::TY_DOUBLE, SuperType::TY_DOUBLE, false}); // double /= double -> double
    this.divEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_INT, SuperType::TY_INT, false}); // int /= int -> int
    this.divEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_SHORT, SuperType::TY_INT, false}); // int /= short -> int
    this.divEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_LONG, SuperType::TY_INT, false}); // int /= long -> int
    this.divEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_INT, SuperType::TY_SHORT, false}); // short /= int -> short
    this.divEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_SHORT, SuperType::TY_SHORT, false}); // short /= short -> short
    this.divEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_LONG, SuperType::TY_SHORT, false}); // short /= long -> short
    this.divEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_INT, SuperType::TY_LONG, false}); // long /= int -> long
    this.divEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_SHORT, SuperType::TY_LONG, false}); // long /= short -> long
    this.divEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_LONG, SuperType::TY_LONG, false}); // long /= long -> long

    // Rem equal op rules
    this.remEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_DOUBLE, SuperType::TY_DOUBLE, SuperType::TY_DOUBLE, false}); // double %= double -> double
    this.remEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_INT, SuperType::TY_INT, false}); // int %= int -> int
    this.remEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_SHORT, SuperType::TY_INT, false}); // int %= short -> int
    this.remEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_LONG, SuperType::TY_INT, false}); // int %= long -> int
    this.remEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_INT, SuperType::TY_SHORT, false}); // short %= int -> short
    this.remEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_SHORT, SuperType::TY_SHORT, false}); // short %= short -> short
    this.remEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_LONG, SuperType::TY_SHORT, false}); // short %= long -> short
    this.remEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_INT, SuperType::TY_LONG, false}); // long %= int -> long
    this.remEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_SHORT, SuperType::TY_LONG, false}); // long %= short -> long
    this.remEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_LONG, SuperType::TY_LONG, false}); // long %= long -> long
    this.remEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_BYTE, SuperType::TY_BYTE, SuperType::TY_BYTE, false}); // byte %= byte -> byte

    // Shl equal op rules
    this.shlEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_INT, SuperType::TY_INT, false}); // int <<= int -> int
    this.shlEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_SHORT, SuperType::TY_INT, false}); // int <<= short -> int
    this.shlEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_LONG, SuperType::TY_LONG, false}); // int <<= long -> int
    this.shlEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_INT, SuperType::TY_SHORT, false}); // short <<= int -> short
    this.shlEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_SHORT, SuperType::TY_SHORT, false}); // short <<= short -> short
    this.shlEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_LONG, SuperType::TY_LONG, false}); // short <<= long -> short
    this.shlEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_INT, SuperType::TY_LONG, false}); // long <<= int -> long
    this.shlEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_SHORT, SuperType::TY_LONG, false}); // long <<= short -> long
    this.shlEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_LONG, SuperType::TY_LONG, false}); // long <<= long -> long
    this.shlEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_BYTE, SuperType::TY_BYTE, SuperType::TY_BYTE, false}); // byte <<= byte -> byte

    // Shr equal op rules
    this.shrEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_INT, SuperType::TY_INT, false}); // int >>= int -> int
    this.shrEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_SHORT, SuperType::TY_INT, false}); // int >>= short -> int
    this.shrEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_LONG, SuperType::TY_LONG, false}); // int >>= long -> int
    this.shrEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_INT, SuperType::TY_SHORT, false}); // short >>= int -> short
    this.shrEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_SHORT, SuperType::TY_SHORT, false}); // short >>= short -> short
    this.shrEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_LONG, SuperType::TY_LONG, false}); // short >>= long -> short
    this.shrEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_INT, SuperType::TY_LONG, false}); // long >>= int -> long
    this.shrEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_SHORT, SuperType::TY_LONG, false}); // long >>= short -> long
    this.shrEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_LONG, SuperType::TY_LONG, false}); // long >>= long -> long
    this.shrEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_BYTE, SuperType::TY_BYTE, SuperType::TY_BYTE, false}); // byte >>= byte -> byte

    // And equal op rules
    this.andEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_INT, SuperType::TY_INT, false}); // int &= int -> int
    this.andEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_SHORT, SuperType::TY_INT, false}); // int &= short -> int
    this.andEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_LONG, SuperType::TY_LONG, false}); // int &= long -> int
    this.andEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_INT, SuperType::TY_SHORT, false}); // short &= int -> short
    this.andEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_SHORT, SuperType::TY_SHORT, false}); // short &= short -> short
    this.andEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_LONG, SuperType::TY_LONG, false}); // short &= long -> short
    this.andEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_INT, SuperType::TY_LONG, false}); // long &= int -> long
    this.andEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_SHORT, SuperType::TY_LONG, false}); // long &= short -> long
    this.andEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_LONG, SuperType::TY_LONG, false}); // long &= long -> long
    this.andEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_BYTE, SuperType::TY_BYTE, SuperType::TY_BYTE, false}); // byte &= byte -> byte

    // Or equal op rules
    this.orEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_INT, SuperType::TY_INT, false}); // int |= int -> int
    this.orEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_SHORT, SuperType::TY_INT, false}); // int |= short -> int
    this.orEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_LONG, SuperType::TY_LONG, false}); // int |= long -> int
    this.orEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_INT, SuperType::TY_SHORT, false}); // short |= int -> short
    this.orEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_SHORT, SuperType::TY_SHORT, false}); // short |= short -> short
    this.orEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_LONG, SuperType::TY_LONG, false}); // short |= long -> short
    this.orEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_INT, SuperType::TY_LONG, false}); // long |= int -> long
    this.orEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_SHORT, SuperType::TY_LONG, false}); // long |= short -> long
    this.orEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_LONG, SuperType::TY_LONG, false}); // long |= long -> long
    this.orEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_BYTE, SuperType::TY_BYTE, SuperType::TY_BYTE, false}); // byte |= byte -> byte

    // Xor equal op rules
    this.xorEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_INT, SuperType::TY_INT, false}); // int ^= int -> int
    this.xorEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_SHORT, SuperType::TY_INT, false}); // int ^= short -> int
    this.xorEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_LONG, SuperType::TY_LONG, false}); // int ^= long -> int
    this.xorEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_INT, SuperType::TY_SHORT, false}); // short ^= int -> short
    this.xorEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_SHORT, SuperType::TY_SHORT, false}); // short ^= short -> short
    this.xorEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_LONG, SuperType::TY_LONG, false}); // short ^= long -> short
    this.xorEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_INT, SuperType::TY_LONG, false}); // long ^= int -> long
    this.xorEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_SHORT, SuperType::TY_LONG, false}); // long ^= short -> long
    this.xorEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_LONG, SuperType::TY_LONG, false}); // long ^= long -> long
    this.xorEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_BYTE, SuperType::TY_BYTE, SuperType::TY_BYTE, false}); // byte ^= byte -> byte
    this.xorEqualOpRules.pushBack(BinaryOpRule{SuperType::TY_CHAR, SuperType::TY_CHAR, SuperType::TY_CHAR, false}); // char ^= char -> char

    // Logical and op rules
    this.logicalAndOpRules.pushBack(BinaryOpRule{SuperType::TY_BOOL, SuperType::TY_BOOL, SuperType::TY_BOOL, false}); // bool && bool -> bool

    // Logical or op rules
    this.logicalOrOpRules.pushBack(BinaryOpRule{SuperType::TY_BOOL, SuperType::TY_BOOL, SuperType::TY_BOOL, false}); // bool || bool -> bool

    // Bitwise or op rules
    this.bitwiseOrOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_INT, SuperType::TY_INT, false}); // int | int -> int
    this.bitwiseOrOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_SHORT, SuperType::TY_SHORT, false}); // short | short -> short
    this.bitwiseOrOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_LONG, SuperType::TY_LONG, false}); // long | long -> long
    this.bitwiseOrOpRules.pushBack(BinaryOpRule{SuperType::TY_BYTE, SuperType::TY_BYTE, SuperType::TY_BYTE, false}); // byte | byte -> byte
    this.bitwiseOrOpRules.pushBack(BinaryOpRule{SuperType::TY_BOOL, SuperType::TY_BOOL, SuperType::TY_BOOL, false}); // bool | bool -> bool

    // Bitwise xor op rules
    this.bitwiseXorOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_INT, SuperType::TY_INT, false}); // int ^ int -> int
    this.bitwiseXorOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_SHORT, SuperType::TY_SHORT, false}); // short ^ short -> short
    this.bitwiseXorOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_LONG, SuperType::TY_LONG, false}); // long ^ long -> long
    this.bitwiseXorOpRules.pushBack(BinaryOpRule{SuperType::TY_BYTE, SuperType::TY_BYTE, SuperType::TY_BYTE, false}); // byte ^ byte -> byte
    this.bitwiseXorOpRules.pushBack(BinaryOpRule{SuperType::TY_BOOL, SuperType::TY_BOOL, SuperType::TY_BOOL, false}); // bool ^ bool -> bool

    // Bitwise and op rules
    this.bitwiseAndOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_INT, SuperType::TY_INT, false}); // int & int -> int
    this.bitwiseAndOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_SHORT, SuperType::TY_SHORT, false}); // short & short -> short
    this.bitwiseAndOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_LONG, SuperType::TY_LONG, false}); // long & long -> long
    this.bitwiseAndOpRules.pushBack(BinaryOpRule{SuperType::TY_BYTE, SuperType::TY_BYTE, SuperType::TY_BYTE, false}); // byte & byte -> byte
    this.bitwiseAndOpRules.pushBack(BinaryOpRule{SuperType::TY_BOOL, SuperType::TY_BOOL, SuperType::TY_BOOL, false}); // bool & bool -> bool

    // Equal op rules
    this.equalOpRules.pushBack(BinaryOpRule{SuperType::TY_DOUBLE, SuperType::TY_DOUBLE, SuperType::TY_BOOL, false}); // double == double -> bool
    this.equalOpRules.pushBack(BinaryOpRule{SuperType::TY_DOUBLE, SuperType::TY_INT, SuperType::TY_BOOL, false}); // double == int -> bool
    this.equalOpRules.pushBack(BinaryOpRule{SuperType::TY_DOUBLE, SuperType::TY_SHORT, SuperType::TY_BOOL, false}); // double == short -> bool
    this.equalOpRules.pushBack(BinaryOpRule{SuperType::TY_DOUBLE, SuperType::TY_LONG, SuperType::TY_BOOL, false}); // double == long -> bool
    this.equalOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_DOUBLE, SuperType::TY_BOOL, false}); // int == double -> bool
    this.equalOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_INT, SuperType::TY_BOOL, false}); // int == int -> bool
    this.equalOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_SHORT, SuperType::TY_BOOL, false}); // int == short -> bool
    this.equalOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_LONG, SuperType::TY_BOOL, false}); // int == long -> bool
    this.equalOpRules.pushBack(BinaryOpRule{SuperType::TY_INT, SuperType::TY_CHAR, SuperType::TY_BOOL, false}); // int == char -> bool
    this.equalOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_DOUBLE, SuperType::TY_BOOL, false}); // short == double -> bool
    this.equalOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_INT, SuperType::TY_BOOL, false}); // short == int -> bool
    this.equalOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_SHORT, SuperType::TY_BOOL, false}); // short == short -> bool
    this.equalOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_LONG, SuperType::TY_BOOL, false}); // short == long -> bool
    this.equalOpRules.pushBack(BinaryOpRule{SuperType::TY_SHORT, SuperType::TY_CHAR, SuperType::TY_BOOL, false}); // short == char -> bool
    this.equalOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_DOUBLE, SuperType::TY_BOOL, false}); // long == double -> bool
    this.equalOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_INT, SuperType::TY_BOOL, false}); // long == int -> bool
    this.equalOpRules.pushBack(BinaryOpRule{SuperType::TY_LONG, SuperType::TY_SHORT, SuperType::TY_BOOL, false}); // long == short -> bool
