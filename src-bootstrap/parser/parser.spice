// Std imports
import "std/data/stack";
import "std/data/vector";
import "std/data/pair";
import "std/text/format";
import "std/type/type-conversion";

// Own imports
import "bootstrap/compiler-pass";
import "bootstrap/source-file";
import "bootstrap/global/global-resource-manager";
import "bootstrap/lexer/lexer";
import "bootstrap/lexer/token";
import "bootstrap/reader/code-loc";
import "bootstrap/ast/ast-nodes";
import "bootstrap/ast/attributes";
import "bootstrap/symboltablebuilder/qual-type";
import "bootstrap/symboltablebuilder/super-type";
import "bootstrap/symboltablebuilder/type-qualifiers";
import "bootstrap/exception/parser-error";
import "bootstrap/util/compile-progress";

// External functions
ext f<unsigned long> strtoull(string, char**, int);

/**
 * Check if the given identifier is a reserved keyword
 *
 * @param identifier Identifier to check
 * @return Reserved or not
 */
public f<bool> isReservedKeyword(const String& identifier) {
    return identifier == "new" || identifier == "stash" || identifier == "pick" || identifier == "sync" || identifier == "class";
}

// Generic types
type T dyn;

/**
 * Builds the AST of a source file from its token stream. This is the equivalent of the ANTLR-generated parser and the
 * ASTBuilder of the host compiler.
 */
public type Parser struct {
    compose public CompilerPass compilerPass
    Lexer& lexer
    Stack<ASTNode*> parentStack
    // Number of additional '>' tokens that are still pending due to a previously split SHR ('>>') token.
    // This is needed to close nested generic type lists, since the lexer merges '>>' into a single token.
    unsigned int pendingGreaters = 0
    // Whether a '<' is still pending due to a previously split SHL ('<<') token. This is needed for the template type list
    // of a generic less operator, e.g. 'operator<<T>(...)', since the lexer merges '<<' into a single token.
    bool pendingLess = false
    // Whether a field data type is currently parsed. Its template types are field types as well
    bool isParsingFieldType = false
    unsigned long currentNodeId = 0l
    Vector<IVisitable*> switchStmts
}

public p Parser.ctor(GlobalResourceManager& resourceManager, SourceFile* sourceFile, Lexer& lexer) {
    this.compilerPass = CompilerPass(resourceManager, sourceFile);
    this.lexer = lexer;
    // Make sure the current token is a relevant (non-comment) token
    this.skipIgnoredTokens();
}

f<T*> Parser.createNode<T>() {
    ASTNode* parent = nil<ASTNode*>;
    const bool isRootNode = this.parentStack.isEmpty();
    if !isRootNode {
        parent = this.parentStack.top();
    }

    // Reserve storage in the pool and construct the node in place. We construct in place (instead of
    // copying a prebuilt node) so that AST nodes may hold non-copyable members such as their children.
    T* node = this.resourceManager.astNodeAlloc.reserve<T>();
    unsafe {
        __placement_new<T>(node, this.lexer.getCodeLoc());
    }
    this.resourceManager.nodeToNodeId.upsert(getNodeAddress(cast<ASTNode*>(node)), this.currentNodeId++);
    // Upcast to the composed ASTNode base. This is what the parent/child book-keeping operates on.
    ASTNode* nodeBase = cast<ASTNode*>(node);
    // Remember the node as IVisitable*, so generic child traversal can dispatch to its concrete type
    nodeBase.visitable = cast<IVisitable*>(node);

    // If this is not the entry node, we need to add the new node to its parent
    if !isRootNode {
        parent.addChild(nodeBase);
    }

    // This node is the parent for its children
    this.parentStack.push(nodeBase);

    return node;
}

#[ignoreUnusedReturnValue]
f<T*> Parser.concludeNode<T>(T* node) {
    assert !this.parentStack.isEmpty();
    ASTNode* nodeBase = cast<ASTNode*>(node);
    assert this.parentStack.top() == nodeBase;
    this.parentStack.pop();
    // The node ends with the last token, that was consumed for it (like the stop token of a parser rule context in the host)
    const Token& stopToken = this.lexer.getPreviousRelevantToken();
    nodeBase.codeLoc.sourceIntervalStop = cast<long>(stopToken.endOffset) - 1l;
    return node;
}

// Create a new node, which takes the place of the most recently parsed child of the current parent node and adopts it.
// This is used for expressions, where the node type is only known after the first operand was parsed. Pass-through
// expressions (e.g. an additive expression with only one operand) therefore never get a node, like in the host ASTBuilder.
f<T*> Parser.createNodeWrappingLastChild<T>() {
    assert !this.parentStack.isEmpty();
    ASTNode* parent = this.parentStack.top();
    assert !parent.children.isEmpty();
    ASTNode* child = parent.children.back();
    parent.children.popBack();

    // Create the node in place of the child. It starts where its first child starts
    T* node = this.createNode<T>();
    ASTNode* nodeBase = cast<ASTNode*>(node);
    nodeBase.codeLoc = child.codeLoc;

    // Adopt the child
    nodeBase.addChild(child);

    return node;
}

// Move a child of the given parent node to the end of its children. The host lists the children of a node in the order of
// its members (see GET_CHILDREN), which differs from the parse order for some nodes. This is used to mirror that order.
p Parser.moveChildToEnd(ASTNode* parent, ASTNode* child) {
    const unsigned long childCount = parent.children.getSize();
    for unsigned long i = 0l; i < childCount; i++ {
        if parent.children.get(i) == child {
            parent.children.removeAt(i);
            parent.children.pushBack(child);
            return;
        }
    }
    assert false; // Child not found
}

f<IVisitable*> Parser.concludeExprNode<T>(T* node) {
    this.concludeNode(node);
    return cast<IVisitable*>(node);
}

inline f<bool> Parser.currentTokenIs(TokenType expectedTokenType) {
    return this.lexer.getToken().tokenType == expectedTokenType;
}

f<bool> Parser.currentTokenIsOneOf(TokenType[] expectedTokenTypeArray, unsigned long size) {
    for unsigned long i = 0l; i < size; i++ {
        if this.currentTokenIs(expectedTokenTypeArray[i]) {
            return true;
        }
    }
    return false;
}

// =================================================== Token stream helpers ===================================================

inline f<bool> Parser.isIgnoredTokenType(TokenType tokenType) {
    return tokenType == TokenType::LINE_COMMENT || tokenType == TokenType::BLOCK_COMMENT || tokenType == TokenType::DOC_COMMENT;
}

p Parser.skipIgnoredTokens() {
    while this.isIgnoredTokenType(this.lexer.getToken().tokenType) {
        this.lexer.advance();
    }
}

// Advance to the next relevant token, transparently skipping comment tokens.
p Parser.advance() {
    this.lexer.advance();
    this.skipIgnoredTokens();
}

// Assert that the current token has the expected type and advance afterwards.
p Parser.expect(TokenType expectedTokenType) {
    if !this.currentTokenIs(expectedTokenType) {
        const Token& token = this.lexer.getToken();
        const String message = "Unexpected token '" + token.text + "'";
        this.throwParserError(token.codeLoc, ParserErrorType::PARSING_FAILED, message.getRaw());
    }
    this.advance();
}

// Return the type of the token at the given offset, where offset 0 is the current token.
// Comment tokens are skipped, so the offset counts relevant tokens only. The lexer resolves this
// in O(1) via its precomputed comment-free index, which keeps speculative lookahead cheap.
f<TokenType> Parser.tokenAt(unsigned long offset) {
    return this.lexer.peekRelevantType(offset);
}

// Check if a generic type list opens at the current position. A '<' might still be pending from a split SHL ('<<') token.
f<bool> Parser.isGenericOpenAhead() {
    return this.pendingLess || this.currentTokenIs(TokenType::LESS);
}

// Open a generic type list. Uses up a pending '<' from a split SHL ('<<') token, if there is one.
p Parser.consumeGenericOpen() {
    if this.pendingLess {
        this.pendingLess = false;
        return;
    }
    this.expect(TokenType::LESS);
}

// Close a generic type list. Handles the case where the lexer merged two closing
// angle brackets of nested generic lists into a single SHR ('>>') token.
p Parser.consumeGenericClose() {
    // A previously split SHR still provides one '>' for us
    if this.pendingGreaters > 0 {
        this.pendingGreaters--;
        return;
    }
    // A single SHR token closes two generic lists at once
    if this.currentTokenIs(TokenType::SHR) {
        this.pendingGreaters = 1;
        this.advance();
        return;
    }
    this.expect(TokenType::GREATER);
}

// ===================================================== Lookahead matchers ====================================================
// These functions inspect (but do not consume) upcoming tokens to disambiguate grammar alternatives.
// They return the offset right after the matched construct, or -1 if no match was possible.

inline f<bool> Parser.isQualifierType(TokenType tokenType) {
    return tokenType == TokenType::CONST || tokenType == TokenType::SIGNED || tokenType == TokenType::UNSIGNED
        || tokenType == TokenType::INLINE || tokenType == TokenType::PUBLIC || tokenType == TokenType::HEAP
        || tokenType == TokenType::COMPOSE;
}

inline f<bool> Parser.isBaseDataTypeKeyword(TokenType tokenType) {
    return tokenType == TokenType::TYPE_DOUBLE || tokenType == TokenType::TYPE_INT || tokenType == TokenType::TYPE_SHORT
        || tokenType == TokenType::TYPE_LONG || tokenType == TokenType::TYPE_BYTE || tokenType == TokenType::TYPE_CHAR
        || tokenType == TokenType::TYPE_STRING || tokenType == TokenType::TYPE_BOOL || tokenType == TokenType::TYPE_DYN;
}

inline f<bool> Parser.isConstantStart(TokenType tokenType) {
    return tokenType == TokenType::DOUBLE_LIT || tokenType == TokenType::INT_LIT || tokenType == TokenType::SHORT_LIT
        || tokenType == TokenType::LONG_LIT || tokenType == TokenType::CHAR_LIT || tokenType == TokenType::STRING_LIT
        || tokenType == TokenType::TRUE || tokenType == TokenType::FALSE;
}

inline f<bool> Parser.isAssignOp(TokenType tokenType) {
    return tokenType == TokenType::ASSIGN || tokenType == TokenType::PLUS_EQUAL || tokenType == TokenType::MINUS_EQUAL
        || tokenType == TokenType::MUL_EQUAL || tokenType == TokenType::DIV_EQUAL || tokenType == TokenType::REM_EQUAL
        || tokenType == TokenType::SHL_EQUAL || tokenType == TokenType::SHR_EQUAL || tokenType == TokenType::AND_EQUAL
        || tokenType == TokenType::OR_EQUAL || tokenType == TokenType::XOR_EQUAL;
}

// Check if the current token is a minus sign that belongs to a negative numeric constant
inline f<bool> Parser.isNegativeNumericConstantAhead() {
    if !this.currentTokenIs(TokenType::MINUS) {
        return false;
    }
    const TokenType nextTokenType = this.tokenAt(1l);
    return nextTokenType == TokenType::DOUBLE_LIT || nextTokenType == TokenType::INT_LIT
        || nextTokenType == TokenType::SHORT_LIT || nextTokenType == TokenType::LONG_LIT;
}

// Skip a balanced angle-bracket group starting at the given offset (which must be a LESS token).
// Accounts for SHL ('<<') and SHR ('>>') tokens which open/close two levels at once.
f<long> Parser.matchAngleGroup(long offset) {
    long depth = 0l;
    while true {
        const TokenType tokenType = this.tokenAt(cast<unsigned long>(offset));
        if !this.isTypeLstToken(tokenType) {
            return -1l; // This token can not be part of a type list, so this is no generic type list
        } else if tokenType == TokenType::LESS {
            depth++;
        } else if tokenType == TokenType::SHL {
            depth += 2l;
        } else if tokenType == TokenType::GREATER {
            depth--;
        } else if tokenType == TokenType::SHR {
            depth -= 2l;
        }
        offset++;
        if depth <= 0l {
            return offset;
        }
    }
    panic(Error("Unreachable")); // The loop above only exits via return
}

// Get the text of the current identifier token and check that it is not reserved. The token is not consumed.
f<String> Parser.getIdentifier(bool isTypeIdentifier) {
    const Token& token = this.lexer.getToken();
    const String& identifier = token.text;

    // Check if the list of reserved keywords contains the given identifier
    if isReservedKeyword(identifier) {
        const String message = "'" + identifier + "' is a reserved keyword. Please use another name instead";
        this.throwParserError(token.codeLoc, ParserErrorType::RESERVED_KEYWORD, message.getRaw());
    }

    // Check if the identifier is a type identifier and is reserved
    if isTypeIdentifier && !this.sourceFile.isStdFile && isReservedTypeName(identifier) {
        const String message = "'" + identifier + "' is a reserved type name. Please use another one instead";
        this.throwParserError(token.codeLoc, ParserErrorType::RESERVED_TYPENAME, message.getRaw());
    }

    return identifier;
}

// Check if the given token type can appear within a type list (typeLst), including the enclosing angle brackets.
f<bool> Parser.isTypeLstToken(TokenType tokenType) {
    if this.isQualifierType(tokenType) || this.isBaseDataTypeKeyword(tokenType) {
        return true;
    }
    const dyn options = [
        TokenType::IDENTIFIER, TokenType::TYPE_IDENTIFIER, TokenType::SCOPE_ACCESS, TokenType::COMMA, TokenType::LESS,
        TokenType::GREATER, TokenType::SHL, TokenType::SHR, TokenType::MUL, TokenType::BITWISE_AND, TokenType::LBRACKET,
        TokenType::RBRACKET, TokenType::INT_LIT, TokenType::F, TokenType::P, TokenType::LPAREN, TokenType::RPAREN
    ];
    for unsigned long i = 0l; i < len(options); i++ {
        if tokenType == options[i] {
            return true;
        }
    }
    return false;
}

// Skip a balanced group delimited by the given open/close token types, starting at an open token.
f<long> Parser.matchBalancedGroup(long offset, TokenType openType, TokenType closeType) {
    long depth = 0l;
    while true {
        const TokenType tokenType = this.tokenAt(cast<unsigned long>(offset));
        if tokenType == TokenType::EOF {
            return -1l;
        } else if tokenType == openType {
            depth++;
        } else if tokenType == closeType {
            depth--;
        }
        offset++;
        if depth <= 0l {
            return offset;
        }
    }
    panic(Error("Unreachable")); // The loop above only exits via return
}

// Try to match a dataType at the given offset. Returns the offset right after the dataType, or -1.
f<long> Parser.matchDataType(long offset) {
    // Qualifiers
    while this.isQualifierType(this.tokenAt(cast<unsigned long>(offset))) {
        offset++;
    }
    // Base data type
    const TokenType baseType = this.tokenAt(cast<unsigned long>(offset));
    if this.isBaseDataTypeKeyword(baseType) {
        offset++;
    } else if baseType == TokenType::F || baseType == TokenType::P {
        offset++;
        if this.tokenAt(cast<unsigned long>(offset)) == TokenType::LESS {
            offset = this.matchAngleGroup(offset);
            if offset < 0l { return -1l; }
        }
        if this.tokenAt(cast<unsigned long>(offset)) != TokenType::LPAREN { return -1l; }
        offset = this.matchBalancedGroup(offset, TokenType::LPAREN, TokenType::RPAREN);
        if offset < 0l { return -1l; }
    } else if baseType == TokenType::IDENTIFIER || baseType == TokenType::TYPE_IDENTIFIER {
        // (IDENTIFIER SCOPE_ACCESS)*
        while this.tokenAt(cast<unsigned long>(offset)) == TokenType::IDENTIFIER && this.tokenAt(cast<unsigned long>(offset + 1l)) == TokenType::SCOPE_ACCESS {
            offset += 2l;
        }
        if this.tokenAt(cast<unsigned long>(offset)) != TokenType::TYPE_IDENTIFIER { return -1l; }
        offset++;
        if this.tokenAt(cast<unsigned long>(offset)) == TokenType::LESS {
            offset = this.matchAngleGroup(offset);
            if offset < 0l { return -1l; }
        }
    } else {
        return -1l;
    }
    // Pointer / reference / array suffixes
    while true {
        const TokenType suffix = this.tokenAt(cast<unsigned long>(offset));
        if suffix == TokenType::MUL || suffix == TokenType::BITWISE_AND {
            offset++;
        } else if suffix == TokenType::LBRACKET {
            offset = this.matchBalancedGroup(offset, TokenType::LBRACKET, TokenType::RBRACKET);
            if offset < 0l { return -1l; }
        } else {
            break;
        }
    }
    return offset;
}

// A statement is a declaration if it starts with a dataType immediately followed by an identifier (the variable name).
f<bool> Parser.isDeclStmtAhead() {
    const long afterType = this.matchDataType(0l);
    return afterType >= 0l && this.tokenAt(cast<unsigned long>(afterType)) == TokenType::IDENTIFIER;
}

// Match the name path of a function call: (IDENTIFIER ::)* (IDENTIFIER .)* (IDENTIFIER | TYPE_IDENTIFIER) (< typeLst >)?
f<long> Parser.matchFctCallPath(long offset) {
    while this.tokenAt(cast<unsigned long>(offset)) == TokenType::IDENTIFIER && this.tokenAt(cast<unsigned long>(offset + 1l)) == TokenType::SCOPE_ACCESS {
        offset += 2l;
    }
    while this.tokenAt(cast<unsigned long>(offset)) == TokenType::IDENTIFIER && this.tokenAt(cast<unsigned long>(offset + 1l)) == TokenType::DOT {
        offset += 2l;
    }
    const TokenType name = this.tokenAt(cast<unsigned long>(offset));
    if name != TokenType::IDENTIFIER && name != TokenType::TYPE_IDENTIFIER { return -1l; }
    offset++;
    if this.tokenAt(cast<unsigned long>(offset)) == TokenType::LESS {
        offset = this.matchAngleGroup(offset);
        if offset < 0l { return -1l; }
    }
    return offset;
}

// Match the name path of a struct instantiation: (IDENTIFIER ::)* TYPE_IDENTIFIER (< typeLst >)?
f<long> Parser.matchStructPath(long offset) {
    while this.tokenAt(cast<unsigned long>(offset)) == TokenType::IDENTIFIER && this.tokenAt(cast<unsigned long>(offset + 1l)) == TokenType::SCOPE_ACCESS {
        offset += 2l;
    }
    if this.tokenAt(cast<unsigned long>(offset)) != TokenType::TYPE_IDENTIFIER { return -1l; }
    offset++;
    if this.tokenAt(cast<unsigned long>(offset)) == TokenType::LESS {
        offset = this.matchAngleGroup(offset);
        if offset < 0l { return -1l; }
    }
    return offset;
}

f<bool> Parser.isFctCallAhead() {
    const long after = this.matchFctCallPath(0l);
    return after >= 0l && this.tokenAt(cast<unsigned long>(after)) == TokenType::LPAREN;
}

// A struct path followed by a brace group is a struct instantiation, unless the brace group is a statement list. This is
// the case for e.g. 'if i == MAX_COUNT { return; }', where the brace group belongs to the if statement.
f<bool> Parser.isStructInstantiationAhead() {
    const long lbraceOffset = this.matchStructPath(0l);
    if lbraceOffset < 0l || this.tokenAt(cast<unsigned long>(lbraceOffset)) != TokenType::LBRACE {
        return false;
    }

    // A statement list may start with a statement keyword, which can not start an argument list
    const TokenType firstToken = this.tokenAt(cast<unsigned long>(lbraceOffset + 1l));
    if this.isStmtStartKeyword(firstToken) || firstToken == TokenType::LBRACE {
        return false;
    }

    // A statement list contains semicolons on its top level, while an argument list does not
    long offset = lbraceOffset;
    long depth = 0l;
    while true {
        const TokenType tokenType = this.tokenAt(cast<unsigned long>(offset));
        if tokenType == TokenType::EOF {
            return false;
        } else if tokenType == TokenType::LBRACE {
            depth++;
        } else if tokenType == TokenType::RBRACE {
            depth--;
        } else if tokenType == TokenType::SEMICOLON && depth == 1l {
            return false;
        }
        offset++;
        if depth == 0l {
            break;
        }
    }

    // An empty brace group is only a struct instantiation, if the expression can continue after it
    if offset == lbraceOffset + 2l {
        const TokenType afterBraces = this.tokenAt(cast<unsigned long>(offset));
        return afterBraces != TokenType::ELSE && !this.isStmtStartToken(afterBraces);
    }
    return true;
}

// Check if the given token type is a keyword that can only appear at the start of a statement
f<bool> Parser.isStmtStartKeyword(TokenType tokenType) {
    const dyn options = [
        TokenType::RETURN, TokenType::IF, TokenType::FOR, TokenType::FOREACH, TokenType::WHILE, TokenType::DO,
        TokenType::SWITCH, TokenType::CASE, TokenType::DEFAULT, TokenType::BREAK, TokenType::CONTINUE,
        TokenType::FALLTHROUGH, TokenType::ASSERT, TokenType::UNSAFE
    ];
    for unsigned long i = 0l; i < len(options); i++ {
        if tokenType == options[i] {
            return true;
        }
    }
    return this.isQualifierType(tokenType) || this.isBaseDataTypeKeyword(tokenType);
}

// Check if the given token type can start a statement, but can not continue an expression
f<bool> Parser.isStmtStartToken(TokenType tokenType) {
    if this.isStmtStartKeyword(tokenType) || this.isConstantStart(tokenType) {
        return true;
    }
    return tokenType == TokenType::IDENTIFIER || tokenType == TokenType::TYPE_IDENTIFIER || tokenType == TokenType::NIL
        || tokenType == TokenType::CAST || tokenType == TokenType::F || tokenType == TokenType::P || tokenType == TokenType::EOF;
}

// A parenthesized group is a lambda expression if it is followed by an arrow ('->').
f<bool> Parser.isLambdaExprAhead() {
    const long after = this.matchBalancedGroup(0l, TokenType::LPAREN, TokenType::RPAREN);
    return after >= 0l && this.tokenAt(cast<unsigned long>(after)) == TokenType::ARROW;
}

public f<ASTEntryNode*> Parser.parse() {
    dyn entryNode = this.createNode<ASTEntryNode>();

    while !this.currentTokenIs(TokenType::EOF) {
        this.parseTopLevelDef(entryNode);
    }

    // The host lists the children of the entry node grouped by kind: mod attrs, import defs and top level defs
    this.groupEntryChildren(entryNode);

    // Hand over all switch statements of this file
    foreach IVisitable* switchStmt : this.switchStmts {
        entryNode.switchStmts.pushBack(switchStmt);
    }

    return this.concludeNode(entryNode);
}

p Parser.groupEntryChildren(ASTEntryNode* entryNode) {
    ASTNode* entryNodeBase = cast<ASTNode*>(entryNode);
    Vector<ASTNode*> modAttrs;
    Vector<ASTNode*> importDefs;
    Vector<ASTNode*> topLevelDefs;
    foreach ASTNode* child : entryNodeBase.children {
        if this.containsVisitable(entryNode.modAttrs, child.visitable) {
            modAttrs.pushBack(child);
        } else if this.containsVisitable(entryNode.importDefs, child.visitable) {
            importDefs.pushBack(child);
        } else {
            topLevelDefs.pushBack(child);
        }
    }
    entryNodeBase.children.clear();
    foreach ASTNode* child : modAttrs {
        entryNodeBase.children.pushBack(child);
    }
    foreach ASTNode* child : importDefs {
        entryNodeBase.children.pushBack(child);
    }
    foreach ASTNode* child : topLevelDefs {
        entryNodeBase.children.pushBack(child);
    }
}

f<bool> Parser.containsVisitable(const Vector<IVisitable*>& visitables, IVisitable* visitable) {
    foreach IVisitable* candidate : visitables {
        if candidate == visitable {
            return true;
        }
    }
    return false;
}

// entry: (mainFunctionDef | functionDef | procedureDef | structDef | interfaceDef | unionDef | enumDef
//         | genericTypeDef | aliasDef | globalVarDef | importDef | extDecl | modAttr)* EOF;
p Parser.parseTopLevelDef(ASTEntryNode* entryNode) {
    // Constructs that are unambiguous from their first token
    if this.currentTokenIs(TokenType::MOD_ATTR_PREAMBLE) {
        entryNode.modAttrs.pushBack(cast<IVisitable*>(this.parseModAttr()));
        return;
    }
    if this.currentTokenIs(TokenType::IMPORT) {
        entryNode.importDefs.pushBack(cast<IVisitable*>(this.parseImportDef()));
        return;
    }

    // Determine the discriminating token, skipping an optional topLevelDefAttr ('#[...]') and a qualifier list
    long offset = 0l;
    if this.tokenAt(cast<unsigned long>(offset)) == TokenType::FCT_ATTR_PREAMBLE {
        offset++; // '#'
        if this.tokenAt(cast<unsigned long>(offset)) == TokenType::LBRACKET {
            offset = this.matchBalancedGroup(offset, TokenType::LBRACKET, TokenType::RBRACKET);
        }
    }
    while this.isQualifierType(this.tokenAt(cast<unsigned long>(offset))) {
        offset++;
    }
    const TokenType disc = this.tokenAt(cast<unsigned long>(offset));

    if disc == TokenType::EXT {
        entryNode.topLevelDefs.pushBack(cast<IVisitable*>(this.parseExtDecl()));
    } else if disc == TokenType::P {
        entryNode.topLevelDefs.pushBack(cast<IVisitable*>(this.parseProcDef()));
    } else if disc == TokenType::F {
        // mainFunctionDef: 'f' '<' 'int' '>' 'main' ...; everything else starting with 'f' is a functionDef
        const bool isMain = this.tokenAt(cast<unsigned long>(offset + 1l)) == TokenType::LESS
            && this.tokenAt(cast<unsigned long>(offset + 2l)) == TokenType::TYPE_INT
            && this.tokenAt(cast<unsigned long>(offset + 3l)) == TokenType::GREATER
            && this.tokenAt(cast<unsigned long>(offset + 4l)) == TokenType::MAIN;
        if isMain {
            entryNode.topLevelDefs.pushBack(cast<IVisitable*>(this.parseMainFctDef()));
        } else {
            entryNode.topLevelDefs.pushBack(cast<IVisitable*>(this.parseFctDef()));
        }
    } else if disc == TokenType::TYPE {
        // structDef | interfaceDef | unionDef | enumDef | genericTypeDef | aliasDef
        // After 'type' TYPE_IDENTIFIER, decide based on the following keyword / generic list
        long keywordOffset = offset + 2l;
        TokenType after = this.tokenAt(cast<unsigned long>(keywordOffset));
        if after == TokenType::LESS {
            // Generic struct or interface: skip the generic list and look at the keyword behind it
            keywordOffset = this.matchAngleGroup(keywordOffset);
            after = keywordOffset < 0l ? TokenType::INVALID : this.tokenAt(cast<unsigned long>(keywordOffset));
        }
        if after == TokenType::ENUM {
            entryNode.topLevelDefs.pushBack(cast<IVisitable*>(this.parseEnumDef()));
        } else if after == TokenType::ALIAS {
            entryNode.topLevelDefs.pushBack(cast<IVisitable*>(this.parseAliasDef()));
        } else if after == TokenType::INTERFACE {
            entryNode.topLevelDefs.pushBack(cast<IVisitable*>(this.parseInterfaceDef()));
        } else if after == TokenType::STRUCT {
            entryNode.topLevelDefs.pushBack(cast<IVisitable*>(this.parseStructDef()));
        } else if after == TokenType::UNION {
            entryNode.topLevelDefs.pushBack(cast<IVisitable*>(this.parseUnionDef()));
        } else {
            entryNode.topLevelDefs.pushBack(cast<IVisitable*>(this.parseGenericTypeDef()));
        }
    } else {
        entryNode.topLevelDefs.pushBack(cast<IVisitable*>(this.parseGlobalVarDef()));
    }
}

public f<ASTMainFctDefNode*> Parser.parseMainFctDef() {
    dyn mainFctDefNode = this.createNode<ASTMainFctDefNode>();

    // Parse topLevelDefAttr
    if this.currentTokenIs(TokenType::FCT_ATTR_PREAMBLE) {
        ASTTopLevelDefAttrNode* attrs = this.parseTopLevelDefAttr();
        mainFctDefNode.attrs = attrs;
    }

    // Consume expected tokens 'f<int> main'
    this.expect(TokenType::F);
    this.expect(TokenType::LESS);
    this.expect(TokenType::TYPE_INT);
    this.consumeGenericClose();
    this.expect(TokenType::MAIN);

    // Parse pramLst
    this.expect(TokenType::LPAREN);
    if !this.currentTokenIs(TokenType::RPAREN) {
        mainFctDefNode.takesArgs = true;
        ASTParamLstNode* paramLst = this.parseParamLst();
        mainFctDefNode.paramLst = paramLst;
    }
    this.expect(TokenType::RPAREN);

    // Parse stmtLst
    ASTStmtLstNode* body = this.parseStmtLst();
    mainFctDefNode.body = body;

    return this.concludeNode(mainFctDefNode);
}

public f<ASTFctDefNode*> Parser.parseFctDef() {
    dyn fctDefNode = this.createNode<ASTFctDefNode>();

    // Parse topLevelDefAttr
    if this.currentTokenIs(TokenType::FCT_ATTR_PREAMBLE) {
        ASTTopLevelDefAttrNode* attrs = this.parseTopLevelDefAttr();
        fctDefNode.attrs = attrs;
        // Tell the attributes that they are function attributes (matches host semantics)
        foreach ASTAttrNode* attr : attrs.attrLst.attributes {
            attr.target = AttrTarget::TARGET_FCT_PROC;
        }
    }

    // Parse qualifierLst
    if !this.currentTokenIs(TokenType::F) {
        fctDefNode.qualifierLst = this.parseQualifierLst();
    }

    this.expect(TokenType::F);
    this.expect(TokenType::LESS);
    fctDefNode.returnType = this.parseDataType();
    fctDefNode.returnType.isReturnType = true;
    this.consumeGenericClose();
    fctDefNode.name = this.parseFctName();
    fctDefNode.isMethod = fctDefNode.name.nameFragments.getSize() > 1l;

    // Parse typeLst (template type list)
    if this.isGenericOpenAhead() {
        fctDefNode.hasTemplateTypes = true;
        this.consumeGenericOpen();
        fctDefNode.templateTypeLst = this.parseTypeLst();
        this.consumeGenericClose();
    }

    // Parse paramLst
    this.expect(TokenType::LPAREN);
    if !this.currentTokenIs(TokenType::RPAREN) {
        fctDefNode.hasParams = true;
        ASTParamLstNode* paramLst = this.parseParamLst();
        fctDefNode.paramLst = paramLst;
    }
    this.expect(TokenType::RPAREN);

    // Parse stmtLst
    ASTStmtLstNode* body = this.parseStmtLst();
    fctDefNode.body = body;

    return this.concludeNode(fctDefNode);
}

public f<ASTProcDefNode*> Parser.parseProcDef() {
    dyn procDefNode = this.createNode<ASTProcDefNode>();

    // Parse topLevelDefAttr
    if this.currentTokenIs(TokenType::FCT_ATTR_PREAMBLE) {
        ASTTopLevelDefAttrNode* attrs = this.parseTopLevelDefAttr();
        procDefNode.attrs = attrs;
        // Tell the attributes that they are function attributes (matches host semantics)
        foreach ASTAttrNode* attr : attrs.attrLst.attributes {
            attr.target = AttrTarget::TARGET_FCT_PROC;
        }
    }

    // Parse qualifierLst
    if !this.currentTokenIs(TokenType::P) {
        procDefNode.qualifierLst = this.parseQualifierLst();
    }

    this.expect(TokenType::P);
    procDefNode.name = this.parseFctName();
    procDefNode.isMethod = procDefNode.name.nameFragments.getSize() > 1l;
    // Note: isCtor is derived later, by SymbolTableBuilder (matches host: it is set from
    // name->nameFragments.back() == CTOR_FUNCTION_NAME during symbol-table building, not parsing).

    // Parse typeLst (template type list)
    if this.isGenericOpenAhead() {
        procDefNode.hasTemplateTypes = true;
        this.consumeGenericOpen();
        procDefNode.templateTypeLst = this.parseTypeLst();
        this.consumeGenericClose();
    }

    // Parse paramLst
    this.expect(TokenType::LPAREN);
    if !this.currentTokenIs(TokenType::RPAREN) {
        procDefNode.hasParams = true;
        ASTParamLstNode* paramLst = this.parseParamLst();
        procDefNode.paramLst = paramLst;
    }
    this.expect(TokenType::RPAREN);

    // Parse stmtLst
    ASTStmtLstNode* body = this.parseStmtLst();
    procDefNode.body = body;

    return this.concludeNode(procDefNode);
}

f<ASTFctNameNode*> Parser.parseFctName() {
    dyn fctNameNode = this.createNode<ASTFctNameNode>();

    if this.currentTokenIs(TokenType::OPERATOR) {
        this.expect(TokenType::OPERATOR);
        const String opName = this.parseOverloadableOp();
        fctNameNode.name = opName;
        fctNameNode.fqName = opName;
        fctNameNode.nameFragments.pushBack(opName);
    } else {
        if this.currentTokenIs(TokenType::TYPE_IDENTIFIER) {
            const String structName = this.getIdentifier(true);
            fctNameNode.structName = structName;
            fctNameNode.nameFragments.pushBack(structName);
            this.expect(TokenType::TYPE_IDENTIFIER);
            this.expect(TokenType::DOT);
        }
        const String name = this.getIdentifier(false);
        fctNameNode.name = name;
        fctNameNode.nameFragments.pushBack(name);
        this.expect(TokenType::IDENTIFIER);

        // Build the fully-qualified name (matches host's MEMBER_ACCESS_TOKEN-joined fqName)
        if !fctNameNode.structName.isEmpty() {
            fctNameNode.fqName = fctNameNode.structName + MEMBER_ACCESS_TOKEN + name;
        } else {
            fctNameNode.fqName = name;
        }
    }

    return this.concludeNode(fctNameNode);
}

// overloadableOp: PLUS | MINUS | MUL | DIV | EQUAL | NOT_EQUAL | LESS | GREATER | LESS_EQUAL | GREATER_EQUAL | LESS LESS
//               | GREATER GREATER | BITWISE_AND | BITWISE_OR | BITWISE_XOR | BITWISE_NOT | PLUS_EQUAL | MINUS_EQUAL | MUL_EQUAL
//               | DIV_EQUAL | PLUS_PLUS | MINUS_MINUS | LBRACKET RBRACKET | ASSIGN;
// Note: the lexer merges '<<' and '>>' into single SHL / SHR tokens. Returns the mangled op.* function
// name for the matched operator (matches host's ASTBuilder::visitOverloadableOp mapping).
f<String> Parser.parseOverloadableOp() {
    const TokenType tok = this.lexer.getToken().tokenType;
    String name;
    if tok == TokenType::PLUS {
        name = String(OP_FCT_PLUS);
    } else if tok == TokenType::MINUS {
        name = String(OP_FCT_MINUS);
    } else if tok == TokenType::MUL {
        name = String(OP_FCT_MUL);
    } else if tok == TokenType::DIV {
        name = String(OP_FCT_DIV);
    } else if tok == TokenType::EQUAL {
        name = String(OP_FCT_EQUAL);
    } else if tok == TokenType::NOT_EQUAL {
        name = String(OP_FCT_NOT_EQUAL);
    } else if tok == TokenType::LESS {
        name = String(OP_FCT_LESS);
    } else if tok == TokenType::GREATER {
        name = String(OP_FCT_GREATER);
    } else if tok == TokenType::LESS_EQUAL {
        name = String(OP_FCT_LESS_EQUAL);
    } else if tok == TokenType::GREATER_EQUAL {
        name = String(OP_FCT_GREATER_EQUAL);
    } else if tok == TokenType::SHL {
        // '<<' is the shift left operator, if the parameter list or a template type list follows. Otherwise, it is the less
        // operator, followed by the opening '<' of a template type list (e.g. 'operator<<T>(...)'), which stays pending
        const TokenType nextTok = this.tokenAt(1l);
        if nextTok == TokenType::LPAREN || nextTok == TokenType::LESS {
            name = String(OP_FCT_SHL);
        } else {
            name = String(OP_FCT_LESS);
            this.pendingLess = true;
        }
    } else if tok == TokenType::SHR {
        name = String(OP_FCT_SHR);
    } else if tok == TokenType::BITWISE_AND {
        name = String(OP_FCT_BITWISE_AND);
    } else if tok == TokenType::BITWISE_OR {
        name = String(OP_FCT_BITWISE_OR);
    } else if tok == TokenType::BITWISE_XOR {
        name = String(OP_FCT_BITWISE_XOR);
    } else if tok == TokenType::BITWISE_NOT {
        name = String(OP_FCT_BITWISE_NOT);
    } else if tok == TokenType::PLUS_EQUAL {
        name = String(OP_FCT_PLUS_EQUAL);
    } else if tok == TokenType::MINUS_EQUAL {
        name = String(OP_FCT_MINUS_EQUAL);
    } else if tok == TokenType::MUL_EQUAL {
        name = String(OP_FCT_MUL_EQUAL);
    } else if tok == TokenType::DIV_EQUAL {
        name = String(OP_FCT_DIV_EQUAL);
    } else if tok == TokenType::PLUS_PLUS {
        name = String(OP_FCT_POSTFIX_PLUS_PLUS);
    } else if tok == TokenType::MINUS_MINUS {
        name = String(OP_FCT_POSTFIX_MINUS_MINUS);
    } else if tok == TokenType::ASSIGN {
        name = String(OP_FCT_ASSIGN);
    }

    if tok == TokenType::LBRACKET { // Subscript operator '[]'
        this.expect(TokenType::LBRACKET);
        this.expect(TokenType::RBRACKET);
        name = String(OP_FCT_SUBSCRIPT);
    } else {
        // All remaining overloadable operators are a single token
        this.advance();
    }
    return name;
}

// Override the type id of a struct, interface or union, if the fixed type id attribute is set
p Parser.applyFixedTypeId(ASTTopLevelDefAttrNode* attrs, unsigned long& typeId) {
    const String fixedTypeIdKey = String(ATTR_CORE_COMPILER_FIXED_TYPE_ID);
    if attrs.attrLst.hasAttr(fixedTypeIdKey) {
        const CompileTimeValue value = attrs.attrLst.getAttrValueByName(fixedTypeIdKey);
        typeId = cast<unsigned long>(value.getIntValue());
    }
}

f<ASTStructDefNode*> Parser.parseStructDef() {
    dyn structDefNode = this.createNode<ASTStructDefNode>();
    structDefNode.typeId = this.resourceManager.getNextCustomTypeId();

    // Parse topLevelDefAttr
    if this.currentTokenIs(TokenType::FCT_ATTR_PREAMBLE) {
        ASTTopLevelDefAttrNode* attrs = this.parseTopLevelDefAttr();
        structDefNode.attrs = attrs;
        // Tell the attributes that they are struct attributes (matches host semantics)
        foreach ASTAttrNode* attr : attrs.attrLst.attributes {
            attr.target = AttrTarget::TARGET_STRUCT;
        }
        // Check if a custom type id was set
        this.applyFixedTypeId(attrs, structDefNode.typeId);
    }

    // Parse qualifierLst
    if !this.currentTokenIs(TokenType::TYPE) {
        structDefNode.qualifierLst = this.parseQualifierLst();
    }

    this.expect(TokenType::TYPE);
    structDefNode.structName = this.getIdentifier(true);
    this.expect(TokenType::TYPE_IDENTIFIER);

    // Parse typeLst (template type list)
    if this.currentTokenIs(TokenType::LESS) {
        structDefNode.hasTemplateTypes = true;
        this.expect(TokenType::LESS);
        structDefNode.templateTypeLst = this.parseTypeLst();
        this.consumeGenericClose();
    }

    this.expect(TokenType::STRUCT);

    // Parse typeLst (implemented interfaces)
    if this.currentTokenIs(TokenType::COLON) {
        structDefNode.hasInterfaces = true;
        this.expect(TokenType::COLON);
        structDefNode.interfaceTypeLst = this.parseTypeLst();
    }

    // Parse fieldLst
    this.expect(TokenType::LBRACE);
    while !this.currentTokenIs(TokenType::RBRACE) {
        structDefNode.fields.pushBack(cast<IVisitable*>(this.parseField()));
    }
    this.expect(TokenType::RBRACE);

    return this.concludeNode(structDefNode);
}

f<ASTInterfaceDefNode*> Parser.parseInterfaceDef() {
    dyn interfaceDefNode = this.createNode<ASTInterfaceDefNode>();
    interfaceDefNode.typeId = this.resourceManager.getNextCustomTypeId();

    // Parse topLevelDefAttr
    if this.currentTokenIs(TokenType::FCT_ATTR_PREAMBLE) {
        ASTTopLevelDefAttrNode* attrs = this.parseTopLevelDefAttr();
        interfaceDefNode.attrs = attrs;
        // Tell the attributes that they are interface attributes (matches host semantics)
        foreach ASTAttrNode* attr : attrs.attrLst.attributes {
            attr.target = AttrTarget::TARGET_INTERFACE;
        }
        // Check if a custom type id was set
        this.applyFixedTypeId(attrs, interfaceDefNode.typeId);
    }

    // Parse qualifierLst
    if !this.currentTokenIs(TokenType::TYPE) {
        interfaceDefNode.qualifierLst = this.parseQualifierLst();
    }

    this.expect(TokenType::TYPE);
    interfaceDefNode.interfaceName = this.getIdentifier(true);
    this.expect(TokenType::TYPE_IDENTIFIER);

    // Parse typeLst (template type list)
    if this.currentTokenIs(TokenType::LESS) {
        interfaceDefNode.hasTemplateTypes = true;
        this.expect(TokenType::LESS);
        interfaceDefNode.templateTypeLst = this.parseTypeLst();
        this.consumeGenericClose();
    }

    this.expect(TokenType::INTERFACE);

    // Parse signatures
    this.expect(TokenType::LBRACE);
    while !this.currentTokenIs(TokenType::RBRACE) && !this.currentTokenIs(TokenType::EOF) {
        interfaceDefNode.signatures.pushBack(cast<IVisitable*>(this.parseSignature()));
    }
    this.expect(TokenType::RBRACE);

    return this.concludeNode(interfaceDefNode);
}

f<ASTUnionDefNode*> Parser.parseUnionDef() {
    dyn unionDefNode = this.createNode<ASTUnionDefNode>();
    unionDefNode.typeId = this.resourceManager.getNextCustomTypeId();

    // Parse topLevelDefAttr
    if this.currentTokenIs(TokenType::FCT_ATTR_PREAMBLE) {
        ASTTopLevelDefAttrNode* attrs = this.parseTopLevelDefAttr();
        unionDefNode.attrs = attrs;
        // Tell the attributes that they are union attributes (matches host semantics)
        foreach ASTAttrNode* attr : attrs.attrLst.attributes {
            attr.target = AttrTarget::TARGET_UNION;
        }
        // Check if a custom type id was set
        this.applyFixedTypeId(attrs, unionDefNode.typeId);
    }

    // Parse qualifierLst
    if !this.currentTokenIs(TokenType::TYPE) {
        unionDefNode.qualifierLst = this.parseQualifierLst();
    }

    this.expect(TokenType::TYPE);
    unionDefNode.unionName = this.getIdentifier(true);
    this.expect(TokenType::TYPE_IDENTIFIER);

    // Parse typeLst (template type list)
    if this.currentTokenIs(TokenType::LESS) {
        unionDefNode.hasTemplateTypes = true;
        this.expect(TokenType::LESS);
        unionDefNode.templateTypeLst = this.parseTypeLst();
        this.consumeGenericClose();
    }

    this.expect(TokenType::UNION);

    // Parse fieldLst
    this.expect(TokenType::LBRACE);
    while !this.currentTokenIs(TokenType::RBRACE) {
        unionDefNode.fields.pushBack(cast<IVisitable*>(this.parseField()));
    }
    this.expect(TokenType::RBRACE);

    return this.concludeNode(unionDefNode);
}

f<ASTEnumDefNode*> Parser.parseEnumDef() {
    dyn enumDefNode = this.createNode<ASTEnumDefNode>();
    enumDefNode.typeId = this.resourceManager.getNextCustomTypeId();

    // Parse qualifierLst
    if !this.currentTokenIs(TokenType::TYPE) {
        enumDefNode.qualifierLst = this.parseQualifierLst();
    }

    this.expect(TokenType::TYPE);
    enumDefNode.enumName = this.getIdentifier(true);
    this.expect(TokenType::TYPE_IDENTIFIER);
    this.expect(TokenType::ENUM);

    // Parse enumItemLst
    this.expect(TokenType::LBRACE);
    ASTEnumItemLstNode* itemLst = this.parseEnumItemLst();
    enumDefNode.itemLst = itemLst;
    // Back-link every item to its enclosing enum def (matches host semantics)
    foreach ASTEnumItemNode* item : itemLst.items {
        item.enumDef = enumDefNode;
    }
    this.expect(TokenType::RBRACE);

    return this.concludeNode(enumDefNode);
}

f<ASTGenericTypeDefNode*> Parser.parseGenericTypeDef() {
    dyn genericTypeDefNode = this.createNode<ASTGenericTypeDefNode>();

    this.expect(TokenType::TYPE);
    genericTypeDefNode.typeName = this.getIdentifier(true);
    this.expect(TokenType::TYPE_IDENTIFIER);
    genericTypeDefNode.typeAltsLst = cast<IVisitable*>(this.parseTypeAltsLst());
    this.expect(TokenType::SEMICOLON);

    return this.concludeNode(genericTypeDefNode);
}

f<ASTAliasDefNode*> Parser.parseAliasDef() {
    dyn aliasDefNode = this.createNode<ASTAliasDefNode>();
    aliasDefNode.typeId = this.resourceManager.getNextCustomTypeId();

    // Parse qualifierLst
    if !this.currentTokenIs(TokenType::TYPE) {
        aliasDefNode.qualifierLst = this.parseQualifierLst();
    }

    this.expect(TokenType::TYPE);
    aliasDefNode.aliasName = this.getIdentifier(true);
    this.expect(TokenType::TYPE_IDENTIFIER);
    this.expect(TokenType::ALIAS);
    const unsigned long dataTypeStartIdx = this.lexer.getTokenIndex();
    aliasDefNode.dataType = this.parseDataType();
    aliasDefNode.dataTypeString = this.lexer.getTokenText(dataTypeStartIdx, this.lexer.getTokenIndex());
    this.expect(TokenType::SEMICOLON);

    return this.concludeNode(aliasDefNode);
}

f<ASTGlobalVarDefNode*> Parser.parseGlobalVarDef() {
    dyn globalVarDefNode = this.createNode<ASTGlobalVarDefNode>();

    globalVarDefNode.dataType = this.parseDataType();
    globalVarDefNode.dataType.isGlobalType = true;
    globalVarDefNode.varName = this.getIdentifier(true);
    this.expect(TokenType::TYPE_IDENTIFIER);

    // Parse initializer
    if this.currentTokenIs(TokenType::ASSIGN) {
        this.expect(TokenType::ASSIGN);
        globalVarDefNode.hasValue = true;
        globalVarDefNode.constant = this.parseConstant();
    }

    this.expect(TokenType::SEMICOLON);

    return this.concludeNode(globalVarDefNode);
}

f<ASTExtDeclNode*> Parser.parseExtDecl() {
    dyn extDeclNode = this.createNode<ASTExtDeclNode>();

    // Parse topLevelDefAttr
    if this.currentTokenIs(TokenType::FCT_ATTR_PREAMBLE) {
        ASTTopLevelDefAttrNode* attrs = this.parseTopLevelDefAttr();
        extDeclNode.attrs = attrs;
        // Tell the attributes that they are ext-decl attributes (matches host semantics)
        foreach ASTAttrNode* attr : attrs.attrLst.attributes {
            attr.target = AttrTarget::TARGET_EXT_DECL;
        }
    }

    this.expect(TokenType::EXT);

    // Parse parse function prefix / procedure prefix
    if this.currentTokenIs(TokenType::F) {
        this.expect(TokenType::F);
        this.expect(TokenType::LESS);
        extDeclNode.returnType = this.parseDataType();
        extDeclNode.returnType.isReturnType = true;
        this.consumeGenericClose();
    } else {
        this.expect(TokenType::P);
    }

    // Parse external function name
    extDeclNode.extFunctionName = this.getIdentifier(false);
    if this.currentTokenIs(TokenType::IDENTIFIER) {
        this.expect(TokenType::IDENTIFIER);
    } else {
        this.expect(TokenType::TYPE_IDENTIFIER);
    }

    // Parse typeLstWithEllipsis
    this.expect(TokenType::LPAREN);
    if !this.currentTokenIs(TokenType::RPAREN) {
        extDeclNode.hasArgs = true;
        extDeclNode.argTypeLst = cast<IVisitable*>(this.parseTypeLstWithEllipsis());
    }
    this.expect(TokenType::RPAREN);

    this.expect(TokenType::SEMICOLON);

    return this.concludeNode(extDeclNode);
}

f<ASTImportDefNode*> Parser.parseImportDef() {
    dyn importDefNode = this.createNode<ASTImportDefNode>();

    this.expect(TokenType::IMPORT);
    // The lexer already strips the surrounding quotes for STRING_LIT tokens, so .text is the raw path.
    importDefNode.importPath = this.lexer.getToken().text;
    this.expect(TokenType::STRING_LIT);

    if this.currentTokenIs(TokenType::AS) {
        this.expect(TokenType::AS);
        importDefNode.importName = this.getIdentifier(false);
        this.expect(TokenType::IDENTIFIER);
    } else {
        // If no name is given, use the path as the name (matches host semantics)
        importDefNode.importName = importDefNode.importPath;
    }
    this.expect(TokenType::SEMICOLON);

    return this.concludeNode(importDefNode);
}

f<ASTUnsafeBlockNode*> Parser.parseUnsafeBlock() {
    dyn unsafeBlockNode = this.createNode<ASTUnsafeBlockNode>();

    this.expect(TokenType::UNSAFE);
    ASTStmtLstNode* body = this.parseStmtLst();
    unsafeBlockNode.body = body;

    return this.concludeNode(unsafeBlockNode);
}

f<ASTForLoopNode*> Parser.parseForLoop() {
    dyn forLoopNode = this.createNode<ASTForLoopNode>();

    this.expect(TokenType::FOR);

    // Parse head
    if this.currentTokenIs(TokenType::LPAREN) {
        this.expect(TokenType::LPAREN);
        this.parseForHead(forLoopNode);
        this.expect(TokenType::RPAREN);
    } else {
        this.parseForHead(forLoopNode);
    }

    // Parse stmtLst
    forLoopNode.body = this.parseStmtLst();

    return this.concludeNode(forLoopNode);
}

p Parser.parseForHead(ASTForLoopNode* forLoopNode) {
    forLoopNode.initDecl = this.parseDeclStmt();
    this.expect(TokenType::SEMICOLON);
    forLoopNode.condAssign = this.parseAssignExpr();
    this.expect(TokenType::SEMICOLON);
    forLoopNode.incAssign = this.parseAssignExpr();
}

f<ASTForeachLoopNode*> Parser.parseForeachLoop() {
    dyn foreachLoopNode = this.createNode<ASTForeachLoopNode>();

    this.expect(TokenType::FOREACH);

    // Parse head
    if this.currentTokenIs(TokenType::LPAREN) {
        this.expect(TokenType::LPAREN);
        this.parseForeachHead(foreachLoopNode);
        this.expect(TokenType::RPAREN);
    } else {
        this.parseForeachHead(foreachLoopNode);
    }

    // Parse stmtLst
    foreachLoopNode.body = this.parseStmtLst();

    return this.concludeNode(foreachLoopNode);
}

p Parser.parseForeachHead(ASTForeachLoopNode* foreachLoopNode) {
    ASTDeclStmtNode* itemVarDecl = this.parseDeclStmt();
    if this.currentTokenIs(TokenType::COMMA) {
        // Two declarations given: the first is the index, the second is the item
        foreachLoopNode.idxVarDecl = itemVarDecl;
        this.expect(TokenType::COMMA);
        itemVarDecl = this.parseDeclStmt();
    }
    foreachLoopNode.itemVarDecl = itemVarDecl;
    itemVarDecl.isForEachItem = true;
    this.expect(TokenType::COLON);
    foreachLoopNode.iteratorAssign = this.parseAssignExpr();
}

f<ASTWhileLoopNode*> Parser.parseWhileLoop() {
    dyn whileLoopNode = this.createNode<ASTWhileLoopNode>();

    this.expect(TokenType::WHILE);

    // Parse head
    whileLoopNode.condition = this.parseAssignExpr();

    // Parse stmtLst
    whileLoopNode.body = this.parseStmtLst();

    return this.concludeNode(whileLoopNode);
}

f<ASTDoWhileLoopNode*> Parser.parseDoWhileLoop() {
    dyn doWhileLoopNode = this.createNode<ASTDoWhileLoopNode>();

    this.expect(TokenType::DO);

    // Parse stmtLst
    doWhileLoopNode.body = this.parseStmtLst();

    // Parse foot
    this.expect(TokenType::WHILE);
    doWhileLoopNode.condition = this.parseAssignExpr();
    this.expect(TokenType::SEMICOLON);

    return this.concludeNode(doWhileLoopNode);
}

f<ASTIfStmtNode*> Parser.parseIfStmt() {
    dyn ifStmtNode = this.createNode<ASTIfStmtNode>();

    this.expect(TokenType::IF);

    // Parse head
    ifStmtNode.condition = this.parseAssignExpr();

    // Parse stmtLst
    ifStmtNode.thenBody = this.parseStmtLst();

    // Parse else
    if this.currentTokenIs(TokenType::ELSE) {
        ifStmtNode.elseStmt = this.parseElseStmt();
    }

    return this.concludeNode(ifStmtNode);
}

f<ASTElseStmtNode*> Parser.parseElseStmt() {
    dyn elseStmtNode = this.createNode<ASTElseStmtNode>();

    this.expect(TokenType::ELSE);

    if this.currentTokenIs(TokenType::IF) { // Else if
        elseStmtNode.isElseIf = true;
        elseStmtNode.ifStmt = this.parseIfStmt();
    } else { // Else
        elseStmtNode.body = this.parseStmtLst();
    }

    return this.concludeNode(elseStmtNode);
}

f<ASTSwitchStmtNode*> Parser.parseSwitchStmt() {
    dyn switchStmtNode = this.createNode<ASTSwitchStmtNode>();

    this.expect(TokenType::SWITCH);
    switchStmtNode.assignExpr = this.parseAssignExpr();
    this.expect(TokenType::LBRACE);
    while this.currentTokenIs(TokenType::CASE) {
        switchStmtNode.caseBranches.pushBack(cast<IVisitable*>(this.parseCaseBranch()));
    }
    if this.currentTokenIs(TokenType::DEFAULT) {
        switchStmtNode.hasDefaultBranch = true;
        switchStmtNode.defaultBranch = cast<IVisitable*>(this.parseDefaultBranch());
    }
    this.expect(TokenType::RBRACE);

    // Remember the switch statement, so that later passes can access all switch statements without walking the whole AST
    this.switchStmts.pushBack(cast<IVisitable*>(switchStmtNode));

    return this.concludeNode(switchStmtNode);
}

f<ASTCaseBranchNode*> Parser.parseCaseBranch() {
    dyn caseBranchNode = this.createNode<ASTCaseBranchNode>();

    this.expect(TokenType::CASE);
    caseBranchNode.caseConstants.pushBack(cast<IVisitable*>(this.parseCaseConstant()));
    while this.currentTokenIs(TokenType::COMMA) {
        this.expect(TokenType::COMMA);
        caseBranchNode.caseConstants.pushBack(cast<IVisitable*>(this.parseCaseConstant()));
    }
    this.expect(TokenType::COLON);
    caseBranchNode.body = this.parseStmtLst();

    return this.concludeNode(caseBranchNode);
}

f<ASTDefaultBranchNode*> Parser.parseDefaultBranch() {
    dyn defaultBranchNode = this.createNode<ASTDefaultBranchNode>();

    this.expect(TokenType::DEFAULT);
    this.expect(TokenType::COLON);
    defaultBranchNode.body = this.parseStmtLst();

    return this.concludeNode(defaultBranchNode);
}

f<ASTAnonymousBlockStmtNode*> Parser.parseAnonymousBlockStmt() {
    dyn anonymousBlockStmtNode = this.createNode<ASTAnonymousBlockStmtNode>();

    anonymousBlockStmtNode.body = this.parseStmtLst();

    return this.concludeNode(anonymousBlockStmtNode);
}

// stmtLst: LBRACE (stmt | forLoop | foreachLoop | whileLoop | doWhileLoop | ifStmt | switchStmt
//                   | assertStmt | unsafeBlock | anonymousBlockStmt)* RBRACE;
f<ASTStmtLstNode*> Parser.parseStmtLst() {
    dyn stmtLstNode = this.createNode<ASTStmtLstNode>();

    this.expect(TokenType::LBRACE);
    while !this.currentTokenIs(TokenType::RBRACE) && !this.currentTokenIs(TokenType::EOF) {
        if this.currentTokenIs(TokenType::FOR) {
            stmtLstNode.statements.pushBack(cast<IVisitable*>(this.parseForLoop()));
        } else if this.currentTokenIs(TokenType::FOREACH) {
            stmtLstNode.statements.pushBack(cast<IVisitable*>(this.parseForeachLoop()));
        } else if this.currentTokenIs(TokenType::WHILE) {
            stmtLstNode.statements.pushBack(cast<IVisitable*>(this.parseWhileLoop()));
        } else if this.currentTokenIs(TokenType::DO) {
            stmtLstNode.statements.pushBack(cast<IVisitable*>(this.parseDoWhileLoop()));
        } else if this.currentTokenIs(TokenType::IF) {
            stmtLstNode.statements.pushBack(cast<IVisitable*>(this.parseIfStmt()));
        } else if this.currentTokenIs(TokenType::SWITCH) {
            stmtLstNode.statements.pushBack(cast<IVisitable*>(this.parseSwitchStmt()));
        } else if this.currentTokenIs(TokenType::ASSERT) {
            stmtLstNode.statements.pushBack(cast<IVisitable*>(this.parseAssertStmt()));
        } else if this.currentTokenIs(TokenType::UNSAFE) {
            stmtLstNode.statements.pushBack(cast<IVisitable*>(this.parseUnsafeBlock()));
        } else if this.currentTokenIs(TokenType::LBRACE) {
            stmtLstNode.statements.pushBack(cast<IVisitable*>(this.parseAnonymousBlockStmt()));
        } else {
            stmtLstNode.statements.pushBack(this.parseStmt());
        }
    }
    stmtLstNode.closingBraceCodeLoc = this.lexer.getCodeLoc();
    this.expect(TokenType::RBRACE);

    return this.concludeNode(stmtLstNode);
}

f<ASTTypeLstNode*> Parser.parseTypeLst() {
    dyn typeLstNode = this.createNode<ASTTypeLstNode>();

    typeLstNode.dataTypes.pushBack(this.parseDataType());
    while this.currentTokenIs(TokenType::COMMA) {
        this.expect(TokenType::COMMA);
        typeLstNode.dataTypes.pushBack(this.parseDataType());
    }

    return this.concludeNode(typeLstNode);
}

// typeLstWithEllipsis: typeLst (COMMA ELLIPSIS)?;
f<ASTTypeLstWithEllipsisNode*> Parser.parseTypeLstWithEllipsis() {
    dyn typeLstWithEllipsisNode = this.createNode<ASTTypeLstWithEllipsisNode>();

    // Parse typeLst. A comma, which is followed by an ellipsis, does not belong to the type list
    dyn typeLstNode = this.createNode<ASTTypeLstNode>();
    typeLstNode.dataTypes.pushBack(this.parseDataType());
    while this.currentTokenIs(TokenType::COMMA) && this.tokenAt(1l) != TokenType::ELLIPSIS {
        this.expect(TokenType::COMMA);
        typeLstNode.dataTypes.pushBack(this.parseDataType());
    }
    typeLstWithEllipsisNode.typeLst = this.concludeNode(typeLstNode);

    // Parse optional ellipsis
    if this.currentTokenIs(TokenType::COMMA) {
        this.expect(TokenType::COMMA);
        this.expect(TokenType::ELLIPSIS);
        typeLstWithEllipsisNode.hasEllipsis = true;
    }

    return this.concludeNode(typeLstWithEllipsisNode);
}

f<ASTTypeAltsLstNode*> Parser.parseTypeAltsLst() {
    dyn typeAltsLstNode = this.createNode<ASTTypeAltsLstNode>();

    typeAltsLstNode.dataTypes.pushBack(this.parseDataType());
    while this.currentTokenIs(TokenType::BITWISE_OR) {
        this.expect(TokenType::BITWISE_OR);
        typeAltsLstNode.dataTypes.pushBack(this.parseDataType());
    }

    return this.concludeNode(typeAltsLstNode);
}

f<ASTParamLstNode*> Parser.parseParamLst() {
    dyn paramLstNode = this.createNode<ASTParamLstNode>();

    paramLstNode.params.pushBack(this.parseDeclStmt());
    while this.currentTokenIs(TokenType::COMMA) {
        this.expect(TokenType::COMMA);
        paramLstNode.params.pushBack(this.parseDeclStmt());
    }

    // Mark each declaration as a function parameter (matches host semantics)
    foreach ASTDeclStmtNode* param : paramLstNode.params {
        param.isFctParam = true;
        param.dataType.isParamType = true;
    }

    return this.concludeNode(paramLstNode);
}

f<ASTArgLstNode*> Parser.parseArgLst() {
    dyn argLstNode = this.createNode<ASTArgLstNode>();

    argLstNode.args.pushBack(this.parseAssignExpr());
    while this.currentTokenIs(TokenType::COMMA) {
        this.expect(TokenType::COMMA);
        argLstNode.args.pushBack(this.parseAssignExpr());
    }

    return this.concludeNode(argLstNode);
}

f<ASTEnumItemLstNode*> Parser.parseEnumItemLst() {
    dyn enumItemLstNode = this.createNode<ASTEnumItemLstNode>();

    enumItemLstNode.items.pushBack(this.parseEnumItem());
    while this.currentTokenIs(TokenType::COMMA) {
        this.expect(TokenType::COMMA);
        enumItemLstNode.items.pushBack(this.parseEnumItem());
    }

    return this.concludeNode(enumItemLstNode);
}

f<ASTEnumItemNode*> Parser.parseEnumItem() {
    dyn enumItemNode = this.createNode<ASTEnumItemNode>();

    enumItemNode.itemName = this.getIdentifier(false);
    this.expect(TokenType::TYPE_IDENTIFIER);
    if this.currentTokenIs(TokenType::ASSIGN) {
        this.expect(TokenType::ASSIGN);
        enumItemNode.hasValue = true;
        enumItemNode.itemValue = cast<unsigned int>(this.parseNumeric(this.lexer.getToken(), false, 32));
        this.expect(TokenType::INT_LIT);
    }

    return this.concludeNode(enumItemNode);
}

f<ASTFieldNode*> Parser.parseField() {
    dyn fieldNode = this.createNode<ASTFieldNode>();

    // Mark the data type and all its template types as field types (host: DataTypeNode::setFieldTypeRecursive)
    this.isParsingFieldType = true;
    fieldNode.dataType = this.parseDataType();
    this.isParsingFieldType = false;
    fieldNode.fieldName = this.getIdentifier(false);
    this.expect(TokenType::IDENTIFIER);

    if this.currentTokenIs(TokenType::ASSIGN) {
        this.expect(TokenType::ASSIGN);
        fieldNode.defaultValue = this.parseTernaryExpr();
    }

    return this.concludeNode(fieldNode);
}

f<ASTSignatureNode*> Parser.parseSignature() {
    dyn signatureNode = this.createNode<ASTSignatureNode>();

    // Parse qualifierLst
    const dyn options = [TokenType::F, TokenType::P];
    if !this.currentTokenIsOneOf(options, len(options)) {
        signatureNode.qualifierLst = this.parseQualifierLst();
    }

    if this.currentTokenIs(TokenType::F) {
        this.expect(TokenType::F);
        this.expect(TokenType::LESS);
        signatureNode.hasReturnType = true;
        signatureNode.signatureType = SignatureType::TYPE_FUNCTION;
        signatureNode.signatureQualifiers = getTypeQualifiersOf(SuperType::TY_FUNCTION);
        signatureNode.returnType = this.parseDataType();
        this.consumeGenericClose();
    } else {
        this.expect(TokenType::P);
        signatureNode.signatureType = SignatureType::TYPE_PROCEDURE;
        signatureNode.signatureQualifiers = getTypeQualifiersOf(SuperType::TY_PROCEDURE);
    }

    // Parse function name
    signatureNode.methodName = this.getIdentifier(false);
    this.expect(TokenType::IDENTIFIER);

    // Parse typeLst (template type list)
    if this.currentTokenIs(TokenType::LESS) {
        this.expect(TokenType::LESS);
        signatureNode.hasTemplateTypes = true;
        signatureNode.templateTypeLst = this.parseTypeLst();
        this.consumeGenericClose();
    }

    // Parse typeLst
    this.expect(TokenType::LPAREN);
    if !this.currentTokenIs(TokenType::RPAREN) {
        signatureNode.hasParams = true;
        signatureNode.paramTypeLst = this.parseTypeLst();
    }
    this.expect(TokenType::RPAREN);

    this.expect(TokenType::SEMICOLON);

    return this.concludeNode(signatureNode);
}

// stmt: (declStmt | exprStmt | returnStmt | breakStmt | continueStmt | fallthroughStmt) SEMICOLON;
// Returns the actual matched node (as IVisitable*), not a generic wrapper, matching host's
// ASTBuilder::visitStmt (which upcasts whichever alternative matched to the common StmtNode* type).
f<IVisitable*> Parser.parseStmt() {
    IVisitable* stmtNode = nil<IVisitable*>;

    if this.currentTokenIs(TokenType::RETURN) {
        stmtNode = this.parseReturnStmt();
    } else if this.currentTokenIs(TokenType::BREAK) {
        stmtNode = this.parseBreakStmt();
    } else if this.currentTokenIs(TokenType::CONTINUE) {
        stmtNode = this.parseContinueStmt();
    } else if this.currentTokenIs(TokenType::FALLTHROUGH) {
        stmtNode = this.parseFallthroughStmt();
    } else if this.isDeclStmtAhead() {
        stmtNode = this.parseDeclStmt();
    } else {
        // exprStmt
        dyn exprStmtNode = this.createNode<ASTExprStmtNode>();
        exprStmtNode.expr = this.parseAssignExpr();
        stmtNode = this.concludeNode(exprStmtNode);
    }
    this.expect(TokenType::SEMICOLON);

    return stmtNode;
}

f<ASTDeclStmtNode*> Parser.parseDeclStmt() {
    dyn declStmtNode = this.createNode<ASTDeclStmtNode>();

    // Parse dataType
    declStmtNode.dataType = this.parseDataType();

    declStmtNode.varName = this.getIdentifier(false);
    this.expect(TokenType::IDENTIFIER);

    // Parse initializer
    if this.currentTokenIs(TokenType::ASSIGN) {
        this.expect(TokenType::ASSIGN);
        declStmtNode.hasAssignment = true;
        declStmtNode.assignExpr = this.parseAssignExpr();
    }

    return this.concludeNode(declStmtNode);
}

f<ASTQualifierLstNode*> Parser.parseQualifierLst() {
    dyn qualifierLstNode = this.createNode<ASTQualifierLstNode>();

    const dyn qualifierSelect = [TokenType::CONST, TokenType::SIGNED, TokenType::UNSIGNED, TokenType::INLINE, TokenType::PUBLIC, TokenType::HEAP, TokenType::COMPOSE];
    do {
        qualifierLstNode.qualifiers.pushBack(this.parseQualifier());
    } while this.currentTokenIsOneOf(qualifierSelect, len(qualifierSelect));

    // Check if qualifier combination is invalid
    bool seenSignedOrUnsigned = false;
    foreach ASTQualifierNode* qualifier : qualifierLstNode.qualifiers {
        // Check if we have both, signed and unsigned qualifier
        if qualifier.qualifierType != QualifierType::SIGNED && qualifier.qualifierType != QualifierType::UNSIGNED {
            continue;
        }
        if seenSignedOrUnsigned {
            const ASTNode* qualifierBase = cast<ASTNode*>(qualifier);
            this.throwParserError(qualifierBase.codeLoc, ParserErrorType::INVALID_QUALIFIER_COMBINATION, "A variable can not be signed and unsigned");
        }
        seenSignedOrUnsigned = true;
    }

    return this.concludeNode(qualifierLstNode);
}

f<ASTQualifierNode*> Parser.parseQualifier() {
    dyn qualifierNode = this.createNode<ASTQualifierNode>();

    if this.currentTokenIs(TokenType::CONST) {
        this.expect(TokenType::CONST);
        qualifierNode.qualifierType = QualifierType::CONST;
    } else if this.currentTokenIs(TokenType::SIGNED) {
        this.expect(TokenType::SIGNED);
        qualifierNode.qualifierType = QualifierType::SIGNED;
    } else if this.currentTokenIs(TokenType::UNSIGNED) {
        this.expect(TokenType::UNSIGNED);
        qualifierNode.qualifierType = QualifierType::UNSIGNED;
    } else if this.currentTokenIs(TokenType::INLINE) {
        this.expect(TokenType::INLINE);
        qualifierNode.qualifierType = QualifierType::INLINE;
    } else if this.currentTokenIs(TokenType::PUBLIC) {
        this.expect(TokenType::PUBLIC);
        qualifierNode.qualifierType = QualifierType::PUBLIC;
    } else if this.currentTokenIs(TokenType::HEAP) {
        this.expect(TokenType::HEAP);
        qualifierNode.qualifierType = QualifierType::HEAP;
    } else if this.currentTokenIs(TokenType::COMPOSE) {
        this.expect(TokenType::COMPOSE);
        qualifierNode.qualifierType = QualifierType::COMPOSE;
    } else {
        assert false;
    }

    return this.concludeNode(qualifierNode);
}

f<ASTModAttrNode*> Parser.parseModAttr() {
    dyn modAttrNode = this.createNode<ASTModAttrNode>();

    this.expect(TokenType::MOD_ATTR_PREAMBLE);
    this.expect(TokenType::LBRACKET);
    modAttrNode.attrLst = this.parseAttrLst();
    this.expect(TokenType::RBRACKET);

    // Tell the attributes that they are module attributes (matches host semantics)
    foreach ASTAttrNode* attr : modAttrNode.attrLst.attributes {
        attr.target = AttrTarget::TARGET_MODULE;
    }

    return this.concludeNode(modAttrNode);
}

f<ASTTopLevelDefAttrNode*> Parser.parseTopLevelDefAttr() {
    dyn topLevelDefAttrNode = this.createNode<ASTTopLevelDefAttrNode>();

    this.expect(TokenType::FCT_ATTR_PREAMBLE);
    this.expect(TokenType::LBRACKET);
    topLevelDefAttrNode.attrLst = this.parseAttrLst();
    this.expect(TokenType::RBRACKET);

    // Note: the concrete target (TARGET_FCT_PROC / TARGET_STRUCT / TARGET_INTERFACE / TARGET_UNION /
    // TARGET_EXT_DECL) depends on which construct this attribute list is attached to, so it is set by
    // the caller (parseFctDef, parseStructDef, ...), matching host's per-construct target propagation.

    return this.concludeNode(topLevelDefAttrNode);
}

f<ASTLambdaAttrNode*> Parser.parseLambdaAttr() {
    dyn lambdaAttrNode = this.createNode<ASTLambdaAttrNode>();

    this.expect(TokenType::LBRACKET);
    this.expect(TokenType::LBRACKET);
    lambdaAttrNode.attrLst = this.parseAttrLst();
    this.expect(TokenType::RBRACKET);
    this.expect(TokenType::RBRACKET);

    // Tell the attributes that they are lambda attributes (matches host semantics)
    foreach ASTAttrNode* attr : lambdaAttrNode.attrLst.attributes {
        attr.target = AttrTarget::TARGET_LAMBDA;
    }

    return this.concludeNode(lambdaAttrNode);
}

f<ASTAttrLstNode*> Parser.parseAttrLst() {
    dyn attrLstNode = this.createNode<ASTAttrLstNode>();

    attrLstNode.attributes.pushBack(this.parseAttr());
    while this.currentTokenIs(TokenType::COMMA) {
        this.expect(TokenType::COMMA);
        attrLstNode.attributes.pushBack(this.parseAttr());
    }

    return this.concludeNode(attrLstNode);
}

f<ASTAttrNode*> Parser.parseAttr() {
    dyn attrNode = this.createNode<ASTAttrNode>();

    // Parse attribute name
    String key = this.lexer.getToken().text;
    this.expect(TokenType::IDENTIFIER);
    while this.currentTokenIs(TokenType::DOT) {
        this.expect(TokenType::DOT);
        key += ".";
        key += this.lexer.getToken().text;
        this.expect(TokenType::IDENTIFIER);
    }
    attrNode.key = key;

    // Parse attribute value
    if this.currentTokenIs(TokenType::ASSIGN) {
        this.expect(TokenType::ASSIGN);
        // Classify the value's type from the upcoming literal token, matching host semantics
        // (values other than string/int/bool are rejected by later stages, not enforced here).
        const TokenType valueTok = this.lexer.getToken().tokenType;
        if valueTok == TokenType::STRING_LIT {
            attrNode.attrType = AttrType::TYPE_STRING;
        } else if valueTok == TokenType::INT_LIT {
            attrNode.attrType = AttrType::TYPE_INT;
        } else if valueTok == TokenType::TRUE || valueTok == TokenType::FALSE {
            attrNode.attrType = AttrType::TYPE_BOOL;
        } else {
            this.throwParserError(this.lexer.getCodeLoc(), ParserErrorType::INVALID_ATTR_VALUE_TYPE, "Invalid attribute value type");
        }
        attrNode.value = this.parseConstant();
    } else {
        // If no value is given, use the bool type (matches host semantics)
        attrNode.attrType = AttrType::TYPE_BOOL;
    }

    return this.concludeNode(attrNode);
}

f<ASTCaseConstantNode*> Parser.parseCaseConstant() {
    dyn caseConstantNode = this.createNode<ASTCaseConstantNode>();

    const dyn optionsVarExpr = [TokenType::IDENTIFIER, TokenType::TYPE_IDENTIFIER];
    if this.currentTokenIsOneOf(optionsVarExpr, len(optionsVarExpr)) {
        String fqIdentifier;
        // Optional (IDENTIFIER SCOPE_ACCESS) prefix
        if this.currentTokenIs(TokenType::IDENTIFIER) {
            const String fragment = this.getIdentifier(false);
            caseConstantNode.identifierFragments.pushBack(fragment);
            fqIdentifier += fragment;
            fqIdentifier += SCOPE_ACCESS_TOKEN;
            this.expect(TokenType::IDENTIFIER);
            this.expect(TokenType::SCOPE_ACCESS);
        }
        const String typeFragment = this.getIdentifier(false);
        caseConstantNode.identifierFragments.pushBack(typeFragment);
        fqIdentifier += typeFragment;
        this.expect(TokenType::TYPE_IDENTIFIER);
        while this.currentTokenIs(TokenType::SCOPE_ACCESS) {
            this.expect(TokenType::SCOPE_ACCESS);
            const String fragment = this.getIdentifier(false);
            caseConstantNode.identifierFragments.pushBack(fragment);
            fqIdentifier += SCOPE_ACCESS_TOKEN;
            fqIdentifier += fragment;
            this.expect(TokenType::TYPE_IDENTIFIER);
        }
        caseConstantNode.fqIdentifier = fqIdentifier;
    } else {
        caseConstantNode.constant = this.parseConstant();
    }

    return this.concludeNode(caseConstantNode);
}

f<ASTReturnStmtNode*> Parser.parseReturnStmt() {
    dyn returnStmtNode = this.createNode<ASTReturnStmtNode>();

    this.expect(TokenType::RETURN);
    if !this.currentTokenIs(TokenType::SEMICOLON) {
        returnStmtNode.hasReturnValue = true;
        returnStmtNode.assignExpr = this.parseAssignExpr();
    }

    return this.concludeNode(returnStmtNode);
}

f<ASTBreakStmtNode*> Parser.parseBreakStmt() {
    dyn breakStmtNode = this.createNode<ASTBreakStmtNode>();

    this.expect(TokenType::BREAK);
    if this.currentTokenIs(TokenType::INT_LIT) {
        const String& breakTimes = this.lexer.getToken().text;
        breakStmtNode.breakTimes = toInt(breakTimes.getRaw());
        this.expect(TokenType::INT_LIT);
    }

    return this.concludeNode(breakStmtNode);
}

f<ASTContinueStmtNode*> Parser.parseContinueStmt() {
    dyn continueStmtNode = this.createNode<ASTContinueStmtNode>();

    this.expect(TokenType::CONTINUE);
    if this.currentTokenIs(TokenType::INT_LIT) {
        const String& continueTimes = this.lexer.getToken().text;
        continueStmtNode.continueTimes = toInt(continueTimes.getRaw());
        this.expect(TokenType::INT_LIT);
    }

    return this.concludeNode(continueStmtNode);
}

f<ASTFallthroughStmtNode*> Parser.parseFallthroughStmt() {
    dyn fallthroughStmtNode = this.createNode<ASTFallthroughStmtNode>();

    this.expect(TokenType::FALLTHROUGH);

    return this.concludeNode(fallthroughStmtNode);
}

f<ASTAssertStmtNode*> Parser.parseAssertStmt() {
    dyn assertStmtNode = this.createNode<ASTAssertStmtNode>();

    this.expect(TokenType::ASSERT);
    const unsigned long exprStartIdx = this.lexer.getTokenIndex();
    assertStmtNode.assignExpr = this.parseAssignExpr();
    assertStmtNode.expressionString = this.lexer.getSourceCode(exprStartIdx, this.lexer.getTokenIndex());
    this.expect(TokenType::SEMICOLON);

    return this.concludeNode(assertStmtNode);
}

// assignExpr: prefixUnaryExpr assignOp assignExpr | ternaryExpr;
// A valid assignment lhs (prefixUnaryExpr) is also a valid ternaryExpr, so we parse a ternaryExpr first
// and only treat it as an assignment if an assignment operator follows.
f<IVisitable*> Parser.parseAssignExpr() {
    // Parse lhs
    IVisitable* lhs = this.parseTernaryExpr();

    // Pass-through if this is no assignment
    if !this.isAssignOp(this.lexer.getToken().tokenType) {
        return lhs;
    }

    dyn assignExprNode = this.createNodeWrappingLastChild<ASTAssignExprNode>();
    assignExprNode.lhs = lhs;

    // Parse assign operator
    assignExprNode.op = this.parseAssignOp();

    // Parse rhs
    assignExprNode.rhs = this.parseAssignExpr();

    return this.concludeExprNode(assignExprNode);
}

// assignOp: ASSIGN | PLUS_EQUAL | MINUS_EQUAL | MUL_EQUAL | DIV_EQUAL | REM_EQUAL | SHL_EQUAL | SHR_EQUAL | AND_EQUAL | OR_EQUAL | XOR_EQUAL;
f<AssignOp> Parser.parseAssignOp() {
    const TokenType tokenType = this.lexer.getToken().tokenType;
    this.advance();
    switch tokenType {
        case TokenType::ASSIGN: { return AssignOp::OP_ASSIGN; }
        case TokenType::PLUS_EQUAL: { return AssignOp::OP_PLUS_EQUAL; }
        case TokenType::MINUS_EQUAL: { return AssignOp::OP_MINUS_EQUAL; }
        case TokenType::MUL_EQUAL: { return AssignOp::OP_MUL_EQUAL; }
        case TokenType::DIV_EQUAL: { return AssignOp::OP_DIV_EQUAL; }
        case TokenType::REM_EQUAL: { return AssignOp::OP_REM_EQUAL; }
        case TokenType::SHL_EQUAL: { return AssignOp::OP_SHL_EQUAL; }
        case TokenType::SHR_EQUAL: { return AssignOp::OP_SHR_EQUAL; }
        case TokenType::AND_EQUAL: { return AssignOp::OP_AND_EQUAL; }
        case TokenType::OR_EQUAL: { return AssignOp::OP_OR_EQUAL; }
        case TokenType::XOR_EQUAL: { return AssignOp::OP_XOR_EQUAL; }
    }
    panic(Error("Unknown assign operator")); // LCOV_EXCL_LINE
}

// ternaryExpr: logicalOrExpr (QUESTION_MARK logicalOrExpr? COLON logicalOrExpr)?;
f<IVisitable*> Parser.parseTernaryExpr() {
    // Parse condition
    IVisitable* condition = this.parseLogicalOrExpr();

    // Pass-through if this is no ternary
    if !this.currentTokenIs(TokenType::QUESTION_MARK) {
        return condition;
    }

    dyn ternaryExprNode = this.createNodeWrappingLastChild<ASTTernaryExprNode>();
    ternaryExprNode.condition = condition;

    // Parse both branches. The true branch is omitted in the shortened form (COND ?: FALSE_EXPR)
    this.expect(TokenType::QUESTION_MARK);
    if this.currentTokenIs(TokenType::COLON) {
        this.expect(TokenType::COLON);
        ternaryExprNode.isShortened = true;
        ternaryExprNode.falseExpr = this.parseLogicalOrExpr();
    } else {
        ternaryExprNode.trueExpr = this.parseLogicalOrExpr();
        this.expect(TokenType::COLON);
        ternaryExprNode.falseExpr = this.parseLogicalOrExpr();
    }

    return this.concludeExprNode(ternaryExprNode);
}

// logicalOrExpr: logicalAndExpr (LOGICAL_OR logicalAndExpr)*;
f<IVisitable*> Parser.parseLogicalOrExpr() {
    // Parse first operand
    IVisitable* firstOperand = this.parseLogicalAndExpr();

    // Pass-through if there is only one operand
    if !this.currentTokenIs(TokenType::LOGICAL_OR) {
        return firstOperand;
    }

    dyn logicalOrExprNode = this.createNodeWrappingLastChild<ASTLogicalOrExprNode>();
    logicalOrExprNode.operands.pushBack(firstOperand);

    // Parse remaining operands
    while this.currentTokenIs(TokenType::LOGICAL_OR) {
        this.expect(TokenType::LOGICAL_OR);
        logicalOrExprNode.operands.pushBack(this.parseLogicalAndExpr());
    }

    return this.concludeExprNode(logicalOrExprNode);
}

// logicalAndExpr: bitwiseOrExpr (LOGICAL_AND bitwiseOrExpr)*;
f<IVisitable*> Parser.parseLogicalAndExpr() {
    // Parse first operand
    IVisitable* firstOperand = this.parseBitwiseOrExpr();

    // Pass-through if there is only one operand
    if !this.currentTokenIs(TokenType::LOGICAL_AND) {
        return firstOperand;
    }

    dyn logicalAndExprNode = this.createNodeWrappingLastChild<ASTLogicalAndExprNode>();
    logicalAndExprNode.operands.pushBack(firstOperand);

    // Parse remaining operands
    while this.currentTokenIs(TokenType::LOGICAL_AND) {
        this.expect(TokenType::LOGICAL_AND);
        logicalAndExprNode.operands.pushBack(this.parseBitwiseOrExpr());
    }

    return this.concludeExprNode(logicalAndExprNode);
}

// bitwiseOrExpr: bitwiseXorExpr (BITWISE_OR bitwiseXorExpr)*;
f<IVisitable*> Parser.parseBitwiseOrExpr() {
    // Parse first operand
    IVisitable* firstOperand = this.parseBitwiseXorExpr();

    // Pass-through if there is only one operand
    if !this.currentTokenIs(TokenType::BITWISE_OR) {
        return firstOperand;
    }

    dyn bitwiseOrExprNode = this.createNodeWrappingLastChild<ASTBitwiseOrExprNode>();
    bitwiseOrExprNode.operands.pushBack(firstOperand);

    // Parse remaining operands
    while this.currentTokenIs(TokenType::BITWISE_OR) {
        this.expect(TokenType::BITWISE_OR);
        bitwiseOrExprNode.operands.pushBack(this.parseBitwiseXorExpr());
    }

    return this.concludeExprNode(bitwiseOrExprNode);
}

// bitwiseXorExpr: bitwiseAndExpr (BITWISE_XOR bitwiseAndExpr)*;
f<IVisitable*> Parser.parseBitwiseXorExpr() {
    // Parse first operand
    IVisitable* firstOperand = this.parseBitwiseAndExpr();

    // Pass-through if there is only one operand
    if !this.currentTokenIs(TokenType::BITWISE_XOR) {
        return firstOperand;
    }

    dyn bitwiseXorExprNode = this.createNodeWrappingLastChild<ASTBitwiseXorExprNode>();
    bitwiseXorExprNode.operands.pushBack(firstOperand);

    // Parse remaining operands
    while this.currentTokenIs(TokenType::BITWISE_XOR) {
        this.expect(TokenType::BITWISE_XOR);
        bitwiseXorExprNode.operands.pushBack(this.parseBitwiseAndExpr());
    }

    return this.concludeExprNode(bitwiseXorExprNode);
}

// bitwiseAndExpr: equalityExpr (BITWISE_AND equalityExpr)*;
f<IVisitable*> Parser.parseBitwiseAndExpr() {
    // Parse first operand
    IVisitable* firstOperand = this.parseEqualityExpr();

    // Pass-through if there is only one operand
    if !this.currentTokenIs(TokenType::BITWISE_AND) {
        return firstOperand;
    }

    dyn bitwiseAndExprNode = this.createNodeWrappingLastChild<ASTBitwiseAndExprNode>();
    bitwiseAndExprNode.operands.pushBack(firstOperand);

    // Parse remaining operands
    while this.currentTokenIs(TokenType::BITWISE_AND) {
        this.expect(TokenType::BITWISE_AND);
        bitwiseAndExprNode.operands.pushBack(this.parseEqualityExpr());
    }

    return this.concludeExprNode(bitwiseAndExprNode);
}

// equalityExpr: relationalExpr ((EQUAL | NOT_EQUAL) relationalExpr)?;
f<IVisitable*> Parser.parseEqualityExpr() {
    // Parse first operand
    IVisitable* firstOperand = this.parseRelationalExpr();

    // Pass-through if there is only one operand
    const dyn options = [TokenType::EQUAL, TokenType::NOT_EQUAL];
    if !this.currentTokenIsOneOf(options, len(options)) {
        return firstOperand;
    }

    dyn equalityExprNode = this.createNodeWrappingLastChild<ASTEqualityExprNode>();
    equalityExprNode.operands.pushBack(firstOperand);

    // Extract operator
    if this.currentTokenIs(TokenType::EQUAL) {
        equalityExprNode.op = EqualityOp::OP_EQUAL;
    } else {
        equalityExprNode.op = EqualityOp::OP_NOT_EQUAL;
    }
    this.advance();

    // Parse second operand
    equalityExprNode.operands.pushBack(this.parseRelationalExpr());

    return this.concludeExprNode(equalityExprNode);
}

// relationalExpr: shiftExpr ((LESS | GREATER | LESS_EQUAL | GREATER_EQUAL) shiftExpr)?;
f<IVisitable*> Parser.parseRelationalExpr() {
    // Parse first operand
    IVisitable* firstOperand = this.parseShiftExpr();

    // Pass-through if there is only one operand
    const dyn options = [TokenType::LESS, TokenType::GREATER, TokenType::LESS_EQUAL, TokenType::GREATER_EQUAL];
    if !this.currentTokenIsOneOf(options, len(options)) {
        return firstOperand;
    }

    dyn relationalExprNode = this.createNodeWrappingLastChild<ASTRelationalExprNode>();
    relationalExprNode.operands.pushBack(firstOperand);

    // Extract operator
    if this.currentTokenIs(TokenType::LESS) {
        relationalExprNode.op = RelationalOp::OP_LESS;
    } else if this.currentTokenIs(TokenType::GREATER) {
        relationalExprNode.op = RelationalOp::OP_GREATER;
    } else if this.currentTokenIs(TokenType::LESS_EQUAL) {
        relationalExprNode.op = RelationalOp::OP_LESS_EQUAL;
    } else {
        relationalExprNode.op = RelationalOp::OP_GREATER_EQUAL;
    }
    this.advance();

    // Parse second operand
    relationalExprNode.operands.pushBack(this.parseShiftExpr());

    return this.concludeExprNode(relationalExprNode);
}

// shiftExpr: additiveExpr ((LESS LESS | GREATER GREATER) additiveExpr)*;
// The lexer merges '<<' and '>>' into single SHL / SHR tokens.
f<IVisitable*> Parser.parseShiftExpr() {
    // Parse first operand
    IVisitable* firstOperand = this.parseAdditiveExpr();

    // Pass-through if there is only one operand
    const dyn options = [TokenType::SHL, TokenType::SHR];
    if !this.currentTokenIsOneOf(options, len(options)) {
        return firstOperand;
    }

    dyn shiftExprNode = this.createNodeWrappingLastChild<ASTShiftExprNode>();
    shiftExprNode.operands.pushBack(firstOperand);

    // Parse remaining operands
    while this.currentTokenIsOneOf(options, len(options)) {
        // Extract operator
        ShiftOp op = ShiftOp::OP_SHIFT_RIGHT;
        if this.currentTokenIs(TokenType::SHL) {
            op = ShiftOp::OP_SHIFT_LEFT;
        }
        shiftExprNode.opQueue.push(Pair<ShiftOp, QualType>(op, QualType(SuperType::TY_INVALID)));
        this.advance();

        // Parse operand
        shiftExprNode.operands.pushBack(this.parseAdditiveExpr());
    }

    return this.concludeExprNode(shiftExprNode);
}

// additiveExpr: multiplicativeExpr ((PLUS | MINUS) multiplicativeExpr)*;
f<IVisitable*> Parser.parseAdditiveExpr() {
    // Parse first operand
    IVisitable* firstOperand = this.parseMultiplicativeExpr();

    // Pass-through if there is only one operand
    const dyn options = [TokenType::PLUS, TokenType::MINUS];
    if !this.currentTokenIsOneOf(options, len(options)) {
        return firstOperand;
    }

    dyn additiveExprNode = this.createNodeWrappingLastChild<ASTAdditiveExprNode>();
    additiveExprNode.operands.pushBack(firstOperand);

    // Parse remaining operands
    while this.currentTokenIsOneOf(options, len(options)) {
        // Extract operator
        AdditiveOp op = AdditiveOp::OP_MINUS;
        if this.currentTokenIs(TokenType::PLUS) {
            op = AdditiveOp::OP_PLUS;
        }
        additiveExprNode.opQueue.push(Pair<AdditiveOp, QualType>(op, QualType(SuperType::TY_INVALID)));
        this.advance();

        // Parse operand
        additiveExprNode.operands.pushBack(this.parseMultiplicativeExpr());
    }

    return this.concludeExprNode(additiveExprNode);
}

// multiplicativeExpr: castExpr ((MUL | DIV | REM) castExpr)*;
f<IVisitable*> Parser.parseMultiplicativeExpr() {
    // Parse first operand
    IVisitable* firstOperand = this.parseCastExpr();

    // Pass-through if there is only one operand
    const dyn options = [TokenType::MUL, TokenType::DIV, TokenType::REM];
    if !this.currentTokenIsOneOf(options, len(options)) {
        return firstOperand;
    }

    dyn multiplicativeExprNode = this.createNodeWrappingLastChild<ASTMultiplicativeExprNode>();
    multiplicativeExprNode.operands.pushBack(firstOperand);

    // Parse remaining operands
    while this.currentTokenIsOneOf(options, len(options)) {
        // Extract operator
        MultiplicativeOp op = MultiplicativeOp::OP_REM;
        if this.currentTokenIs(TokenType::MUL) {
            op = MultiplicativeOp::OP_MUL;
        } else if this.currentTokenIs(TokenType::DIV) {
            op = MultiplicativeOp::OP_DIV;
        }
        multiplicativeExprNode.opQueue.push(Pair<MultiplicativeOp, QualType>(op, QualType(SuperType::TY_INVALID)));
        this.advance();

        // Parse operand
        multiplicativeExprNode.operands.pushBack(this.parseCastExpr());
    }

    return this.concludeExprNode(multiplicativeExprNode);
}

// castExpr: prefixUnaryExpr | CAST LESS dataType GREATER LPAREN assignExpr RPAREN;
f<IVisitable*> Parser.parseCastExpr() {
    // Pass-through if this is no cast
    if !this.currentTokenIs(TokenType::CAST) {
        return this.parsePrefixUnaryExpr();
    }

    dyn castExprNode = this.createNode<ASTCastExprNode>();

    this.expect(TokenType::CAST);
    this.expect(TokenType::LESS);
    castExprNode.dataType = this.parseDataType();
    this.consumeGenericClose();
    this.expect(TokenType::LPAREN);
    castExprNode.assignExpr = this.parseAssignExpr();
    this.expect(TokenType::RPAREN);
    castExprNode.isCast = true;

    return this.concludeExprNode(castExprNode);
}

// prefixUnaryExpr: postfixUnaryExpr | (MINUS | PLUS_PLUS | MINUS_MINUS | NOT | BITWISE_NOT | MUL | BITWISE_AND) prefixUnaryExpr;
f<IVisitable*> Parser.parsePrefixUnaryExpr() {
    // Pass-through if there is no prefix operator. A minus sign directly in front of a numeric literal belongs to the
    // constant, because the grammar prefers the postfixUnaryExpr alternative in that case.
    const dyn options = [TokenType::MINUS, TokenType::PLUS_PLUS, TokenType::MINUS_MINUS, TokenType::NOT, TokenType::BITWISE_NOT, TokenType::MUL, TokenType::BITWISE_AND];
    if !this.currentTokenIsOneOf(options, len(options)) || this.isNegativeNumericConstantAhead() {
        return this.parsePostfixUnaryExpr();
    }

    dyn prefixUnaryExprNode = this.createNode<ASTPrefixUnaryExprNode>();

    // Extract operator
    const TokenType tokenType = this.lexer.getToken().tokenType;
    if tokenType == TokenType::MINUS {
        prefixUnaryExprNode.op = PrefixUnaryOp::OP_MINUS;
    } else if tokenType == TokenType::PLUS_PLUS {
        prefixUnaryExprNode.op = PrefixUnaryOp::OP_PLUS_PLUS;
    } else if tokenType == TokenType::MINUS_MINUS {
        prefixUnaryExprNode.op = PrefixUnaryOp::OP_MINUS_MINUS;
    } else if tokenType == TokenType::NOT {
        prefixUnaryExprNode.op = PrefixUnaryOp::OP_NOT;
    } else if tokenType == TokenType::BITWISE_NOT {
        prefixUnaryExprNode.op = PrefixUnaryOp::OP_BITWISE_NOT;
    } else if tokenType == TokenType::MUL {
        prefixUnaryExprNode.op = PrefixUnaryOp::OP_DEREFERENCE;
    } else {
        prefixUnaryExprNode.op = PrefixUnaryOp::OP_ADDRESS_OF;
    }
    this.advance();

    // Parse operand
    prefixUnaryExprNode.prefixUnaryExpr = this.parsePrefixUnaryExpr();

    return this.concludeExprNode(prefixUnaryExprNode);
}

// postfixUnaryExpr: atomicExpr | postfixUnaryExpr (LBRACKET assignExpr RBRACKET | DOT IDENTIFIER | PLUS_PLUS | MINUS_MINUS | NOT);
// The rule is left-recursive, so each postfix operator wraps the expression parsed so far into a new node.
f<IVisitable*> Parser.parsePostfixUnaryExpr() {
    IVisitable* expr = cast<IVisitable*>(this.parseAtomicExpr());

    const dyn options = [TokenType::LBRACKET, TokenType::DOT, TokenType::PLUS_PLUS, TokenType::MINUS_MINUS, TokenType::NOT];
    while this.currentTokenIsOneOf(options, len(options)) {
        dyn postfixUnaryExprNode = this.createNodeWrappingLastChild<ASTPostfixUnaryExprNode>();
        postfixUnaryExprNode.postfixUnaryExpr = expr;

        // Extract operator
        if this.currentTokenIs(TokenType::LBRACKET) {
            this.expect(TokenType::LBRACKET);
            postfixUnaryExprNode.op = PostfixUnaryOp::OP_SUBSCRIPT;
            postfixUnaryExprNode.subscriptIndexExpr = this.parseAssignExpr();
            this.expect(TokenType::RBRACKET);
        } else if this.currentTokenIs(TokenType::DOT) {
            this.expect(TokenType::DOT);
            postfixUnaryExprNode.op = PostfixUnaryOp::OP_MEMBER_ACCESS;
            postfixUnaryExprNode.identifier = this.getIdentifier(false);
            this.expect(TokenType::IDENTIFIER);
        } else if this.currentTokenIs(TokenType::PLUS_PLUS) {
            this.expect(TokenType::PLUS_PLUS);
            postfixUnaryExprNode.op = PostfixUnaryOp::OP_PLUS_PLUS;
        } else if this.currentTokenIs(TokenType::MINUS_MINUS) {
            this.expect(TokenType::MINUS_MINUS);
            postfixUnaryExprNode.op = PostfixUnaryOp::OP_MINUS_MINUS;
        } else {
            this.expect(TokenType::NOT);
            postfixUnaryExprNode.op = PostfixUnaryOp::OP_ERR_PROPAGATION;
        }

        expr = this.concludeExprNode(postfixUnaryExprNode);
    }

    return expr;
}

// atomicExpr: constant | value | (IDENTIFIER | TYPE_IDENTIFIER) (SCOPE_ACCESS (IDENTIFIER | TYPE_IDENTIFIER))* | LPAREN assignExpr RPAREN;
f<ASTAtomicExprNode*> Parser.parseAtomicExpr() {
    dyn atomicExprNode = this.createNode<ASTAtomicExprNode>();

    const TokenType cur = this.lexer.getToken().tokenType;
    if this.isConstantStart(cur) || this.isNegativeNumericConstantAhead() {
        atomicExprNode.constant = this.parseConstant();
    } else if cur == TokenType::LPAREN && !this.isLambdaExprAhead() {
        this.expect(TokenType::LPAREN);
        atomicExprNode.assignExpr = this.parseAssignExpr();
        this.expect(TokenType::RPAREN);
    } else if (cur == TokenType::IDENTIFIER || cur == TokenType::TYPE_IDENTIFIER) && !this.isFctCallAhead() && !this.isStructInstantiationAhead() {
        // Plain (scoped) variable or constant access
        const String firstFragment = this.getIdentifier(false);
        String fqIdentifier = firstFragment;
        atomicExprNode.identifierFragments.pushBack(firstFragment);
        this.advance();
        while this.currentTokenIs(TokenType::SCOPE_ACCESS) {
            this.expect(TokenType::SCOPE_ACCESS);
            const String fragment = this.getIdentifier(false);
            if this.currentTokenIs(TokenType::TYPE_IDENTIFIER) {
                this.expect(TokenType::TYPE_IDENTIFIER);
            } else {
                this.expect(TokenType::IDENTIFIER);
            }
            atomicExprNode.identifierFragments.pushBack(fragment);
            fqIdentifier += SCOPE_ACCESS_TOKEN;
            fqIdentifier += fragment;
        }
        atomicExprNode.fqIdentifier = fqIdentifier;
    } else {
        atomicExprNode.value = cast<IVisitable*>(this.parseValue());
    }

    return this.concludeNode(atomicExprNode);
}

// value: fctCall | arrayInitialization | structInstantiation | lambdaFunc | lambdaProc | lambdaExpr | NIL LESS dataType GREATER;
f<ASTValueNode*> Parser.parseValue() {
    dyn valueNode = this.createNode<ASTValueNode>();

    if this.currentTokenIs(TokenType::NIL) {
        this.expect(TokenType::NIL);
        this.expect(TokenType::LESS);
        valueNode.isNil = true;
        valueNode.nilType = this.parseDataType();
        this.consumeGenericClose();
    } else if this.currentTokenIs(TokenType::LBRACKET) {
        valueNode.arrayInitialization = cast<IVisitable*>(this.parseArrayInitialization());
    } else if this.currentTokenIs(TokenType::F) {
        valueNode.lambdaFunc = cast<IVisitable*>(this.parseLambdaFunc());
    } else if this.currentTokenIs(TokenType::P) {
        valueNode.lambdaProc = cast<IVisitable*>(this.parseLambdaProc());
    } else if this.currentTokenIs(TokenType::LPAREN) {
        valueNode.lambdaExpr = cast<IVisitable*>(this.parseLambdaExpr());
    } else if this.isStructInstantiationAhead() {
        valueNode.structInstantiation = cast<IVisitable*>(this.parseStructInstantiation());
    } else {
        valueNode.fctCall = cast<IVisitable*>(this.parseFctCall());
    }

    return this.concludeNode(valueNode);
}

// constant: MINUS? (DOUBLE_LIT | INT_LIT | SHORT_LIT | LONG_LIT) | CHAR_LIT | STRING_LIT | TRUE | FALSE;
f<ASTConstantNode*> Parser.parseConstant() {
    dyn constantNode = this.createNode<ASTConstantNode>();

    // Detect an optional leading minus sign for numeric literals
    const bool isNegative = this.currentTokenIs(TokenType::MINUS);
    if isNegative {
        this.expect(TokenType::MINUS);
    }

    const Token& token = this.lexer.getToken();
    if this.currentTokenIs(TokenType::DOUBLE_LIT) {
        constantNode.primitiveValueType = PrimitiveValueType::TYPE_DOUBLE;
        const double value = toDouble(token.text.getRaw());
        constantNode.compileTimeValue.setDoubleValue(isNegative ? -value : value);
        this.expect(TokenType::DOUBLE_LIT);
    } else if this.currentTokenIs(TokenType::INT_LIT) {
        constantNode.primitiveValueType = PrimitiveValueType::TYPE_INT;
        constantNode.isUnsigned = token.text.endsWith("u");
        constantNode.compileTimeValue.setIntValue(cast<int>(this.parseNumeric(token, isNegative, 32)));
        this.expect(TokenType::INT_LIT);
    } else if this.currentTokenIs(TokenType::SHORT_LIT) {
        constantNode.primitiveValueType = PrimitiveValueType::TYPE_SHORT;
        constantNode.isUnsigned = token.text.endsWith("u");
        constantNode.compileTimeValue.setShortValue(cast<short>(this.parseNumeric(token, isNegative, 16)));
        this.expect(TokenType::SHORT_LIT);
    } else if this.currentTokenIs(TokenType::LONG_LIT) {
        constantNode.primitiveValueType = PrimitiveValueType::TYPE_LONG;
        constantNode.isUnsigned = token.text.endsWith("u");
        constantNode.compileTimeValue.setLongValue(this.parseNumeric(token, isNegative, 64));
        this.expect(TokenType::LONG_LIT);
    } else if this.currentTokenIs(TokenType::CHAR_LIT) {
        constantNode.primitiveValueType = PrimitiveValueType::TYPE_CHAR;
        constantNode.compileTimeValue.setCharValue(this.parseChar(token));
        this.expect(TokenType::CHAR_LIT);
    } else if this.currentTokenIs(TokenType::STRING_LIT) {
        // Save a pointer to the string in the compile time value
        constantNode.primitiveValueType = PrimitiveValueType::TYPE_STRING;
        constantNode.compileTimeValue.setStringValueOffset(this.resourceManager.compileTimeStringValues.getSize());
        // Add the string to the global compile time string list
        this.resourceManager.compileTimeStringValues.pushBack(parseString(token.text));
        this.expect(TokenType::STRING_LIT);
    } else if this.currentTokenIs(TokenType::TRUE) {
        constantNode.primitiveValueType = PrimitiveValueType::TYPE_BOOL;
        constantNode.compileTimeValue.setBoolValue(true);
        this.expect(TokenType::TRUE);
    } else if this.currentTokenIs(TokenType::FALSE) {
        constantNode.primitiveValueType = PrimitiveValueType::TYPE_BOOL;
        constantNode.compileTimeValue.setBoolValue(false);
        this.expect(TokenType::FALSE);
    } else {
        panic(Error("Unknown constant type"));
    }

    return this.concludeNode(constantNode);
}

// fctCall: (IDENTIFIER SCOPE_ACCESS)* (IDENTIFIER DOT)* (IDENTIFIER | TYPE_IDENTIFIER) (LESS typeLst GREATER)? LPAREN argLst? RPAREN;
f<ASTFctCallNode*> Parser.parseFctCall() {
    dyn fctCallNode = this.createNode<ASTFctCallNode>();

    // Scope prefix: (IDENTIFIER SCOPE_ACCESS)*
    String fqFunctionName;
    while this.currentTokenIs(TokenType::IDENTIFIER) && this.tokenAt(1l) == TokenType::SCOPE_ACCESS {
        const String fragment = this.lexer.getToken().text;
        fctCallNode.functionNameFragments.pushBack(fragment);
        fqFunctionName += fragment;
        fqFunctionName += SCOPE_ACCESS_TOKEN;
        this.expect(TokenType::IDENTIFIER);
        this.expect(TokenType::SCOPE_ACCESS);
    }
    // Member prefix: (IDENTIFIER DOT)*
    while this.currentTokenIs(TokenType::IDENTIFIER) && this.tokenAt(1l) == TokenType::DOT {
        const String fragment = this.lexer.getToken().text;
        fctCallNode.functionNameFragments.pushBack(fragment);
        fqFunctionName += fragment;
        fqFunctionName += MEMBER_ACCESS_TOKEN;
        this.expect(TokenType::IDENTIFIER);
        this.expect(TokenType::DOT);
    }
    // Final name segment
    const String fragment = this.lexer.getToken().text;
    fctCallNode.functionNameFragments.pushBack(fragment);
    fqFunctionName += fragment;
    if this.currentTokenIs(TokenType::TYPE_IDENTIFIER) {
        this.expect(TokenType::TYPE_IDENTIFIER);
    } else {
        this.expect(TokenType::IDENTIFIER);
    }
    fctCallNode.fqFunctionName = fqFunctionName;

    // Template type list
    if this.currentTokenIs(TokenType::LESS) {
        this.expect(TokenType::LESS);
        fctCallNode.hasTemplateTypes = true;
        fctCallNode.templateTypeLst = this.parseTypeLst();
        this.consumeGenericClose();
    }
    // Argument list
    this.expect(TokenType::LPAREN);
    if !this.currentTokenIs(TokenType::RPAREN) {
        fctCallNode.hasArgs = true;
        fctCallNode.argLst = this.parseArgLst();
    }
    this.expect(TokenType::RPAREN);

    return this.concludeNode(fctCallNode);
}

// arrayInitialization: LBRACKET argLst? RBRACKET;
f<ASTArrayInitializationNode*> Parser.parseArrayInitialization() {
    dyn arrayInitializationNode = this.createNode<ASTArrayInitializationNode>();

    this.expect(TokenType::LBRACKET);
    if !this.currentTokenIs(TokenType::RBRACKET) {
        arrayInitializationNode.itemLst = this.parseArgLst();
    }
    this.expect(TokenType::RBRACKET);

    return this.concludeNode(arrayInitializationNode);
}

// structInstantiation: (IDENTIFIER SCOPE_ACCESS)* TYPE_IDENTIFIER (LESS typeLst GREATER)? LBRACE argLst? RBRACE;
f<ASTStructInstantiationNode*> Parser.parseStructInstantiation() {
    dyn structInstantiationNode = this.createNode<ASTStructInstantiationNode>();

    // Scope prefix: (IDENTIFIER SCOPE_ACCESS)*
    String fqStructName;
    while this.currentTokenIs(TokenType::IDENTIFIER) && this.tokenAt(1l) == TokenType::SCOPE_ACCESS {
        const String fragment = this.lexer.getToken().text;
        structInstantiationNode.structNameFragments.pushBack(fragment);
        fqStructName += fragment;
        fqStructName += SCOPE_ACCESS_TOKEN;
        this.expect(TokenType::IDENTIFIER);
        this.expect(TokenType::SCOPE_ACCESS);
    }
    const String structName = this.lexer.getToken().text;
    structInstantiationNode.structNameFragments.pushBack(structName);
    fqStructName += structName;
    this.expect(TokenType::TYPE_IDENTIFIER);
    structInstantiationNode.fqStructName = fqStructName;

    if this.currentTokenIs(TokenType::LESS) {
        this.expect(TokenType::LESS);
        structInstantiationNode.hasTemplateTypes = true;
        structInstantiationNode.templateTypeLst = this.parseTypeLst();
        this.consumeGenericClose();
    }

    this.expect(TokenType::LBRACE);
    if !this.currentTokenIs(TokenType::RBRACE) {
        structInstantiationNode.fieldLst = this.parseArgLst();
    }
    this.expect(TokenType::RBRACE);

    return this.concludeNode(structInstantiationNode);
}

// lambdaFunc: F LESS dataType GREATER LPAREN paramLst? RPAREN lambdaAttr? stmtLst;
f<ASTLambdaFuncNode*> Parser.parseLambdaFunc() {
    dyn lambdaFuncNode = this.createNode<ASTLambdaFuncNode>();

    this.expect(TokenType::F);
    this.expect(TokenType::LESS);
    lambdaFuncNode.returnType = this.parseDataType();
    this.consumeGenericClose();

    // Parse paramLst
    this.expect(TokenType::LPAREN);
    if !this.currentTokenIs(TokenType::RPAREN) {
        lambdaFuncNode.hasParams = true;
        lambdaFuncNode.paramLst = cast<IVisitable*>(this.parseParamLst());
    }
    this.expect(TokenType::RPAREN);

    // Parse lambda attrs
    if this.currentTokenIs(TokenType::LBRACKET) {
        lambdaFuncNode.lambdaAttr = this.parseLambdaAttr();
    }

    // Parse body
    lambdaFuncNode.body = cast<IVisitable*>(this.parseStmtLst());

    // The host lists the lambda attrs after the body in the children of the node
    if lambdaFuncNode.lambdaAttr != nil<ASTLambdaAttrNode*> {
        this.moveChildToEnd(cast<ASTNode*>(lambdaFuncNode), cast<ASTNode*>(lambdaFuncNode.lambdaAttr));
    }

    return this.concludeNode(lambdaFuncNode);
}

// lambdaProc: P LPAREN paramLst? RPAREN lambdaAttr? stmtLst;
f<ASTLambdaProcNode*> Parser.parseLambdaProc() {
    dyn lambdaProcNode = this.createNode<ASTLambdaProcNode>();

    this.expect(TokenType::P);

    // Parse paramLst
    this.expect(TokenType::LPAREN);
    if !this.currentTokenIs(TokenType::RPAREN) {
        lambdaProcNode.hasParams = true;
        lambdaProcNode.paramLst = cast<IVisitable*>(this.parseParamLst());
    }
    this.expect(TokenType::RPAREN);

    // Parse lambda attrs
    if this.currentTokenIs(TokenType::LBRACKET) {
        lambdaProcNode.lambdaAttr = this.parseLambdaAttr();
    }

    // Parse body
    lambdaProcNode.body = cast<IVisitable*>(this.parseStmtLst());

    // The host lists the lambda attrs after the body in the children of the node
    if lambdaProcNode.lambdaAttr != nil<ASTLambdaAttrNode*> {
        this.moveChildToEnd(cast<ASTNode*>(lambdaProcNode), cast<ASTNode*>(lambdaProcNode.lambdaAttr));
    }

    return this.concludeNode(lambdaProcNode);
}

// lambdaExpr: LPAREN paramLst? RPAREN ARROW assignExpr;
f<ASTLambdaExprNode*> Parser.parseLambdaExpr() {
    dyn lambdaExprNode = this.createNode<ASTLambdaExprNode>();

    // Parse paramLst
    this.expect(TokenType::LPAREN);
    if !this.currentTokenIs(TokenType::RPAREN) {
        lambdaExprNode.hasParams = true;
        lambdaExprNode.paramLst = cast<IVisitable*>(this.parseParamLst());
    }
    this.expect(TokenType::RPAREN);

    this.expect(TokenType::ARROW);
    lambdaExprNode.lambdaExpr = this.parseAssignExpr();

    return this.concludeNode(lambdaExprNode);
}

// dataType: qualifierLst? baseDataType (MUL | BITWISE_AND | LBRACKET (INT_LIT | TYPE_IDENTIFIER)? RBRACKET)*;
f<ASTDataTypeNode*> Parser.parseDataType() {
    dyn dataTypeNode = this.createNode<ASTDataTypeNode>();
    dataTypeNode.isFieldType = this.isParsingFieldType;

    if this.isQualifierType(this.lexer.getToken().tokenType) {
        dataTypeNode.qualifierLst = this.parseQualifierLst();
    }
    dataTypeNode.baseDataType = this.parseBaseDataType();

    // Parse type modifiers. If a '>' of a split SHR ('>>') token is still pending, it closes the enclosing generic list
    // first, so the following modifiers belong to the enclosing data type (e.g. the '&' in 'Vector<Vector<int>>&')
    while this.pendingGreaters == 0 {
        if this.currentTokenIs(TokenType::MUL) { // Pointer
            this.expect(TokenType::MUL);
            dataTypeNode.tmQueue.push(TypeModifier(TypeModifierType::TYPE_PTR, false, 0, String()));
        } else if this.currentTokenIs(TokenType::BITWISE_AND) { // Reference
            this.expect(TokenType::BITWISE_AND);
            dataTypeNode.tmQueue.push(TypeModifier(TypeModifierType::TYPE_REF, false, 0, String()));
        } else if this.currentTokenIs(TokenType::LBRACKET) { // Array
            this.expect(TokenType::LBRACKET);
            bool hasSize = false;
            unsigned int hardcodedSize = 0;
            String sizeVarName;
            if this.currentTokenIs(TokenType::INT_LIT) {
                hasSize = true;
                const String& sizeStr = this.lexer.getToken().text;
                hardcodedSize = cast<unsigned int>(toInt(sizeStr.getRaw()));
                this.expect(TokenType::INT_LIT);
            } else if this.currentTokenIs(TokenType::TYPE_IDENTIFIER) {
                hasSize = true;
                sizeVarName = this.getIdentifier(true);
                this.expect(TokenType::TYPE_IDENTIFIER);
            }
            this.expect(TokenType::RBRACKET);
            dataTypeNode.tmQueue.push(TypeModifier(TypeModifierType::TYPE_ARRAY, hasSize, hardcodedSize, sizeVarName));
        } else {
            break;
        }
    }

    return this.concludeNode(dataTypeNode);
}

// baseDataType: TYPE_DOUBLE | TYPE_INT | TYPE_SHORT | TYPE_LONG | TYPE_BYTE | TYPE_CHAR | TYPE_STRING | TYPE_BOOL | TYPE_DYN | customDataType | functionDataType;
f<ASTBaseDataTypeNode*> Parser.parseBaseDataType() {
    dyn baseDataTypeNode = this.createNode<ASTBaseDataTypeNode>();

    const TokenType tokenType = this.lexer.getToken().tokenType;
    if tokenType == TokenType::TYPE_DOUBLE {
        baseDataTypeNode.baseType = BaseDataTypeType::TYPE_DOUBLE;
        this.advance();
    } else if tokenType == TokenType::TYPE_INT {
        baseDataTypeNode.baseType = BaseDataTypeType::TYPE_INT;
        this.advance();
    } else if tokenType == TokenType::TYPE_SHORT {
        baseDataTypeNode.baseType = BaseDataTypeType::TYPE_SHORT;
        this.advance();
    } else if tokenType == TokenType::TYPE_LONG {
        baseDataTypeNode.baseType = BaseDataTypeType::TYPE_LONG;
        this.advance();
    } else if tokenType == TokenType::TYPE_BYTE {
        baseDataTypeNode.baseType = BaseDataTypeType::TYPE_BYTE;
        this.advance();
    } else if tokenType == TokenType::TYPE_CHAR {
        baseDataTypeNode.baseType = BaseDataTypeType::TYPE_CHAR;
        this.advance();
    } else if tokenType == TokenType::TYPE_STRING {
        baseDataTypeNode.baseType = BaseDataTypeType::TYPE_STRING;
        this.advance();
    } else if tokenType == TokenType::TYPE_BOOL {
        baseDataTypeNode.baseType = BaseDataTypeType::TYPE_BOOL;
        this.advance();
    } else if tokenType == TokenType::TYPE_DYN {
        baseDataTypeNode.baseType = BaseDataTypeType::TYPE_DYN;
        this.advance();
    } else if tokenType == TokenType::F || tokenType == TokenType::P {
        baseDataTypeNode.baseType = BaseDataTypeType::TYPE_FUNCTION;
        baseDataTypeNode.functionDataType = cast<IVisitable*>(this.parseFunctionDataType());
    } else {
        baseDataTypeNode.baseType = BaseDataTypeType::TYPE_CUSTOM;
        baseDataTypeNode.customDataType = this.parseCustomDataType();
    }

    return this.concludeNode(baseDataTypeNode);
}

// customDataType: (IDENTIFIER SCOPE_ACCESS)* TYPE_IDENTIFIER (LESS typeLst GREATER)?;
f<ASTCustomDataTypeNode*> Parser.parseCustomDataType() {
    dyn customDataTypeNode = this.createNode<ASTCustomDataTypeNode>();

    // Parse type name: (IDENTIFIER SCOPE_ACCESS)* TYPE_IDENTIFIER
    String fqTypeName;
    while this.currentTokenIs(TokenType::IDENTIFIER) && this.tokenAt(1l) == TokenType::SCOPE_ACCESS {
        const String fragment = this.lexer.getToken().text;
        customDataTypeNode.typeNameFragments.pushBack(fragment);
        fqTypeName += fragment;
        fqTypeName += SCOPE_ACCESS_TOKEN;
        this.expect(TokenType::IDENTIFIER);
        this.expect(TokenType::SCOPE_ACCESS);
    }
    const String typeName = this.lexer.getToken().text;
    customDataTypeNode.typeNameFragments.pushBack(typeName);
    fqTypeName += typeName;
    this.expect(TokenType::TYPE_IDENTIFIER);
    customDataTypeNode.fqTypeName = fqTypeName;

    // Parse typeLst (template type list)
    if this.currentTokenIs(TokenType::LESS) {
        this.expect(TokenType::LESS);
        customDataTypeNode.templateTypeLst = cast<IVisitable*>(this.parseTypeLst());
        this.consumeGenericClose();
    }

    return this.concludeNode(customDataTypeNode);
}

// functionDataType: (F LESS dataType GREATER | P) LPAREN typeLst? RPAREN;
f<ASTFunctionDataTypeNode*> Parser.parseFunctionDataType() {
    dyn functionDataTypeNode = this.createNode<ASTFunctionDataTypeNode>();

    // Field types are only propagated to template types, not to the param and return types of function types
    const bool wasParsingFieldType = this.isParsingFieldType;
    this.isParsingFieldType = false;

    if this.currentTokenIs(TokenType::F) {
        this.expect(TokenType::F);
        this.expect(TokenType::LESS);
        functionDataTypeNode.isFunction = true;
        functionDataTypeNode.returnType = this.parseDataType();
        this.consumeGenericClose();
    } else {
        this.expect(TokenType::P);
    }

    // Parse typeLst (param types)
    this.expect(TokenType::LPAREN);
    if !this.currentTokenIs(TokenType::RPAREN) {
        functionDataTypeNode.paramTypeLst = this.parseTypeLst();
    }
    this.expect(TokenType::RPAREN);

    this.isParsingFieldType = wasParsingFieldType;

    return this.concludeNode(functionDataTypeNode);
}

// ======================================================= Literal helpers =======================================================

/**
 * Parse an integer literal token (INT_LIT, SHORT_LIT or LONG_LIT) and check it against the limits of the target type
 *
 * @param token Literal token. Its text contains the optional unsigned suffix 'u', but not the 's' / 'l' suffixes
 * @param isNegative Whether the literal is preceded by a minus sign
 * @param bitWidth Bit width of the target type (16, 32 or 64)
 * @return Parsed number
 */
f<long> Parser.parseNumeric(const Token& token, bool isNegative, unsigned int bitWidth) {
    String input = token.text;

    // Set to signed if the input string does not end with 'u'
    const bool isUnsigned = input.endsWith("u");
    if isUnsigned {
        input = input.getSubstring(0ul, cast<long>(input.getLength()) - 1l);
    }

    // Detect the base
    int base = 10;
    String digits = input;
    if input.getLength() >= 3l && input[0l] == '0' {
        const char baseChar = toLower(input[1l]);
        if baseChar == 'd' {
            digits = input.getSubstring(2ul);
        } else if baseChar == 'b' {
            base = 2;
            digits = input.getSubstring(2ul);
        } else if baseChar == 'h' || baseChar == 'x' {
            base = 16;
            digits = input.getSubstring(2ul);
        } else if baseChar == 'o' {
            base = 8;
            digits = input.getSubstring(2ul);
        }
    }

    // Parse the magnitude as unsigned, so that values like 2^63 (the absolute value of the min long) fit
    const unsigned long magnitude = strtoull(digits.getRaw(), nil<char**>, base);

    // Check the limits of the target type
    if bitWidth == 64 {
        const unsigned long maxNegMagnitude = 9223372036854775808ul; // 2^63
        if isNegative {
            if magnitude > maxNegMagnitude {
                this.throwParserError(token.codeLoc, ParserErrorType::NUMBER_OUT_OF_RANGE, "The provided number is out of range");
            }
            if magnitude == maxNegMagnitude {
                return -9223372036854775807l - 1l; // Min long
            }
            const long positiveNumber = cast<long>(magnitude);
            return -positiveNumber;
        }
        if !isUnsigned && magnitude > maxNegMagnitude - 1ul {
            this.throwParserError(token.codeLoc, ParserErrorType::NUMBER_OUT_OF_RANGE, "The provided number is out of range");
        }
        return cast<long>(magnitude);
    }
    const long signedUpperLimit = (1l << cast<long>(bitWidth - 1)) - 1l;
    const long upperLimit = isUnsigned ? (1l << cast<long>(bitWidth)) - 1l : signedUpperLimit;
    const long lowerLimit = isUnsigned ? 0l : -signedUpperLimit - 1l;
    if magnitude > cast<unsigned long>(upperLimit) + 1ul {
        this.throwParserError(token.codeLoc, ParserErrorType::NUMBER_OUT_OF_RANGE, "The provided number is out of range");
    }
    long number = cast<long>(magnitude);
    if isNegative {
        number = -number;
    }
    if number < lowerLimit || number > upperLimit {
        this.throwParserError(token.codeLoc, ParserErrorType::NUMBER_OUT_OF_RANGE, "The provided number is out of range");
    }
    return number;
}

/**
 * Parse a char literal token. The lexer keeps escape sequences as is, so they are resolved here
 *
 * @param token Char literal token, without the surrounding quotes
 * @return Char value
 */
f<char> Parser.parseChar(const Token& token) {
    String input = token.text;
    if input.getLength() == 1l { // Normal char literals
        return input[0l];
    }

    if input.getLength() == 2l && input[0l] == '\\' { // Char literals with escape sequence
        const char escapedChar = input[1l];
        switch escapedChar {
            case '\'': { return '\''; }
            case '"': { return '"'; }
            case '\\': { return '\\'; }
            case 'n': { return '\n'; }
            case 'r': { return '\r'; }
            case 't': { return '\t'; }
            case 'b': { return '\b'; }
            case 'f': { return '\f'; }
            case 'v': { return '\v'; }
            case '0': { return '\0'; }
        }
        const String message = "Invalid escape sequence '" + input + "'";
        this.throwParserError(token.codeLoc, ParserErrorType::INVALID_CHAR_LITERAL, message.getRaw());
    }

    const String message = "Invalid char literal '" + input + "'";
    this.throwParserError(token.codeLoc, ParserErrorType::INVALID_CHAR_LITERAL, message.getRaw());
    return '\0';
}

/**
 * Resolve the escape sequences of a string literal. The lexer already strips the surrounding quotes.
 *
 * @param input String literal content
 * @return String value
 */
f<String> parseString(const String& input) {
    String stringValue = input;
    replaceEscapeChars(stringValue);
    return stringValue;
}

/**
 * Replace escape sequences like \n or octal escape sequences like \033 in the given string with their char values
 *
 * @param input String to resolve the escape sequences in
 */
p replaceEscapeChars(String& input) {
    String output;
    unsigned long readIndex = 0l;
    const unsigned long length = input.getLength();

    while readIndex < length {
        const char c = input[readIndex];
        if c == '\\' && readIndex + 1l < length {
            const char next = input[readIndex + 1l];
            const char escapedChar = getEscapedChar(next);
            if escapedChar != '\0' {
                output += escapedChar;
                readIndex += 2l;
                continue;
            }

            // Handle octal escape sequences (up to 3 digits)
            if next >= '0' && next <= '7' {
                int value = 0;
                unsigned long octalDigits = 0l;

                // Look ahead up to 3 digits
                for unsigned long i = 1l; i <= 3l && readIndex + i < length; i++ {
                    const char oc = input[readIndex + i];
                    if oc < '0' || oc > '7' {
                        break;
                    }
                    value = value << 3 | (cast<int>(oc) - cast<int>('0')); // Multiply by 8 and add digit
                    octalDigits++;
                }

                if octalDigits > 0l {
                    output += cast<char>(value);
                    readIndex += 1l + octalDigits; // Backslash + octal digits
                    continue;
                }
            }
        }

        // Copy current character
        output += c;
        readIndex++;
    }

    input = output;
}

/**
 * Get the char value of a simple escape sequence like \n
 *
 * @param c Char after the backslash
 * @return Char value or '\0' if this is no simple escape sequence
 */
f<char> getEscapedChar(char c) {
    switch c {
        case 'a': { return cast<char>(7); } // Bell
        case 'b': { return '\b'; }
        case 'f': { return '\f'; }
        case 'n': { return '\n'; }
        case 'r': { return '\r'; }
        case 't': { return '\t'; }
        case 'v': { return '\v'; }
        case '\\': { return '\\'; }
        case '?': { return '?'; }
        case '\'': { return '\''; }
        case '"': { return '"'; }
    }
    return '\0';
}

/**
 * Abort parsing with a parser error. The bootstrap compiler has no exceptions, so the error is raised as a panic.
 *
 * @param codeLoc Code location of the error
 * @param errorType Type of the error
 * @param message Error message suffix
 */
p Parser.throwParserError(const CodeLoc& codeLoc, ParserErrorType errorType, string message) {
    const ParserError parserError = ParserError(codeLoc, errorType, message);
    const String& errorMessage = parserError.getMessage();
    clearActiveCompileProgress();
    panic(Error(errorMessage.getRaw()));
}
