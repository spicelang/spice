// ─── tests ────────────────────────────────────────────────────────────────────

f<bool> createdPathContains(MockResourceManager& resourceManager, unsigned long index, string needle) {
    const String& createdPath = resourceManager.createdPaths.get(index);
    return createdPath.contains(needle);
}

#[test, test.name="ImportCollector Smoke test"]
public f<bool> testImportCollectorSmoke() {
    // SPICE_BOOTSTRAP_DIR must point to src-bootstrap/ (same requirement as the other bootstrap tests)
    const FilePath bootstrapDir = getBootstrapCompilerDir();
    assert !bootstrapDir.isEmpty();

    Scope root = Scope(nil<Scope*>, nil<ISourceFile*>, ScopeType::GLOBAL, nil<CodeLoc*>);
    MockSourceFile mockFile;
    mockFile.filePath = FilePath("/tmp/mock-main.spice");
    mockFile.globalScopePtr = &root;
    MockResourceManager mockRm;
    mockRm.cliOptions.targetTriple = llvm::Triple(String("x86_64"), String("unknown"), String("linux"));
    IGlobalResourceManager& resourceManager = mockRm;
    ISourceFile* sourceFile = &mockFile;
    ImportCollector collector = ImportCollector(resourceManager, sourceFile);

    // CompilerPass picked up the root scope of the source file
    assert collector.rootScope == &root;

    // ---- visitModAttr: the four core.compiler.* bool attributes ----
    ASTConstantNode trueValue = ASTConstantNode(CodeLoc(1l, 1l, "t.spice"));
    trueValue.compileTimeValue.boolValue = true;
    ASTConstantNode falseValue = ASTConstantNode(CodeLoc(1l, 2l, "t.spice"));
    falseValue.compileTimeValue.boolValue = false;
    ASTAttrNode attrIgnore = ASTAttrNode(CodeLoc(2l, 1l, "t.spice"));
    attrIgnore.key = String(ATTR_CORE_COMPILER_WARNINGS_IGNORE);
    attrIgnore.value = &trueValue;
    ASTAttrNode attrKeep = ASTAttrNode(CodeLoc(3l, 1l, "t.spice"));
    attrKeep.key = String(ATTR_CORE_COMPILER_KEEP_ON_NAME_COLLISION);
    attrKeep.value = &trueValue;
    ASTAttrNode attrTracing = ASTAttrNode(CodeLoc(4l, 1l, "t.spice"));
    attrTracing.key = String(ATTR_CORE_COMPILER_ERROR_RETURN_TRACING);
    attrTracing.value = &falseValue;
    ASTAttrNode attrExplicit = ASTAttrNode(CodeLoc(5l, 1l, "t.spice")); // no value => defaults to true
    attrExplicit.key = String(ATTR_CORE_COMPILER_EXPLICIT_ERROR_HANDLING);
    ASTAttrLstNode attrLst = ASTAttrLstNode(CodeLoc(2l, 1l, "t.spice"));
    attrLst.attributes.pushBack(&attrIgnore);
    attrLst.attributes.pushBack(&attrKeep);
    attrLst.attributes.pushBack(&attrTracing);
    attrLst.attributes.pushBack(&attrExplicit);
    ASTModAttrNode modAttr = ASTModAttrNode(CodeLoc(2l, 1l, "t.spice"));
    modAttr.attrLst = &attrLst;

    mockFile.errorReturnTracing = true; // must be overwritten with 'false'
    collector.visitModAttr(&modAttr);
    assert mockFile.ignoreWarnings;
    assert mockFile.alwaysKeepSymbolsOnNameCollision;
    assert !mockFile.errorReturnTracing;
    assert mockFile.explicitErrorHandling;

    // ---- visitImportDef: rejected import paths ----
    ASTImportDefNode absImport = ASTImportDefNode(CodeLoc(10l, 1l, "t.spice"));
    absImport.importPath = String("/etc/passwd");
    absImport.importName = String("abs");
    collector.visitImportDef(&absImport);
    assert mockRm.errorManager.softErrors.getSize() == 1l;
    assert softErrorContains(mockRm.errorManager, 0l, "must be relative");

    ASTImportDefNode parentImport = ASTImportDefNode(CodeLoc(11l, 1l, "t.spice"));
    parentImport.importPath = String("std/../../etc/passwd");
    parentImport.importName = String("parent");
    collector.visitImportDef(&parentImport);
    assert mockRm.errorManager.softErrors.getSize() == 2l;
    assert softErrorContains(mockRm.errorManager, 1l, "parent-directory");

    ASTImportDefNode missingImport = ASTImportDefNode(CodeLoc(12l, 1l, "t.spice"));
    missingImport.importPath = String("bootstrap/no-such-module");
    missingImport.importName = String("missing");
    collector.visitImportDef(&missingImport);
    assert mockRm.errorManager.softErrors.getSize() == 3l;
    assert softErrorContains(mockRm.errorManager, 2l, "The source file 'no-such-module.spice' was not found");

    // None of the rejected imports registered a symbol, created a source file or added a dependency
    assert root.lookupStrict(String("abs")) == nil<SymbolTableEntry*>;
    assert root.lookupStrict(String("parent")) == nil<SymbolTableEntry*>;
    assert root.lookupStrict(String("missing")) == nil<SymbolTableEntry*>;
    assert mockRm.createdPaths.getSize() == 0l;
    assert mockFile.dependencyNames.getSize() == 0l;

    // ---- visitImportDef: successful import ----
    ASTImportDefNode okImport = ASTImportDefNode(CodeLoc(13l, 1l, "t.spice"));
    okImport.importPath = String("bootstrap/ast/attributes");
    okImport.importName = String("attrs");
    collector.visitImportDef(&okImport);
    assert mockRm.errorManager.softErrors.getSize() == 3l;
    assert mockRm.createdPaths.getSize() == 1l;
    assert createdPathContains(mockRm, 0l, "ast/attributes.spice");
    assert mockFile.dependencyNames.getSize() == 1l;
    assert mockFile.dependencyNames.get(0l) == "attrs";
    assert root.lookupStrict(String("attrs")) != nil<SymbolTableEntry*>;
    assert okImport.entry == root.lookupStrict(String("attrs"));

    // ---- visitImportDef: duplicate import name ----
    ASTImportDefNode dupImport = ASTImportDefNode(CodeLoc(14l, 1l, "t.spice"));
    dupImport.importPath = String("bootstrap/ast/attributes");
    dupImport.importName = String("attrs");
    collector.visitImportDef(&dupImport);
    assert mockRm.errorManager.softErrors.getSize() == 4l;
    assert softErrorContains(mockRm.errorManager, 3l, "Duplicate import 'attrs'");
    assert mockRm.createdPaths.getSize() == 1l;
    assert mockFile.dependencyNames.getSize() == 1l;

    // ---- entry point: visit(ASTEntryNode*) dispatches module attributes and imports through IVisitable ----
    ASTConstantNode resetValue = ASTConstantNode(CodeLoc(20l, 1l, "t.spice"));
    resetValue.compileTimeValue.boolValue = false;
    ASTAttrNode attrReset = ASTAttrNode(CodeLoc(21l, 1l, "t.spice"));
    attrReset.key = String(ATTR_CORE_COMPILER_WARNINGS_IGNORE);
    attrReset.value = &resetValue;
    ASTAttrLstNode attrLst2 = ASTAttrLstNode(CodeLoc(21l, 1l, "t.spice"));
    attrLst2.attributes.pushBack(&attrReset);
    ASTModAttrNode modAttr2 = ASTModAttrNode(CodeLoc(21l, 1l, "t.spice"));
    modAttr2.attrLst = &attrLst2;
    ASTImportDefNode entryImport = ASTImportDefNode(CodeLoc(22l, 1l, "t.spice"));
    entryImport.importPath = String("bootstrap/ast/attributes");
    entryImport.importName = String("attrs2");
    ASTEntryNode entry = ASTEntryNode(CodeLoc(1l, 1l, "t.spice"));
    entry.modAttrs.pushBack(cast<IVisitable*>(&modAttr2));
    entry.importDefs.pushBack(cast<IVisitable*>(&entryImport));

    collector.visit(&entry);
    assert !mockFile.ignoreWarnings; // module attribute visited via the entry point
    assert mockFile.dependencyNames.getSize() == 2l; // import visited via the entry point
    assert mockFile.dependencyNames.get(1l) == "attrs2";
    assert root.lookupStrict(String("attrs2")) != nil<SymbolTableEntry*>;

    return true;
}
