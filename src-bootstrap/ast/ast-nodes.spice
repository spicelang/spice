// ====================================================== IVisitable.getASTNode ==================================================

// Every IVisitable node exposes its composed ASTNode. This is required to reach the node base of a child, that is stored as
// IVisitable* because its type is declared later in this file.

/**
 * Get the composed ASTNode of a visitable node
 *
 * @param node Visitable node
 * @return Composed ASTNode
 */
public f<ASTNode*> getASTNode(IVisitable* node) {
    ASTNode* astNode = nil<ASTNode*>;
    unsafe {
        astNode = cast<ASTNode*>(node.getASTNodeAddress());
    }
    return astNode;
}

