/**
 * Saves a constant value for an AST node to realize features like array-out-of-bounds checks
 */
public type CompileTimeValue union {
    public double doubleValue
    public int intValue
    public short shortValue
    public long longValue
    public byte byteValue
    public char charValue
    public unsigned long stringValueOffset // Offset into vector of strings in GlobalResourceManager
    public bool boolValue
}

public type IVisitable interface {
    public f<Any> accept(IAbstractAstVisitor*);
    public f<const CodeLoc&> getCodeLoc();
    // Address of the composed ASTNode. It is not typed as ASTNode*, because ASTNode is declared after this interface (and
    // needs it for its 'visitable' field). Use getASTNode(IVisitable*) to retrieve the typed pointer.
    public f<byte*> getASTNodeAddress();
}

// ========================================================= ASTNodeKind =========================================================

/**
 * Kind of a concrete AST node. Spice has no virtual dispatch through a struct, so the functions below, that are virtual methods
 * in the host (e.g. returnsOnAllControlPaths), switch over the kind of the node instead.
 */
public type ASTNodeKind enum {
    INVALID,
    ENTRY,
    CONSTANT,
    ATTR,
    ATTR_LST,
    QUALIFIER,
    QUALIFIER_LST,
    CUSTOM_DATA_TYPE,
    BASE_DATA_TYPE,
    DATA_TYPE,
    TYPE_LST,
    MAIN_FCT_DEF,
    FCT_NAME,
    FCT_DEF,
    PROC_DEF,
    STRUCT_DEF,
    INTERFACE_DEF,
    UNION_DEF,
    ENUM_DEF,
    GENERIC_TYPE_DEF,
    ALIAS_DEF,
    GLOBAL_VAR_DEF,
    EXT_DECL,
    IMPORT_DEF,
    UNSAFE_BLOCK,
    FOR_LOOP,
    FOREACH_LOOP,
    WHILE_LOOP,
    DO_WHILE_LOOP,
    IF_STMT,
    ELSE_STMT,
    SWITCH_STMT,
    CASE_BRANCH,
    DEFAULT_BRANCH,
    ANONYMOUS_BLOCK_STMT,
    STMT_LST,
    TYPE_LST_WITH_ELLIPSIS,
    TYPE_ALTS_LST,
    DECL_STMT,
    PARAM_LST,
    ARG_LST,
    ENUM_ITEM,
    ENUM_ITEM_LST,
    FIELD,
    SIGNATURE,
    EXPR_STMT,
    MOD_ATTR,
    TOP_LEVEL_DEF_ATTR,
    LAMBDA_ATTR,
    CASE_CONSTANT,
    RETURN_STMT,
    BREAK_STMT,
    CONTINUE_STMT,
    FALLTHROUGH_STMT,
    ASSERT_STMT,
    ASSIGN_EXPR,
    TERNARY_EXPR,
    LOGICAL_OR_EXPR,
    LOGICAL_AND_EXPR,
    BITWISE_OR_EXPR,
    BITWISE_XOR_EXPR,
    BITWISE_AND_EXPR,
    EQUALITY_EXPR,
    RELATIONAL_EXPR,
    SHIFT_EXPR,
    ADDITIVE_EXPR,
    MULTIPLICATIVE_EXPR,
    CAST_EXPR,
    PREFIX_UNARY_EXPR,
    POSTFIX_UNARY_EXPR,
    ATOMIC_EXPR,
    VALUE,
    FCT_CALL,
    ARRAY_INITIALIZATION,
    STRUCT_INSTANTIATION,
    LAMBDA_FUNC,
    LAMBDA_PROC,
    LAMBDA_EXPR,
    FUNCTION_DATA_TYPE
}

// =========================================================== ASTNode ===========================================================

public type ASTNode struct/*: IVisitable*/ {
    public ASTNode* parent = nil<ASTNode*>
    public Vector<ASTNode*> children
    public CodeLoc codeLoc
    // The node as an IVisitable*, set by the parser when it creates the node. A plain ASTNode* cannot be dispatched
    // on (Spice has no virtual dispatch through a struct), so generic child traversal goes through this pointer.
    public IVisitable* visitable = nil<IVisitable*>
    // Kind of the concrete node. Set by the constructor of the concrete node
    public ASTNodeKind kind = ASTNodeKind::INVALID
    // Whether the node is an expression / statement node. Set by the constructors of ASTExprNode / ASTStmtNode
    public bool isExprNode = false
    public bool isStmtNode = false
}

public p ASTNode.ctor(const CodeLoc& codeLoc) {
    this.codeLoc = codeLoc;
}

// Explicit destructor. AST nodes only ever live inside the BlockAllocator pool and are released via
// sDestruct(ASTNode*), so their destructor is never reached through normal value destruction. Defining
// it explicitly makes sure it is generated. The composed 'children' vector only holds non-owning
// pointers, so it is enough to let the implicitly appended member destruction free the vector storage.
public p ASTNode.dtor() {}

public f<Any> ASTNode.accept(IAbstractAstVisitor* _) {
    assert false; // Concrete node types must override accept()
    return Any();
}

// Register a child node and set its parent to this node.
public p ASTNode.addChild(ASTNode* child) {
    assert child != nil<ASTNode*>;
    child.parent = this;
    this.children.pushBack(child);
}

public f<const Vector<ASTNode*>&> ASTNode.getChildren() {
    return this.children;
}

/**
 * Dispatch to all registered children of a node, like the host's AbstractASTVisitor::visitChildren. Passes use this
 * as the default behavior of every visit method they do not implement themselves.
 *
 * @param node Node whose children should be visited
 * @param visitor Visitor to dispatch to
 */
public f<Any> visitChildrenOf(ASTNode* node, IAbstractAstVisitor* visitor) {
    foreach ASTNode* child : node.children {
        assert child != nil<ASTNode*>;
        assert child.visitable != nil<IVisitable*>;
        child.visitable.accept(visitor);
    }
    return Any();
}

