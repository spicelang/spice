#[test, test.name="ASTNodes Smoke test"]
public f<bool> testASTNodesSmoke() {
    const CodeLoc loc = CodeLoc(3l, 7l, "ast.spice");

    // Base node
    ASTNode base = ASTNode(loc);
    assert base.codeLoc.line == 3l;
    assert base.codeLoc.col == 7l;
    assert base.parent == nil<ASTNode*>;

    // Stmt node composes a base node + carries the 'unreachable' flag
    ASTStmtNode stmt = ASTStmtNode(loc);
    assert stmt.node.codeLoc.line == 3l;
    assert !stmt.unreachable;
    stmt.unreachable = true;
    assert stmt.unreachable;

    // Expression node composes a base node
    ASTExprNode expr = ASTExprNode(loc);
    assert expr.node.codeLoc.col == 7l;

    // Top-level def node composes a base node
    ASTTopLevelDefNode topDef = ASTTopLevelDefNode(loc);
    assert topDef.node.codeLoc.line == 3l;

    // Function-def base composes a top-level def
    ASTFctDefBaseNode fctBase = ASTFctDefBaseNode(loc);
    assert fctBase.node.node.codeLoc.line == 3l;

    // FctDef composes the FctDef-base
    ASTFctDefNode fctDef = ASTFctDefNode(loc);
    assert fctDef.node.node.node.codeLoc.line == 3l;

    // QualifierNode carries a QualifierType
    ASTQualifierNode qual = ASTQualifierNode(loc);
    assert qual.qualifierType == QualifierType::NONE;
    qual.qualifierType = QualifierType::CONST;
    assert qual.qualifierType == QualifierType::CONST;

    // TypeLstWithEllipsisNode
    ASTTypeLstWithEllipsisNode typeLstEllipsis = ASTTypeLstWithEllipsisNode(loc);
    assert typeLstEllipsis.node.codeLoc.line == 3l;

    // TopLevelDefAttrNode
    ASTTopLevelDefAttrNode tlAttr = ASTTopLevelDefAttrNode(loc);
    assert tlAttr.node.codeLoc.line == 3l;

    return true;
}

// ======================================================= Virtual methods =======================================================

// The host implements the following functions as virtual methods of ASTNode, which are overridden by the concrete nodes.
// Spice has no virtual dispatch through a struct, so they switch over the kind of the node instead. The concrete node is
// reached via its IVisitable pointer, which has the same address as the concrete node.

/**
 * Get the concrete node of an AST node
 *
 * @param node AST node, which must be of the given concrete node type
 * @return Concrete node
 */
public f<ConcreteNode*> downcast<ConcreteNode>(ASTNode* node) {
    ConcreteNode* concreteNode = nil<ConcreteNode*>;
    unsafe {
        concreteNode = cast<ConcreteNode*>(node.visitable);
    }
    return concreteNode;
}

/**
 * Get the concrete node of an AST node, that is stored as IVisitable*
 *
 * @param node AST node, which must be of the given concrete node type
 * @return Concrete node
 */
public f<ConcreteNode*> downcast<ConcreteNode>(IVisitable* node) {
    ConcreteNode* concreteNode = nil<ConcreteNode*>;
    unsafe {
        concreteNode = cast<ConcreteNode*>(node);
    }
    return concreteNode;
}

// Do node-specific work when the AST gets resized to a number of manifestations
/**
 * Get the operator overloading functions of a node, that supports operator overloading. Equal to the host's
 * ASTNode::getOpFctPointers(), which is overridden by the concrete nodes.
 *
 * @return Operator overloading functions per manifestation
 */
public f<Vector<Vector<const Function*>>*> ASTNode.getOpFctPointers() {
    Vector<Vector<const Function*>>* opFctPointers = nil<Vector<Vector<const Function*>>*>;
    switch this.kind {
        case ASTNodeKind::ASSIGN_EXPR: {
            ASTAssignExprNode* concreteNode = downcast<ASTAssignExprNode>(this);
            opFctPointers = &concreteNode.opFct;
        }
        case ASTNodeKind::BITWISE_OR_EXPR: {
            ASTBitwiseOrExprNode* concreteNode = downcast<ASTBitwiseOrExprNode>(this);
            opFctPointers = &concreteNode.opFct;
        }
        case ASTNodeKind::BITWISE_XOR_EXPR: {
            ASTBitwiseXorExprNode* concreteNode = downcast<ASTBitwiseXorExprNode>(this);
            opFctPointers = &concreteNode.opFct;
        }
        case ASTNodeKind::BITWISE_AND_EXPR: {
            ASTBitwiseAndExprNode* concreteNode = downcast<ASTBitwiseAndExprNode>(this);
            opFctPointers = &concreteNode.opFct;
        }
        case ASTNodeKind::EQUALITY_EXPR: {
            ASTEqualityExprNode* concreteNode = downcast<ASTEqualityExprNode>(this);
            opFctPointers = &concreteNode.opFct;
        }
        case ASTNodeKind::SHIFT_EXPR: {
            ASTShiftExprNode* concreteNode = downcast<ASTShiftExprNode>(this);
            opFctPointers = &concreteNode.opFct;
        }
        case ASTNodeKind::ADDITIVE_EXPR: {
            ASTAdditiveExprNode* concreteNode = downcast<ASTAdditiveExprNode>(this);
            opFctPointers = &concreteNode.opFct;
        }
        case ASTNodeKind::MULTIPLICATIVE_EXPR: {
            ASTMultiplicativeExprNode* concreteNode = downcast<ASTMultiplicativeExprNode>(this);
            opFctPointers = &concreteNode.opFct;
        }
        case ASTNodeKind::PREFIX_UNARY_EXPR: {
            ASTPrefixUnaryExprNode* concreteNode = downcast<ASTPrefixUnaryExprNode>(this);
            opFctPointers = &concreteNode.opFct;
        }
        case ASTNodeKind::POSTFIX_UNARY_EXPR: {
            ASTPostfixUnaryExprNode* concreteNode = downcast<ASTPostfixUnaryExprNode>(this);
            opFctPointers = &concreteNode.opFct;
        }
        default: {
            panic(Error("The given node does not overload the getOpFctPointers function"));
        }
    }
    return opFctPointers;
}

/**
 * Check if nodes of the given kind store operator overloading functions (getOpFctPointers)
 *
 * @param kind Node kind
 * @return Stores operator overloading functions or not
 */
f<bool> hasOpFctPointers(ASTNodeKind kind) {
    switch kind {
        case ASTNodeKind::ASSIGN_EXPR, ASTNodeKind::BITWISE_OR_EXPR, ASTNodeKind::BITWISE_XOR_EXPR, ASTNodeKind::BITWISE_AND_EXPR, ASTNodeKind::EQUALITY_EXPR, ASTNodeKind::SHIFT_EXPR, ASTNodeKind::ADDITIVE_EXPR, ASTNodeKind::MULTIPLICATIVE_EXPR, ASTNodeKind::PREFIX_UNARY_EXPR, ASTNodeKind::POSTFIX_UNARY_EXPR: {
            return true;
        }
        default: {
            return false;
        }
    }
}

p customItemsInitialization(ASTNode* node, unsigned long manifestationCount) {
    if node.kind == ASTNodeKind::ASSIGN_EXPR {
        ASTAssignExprNode* assignExprNode = downcast<ASTAssignExprNode>(node);
        while assignExprNode.lhsDtorFct.getSize() < manifestationCount {
            assignExprNode.lhsDtorFct.pushBack(nil<const Function*>);
        }
    }
    if hasOpFctPointers(node.kind) {
        // Each manifestation starts with one empty operator function slot (host: opFct.resize(manifestationCount, {nullptr}))
        Vector<Vector<const Function*>>* opFct = node.getOpFctPointers();
        while opFct.getSize() < manifestationCount {
            Vector<const Function*> opFctsOfManifestation;
            opFctsOfManifestation.pushBack(nil<const Function*>);
            opFct.pushBack(opFctsOfManifestation);
        }
    }
    if node.kind == ASTNodeKind::DECL_STMT {
        ASTDeclStmtNode* declStmtNode = downcast<ASTDeclStmtNode>(node);
        while declStmtNode.entries.getSize() < manifestationCount {
            declStmtNode.entries.pushBack(nil<SymbolTableEntry*>);
        }
    }
    if node.kind == ASTNodeKind::IF_STMT {
        ASTIfStmtNode* ifStmtNode = downcast<ASTIfStmtNode>(node);
        while ifStmtNode.compileThenBranch.getSize() < manifestationCount {
            ifStmtNode.compileThenBranch.pushBack(true);
        }
        while ifStmtNode.compileElseBranch.getSize() < manifestationCount {
            ifStmtNode.compileElseBranch.pushBack(true);
        }
    }
}

/**
 * Check if the given node returns on all control paths
 *
 * @param doSetPredecessorsUnreachable Whether statements after a returning statement are marked as unreachable. Can be
 *                                     reset by the callee, if the return statement is only a modification of the result
 * @param manIdx Manifestation index
 * @return Returns on all control paths or not
 */
public f<bool> ASTNode.returnsOnAllControlPaths(bool* doSetPredecessorsUnreachable, unsigned long manIdx) {
    switch this.kind {
        case ASTNodeKind::MAIN_FCT_DEF: {
            ASTMainFctDefNode* mainFctDefNode = downcast<ASTMainFctDefNode>(this);
            return returnsOnAllControlPaths(mainFctDefNode.body, doSetPredecessorsUnreachable, manIdx);
        }
        case ASTNodeKind::FCT_DEF: {
            ASTFctDefNode* fctDefNode = downcast<ASTFctDefNode>(this);
            return returnsOnAllControlPaths(fctDefNode.body, doSetPredecessorsUnreachable, manIdx);
        }
        case ASTNodeKind::PROC_DEF: {
            ASTProcDefNode* procDefNode = downcast<ASTProcDefNode>(this);
            return returnsOnAllControlPaths(procDefNode.body, doSetPredecessorsUnreachable, manIdx);
        }
        case ASTNodeKind::FOR_LOOP: {
            // If we have the guarantee that the loop condition is always true and the loop body returns on all control paths,
            // we can assume that the loop itself will always return
            ASTForLoopNode* forLoopNode = downcast<ASTForLoopNode>(this);
            const bool condAlwaysTrue = isAlwaysTrue(forLoopNode.condAssign, manIdx);
            return condAlwaysTrue && returnsOnAllControlPaths(forLoopNode.body, doSetPredecessorsUnreachable, manIdx);
        }
        case ASTNodeKind::WHILE_LOOP: {
            // If we have the guarantee that the loop condition is always true and the loop body returns on all control paths,
            // we can assume that the loop itself will always return
            ASTWhileLoopNode* whileLoopNode = downcast<ASTWhileLoopNode>(this);
            const bool condAlwaysTrue = isAlwaysTrue(whileLoopNode.condition, manIdx);
            return condAlwaysTrue && returnsOnAllControlPaths(whileLoopNode.body, doSetPredecessorsUnreachable, manIdx);
        }
        case ASTNodeKind::DO_WHILE_LOOP: {
            // Do-while loops will always be executed at least once. So if the body returns on all control paths, the loop will as well
            ASTDoWhileLoopNode* doWhileLoopNode = downcast<ASTDoWhileLoopNode>(this);
            return returnsOnAllControlPaths(doWhileLoopNode.body, doSetPredecessorsUnreachable, manIdx);
        }
        case ASTNodeKind::IF_STMT: {
            ASTIfStmtNode* ifStmtNode = downcast<ASTIfStmtNode>(this);
            // If the condition always evaluates to 'true' the then block must return
            if !ifStmtNode.doCompileElseBranch(manIdx) {
                return returnsOnAllControlPaths(ifStmtNode.thenBody, doSetPredecessorsUnreachable, manIdx);
            }
            // If the condition always evaluates to 'false' the else block must return
            const bool hasElseStmt = ifStmtNode.elseStmt != nil<IVisitable*>;
            if !ifStmtNode.doCompileThenBranch(manIdx) {
                return hasElseStmt && returnsOnAllControlPaths(ifStmtNode.elseStmt, doSetPredecessorsUnreachable, manIdx);
            }
            // If the condition does not always evaluate to 'true' or 'false' we need to check both branches
            return returnsOnAllControlPaths(ifStmtNode.thenBody, doSetPredecessorsUnreachable, manIdx) && hasElseStmt
                && returnsOnAllControlPaths(ifStmtNode.elseStmt, doSetPredecessorsUnreachable, manIdx);
        }
        case ASTNodeKind::ELSE_STMT: {
            ASTElseStmtNode* elseStmtNode = downcast<ASTElseStmtNode>(this);
            if elseStmtNode.isElseIf {
                return returnsOnAllControlPaths(elseStmtNode.ifStmt, doSetPredecessorsUnreachable, manIdx);
            }
            return returnsOnAllControlPaths(elseStmtNode.body, doSetPredecessorsUnreachable, manIdx);
        }
        case ASTNodeKind::SWITCH_STMT: {
            ASTSwitchStmtNode* switchStmtNode = downcast<ASTSwitchStmtNode>(this);
            foreach IVisitable* caseBranch : switchStmtNode.caseBranches {
                if !returnsOnAllControlPaths(caseBranch, doSetPredecessorsUnreachable, manIdx) {
                    return false;
                }
            }
            const bool hasDefaultBranch = switchStmtNode.defaultBranch != nil<IVisitable*>;
            return !hasDefaultBranch || returnsOnAllControlPaths(switchStmtNode.defaultBranch, doSetPredecessorsUnreachable, manIdx);
        }
        case ASTNodeKind::CASE_BRANCH: {
            ASTCaseBranchNode* caseBranchNode = downcast<ASTCaseBranchNode>(this);
            return returnsOnAllControlPaths(caseBranchNode.body, doSetPredecessorsUnreachable, manIdx);
        }
        case ASTNodeKind::DEFAULT_BRANCH: {
            ASTDefaultBranchNode* defaultBranchNode = downcast<ASTDefaultBranchNode>(this);
            return returnsOnAllControlPaths(defaultBranchNode.body, doSetPredecessorsUnreachable, manIdx);
        }
        case ASTNodeKind::STMT_LST: {
            ASTStmtLstNode* stmtLstNode = downcast<ASTStmtLstNode>(this);
            // An empty statement list does not return at all
            if stmtLstNode.statements.isEmpty() {
                return false;
            }
            // A statement list returns on all control paths, if the one direct child statement returns on all control paths
            bool returnsOnAllPaths = false;
            foreach IVisitable* child : stmtLstNode.statements {
                assert child != nil<IVisitable*>;
                ASTNode* childNode = getASTNode(child);

                // Prevent marking instructions as unreachable if doSetPredecessorsUnreachable is set to false
                if returnsOnAllPaths && *doSetPredecessorsUnreachable {
                    ASTStmtNode* stmtNode = asStmtNode(childNode);
                    stmtNode.unreachable = true;
                }

                if childNode.returnsOnAllControlPaths(doSetPredecessorsUnreachable, manIdx) {
                    returnsOnAllPaths = true;
                }
            }
            return returnsOnAllPaths;
        }
        case ASTNodeKind::RETURN_STMT: {
            return true;
        }
        case ASTNodeKind::ASSIGN_EXPR: {
            ASTAssignExprNode* assignExprNode = downcast<ASTAssignExprNode>(this);
            // If it's a ternary, do the default thing
            if assignExprNode.op == AssignOp::OP_NONE {
                return returnsOnAllControlPaths(assignExprNode.ternaryExpr, doSetPredecessorsUnreachable, manIdx);
            }

            // If it's a modification on the result variable, we technically return from the function, but at the end of the function.
            ASTAtomicExprNode* atomicExpr = assignExprNode.getLhsAtomicNode();
            if atomicExpr != nil<ASTAtomicExprNode*> && atomicExpr.fqIdentifier == RETURN_VARIABLE_NAME {
                // If we assign the result variable, we technically return from the function, but at the end of the function.
                // Therefore, the following code is not unreachable, but will be executed in any case.
                *doSetPredecessorsUnreachable = false;
                return true;
            }

            return false;
        }
        case ASTNodeKind::FCT_CALL: {
            // Some builtin functions terminate the control flow, e.g. panic
            ASTFctCallNode* fctCallNode = downcast<ASTFctCallNode>(this);
            BuiltinFunctionInfo builtinFunctionInfo;
            return lookupBuiltinFunction(fctCallNode.fqFunctionName, builtinFunctionInfo) && builtinFunctionInfo.isFunctionTerminator;
        }
        case ASTNodeKind::LAMBDA_FUNC: {
            ASTLambdaFuncNode* lambdaFuncNode = downcast<ASTLambdaFuncNode>(this);
            return returnsOnAllControlPaths(lambdaFuncNode.body, doSetPredecessorsUnreachable, manIdx);
        }
        case ASTNodeKind::LAMBDA_PROC: {
            ASTLambdaProcNode* lambdaProcNode = downcast<ASTLambdaProcNode>(this);
            return returnsOnAllControlPaths(lambdaProcNode.body, doSetPredecessorsUnreachable, manIdx);
        }
    }
    // Default behavior: Returns on all control paths if the only child does
    if this.children.getSize() != 1l {
        return false;
    }
    ASTNode* onlyChild = this.children.front();
    return onlyChild.returnsOnAllControlPaths(doSetPredecessorsUnreachable, manIdx);
}

// Shorthand for calling returnsOnAllControlPaths on a node, that is stored as IVisitable*
f<bool> returnsOnAllControlPaths(IVisitable* node, bool* doSetPredecessorsUnreachable, unsigned long manIdx) {
    ASTNode* astNode = getASTNode(node);
    return astNode.returnsOnAllControlPaths(doSetPredecessorsUnreachable, manIdx);
}

// Check if the given node has a compile time value, which is 'true'
f<bool> isAlwaysTrue(IVisitable* node, unsigned long manIdx) {
    ASTNode* astNode = getASTNode(node);
    if !astNode.hasCompileTimeValue(manIdx) {
        return false;
    }
    const CompileTimeValue compileTimeValue = astNode.getCompileTimeValue(manIdx);
    return compileTimeValue.boolValue;
}

/**
 * Check if the given node has a value, that is known at compile time
 *
 * @param manIdx Manifestation index
 * @return Has compile time value or not
 */
public f<bool> ASTNode.hasCompileTimeValue(unsigned long manIdx) {
    switch this.kind {
        case ASTNodeKind::CONSTANT: {
            return true;
        }
        case ASTNodeKind::GLOBAL_VAR_DEF: {
            return true;
        }
        case ASTNodeKind::TERNARY_EXPR: {
            ASTTernaryExprNode* ternaryExprNode = downcast<ASTTernaryExprNode>(this);
            const bool trueExprHasCompileTimeValue = ternaryExprNode.trueExpr == nil<IVisitable*> || hasCompileTimeValue(ternaryExprNode.trueExpr, manIdx);
            const bool falseExprHasCompileTimeValue = ternaryExprNode.falseExpr == nil<IVisitable*> || hasCompileTimeValue(ternaryExprNode.falseExpr, manIdx);
            return hasCompileTimeValue(ternaryExprNode.condition, manIdx) && trueExprHasCompileTimeValue && falseExprHasCompileTimeValue;
        }
        case ASTNodeKind::LOGICAL_OR_EXPR,
             ASTNodeKind::LOGICAL_AND_EXPR,
             ASTNodeKind::BITWISE_OR_EXPR,
             ASTNodeKind::BITWISE_XOR_EXPR,
             ASTNodeKind::BITWISE_AND_EXPR,
             ASTNodeKind::EQUALITY_EXPR,
             ASTNodeKind::RELATIONAL_EXPR,
             ASTNodeKind::SHIFT_EXPR,
             ASTNodeKind::ADDITIVE_EXPR,
             ASTNodeKind::MULTIPLICATIVE_EXPR: {
            // All operands of these nodes are its children
            foreach ASTNode* operand : this.children {
                if !operand.hasCompileTimeValue(manIdx) {
                    return false;
                }
            }
            return true;
        }
        case ASTNodeKind::CAST_EXPR: {
            ASTCastExprNode* castExprNode = downcast<ASTCastExprNode>(this);
            return castExprNode.isCast ? hasCompileTimeValue(castExprNode.assignExpr, manIdx) : hasCompileTimeValue(castExprNode.prefixUnaryExpr, manIdx);
        }
        case ASTNodeKind::PREFIX_UNARY_EXPR: {
            ASTPrefixUnaryExprNode* prefixUnaryExprNode = downcast<ASTPrefixUnaryExprNode>(this);
            if prefixUnaryExprNode.postfixUnaryExpr != nil<IVisitable*> {
                return hasCompileTimeValue(prefixUnaryExprNode.postfixUnaryExpr, manIdx);
            }
            const PrefixUnaryOp op = prefixUnaryExprNode.op;
            const bool isSupported = op == PrefixUnaryOp::OP_NONE || op == PrefixUnaryOp::OP_MINUS || op == PrefixUnaryOp::OP_PLUS_PLUS
                || op == PrefixUnaryOp::OP_MINUS_MINUS || op == PrefixUnaryOp::OP_NOT || op == PrefixUnaryOp::OP_BITWISE_NOT;
            return isSupported && hasCompileTimeValue(prefixUnaryExprNode.prefixUnaryExpr, manIdx);
        }
        case ASTNodeKind::POSTFIX_UNARY_EXPR: {
            ASTPostfixUnaryExprNode* postfixUnaryExprNode = downcast<ASTPostfixUnaryExprNode>(this);
            if postfixUnaryExprNode.atomicExpr != nil<IVisitable*> {
                return hasCompileTimeValue(postfixUnaryExprNode.atomicExpr, manIdx);
            }
            const PostfixUnaryOp op = postfixUnaryExprNode.op;
            const bool isSupported = op == PostfixUnaryOp::OP_NONE || op == PostfixUnaryOp::OP_PLUS_PLUS || op == PostfixUnaryOp::OP_MINUS_MINUS;
            return isSupported && hasCompileTimeValue(postfixUnaryExprNode.postfixUnaryExpr, manIdx);
        }
        case ASTNodeKind::VALUE: {
            ASTValueNode* valueNode = downcast<ASTValueNode>(this);
            if valueNode.isNil {
                return true;
            }
        }
        case ASTNodeKind::FCT_CALL: {
            // ToDo: Return true for builtin function calls with a compile time value, once FctCallNode.data is ported
            return false;
        }
    }
    // Default behavior: Has a compile time value if the only child has one
    if this.children.getSize() != 1l {
        return false;
    }
    ASTNode* onlyChild = this.children.front();
    return onlyChild.hasCompileTimeValue(manIdx);
}

// Shorthand for calling hasCompileTimeValue on a node, that is stored as IVisitable*
f<bool> hasCompileTimeValue(IVisitable* node, unsigned long manIdx) {
    ASTNode* astNode = getASTNode(node);
    return astNode.hasCompileTimeValue(manIdx);
}

/**
 * Get the value of the given node, that is known at compile time
 *
 * @param manIdx Manifestation index
 * @return Compile time value
 */
public f<CompileTimeValue> ASTNode.getCompileTimeValue(unsigned long manIdx) {
    CompileTimeValue compileTimeValue;
    switch this.kind {
        case ASTNodeKind::CONSTANT: {
            ASTConstantNode* constantNode = downcast<ASTConstantNode>(this);
            return constantNode.compileTimeValue;
        }
        case ASTNodeKind::GLOBAL_VAR_DEF: {
            ASTGlobalVarDefNode* globalVarDefNode = downcast<ASTGlobalVarDefNode>(this);
            ASTNode* constantNode = cast<ASTNode*>(globalVarDefNode.constant);
            return constantNode.getCompileTimeValue(manIdx);
        }
        case ASTNodeKind::TERNARY_EXPR: {
            ASTTernaryExprNode* ternaryExprNode = downcast<ASTTernaryExprNode>(this);
            assert ternaryExprNode.condition != nil<IVisitable*>;
            if ternaryExprNode.trueExpr == nil<IVisitable*> && ternaryExprNode.falseExpr == nil<IVisitable*> {
                return getCompileTimeValue(ternaryExprNode.condition, manIdx);
            }

            // If the condition has no compile time value, we do not need to evaluate the true and false values
            if !hasCompileTimeValue(ternaryExprNode.condition, manIdx) {
                return compileTimeValue;
            }

            // Check if the condition always evaluates to 'true'
            const CompileTimeValue conditionValue = getCompileTimeValue(ternaryExprNode.condition, manIdx);
            if conditionValue.boolValue {
                IVisitable* trueValue = ternaryExprNode.isShortened ? ternaryExprNode.condition : ternaryExprNode.trueExpr;
                assert trueValue != nil<IVisitable*>;
                return getCompileTimeValue(trueValue, manIdx);
            }

            assert ternaryExprNode.falseExpr != nil<IVisitable*>;
            return getCompileTimeValue(ternaryExprNode.falseExpr, manIdx);
        }
        case ASTNodeKind::LOGICAL_OR_EXPR: {
            if this.children.getSize() == 1l {
                return getChildCompileTimeValue(this, 0l, manIdx);
            }
            // Check if one expression evaluates to 'true'
            foreach ASTNode* operand : this.children {
                assert operand.hasCompileTimeValue(manIdx);
                // If one operand evaluates to 'true' the whole expression is 'true'
                const CompileTimeValue operandValue = operand.getCompileTimeValue(manIdx);
                if operandValue.boolValue {
                    compileTimeValue.boolValue = true;
                    return compileTimeValue;
                }
            }
            // Return 'false'
            compileTimeValue.boolValue = false;
            return compileTimeValue;
        }
        case ASTNodeKind::LOGICAL_AND_EXPR: {
            if this.children.getSize() == 1l {
                return getChildCompileTimeValue(this, 0l, manIdx);
            }
            // Check if all expressions evaluate to 'true'
            foreach ASTNode* operand : this.children {
                assert operand.hasCompileTimeValue(manIdx);
                // If one operand evaluates to 'false' the whole expression is 'false'
                const CompileTimeValue operandValue = operand.getCompileTimeValue(manIdx);
                if !operandValue.boolValue {
                    compileTimeValue.boolValue = false;
                    return compileTimeValue;
                }
            }
            // Return 'false' (mirrors the host)
            compileTimeValue.boolValue = false;
            return compileTimeValue;
        }
        case ASTNodeKind::BITWISE_OR_EXPR, ASTNodeKind::BITWISE_XOR_EXPR, ASTNodeKind::BITWISE_AND_EXPR: {
            if this.children.getSize() == 1l {
                return getChildCompileTimeValue(this, 0l, manIdx);
            }
            compileTimeValue = getChildCompileTimeValue(this, 0l, manIdx);
            for unsigned long i = 1l; i < this.children.getSize(); i++ {
                ASTNode* operand = this.children.get(i);
                assert operand.hasCompileTimeValue(manIdx);
                const CompileTimeValue operandValue = operand.getCompileTimeValue(manIdx);
                if this.kind == ASTNodeKind::BITWISE_OR_EXPR {
                    compileTimeValue.longValue |= operandValue.longValue;
                } else if this.kind == ASTNodeKind::BITWISE_XOR_EXPR {
                    compileTimeValue.longValue ^= operandValue.longValue;
                } else {
                    compileTimeValue.longValue &= operandValue.longValue;
                }
            }
            return compileTimeValue;
        }
        case ASTNodeKind::EQUALITY_EXPR: {
            if this.children.getSize() == 1l {
                return getChildCompileTimeValue(this, 0l, manIdx);
            }
            ASTEqualityExprNode* equalityExprNode = downcast<ASTEqualityExprNode>(this);
            const CompileTimeValue op0Value = getChildCompileTimeValue(this, 0l, manIdx);
            const CompileTimeValue op1Value = getChildCompileTimeValue(this, 1l, manIdx);
            if equalityExprNode.op == EqualityOp::OP_EQUAL {
                compileTimeValue.boolValue = op0Value.longValue == op1Value.longValue;
            } else {
                assert equalityExprNode.op == EqualityOp::OP_NOT_EQUAL;
                compileTimeValue.boolValue = op0Value.longValue != op1Value.longValue;
            }
            return compileTimeValue;
        }
        case ASTNodeKind::RELATIONAL_EXPR: {
            if this.children.getSize() == 1l {
                return getChildCompileTimeValue(this, 0l, manIdx);
            }
            ASTRelationalExprNode* relationalExprNode = downcast<ASTRelationalExprNode>(this);
            const CompileTimeValue op0Value = getChildCompileTimeValue(this, 0l, manIdx);
            const CompileTimeValue op1Value = getChildCompileTimeValue(this, 1l, manIdx);
            const RelationalOp op = relationalExprNode.op;
            if op == RelationalOp::OP_LESS {
                compileTimeValue.boolValue = op0Value.longValue < op1Value.longValue;
            } else if op == RelationalOp::OP_GREATER {
                compileTimeValue.boolValue = op0Value.longValue > op1Value.longValue;
            } else if op == RelationalOp::OP_LESS_EQUAL {
                compileTimeValue.boolValue = op0Value.longValue <= op1Value.longValue;
            } else {
                assert op == RelationalOp::OP_GREATER_EQUAL;
                compileTimeValue.boolValue = op0Value.longValue >= op1Value.longValue;
            }
            return compileTimeValue;
        }
        case ASTNodeKind::SHIFT_EXPR: {
            if this.children.getSize() == 1l {
                return getChildCompileTimeValue(this, 0l, manIdx);
            }
            ASTShiftExprNode* shiftExprNode = downcast<ASTShiftExprNode>(this);
            compileTimeValue = getChildCompileTimeValue(this, 0l, manIdx);
            ShiftOpQueue opQueueCopy = shiftExprNode.opQueue;
            for unsigned long i = 1l; i < this.children.getSize(); i++ {
                ASTNode* operand = this.children.get(i);
                assert operand.hasCompileTimeValue(manIdx);
                const CompileTimeValue operandValue = operand.getCompileTimeValue(manIdx);
                const Pair<ShiftOp, QualType> opEntry = opQueueCopy.pop();
                if opEntry.getFirst() == ShiftOp::OP_SHIFT_LEFT {
                    compileTimeValue.longValue <<= operandValue.longValue;
                } else {
                    assert opEntry.getFirst() == ShiftOp::OP_SHIFT_RIGHT;
                    compileTimeValue.longValue >>= operandValue.longValue;
                }
            }
            return compileTimeValue;
        }
        case ASTNodeKind::ADDITIVE_EXPR: {
            if this.children.getSize() == 1l {
                return getChildCompileTimeValue(this, 0l, manIdx);
            }
            ASTAdditiveExprNode* additiveExprNode = downcast<ASTAdditiveExprNode>(this);
            compileTimeValue = getChildCompileTimeValue(this, 0l, manIdx);
            AdditiveOpQueue opQueueCopy = additiveExprNode.opQueue;
            for unsigned long i = 1l; i < this.children.getSize(); i++ {
                ASTNode* operand = this.children.get(i);
                assert operand.hasCompileTimeValue(manIdx);
                const CompileTimeValue operandValue = operand.getCompileTimeValue(manIdx);
                const Pair<AdditiveOp, QualType> opEntry = opQueueCopy.pop();
                if opEntry.getFirst() == AdditiveOp::OP_PLUS {
                    compileTimeValue.longValue += operandValue.longValue;
                } else {
                    assert opEntry.getFirst() == AdditiveOp::OP_MINUS;
                    compileTimeValue.longValue -= operandValue.longValue;
                }
            }
            return compileTimeValue;
        }
        case ASTNodeKind::MULTIPLICATIVE_EXPR: {
            if this.children.getSize() == 1l {
                return getChildCompileTimeValue(this, 0l, manIdx);
            }
            ASTMultiplicativeExprNode* multiplicativeExprNode = downcast<ASTMultiplicativeExprNode>(this);
            compileTimeValue = getChildCompileTimeValue(this, 0l, manIdx);
            MultiplicativeOpQueue opQueueCopy = multiplicativeExprNode.opQueue;
            for unsigned long i = 1l; i < this.children.getSize(); i++ {
                ASTNode* operand = this.children.get(i);
                assert operand.hasCompileTimeValue(manIdx);
                const CompileTimeValue operandValue = operand.getCompileTimeValue(manIdx);
                const Pair<MultiplicativeOp, QualType> opEntry = opQueueCopy.pop();
                const MultiplicativeOp op = opEntry.getFirst();
                if op == MultiplicativeOp::OP_MUL {
                    compileTimeValue.longValue *= operandValue.longValue;
                } else if op == MultiplicativeOp::OP_DIV {
                    if operandValue.longValue == 0l {
                        const SemanticError error = SemanticError(operand, SemanticErrorType::DIVISION_BY_ZERO, "Dividing by zero is not allowed.");
                        const String& errorMessage = error.getMessage();
                        panic(Error(errorMessage.getRaw()));
                    }
                    compileTimeValue.longValue /= operandValue.longValue;
                } else {
                    assert op == MultiplicativeOp::OP_REM;
                    // Note: The host does not check for a zero divisor here and crashes with SIGFPE
                    if operandValue.longValue == 0l {
                        const SemanticError error = SemanticError(operand, SemanticErrorType::DIVISION_BY_ZERO, "Dividing by zero is not allowed.");
                        const String& errorMessage = error.getMessage();
                        panic(Error(errorMessage.getRaw()));
                    }
                    compileTimeValue.longValue %= operandValue.longValue;
                }
            }
            return compileTimeValue;
        }
        case ASTNodeKind::CAST_EXPR: {
            ASTCastExprNode* castExprNode = downcast<ASTCastExprNode>(this);
            return castExprNode.isCast ? getCompileTimeValue(castExprNode.assignExpr, manIdx) : getCompileTimeValue(castExprNode.prefixUnaryExpr, manIdx);
        }
        case ASTNodeKind::PREFIX_UNARY_EXPR: {
            ASTPrefixUnaryExprNode* prefixUnaryExprNode = downcast<ASTPrefixUnaryExprNode>(this);
            if prefixUnaryExprNode.postfixUnaryExpr != nil<IVisitable*> {
                return getCompileTimeValue(prefixUnaryExprNode.postfixUnaryExpr, manIdx);
            }
            const CompileTimeValue opValue = getCompileTimeValue(prefixUnaryExprNode.prefixUnaryExpr, manIdx);
            const PrefixUnaryOp op = prefixUnaryExprNode.op;
            if op == PrefixUnaryOp::OP_MINUS {
                compileTimeValue.longValue = -opValue.longValue;
            } else if op == PrefixUnaryOp::OP_PLUS_PLUS {
                compileTimeValue.longValue = opValue.longValue + 1l;
            } else if op == PrefixUnaryOp::OP_MINUS_MINUS {
                compileTimeValue.longValue = opValue.longValue - 1l;
            } else if op == PrefixUnaryOp::OP_NOT {
                compileTimeValue.boolValue = !opValue.boolValue;
            } else {
                assert op == PrefixUnaryOp::OP_BITWISE_NOT;
                compileTimeValue.longValue = ~opValue.longValue;
            }
            return compileTimeValue;
        }
        case ASTNodeKind::POSTFIX_UNARY_EXPR: {
            ASTPostfixUnaryExprNode* postfixUnaryExprNode = downcast<ASTPostfixUnaryExprNode>(this);
            if postfixUnaryExprNode.atomicExpr != nil<IVisitable*> {
                return getCompileTimeValue(postfixUnaryExprNode.atomicExpr, manIdx);
            }
            // The postfix operators return the value before the modification
            const PostfixUnaryOp op = postfixUnaryExprNode.op;
            assert op == PostfixUnaryOp::OP_PLUS_PLUS || op == PostfixUnaryOp::OP_MINUS_MINUS;
            return getCompileTimeValue(postfixUnaryExprNode.postfixUnaryExpr, manIdx);
        }
        case ASTNodeKind::VALUE: {
            ASTValueNode* valueNode = downcast<ASTValueNode>(this);
            if valueNode.isNil {
                compileTimeValue.longValue = 0l;
                return compileTimeValue;
            }
        }
    }
    // Default behavior: Take the compile time value of the only child
    if this.children.getSize() != 1l {
        return compileTimeValue;
    }
    return getChildCompileTimeValue(this, 0l, manIdx);
}

// Shorthand for getting the compile time value of the child with the given index
f<CompileTimeValue> getChildCompileTimeValue(ASTNode* node, unsigned long childIdx, unsigned long manIdx) {
    ASTNode* child = node.children.get(childIdx);
    return child.getCompileTimeValue(manIdx);
}

// Shorthand for calling getCompileTimeValue on a node, that is stored as IVisitable*
f<CompileTimeValue> getCompileTimeValue(IVisitable* node, unsigned long manIdx) {
    ASTNode* astNode = getASTNode(node);
    return astNode.getCompileTimeValue(manIdx);
}

/**
 * Get the atomic expression on the left hand side of an assignment, if there is one
 *
 * @return Atomic expression node or nil
 */
public f<ASTAtomicExprNode*> ASTAssignExprNode.getLhsAtomicNode() {
    ASTNode* lhsNode = getASTNode(this.lhs);
    if lhsNode.kind == ASTNodeKind::ATOMIC_EXPR {
        return downcast<ASTAtomicExprNode>(lhsNode);
    }
    ASTNode* lastChild = lhsNode.children.back();
    if lastChild.kind == ASTNodeKind::ATOMIC_EXPR {
        return downcast<ASTAtomicExprNode>(lastChild);
    }
    ASTNode* firstGrandChild = lastChild.children.front();
    if firstGrandChild.kind == ASTNodeKind::ATOMIC_EXPR {
        return downcast<ASTAtomicExprNode>(firstGrandChild);
    }
    return nil<ASTAtomicExprNode*>;
}

// ====================================================== IVisitable.getCodeLoc ==================================================

// Every IVisitable node exposes its own code location. Passes use it to name the scope of an expression the same way the
// host does ('expr:' + code location of the expression), so that later passes find the scope again from the node alone.

public f<const CodeLoc&> ASTEntryNode.getCodeLoc() { return this.codeLoc; }
public f<const CodeLoc&> ASTConstantNode.getCodeLoc() { return this.codeLoc; }
public f<const CodeLoc&> ASTAttrNode.getCodeLoc() { return this.codeLoc; }
public f<const CodeLoc&> ASTAttrLstNode.getCodeLoc() { return this.codeLoc; }
public f<const CodeLoc&> ASTQualifierNode.getCodeLoc() { return this.codeLoc; }
public f<const CodeLoc&> ASTQualifierLstNode.getCodeLoc() { return this.codeLoc; }
public f<const CodeLoc&> ASTCustomDataTypeNode.getCodeLoc() { return this.codeLoc; }
public f<const CodeLoc&> ASTBaseDataTypeNode.getCodeLoc() { return this.codeLoc; }
public f<const CodeLoc&> ASTDataTypeNode.getCodeLoc() { return this.codeLoc; }
public f<const CodeLoc&> ASTTypeLstNode.getCodeLoc() { return this.codeLoc; }
public f<const CodeLoc&> ASTMainFctDefNode.getCodeLoc() { return this.codeLoc; }
public f<const CodeLoc&> ASTFctNameNode.getCodeLoc() { return this.codeLoc; }
public f<const CodeLoc&> ASTFctDefNode.getCodeLoc() { return this.codeLoc; }
public f<const CodeLoc&> ASTProcDefNode.getCodeLoc() { return this.codeLoc; }
public f<const CodeLoc&> ASTStructDefNode.getCodeLoc() { return this.codeLoc; }
public f<const CodeLoc&> ASTInterfaceDefNode.getCodeLoc() { return this.codeLoc; }
public f<const CodeLoc&> ASTUnionDefNode.getCodeLoc() { return this.codeLoc; }
public f<const CodeLoc&> ASTEnumDefNode.getCodeLoc() { return this.codeLoc; }
public f<const CodeLoc&> ASTGenericTypeDefNode.getCodeLoc() { return this.codeLoc; }
public f<const CodeLoc&> ASTAliasDefNode.getCodeLoc() { return this.codeLoc; }
public f<const CodeLoc&> ASTGlobalVarDefNode.getCodeLoc() { return this.codeLoc; }
public f<const CodeLoc&> ASTExtDeclNode.getCodeLoc() { return this.codeLoc; }
public f<const CodeLoc&> ASTImportDefNode.getCodeLoc() { return this.codeLoc; }
public f<const CodeLoc&> ASTUnsafeBlockNode.getCodeLoc() { return this.codeLoc; }
public f<const CodeLoc&> ASTForLoopNode.getCodeLoc() { return this.codeLoc; }
public f<const CodeLoc&> ASTForeachLoopNode.getCodeLoc() { return this.codeLoc; }
public f<const CodeLoc&> ASTWhileLoopNode.getCodeLoc() { return this.codeLoc; }
public f<const CodeLoc&> ASTDoWhileLoopNode.getCodeLoc() { return this.codeLoc; }
public f<const CodeLoc&> ASTIfStmtNode.getCodeLoc() { return this.codeLoc; }
public f<const CodeLoc&> ASTElseStmtNode.getCodeLoc() { return this.codeLoc; }
public f<const CodeLoc&> ASTSwitchStmtNode.getCodeLoc() { return this.codeLoc; }
