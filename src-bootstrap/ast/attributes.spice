// Std imports
import "std/data/unordered-map";

// Own imports
import "bootstrap/ast/ast-nodes";

// Constants
public const string ATTR_CORE_LINKER_FLAG = "core.linker.flag";
public const string ATTR_CORE_LINUX_LINKER_FLAG = "core.linux.linker.flag";
public const string ATTR_CORE_DARWIN_LINKER_FLAG = "core.darwin.linker.flag";
public const string ATTR_CORE_WINDOWS_LINKER_FLAG = "core.windows.linker.flag";
public const string ATTR_CORE_LINKER_ADDITIONAL_SOURCE = "core.linker.additionalSource";
public const string ATTR_CORE_LINKER_DLL = "core.linker.dll";
public const string ATTR_CORE_COMPILER_MANGLE = "core.compiler.mangle";
public const string ATTR_CORE_COMPILER_MANGLED_NAME = "core.compiler.mangledName";
public const string ATTR_CORE_COMPILER_KEEP_ON_NAME_COLLISION = "core.compiler.alwaysKeepOnNameCollision";
public const string ATTR_CORE_COMPILER_FIXED_TYPE_ID = "core.compiler.fixedTypeId";
public const string ATTR_CORE_COMPILER_EMIT_VTABLE = "core.compiler.alwaysEmitVTable";
public const string ATTR_CORE_COMPILER_PACKED = "core.compiler.packed";
public const string ATTR_CORE_COMPILER_WARNINGS_IGNORE = "core.compiler.warnings.ignore";
public const string ATTR_CORE_COMPILER_EXPLICIT_ERROR_HANDLING = "core.compiler.explicitErrorHandling";
public const string ATTR_CORE_COMPILER_ERROR_RETURN_TRACING = "core.compiler.errorReturnTracing";
public const string ATTR_TEST = "test";
public const string ATTR_TEST_NAME = "test.name";
public const string ATTR_TEST_SKIP = "test.skip";
public const string ATTR_ASYNC = "async";
public const string ATTR_IGNORE_UNUSED_RETURN_VALUE = "ignoreUnusedReturnValue";

// Enums mirror AttrNode::AttrTarget and AttrNode::AttrType from src/ast/ASTNodes.h
public type AttrTarget enum {
    TARGET_INVALID = 0,
    TARGET_MODULE = 1,
    TARGET_STRUCT = 2,
    TARGET_INTERFACE = 4,
    TARGET_FCT_PROC = 8,
    TARGET_EXT_DECL = 16,
    TARGET_LAMBDA = 32,
    TARGET_UNION = 64
}

public type AttrType enum {
    ATTR_TYPE_INVALID,
    TYPE_STRING,
    TYPE_BOOL,
    TYPE_INT
}

// Structs
public type AttrConfigValue struct {
    public unsigned byte target
    public AttrType attrType
}

/**
 * Look up the allowed targets and the value type of a known attribute. This is the equivalent of the host's ATTR_CONFIGS
 * table (Spice globals must be primitives, so it is a function instead of a map).
 *
 * @param key Attribute key
 * @param config Receives the configuration of the attribute if it is known
 * @return True if the attribute is known
 */
public f<bool> getAttrConfig(const String& key, AttrConfigValue& config) {
    const unsigned byte targetModule = cast<unsigned byte>(AttrTarget::TARGET_MODULE);
    const unsigned byte targetStruct = cast<unsigned byte>(AttrTarget::TARGET_STRUCT);
    const unsigned byte targetInterface = cast<unsigned byte>(AttrTarget::TARGET_INTERFACE);
    const unsigned byte targetFctProc = cast<unsigned byte>(AttrTarget::TARGET_FCT_PROC);
    const unsigned byte targetExtDecl = cast<unsigned byte>(AttrTarget::TARGET_EXT_DECL);
    const unsigned byte targetLambda = cast<unsigned byte>(AttrTarget::TARGET_LAMBDA);
    const unsigned byte targetUnion = cast<unsigned byte>(AttrTarget::TARGET_UNION);

    if key == ATTR_CORE_LINKER_FLAG || key == ATTR_CORE_LINUX_LINKER_FLAG || key == ATTR_CORE_DARWIN_LINKER_FLAG ||
       key == ATTR_CORE_WINDOWS_LINKER_FLAG || key == ATTR_CORE_LINKER_ADDITIONAL_SOURCE {
        config.target = targetModule;
        config.attrType = AttrType::TYPE_STRING;
    } else if key == ATTR_CORE_COMPILER_KEEP_ON_NAME_COLLISION || key == ATTR_CORE_COMPILER_WARNINGS_IGNORE ||
              key == ATTR_CORE_COMPILER_EXPLICIT_ERROR_HANDLING || key == ATTR_CORE_COMPILER_ERROR_RETURN_TRACING {
        config.target = targetModule;
        config.attrType = AttrType::TYPE_BOOL;
    } else if key == ATTR_CORE_COMPILER_FIXED_TYPE_ID {
        config.target = targetStruct | targetInterface | targetUnion;
        config.attrType = AttrType::TYPE_INT;
    } else if key == ATTR_CORE_LINKER_DLL {
        config.target = targetExtDecl;
        config.attrType = AttrType::TYPE_BOOL;
    } else if key == ATTR_CORE_COMPILER_MANGLE {
        config.target = targetFctProc | targetExtDecl;
        config.attrType = AttrType::TYPE_BOOL;
    } else if key == ATTR_CORE_COMPILER_MANGLED_NAME {
        config.target = targetFctProc | targetExtDecl;
        config.attrType = AttrType::TYPE_STRING;
    } else if key == ATTR_CORE_COMPILER_EMIT_VTABLE || key == ATTR_CORE_COMPILER_PACKED {
        config.target = targetStruct;
        config.attrType = AttrType::TYPE_BOOL;
    } else if key == ATTR_TEST || key == ATTR_TEST_SKIP {
        config.target = targetFctProc;
        config.attrType = AttrType::TYPE_BOOL;
    } else if key == ATTR_TEST_NAME {
        config.target = targetFctProc;
        config.attrType = AttrType::TYPE_STRING;
    } else if key == ATTR_ASYNC || key == ATTR_IGNORE_UNUSED_RETURN_VALUE {
        config.target = targetFctProc | targetLambda;
        config.attrType = AttrType::TYPE_BOOL;
    } else {
        return false;
    }
    return true;
}

#[test, test.name="Attributes Smoke test"]
public f<bool> testAttributesSmoke() {
    // Attribute name constants
    assert ATTR_CORE_LINKER_FLAG == "core.linker.flag";
    assert ATTR_CORE_DARWIN_LINKER_FLAG == "core.darwin.linker.flag";
    assert ATTR_TEST == "test";
    assert ATTR_TEST_NAME == "test.name";
    assert ATTR_IGNORE_UNUSED_RETURN_VALUE == "ignoreUnusedReturnValue";

    // AttrTarget is a bitmask (powers of 2)
    assert AttrTarget::TARGET_MODULE == AttrTarget::TARGET_MODULE;
    assert AttrTarget::TARGET_STRUCT != AttrTarget::TARGET_MODULE;
    assert AttrTarget::TARGET_LAMBDA != AttrTarget::TARGET_FCT_PROC;

    // AttrType distinct values
    assert AttrType::TYPE_STRING != AttrType::TYPE_BOOL;
    assert AttrType::ATTR_TYPE_INVALID != AttrType::TYPE_INT;

    // Build a config value
    AttrConfigValue cfg = AttrConfigValue{cast<byte>(8), AttrType::TYPE_STRING};
    assert cfg.attrType == AttrType::TYPE_STRING;

    // Known attributes resolve to the same targets/types as the host's ATTR_CONFIGS table
    AttrConfigValue looked;
    assert getAttrConfig(String(ATTR_CORE_LINKER_FLAG), looked);
    assert looked.target == cast<unsigned byte>(AttrTarget::TARGET_MODULE);
    assert looked.attrType == AttrType::TYPE_STRING;
    assert getAttrConfig(String(ATTR_CORE_COMPILER_FIXED_TYPE_ID), looked);
    assert looked.target == (cast<unsigned byte>(AttrTarget::TARGET_STRUCT) | cast<unsigned byte>(AttrTarget::TARGET_INTERFACE) | cast<unsigned byte>(AttrTarget::TARGET_UNION));
    assert looked.attrType == AttrType::TYPE_INT;
    assert getAttrConfig(String(ATTR_ASYNC), looked);
    assert looked.target == (cast<unsigned byte>(AttrTarget::TARGET_FCT_PROC) | cast<unsigned byte>(AttrTarget::TARGET_LAMBDA));
    assert looked.attrType == AttrType::TYPE_BOOL;
    assert getAttrConfig(String(ATTR_TEST_NAME), looked);
    assert looked.attrType == AttrType::TYPE_STRING;
    assert !getAttrConfig(String("not.an.attribute"), looked);

    return true;
}
