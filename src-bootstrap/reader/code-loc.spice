// Imports
import "std/type/type-conversion";
import "std/data/vector";
import "std/io/filepath";
import "std/text/string-ext";
import "std/os/os";

// Own imports
import "bootstrap/util/test-util";

// Path of the root source file of the compilation. The host's CodeLoc references its source file and retrieves the root source
// file from it. The bootstrap CodeLoc only carries the path of its source file, so the path of the root source file is registered
// here by the GlobalResourceManager, when it creates the root source file.
string ROOT_SOURCE_FILE_PATH = ""; // Empty as long as no root source file is registered

/**
 * Register the path of the root source file, which toPrettyFilePath() makes the paths relative to
 *
 * @param rootSourceFilePath Path of the root source file. Has to stay valid for the whole compilation
 */
public p setRootSourceFilePath(string rootSourceFilePath) {
    ROOT_SOURCE_FILE_PATH = rootSourceFilePath;
}

public type CodeLoc struct {
    public unsigned long line
    public unsigned long col
    public string sourceFilePath
    // Interval of the located source code as offsets of its first and last char (both inclusive), like the host's
    // sourceInterval. The default is an empty interval, like the default of antlr4::misc::Interval.
    public long sourceIntervalStart = -1l
    public long sourceIntervalStop = -2l
}

public p CodeLoc.ctor(unsigned long line, unsigned long col, string sourceFilePath = "") {
    this.line = line;
    this.col = col;
    this.sourceFilePath = sourceFilePath;
}

/**
 * Returns the code location as a string for using it as a map key or similar
 *
 * @return Code location string
 */
public f<String> CodeLoc.toString() {
    return "L" + toString(this.line) + "C" + toString(this.col);
}

/**
 * Returns the code location in a pretty form
 *
 * @return Pretty code location
 */
public f<String> CodeLoc.toPrettyString() {
    const String filePath = this.toPrettyFilePath();
    const String prefix = filePath.isEmpty() ? String() : filePath + ":";
    return prefix + toString(this.line) + ":" + toString(this.col);
}

/**
 * Returns the path of the source file this code location points into, relative to the root source file
 *
 * @return Pretty file path
 */
public f<String> CodeLoc.toPrettyFilePath() {
    // Without a registered root source file (e.g. in unit tests), the path is returned as is
    if len(ROOT_SOURCE_FILE_PATH) == 0 || len(this.sourceFilePath) == 0 {
        return String(this.sourceFilePath);
    }
    String relativePath = getRelativePath(String(this.sourceFilePath), String(ROOT_SOURCE_FILE_PATH));
    if relativePath == "." {
        const FilePath path = FilePath(this.sourceFilePath);
        relativePath = "./" + path.getFileName();
    }
    return relativePath;
}

/**
 * Make the given path relative to the given base path, like std::filesystem::relative(path, base) in C++. Both paths are
 * resolved to their canonical form first. If this is not possible, the path is returned as is.
 *
 * @param path Path to make relative
 * @param base Base path
 * @return Relative path in generic format
 */
public f<String> getRelativePath(const String& path, const String& base) {
    const FilePath originalPath = FilePath(path);
    const FilePath originalBase = FilePath(base);
    FilePath canonicalPath = originalPath.canonical();
    FilePath canonicalBase = originalBase.canonical();
    if canonicalPath.isEmpty() || canonicalBase.isEmpty() {
        return path;
    }
    const Vector<String> pathFragments = split(String(canonicalPath.toGenericString()), '/');
    const Vector<String> baseFragments = split(String(canonicalBase.toGenericString()), '/');

    // Skip the common prefix
    unsigned long commonCount = 0l;
    while commonCount < pathFragments.getSize() && commonCount < baseFragments.getSize() {
        if pathFragments.get(commonCount) != baseFragments.get(commonCount) {
            break;
        }
        commonCount++;
    }

    // Go up for each remaining fragment of the base and then down along the remaining fragments of the path
    String relativePath;
    for unsigned long i = commonCount; i < baseFragments.getSize(); i++ {
        if !relativePath.isEmpty() {
            relativePath += '/';
        }
        relativePath += "..";
    }
    for unsigned long i = commonCount; i < pathFragments.getSize(); i++ {
        if !relativePath.isEmpty() {
            relativePath += '/';
        }
        relativePath += pathFragments.get(i);
    }
    return relativePath.isEmpty() ? String(".") : relativePath;
}

/**
 * Returns the line number in a pretty form
 *
 * @return Pretty line number
 */
public f<String> CodeLoc.toPrettyLine() {
    return "L" + toString(this.line);
}

/**
 * Returns the line and column number in a pretty form
 */
public f<String> CodeLoc.toPrettyLineAndColumn() {
    return this.toString();
}

/**
 * Check if this code location is located before the given one. This is the equivalent of the host's operator<, since
 * Spice does not support overloading '<'.
 *
 * @param other Other code location
 * @return Before or not
 */
public f<bool> CodeLoc.isBefore(const CodeLoc& other) {
    return this.line == other.line ? this.col < other.col : this.line < other.line;
}

/**
 * Check if this code location is located after the given one. This is the equivalent of the host's operator>.
 *
 * @param other Other code location
 * @return After or not
 */
public f<bool> CodeLoc.isAfter(const CodeLoc& other) {
    return this.line == other.line ? this.col > other.col : this.line > other.line;
}

public f<bool> operator==(const CodeLoc &lhs, const CodeLoc &rhs) {
    return lhs.sourceFilePath == rhs.sourceFilePath && lhs.line == rhs.line && lhs.col == rhs.col;
}

// ─── tests ────────────────────────────────────────────────────────────────────

#[test]
f<bool> testGetRelativePath() {
    const FilePath testDir = makeUniqueTestDir("spice-code-loc-test");
    const FilePath realDir = testDir / "real" / "nested";
    createTestDirs(realDir);
    const FilePath realFile = realDir / "file.txt";
    const FilePath otherFile = testDir / "other.txt";
    writeTestFile(realFile, "content");
    writeTestFile(otherFile, "content");

    // Like std::filesystem::relative, the base is treated as a dir, even if it is a file
    const String upwards = getRelativePath(String(otherFile.toString()), String(realFile.toString()));
    const String downwards = getRelativePath(String(realFile.toString()), String(otherFile.toString()));
    const String same = getRelativePath(String(otherFile.toString()), String(otherFile.toString()));

    // A path, that can't be resolved, is returned as is
    const FilePath missingFile = testDir / "non-existing.txt";
    const FilePath canonicalMissingFile = missingFile.canonical();
    const String missing = getRelativePath(String(missingFile.toString()), String(otherFile.toString()));

    // Paths are resolved through symlinks. Creating symlinks requires special privileges on Windows, so this part is skipped
    // there. Through the symlink, the file lives three levels below the test dir, not two
    const FilePath linkDir = testDir / "link-parent" / "link";
    createTestDirs(testDir / "link-parent");
    const bool hasSymlink = createTestDirSymlink(realDir, linkDir);
    String upwardsFromLink = String("../../../other.txt");
    String downwardsToLink = String("../real/nested/file.txt");
    bool linkResolvesToRealFile = true;
    if hasSymlink {
        const FilePath linkFile = linkDir / "file.txt";
        const FilePath linkFileWithDot = linkDir / "." / "file.txt";
        const FilePath canonicalRealFile = realFile.canonical();
        const FilePath canonicalLinkFile = linkFile.canonical();
        const FilePath canonicalLinkFileWithDot = linkFileWithDot.canonical();
        linkResolvesToRealFile = canonicalRealFile.isAbsolute() && canonicalRealFile == canonicalLinkFile && canonicalRealFile == canonicalLinkFileWithDot;
        upwardsFromLink = getRelativePath(String(otherFile.toString()), String(linkFile.toString()));
        downwardsToLink = getRelativePath(String(linkFile.toString()), String(otherFile.toString()));
    }

    // Clean up before asserting, so that a failure does not leave the files behind
    removeTestDir(testDir);
    assert upwards == "../../../other.txt";
    assert downwards == "../real/nested/file.txt";
    assert same == ".";
    assert canonicalMissingFile.isEmpty();
    assert missing == missingFile.toString();
    assert hasSymlink || isWindows();
    assert linkResolvesToRealFile;
    assert upwardsFromLink == "../../../other.txt";
    assert downwardsToLink == "../real/nested/file.txt";
    return true;
}
