// Imports
import "std/type/type-conversion";

public type CodeLoc struct {
    public unsigned long line
    public unsigned long col
    public string sourceFilePath
    // Interval of the located source code as offsets of its first and last char (both inclusive), like the host's
    // sourceInterval. The default is an empty interval, like the default of antlr4::misc::Interval.
    public long sourceIntervalStart = -1l
    public long sourceIntervalStop = -2l
}

public p CodeLoc.ctor(unsigned long line, unsigned long col, string sourceFilePath = "") {
    this.line = line;
    this.col = col;
    this.sourceFilePath = sourceFilePath;
}

/**
 * Returns the code location as a string for using it as a map key or similar
 *
 * @return Code location string
 */
public f<String> CodeLoc.toString() {
    return "L" + toString(this.line) + "C" + toString(this.col);
}

/**
 * Returns the code location in a pretty form
 *
 * @return Pretty code location
 */
public f<String> CodeLoc.toPrettyString() {
    const String filePath = this.toPrettyFilePath();
    const String prefix = filePath.isEmpty() ? String() : filePath + ":";
    return prefix + toString(this.line) + ":" + toString(this.col);
}

/**
 * Returns the path of the source file this code location points into.
 *
 * Note: The host's CodeLoc references the source file and makes the path relative to the root source file. The bootstrap
 * CodeLoc only carries the path, so it is returned as is.
 *
 * @return Pretty file path
 */
public f<String> CodeLoc.toPrettyFilePath() {
    return String(this.sourceFilePath);
}

/**
 * Returns the line number in a pretty form
 *
 * @return Pretty line number
 */
public f<String> CodeLoc.toPrettyLine() {
    return "L" + toString(this.line);
}

/**
 * Returns the line and column number in a pretty form
 */
public f<String> CodeLoc.toPrettyLineAndColumn() {
    return this.toString();
}

/**
 * Check if this code location is located before the given one. This is the equivalent of the host's operator<, since
 * Spice does not support overloading '<'.
 *
 * @param other Other code location
 * @return Before or not
 */
public f<bool> CodeLoc.isBefore(const CodeLoc& other) {
    return this.line == other.line ? this.col < other.col : this.line < other.line;
}

/**
 * Check if this code location is located after the given one. This is the equivalent of the host's operator>.
 *
 * @param other Other code location
 * @return After or not
 */
public f<bool> CodeLoc.isAfter(const CodeLoc& other) {
    return this.line == other.line ? this.col > other.col : this.line > other.line;
}

public f<bool> operator==(const CodeLoc &lhs, const CodeLoc &rhs) {
    return lhs.sourceFilePath == rhs.sourceFilePath && lhs.line == rhs.line && lhs.col == rhs.col;
}

#[test, test.name="CodeLoc Smoke test"]
public f<bool> testCodeLocSmoke() {
    // Constructor without sourceFilePath
    CodeLoc loc1 = CodeLoc(12l, 5l);
    assert loc1.line == 12l;
    assert loc1.col == 5l;
    assert loc1.sourceFilePath == "";

    // toString
    assert loc1.toString() == "L12C5";

    // toPrettyString and toPrettyFilePath without sourceFilePath
    assert loc1.toPrettyString() == "12:5";
    assert loc1.toPrettyFilePath() == "";

    // toPrettyLine
    assert loc1.toPrettyLine() == "L12";

    // toPrettyLineAndColumn
    assert loc1.toPrettyLineAndColumn() == "L12C5";

    // Constructor with sourceFilePath
    CodeLoc loc2 = CodeLoc(7l, 3l, "test.spice");
    assert loc2.toPrettyString() == "test.spice:7:3";
    assert loc2.toPrettyFilePath() == "test.spice";

    // Equality
    CodeLoc loc3 = CodeLoc(12l, 5l);
    assert loc1 == loc3;
    assert !(loc1 == loc2);

    return true;
}