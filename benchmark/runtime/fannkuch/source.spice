// Counts the pancake flips of all permutations (fannkuch-redux). Covers array accesses and integer arithmetic.
// Usage: fannkuch <permutation length (at most 16)>

import "std/type/type-conversion";

f<int> main(int argc, string[] argv) {
    int n = argc > 1 ? toInt(argv[1]) : 7;
    if n < 1 { n = 1; }
    if n > 16 { n = 16; }

    int[16] perm;
    int[16] perm1;
    int[16] count;
    for int i = 0; i < n; i++ {
        perm1[i] = i;
    }

    int maxFlips = 0;
    int checksum = 0;
    int permCount = 0;
    int r = n;
    while true {
        while r != 1 {
            count[r - 1] = r;
            r--;
        }

        // Flip the prefix until the first element is 0
        for int i = 0; i < n; i++ {
            perm[i] = perm1[i];
        }
        int flips = 0;
        int k = perm[0];
        while k != 0 {
            int lo = 0;
            int hi = k;
            while lo < hi {
                const int tmp = perm[lo];
                perm[lo] = perm[hi];
                perm[hi] = tmp;
                lo++;
                hi--;
            }
            flips++;
            k = perm[0];
        }
        if flips > maxFlips {
            maxFlips = flips;
        }
        checksum += permCount % 2 == 0 ? flips : -flips;

        // Next permutation
        while true {
            if r == n {
                printf("%d\nPfannkuchen(%d) = %d\n", checksum, n, maxFlips);
                return 0;
            }
            const int perm0 = perm1[0];
            for int i = 0; i < r; i++ {
                perm1[i] = perm1[i + 1];
            }
            perm1[r] = perm0;
            count[r]--;
            if count[r] > 0 {
                break;
            }
            r++;
        }
        permCount++;
    }
}
