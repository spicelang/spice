// Builds a long string from many small pieces and numbers. Covers String appends, reallocation and number formatting.
// Usage: string-builder <piece count>

import "std/type/type-conversion";

f<int> main(int argc, string[] argv) {
    const int pieceCount = argc > 1 ? toInt(argv[1]) : 100000;

    String text;
    for int i = 0; i < pieceCount; i++ {
        text.append("item-");
        text.append(toString(i));
        text.append(';');
    }

    // Count the separators, to use the result
    unsigned long separators = 0l;
    for unsigned long i = 0l; i < text.getLength(); i++ {
        if text[i] == ';' {
            separators++;
        }
    }
    printf("length: %lu, separators: %lu\n", text.getLength(), separators);
}
