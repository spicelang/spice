---
# clang-tidy configuration for the Spice compiler (src/, test/).
#
# Scope: bug-finding checks (bugprone, clang-analyzer, performance, portability,
# misc) rather than style/opinion checks — formatting is handled by .clang-format
# and naming/layout conventions are documented in STYLE_GUIDE.md. See that file's
# "Memory management" section for why cppcoreguidelines' ownership/pointer checks
# are intentionally left out: the codebase favors raw pointers owned by long-lived
# containers (Scope*, ASTNode*, llvm::Value*) and arena-allocated AST nodes, which
# those checks are not designed for.
#
# clang-analyzer-optin.core.EnumCastOutOfRange is disabled because LLVM's bitmask enums
# (LLVM_MARK_AS_BITMASK_ENUM, e.g. llvm::DINode::DIFlags) are meant to hold ORed combinations of their
# enumerators, which is exactly what the check reports as an out-of-range cast. It is an opt-in analyzer
# check and yields nothing but false positives on the LLVM APIs used throughout the IR generator. It has to be disabled
# here rather than via NOLINT: the diagnostics are reported inside LLVM's own operator| / operator|= (BitmaskEnum.h),
# not at the call site in our sources, so a NOLINT next to our code does not suppress them.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  clang-analyzer-*,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  performance-*,
  portability-*,
  misc-*,
  -misc-non-private-member-variables-in-classes,
  -misc-no-recursion,
  -misc-include-cleaner,
  readability-avoid-const-params-in-decls,
  readability-misleading-indentation,
  readability-redundant-control-flow,
  readability-redundant-declaration

WarningsAsErrors: ''
HeaderFilterRegex: '(src|test)/.*'
FormatStyle: none
