# Diagnostic catalog of the compiler re-implementation (media/specs/compiler-reimplementation.md, section 5.3).
# Source of src-next/diag/codes.spice (python tools/gen/generate.py). A code is the index of its member within its family,
# which is the value of the legacy enum, so the order must not change.
#
# [<Family>] starts a family, 'enum = <name>' gives the name of its enum. A member line is '<MEMBER> = <prefix>'. The prefix
# is the text before the message ('<prefix>: <message>'). Extracted from the legacy sources by tools/gen/extract_diagnostics_def.py.

[Lexer]
enum = LexerErrorType
TOKENIZING_FAILED = Tokenizing failed

[Parser]
enum = ParserErrorType
PARSING_FAILED = Parsing failed
NUMBER_OUT_OF_RANGE = Number is out of range
INVALID_QUALIFIER_COMBINATION = Invalid qualifier combination
INVALID_CHAR_LITERAL = Invalid char literal
INVALID_STRING_LITERAL = Invalid string literal
INVALID_INT_LITERAL = Invalid integer literal
INVALID_ATTR_VALUE_TYPE = Invalid attribute value type
RESERVED_KEYWORD = Usage of reserved keyword
RESERVED_TYPENAME = Usage of reserved typename

[Semantic]
enum = SemanticErrorType
REFERENCED_UNDEFINED_FUNCTION = Referenced undefined function
REFERENCED_UNDEFINED_VARIABLE = Referenced undefined variable
REFERENCED_UNDEFINED_STRUCT = Referenced undefined struct
REFERENCED_UNDEFINED_INTERFACE = Referenced undefined interface
REFERENCED_UNDEFINED_UNION = Referenced undefined union
REFERENCED_UNDEFINED_FIELD = Referenced undefined struct field
USED_BEFORE_DECLARED = Used before declared
FUNCTION_AMBIGUITY = Function ambiguity
STRUCT_AMBIGUITY = Struct ambiguity
INTERFACE_AMBIGUITY = Interface ambiguity
DUPLICATE_SYMBOL = Duplicate symbol
VARIABLE_DECLARED_TWICE = Multiple declarations of the same variable
EXPORTED_SYMBOL_COLLISION = Multiple exported symbols with the same linker name
FUNCTION_DECLARED_TWICE = Multiple declarations of a function
PROCEDURE_DECLARED_TWICE = Multiple declarations of a procedure
STRUCT_INFINITE_SIZE = Struct with infinite size
NO_MATCHING_CTOR_FOUND = No matching ctor found
COPY_CTOR_REQUIRED = Missing mandatory copy ctor
INTERFACE_METHOD_NOT_IMPLEMENTED = Interface method not implemented
INVALID_DEFAULT_METHOD = Invalid default method
INVALID_SYMBOL_ACCESS = Invalid symbol access
DUPLICATE_ENUM_ITEM_VALUE = Duplicate enum item value
GLOBAL_OF_TYPE_DYN = Global of type dyn
GLOBAL_OF_INVALID_TYPE = Global of invalid type
GLOBAL_CONST_WITHOUT_VALUE = Global const without value
MISSING_RETURN_STMT = Missing return statement
INVALID_PARAM_ORDER = Invalid argument order
LAMBDA_WITH_OPTIONAL_PARAMS = Lambda with optional parameters
REFERENCED_OVERLOADED_FCT = Referenced overloaded function
DTOR_MUST_BE_PROCEDURE = Destructor must be a procedure
DTOR_WITH_PARAMS = Destructors must not have parameters
OPERATOR_WRONG_DATA_TYPE = Wrong data type for operator
INVALID_ITERATOR = Invalid iterator
UNEXPECTED_DYN_TYPE = Unexpected dyn type
REASSIGN_CONST_VARIABLE = Cannot re-assign constant variable
CONDITION_MUST_BE_BOOL = Condition must be bool
SWITCH_EXPR_MUST_BE_PRIMITIVE = Switch expression of wrong type
SWITCH_CASE_TYPE_MISMATCH = Case constant type does not match switch expression type
MISSING_MAIN_FUNCTION = Spice executables must contain a main function
FCT_PARAM_IS_TYPE_DYN = Parameter type dyn not valid in function/procedure definition without default value
INVALID_BREAK_NUMBER = Invalid number of break calls
INVALID_CONTINUE_NUMBER = Invalid number of continue calls
FALLTHROUGH_NOT_ALLOWED = Fallthrough statement not allowed here
CASE_CONSTANT_INVALID_TYPE = Case constant of invalid type
PRINTF_TYPE_ERROR = Types of printf call not matching
PRINTF_ARG_COUNT_ERROR = Printf arg number not matching template string
DUPLICATE_IMPORT_NAME = Duplicate import name
IMPORTED_FILE_NOT_EXISTING = Imported source file not existing
INVALID_IMPORT_PATH = Invalid import path
ACCESS_TO_NON_EXISTING_MEMBER = Access to non-existing member
INVALID_MEMBER_ACCESS = Member access is only allowed on structs and Strings
UNKNOWN_DATATYPE = Unknown datatype
UNKNOWN_ATTR = Unknown attribute
INVALID_ATTR_TARGET = Invalid attribute target
MISSING_ATTR_VALUE = Missing attribute value
UNSUPPORTED_ATTR_VALUE = Unsupported attribute value
NUMBER_OF_FIELDS_NOT_MATCHING = Number of struct fields not matching declaration
FIELD_TYPE_NOT_MATCHING = The type of a field value does not match the declaration
ARRAY_SIZE_INVALID = Array size invalid
FOREACH_IDX_NOT_LONG = Foreach index not of type long
ARRAY_INDEX_NOT_INT_OR_LONG = Array index not of type int or long
ARRAY_ITEM_TYPE_NOT_MATCHING = Array item type not matching
EXPECTED_ARRAY_TYPE = Expected array type
EXPECTED_ERROR_TYPE = Expected error type
INVALID_SYSCALL_NUMBER_TYPE = Invalid syscall number type
SYSCALL_NUMBER_OUT_OF_RANGE = Syscall number out of range
BUILTIN_TEMPLATE_TYPE_COUNT_MISMATCH = Builtin function template type count mismatch
BUILTIN_ARG_COUNT_MISMATCH = Builtin function argument count mismatch
BUILTIN_SIGNATURE_MISMATCH = Builtin function signature mismatch
BUILTIN_ARG_TYPE_MISMATCH = Builtin function argument type mismatch
RETURN_WITHOUT_VALUE_RESULT = Return without initialization of result variable
RETURN_WITH_VALUE_IN_PROCEDURE = Return with value in procedure
RETURN_OF_TEMPORARY_VALUE = Return of temporary value
INVALID_STRUCT_INSTANTIATION = Invalid struct instantiation
DYN_POINTERS_NOT_ALLOWED = Dyn pointers not allowed
REF_POINTERS_ARE_NOT_ALLOWED = Ref pointers not allowed
DYN_REFERENCES_NOT_ALLOWED = Dyn references not allowed
MULTI_REF_NOT_ALLOWED = Multi references not allowed
DYN_ARRAYS_NOT_ALLOWED = Dyn arrays not allowed
REFERENCE_WITHOUT_INITIALIZER = Reference without initializer
TEMP_TO_NON_CONST_REF = Temporary bound to non-const reference
LVALUE_TO_RVALUE_REF = LValue bound to RValue reference
RVALUE_REF_NOT_ALLOWED = RValue reference not allowed
GENERIC_TYPE_NOT_IN_TEMPLATE = Generic type not contained in template
QUALIFIER_AT_ILLEGAL_CONTEXT = Qualifier at illegal context
INSUFFICIENT_VISIBILITY = Insufficient symbol visibility
EXPECTED_GENERIC_TYPE = Expected a generic type
EXPECTED_NON_GENERIC_TYPE = Expected a non-generic type
EXPECTED_STRUCT_TYPE = Expected a struct type
EXPECTED_INTERFACE_TYPE = Expected an interface type
EXPECTED_COMPILE_TIME_VALUE = Expected compile time value
ALIAS_WITH_TEMPLATE_LIST = Alias with template list
INVALID_TEMPLATE_TYPES = Invalid template types
EXPECTED_TYPE = Expected type
UNSAFE_OPERATION_IN_SAFE_CONTEXT = Unsafe operation in safe context
ASSERTION_CONDITION_BOOL = Assertion condition must be bool
ARRAY_INDEX_OUT_OF_BOUNDS = Array index out of bounds
EXPECTED_CONST_VARIABLE = Expected const variable
DIVISION_BY_ZERO = Division by zero
TEST_FUNCTION_WITH_PARAMS = Test function with parameters
TEST_FUNCTION_WRONG_RETURN_TYPE = Test function with wrong return type
LAMBDA_CAPTURE_ESCAPE = Lambda may outlive its captures
ERR_PROPAGATION_INVALID_OPERAND = Invalid operand for error propagation operator
ERR_PROPAGATION_INVALID_CONTEXT = Error propagation operator used in invalid context
DISCARDED_RESULT_VALUE = Discarded Result value
UNION_AMBIGUITY = Union ambiguity
UNION_INFINITE_SIZE = Union with infinite size detected
UNION_FIELD_TYPE_NOT_TRIVIAL = Union field type not trivial
UNION_FIELD_MUST_NOT_BE_REFERENCE = Union field must not be a reference
DUPLICATE_UNION_DEFAULT_VALUE = Duplicate default value in union
AMBIGUOUS_SYMBOL = Ambiguous symbol
INTERFACE_RETURNED_BY_VALUE = Interface returned by value
UNSUPPORTED_BY_BACKEND = Unsupported by backend
INVALID_ASM_CONSTRAINTS = Invalid inline assembly constraints
INVALID_ASM_TEMPLATE = Invalid inline assembly template
UNSUPPORTED_IN_FREESTANDING_MODE = Unsupported in freestanding mode
INVALID_PANIC_HANDLER = Invalid panic handler
MULTIPLE_PANIC_HANDLERS = Multiple panic handlers
INVALID_ALLOCATOR_FUNCTION = Invalid allocator function
MULTIPLE_ALLOCATOR_FUNCTIONS = Multiple allocator functions
MISSING_ALLOCATOR_FUNCTIONS = Missing allocator functions
IMPORT_REQUIRES_OS = Import requires an operating system
INVALID_CTOR_DELEGATION = Invalid ctor delegation
RESULT_VARIABLE_DECLARED = Declaration of the implicit result variable
RETURN_OF_LOCAL_REFERENCE = Return of reference to local variable
RETURN_OF_LOCAL_ADDRESS = Return of address of local variable
PARTIALLY_NAMED_PARAMS = Partially named parameters
PARAM_NAME_MISMATCH = Parameter name mismatch

[Compiler]
enum = CompilerErrorType
UNRESOLVED_SOFT_ERRORS = Unresolved soft errors
SOURCE_FILE_NOT_FOUND = Source file not found
CANT_OPEN_OUTPUT_FILE = Could not open output file
WRONG_OUTPUT_TYPE = Wrong type of output file
INTERNAL_ERROR = Internal compiler error
IO_ERROR = I/O Error
STD_NOT_FOUND = Std lib not found
TARGET_NOT_AVAILABLE = Selected target not available
OOM = An out of memory error occurred
INVALID_FUNCTION = Invalid function
INVALID_MODULE = Invalid module
BACKEND_ERROR = Backend error
INVALID_MANIFEST = Invalid manifest

[Linker]
enum = LinkerErrorType
LINKER_INVOKER_NOT_FOUND = Linker invoker not found
LINKER_NOT_FOUND = Linker not found
ARCHIVER_NOT_FOUND = Archiver not found
LINKER_ERROR = Linker error occurred
SANITIZER_NOT_SUPPORTED_BY_LINKER_INVOKER = Sanitizer not supported by linker invoker

[Cli]
enum = CliErrorType
INCOMPATIBLE_OPTIONS = Incompatible options
NON_ZERO_EXIT_CODE = Non-zero exit code
TERMINATED_BY_SIGNAL = Terminated by signal
FEATURE_NOT_SUPPORTED_FOR_TARGET = Feature is not supported for this target
FEATURE_NOT_SUPPORTED_WHEN_DOCKERIZED = Feature not supported when dockerized
INVALID_BUILD_MODE = Invalid build mode
INVALID_OUTPUT_CONTAINER = Invalid output container
INVALID_SANITIZER = Invalid sanitizer
INVALID_BACKEND = Invalid backend
INVALID_DEBUG_INFO_LEVEL = Invalid debug info level
INVALID_RELOCATION_MODEL = Invalid relocation model
INVALID_CODE_MODEL = Invalid code model
INVALID_CPU_FEATURE = Invalid CPU feature

[Warning]
enum = CompilerWarningType
UNUSED_FUNCTION = Unused function
UNUSED_PROCEDURE = Unused procedure
UNUSED_METHOD = Unused method
UNUSED_STRUCT = Unused struct
UNUSED_INTERFACE = Unused interface
UNUSED_UNION = Unused union
UNUSED_IMPORT = Unused import
UNUSED_FIELD = Unused field
UNUSED_ENUM_ITEM = Unused enum item
UNUSED_ALIAS = Unused type alias
UNUSED_VARIABLE = Unused variable
UNUSED_RETURN_VALUE = Unused return value
UNREACHABLE_CODE = Unreachable code detected
SHADOWED_VARIABLE = Shadowed variable
IDENTITY_CAST = Identity cast
SINGLE_GENERIC_TYPE_CONDITION = Only one type condition
INEFFECTIVE_GENERIC_TYPE_CONDITION = Ineffective type condition
BOOL_ASSIGN_AS_CONDITION = Bool assignment as condition
NON_TRIVIAL_TYPE_PASSED_BY_VALUE = Non-trivial type passed by value
RETURN_OF_LOCAL_ADDRESS = Return of address of local variable
UNINSTALL_FAILED = Uninstall failed
BACKEND_WARNING = Backend warning
