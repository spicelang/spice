// Text before the message of a diagnostic with a code of LinkerErrorType
public f<string> getLinkerErrorTypePrefix(const LinkerErrorType code) {
    switch code {
        case LinkerErrorType::LINKER_INVOKER_NOT_FOUND: { return "Linker invoker not found"; }
        case LinkerErrorType::LINKER_NOT_FOUND: { return "Linker not found"; }
        case LinkerErrorType::ARCHIVER_NOT_FOUND: { return "Archiver not found"; }
        case LinkerErrorType::LINKER_ERROR: { return "Linker error occurred"; }
        case LinkerErrorType::SANITIZER_NOT_SUPPORTED_BY_LINKER_INVOKER: { return "Sanitizer not supported by linker invoker"; }
        default: { panic(Error("Unknown diagnostic code")); }
    }
}

#[test]
f<bool> testLinkerErrorTypeCodes() {
    assert getLinkerErrorTypeCount() == 5u;
    for unsigned int i = 0u; i < getLinkerErrorTypeCount(); i++ {
        assert len(getLinkerErrorTypePrefix(cast<LinkerErrorType>(i))) > 0l;
    }
    assert String(getLinkerErrorTypePrefix(LinkerErrorType::LINKER_INVOKER_NOT_FOUND)) == "Linker invoker not found";
    assert String(getLinkerErrorTypePrefix(LinkerErrorType::SANITIZER_NOT_SUPPORTED_BY_LINKER_INVOKER)) == "Sanitizer not supported by linker invoker";
    return true;
}

