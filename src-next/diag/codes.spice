// Text before the message of a diagnostic with a code of CliErrorType
public f<string> getCliErrorTypePrefix(const CliErrorType code) {
    switch code {
        case CliErrorType::INCOMPATIBLE_OPTIONS: { return "Incompatible options"; }
        case CliErrorType::NON_ZERO_EXIT_CODE: { return "Non-zero exit code"; }
        case CliErrorType::TERMINATED_BY_SIGNAL: { return "Terminated by signal"; }
        case CliErrorType::FEATURE_NOT_SUPPORTED_FOR_TARGET: { return "Feature is not supported for this target"; }
        case CliErrorType::FEATURE_NOT_SUPPORTED_WHEN_DOCKERIZED: { return "Feature not supported when dockerized"; }
        case CliErrorType::INVALID_BUILD_MODE: { return "Invalid build mode"; }
        case CliErrorType::INVALID_OUTPUT_CONTAINER: { return "Invalid output container"; }
        case CliErrorType::INVALID_SANITIZER: { return "Invalid sanitizer"; }
        case CliErrorType::INVALID_BACKEND: { return "Invalid backend"; }
        case CliErrorType::INVALID_DEBUG_INFO_LEVEL: { return "Invalid debug info level"; }
        case CliErrorType::INVALID_RELOCATION_MODEL: { return "Invalid relocation model"; }
        case CliErrorType::INVALID_CODE_MODEL: { return "Invalid code model"; }
        case CliErrorType::INVALID_CPU_FEATURE: { return "Invalid CPU feature"; }
        default: { panic(Error("Unknown diagnostic code")); }
    }
}

#[test]
f<bool> testCliErrorTypeCodes() {
    assert getCliErrorTypeCount() == 13u;
    for unsigned int i = 0u; i < getCliErrorTypeCount(); i++ {
        assert len(getCliErrorTypePrefix(cast<CliErrorType>(i))) > 0l;
    }
    assert String(getCliErrorTypePrefix(CliErrorType::INCOMPATIBLE_OPTIONS)) == "Incompatible options";
    assert String(getCliErrorTypePrefix(CliErrorType::INVALID_CPU_FEATURE)) == "Invalid CPU feature";
    return true;
}

// Warning: 22 codes
public type CompilerWarningType enum {
    UNUSED_FUNCTION,
    UNUSED_PROCEDURE,
    UNUSED_METHOD,
    UNUSED_STRUCT,
    UNUSED_INTERFACE,
    UNUSED_UNION,
    UNUSED_IMPORT,
    UNUSED_FIELD,
    UNUSED_ENUM_ITEM,
    UNUSED_ALIAS,
    UNUSED_VARIABLE,
    UNUSED_RETURN_VALUE,
    UNREACHABLE_CODE,
    SHADOWED_VARIABLE,
    IDENTITY_CAST,
    SINGLE_GENERIC_TYPE_CONDITION,
    INEFFECTIVE_GENERIC_TYPE_CONDITION,
    BOOL_ASSIGN_AS_CONDITION,
    NON_TRIVIAL_TYPE_PASSED_BY_VALUE,
    RETURN_OF_LOCAL_ADDRESS,
    UNINSTALL_FAILED,
    BACKEND_WARNING
}

// Number of codes of CompilerWarningType
public f<unsigned int> getCompilerWarningTypeCount() {
    return 22u;
}

// Text before the message of a diagnostic with a code of CompilerWarningType
public f<string> getCompilerWarningTypePrefix(const CompilerWarningType code) {
    switch code {
        case CompilerWarningType::UNUSED_FUNCTION: { return "Unused function"; }
        case CompilerWarningType::UNUSED_PROCEDURE: { return "Unused procedure"; }
        case CompilerWarningType::UNUSED_METHOD: { return "Unused method"; }
        case CompilerWarningType::UNUSED_STRUCT: { return "Unused struct"; }
        case CompilerWarningType::UNUSED_INTERFACE: { return "Unused interface"; }
        case CompilerWarningType::UNUSED_UNION: { return "Unused union"; }
        case CompilerWarningType::UNUSED_IMPORT: { return "Unused import"; }
        case CompilerWarningType::UNUSED_FIELD: { return "Unused field"; }
        case CompilerWarningType::UNUSED_ENUM_ITEM: { return "Unused enum item"; }
        case CompilerWarningType::UNUSED_ALIAS: { return "Unused type alias"; }
        case CompilerWarningType::UNUSED_VARIABLE: { return "Unused variable"; }
        case CompilerWarningType::UNUSED_RETURN_VALUE: { return "Unused return value"; }
        case CompilerWarningType::UNREACHABLE_CODE: { return "Unreachable code detected"; }
        case CompilerWarningType::SHADOWED_VARIABLE: { return "Shadowed variable"; }
        case CompilerWarningType::IDENTITY_CAST: { return "Identity cast"; }
        case CompilerWarningType::SINGLE_GENERIC_TYPE_CONDITION: { return "Only one type condition"; }
        case CompilerWarningType::INEFFECTIVE_GENERIC_TYPE_CONDITION: { return "Ineffective type condition"; }
        case CompilerWarningType::BOOL_ASSIGN_AS_CONDITION: { return "Bool assignment as condition"; }
        case CompilerWarningType::NON_TRIVIAL_TYPE_PASSED_BY_VALUE: { return "Non-trivial type passed by value"; }
        case CompilerWarningType::RETURN_OF_LOCAL_ADDRESS: { return "Return of address of local variable"; }
        case CompilerWarningType::UNINSTALL_FAILED: { return "Uninstall failed"; }
        case CompilerWarningType::BACKEND_WARNING: { return "Backend warning"; }
        default: { panic(Error("Unknown diagnostic code")); }
    }
}

#[test]
f<bool> testCompilerWarningTypeCodes() {
    assert getCompilerWarningTypeCount() == 22u;
    for unsigned int i = 0u; i < getCompilerWarningTypeCount(); i++ {
        assert len(getCompilerWarningTypePrefix(cast<CompilerWarningType>(i))) > 0l;
    }
    assert String(getCompilerWarningTypePrefix(CompilerWarningType::UNUSED_FUNCTION)) == "Unused function";
    assert String(getCompilerWarningTypePrefix(CompilerWarningType::BACKEND_WARNING)) == "Backend warning";
    return true;
}
