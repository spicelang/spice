// Own imports. The imports pull the builtin tests of the base layer into the test build
import "@/base/arena";
import "@/base/concurrency";
import "@/base/hash";
import "@/base/id";
import "@/base/id-map";
import "@/base/id-vec";
import "@/base/interner";
import "@/base/manifest";
import "@/base/save-and-restore";
import "@/base/small-vec";
import "@/base/strings";
import "@/base/system";
import "@/base/test-util";

/**
 * Entry point to the re-implementation of the Spice compiler. Only prints the version for now
 *
 * @param argc Argument count
 * @param argv Argument vector
 * @return Return code
 */
f<int> main(int argc, string[] argv) {
    if argc == 2 && (String(argv[1]) == "--version" || String(argv[1]) == "-v") {
        const string version = __get_build_var<string>("SPICE_VERSION", "dev");
        printf("Spice (next) version: %s\n", version);
        return 0;
    }
    printf("Usage: spice-next --version\n");
    return 1;
}
