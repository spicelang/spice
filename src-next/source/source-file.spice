// Std imports
import "std/data/vector";

// Own imports
import "@/base/id";

/**
 * A source file or string, that the SourceManager holds. The text is read once and never changes afterwards. The line table
 * lets the SourceManager find the line of an offset by binary search, instead of the Reader of the legacy compiler, which
 * counted lines and columns while it consumed the characters.
 */
public type SourceFile struct {
    public String path // Path as it was passed to the SourceManager. Empty for a source without a path
    public String text // All bytes of the source, as they were read
    public bool fromDisk = false // Read from a file, so addFile finds it by its path. A string is never found
    // Offset of the first byte of every line. Line n (1-based) starts at lineStarts[n - 1]. The first entry is always 0 and a
    // line starts after every '\n', also after the last byte
    public Vector<unsigned int> lineStarts
}

/**
 * Id of a source file within the SourceManager
 */
public type FileId alias Id<SourceFile>;

/**
 * Create the id of a file. The alias cannot be used as a constructor
 *
 * @param index Index of the file within the SourceManager
 * @return File id
 */
public inline f<FileId> makeFileId(unsigned int index) {
    return Id<SourceFile>(index);
}

/**
 * Id that refers to no file. A default-constructed Span carries it
 *
 * @return Invalid file id
 */
public inline f<FileId> noFileId() {
    return makeFileId(4294967295u);
}

/**
 * Check if the id refers to a file
 *
 * @param id File id to check
 * @return Valid or not
 */
public inline f<bool> isValid(const FileId& id) {
    return id.index != 4294967295u;
}
