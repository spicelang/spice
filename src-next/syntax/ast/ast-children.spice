        case AstNodeKind::FCT_CALL: { return &store.getFctCall(id).header; }
        case AstNodeKind::ARRAY_INITIALIZATION: { return &store.getArrayInitialization(id).header; }
        case AstNodeKind::STRUCT_INSTANTIATION: { return &store.getStructInstantiation(id).header; }
        case AstNodeKind::LAMBDA_FUNC: { return &store.getLambdaFunc(id).header; }
        case AstNodeKind::LAMBDA_PROC: { return &store.getLambdaProc(id).header; }
        case AstNodeKind::LAMBDA_EXPR: { return &store.getLambdaExpr(id).header; }
        case AstNodeKind::FUNCTION_DATA_TYPE: { return &store.getFunctionDataType(id).header; }
        default: { panic(Error("Unknown AST node kind")); }
    }
}

/**
 * Set the parent of a node. The parser does it when it attaches a node to its parent
 */
public p setParent(const AstStore& store, NodeId child, NodeId parent) {
    getHeader(store, child).parent = parent;
}

/**
 * Append the children of a node to `out`, in the order of `children` in the legacy AST. A missing optional child is skipped
 *
 * @param store Store of the node
 * @param id Id of the node
 * @param out Vector to append the ids to
 */
public p collectChildren(const AstStore& store, NodeId id, Vector<NodeId>& out) {
    switch store.getKind(id) {
        case AstNodeKind::ENTRY: { collectEntryChildren(store, id, out); }
        case AstNodeKind::CONSTANT: { collectConstantChildren(store, id, out); }
        case AstNodeKind::ATTR: { collectAttrChildren(store, id, out); }
        case AstNodeKind::ATTR_LST: { collectAttrLstChildren(store, id, out); }
        case AstNodeKind::QUALIFIER: { collectQualifierChildren(store, id, out); }
        case AstNodeKind::QUALIFIER_LST: { collectQualifierLstChildren(store, id, out); }
        case AstNodeKind::CUSTOM_DATA_TYPE: { collectCustomDataTypeChildren(store, id, out); }
        case AstNodeKind::BASE_DATA_TYPE: { collectBaseDataTypeChildren(store, id, out); }
        case AstNodeKind::DATA_TYPE: { collectDataTypeChildren(store, id, out); }
        case AstNodeKind::TYPE_LST: { collectTypeLstChildren(store, id, out); }
        case AstNodeKind::MAIN_FCT_DEF: { collectMainFctDefChildren(store, id, out); }
        case AstNodeKind::FCT_NAME: { collectFctNameChildren(store, id, out); }
        case AstNodeKind::FCT_DEF: { collectFctDefChildren(store, id, out); }
        case AstNodeKind::PROC_DEF: { collectProcDefChildren(store, id, out); }
        case AstNodeKind::STRUCT_DEF: { collectStructDefChildren(store, id, out); }
        case AstNodeKind::INTERFACE_DEF: { collectInterfaceDefChildren(store, id, out); }
        case AstNodeKind::UNION_DEF: { collectUnionDefChildren(store, id, out); }
        case AstNodeKind::ENUM_DEF: { collectEnumDefChildren(store, id, out); }
        case AstNodeKind::GENERIC_TYPE_DEF: { collectGenericTypeDefChildren(store, id, out); }
        case AstNodeKind::ALIAS_DEF: { collectAliasDefChildren(store, id, out); }
        case AstNodeKind::GLOBAL_VAR_DEF: { collectGlobalVarDefChildren(store, id, out); }
        case AstNodeKind::EXT_DECL: { collectExtDeclChildren(store, id, out); }
        case AstNodeKind::IMPORT_DEF: { collectImportDefChildren(store, id, out); }
        case AstNodeKind::UNSAFE_BLOCK: { collectUnsafeBlockChildren(store, id, out); }
        case AstNodeKind::FOR_LOOP: { collectForLoopChildren(store, id, out); }
        case AstNodeKind::FOREACH_LOOP: { collectForeachLoopChildren(store, id, out); }
        case AstNodeKind::WHILE_LOOP: { collectWhileLoopChildren(store, id, out); }
        case AstNodeKind::DO_WHILE_LOOP: { collectDoWhileLoopChildren(store, id, out); }
        case AstNodeKind::IF_STMT: { collectIfStmtChildren(store, id, out); }
        case AstNodeKind::ELSE_STMT: { collectElseStmtChildren(store, id, out); }
        case AstNodeKind::SWITCH_STMT: { collectSwitchStmtChildren(store, id, out); }
        case AstNodeKind::CASE_BRANCH: { collectCaseBranchChildren(store, id, out); }
        case AstNodeKind::DEFAULT_BRANCH: { collectDefaultBranchChildren(store, id, out); }
        case AstNodeKind::ANONYMOUS_BLOCK_STMT: { collectAnonymousBlockStmtChildren(store, id, out); }
        case AstNodeKind::STMT_LST: { collectStmtLstChildren(store, id, out); }
        case AstNodeKind::TYPE_LST_WITH_ELLIPSIS: { collectTypeLstWithEllipsisChildren(store, id, out); }
        case AstNodeKind::TYPE_ALTS_LST: { collectTypeAltsLstChildren(store, id, out); }
        case AstNodeKind::DECL_STMT: { collectDeclStmtChildren(store, id, out); }
        case AstNodeKind::PARAM_LST: { collectParamLstChildren(store, id, out); }
        case AstNodeKind::ARG_LST: { collectArgLstChildren(store, id, out); }
        case AstNodeKind::ENUM_ITEM: { collectEnumItemChildren(store, id, out); }
        case AstNodeKind::ENUM_ITEM_LST: { collectEnumItemLstChildren(store, id, out); }
        case AstNodeKind::FIELD: { collectFieldChildren(store, id, out); }
        case AstNodeKind::SIGNATURE: { collectSignatureChildren(store, id, out); }
        case AstNodeKind::EXPR_STMT: { collectExprStmtChildren(store, id, out); }
        case AstNodeKind::MOD_ATTR: { collectModAttrChildren(store, id, out); }
        case AstNodeKind::TOP_LEVEL_DEF_ATTR: { collectTopLevelDefAttrChildren(store, id, out); }
        case AstNodeKind::LAMBDA_ATTR: { collectLambdaAttrChildren(store, id, out); }
        case AstNodeKind::CASE_CONSTANT: { collectCaseConstantChildren(store, id, out); }
        case AstNodeKind::RETURN_STMT: { collectReturnStmtChildren(store, id, out); }
        case AstNodeKind::BREAK_STMT: { collectBreakStmtChildren(store, id, out); }
        case AstNodeKind::CONTINUE_STMT: { collectContinueStmtChildren(store, id, out); }
        case AstNodeKind::FALLTHROUGH_STMT: { collectFallthroughStmtChildren(store, id, out); }
        case AstNodeKind::ASSERT_STMT: { collectAssertStmtChildren(store, id, out); }
        case AstNodeKind::ASSIGN_EXPR: { collectAssignExprChildren(store, id, out); }
        case AstNodeKind::TERNARY_EXPR: { collectTernaryExprChildren(store, id, out); }
        case AstNodeKind::LOGICAL_OR_EXPR: { collectLogicalOrExprChildren(store, id, out); }
        case AstNodeKind::LOGICAL_AND_EXPR: { collectLogicalAndExprChildren(store, id, out); }
        case AstNodeKind::BITWISE_OR_EXPR: { collectBitwiseOrExprChildren(store, id, out); }
        case AstNodeKind::BITWISE_XOR_EXPR: { collectBitwiseXorExprChildren(store, id, out); }
        case AstNodeKind::BITWISE_AND_EXPR: { collectBitwiseAndExprChildren(store, id, out); }
        case AstNodeKind::EQUALITY_EXPR: { collectEqualityExprChildren(store, id, out); }
        case AstNodeKind::RELATIONAL_EXPR: { collectRelationalExprChildren(store, id, out); }
        case AstNodeKind::SHIFT_EXPR: { collectShiftExprChildren(store, id, out); }
        case AstNodeKind::ADDITIVE_EXPR: { collectAdditiveExprChildren(store, id, out); }
        case AstNodeKind::MULTIPLICATIVE_EXPR: { collectMultiplicativeExprChildren(store, id, out); }
        case AstNodeKind::CAST_EXPR: { collectCastExprChildren(store, id, out); }
        case AstNodeKind::PREFIX_UNARY_EXPR: { collectPrefixUnaryExprChildren(store, id, out); }
        case AstNodeKind::POSTFIX_UNARY_EXPR: { collectPostfixUnaryExprChildren(store, id, out); }
        case AstNodeKind::ATOMIC_EXPR: { collectAtomicExprChildren(store, id, out); }
        case AstNodeKind::VALUE: { collectValueChildren(store, id, out); }
        case AstNodeKind::FCT_CALL: { collectFctCallChildren(store, id, out); }
        case AstNodeKind::ARRAY_INITIALIZATION: { collectArrayInitializationChildren(store, id, out); }
        case AstNodeKind::STRUCT_INSTANTIATION: { collectStructInstantiationChildren(store, id, out); }
        case AstNodeKind::LAMBDA_FUNC: { collectLambdaFuncChildren(store, id, out); }
        case AstNodeKind::LAMBDA_PROC: { collectLambdaProcChildren(store, id, out); }
        case AstNodeKind::LAMBDA_EXPR: { collectLambdaExprChildren(store, id, out); }
        case AstNodeKind::FUNCTION_DATA_TYPE: { collectFunctionDataTypeChildren(store, id, out); }
        default: {}
    }
}
