// This file lives outside test/test-files on purpose: it is the escape target for the
// typechecker/imports/error-import-path-traversal-symlink test case, which imports it through a
// symlink to prove that a lexically '..'-free import path cannot be used to read a file outside
// the permitted directory tree. It must never actually be compiled - if it is, the containment
// check that the test exists to cover has regressed.
const secret = "leaked";
