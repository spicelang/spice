import "std/os/thread-pool";
import "std/os/atomic";
import "std/time/delay";

type Counter struct {
    Atomic<unsigned long> value
}

f<int> main() {
    Counter counter;
    counter.value = Atomic<unsigned long>(0ul);
    Counter* counterPtr = &counter;
    ThreadPool tp = ThreadPool(4s);
    // Paused pools do not take jobs
    tp.pause();
    for int i = 0; i < 50; i++ {
        tp.enqueue(p() [[async]] { counterPtr.value.fetchAdd(1ul); });
    }
    tp.start();
    delay(50);
    printf("paused: queued=%d done=%d paused=%d\n", tp.getQueuedJobCount(), counter.value.fetchAdd(0ul), tp.isPaused());
    // Resumed pools drain the queue
    tp.resume();
    tp.join();
    printf("joined: queued=%d done=%d running=%d\n", tp.getQueuedJobCount(), counter.value.fetchAdd(0ul), tp.getRunningJobCount());
    // stop() ends idle workers, even if the queue is empty
    tp.start();
    tp.stop();
    printf("stopped: done=%d\n", counter.value.fetchAdd(0ul));
}
