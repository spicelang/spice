// TEST: --sanitizer=address

import "std/data/linked-list";
import "std/data/doubly-linked-list";
import "std/data/binary-tree";
import "std/data/red-black-tree";
import "std/data/vector";
import "std/data/unordered-map";
import "std/data/unordered-set";
import "std/data/pair";

f<int> main() {
    // A container going out of scope must free its whole internal node chain/tree (including
    // each stored value's own heap resources), not just the head/root node's own memory block.
    {
        LinkedList<String> list = LinkedList<String>();
        list.pushBack(String("first heap-allocated list value"));
        list.pushBack(String("second heap-allocated list value"));
        list.pushBack(String("third heap-allocated list value"));
    }
    printf("linked list ok\n");

    {
        DoublyLinkedList<String> list = DoublyLinkedList<String>();
        list.pushBack(String("first heap-allocated dlist value"));
        list.pushFront(String("second heap-allocated dlist value"));
        list.pushBack(String("third heap-allocated dlist value"));
    }
    printf("doubly linked list ok\n");

    {
        BinaryTree<int> tree = BinaryTree<int>();
        tree.insert(5);
        tree.insert(2);
        tree.insert(8);
        tree.insert(1);
        tree.insert(3);
        tree.insert(7);
        tree.insert(9);
    }
    printf("binary tree ok\n");

    {
        RedBlackTree<int, String> tree = RedBlackTree<int, String>();
        tree.insert(3, String("first heap-allocated rbt value"));
        tree.insert(1, String("second heap-allocated rbt value"));
        tree.insert(4, String("third heap-allocated rbt value"));
        tree.insert(2, String("fourth heap-allocated rbt value"));
    }
    printf("red-black tree ok\n");

    {
        // clear() on an already-empty tree (rootNode == nil) must not crash either
        RedBlackTree<int, String> tree = RedBlackTree<int, String>();
        tree.clear();
    }
    printf("red-black tree empty clear ok\n");

    {
        // Vector must destruct each owned element (e.g. String) on scope exit and in clear(), not just
        // free its own backing buffer
        Vector<String> vec = Vector<String>();
        vec.pushBack(String("first heap-allocated vector value"));
        vec.pushBack(String("second heap-allocated vector value"));
        vec.pushBack(String("third heap-allocated vector value"));
        vec.clear();
        vec.pushBack(String("fourth heap-allocated vector value"));
    }
    printf("vector ok\n");

    {
        // Copy-construction and copy-assignment must deep-copy owned elements instead of aliasing the
        // source's heap resources, which would double-free once elements are properly destructed
        Vector<String> original = Vector<String>();
        original.pushBack(String("first original vector value"));
        original.pushBack(String("second original vector value"));

        Vector<String> copyConstructed = Vector<String>(original);

        Vector<String> copyAssigned = Vector<String>();
        copyAssigned.pushBack(String("value to be overwritten"));
        copyAssigned = original;

        printf("copies hold %d and %d elements\n", copyConstructed.getSize(), copyAssigned.getSize());
    }
    printf("vector copy ok\n");

    {
        // Iterating a hash-table-backed container must not corrupt its bucket contents. Reassigning a
        // reference-typed local variable in Spice assigns through the reference, it does not rebind it.
        // A handful of entries spread across the default 100 buckets still exercises the iterator's
        // "skip empty buckets" logic, which is where the corruption used to happen.
        // The values are non-trivial on purpose: HashTable's own element type (HashEntry<K, V>) is only
        // ever reached indirectly as a nested generic field (Vector<LinkedList<HashEntry<K, V>>>) and is
        // never instantiated by name, so its compiler-generated default dtor used to be missing and every
        // stored value leaked (see #1297).
        UnorderedMap<int, String> map = UnorderedMap<int, String>();
        map.upsert(3, String("first heap-allocated map value"));
        map.upsert(17, String("second heap-allocated map value"));
        map.upsert(42, String("third heap-allocated map value"));
        map.upsert(58, String("fourth heap-allocated map value"));
        map.upsert(91, String("fifth heap-allocated map value"));
        int count = 0;
        foreach Pair<int&, String&> entry : map {
            count++;
        }
        printf("iterated %d map entries\n", count);
    }
    printf("unordered map ok\n");

    {
        // Same as above, but for UnorderedSet, which stores its values as the *keys* of a HashTable<V, bool>
        UnorderedSet<String> set = UnorderedSet<String>();
        set.insert(String("first heap-allocated set value"));
        set.insert(String("second heap-allocated set value"));
        set.insert(String("third heap-allocated set value"));
        int count = 0;
        foreach String value : set {
            count += value.getLength() > 0l ? 1 : 0;
        }
        printf("iterated %d set entries\n", count);
    }
    printf("unordered set ok\n");

    return 0;
}
