import "std/io/file";

f<int> main() {
    // Own file name, because the tests run in parallel in the same working dir and 'file-write-read' uses './test-file.txt'
    string filename = "./test-file-create-delete.txt";
    bool _ = deleteFile(filename); // Ensure that the file is not present in the beginning

    assert !fileExists(filename);
    assert createFile(filename);
    assert fileExists(filename);
    assert deleteFile(filename);
    assert !fileExists(filename);

    printf("All assertions passed!\n");
}