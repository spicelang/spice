import "std/os/os";
import "std/data/vector";
import "std/io/cli-parser";
import "std/io/cli-subcommand";
import "std/io/filepath";

// State the options write to
type State struct {
    string single = ""
    String named
    int count = 0
    FilePath output
    string callbackValue = ""
    Vector<String> tags
    string file = ""
}

f<int> main() {
    State state;
    State* s = &state;

    CliParser parser = CliParser("Test Program", "This is a simple test program");
    CliSubcommand& build = parser.addSubcommand("build", "Build something");
    build.addOption("--single", state.single, "Single raw string value");
    build.addOption("--named", state.named, "Named String value");
    build.addOption("--count", state.count, "Count value");
    build.addOption("--output", state.output, "Output file path");
    CliOption<string>& targetOption = build.addOption("--target", p(const string& value) {
        s.callbackValue = value;
    }, "Callback value");
    targetOption.addAlias("-t");
    CliOption<string>& tagOption = build.addOption("--tag", p(const string& tag) {
        s.tags.pushBack(String(tag));
    }, "Tags");
    tagOption.allowMultipleValues();
    build.addOption("<file>", state.file, "File to build");

    // The "--name=value" syntax attaches the value to the option name, for every option type
    string[7] args = ["prog", "build", "--single=x", "--count=42", "--output=out.o", "--named=foo", "main.spice"];
    assert parser.parse(7u, args) == EXIT_CODE_SUCCESS;
    assert state.single == "x"; // Raw string set-value: the value must stay valid after parsing returns
    assert state.count == 42;
    const string outputPath = state.output.toString();
    assert outputPath == "out.o";
    assert state.named == "foo";
    assert state.file == "main.spice";

    // The value may contain further '=' and '-' characters; only the first '=' splits name and value
    string[4] tripleArgs = ["prog", "build", "--target=x86_64-unknown-linux-gnu", "app.spice"];
    assert parser.parse(4u, tripleArgs) == EXIT_CODE_SUCCESS;
    assert state.callbackValue == "x86_64-unknown-linux-gnu";
    assert state.file == "app.spice";

    // The "=value" syntax also works on an alias
    state.callbackValue = "";
    string[4] aliasArgs = ["prog", "build", "-t=native", "alias.spice"];
    assert parser.parse(4u, aliasArgs) == EXIT_CODE_SUCCESS;
    assert state.callbackValue == "native";

    // The space-separated syntax keeps working unchanged
    string[5] spaceArgs = ["prog", "build", "--single", "y", "space.spice"];
    assert parser.parse(5u, spaceArgs) == EXIT_CODE_SUCCESS;
    assert state.single == "y";
    assert state.file == "space.spice";

    // An attached value on a multiple-value option is the first value; the following arguments are taken as further values,
    // while the trailing argument is still left over for the required positional
    string[6] multiArgs = ["prog", "build", "--tag=a", "b", "c", "multi.spice"];
    assert parser.parse(6u, multiArgs) == EXIT_CODE_SUCCESS;
    assert state.tags.getSize() == 3;
    assert state.tags.get(0) == "a";
    assert state.tags.get(1) == "b";
    assert state.tags.get(2) == "c";
    assert state.file == "multi.spice";

    // A flag, whose name contains a value, takes precedence over a flag with the bare name, regardless of the order they were
    // added in. The bare flag still matches on its own
    string level = "";
    string* l = &level;
    build.addFlag("--debug-info", p(const bool& _v) { *l = "full"; }, "Full debug info");
    build.addFlag("--debug-info=line-only", p(const bool& _v) { *l = "line-only"; }, "Line tables only");
    build.addFlag("--debug-info=none", p(const bool& _v) { *l = "none"; }, "No debug info");
    string[4] lineOnlyArgs = ["prog", "build", "--debug-info=line-only", "flag.spice"];
    assert parser.parse(4u, lineOnlyArgs) == EXIT_CODE_SUCCESS;
    assert level == "line-only";
    string[4] noneArgs = ["prog", "build", "--debug-info=none", "flag.spice"];
    assert parser.parse(4u, noneArgs) == EXIT_CODE_SUCCESS;
    assert level == "none";
    string[4] bareArgs = ["prog", "build", "--debug-info", "flag.spice"];
    assert parser.parse(4u, bareArgs) == EXIT_CODE_SUCCESS;
    assert level == "full";

    printf("All assertions passed!\n");
}
