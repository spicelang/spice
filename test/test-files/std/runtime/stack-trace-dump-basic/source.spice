// Exercises sDumpStacktrace() on every platform: the capture, the symbol resolution and the printed format.
//
// Two of the columns a dump prints cannot be compared as they are: addresses move between runs under ASLR, and
// offsets shift with every codegen change. The frame numbers in front of them are reproducible and are compared
// as they are. The dump also goes to stderr, which the test runner folds into the compared output. It is
// therefore pointed at a file first and printed back to stdout with those two columns masked. What is left - which symbols resolve, and how they demangle - is the same on every platform, since
// libbacktrace resolves against the executable's own symbol table everywhere, so one 'cout.out' covers all of
// them.
//
// The 'at <file>:<line>' part of a frame line comes from debug info, which the test runner does not ask for, so
// it never appears here and needs no masking.
//
// Only the frames this test owns are printed. Everything below main belongs to the C runtime, which adds a
// different number of frames on every platform.
//
// A third dump is taken with the frames that are not Spice code hidden. Those are the C runtime frames just
// mentioned, so what it prints is the three frames the test owns and nothing else, on every platform but Windows,
// where libbacktrace can put a Spice name on a frame in a system DLL (see the docs on stack traces).
//
// sDumpStacktrace() is not imported: like the other 's'-prefixed runtime functions, it is pulled in by name.
import "std/data/vector";
import "std/io/file";
import "std/os/os";

ext f<byte*> freopen(string /*file path*/, string /*mode*/, byte* /*stream*/);
ext f<int> fflush(byte* /*stream*/);

const string DUMP_FILE_PATH = "./stack-trace-dump.txt";
const string HEADER_LINE = "Stack trace:";
const string INDENT = "  ";
const string FRAME_NUMBER_PREFIX = "  #";
// Width of the '  #<n>' column that dump() prints in front of every frame: two spaces, '#', and the number
// left-aligned in a field of three
const long FRAME_NUMBER_WIDTH = 6l;
// innerFrame, middleFrame and main - the frames below them are the C runtime's
const long PRINTED_FRAMES = 3l;
// Dumps taken: without addresses, with them, and without addresses and without the frames that are not Spice code
const long DUMP_COUNT = 3l;

p innerFrame(bool includeAddresses, bool hideNonSpiceFrames) {
    // All dumps are taken here, from the same call site, so they see the same frames
    sDumpStacktrace(includeAddresses, hideNonSpiceFrames);
}

p middleFrame(bool includeAddresses, bool hideNonSpiceFrames) {
    innerFrame(includeAddresses, hideNonSpiceFrames);
}

/**
 * Reads the dump back in, dropping the empty line that the trailing newline yields at EOF.
 */
f<Vector<String>> readDumpLines() {
    Result<File> fileResult = openFile(DUMP_FILE_PATH, MODE_READ);
    assert fileResult.isOk();
    File dumpFile = fileResult.unwrap();

    Vector<String> lines;
    while !dumpFile.isEOF() {
        String line = dumpFile.readLine();
        if !line.isEmpty() {
            lines.pushBack(line);
        }
    }
    assert dumpFile.close();
    return lines;
}

/**
 * Masks the address and the offset of one frame line, leaving only what is reproducible - which includes the
 * frame number, so it is carried over unchanged.
 *
 * @param line Frame line, as dump() printed it
 * @param hasAddress Whether the line was printed with the address column
 */
f<String> normalizeFrameLine(String& line, bool hasAddress) {
    assert line.startsWith(FRAME_NUMBER_PREFIX);
    String normalized = line.getSubstring(0l, FRAME_NUMBER_WIDTH);
    String rest = line.getSubstring(FRAME_NUMBER_WIDTH);

    if hasAddress {
        // '%p' leaves the address format to the platform. The column ends at the double space behind it.
        const long addressEnd = rest.find(INDENT);
        assert addressEnd > 0l;
        normalized += "<address>";
        normalized += INDENT;
        rest = rest.getSubstring(addressEnd + 2l);
    }

    // A resolved frame prints as '<name> + <offset>', an unresolved one as '<unknown>'
    const long offsetStart = rest.find(" + ");
    if offsetStart == -1l {
        normalized += rest;
        return normalized;
    }
    normalized += rest.getSubstring(0l, offsetStart + 3l);
    normalized += "<offset>";
    return normalized;
}

/**
 * Prints one dump back to stdout, masked.
 *
 * @param lines All lines of the dump file
 * @param firstFrameIdx Index of the dump's first frame line
 * @param hasAddresses Whether the dump was taken with the address column
 */
p printMaskedDump(Vector<String>& lines, long firstFrameIdx, bool hasAddresses) {
    printf("%s\n", HEADER_LINE);
    for long i = 0l; i < PRINTED_FRAMES; i++ {
        String normalized = normalizeFrameLine(lines.get(firstFrameIdx + i), hasAddresses);
        printf("%s\n", normalized.getRaw());
    }
}

/**
 * Number of frame lines in the dump whose header sits at the given position, i.e. the lines up to the next header or
 * the end of the file.
 *
 * @param lines All lines of the dump file
 * @param headerIdxs Positions of the header lines, one per dump
 * @param dumpIdx Which dump to count the frames of
 */
f<long> countFrames(Vector<String>& lines, Vector<long>& headerIdxs, long dumpIdx) {
    const long end = dumpIdx + 1l < headerIdxs.getSize() ? headerIdxs.get(dumpIdx + 1l) : lines.getSize();
    return end - headerIdxs.get(dumpIdx) - 1l;
}

/**
 * Whether the given frame line, once masked, is one of the frame lines of the dump whose first frame is at the given
 * position, also masked. The offsets have to be masked on both sides: main calls middleFrame from a different place
 * for every dump, so its offset differs between them even though it is the same frame.
 *
 * @param lines All lines of the dump file
 * @param firstFrameIdx Index of the dump's first frame line
 * @param frameCount Number of frame lines in that dump
 * @param line Line to look for, printed without the address column like the dump it is compared with
 */
f<bool> containsFrameLine(Vector<String>& lines, long firstFrameIdx, long frameCount, String& line) {
    String normalizedLine = normalizeFrameLine(line, false);
    for long i = firstFrameIdx; i < firstFrameIdx + frameCount; i++ {
        if normalizeFrameLine(lines.get(i), false) == normalizedLine { return true; }
    }
    return false;
}

f<int> main() {
    // Point stderr at a file, so the dump does not reach the compared output unmasked
    assert freopen(DUMP_FILE_PATH, MODE_WRITE, __stderr()) != nil<byte*>;

    middleFrame(false, false);
    middleFrame(true, false);
    middleFrame(false, true);
    assert fflush(__stderr()) == 0;

    Vector<String> lines = readDumpLines();

    // The file holds the trace without addresses first, then the same trace with them, then the same trace without
    // addresses and without the frames that are not Spice code. Each opens with its own header line.
    assert !lines.isEmpty();
    assert lines.get(0l) == HEADER_LINE;
    Vector<long> headerIdxs;
    for long i = 0l; i < lines.getSize(); i++ {
        if lines.get(i) == HEADER_LINE {
            headerIdxs.pushBack(i);
        }
    }
    assert headerIdxs.getSize() == DUMP_COUNT;

    const long plainFrameCount = countFrames(lines, headerIdxs, 0l);
    const long addressFrameCount = countFrames(lines, headerIdxs, 1l);
    const long spiceFrameCount = countFrames(lines, headerIdxs, 2l);
    const long plainFirstIdx = headerIdxs.get(0l) + 1l;
    const long addressFirstIdx = headerIdxs.get(1l) + 1l;
    const long spiceFirstIdx = headerIdxs.get(2l) + 1l;

    // innerFrame, middleFrame and main are always on the stack, and at O0 none of them can be inlined away
    assert plainFrameCount >= PRINTED_FRAMES;
    // Both dumps walk the same call chain, so they see the same frames
    assert addressFrameCount == plainFrameCount;
    // Hiding can only take frames away, and the three that are Spice code stay on every platform
    assert spiceFrameCount >= PRINTED_FRAMES;
    assert spiceFrameCount <= plainFrameCount;
    // What is left are frames the unfiltered dump printed as well, number included: hiding a frame does not renumber
    // the ones behind it
    for long i = 0l; i < spiceFrameCount; i++ {
        assert containsFrameLine(lines, plainFirstIdx, plainFrameCount, lines.get(spiceFirstIdx + i));
    }
    // Everything below main is the C runtime, so nothing but the three frames the test owns is left
    if !isWindows() {
        assert spiceFrameCount == PRINTED_FRAMES;
    }

    printMaskedDump(lines, plainFirstIdx, false);
    printMaskedDump(lines, addressFirstIdx, true);
    printMaskedDump(lines, spiceFirstIdx, false);

    // Detach stderr from the dump file first, because Windows refuses to unlink a file that is still open. Every
    // assertion above has passed by now: a red run never gets here, so the file stays around to be looked at.
    assert freopen(isWindows() ? "NUL" : "/dev/null", MODE_WRITE, __stderr()) != nil<byte*>;
    assert deleteFile(DUMP_FILE_PATH);
    return 0;
}
