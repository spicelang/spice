// Exercises StackTraceEntry.isSpice on a stack that leaves Spice and comes back: main calls the C library's qsort,
// which calls a Spice function back.
//
// How many frames qsort's own implementation spends, and what they are called, differs between C runtimes, and so
// does what sits below main - some unwinders stop there - so none of that is asserted. What holds everywhere is the
// shape: the frame that captured is Spice, the stack then leaves Spice code for qsort, and comes back to it in main.
//
// Skipped on Windows, where libbacktrace can put a Spice name on a frame in a system DLL, which would make the
// native frames in between look like Spice ones (see the docs on stack traces).
//
// sGetStacktrace() and the types it returns are not imported: like the other 's'-prefixed runtime functions, they
// are pulled in by name.
ext p qsort(int* /*base*/, unsigned long /*count*/, unsigned long /*size*/, f<int>(int*, int*) /*compare*/);

f<int> compare(int* a, int* b) {
    const StackTrace trace = sGetStacktrace();
    assert !trace.isEmpty();
    assert trace.getEntry(0ul).isSpice;

    // Whether the stack has left Spice code and then come back to it, and the last frame of Spice code it passed
    // through
    bool leftSpice = false;
    bool returnedToSpice = false;
    String lastSpiceFrame = String();
    foreach StackTraceEntry& entry : trace {
        if !entry.isSpice {
            leftSpice = true;
        } else {
            if leftSpice { returnedToSpice = true; }
            lastSpiceFrame = entry.functionName;
        }
    }
    // With debug info the name is spelled 'main()', without it 'main'
    const bool isShapeAsExpected = returnedToSpice && lastSpiceFrame.startsWith("main");
    // A shape that differs on a platform this was not written on is much easier to fix with the trace in front of you
    if !isShapeAsExpected { trace.dump(); }
    assert returnedToSpice;
    assert lastSpiceFrame.startsWith("main");

    return *a - *b;
}

f<int> main() {
    int[2] values = [2, 1];
    qsort(&values[0], 2ul, 4ul, compare);

    // qsort has to compare two elements to order them, so the callback ran - and its assertions with it
    assert values[0] == 1;
    assert values[1] == 2;

    printf("All assertions passed!\n");
    return 0;
}
