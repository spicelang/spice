// TEST: --build-mode=release
// Error return tracing is disabled in release builds: no origin or hop is ever recorded, so dumpTrace() prints the
// error without a trace, regardless of how the error propagated.

f<Result<int>> readIt(bool fail) {
    if fail {
        return err<int>(42, "it failed");
    }
    return ok<int>(7);
}

f<Result<int>> compute(bool fail) {
    int value = readIt(fail)!;
    return ok<int>(value * 2);
}

f<int> main() {
    Result<int> errResult = compute(true);
    errResult.dumpTrace();
    printf("done\n");
}
