// Diagnostic round: a prior version asserted trace.count == 4 and failed identically on Linux and macOS (exit
// code 1), which - since those platforms' CRTs are otherwise very different - points at an extra frame
// contributed by Spice's own generated test-entry (from #[test]/run-builtin-tests) rather than anything
// platform-specific. Printing the actual count (instead of asserting on it) and deliberately mismatching
// cout.out.placeholder below forces the CI diff to show the real captured output, so the exact expected count
// and dump() text can be filled in for real once observed - see cout.out.

import "std/runtime/stack_trace_rt";

f<bool> levelC() {
    StackTraceBuffer trace;
    trace.capture();

    printf("count=%d\n", trace.count);
    for int i = 0; i < trace.count; i++ {
        if trace.addresses[i] == nil<byte*> {
            printf("nil at %d\n", i);
        }
    }

    sDumpStacktrace(false);

    return true;
}

f<bool> levelB() {
    return levelC();
}

f<bool> levelA() {
    return levelB();
}

#[test]
f<bool> testStackTraceCapture() {
    return levelA();
}
