// Diagnostic round 3: rounds 1-2 found two compounding issues.
//
// 1. capture() didn't recognize the chain's sentinel/terminator frame: on macOS/AArch64 specifically, the
//    sentinel's return-address field reads zero (one hop before its saved-frame-pointer field does, which is
//    the more commonly documented signal), so the walk recorded a bogus nil entry instead of stopping. Fixed in
//    stack_trace_rt.spice/stack_trace_rt_windows.spice: the walk now stops without recording once the
//    return-address about to be captured is itself nil.
// 2. levelA/levelB/levelC/testStackTraceCapture were all trivial `return foo();` tail calls, which is exactly
//    the shape a compiler can collapse via tail-call optimization - and apparently one platform's toolchain does
//    that more aggressively here than another's, so the *real* number of frames wasn't even the same source-level
//    depth across platforms to begin with. Fixed below by assigning each call's result to a local before
//    returning it, taking the call out of tail position so every wrapper keeps its own frame regardless of
//    platform.
//
// This round re-enables the actual capture()/dump() path (not the raw __frame_address() probing of round 2) to
// confirm both fixes together produce a consistent count with no nil entries, on every platform, before locking
// in the real assertion and cout.out.

import "std/runtime/stack_trace_rt";

f<bool> levelC() {
    StackTraceBuffer trace;
    trace.capture();

    printf("count=%d\n", trace.count);
    for int i = 0; i < trace.count; i++ {
        if trace.addresses[i] == nil<byte*> {
            printf("nil at %d\n", i);
        }
    }

    sDumpStacktrace(false);

    return true;
}

f<bool> levelB() {
    const bool result = levelC(); // not a tail call - keeps levelB's own frame on every platform
    return result;
}

f<bool> levelA() {
    const bool result = levelB();
    return result;
}

#[test]
f<bool> testStackTraceCapture() {
    const bool result = levelA();
    return result;
}
