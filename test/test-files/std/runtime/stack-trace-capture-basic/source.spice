// Exercises StackTraceBuffer.capture() (the frame-pointer walk in stack_trace_rt.spice) through a few nested
// calls, and calls sDumpStacktrace() directly as a smoke test of the capture+dump convenience wrapper.
//
// The exact captured frame count is genuinely platform-dependent (confirmed via CI rather than assumed, under
// the previous #[test]-based version of this test - switching to a plain main() changes the call chain below
// main() itself, so those exact numbers need reconfirming here). What IS genuinely platform-independent is that
// the sentinel-frame fix in capture() holds everywhere: no captured address should ever be nil - asserted
// directly below.
//
// sDumpStacktrace()'s own output is also part of what cout.out compares (dladdr()/DbgHelp resolve whatever they
// can - see stack_trace_symbol_rt.spice/stack_trace_symbol_rt_windows.spice for what to expect there).

import "std/runtime/stack_trace_rt";

f<bool> levelC() {
    StackTraceBuffer trace;
    trace.capture();

    printf("count=%d\n", trace.count);
    for int i = 0; i < trace.count; i++ {
        assert trace.addresses[i] != nil<byte*>;
    }

    sDumpStacktrace(false);

    return true;
}

f<bool> levelB() {
    const bool ok = levelC(); // not a tail call - keeps levelB's own frame on every platform
    return ok;
}

f<bool> levelA() {
    const bool ok = levelB();
    return ok;
}

f<int> main() {
    const bool ok = levelA();
    if !ok { return 1; }
    return 0;
}
