// Exercises StackTraceBuffer.capture() (the frame-pointer walk in stack_trace_rt.spice) through a few nested
// calls. How many frames get captured beyond this call chain depends on how many further frames the platform's
// CRT/libc keeps below main() (e.g. _start, __libc_start_main), so this only asserts a lower bound instead of an
// exact frame count - anything less than the number of Spice-level frames below would mean the walk is broken.

import "std/runtime/stack_trace_rt";

f<int> levelC() {
    StackTraceBuffer trace;
    trace.capture();

    if trace.count < 3 {
        printf("FAIL: expected at least 3 frames, got %d\n", trace.count);
        return 1;
    }

    for int i = 0; i < trace.count; i++ {
        if trace.addresses[i] == nil<byte*> {
            printf("FAIL: frame %d has a nil address\n", i);
            return 1;
        }
    }

    printf("PASS\n");
    return 0;
}

f<int> levelB() {
    return levelC();
}

f<int> levelA() {
    return levelB();
}

f<int> main() {
    return levelA();
}
