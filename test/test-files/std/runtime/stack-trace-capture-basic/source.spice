// Exercises StackTraceBuffer.capture() (the frame-pointer walk in stack_trace_rt.spice) through a few nested
// calls, and calls sDumpStacktrace() directly as a smoke test of the capture+dump convenience wrapper.
//
// The exact captured frame count is genuinely platform-dependent, confirmed via CI rather than assumed:
//   - Linux (x86_64 and AArch64): 3 - levelC, levelB and levelA each keep their own frame, and the chain's
//     sentinel is reached right after levelA's.
//   - macOS/AArch64: 1 - only levelC's own frame is walkable; the very next hop is already the chain's
//     sentinel. (levelB/levelA/testStackTraceCapture aren't individually visible in the frame-pointer chain
//     there, for reasons not fully pinned down - ruled out tail-call collapsing specifically, since taking each
//     call out of tail position below made no difference to the count.)
// Since the count varies by platform, and Spice has no source-level conditional compilation to branch on target
// OS, the exact-count check lives in the OS/arch-specific cout.out files (cout-linux-amd64.out,
// cout-linux-aarch64.out, cout-macos.out) rather than as a hardcoded assertion here - the printed "count=N" line
// is what those compare against. What's genuinely platform-independent, and so what IS asserted directly below,
// is that the sentinel fix holds everywhere: no captured address should ever be nil.
//
// sDumpStacktrace()'s own output is also part of what cout.out compares (dladdr()/DbgHelp resolve whatever they
// can - see stack_trace_symbol_rt.spice/stack_trace_symbol_rt_windows.spice for what to expect there), so its
// text is included in the platform-specific refs too.
//
// No Windows ref yet: CI currently reports completely empty captured output there (not even the test harness's
// own unconditional lines), with a clean exit code - looks like a capture/redirection anomaly rather than
// anything wrong with this test's logic, but unconfirmed. Needs a real look before locking in a Windows
// expectation.

import "std/runtime/stack_trace_rt";

f<bool> levelC() {
    StackTraceBuffer trace;
    trace.capture();

    printf("count=%d\n", trace.count);
    for int i = 0; i < trace.count; i++ {
        assert trace.addresses[i] != nil<byte*>;
    }

    sDumpStacktrace(false);

    return true;
}

f<bool> levelB() {
    const bool ok = levelC(); // not a tail call - keeps levelB's own frame on every platform
    return ok;
}

f<bool> levelA() {
    const bool ok = levelB();
    return ok;
}

#[test]
f<bool> testStackTraceCapture() {
    const bool ok = levelA();
    return ok;
}
