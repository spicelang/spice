// Exercises StackTraceBuffer.capture() (the frame-pointer walk in stack_trace_rt.spice) through a few nested
// calls, and calls sDumpStacktrace() directly as a smoke test of the capture+dump convenience wrapper.
// capture()'s first recorded frame is the call site of capture() itself (levelC below), so this chain
// contributes exactly 4 frames: levelC, levelB, levelA and testStackTraceCapture.
//
// sDumpStacktrace() writes to stderr, whose content (raw addresses, and symbol names where dladdr() resolves
// them) is not deterministic enough to assert on - so this test checks only the exit code (see exit-code.out),
// not stdout/stderr content. A failing assert would abort with a non-zero exit code either way.

import "std/runtime/stack_trace_rt";

f<bool> levelC() {
    StackTraceBuffer trace;
    trace.capture();

    assert trace.count == 4;

    for int i = 0; i < trace.count; i++ {
        assert trace.addresses[i] != nil<byte*>;
    }

    sDumpStacktrace();

    return true;
}

f<bool> levelB() {
    return levelC();
}

f<bool> levelA() {
    return levelB();
}

#[test]
f<bool> testStackTraceCapture() {
    return levelA();
}
