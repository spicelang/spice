// Exercises StackTrace.capture() and the StackTrace/StackTraceEntry API.
//
// Only properties that hold on every platform and at every optimization level are asserted. The exact frame
// count is not one of them: it depends on how many frames the C runtime puts below main, and on whether the
// optimizer inlined the helpers below. Neither is the presence of symbol names or source locations - the first
// needs a symbol table, the second debug info, and the runner asks for neither.
import "std/os/os";
import "std/runtime/stack_trace_rt";

f<bool> levelC() {
    StackTrace noSkip;
    noSkip.capture(0);
    assert noSkip.getSize() > 0l;
    assert !noSkip.isEmpty();

    // Every frame carries a real return address, whether or not its symbol resolved
    for long i = 0l; i < noSkip.getSize(); i++ {
        const StackTraceEntry& entry = noSkip.getEntry(i);
        assert entry.address != nil<byte*>;
        // An offset is only meaningful together with the name it counts from, and a line number only together
        // with the file it points into - so neither may show up on its own
        if entry.functionName.isEmpty() { assert entry.offset == 0l; }
        if entry.fileName.isEmpty() { assert entry.lineNumber == 0; }
        // Whenever debug info names the file, it also settles whether the frame is Spice code. Which frames carry a
        // file depends on the platform - some C runtimes ship debug info of their own - so this holds for each of them.
        if entry.fileName.endsWith(".spice") { assert entry.isSpice; }
        else if !entry.fileName.isEmpty() { assert !entry.isSpice; }
    }

    // The frame that captured is Spice code without any debug info, whichever of the test's functions it is - the
    // optimizer may have inlined levelC into a caller, but never main, which is recognized by its name
    assert noSkip.getEntry(0ul).isSpice;
    // The stack ends in the startup code of the C runtime, which is not Spice. Left out on Windows, where a frame in
    // a system DLL can come back with the name of a function from another module - see the docs on stack traces.
    if !isWindows() && noSkip.getSize() < cast<long>(STACK_TRACE_CAPACITY) {
        assert !noSkip.getEntry(noSkip.getSize() - 1l).isSpice;
    }

    StackTrace skipOne;
    skipOne.capture(1);
    StackTrace skipTwo;
    skipTwo.capture(2);

    // A capture is capped at STACK_TRACE_CAPACITY, and once the stack is deeper than that every capture comes
    // back at the cap, so skipping stops reducing the size. The assertions below only hold below the cap.
    if noSkip.getSize() < cast<long>(STACK_TRACE_CAPACITY) {
        // Skipping n frames drops exactly n of them, never more and never fewer
        assert skipOne.getSize() == noSkip.getSize() - 1l;
        assert skipTwo.getSize() == noSkip.getSize() - 2l;

        // What remains is the tail of the unskipped trace, not a different walk
        for long i = 0l; i < skipTwo.getSize(); i++ {
            const StackTraceEntry& skipped = skipTwo.getEntry(i);
            const StackTraceEntry& full = noSkip.getEntry(i + 2l);
            assert skipped.address == full.address;
        }

        // Skipping past the bottom of the stack yields nothing rather than reading past it
        StackTrace skipAll;
        skipAll.capture(cast<int>(noSkip.getSize()) + 10);
        assert skipAll.isEmpty();
    }

    // The largest skip there is lands far below the bottom of the stack and yields nothing. It has to stay that way
    // on the way to the C shim, where it is an int and the largest unsigned values are negative: read as "skip
    // nothing", it would start the trace inside the stack trace runtime. Capturing over an existing trace must clear
    // it either way.
    StackTrace reused;
    reused.capture(0);
    assert !reused.isEmpty();
    reused.capture(4294967295u);
    assert reused.isEmpty();

    // sGetStacktrace() is the auto-imported entry point and hides its own frame, so it sees the same stack
    const StackTrace fromRuntimeFct = sGetStacktrace();
    assert fromRuntimeFct.getSize() == noSkip.getSize();

    // A trace can be walked with a foreach loop, which visits every frame once, in order
    long visited = 0l;
    foreach StackTraceEntry& entry : noSkip {
        assert entry.address == noSkip.getEntry(visited).address;
        visited++;
    }
    assert visited == noSkip.getSize();

    // The same loop with the frame number, which is the index the frame sits at
    foreach unsigned long frameIndex, StackTraceEntry& entry : noSkip {
        assert entry.address == noSkip.getEntry(frameIndex).address;
    }

    // The iterator behind that loop can also be driven by hand, forwards and backwards
    StackTraceIterator<StackTraceEntry> it = noSkip.getIterator();
    assert it.isValid();
    assert it.get().address == noSkip.getEntry(0ul).address;
    it++;
    assert it.get().address == noSkip.getEntry(1ul).address;
    it += 1;
    assert it.get().address == noSkip.getEntry(2ul).address;
    it--;
    assert it.get().address == noSkip.getEntry(1ul).address;
    it -= 1;
    assert it.get().address == noSkip.getEntry(0ul).address;

    return true;
}

f<bool> levelB() {
    const bool ok = levelC(); // not a tail call - keeps levelB's own frame where the optimizer leaves it
    return ok;
}

f<bool> levelA() {
    const bool ok = levelB();
    return ok;
}

f<int> main() {
    const bool ok = levelA();
    if !ok { return 1; }
    printf("All assertions passed!\n");
    return 0;
}
