// TEMPORARY DIAGNOSTIC - replaces the real test to find out why it fails on Windows CI. On other platforms it only
// prints the expected line. On Windows it prints its findings instead, so that the runner shows them as a mismatch.
import "std/os/os";
import "std/os/thread";
import "std/runtime/stack_trace_rt";

ext f<int> fflush(byte* /*stream*/);

p report(string label, StackTrace& trace) {
    int named = 0;
    foreach StackTraceEntry& entry : trace {
        if !entry.functionName.isEmpty() { named++; }
    }
    printf("%s: size=%d named=%d\n", label, cast<int>(trace.getSize()), named);
    fflush(nil<byte*>);
}

p dumpEntries(StackTrace& trace) {
    foreach unsigned long index, StackTraceEntry& entry : trace {
        printf("    #%lu addr=%p off=%lu spice=%d file=%s name=%s\n", index, entry.address, entry.offset, cast<int>(entry.isSpice),
               entry.fileName.getRaw(), entry.functionName.getRaw());
    }
    fflush(nil<byte*>);
}

p step(string text) {
    if isWindows() {
        printf("%s\n", text);
        fflush(nil<byte*>);
    }
}

p singleWorker() {
    step("  worker started");
    StackTrace trace = sGetStacktrace();
    if isWindows() {
        report("  single worker", trace);
        dumpEntries(trace);
    }
}

p manyWorker() {
    StackTrace trace = sGetStacktrace();
    if isWindows() { report("  many worker", trace); }
}

f<int> main() {
    step("step A: main thread");
    StackTrace mainTrace = sGetStacktrace();
    if isWindows() {
        report("  main", mainTrace);
        dumpEntries(mainTrace);
    }

    step("step B: one worker thread");
    Thread single = Thread(singleWorker);
    single.run();
    single.join();

    step("step C: 16 concurrent workers");
    Thread[16] threads;
    for int i = 0; i < 16; i++ {
        threads[i] = Thread(manyWorker);
    }
    for int i = 0; i < 16; i++ {
        Thread& thread = threads[i];
        thread.run();
    }
    for int i = 0; i < 16; i++ {
        Thread& thread = threads[i];
        thread.join();
    }

    step("step D: done");
    if !isWindows() { printf("All assertions passed!\n"); }
    return 0;
}
