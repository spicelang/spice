// TEMPORARY DIAGNOSTIC (Windows CI only, prints its findings there so the runner shows them as a mismatch): sixteen
// threads race the very first capture of the process, like the real test, but report instead of asserting. Other
// platforms only print the expected line.
import "std/os/os";
import "std/os/thread";
import "std/runtime/stack_trace_rt";

ext f<int> fflush(byte* /*stream*/);

p step(string text) {
    if isWindows() {
        printf("%s\n", text);
        fflush(nil<byte*>);
    }
}

p worker() {
    StackTrace trace = sGetStacktrace();
    if isWindows() {
        int named = 0;
        foreach StackTraceEntry& entry : trace {
            if !entry.functionName.isEmpty() { named++; }
        }
        printf("  worker: size=%d named=%d\n", cast<int>(trace.getSize()), named);
        if named == 0 {
            foreach unsigned long index, StackTraceEntry& entry : trace {
                printf("    #%lu addr=%p off=%lu spice=%d\n", index, entry.address, entry.offset, cast<int>(entry.isSpice));
            }
        }
        fflush(nil<byte*>);
    }
}

f<int> main() {
    step("16 workers race the first capture");
    Thread[16] threads;
    for int i = 0; i < 16; i++ {
        threads[i] = Thread(worker);
    }
    for int i = 0; i < 16; i++ {
        Thread& thread = threads[i];
        thread.run();
    }
    for int i = 0; i < 16; i++ {
        Thread& thread = threads[i];
        thread.join();
    }
    step("done");
    if !isWindows() { printf("All assertions passed!\n"); }
    return 0;
}
