// TEST: --keep-symbol-table
//
// Exercises libbacktrace-backed symbol resolution (std/runtime/stack_trace_libbacktrace_rt, backed by
// deps/libbacktrace), which resolveFromLibbacktrace() consults ahead of the platform's own resolver in
// StackTrace.capture(). This build turns the flag on - keeping the binary's own symbol table instead of
// stripping it - so on POSIX every frame this program owns is expected to resolve to a real, demangled name:
// the point of the flag is resolving functions the platform's own resolver cannot see (not exported, no debug
// info shipped), including 'innerFrame' below, which is neither 'public' nor ever passed to '-rdynamic'.
//
// Windows has no libbacktrace-backed resolution at all (stack_trace_libbacktrace_rt_windows.spice is an
// always-unresolved stub - DbgHelp already reads a Windows binary's own symbol/PDB data directly, the same way
// libbacktrace does here for ELF/Mach-O), and DbgHelp's SymFromAddr() does not resolve either frame in this
// clang/MinGW build (no PDB emitted in this configuration - the same limitation stack-trace-dump-basic already
// documents for its own Windows reference). So unlike Linux/macOS, Windows sees no benefit from the flag here;
// its own reference file expects '<unknown>' throughout, same as without the flag.
//
// The offset column is still not portable (it moves with any codegen change), so a resolved frame masks it the
// same way stack-trace-dump-basic masks it. The address column is dropped entirely here - this test is about
// names, not about the address/offset format, which the other test already covers. Expected output is pinned
// per platform in 'cout-<os>.out', same as stack-trace-dump-basic.
import "std/data/vector";
import "std/io/file";

ext f<byte*> freopen(string /*file path*/, string /*mode*/, byte* /*stream*/);
ext f<int> fflush(byte* /*stream*/);

const string DUMP_FILE_PATH = "./stack-trace-dump-libbacktrace.txt";
const string HEADER_LINE = "Stack trace:";
// innerFrame, middleFrame and main - the frames below them are the C runtime's, which this build does not touch
const long OWNED_FRAMES = 3l;

p innerFrame() {
    sDumpStacktrace(false);
}

p middleFrame() {
    innerFrame();
}

/**
 * Reads the dump back in, dropping the empty line that the trailing newline yields at EOF.
 */
f<Vector<String>> readDumpLines() {
    Result<File> fileResult = openFile(DUMP_FILE_PATH, MODE_READ);
    assert fileResult.isOk();
    File dumpFile = fileResult.unwrap();

    Vector<String> lines;
    while !dumpFile.isEOF() {
        String line = dumpFile.readLine();
        if !line.isEmpty() {
            lines.pushBack(line);
        }
    }
    assert dumpFile.close();
    return lines;
}

/**
 * Masks the offset of a resolved frame line ('  <name> + 0x...' -> '  <name> + <offset>'). An unresolved
 * frame ('  <unknown>') has no offset to mask and is returned unchanged - see the module comment above for why
 * that is the expected outcome on Windows.
 */
f<String> maskOffset(String& line) {
    assert line.startsWith("  ");
    const long offsetStart = line.find(" + ");
    if offsetStart == -1l {
        return line;
    }
    return line.getSubstring(0l, offsetStart + 3l) + "<offset>";
}

f<int> main() {
    // Point stderr at a file, so the dump does not reach the compared output unmasked
    assert freopen(DUMP_FILE_PATH, MODE_WRITE, __stderr()) != nil<byte*>;

    middleFrame();
    assert fflush(__stderr()) == 0;

    Vector<String> lines = readDumpLines();
    assert lines.getSize() >= 1l + OWNED_FRAMES;
    assert lines.get(0l) == HEADER_LINE;

    for long i = 0l; i < OWNED_FRAMES; i++ {
        String masked = maskOffset(lines.get(1l + i));
        printf("%s\n", masked.getRaw());
    }

    // The dump file is deliberately left behind: stderr is still attached to it, which Windows refuses to
    // unlink, and it is what one looks at when this test goes red
    printf("All assertions passed!\n");
    return 0;
}
