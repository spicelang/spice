import "std/data/map";
import "std/data/pair";

f<int> main() {
    Map<int, int> map;
    {
        foreach Pair<int&, int&> item : map {
            int& first = item.getFirst();
            int& second = item.getSecond();
            printf("%d: %d\n", first, second);
        }
    }

    map.upsert(1, 2);
    map.upsert(2, 3);
    map.upsert(3, 4);
    map.upsert(4, 5);
    map.upsert(5, 6);
    foreach Pair<int&, int&> item : map {
        int& first = item.getFirst();
        int& second = item.getSecond();
        printf("%d: %d\n", first, second);
    }
}