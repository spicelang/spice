import "std/data/red-black-tree";
import "std/data/pair";

f<int> main() {
    RedBlackTree<int, int> tree;
    {
        foreach Pair<int&, int&> item : tree {
            int& first = item.getFirst();
            int& second = item.getSecond();
            printf("%d: %d\n", first, second);
        }
    }

    tree.upsert(1, 2);
    tree.upsert(2, 3);
    tree.upsert(3, 4);
    tree.upsert(4, 5);
    tree.upsert(5, 6);
    foreach Pair<int&, int&> item : tree {
        int& first = item.getFirst();
        int& second = item.getSecond();
        printf("%d: %d\n", first, second);
    }
}
