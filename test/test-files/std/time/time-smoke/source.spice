import "std/time/time";

f<int> main() {
    const long millisBefore = getCurrentMillis();
    const long secs = getCurrentSecs();
    const long micros = getCurrentMicros();
    const long millisAfter = getCurrentMillis();
    assert millisBefore > 0l;
    assert secs >= millisBefore / 1000l; // The second and microsecond samples lie between the two millisecond samples
    assert secs <= millisAfter / 1000l;
    assert micros / 1000l >= millisBefore;
    assert micros / 1000l <= millisAfter;

    // Leap years follow the Gregorian calendar
    assert isLeapYear(2024);
    assert !isLeapYear(2023);
    assert !isLeapYear(1900);
    assert isLeapYear(2000);

    assert getCurrentYear() >= 2024;

    printf("All assertions passed!\n");
}
