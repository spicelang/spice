import "std/time/time";

f<int> main() {
    const long millis = getCurrentMillis();
    const long micros = getCurrentMicros();
    assert millis > 0l;
    assert micros / 1000l >= millis;
    assert micros / 1000l - millis < 1000l; // Both calls are within a second
    assert getCurrentSecs() > 0l;

    // Leap years follow the Gregorian calendar
    assert isLeapYear(2024);
    assert !isLeapYear(2023);
    assert !isLeapYear(1900);
    assert isLeapYear(2000);

    assert getCurrentYear() >= 2024;

    printf("All assertions passed!\n");
}
