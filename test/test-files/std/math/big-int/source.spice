    checkPair("-481938647748437226", "-201576665637584393241049557689487042076559017929899392011262141", "-201576665637584393241049557689487042076559018411838039759699367", "201576665637584393241049557689487042076559017447960744262824915", "97147585655016295283030553311044111468055574651509564836768448411858824568860866", "0", "-481938647748437226", 1, "-66237143384256061464926748672", "-13698");
    checkPair("-14208249946760105755170789875691153429569390632602386297421651850437515680688446841844082039", "187031205899373066450234467799317557707388120292163432850514384639780", "-14208249946760105755170602844485254056502940398134586979863944462317223517255596327459442259", "-14208249946760105755170976906897052802635840867070185614979359238557807844121297356228721819", "-2657386121262245748826044743903733516197725383574995490647746806197119088935826257462879337981516846436638143854282960518582202280693741202417227920555782911420", "-75967269089867597249167", "-67178575577950885095221738890783822747393753806285293589955644018779", -1, "-1952767003351308652030717613138605100048600708149632016607504762237664420481409854424154134036671889408", "-403822751501368934304161651757884596621846373881293922563078577082862798326018");
    checkPair("386230024479647366039325339798395832015573708050749177509073426599041334815640020", "-1395922310326488747101641046769810162410640455260176881209163318", "386230024479647364643403029471907084913932661280939015098432971338864453606476702", "386230024479647367435247650124884579117214754820559339919713881859218216024803338", "-539147108089085655972426798694982088905603976634746909044103636289581667798535301272887980432054141485508523908474784024503971631565804876786360", "-276684469918181191", "973985461082404167620590895971063596002068572364638097380888282", 1, "53083050363947675352046188298822314616627162840173428022411811536177249215531522406681149440", "10977317529058364187884687333916981288427158121145031870727093138357");
    checkPair("-3030705957218386663816917557986879813737425586461353360935278424615367", "1247489107564026551012205425302120206743618696441096150985706378290463063", "1244458401606808164348388507744133326929881270854634797624771099865847696", "-1250519813521244937676022342860107086557356122027557504346641656715078430", "-3780772669859344011407706934856245659658463081975680669519955666576363533980595058571724481663410964999515794341111631228814964682320095689121", "0", "-3030705957218386663816917557986879813737425586461353360935278424615367", -1, "-416537055041451067231238638178618636706714061602724257699734553804076884609204224", "-86137844085055424551936697468672713675272961679108714206");
    checkPair("44171545248200366288089509058250615764", "10284489311324517775381950145", "44171545258484855599414026833632565909", "44171545237915876976764991282868665619", "454281784969803960675270436255236141557240833581890841237399085780", "4294967295", "10284489311177877052155107989", 1, "6070890952153752834002091383228228917703745732608", "1255430824136293673748511");
    checkPair("-44171545248200366288089509058250615764", "10284489311324517775381950145", "-44171545237915876976764991282868665619", "-44171545258484855599414026833632565909", "-454281784969803960675270436255236141557240833581890841237399085780", "-4294967295", "-10284489311177877052155107989", -1, "-6070890952153752834002091383228228917703745732608", "-1255430824136293673748512");
    checkPair("757476141775682179260953868033637521247447224607", "176363657642081887295162540158548099173", "757476141952045836903035755328800061405995323780", "757476141599318521618871980738474981088899125434", "133591262940171493496579507962860101977432686551582149633851000958626779020074241950011", "4294967295", "176363657616354746343549320614995677572", 1, "104106728205658058496505802015013535413641310501537006485504", "21528766802011949131979061690845967");
    checkPair("-757476141775682179260953868033637521247447224607", "176363657642081887295162540158548099173", "-757476141599318521618871980738474981088899125434", "-757476141952045836903035755328800061405995323780", "-133591262940171493496579507962860101977432686551582149633851000958626779020074241950011", "-4294967295", "-176363657616354746343549320614995677572", -1, "-104106728205658058496505802015013535413641310501537006485504", "-21528766802011949131979061690845968");
    checkPair("88567445966541243369159902776818469148", "20621215451169117207714015008", "88567445987162458820329019984532484156", "88567445945920027917990785569104454140", "1826368385235826195949094840200225926927472144530794691099256973184", "4294967295", "20621215448006486604319305788", 1, "12172617085329336016182996397471197181422239481856", "2517238214254042627804889");
    checkPair("-88567445966541243369159902776818469148", "20621215451169117207714015008", "-88567445945920027917990785569104454140", "-88567445987162458820329019984532484156", "-1826368385235826195949094840200225926927472144530794691099256973184", "-4294967295", "-20621215448006486604319305788", -1, "-12172617085329336016182996397471197181422239481856", "-2517238214254042627804890");
    checkPair("604480666743477552950213273574467878211528165662", "140741622714204143959347833908181859758", "604480666884219175664417417533815712119710025420", "604480666602735930236009129615120044303346305904", "85075589936841085854305106193073273104643437219200963508925672951682606852113475229796", "4294967295", "140741622691342517409734757638641551052", 1, "83079190231280349159400778439278097840672782134437126078464", "17180373866479998041262810874470343");
    checkPair("-604480666743477552950213273574467878211528165662", "140741622714204143959347833908181859758", "-604480666602735930236009129615120044303346305904", "-604480666884219175664417417533815712119710025420", "-85075589936841085854305106193073273104643437219200963508925672951682606852113475229796", "-4294967295", "-140741622691342517409734757638641551052", -1, "-83079190231280349159400778439278097840672782134437126078464", "-17180373866479998041262810874470344");
    // Small operands
    BigInt value = BigInt(-123456789l);
    value.multiply(-4000000000l);
    assert hasText(value, "493827156000000000");
    value.add(-493827156000000001l);
    assert hasText(value, "-1");
    value.add(1l);
    assert value.isZero() && !value.isNegative() && value.getSignum() == 0;
    BigInt big70 = BigInt(1l) << 70ul;
    big70.multiply(-3l);
    assert hasText(big70, "-3541774862152233910272");
    BigInt divided = big("-1000000000007");
    const long smallRemainder = divided.divide(10l);
    assert hasText(divided, "-100000000000") && smallRemainder == -7l;
    BigInt subtracted = BigInt(5);
    subtracted.subtract(7l);
    assert hasText(subtracted, "-2");

    // Powers
    BigInt power = BigInt(3);
    power.pow(200ul);
    assert hasText(power, "265613988875874769338781322035779626829233452653394495974574961739092490901302182994384699044001");
    BigInt negativePower = BigInt(-7);
    negativePower.pow(33ul);
    assert hasText(negativePower, "-7730993719707444524137094407");
    BigInt zeroPower = BigInt(0);
    zeroPower.pow(0ul);
    assert hasText(zeroPower, "1");

    // Conversions to long and unsigned values
    assert big("9223372036854775807").fitsInLong() && !big("9223372036854775808").fitsInLong();
    assert big("-9223372036854775808").fitsInLong() && !big("-9223372036854775809").fitsInLong();
    assert big("-9223372036854775808").toLong() == -9223372036854775807l - 1l;
    assert big("-42").toLong() == -42l;
    assert big("18446744073709551617").toLong() == 1l; // Wraps around like a cast
    assert hasText(getBigIntFromUnsigned(18446744073709551615ul), "18446744073709551615");
    assert big("-18446744073709551615").getAbsoluteLowBits() == 18446744073709551615ul;

    // Bits, sign and absolute value
    const BigInt bits = big("-1180591620717411303424"); // -2^70
    assert bits.getBitLength() == 71ul && bits.getLowestSetBit() == 70l;
    assert bits.testBit(70ul) && !bits.testBit(69ul) && !bits.testBit(500ul);
    assert BigInt(0).getBitLength() == 0ul && BigInt(0).getLowestSetBit() == -1l;
    assert big("12").isOdd() == false && big("-13").isOdd();
    assert hasText(bits.getAbsolute(), "1180591620717411303424");
    BigInt negated = bits;
    negated.negate();
    assert hasText(negated, "1180591620717411303424");
    BigInt negatedZero = BigInt(0);
    negatedZero.negate();
    assert !negatedZero.isNegative();
    assert hasText(big("-5") >> 1ul, "-3") && hasText(big("-4") >> 1ul, "-2") && hasText(big("-1") >> 70ul, "-1");
    // shiftRight also tells, whether any of the shifted out bits of the absolute value was set
    BigInt minusFive = big("-5");
    assert minusFive.shiftRight(1ul) && hasText(minusFive, "-3");
    BigInt minusFour = big("-4");
    assert !minusFour.shiftRight(1ul) && hasText(minusFour, "-2");
    BigInt minusOne = big("-1");
    assert minusOne.shiftRight(70ul) && hasText(minusOne, "-1"); // All limbs are shifted out
    BigInt twoTo64 = big("18446744073709551616");
    assert !twoTo64.shiftRight(64ul) && hasText(twoTo64, "1");

    // Text in other bases
    assert (BigInt(1l) << 100ul).toString(16) == "10000000000000000000000000";
    Result<BigInt> base36 = parseBigInt(String("ZZ9"), 36);
    assert hasText(base36.unwrap(), "46629");
    assert big("-0").toString() == "0" && !big("-0").isNegative();
    assert big("+17").toString() == "17";
    const Result<BigInt> empty = parseBigInt(String(""));
    const Result<BigInt> onlySign = parseBigInt(String("-"));
    const Result<BigInt> invalidDigit = parseBigInt(String("12a"));
    const Result<BigInt> withSpace = parseBigInt(String(" 12"));
    const Result<BigInt> invalidBase = parseBigInt(String("1"), 37);
    assert empty.isErr() && onlySign.isErr() && invalidDigit.isErr() && withSpace.isErr() && invalidBase.isErr();

    // Compound assignment operators
    BigInt counter = BigInt(10);
    counter += BigInt(5);
    counter -= BigInt(3);
    counter *= BigInt(-4);
    counter /= BigInt(5);
    assert hasText(counter, "-9");

    printf("All assertions succeeded");
}
