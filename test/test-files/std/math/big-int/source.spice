import "std/math/big-int";

// Expected values computed with the integers of Python. The division rounds towards zero like the one of long, the
// remainder has the sign of the dividend and the shift to the right rounds towards negative infinity

f<BigInt> big(string text) {
    Result<BigInt> parsed = parseBigInt(String(text));
    return parsed.unwrap();
}

f<bool> hasText(const BigInt& value, string text) {
    return value.toString() == text;
}

p checkPair(string lhsText, string rhsText, string sum, string difference, string product, string quotient, string remainder, int order, string shiftedLeft, string shiftedRight) {
    const BigInt lhs = big(lhsText);
    const BigInt rhs = big(rhsText);
    assert hasText(lhs, lhsText);
    assert hasText(lhs + rhs, sum);
    assert hasText(lhs - rhs, difference);
    assert hasText(lhs * rhs, product);
    assert hasText(lhs / rhs, quotient);
    BigInt remainderValue = lhs;
    remainderValue.remainder(rhs);
    assert hasText(remainderValue, remainder);
    assert lhs.compare(rhs) == order;
    assert (lhs < rhs) == (order < 0) && (lhs == rhs) == (order == 0) && (lhs >= rhs) == (order >= 0);
    assert hasText(lhs << 37ul, shiftedLeft);
    assert hasText(lhs >> 45ul, shiftedRight);
    // The text in other bases reads back to the same value
    Result<BigInt> fromHex = parseBigInt(lhs.toString(16), 16);
    assert fromHex.unwrap() == lhs;
    Result<BigInt> fromBinary = parseBigInt(lhs.toString(2), 2);
    assert fromBinary.unwrap() == lhs;
    // quotient * divisor + remainder is the dividend
    BigInt quotientValue = lhs;
    BigInt divisionRemainder;
    quotientValue.divideWithRemainder(rhs, divisionRemainder);
    assert quotientValue * rhs + divisionRemainder == lhs;
}

f<int> main() {
    checkPair("0", "1", "1", "-1", "0", "0", "0", -1, "0", "0");
    checkPair("0", "-1", "-1", "1", "0", "0", "0", 1, "0", "0");
    checkPair("0", "4294967295", "4294967295", "-4294967295", "0", "0", "0", -1, "0", "0");
    checkPair("0", "4294967296", "4294967296", "-4294967296", "0", "0", "0", -1, "0", "0");
