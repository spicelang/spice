import "std/bindings/llvm/llvm" as llvm;

// Takes the triple by value, like llvm::getTargetFromTriple
f<bool> isLinux(llvm::Triple triple) {
    return triple.getOSName() == "linux";
}

f<String> archTypeName(string tripleString) {
    const llvm::Triple triple = llvm::Triple(tripleString);
    return triple.getArchTypeName();
}

f<String> osTypeName(string tripleString) {
    const llvm::Triple triple = llvm::Triple(tripleString);
    return triple.getOSTypeName();
}

f<int> main() {
    llvm::Triple original = llvm::Triple(String("x86_64"), String("unknown"), String("linux"));
    assert !original.empty();

    // Copies own their message and stay valid after the original went out of scope
    llvm::Triple copy = original;
    assert copy == original;
    assert copy.getArchName() == "x86_64";
    llvm::Triple survivor;
    {
        llvm::Triple scoped = llvm::Triple(String("riscv64"), String("unknown"), String("linux"));
        llvm::Triple scopedCopy = scoped; // Copy constructor
        survivor = scopedCopy; // Assignment
    }
    assert survivor.getArchName() == "riscv64";
    assert survivor.getOSName() == "linux";

    // A by-value parameter is a copy, so the original stays valid after the call
    assert isLinux(original);
    assert isLinux(original);
    assert original.getVendorName() == "unknown";

    // Assigning a temporary keeps the assigned value alive after the temporary was destroyed
    llvm::Triple assigned;
    assert assigned.empty();
    assigned = llvm::Triple(String("aarch64"), String("apple"), String("darwin"));
    assert !assigned.empty();
    assert assigned.getArchName() == "aarch64";
    assert assigned.getOSName() == "darwin";

    // Re-assigning replaces the previous message
    assigned = original;
    assert assigned == original;
    assert assigned.getOSName() == "linux";
    assigned = assigned; // Self assignment
    assert assigned.getOSName() == "linux";

    // A triple can be created from its whole string. The message is copied, so the string does not have to outlive the triple
    llvm::Triple fromString;
    {
        String tripleString = String("aarch64-unknown-linux-gnu");
        fromString = llvm::Triple(tripleString.getRaw());
    }
    assert !fromString.empty();
    assert fromString.getArchName() == "aarch64";
    assert fromString.getVendorName() == "unknown";
    assert fromString.getOSName() == "linux";

    // Copying an empty triple stays empty
    llvm::Triple empty;
    llvm::Triple emptyCopy = empty;
    assert emptyCopy.empty();

    // The canonical OS and arch names are the ones of llvm::Triple::getOSTypeName / getArchTypeName
    const llvm::Triple darwin = llvm::Triple("arm64-apple-darwin25.6.0");
    assert darwin.getOSName() == "darwin25.6.0";
    assert darwin.getArchName() == "arm64";
    assert darwin.getOSTypeName() == "darwin";
    assert darwin.getArchTypeName() == "aarch64";
    const llvm::Triple macos = llvm::Triple("aarch64-apple-macosx15.0");
    assert macos.getOSTypeName() == "macosx";
    assert macos.getArchTypeName() == "aarch64";
    const llvm::Triple linux = llvm::Triple("x86_64-unknown-linux-gnu");
    assert linux.getOSTypeName() == "linux";
    assert linux.getArchTypeName() == "x86_64";
    const llvm::Triple windows = llvm::Triple("x86_64-pc-windows-msvc");
    assert windows.getOSTypeName() == "windows";
    const llvm::Triple mingw = llvm::Triple("x86_64-w64-mingw32");
    assert mingw.getOSTypeName() == "windows";
    const llvm::Triple x86 = llvm::Triple("i686-pc-linux-gnu");
    assert x86.getArchTypeName() == "i386";
    const llvm::Triple wasm = llvm::Triple("wasm32-unknown-unknown");
    assert wasm.getOSTypeName() == "unknown";
    assert wasm.getArchTypeName() == "wasm32";
    // Architecture aliases
    assert archTypeName("arm64e-apple-darwin") == "aarch64";
    assert archTypeName("arm64ec-pc-windows-msvc") == "aarch64";
    assert archTypeName("arm64_32-apple-watchos") == "aarch64_32";
    assert archTypeName("aarch64_be-unknown-linux-gnu") == "aarch64_be";
    assert archTypeName("amd64-unknown-freebsd") == "x86_64";
    // Digits, that belong to the OS name, are kept. Version suffixes are stripped
    assert osTypeName("wasm32-unknown-wasip1") == "wasip1";
    assert osTypeName("wasm32-unknown-wasi") == "wasi";
    assert osTypeName("x86_64-scei-ps4") == "ps4";
    assert osTypeName("x86_64-sie-ps5") == "ps5";
    assert osTypeName("arm64-apple-ios17.0") == "ios";
    // OS aliases
    assert osTypeName("x86_64-pc-win32") == "windows";
    assert osTypeName("arm64-apple-visionos1.0") == "xros";
    assert osTypeName("x86_64-unknown-kfreebsd") == "kfreebsd";

    printf("All assertions passed!\n");
}
