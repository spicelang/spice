// Parameter names in external declarations are optional. Either all or none of the parameters of a declaration are named
ext f<int> abs(int value);
ext f<byte*> malloc(unsigned long size);
ext p free(byte*);
ext f<int> snprintf(char* buffer, unsigned long size, string format, ...);

f<int> main() {
    byte* address = malloc(32ul);
    unsafe {
        const int length = snprintf(cast<char*>(address), 32ul, "abs: %d", abs(-42));
        printf("%s (%d chars)\n", cast<string>(cast<char*>(address)), length);
    }
    free(address);
}
