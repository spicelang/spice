// Widening integer conversions must extend by the signedness of the source type, not of the target type

f<int> main() {
    // Unsigned source -> wider signed target (zero-extend)
    const unsigned int ui = 4294967295u;
    const unsigned short us = 65535us;
    const byte b = cast<byte>(255);
    const char c = cast<char>(200);
    printf("%lld %lld\n", cast<long>(ui), cast<unsigned long>(ui));
    printf("%d %lld\n", cast<int>(us), cast<long>(us));
    printf("%d %d\n", cast<int>(b), cast<int>(c));

    // Signed source -> wider unsigned target (sign-extend)
    const int i = -1;
    const short s = -1s;
    printf("%llu %u %llu\n", cast<unsigned long>(i), cast<unsigned int>(s), cast<unsigned long>(s));

    // Mixed signedness in binary operators
    const long l = 1l;
    const unsigned long ul = 1ul;
    printf("%lld %lld\n", l + ui, ui + l);
    printf("%llu %llu\n", ul + i, i + ul);
    const long lMax = 4294967295l;
    assert lMax == ui;
    assert ui == lMax;
    long acc = 0l;
    acc += ui;
    acc -= us;
    printf("%lld\n", acc);
}
