// TEST: --sanitizer=thread

import "std/os/thread";

int COUNTER = 0;

p worker() {
    for int i = 0; i < 1000000; i++ {
        COUNTER++;
    }
}

f<int> main() {
    Thread thread1 = Thread(worker);
    Thread thread2 = Thread(worker);
    Result<bool> started1 = thread1.run();
    Result<bool> started2 = thread2.run();
    if started1.isErr() || started2.isErr() { return 1; }
    Result<bool> joined1 = thread1.join();
    Result<bool> joined2 = thread2.join();
    if joined1.isErr() || joined2.isErr() { return 1; }
}