// TEST: --sanitizer=address

import "std/data/vector";
import "std/data/pair";
import "std/iterator/array-iterator";

f<int> main() {
    // The loop header variables are declared once, but assigned in every iteration. Address sanitizer requires lifetime
    // markers, so their lifetime must span all iterations and must not end at the end of the loop body or on continue.
    Vector<Pair<int, String>> pairs = Vector<Pair<int, String>>();
    pairs.pushBack(Pair<int, String>(1, String("one")));
    pairs.pushBack(Pair<int, String>(2, String("two")));
    pairs.pushBack(Pair<int, String>(3, String("three")));
    foreach Pair<int, String> pair : pairs {
        const String& name = pair.getSecond();
        printf("%d: %s\n", pair.getFirst(), name.getRaw());
    }
    foreach unsigned long idx, const Pair<int, String>& pair : pairs {
        if idx == 1l {
            continue;
        }
        const String& name = pair.getSecond();
        printf("%lu: %s\n", idx, name.getRaw());
    }

    int[3] values = [4, 5, 6];
    foreach int value : values {
        if value == 5 {
            continue;
        }
        printf("Value: %d\n", value);
    }

    for int i = 0; i < 3; i++ {
        if i == 1 {
            continue;
        }
        printf("Iteration: %d\n", i);
    }
}
