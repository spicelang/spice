// A function, that returns one of its locals without copying it, hands the local over to the caller. So only the return
// statement, that returns the local, may skip its dtor call. Every other path out of the scope of the local (returning
// something else, leaving a loop body, ...) still has to destruct it.
//
// Every Tracked counts itself in LIVE. Each check only keeps the returned value alive, so the number of live
// instances has to be 1 during every report, whether a local leaked (more) or was destructed twice (less).

public int LIVE = 0;

type Tracked struct {
    int id
}

p Tracked.ctor(int id) {
    this.id = id;
    LIVE++;
}

p Tracked.dtor() {
    LIVE--;
}

p report(string name, int id) {
    printf("%s: id=%d live=%d\n", name, id, LIVE);
}

// The local is returned on one path and a temporary on the other one
f<Tracked> localOrTemporary(bool returnLocal) {
    Tracked local = Tracked(1);
    if !returnLocal {
        return Tracked(2);
    }
    return local;
}

// The early return sits in a loop, like the ones of Triple.getArchTypeName() in the std LLVM bindings
f<Tracked> earlyReturnFromForLoop(int match) {
    const Tracked local = Tracked(1);
    for int i = 0; i < 3; i++ {
        if i == match {
            return Tracked(10 + i);
        }
    }
    return local;
}

// Each of the two locals is returned on a path of its own, which has to destruct the other one
f<Tracked> oneOfTwoLocals(bool returnFirst) {
    Tracked first = Tracked(1);
    Tracked second = Tracked(2);
    if returnFirst {
        return first;
    }
    return second;
}

// The local of the loop body is only returned in the last round, all rounds before have to destruct it at the end of the body
f<Tracked> localOfLoopBody(int rounds) {
    int round = 0;
    while round < 10 {
        Tracked local = Tracked(round);
        if round == rounds {
            return local;
        }
        round++;
    }
    return Tracked(-1);
}

f<int> main() {
    {
        Tracked returned = localOrTemporary(true);
        report("localOrTemporary(true)", returned.id);
    }
    {
        Tracked returned = localOrTemporary(false);
        report("localOrTemporary(false)", returned.id);
    }

    {
        Tracked returned = earlyReturnFromForLoop(0);
        report("earlyReturnFromForLoop(0)", returned.id);
    }
    {
        Tracked returned = earlyReturnFromForLoop(2);
        report("earlyReturnFromForLoop(2)", returned.id);
    }
    {
        Tracked returned = earlyReturnFromForLoop(3);
        report("earlyReturnFromForLoop(3)", returned.id);
    }

    {
        Tracked returned = oneOfTwoLocals(true);
        report("oneOfTwoLocals(true)", returned.id);
    }
    {
        Tracked returned = oneOfTwoLocals(false);
        report("oneOfTwoLocals(false)", returned.id);
    }

    {
        Tracked returned = localOfLoopBody(0);
        report("localOfLoopBody(0)", returned.id);
    }
    {
        Tracked returned = localOfLoopBody(3);
        report("localOfLoopBody(3)", returned.id);
    }

    // A lambda body is a function scope of its own
    f<Tracked>(bool) lambda = f<Tracked>(bool returnLocal) {
        Tracked local = Tracked(1);
        if !returnLocal {
            return Tracked(2);
        }
        return local;
    };
    {
        Tracked returned = lambda(true);
        report("lambda(true)", returned.id);
    }
    {
        Tracked returned = lambda(false);
        report("lambda(false)", returned.id);
    }

    printf("end: live=%d\n", LIVE);
}