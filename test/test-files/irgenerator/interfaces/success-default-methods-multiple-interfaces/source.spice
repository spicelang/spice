type INamed interface {
    f<string> getName();
}

type ICounter interface {
    f<int> getCount();
    p increment();
    p incrementTwice();
}

// Default method of the second interface of the struct
p ICounter.incrementTwice() {
    this.increment();
    this.increment();
}

type Counter struct : INamed, ICounter {
    int count
}

p Counter.ctor() {
    this.count = 0;
}

f<string> Counter.getName() {
    return "Counter";
}

f<int> Counter.getCount() {
    return this.count;
}

p Counter.increment() {
    this.count++;
}

f<int> main() {
    Counter counter = Counter();
    counter.incrementTwice();
    printf("%s: %d\n", counter.getName(), counter.getCount());
    ICounter* icounter = &counter;
    icounter.incrementTwice();
    printf("%s: %d\n", counter.getName(), icounter.getCount());
}
