type T int|double;

type IValue interface {
    f<double> getValue();
    f<double> getDoubleValue();
}

f<double> IValue.getDoubleValue() {
    return this.getValue() * 2.0;
}

type Box<T> struct : IValue {
    T value
}

p Box.ctor(T value) {
    this.value = value;
}

f<double> Box.getValue() {
    return cast<double>(this.value);
}

f<int> main() {
    Box<int> intBox = Box<int>(21);
    Box<double> doubleBox = Box<double>(1.25);
    printf("%.2f\n", intBox.getDoubleValue());
    IValue* value = &doubleBox;
    printf("%.2f\n", value.getDoubleValue());
}
