type Counter struct {
    int value
}

p Counter.ctor(int value) {
    this.value = value;
}

p Counter.dtor() {
    printf("Dtor %d\n", this.value);
}

f<bool> operator<(const Counter& counter, int limit) {
    return counter.value < limit;
}

f<int> getValue(const Counter& counter) {
    return counter.value;
}

f<int> findFirstAbove(int limit) {
    for Counter counter = Counter(0); counter < 10; counter.value++ {
        if counter.value > limit {
            // The loop variable is destructed when returning from the loop body
            return counter.value;
        }
    }
    return -1;
}

f<int> main() {
    // The loop variable lives across all iterations, so it must only be destructed once, when the loop is left
    for Counter counter = Counter(0); counter < 3; counter.value++ {
        printf("Iteration %d\n", counter.value);
    }
    printf("After loop 1\n");

    // ... also when leaving the loop via break, and not when continuing with the next iteration
    for Counter counter = Counter(10); counter < 20; counter.value++ {
        if counter.value == 11 {
            continue;
        }
        if counter.value == 12 {
            break;
        }
        printf("Iteration %d\n", counter.value);
    }
    printf("After loop 2\n");

    printf("Found %d\n", findFirstAbove(4));

    // Temporaries of the incrementer are destructed after each evaluation
    for int i = 0; i < 3; i += getValue(Counter(1)) {
        printf("Iteration %d\n", i);
    }
    printf("After loop 3\n");
}
