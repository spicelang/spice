// When a copy and a move overload of a ctor or assign operator coexist, an RValue argument (a temporary or the result of
// move()) selects the move overload, while an LValue selects the copy overload.

type Test struct {}

p Test.ctor() {
    printf("Constructed\n");
}

p Test.ctor(const Test& _) {
    printf("Copied\n");
}

p operator=(Test& _1, const Test& _2) {
    printf("Copy assigned\n");
}

p Test.ctor(Test&& _) {
    printf("Moved\n");
}

p operator=(Test& _1, Test&& _2) {
    printf("Move assigned\n");
}

p Test.dtor() {
    printf("Destructed\n");
}

f<int> main() {
    Test t;
    printf("Assign temporary\n");
    t = Test();
    printf("Construct from temporary\n");
    Test u = Test(Test());
    printf("Assign non-const LValue\n");
    t = u;
    printf("Construct from non-const LValue\n");
    Test v = Test(u);
    printf("Assign moved LValue\n");
    t = move(u);
    printf("Construct from moved LValue\n");
    Test w = Test(move(u));
    printf("End\n");
}
