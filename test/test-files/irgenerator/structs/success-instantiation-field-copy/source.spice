// TEST: --sanitizer=address

import "std/data/vector";

// Struct instantiation with a non-trivially-copyable field value sourced from a plain (non-temporary) local
// variable must deep-copy that value into the field (call its copy ctor), not shallow-copy its raw bytes.
// A shallow copy aliases the source's owned heap buffer, so once the source is destructed independently of
// the struct - e.g. its enclosing block ends before the struct does, or a function returns the struct while
// the source lives in an outer scope - the struct's field is left dangling.
type Box struct {
    String content
}

type Pair struct {
    String first
    String second
}

f<Box> buildBox(string value) {
    // Field value sourced from a local, non-temporary variable: must be deep-copied, since 'local' keeps
    // its own buffer alive independently and the caller destructs it normally when the function returns.
    String local = String(value);
    return Box{local};
}

// A struct literal used inside a generic function needs its own, per-manifestation copy-ctor info: the struct
// itself (Wrapper<T> here) resolves to a different concrete type for each T the generic function is
// instantiated with, so a copy ctor matched for one manifestation must never be reused for another - it would
// be called on the wrong type's memory layout.
type T dyn;
type Wrapper<T> struct {
    T value
}

// Explicit (even empty) dtor, to sidestep a separate, pre-existing gap where the compiler's default-dtor
// generation misses structs that are only ever reached through a generic manifestation (the same gap
// std/data/hash-table.spice's HashEntry<K, V> hits) - unrelated to what this test is exercising.
public p Wrapper.dtor() {}

f<Wrapper<T>> wrap<T>(const T& value) {
    return Wrapper<T>{value};
}

f<int> main() {
    Box b;
    {
        // The source local goes out of scope (and gets destructed) before 'b' does. If Box{local} had
        // aliased local's buffer instead of copying it, this would leave b.content dangling.
        String local = String("hello");
        b = Box{local};
    }
    printf("box: %s\n", b.content.getRaw());

    // Two fields of the same struct sourced from two different locals must each get their own,
    // independent copy - not both aliasing whichever local happens to be destructed last.
    Pair pairVal;
    {
        String firstLocal = String("first");
        String secondLocal = String("second");
        pairVal = Pair{firstLocal, secondLocal};
    }
    printf("pair: %s %s\n", pairVal.first.getRaw(), pairVal.second.getRaw());

    Box fromReturn = buildBox("returned");
    printf("fromReturn: %s\n", fromReturn.content.getRaw());

    // Two manifestations of wrap<T>, both needing a real (but different) copy ctor for their Wrapper<T>{value}
    // struct literal.
    String strSrc = String("wrapped-string");
    Wrapper<String> wrappedStr = wrap<String>(strSrc);

    Vector<int> vecSrc = Vector<int>();
    vecSrc.pushBack(1);
    vecSrc.pushBack(2);
    vecSrc.pushBack(3);
    Wrapper<Vector<int>> wrappedVec = wrap<Vector<int>>(vecSrc);

    printf("wrappedStr: %s\n", wrappedStr.value.getRaw());
    printf("wrappedVec: %d %d %d\n", wrappedVec.value.get(0), wrappedVec.value.get(1), wrappedVec.value.get(2));

    return 0;
}
