type StructWithHeapFields struct {
    heap int* data
}

p StructWithHeapFields.ctor() {
    dyn res = sAlloc(10l);
    unsafe {
        this.data = cast<heap int*>(res.unwrapAndMove());
    }
}

f<int> main() {
    StructWithHeapFields s = StructWithHeapFields();
    printf("Is nullptr: %d\n", s.data == nil<heap int*>);
    // Destruct explicitly, to check that the default dtor frees the heap field and resets it to nil
    sDestruct(s);
    printf("Is nullptr: %d\n", s.data == nil<heap int*>);
}
