// When a copy and a move overload of a ctor or assign operator coexist, a temporary argument selects the copy overload,
// because temporaries can only be bound to const reference parameters. The move overload must not raise an error then.

type Test struct {}

p Test.ctor() {
    printf("Constructed\n");
}

p Test.ctor(const Test& _) {
    printf("Copied\n");
}

p operator=(Test& _1, const Test& _2) {
    printf("Copy assigned\n");
}

p Test.ctor(Test& _) {
    printf("Moved\n");
}

p operator=(Test& _1, Test& _2) {
    printf("Move assigned\n");
}

p Test.dtor() {
    printf("Destructed\n");
}

f<int> main() {
    Test t;
    printf("Assign temporary\n");
    t = Test();
    printf("Construct from temporary\n");
    Test u = Test(Test());
    printf("Assign non-const lvalue\n");
    t = u;
    printf("Construct from non-const lvalue\n");
    Test v = Test(u);
    printf("End\n");
}
