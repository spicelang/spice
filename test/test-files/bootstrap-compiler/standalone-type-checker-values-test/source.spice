import "std/os/env";
import "std/io/filepath";
import "std/data/vector";
import "std/data/pair";
import "bootstrap/driver";
import "bootstrap/ast/ast-nodes";
import "bootstrap/global/global-resource-manager";
import "bootstrap/model/function";
import "bootstrap/model/struct";
import "bootstrap/source-file";
import "bootstrap/symboltablebuilder/qual-type";
import "bootstrap/symboltablebuilder/scope";
import "bootstrap/symboltablebuilder/super-type";
import "bootstrap/symboltablebuilder/symbol-table-entry";
import "bootstrap/typechecker/type-checker";
import "bootstrap/util/compiler-warning";
import "bootstrap/util/pass-test-util";

f<FilePath> getFixturePath() {
    Result<string> spiceStdDir = getEnv("SPICE_STD_DIR");
    String filePathString = spiceStdDir.unwrap() + "/../test/test-files/bootstrap-compiler/standalone-type-checker-values-test/test-file.spice";
    return FilePath(filePathString);
}

// Type of the symbol with the given name in the given scope. Fails the test if the symbol does not exist
f<QualType> typeOf(Scope* scope, string name) {
    SymbolTableEntry* entry = scope.lookupStrict(String(name));
    assert entry != nil<SymbolTableEntry*>;
    return entry.getQualType();
}

// Collect all nodes of the given kind in the subtree of the given node in pre-order
p collectNodes(ASTNode* node, ASTNodeKind kind, Vector<ASTNode*>& nodes) {
    if node.kind == kind {
        nodes.pushBack(node);
    }
    foreach ASTNode* child : node.children {
        collectNodes(child, kind, nodes);
    }
}

// Call data of the function call at the given index
f<FctCallData*> callDataAt(Vector<ASTNode*>& fctCalls, unsigned long index) {
    ASTFctCallNode* fctCall = downcast<ASTFctCallNode>(fctCalls.get(index));
    return &fctCall.data.get(0l);
}

// Name of the callee of the given call
f<String> calleeName(const FctCallData* data) {
    const Function* callee = data.callee;
    assert callee != nil<const Function*>;
    return callee.name;
}

f<int> main() {
    // -------------------------------------------------------------------------------------------------------------
    // Run the front end and the prepare stage of the type checker
    // -------------------------------------------------------------------------------------------------------------
    CliOptions cliOptions;
    setupPassTestOptions(cliOptions);
    GlobalResourceManager rm = GlobalResourceManager(cliOptions);
    SourceFile* file = rm.createSourceFile(nil<SourceFile*>, String("root"), getFixturePath(), false);
    file.runFrontEnd();
    TypeChecker typeChecker = TypeChecker(rm, file, TypeCheckerMode::TC_MODE_PRE);
    typeChecker.visit(file.ast);
    assert rm.errorManager.softErrors.isEmpty();
    Scope* root = file.getGlobalScope();

    // -------------------------------------------------------------------------------------------------------------
    // Type-check the body of main. The check stage of function definitions is not ported yet
    // -------------------------------------------------------------------------------------------------------------
    ASTEntryNode* entry = file.ast;
    ASTMainFctDefNode* mainFctDef = nil<ASTMainFctDefNode*>;
    foreach IVisitable* topLevelDef : entry.topLevelDefs {
        ASTNode* topLevelDefNode = getASTNode(topLevelDef);
        if topLevelDefNode.kind == ASTNodeKind::MAIN_FCT_DEF {
            mainFctDef = downcast<ASTMainFctDefNode>(topLevelDefNode);
        }
    }
    assert mainFctDef != nil<ASTMainFctDefNode*>;
    Scope* mainScope = mainFctDef.bodyScope;
    if mainScope == nil<Scope*> {
        foreach Pair<const String&, Scope*&> childEntry : root.children {
            Scope* child = childEntry.getSecond();
            if child.scopeType == ScopeType::FUNC_PROC_BODY && child.lookupStrict(String("holder")) != nil<SymbolTableEntry*> {
                mainScope = child;
            }
        }
    }
    assert mainScope != nil<Scope*>;
    typeChecker.currentScope = mainScope;

    ASTNode* bodyNode = getASTNode(mainFctDef.body);
    ASTStmtLstNode* body = downcast<ASTStmtLstNode>(bodyNode);
    typeChecker.visitStmtLst(body);
    // The lambdas leave their scopes again
    assert typeChecker.currentScope == mainScope;

    // -------------------------------------------------------------------------------------------------------------
    // Types of the declared variables
    // -------------------------------------------------------------------------------------------------------------
    const QualType sumType = typeOf(mainScope, "sum");
    assert sumType.is(SuperType::TY_INT);
    const QualType vecType = typeOf(mainScope, "vec");
    assert vecType.is(SuperType::TY_STRUCT);
    assert vecType.getSubType() == "Vec2";
    const QualType lenType = typeOf(mainScope, "len");
    assert lenType.is(SuperType::TY_INT);
    const QualType nestedSumType = typeOf(mainScope, "nestedSum");
    assert nestedSumType.is(SuperType::TY_INT);
    const QualType arrType = typeOf(mainScope, "arr");
    assert arrType.isArray();
    assert arrType.getArraySize() == 3u;
    const QualType ptType = typeOf(mainScope, "pt");
    assert ptType.is(SuperType::TY_STRUCT);
    assert ptType.getSubType() == "Point";
    const QualType doublerType = typeOf(mainScope, "doubler");
    assert doublerType.is(SuperType::TY_FUNCTION);
    const QualType doubledType = typeOf(mainScope, "doubled");
    assert doubledType.is(SuperType::TY_INT);
    const QualType incType = typeOf(mainScope, "inc");
    assert incType.is(SuperType::TY_FUNCTION);
    const QualType incrementerType = typeOf(mainScope, "incrementer");
    assert incrementerType.is(SuperType::TY_PROCEDURE);
    const QualType addRefType = typeOf(mainScope, "addRef");
    assert addRefType.is(SuperType::TY_FUNCTION);
    const QualType ptrType = typeOf(mainScope, "ptr");
    assert ptrType.isPtrTo(SuperType::TY_INT);

    // -------------------------------------------------------------------------------------------------------------
    // Function calls
    // -------------------------------------------------------------------------------------------------------------
    Vector<ASTNode*> fctCalls;
    collectNodes(bodyNode, ASTNodeKind::FCT_CALL, fctCalls);
    assert fctCalls.getSize() == 11l;
    // add(1, 2) is an ordinary call with an arg info per argument
    const FctCallData* addCall = callDataAt(fctCalls, 0l);
    assert addCall.isOrdinaryCall();
    assert calleeName(addCall) == "add";
    ASTFctCallNode* addCallNode = downcast<ASTFctCallNode>(fctCalls.get(0l));
    assert addCallNode.argLst.argInfos.getSize() == 2l;
    // log(sum) calls a procedure
    const FctCallData* logCall = callDataAt(fctCalls, 1l);
    const Function* logCallee = logCall.callee;
    assert logCallee.isProcedure();
    // Vec2(3, 4) calls the ctor
    const FctCallData* ctorCall = callDataAt(fctCalls, 3l);
    assert ctorCall.isCtorCall();
    assert calleeName(ctorCall) == "ctor";
    assert ctorCall.thisType.is(SuperType::TY_STRUCT);
    // vec.length() calls a method
    const FctCallData* methodCall = callDataAt(fctCalls, 4l);
    assert methodCall.isMethodCall();
    assert calleeName(methodCall) == "length";
    // holder.point.sum() calls a method of a field
    const FctCallData* nestedMethodCall = callDataAt(fctCalls, 5l);
    assert nestedMethodCall.isMethodCall();
    assert calleeName(nestedMethodCall) == "sum";
    assert nestedMethodCall.thisType.getSubType() == "Point";
    // doubler(4) and incrementer() call function pointers
    const FctCallData* doublerCall = callDataAt(fctCalls, 6l);
    assert doublerCall.isFctPtrCall();
    assert doublerCall.callee == nil<const Function*>;
    const FctCallData* incrementerCall = callDataAt(fctCalls, 7l);
    assert incrementerCall.isFctPtrCall();

    // Only the result of add(3, 4) is discarded
    unsigned long unusedReturnValueWarnings = 0l;
    foreach const CompilerWarning& warning : file.compilerOutput.warnings {
        if warning.warningMessage.contains("The return value of the function call is unused") {
            unusedReturnValueWarnings++;
        }
    }
    assert unusedReturnValueWarnings == 1l;

    // -------------------------------------------------------------------------------------------------------------
    // Array initialization, struct instantiation and lambdas
    // -------------------------------------------------------------------------------------------------------------
    Vector<ASTNode*> arrayInitializations;
    collectNodes(bodyNode, ASTNodeKind::ARRAY_INITIALIZATION, arrayInitializations);
    ASTArrayInitializationNode* arrayInitialization = downcast<ASTArrayInitializationNode>(arrayInitializations.get(0l));
    assert arrayInitialization.actualSize == 3l;

    Vector<ASTNode*> structInstantiations;
    collectNodes(bodyNode, ASTNodeKind::STRUCT_INSTANTIATION, structInstantiations);
    ASTStructInstantiationNode* structInstantiation = downcast<ASTStructInstantiationNode>(structInstantiations.get(0l));
    assert structInstantiation.instantiatedStructs.get(0l) != nil<Struct*>;
    const Vector<Function*>& fieldCopyCtors = structInstantiation.fieldCopyCtors.get(0l);
    assert fieldCopyCtors.getSize() == 2l;

    // The capturing lambda procedure has lambda captures, the lambda expression has none
    assert incrementerType.hasLambdaCaptures();
    assert !doublerType.hasLambdaCaptures();
    Vector<ASTNode*> lambdaFuncs;
    collectNodes(bodyNode, ASTNodeKind::LAMBDA_FUNC, lambdaFuncs);
    ASTLambdaBaseNode* incLambda = asLambdaBaseNode(lambdaFuncs.get(0l));
    const Function& incManifestation = incLambda.manifestations.get(0l);
    assert incManifestation.name.startsWith("lambda.");
    assert incManifestation.bodyScope == incLambda.bodyScope;
    assert incManifestation.mangleSuffix == ".0";

    // -------------------------------------------------------------------------------------------------------------
    // Invalid values
    // -------------------------------------------------------------------------------------------------------------
    assert rm.errorManager.softErrors.getSize() == 6l;
    assert softErrorContains(rm.errorManager, 0l, "Function/procedure/struct 'unknownFct' could not be found");
    assert softErrorContains(rm.errorManager, 1l, "Function/procedure 'add(int)' could not be found");
    assert softErrorContains(rm.errorManager, 2l, "All provided values have to be of the same data type. You provided int and double");
    assert softErrorContains(rm.errorManager, 3l, "You've passed too less/many field values. Pass either none or all of them");
    assert softErrorContains(rm.errorManager, 4l, "Expected and actual number of arguments do not match");
    assert softErrorContains(rm.errorManager, 5l, "Not all control paths of this lambda function have a return statement");

    printf("All assertions passed!\n");
}
