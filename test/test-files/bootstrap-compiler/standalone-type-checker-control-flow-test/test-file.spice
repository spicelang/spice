// Input program for the standalone type checker control flow test. The functions without trailing return statement after
// a non-exhaustive switch statement are invalid on purpose, the test checks the soft errors they produce.

type Fruit enum {
    APPLE,
    BANANA,
    ORANGE
}

// Valid: all cases return, but there is no default branch, so the trailing return statement is reachable
f<int> classify(int v) {
    switch v {
        case 1: { return 10; }
        case 2: { return 20; }
    }
    return 99;
}

// Valid: all cases and the default branch return, so the switch statement returns on all control paths
f<int> classifyWithDefault(int v) {
    switch v {
        case 1: { return 10; }
        default: { return 30; }
    }
}

// Valid: all enum items are covered, so the switch statement is exhaustive
f<string> getName(Fruit fruit) {
    switch fruit {
        case Fruit::APPLE: { return "Apple"; }
        case Fruit::BANANA, Fruit::ORANGE: { return "Other"; }
    }
}

// Invalid: no default branch, so the control flow continues after the switch statement if no case matches
f<int> classifyWithoutReturn(int v) {
    switch v {
        case 1: { return 10; }
        case 2: { return 20; }
    }
}

// Invalid: not all enum items are covered, so the switch statement is not exhaustive
f<string> getNameNotExhaustive(Fruit fruit) {
    switch fruit {
        case Fruit::APPLE: { return "Apple"; }
        case Fruit::BANANA: { return "Banana"; }
    }
}

f<int> main() {
    return classify(3);
}
