// Input program for the standalone type checker statements test. The test type-checks the body of main. The last statements
// are invalid on purpose, the test checks the soft errors they produce.

type Resource struct {
    int handle
}

p Resource.dtor() {}

f<int> main() {
    int a = 5;
    dyn inferred = 2.5;
    string s = "hello";
    bool flag = false;
    int[3] arr;
    Resource res;

    // Control structures
    if flag = true {
        a++;
    }
    if true {
        a--;
    } else {
        a = 0;
    }
    if a > 3 {
        a = 3;
    } else if a < 0 {
        a = 0;
    }
    while a < 10 {
        a++;
        if a == 5 {
            continue;
        }
        break;
    }
    do {
        a--;
    } while a > 0;
    for int i = 0; i < 3; i++ {
        a += i;
    }
    switch a {
        case 1, 2: {
            a++;
            fallthrough;
        }
        case 3: {
            a--;
        }
        default: {
            a = 0;
        }
    }
    unsafe {
        int* ptr = &a;
    }
    {
        int inner = 1;
        a += inner;
    }
    assert a >= 0;

    // Invalid statements
    break;
    fallthrough;
    assert a;
    while a {}
    switch s {
        case 1: {}
    }
    foreach int item : arr {}
    return a;
}
