import "std/os/env";
import "std/io/filepath";
import "std/data/vector";
import "std/bindings/llvm/llvm" as llvm;
import "bootstrap/driver";
import "bootstrap/lexer/lexer";
import "bootstrap/parser/parser";
import "bootstrap/ast/ast-nodes";
import "bootstrap/global/global-resource-manager";
import "bootstrap/reader/code-loc";
import "bootstrap/source-file";
import "bootstrap/symboltablebuilder/scope";
import "bootstrap/symboltablebuilder/symbol-table-builder";
import "bootstrap/symboltablebuilder/symbol-table-entry";
import "bootstrap/util/pass-test-util";

f<FilePath> getFixturePath() {
    Result<string> spiceStdDir = getEnv("SPICE_STD_DIR");
    String filePathString = spiceStdDir.unwrap() + "/../test/test-files/bootstrap-compiler/standalone-symbol-table-builder-test/test-file.spice";
    return FilePath(filePathString);
}

f<bool> registered(SourceFile& file, string name) {
    return file.exportedNameRegistry.contains(String(name));
}

// Scope of the given definition scope id below 'parent'. Fails the test if it does not exist
f<Scope*> childScope(Scope* parent, const String& scopeId, ScopeType expectedType) {
    Scope* child = parent.getChildScope(scopeId);
    assert child != nil<Scope*>;
    assert child.scopeType == expectedType;
    return child;
}

f<int> main() {
    // -------------------------------------------------------------------------------------------------------------
    // Parse the fixture. Every top level definition must land in its list of the entry node.
    // -------------------------------------------------------------------------------------------------------------
    Lexer lexer = Lexer(getFixturePath());
    Parser parser = Parser(lexer);
    ASTEntryNode* entry = parser.parse();
    assert entry != nil<ASTEntryNode*>;
    assert entry.modAttrs.getSize() == 0l;
    assert entry.importDefs.getSize() == 1l;
    assert entry.topLevelDefs.getSize() == 12l;

    ASTImportDefNode* importDef = nil<ASTImportDefNode*>;
    ASTInterfaceDefNode* shape = nil<ASTInterfaceDefNode*>;
    ASTStructDefNode* rect = nil<ASTStructDefNode*>;
    ASTProcDefNode* ctor = nil<ASTProcDefNode*>;
    ASTFctDefNode* area = nil<ASTFctDefNode*>;
    ASTEnumDefNode* colors = nil<ASTEnumDefNode*>;
    ASTGenericTypeDefNode* generic = nil<ASTGenericTypeDefNode*>;
    ASTAliasDefNode* lengthAlias = nil<ASTAliasDefNode*>;
    ASTGlobalVarDefNode* limit = nil<ASTGlobalVarDefNode*>;
    ASTExtDeclNode* extDecl = nil<ASTExtDeclNode*>;
    ASTFctDefNode* classify = nil<ASTFctDefNode*>;
    ASTFctDefNode* loops = nil<ASTFctDefNode*>;
    ASTMainFctDefNode* mainFct = nil<ASTMainFctDefNode*>;
    unsafe {
        importDef = cast<ASTImportDefNode*>(entry.importDefs.get(0l));
        shape = cast<ASTInterfaceDefNode*>(entry.topLevelDefs.get(0l));
        rect = cast<ASTStructDefNode*>(entry.topLevelDefs.get(1l));
        ctor = cast<ASTProcDefNode*>(entry.topLevelDefs.get(2l));
        area = cast<ASTFctDefNode*>(entry.topLevelDefs.get(3l));
        colors = cast<ASTEnumDefNode*>(entry.topLevelDefs.get(4l));
        generic = cast<ASTGenericTypeDefNode*>(entry.topLevelDefs.get(5l));
        lengthAlias = cast<ASTAliasDefNode*>(entry.topLevelDefs.get(6l));
        limit = cast<ASTGlobalVarDefNode*>(entry.topLevelDefs.get(7l));
        extDecl = cast<ASTExtDeclNode*>(entry.topLevelDefs.get(8l));
        classify = cast<ASTFctDefNode*>(entry.topLevelDefs.get(9l));
        loops = cast<ASTFctDefNode*>(entry.topLevelDefs.get(10l));
        mainFct = cast<ASTMainFctDefNode*>(entry.topLevelDefs.get(11l));
    }

    // The parser captured the data the builder works with
    assert importDef.importPath == "std/io";
    assert shape.interfaceName == "Shape";
    assert shape.signatures.getSize() == 2l;
    assert rect.structName == "Rectangle";
    assert rect.hasInterfaces;
    assert rect.interfaceTypeLst.dataTypes.getSize() == 1l;
    assert rect.fields.getSize() == 2l;
    assert ctor.isMethod;
    assert ctor.name.name == "ctor";
    assert ctor.name.structName == "Rectangle";
    assert ctor.hasParams;
    assert area.isMethod;
    assert area.name.name == "area";
    assert !area.hasParams;
    assert colors.enumName == "Color";
    assert generic.typeName == "T";
    assert lengthAlias.aliasName == "Length";
    assert limit.varName == "LIMIT";
    assert extDecl.extFunctionName == "strlen";
    assert extDecl.hasReturnType;
    assert classify.name.name == "classify";
    assert !classify.isMethod;
    assert loops.name.name == "loops";

    // -------------------------------------------------------------------------------------------------------------
    // Build the symbol table.
    // -------------------------------------------------------------------------------------------------------------
    CliOptions cliOptions;
    setupPassTestOptions(cliOptions);
    GlobalResourceManager rm = GlobalResourceManager(cliOptions);
    SourceFile file = SourceFile(rm, nil<SourceFile*>, String("root"), FilePath("/tmp/mock-main.spice"), false);
    Scope* root = createTestGlobalScope(file);
    SymbolTableBuilder builder = SymbolTableBuilder(rm, &file);
    builder.visit(entry);

    // Everything was accepted, including the main function every executable needs
    assert rm.errorManager.softErrors.getSize() == 0l;

    // Every definition got a symbol in the root scope, and it is the one the AST node points to
    assert root.lookupStrict(String("Shape")) == shape.entry;
    assert root.lookupStrict(String("Rectangle")) == rect.entry;
    assert root.lookupStrict(String("Color")) == colors.entry;
    assert root.lookupStrict(String("T")) == generic.entry;
    assert root.lookupStrict(String("Length")) == lengthAlias.entry;
    assert root.lookupStrict(String("Length.container")) == lengthAlias.aliasedTypeContainerEntry;
    assert root.lookupStrict(String("LIMIT")) == limit.entry;
    assert root.lookupStrict(String("strlen")) == extDecl.entry;
    assert root.lookupStrict(String("classify:") + classify.codeLoc.toString()) == classify.entry;
    assert root.lookupStrict(String("loops:") + loops.codeLoc.toString()) == loops.entry;
    assert root.lookupStrict(String("main")) != nil<SymbolTableEntry*>;
    assert generic.entry.used;

    // Exported names: every definition except generic types (only usable within the file) and the main function
    assert registered(file, "Shape");
    assert registered(file, "Rectangle");
    assert registered(file, "Color");
    assert registered(file, "Length");
    assert registered(file, "LIMIT");
    assert registered(file, "strlen");
    assert registered(file, "classify");
    assert registered(file, "loops");
    assert registered(file, "Color::RED");
    assert registered(file, "Color::GREEN");
    assert registered(file, "Color::BLUE");
    assert !registered(file, "T");
    assert !registered(file, "main");

    // The root scope holds one child per definition with a body: interface, struct, enum, external function, two
    // functions and main. Methods live in the scope of their struct, not in the root scope.
    assert root.children.getSize() == 7l;

    // Interface: one symbol per signature (keyed with the code location to allow overloading)
    Scope* shapeScope = childScope(root, String("interface:Shape"), ScopeType::INTERFACE);
    assert shape.interfaceScope == shapeScope;
    assert shapeScope.symbolTable.symbols.getSize() == 2l;

    // Struct: fields, the implicit field for the implemented interface and one child scope per method
    Scope* rectScope = childScope(root, String("struct:Rectangle"), ScopeType::STRUCT);
    assert rect.structScope == rectScope;
    assert rectScope.lookupStrict(String("width")) != nil<SymbolTableEntry*>;
    assert rectScope.lookupStrict(String("height")) != nil<SymbolTableEntry*>;
    SymbolTableEntry* interfaceField = rectScope.lookupStrict(String("this.Shape"));
    assert interfaceField != nil<SymbolTableEntry*>;
    assert interfaceField.isImplicitField;
    assert interfaceField.used;
    assert rectScope.children.getSize() == 2l;
    assert ctor.structScope == rectScope;
    assert ctor.isCtor;
    assert !area.isMethod || area.structScope == rectScope;
    Scope* ctorScope = childScope(rectScope, ctor.getScopeId(), ScopeType::FUNC_PROC_BODY);
    assert ctor.scope == ctorScope;
    assert ctorScope.lookupStrict(String("this")) != nil<SymbolTableEntry*>;
    assert ctorScope.lookupStrict(String("width")).isParam;
    assert ctorScope.lookupStrict(String("height")).isParam;
    assert ctorScope.lookupStrict(String("result")) == nil<SymbolTableEntry*>; // procedures return nothing
    assert !ctorScope.isDtorScope;
    Scope* areaScope = childScope(rectScope, area.getScopeId(), ScopeType::FUNC_PROC_BODY);
    assert areaScope.lookupStrict(String("this")) != nil<SymbolTableEntry*>;
    assert areaScope.lookupStrict(String("result")) != nil<SymbolTableEntry*>;
    // Both methods are symbols of the struct scope
    assert rectScope.lookupStrict(String("ctor:") + ctor.codeLoc.toString()) == ctor.entry;
    assert rectScope.lookupStrict(String("area:") + area.codeLoc.toString()) == area.entry;

    // Enum: one symbol per item in the enum scope
    Scope* colorScope = childScope(root, String("enum:Color"), ScopeType::ENUM);
    assert colorScope.lookupStrict(String("RED")) != nil<SymbolTableEntry*>;
    assert colorScope.lookupStrict(String("GREEN")) != nil<SymbolTableEntry*>;
    assert colorScope.lookupStrict(String("BLUE")) != nil<SymbolTableEntry*>;

    // if / else if / else: three branch scopes below the function scope. Each condition and the ternary of the else
    // branch get expression scopes of their own
    Scope* classifyScope = childScope(root, classify.getScopeId(), ScopeType::FUNC_PROC_BODY);
    assert classifyScope.lookupStrict(String("n")).isParam;
    assert classifyScope.lookupStrict(String("result")) != nil<SymbolTableEntry*>;
    assert classifyScope.children.getSize() == 3l;
    Scope* thenScope = nil<Scope*>;
    Scope* elseIfScope = nil<Scope*>;
    Scope* elseScope = nil<Scope*>;
    foreach dyn scopeEntry : classifyScope.children {
        Scope* branchScope = scopeEntry.getSecond();
        assert branchScope.scopeType == ScopeType::IF_ELSE_BODY;
        if branchScope.lookupStrict(String("big")) != nil<SymbolTableEntry*> {
            elseScope = branchScope;
        } else if branchScope.children.getSize() == 1l && thenScope == nil<Scope*> {
            thenScope = branchScope;
        } else {
            elseIfScope = branchScope;
        }
    }
    assert elseScope != nil<Scope*>;
    assert elseScope.children.getSize() == 2l; // ternary: true and false branch
    foreach dyn exprEntry : elseScope.children {
        Scope* ternaryScope = exprEntry.getSecond();
        assert ternaryScope.scopeType == ScopeType::EXPR_BODY;
    }
    assert thenScope != nil<Scope*>;
    assert elseIfScope != nil<Scope*>;
    assert thenScope.children.getSize() == 1l; // condition
    assert elseIfScope.children.getSize() == 1l; // condition

    // for / while / do-while: a body scope each, with an expression scope for the condition
    Scope* loopsScope = childScope(root, loops.getScopeId(), ScopeType::FUNC_PROC_BODY);
    assert loopsScope.lookupStrict(String("acc")) != nil<SymbolTableEntry*>;
    assert loopsScope.children.getSize() == 3l;
    long forScopes = 0l;
    long whileScopes = 0l;
    foreach dyn scopeEntry : loopsScope.children {
        Scope* loopScope = scopeEntry.getSecond();
        assert loopScope.children.getSize() == 1l;
        if loopScope.scopeType == ScopeType::FOR_BODY {
            forScopes++;
            assert loopScope.lookupStrict(String("i")) != nil<SymbolTableEntry*>; // the loop variable
        } else {
            assert loopScope.scopeType == ScopeType::WHILE_BODY;
            whileScopes++;
        }
    }
    assert forScopes == 1l;
    assert whileScopes == 2l;

    // main: 'result' is declared and used implicitly. The unsafe block gets a scope, and so do the operands of the
    // short-circuiting '&&' and '||' that are not evaluated unconditionally
    Scope* mainScope = childScope(root, String("fct:main"), ScopeType::FUNC_PROC_BODY);
    assert mainFct.bodyScope == mainScope;
    assert mainScope.lookupStrict(String("result")).used;
    assert mainScope.lookupStrict(String("rect")) != nil<SymbolTableEntry*>;
    assert mainScope.lookupStrict(String("ok")) != nil<SymbolTableEntry*>;
    assert mainScope.children.getSize() == 3l;
    long unsafeScopes = 0l;
    long exprScopes = 0l;
    foreach dyn scopeEntry : mainScope.children {
        Scope* childOfMain = scopeEntry.getSecond();
        if childOfMain.scopeType == ScopeType::UNSAFE_BODY {
            unsafeScopes++;
            assert childOfMain.lookupStrict(String("raw")) != nil<SymbolTableEntry*>;
        } else {
            assert childOfMain.scopeType == ScopeType::EXPR_BODY;
            exprScopes++;
        }
    }
    assert unsafeScopes == 1l;
    assert exprScopes == 2l;

    // Every scope was left again
    assert builder.currentScope == root;

    printf("All assertions passed!\n");
}
