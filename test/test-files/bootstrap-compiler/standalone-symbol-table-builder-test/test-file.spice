// Input program for the standalone symbol table builder test. It contains every kind of top level definition and
// the statements/expressions that create scopes of their own (branches, loops, blocks, conditions, ternaries and
// short-circuiting operands).

import "std/io";

type Shape interface {
    f<int> area();
    p scale(int);
}

type Rectangle struct : Shape {
    int width
    int height
}

p Rectangle.ctor(int width, int height) {
    this.width = width;
    this.height = height;
}

f<int> Rectangle.area() {
    return this.width * this.height;
}

type Color enum {
    RED,
    GREEN = 5,
    BLUE
}

type T dyn;
type Length alias int;

const int LIMIT = 10;

ext f<int> strlen(string);

f<int> classify(int n) {
    if n < 0 {
        return -1;
    } else if n == 0 {
        return 0;
    } else {
        int big = n > LIMIT ? 1 : 2;
        return big;
    }
}

f<int> loops(int n) {
    int acc = 0;
    for int i = 0; i < n; i++ {
        acc += i;
    }
    while acc > 100 {
        acc -= 1;
    }
    do {
        acc++;
    } while acc < 5;
    return acc;
}

f<int> main() {
    Rectangle rect = Rectangle(2, 3);
    bool ok = rect.area() > 1 && LIMIT > 0 || false;
    unsafe {
        int raw = 1;
    }
    return classify(rect.area());
}
