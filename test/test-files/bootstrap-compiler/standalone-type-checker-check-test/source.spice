import "std/os/env";
import "std/io/filepath";
import "std/data/vector";
import "std/data/pair";
import "bootstrap/driver";
import "bootstrap/ast/ast-nodes";
import "bootstrap/global/global-resource-manager";
import "bootstrap/model/function";
import "bootstrap/model/struct";
import "bootstrap/source-file";
import "bootstrap/symboltablebuilder/lifecycle";
import "bootstrap/symboltablebuilder/qual-type";
import "bootstrap/symboltablebuilder/scope";
import "bootstrap/symboltablebuilder/super-type";
import "bootstrap/symboltablebuilder/symbol-table-entry";
import "bootstrap/typechecker/function-manager";
import "bootstrap/typechecker/type-checker";
import "bootstrap/util/pass-test-util";

f<FilePath> getFixturePath() {
    Result<string> spiceStdDir = getEnv("SPICE_STD_DIR");
    String filePathString = spiceStdDir.unwrap() + "/../test/test-files/bootstrap-compiler/standalone-type-checker-check-test/test-file.spice";
    return FilePath(filePathString);
}

// Whether the given scope contains a symbol with the given name
f<bool> hasSymbol(Scope* scope, string name) {
    return scope.lookupStrict(String(name)) != nil<SymbolTableEntry*>;
}

// Struct scope with the given name. Fails the test if the scope does not exist
f<Scope*> structScopeOf(Scope* root, string scopeName) {
    Scope* structScope = root.getChildScope(String(scopeName));
    assert structScope != nil<Scope*>;
    return structScope;
}

// Struct manifestation of the struct with the given name. Fails the test if the struct does not exist
f<Struct*> structOf(Scope* root, string name) {
    SymbolTableEntry* entry = root.lookupStrict(String(name));
    assert entry != nil<SymbolTableEntry*>;
    const QualType structType = entry.getQualType();
    Struct* spiceStruct = structType.getStruct(cast<ASTNode*>(entry.declNode));
    assert spiceStruct != nil<Struct*>;
    return spiceStruct;
}

f<int> main() {
    // -------------------------------------------------------------------------------------------------------------
    // Run the front end, the prepare stage and the check stage of the type checker like SourceFile.runMiddleEnd
    // -------------------------------------------------------------------------------------------------------------
    CliOptions cliOptions;
    setupPassTestOptions(cliOptions);
    GlobalResourceManager rm = GlobalResourceManager(cliOptions);
    SourceFile* file = rm.createSourceFile(nil<SourceFile*>, String("root"), getFixturePath(), false);
    file.runFrontEnd();
    assert rm.errorManager.softErrors.isEmpty();
    {
        DefaultMemberCreationSection defaultMemberCreationSection;
        assert STRUCT_DEFAULT_MEMBERS_DECIDABLE;

        TypeChecker typeCheckerPre = TypeChecker(rm, file, TypeCheckerMode::TC_MODE_PRE);
        typeCheckerPre.visit(file.ast);
        assert rm.errorManager.softErrors.isEmpty();
        file.previousStage = CompileStageType::TYPE_CHECKER_PRE;

        TypeChecker typeCheckerPost = TypeChecker(rm, file, TypeCheckerMode::TC_MODE_POST);
        unsigned int typeCheckerRuns = 0;
        while file.reVisitRequested {
            typeCheckerRuns++;
            assert typeCheckerRuns < 10;
            file.reVisitRequested = false;
            typeCheckerPost.visit(file.ast);
        }
        assert typeCheckerPost.currentScope == file.getGlobalScope();
    }
    assert !STRUCT_DEFAULT_MEMBERS_DECIDABLE;
    assert rm.errorManager.softErrors.isEmpty();
    assert rm.pendingStructDefaultMemberDecisions.isEmpty();
    Scope* root = file.getGlobalScope();

    // -------------------------------------------------------------------------------------------------------------
    // Implicit default members (same symbols as the host compiler creates for the fixture)
    // -------------------------------------------------------------------------------------------------------------
    // Inner: default ctor for the field default value, user-defined dtor
    Scope* innerScope = structScopeOf(root, "struct:Inner");
    assert hasSymbol(innerScope, "default_ctor:L10C1");
    assert !hasSymbol(innerScope, "default_copyctor:L10C1");
    assert !hasSymbol(innerScope, "default_dtor:L10C1");
    assert hasSymbol(innerScope, "dtor:L14C1");
    // Outer: default ctor to construct Inner, default dtor to destruct Inner
    Scope* outerScope = structScopeOf(root, "struct:Outer");
    assert hasSymbol(outerScope, "default_ctor:L17C1");
    assert !hasSymbol(outerScope, "default_copyctor:L17C1");
    assert hasSymbol(outerScope, "default_dtor:L17C1");
    // Square: user-defined ctor, default copy ctor because it emits a vtable
    Scope* squareScope = structScopeOf(root, "struct:Square");
    assert !hasSymbol(squareScope, "default_ctor:L23C1");
    assert hasSymbol(squareScope, "default_copyctor:L23C1");
    assert !hasSymbol(squareScope, "default_dtor:L23C1");
    // Box<Inner>: decided on when it got substantiated while checking main. The generic preset gets no default members
    Scope* boxInnerScope = structScopeOf(root, "struct:Box<Inner>");
    assert hasSymbol(boxInnerScope, "default_ctor:L38C1");
    assert hasSymbol(boxInnerScope, "default_dtor:L38C1");
    Scope* boxScope = structScopeOf(root, "struct:Box");
    assert !hasSymbol(boxScope, "default_ctor:L38C1");
    assert !hasSymbol(boxScope, "default_dtor:L38C1");

    // All manifestations have decided their default members, incl. the one that was substantiated later on
    ASTEntryNode* entry = file.ast;
    ASTStructDefNode* boxDef = nil<ASTStructDefNode*>;
    foreach IVisitable* topLevelDef : entry.topLevelDefs {
        ASTNode* topLevelDefNode = getASTNode(topLevelDef);
        if topLevelDefNode.kind == ASTNodeKind::STRUCT_DEF {
            ASTStructDefNode* structDef = downcast<ASTStructDefNode>(topLevelDefNode);
            foreach Struct* manifestation : structDef.structManifestations {
                assert manifestation.structBase.implicitDefaultMembersDecided;
            }
            if structDef.structName == "Box" {
                boxDef = structDef;
            }
        }
    }
    assert boxDef != nil<ASTStructDefNode*>;
    assert boxDef.structManifestations.getSize() == 2l; // Generic preset + Box<Inner>

    // The default ctor of Outer is a compiler-generated default member and its body preamble initialized all fields
    Struct* outer = structOf(root, "Outer");
    const QualType outerType = outer.structBase.entry.getQualType();
    const ArgList noArgs;
    const Function* outerCtor = lookupFunction(outerScope, String("ctor"), outerType, noArgs, true);
    assert outerCtor != nil<const Function*>;
    assert outerCtor.implicitDefault;
    // The fields are reset to the declared state after the struct was checked
    assert outer.areAllFieldsInState(LifecycleState::DECLARED) == nil<SymbolTableEntry*>;

    // -------------------------------------------------------------------------------------------------------------
    // Interface implementation
    // -------------------------------------------------------------------------------------------------------------
    Struct* square = structOf(root, "Square");
    const QualType squareType = square.structBase.entry.getQualType();
    const Function* area = lookupFunction(squareScope, String("area"), squareType, noArgs, true);
    assert area != nil<const Function*>;
    assert area.isVirtual;
    assert area.vtableIndex == 0l;
    assert area.alreadyTypeChecked;

    // -------------------------------------------------------------------------------------------------------------
    // Function bodies
    // -------------------------------------------------------------------------------------------------------------
    // Only the substantiated manifestation of identity<T> gets checked
    unsigned int checkedIdentityManifestations = 0;
    foreach IVisitable* topLevelDef : entry.topLevelDefs {
        ASTNode* topLevelDefNode = getASTNode(topLevelDef);
        if topLevelDefNode.kind == ASTNodeKind::FCT_DEF {
            ASTFctDefNode* fctDef = downcast<ASTFctDefNode>(topLevelDefNode);
            if fctDef.node.name.name == "identity" {
                foreach const Function* manifestation : fctDef.node.manifestations {
                    assert manifestation.alreadyTypeChecked == manifestation.isFullySubstantiated();
                    if manifestation.alreadyTypeChecked {
                        checkedIdentityManifestations++;
                    }
                }
            }
        }
    }
    assert checkedIdentityManifestations == 1;

    // The body of main was checked. At its end, the dtors of box and outer get called in reverse declaration order
    ASTMainFctDefNode* mainFctDef = nil<ASTMainFctDefNode*>;
    foreach IVisitable* topLevelDef : entry.topLevelDefs {
        ASTNode* topLevelDefNode = getASTNode(topLevelDef);
        if topLevelDefNode.kind == ASTNodeKind::MAIN_FCT_DEF {
            mainFctDef = downcast<ASTMainFctDefNode>(topLevelDefNode);
        }
    }
    assert mainFctDef != nil<ASTMainFctDefNode*>;
    SymbolTableEntry* bEntry = mainFctDef.bodyScope.lookupStrict(String("b"));
    assert bEntry != nil<SymbolTableEntry*>;
    const QualType bType = bEntry.getQualType();
    assert bType.is(SuperType::TY_INT);
    ASTStmtLstNode* body = downcast<ASTStmtLstNode>(getASTNode(mainFctDef.body));
    const ResourcesForManifestationToCleanup& resources = body.resourcesToCleanup.get(0l);
    assert resources.dtorFunctionsToCall.getSize() == 2l;
    const Pair<SymbolTableEntry*, Function*>& boxDtorCall = resources.dtorFunctionsToCall.get(0l);
    const SymbolTableEntry* boxEntry = boxDtorCall.getFirst();
    assert boxEntry.name == "box";
    const Function* boxDtor = boxDtorCall.getSecond();
    assert boxDtor.implicitDefault;
    const Pair<SymbolTableEntry*, Function*>& outerDtorCall = resources.dtorFunctionsToCall.get(1l);
    const SymbolTableEntry* outerEntry = outerDtorCall.getFirst();
    assert outerEntry.name == "outer";
    const Function* outerDtor = outerDtorCall.getSecond();
    assert outerDtor.implicitDefault;

    printf("All assertions passed!\n");
}
