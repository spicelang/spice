// Input program for the standalone type checker test (builtin functions). Each builtin call is invalid and produces a soft
// error in the type checker.

type Pos struct {
    int x
}

f<int> main() {
    Pos pos;
    printf("%d\n", "text");
    printf("%d %d\n", 1);
    printf("%d\n", 1, 2);
    const long sizeOfBoth = sizeof<int>(1);
    const long lenOfInt = len(1);
    const bool sameOne = __is_same<int>();
    const long line = __source_line(1);
    const long offset = __offsetof(pos, 1);
    const int buildVar = __get_build_var<int>("BOOTSTRAP_BUILTINS_TEST_MISSING_VAR");
    const int invalidBuildVar = __get_build_var<int>("BOOTSTRAP_BUILTINS_TEST_INVALID_VAR");
    return 0;
}
