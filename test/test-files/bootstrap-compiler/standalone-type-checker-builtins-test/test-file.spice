// Input program for the standalone type checker test (builtin functions). Each builtin call, whose result is known at
// compile time, gets assigned to a variable. The test checks the compile time values, that the type checker computed.

type Inner struct {
    short a
    long b
}

type Outer struct {
    byte c
    Inner inner
    int d
}

#[core.compiler.packed=true]
type Packed struct {
    byte a
    long b
}

type Number union {
    int integer = 1
    double floating
}

type Shape interface {
    f<int> area();
}

type Square struct : Shape {
    int side
}

f<int> Square.area() {
    return this.side * this.side;
}

f<int> main() {
    Outer outer;
    int[5] numbers = [1, 2, 3, 4, 5];
    const long sizeOfOuter = sizeof<Outer>();
    const long sizeOfOuterValue = sizeof(outer);
    const long sizeOfPacked = sizeof<Packed>();
    const long sizeOfNumber = sizeof<Number>();
    const long sizeOfString = sizeof<string>();
    const long sizeOfLambda = sizeof<f<int>(int)>();
    const long alignOfInner = alignof<Inner>();
    const long alignOfShort = alignof<short>();
    const long offsetOfInner = __offsetof(outer, outer.inner);
    const long offsetOfInnerB = __offsetof(outer, outer.inner.b);
    const long offsetOfD = __offsetof(outer, outer.d);
    const long lenOfNumbers = len(numbers);
    const string nameOfOuter = typename<Outer>();
    const string nameOfInt = typename(numbers);
    const bool sameInts = __is_same<int, int>();
    const bool sameIntLong = __is_same<int, long>();
    const bool squareImplementsShape = __implements_interface<Shape, Square>();
    const bool outerImplementsShape = __implements_interface<Shape, Outer>();
    const bool innerTriviallyCopyable = __is_trivially_copyable<Inner>();
    const bool heapPtr = __is_heap<heap byte*>();
    const bool nonHeapPtr = __is_heap<byte*>();
    const long sourceLine = __source_line();
    const long sourceColumn = __source_column();
    const int buildVar = __get_build_var<int>("BOOTSTRAP_BUILTINS_TEST_VAR", 42);
    const bool newIsSet = __new<Inner>() != nil<Inner*>;
    printf("%d %s %04.2f %%\n", sizeOfOuter, nameOfOuter, 1.5);
    return 0;
}
