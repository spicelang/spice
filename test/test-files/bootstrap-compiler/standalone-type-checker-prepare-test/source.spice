import "std/os/env";
import "std/io/filepath";
import "std/data/vector";
import "bootstrap/driver";
import "bootstrap/ast/ast-nodes";
import "bootstrap/global/global-resource-manager";
import "bootstrap/global/runtime-module-manager";
import "bootstrap/model/function";
import "bootstrap/model/generic-type";
import "bootstrap/model/interface";
import "bootstrap/model/struct";
import "bootstrap/source-file";
import "bootstrap/symboltablebuilder/qual-type";
import "bootstrap/symboltablebuilder/scope";
import "bootstrap/symboltablebuilder/super-type";
import "bootstrap/symboltablebuilder/symbol-table-entry";
import "bootstrap/typechecker/type-checker";
import "bootstrap/util/compiler-warning";
import "bootstrap/util/pass-test-util";

f<FilePath> getFixturePath() {
    Result<string> spiceStdDir = getEnv("SPICE_STD_DIR");
    String filePathString = spiceStdDir.unwrap() + "/../test/test-files/bootstrap-compiler/standalone-type-checker-prepare-test/test-file.spice";
    return FilePath(filePathString);
}

// Type of the symbol with the given name in the given scope. Fails the test if the symbol does not exist
f<QualType> typeOf(Scope* scope, string name) {
    SymbolTableEntry* entry = scope.lookupStrict(String(name));
    assert entry != nil<SymbolTableEntry*>;
    return entry.getQualType();
}

f<int> main() {
    // -------------------------------------------------------------------------------------------------------------
    // Run the front end (parser, import collector, symbol table builder) and the prepare stage of the type checker
    // -------------------------------------------------------------------------------------------------------------
    CliOptions cliOptions;
    setupPassTestOptions(cliOptions);
    GlobalResourceManager rm = GlobalResourceManager(cliOptions);
    SourceFile file = SourceFile(rm, nil<SourceFile*>, String("root"), getFixturePath(), false);
    file.runFrontEnd();
    assert rm.errorManager.softErrors.isEmpty();

    TypeChecker typeChecker = TypeChecker(rm, &file, TypeCheckerMode::TC_MODE_PRE);
    typeChecker.visit(file.ast);
    assert rm.errorManager.softErrors.isEmpty();
    Scope* root = file.getGlobalScope();
    assert typeChecker.currentScope == root;

    ASTEntryNode* entry = file.ast;
    assert entry.topLevelDefs.getSize() == 20l;
    ASTInterfaceDefNode* shape = nil<ASTInterfaceDefNode*>;
    ASTStructDefNode* rect = nil<ASTStructDefNode*>;
    ASTProcDefNode* ctor = nil<ASTProcDefNode*>;
    ASTFctDefNode* area = nil<ASTFctDefNode*>;
    ASTStructDefNode* box = nil<ASTStructDefNode*>;
    ASTEnumDefNode* color = nil<ASTEnumDefNode*>;
    ASTAliasDefNode* length = nil<ASTAliasDefNode*>;
    ASTExtDeclNode* strlenDecl = nil<ASTExtDeclNode*>;
    ASTExtDeclNode* printfDecl = nil<ASTExtDeclNode*>;
    ASTFctDefNode* identity = nil<ASTFctDefNode*>;
    ASTFctDefNode* measure = nil<ASTFctDefNode*>;
    ASTFctDefNode* sumBox = nil<ASTFctDefNode*>;
    unsafe {
        shape = cast<ASTInterfaceDefNode*>(entry.topLevelDefs.get(0l));
        rect = cast<ASTStructDefNode*>(entry.topLevelDefs.get(1l));
        ctor = cast<ASTProcDefNode*>(entry.topLevelDefs.get(2l));
        area = cast<ASTFctDefNode*>(entry.topLevelDefs.get(3l));
        box = cast<ASTStructDefNode*>(entry.topLevelDefs.get(8l));
        color = cast<ASTEnumDefNode*>(entry.topLevelDefs.get(9l));
        length = cast<ASTAliasDefNode*>(entry.topLevelDefs.get(10l));
        strlenDecl = cast<ASTExtDeclNode*>(entry.topLevelDefs.get(13l));
        printfDecl = cast<ASTExtDeclNode*>(entry.topLevelDefs.get(14l));
        identity = cast<ASTFctDefNode*>(entry.topLevelDefs.get(15l));
        measure = cast<ASTFctDefNode*>(entry.topLevelDefs.get(16l));
        sumBox = cast<ASTFctDefNode*>(entry.topLevelDefs.get(18l));
    }

    // -------------------------------------------------------------------------------------------------------------
    // Interface
    // -------------------------------------------------------------------------------------------------------------
    const QualType shapeType = typeOf(root, "Shape");
    assert shapeType.is(SuperType::TY_INTERFACE);
    assert shapeType.getSubType() == "Shape";
    assert shape.interfaceManifestations.getSize() == 1l;
    Interface* shapeInterface = shape.interfaceManifestations.front();
    assert shapeInterface.methods.getSize() == 2l;
    for unsigned long i = 0l; i < 2l; i++ {
        Function* method = shapeInterface.methods.get(i);
        assert method.isVirtual;
        assert method.vtableIndex == i;
        assert method.thisType == shapeType;
    }
    Function* areaSignature = shapeInterface.methods.get(0l);
    assert areaSignature.name == "area";
    assert areaSignature.returnType.is(SuperType::TY_INT);
    Function* scaleSignature = shapeInterface.methods.get(1l);
    assert scaleSignature.name == "scale";
    assert scaleSignature.paramList.getSize() == 1l;
    // Interfaces always require the RTTI runtime
    assert file.isRuntimeModuleAvailable(RuntimeModule::RTTI_RT);

    // -------------------------------------------------------------------------------------------------------------
    // Struct with fields, implementing the interface
    // -------------------------------------------------------------------------------------------------------------
    const QualType rectType = typeOf(root, "Rectangle");
    assert rectType.is(SuperType::TY_STRUCT);
    assert rectType.getBodyScope() == rect.structScope;
    assert rect.emitVTable;
    assert rect.structManifestations.getSize() == 1l;
    Struct* rectStruct = rect.structManifestations.front();
    assert rectStruct.fieldTypes.getSize() == 3l;
    assert rectStruct.interfaceTypes.getSize() == 1l;
    assert rectStruct.interfaceTypes.front() == shapeType;
    const QualType widthType = typeOf(rect.structScope, "width");
    assert widthType.is(SuperType::TY_INT);
    const QualType heightType = typeOf(rect.structScope, "height");
    assert heightType.is(SuperType::TY_LONG);
    assert heightType.isUnsigned();
    const QualType nextType = typeOf(rect.structScope, "next");
    assert nextType.isPtrTo(SuperType::TY_STRUCT);
    const QualType interfaceFieldType = typeOf(rect.structScope, "this.Shape");
    assert interfaceFieldType == shapeType;

    // -------------------------------------------------------------------------------------------------------------
    // Methods
    // -------------------------------------------------------------------------------------------------------------
    assert ctor.manifestations.getSize() == 1l;
    Function* ctorFct = ctor.manifestations.front();
    assert ctorFct.name == "ctor";
    assert ctorFct.thisType == rectType;
    assert ctorFct.paramList.getSize() == 2l;
    assert ctorFct.returnType.is(SuperType::TY_DYN);
    const QualType ctorThisType = typeOf(ctor.scope, "this");
    assert ctorThisType.isPtrTo(SuperType::TY_STRUCT);
    // The body scope was renamed to the scope name of the manifestation
    assert ctorFct.bodyScope == ctor.scope;
    assert rect.structScope.getChildScope(ctorFct.getScopeName()) == ctor.scope;

    assert area.manifestations.getSize() == 1l;
    Function* areaFct = area.manifestations.front();
    assert areaFct.returnType.is(SuperType::TY_INT);
    assert areaFct.thisType == rectType;
    const QualType areaResultType = typeOf(area.scope, "result");
    assert areaResultType.is(SuperType::TY_INVALID); // The check stage sets the type of the result variable

    // -------------------------------------------------------------------------------------------------------------
    // Generic types and generic struct
    // -------------------------------------------------------------------------------------------------------------
    assert root.lookupGenericTypeStrict(String("T")) != nil<GenericType*>;
    assert root.lookupGenericTypeStrict(String("Number")) != nil<GenericType*>;
    assert root.lookupGenericTypeStrict(String("Single")) != nil<GenericType*>;
    unsigned long singleConditionWarnings = 0l;
    foreach const CompilerWarning& warning : file.compilerOutput.warnings {
        if warning.warningMessage.contains("Generic type is locked to one type") {
            singleConditionWarnings++;
        }
    }
    assert singleConditionWarnings == 1l;

    const QualType boxType = typeOf(root, "Box");
    assert boxType.is(SuperType::TY_STRUCT);
    const QualTypeList boxTemplateTypes = boxType.getTemplateTypes();
    assert boxTemplateTypes.getSize() == 1l;
    const QualType& boxTemplateType = boxTemplateTypes.front();
    assert boxTemplateType.is(SuperType::TY_GENERIC);
    assert box.structManifestations.getSize() == 1l;
    const QualType valueType = typeOf(box.structScope, "value");
    assert valueType.is(SuperType::TY_GENERIC);
    const QualType slotsType = typeOf(box.structScope, "slots");
    assert slotsType.isArrayOf(SuperType::TY_INT);
    assert slotsType.getArraySize() == 4u;
    assert !box.emitVTable;

    // -------------------------------------------------------------------------------------------------------------
    // Enum, alias and globals
    // -------------------------------------------------------------------------------------------------------------
    const QualType colorType = typeOf(root, "Color");
    assert colorType.is(SuperType::TY_ENUM);
    ASTEnumItemLstNode* colorItems = nil<ASTEnumItemLstNode*>;
    unsafe {
        colorItems = cast<ASTEnumItemLstNode*>(color.itemLst);
    }
    assert colorItems.items.getSize() == 3l;
    ASTEnumItemNode* red = colorItems.items.get(0l);
    ASTEnumItemNode* green = colorItems.items.get(1l);
    ASTEnumItemNode* blue = colorItems.items.get(2l);
    assert red.itemValue == 0u;
    assert green.itemValue == 5u;
    assert blue.itemValue == 1u;
    const QualType redType = typeOf(color.enumScope, "RED");
    assert redType.is(SuperType::TY_INT);

    const QualType lengthType = typeOf(root, "Length");
    assert lengthType.is(SuperType::TY_ALIAS);
    assert length.aliasedTypeContainerEntry.used;
    const QualType lengthContainerType = length.aliasedTypeContainerEntry.getQualType();
    assert lengthContainerType.is(SuperType::TY_INT);

    const QualType limitType = typeOf(root, "LIMIT");
    assert limitType.is(SuperType::TY_INT);
    assert limitType.isConst();
    const QualType bigType = typeOf(root, "BIG");
    assert bigType.is(SuperType::TY_LONG);
    assert bigType.isPublic();

    // -------------------------------------------------------------------------------------------------------------
    // External declarations
    // -------------------------------------------------------------------------------------------------------------
    assert strlenDecl.extFunction != nil<Function*>;
    assert !strlenDecl.extFunction.mangleFunctionName;
    assert !strlenDecl.extFunction.isVararg;
    assert strlenDecl.extFunction.returnType.is(SuperType::TY_INT);
    assert strlenDecl.extFunction.paramList.getSize() == 1l;
    const QualType strlenType = strlenDecl.entry.getQualType();
    assert strlenType.is(SuperType::TY_FUNCTION);
    assert printfDecl.extFunction.isVararg;

    // -------------------------------------------------------------------------------------------------------------
    // Functions and procedures
    // -------------------------------------------------------------------------------------------------------------
    assert identity.manifestations.getSize() == 1l;
    Function* identityFct = identity.manifestations.front();
    assert identityFct.templateTypes.getSize() == 1l;
    assert identityFct.returnType.is(SuperType::TY_GENERIC);

    assert measure.manifestations.getSize() == 1l;
    Function* measureFct = measure.manifestations.front();
    assert measureFct.returnType.is(SuperType::TY_INT); // The alias is resolved
    assert measureFct.paramList.getSize() == 2l;
    const Param& rectParam = measureFct.paramList.get(0l);
    assert rectParam.qualType.isRefTo(SuperType::TY_STRUCT);
    const Param& colorParam = measureFct.paramList.get(1l);
    assert colorParam.qualType.is(SuperType::TY_INT); // Enums are ints
    const QualType measureType = measure.entry.getQualType();
    assert measureType.is(SuperType::TY_FUNCTION);

    // Usage of a generic struct with a concrete template type
    assert sumBox.manifestations.getSize() == 1l;
    Function* sumBoxFct = sumBox.manifestations.front();
    const Param& boxParam = sumBoxFct.paramList.get(0l);
    assert boxParam.qualType.isPtrTo(SuperType::TY_STRUCT);
    const QualType boxParamBaseType = boxParam.qualType.getBase();
    const QualTypeList boxParamTemplateTypes = boxParamBaseType.getTemplateTypes();
    assert boxParamTemplateTypes.getSize() == 1l;
    const QualType& boxParamTemplateType = boxParamTemplateTypes.front();
    assert boxParamTemplateType.is(SuperType::TY_INT);

    const QualType mainType = typeOf(root, "main");
    assert mainType.is(SuperType::TY_FUNCTION);

    printf("All assertions passed!\n");
}
