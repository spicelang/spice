import "std/os/env";
import "std/io/filepath";
import "std/data/vector";
import "std/data/pair";
import "std/type/any";
import "bootstrap/driver";
import "bootstrap/ast/ast-nodes";
import "bootstrap/global/global-resource-manager";
import "bootstrap/global/runtime-module-manager";
import "bootstrap/source-file";
import "bootstrap/symboltablebuilder/qual-type";
import "bootstrap/symboltablebuilder/scope";
import "bootstrap/symboltablebuilder/super-type";
import "bootstrap/symboltablebuilder/symbol-table-entry";
import "bootstrap/typechecker/expr-result";
import "bootstrap/typechecker/type-checker";
import "bootstrap/util/compiler-warning";
import "bootstrap/util/pass-test-util";

f<FilePath> getFixturePath() {
    Result<string> spiceStdDir = getEnv("SPICE_STD_DIR");
    String filePathString = spiceStdDir.unwrap() + "/../test/test-files/bootstrap-compiler/standalone-type-checker-expressions-test/test-file.spice";
    return FilePath(filePathString);
}

// Type of the symbol with the given name in the given scope. Fails the test if the symbol does not exist
f<QualType> typeOf(Scope* scope, string name) {
    SymbolTableEntry* entry = scope.lookupStrict(String(name));
    assert entry != nil<SymbolTableEntry*>;
    return entry.getQualType();
}

// Check if the expression result at the given index is of the given type
f<bool> hasType(Vector<ExprResult>& exprResults, unsigned long index, SuperType superType) {
    const ExprResult& exprResult = exprResults.get(index);
    return exprResult.ty.is(superType);
}

f<int> main() {
    // -------------------------------------------------------------------------------------------------------------
    // Run the front end and the prepare stage of the type checker
    // -------------------------------------------------------------------------------------------------------------
    CliOptions cliOptions;
    setupPassTestOptions(cliOptions);
    GlobalResourceManager rm = GlobalResourceManager(cliOptions);
    SourceFile* file = rm.createSourceFile(nil<SourceFile*>, String("root"), getFixturePath(), false);
    file.runFrontEnd();
    TypeChecker typeChecker = TypeChecker(rm, file, TypeCheckerMode::TC_MODE_PRE);
    typeChecker.visit(file.ast);
    assert rm.errorManager.softErrors.isEmpty();
    Scope* root = file.getGlobalScope();

    // -------------------------------------------------------------------------------------------------------------
    // Type-check the statements of main one by one. The check stage visitors for statement lists are not ported yet
    // -------------------------------------------------------------------------------------------------------------
    ASTEntryNode* entry = file.ast;
    ASTMainFctDefNode* mainFctDef = nil<ASTMainFctDefNode*>;
    foreach IVisitable* topLevelDef : entry.topLevelDefs {
        ASTNode* topLevelDefNode = getASTNode(topLevelDef);
        if topLevelDefNode.kind == ASTNodeKind::MAIN_FCT_DEF {
            mainFctDef = downcast<ASTMainFctDefNode>(topLevelDefNode);
        }
    }
    assert mainFctDef != nil<ASTMainFctDefNode*>;
    Scope* mainScope = nil<Scope*>;
    foreach Pair<const String&, Scope*&> childEntry : root.children {
        Scope* child = childEntry.getSecond();
        if child.scopeType == ScopeType::FUNC_PROC_BODY {
            mainScope = child;
        }
    }
    assert mainScope != nil<Scope*>;
    typeChecker.currentScope = mainScope;

    ASTStmtLstNode* body = downcast<ASTStmtLstNode>(getASTNode(mainFctDef.body));
    Vector<ExprResult> exprResults; // Result of each valid expression statement
    Vector<unsigned long> softErrorCounts; // Number of soft errors after each invalid expression statement
    foreach IVisitable* stmt : body.statements {
        ASTNode* stmtNode = getASTNode(stmt);
        if stmtNode.kind == ASTNodeKind::DECL_STMT {
            typeChecker.visitDeclStmt(downcast<ASTDeclStmtNode>(stmtNode));
            assert rm.errorManager.softErrors.isEmpty();
        } else {
            assert stmtNode.kind == ASTNodeKind::EXPR_STMT;
            ASTExprStmtNode* exprStmt = downcast<ASTExprStmtNode>(stmtNode);
            Any visitResult = typeChecker.visit(exprStmt.expr);
            const ExprResult exprResult = visitResult.get<ExprResult>();
            if rm.errorManager.softErrors.isEmpty() {
                exprResults.pushBack(exprResult);
            } else {
                // Each invalid expression reports exactly one soft error and evaluates to the unresolved type
                assert exprResult.ty.is(SuperType::TY_UNRESOLVED);
                softErrorCounts.pushBack(cast<unsigned long>(rm.errorManager.softErrors.getSize()));
            }
        }
        // Visiting an expression must always return to the scope it started in
        assert typeChecker.currentScope == mainScope;
    }

    // -------------------------------------------------------------------------------------------------------------
    // Valid expressions
    // -------------------------------------------------------------------------------------------------------------
    assert exprResults.getSize() == 16l;
    // a = 1 + 2 * 3;
    assert hasType(exprResults, 0l, SuperType::TY_INT);
    // b = cast<long>(a) << 2;
    assert hasType(exprResults, 1l, SuperType::TY_LONG);
    // d *= 2.5;
    assert hasType(exprResults, 2l, SuperType::TY_DOUBLE);
    // flag = a < 10 && b >= 3l || !flag;
    assert hasType(exprResults, 3l, SuperType::TY_BOOL);
    // a = flag ? a : 7;
    assert hasType(exprResults, 4l, SuperType::TY_INT);
    // a = arr[2];
    assert hasType(exprResults, 5l, SuperType::TY_INT);
    // d = pt.y;
    assert hasType(exprResults, 6l, SuperType::TY_DOUBLE);
    // a = holder.x; (field of the composed struct)
    assert hasType(exprResults, 7l, SuperType::TY_INT);
    // d = qty.amount; (union field)
    assert hasType(exprResults, 8l, SuperType::TY_DOUBLE);
    // inferred = 3.0; (type inference of a dyn variable)
    assert hasType(exprResults, 9l, SuperType::TY_DOUBLE);
    const QualType inferredType = typeOf(mainScope, "inferred");
    assert inferredType.is(SuperType::TY_DOUBLE);
    // a++;
    assert hasType(exprResults, 10l, SuperType::TY_INT);
    const ExprResult& incrementResult = exprResults.get(10l);
    assert incrementResult.entry == mainScope.lookupStrict(String("a"));
    // --a;
    assert hasType(exprResults, 11l, SuperType::TY_INT);
    // a = a & 3 | 4 ^ 1;
    assert hasType(exprResults, 12l, SuperType::TY_INT);
    // flag = s == "hello"; (requests the string runtime for the comparison)
    assert hasType(exprResults, 13l, SuperType::TY_BOOL);
    assert file.isRuntimeModuleAvailable(RuntimeModule::STRING_RT);
    // a = -a % 3;
    assert hasType(exprResults, 14l, SuperType::TY_INT);
    // a = cast<int>(a); (identity cast warning)
    assert hasType(exprResults, 15l, SuperType::TY_INT);
    bool foundIdentityCastWarning = false;
    foreach const CompilerWarning& warning : file.compilerOutput.warnings {
        if warning.warningMessage.contains("You cast from a type to itself") {
            foundIdentityCastWarning = true;
        }
    }
    assert foundIdentityCastWarning;

    // All assigned variables are initialized now
    SymbolTableEntry* aEntry = mainScope.lookupStrict(String("a"));
    assert aEntry.isInitialized();
    // The logical operands and the ternary branches have expression scopes, whose temporaries need no dtor calls here
    unsigned long exprScopeCount = 0l;
    foreach Pair<const String&, Scope*&> childEntry : mainScope.children {
        Scope* child = childEntry.getSecond();
        if child.scopeType == ScopeType::EXPR_BODY {
            exprScopeCount++;
            assert child.temporaryDtorsToCall.isEmpty();
        }
    }
    assert exprScopeCount > 0l;

    // -------------------------------------------------------------------------------------------------------------
    // Invalid expressions
    // -------------------------------------------------------------------------------------------------------------
    assert softErrorCounts.getSize() == 6l;
    for unsigned long i = 0l; i < softErrorCounts.getSize(); i++ {
        assert softErrorCounts.get(i) == i + 1l;
    }
    assert softErrorContains(rm.errorManager, 0l, "You are trying to access element with index 5 of an array with size 4");
    assert softErrorContains(rm.errorManager, 1l, "Field 'z' not found in struct Point");
    assert softErrorContains(rm.errorManager, 2l, "True and false operands in ternary must be of same data type. Got int and double");
    assert softErrorContains(rm.errorManager, 3l, "Can only apply subscript operator on array type, got int");
    assert softErrorContains(rm.errorManager, 4l, "Array index must be of type int or long");
    assert softErrorContains(rm.errorManager, 5l, "The variable 'unknownVar' could not be found");

    printf("All assertions passed!\n");
}
