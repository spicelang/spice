// Input program for the standalone type checker expressions test. The test type-checks the statements of main one by one.
// The last statements are invalid on purpose, the test checks the soft errors they produce.

type Point struct {
    public int x
    public double y
}

type Holder struct {
    compose public Point point
    public bool flag
}

type Quantity union {
    public int count
    public double amount
}

f<int> main() {
    int a;
    long b;
    double d;
    bool flag;
    string s;
    int[4] arr;
    Point pt;
    Holder holder;
    Quantity qty;
    dyn inferred;

    // Valid expressions
    a = 1 + 2 * 3;
    b = cast<long>(a) << 2;
    d *= 2.5;
    flag = a < 10 && b >= 3l || !flag;
    a = flag ? a : 7;
    a = arr[2];
    d = pt.y;
    a = holder.x;
    d = qty.amount;
    inferred = 3.0;
    a++;
    --a;
    a = a & 3 | 4 ^ 1;
    flag = s == "hello";
    a = -a % 3;
    a = cast<int>(a);

    // Invalid expressions
    a = arr[5];
    a = pt.z;
    a = flag ? 1 : 2.0;
    a = a[1];
    a = arr[true];
    a = unknownVar;
}
