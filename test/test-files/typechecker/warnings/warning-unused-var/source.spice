const int RESET_COUNT = 1; // No warning: only used as case constant

type Counter struct {
    int count
}

// No warning for the unused 'this' parameter
p Counter.reset() {
    printf("reset\n");
}

f<int> main() {
    int unusedVar = 12; // warning
    double _ = 13.34;   // no warning
    Counter counter = Counter{0};
    switch counter.count {
        case RESET_COUNT: { counter.reset(); }
        default: {}
    }
    printf("%d", counter.count);
}
