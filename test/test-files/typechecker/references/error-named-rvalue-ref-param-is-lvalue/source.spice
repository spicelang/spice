type Test struct {
    int value
}

p Test.ctor() {
    this.value = 0;
}

p Test.ctor(const Test& other) {
    this.value = other.value;
}

p Test.ctor(Test&& other) {
    this.value = other.value;
    other.value = 0;
}

p consume(Test&& test) {
    printf("%d\n", test.value);
}

p forward(Test&& test) {
    // A named RValue reference is an LValue, so it has to be moved again to bind to an RValue reference
    consume(test);
}

f<int> main() {
    forward(Test());
}
