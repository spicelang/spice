// With #![core.compiler.explicitErrorHandling = false], discarding a Result<T> return value is only the generic,
// suppressible UNUSED_RETURN_VALUE warning instead of an error.

#![core.compiler.explicitErrorHandling = false]

f<Result<int>> mightFail() {
    return ok<int>(1);
}

f<int> main() {
    mightFail();
    return 0;
}
