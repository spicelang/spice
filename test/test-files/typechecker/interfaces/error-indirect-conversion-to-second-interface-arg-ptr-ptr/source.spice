type First interface {
    f<int> one();
}

type Second interface {
    f<int> two();
}

type Impl struct : First, Second {}

f<int> Impl.one() {
    return 1;
}

f<int> Impl.two() {
    return 2;
}

p takeFirstPtrPtr(First** first) {
    printf("%d\n", (*first).one());
}

p takeSecondPtrPtr(Second** second) {
    printf("%d\n", (*second).two());
}

f<int> main() {
    Impl impl;
    Impl* implPtr = &impl;
    // Allowed, because First sits at offset 0 of Impl
    takeFirstPtrPtr(&implPtr);
    // Not allowed, because the pointer to Impl cannot be adjusted to the Second part of Impl behind another indirection
    takeSecondPtrPtr(&implPtr);
}
