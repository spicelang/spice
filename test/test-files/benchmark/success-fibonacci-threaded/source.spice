import "std/os/thread";

f<int> fib(int n) {
    if n <= 2 { return 1; }
    return fib(n - 1) + fib(n - 2);
}

f<int> main() {
    int threadCount = 8;
    Thread[8] threads;
    // Printed before the threads start, since they may already finish while the others are started
    printf("Starting all threads ...\n");
    for unsigned int i = 0; i < threadCount; i++ {
        threads[i] = Thread(p() {
            int res = fib(30);
            printf("Thread returned with result: %d\n", res);
        });
        Thread& thread = threads[i];
        Result<bool> started = thread.run();
        assert started.isOk();
    }
    for unsigned int i = 0; i < threadCount; i++ {
        Thread& thread = threads[i];
        Result<bool> joined = thread.join();
        assert joined.isOk();
    }
    printf("Program finished");
}