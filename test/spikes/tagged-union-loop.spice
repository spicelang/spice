// Spike 4: cost of the runtime tag check of a union with eight members in a hot loop.
// The same loop runs over a union (tag checked on every access) and over a plain struct (no check).
// Run it as a release build, e.g. 'spice build -O2 test/spikes/tagged-union-loop.spice', it prints the times.
import "std/time/time";

type Eight union {
    long f0
    long f1
    long f2
    long f3
    long f4
    long f5
    long f6
    long f7
}

type EightStruct struct {
    long f0
    long f1
    long f2
    long f3
    long f4
    long f5
    long f6
    long f7
}

f<long> unionLoop(long iterations) {
    Eight u;
    long acc = 1l;
    for long i = 0l; i < iterations; i++ {
        // Assign one field, read it back: assignment sets the tag, the read checks it
        switch i & 7l {
            case 0l: { u.f0 = acc + i; acc ^= u.f0; }
            case 1l: { u.f1 = acc + i; acc ^= u.f1; }
            case 2l: { u.f2 = acc + i; acc ^= u.f2; }
            case 3l: { u.f3 = acc + i; acc ^= u.f3; }
            case 4l: { u.f4 = acc + i; acc ^= u.f4; }
            case 5l: { u.f5 = acc + i; acc ^= u.f5; }
            case 6l: { u.f6 = acc + i; acc ^= u.f6; }
            default: { u.f7 = acc + i; acc ^= u.f7; }
        }
    }
    return acc;
}

f<long> structLoop(long iterations) {
    EightStruct s;
    long acc = 1l;
    for long i = 0l; i < iterations; i++ {
        switch i & 7l {
            case 0l: { s.f0 = acc + i; acc ^= s.f0; }
            case 1l: { s.f1 = acc + i; acc ^= s.f1; }
            case 2l: { s.f2 = acc + i; acc ^= s.f2; }
            case 3l: { s.f3 = acc + i; acc ^= s.f3; }
            case 4l: { s.f4 = acc + i; acc ^= s.f4; }
            case 5l: { s.f5 = acc + i; acc ^= s.f5; }
            case 6l: { s.f6 = acc + i; acc ^= s.f6; }
            default: { s.f7 = acc + i; acc ^= s.f7; }
        }
    }
    return acc;
}

// The tag is set in a setup loop and read in the hot loop, where the compiler cannot prove which field is active
const unsigned long TABLE_SIZE = 1024ul;

f<long> unionTableLoop(long rounds) {
    Eight[1024] table;
    for unsigned long k = 0ul; k < TABLE_SIZE; k++ {
        switch k & 7ul {
            case 0ul: { table[k].f0 = cast<long>(k); }
            case 1ul: { table[k].f1 = cast<long>(k); }
            case 2ul: { table[k].f2 = cast<long>(k); }
            case 3ul: { table[k].f3 = cast<long>(k); }
            case 4ul: { table[k].f4 = cast<long>(k); }
            case 5ul: { table[k].f5 = cast<long>(k); }
            case 6ul: { table[k].f6 = cast<long>(k); }
            default: { table[k].f7 = cast<long>(k); }
        }
    }
    long acc = 0l;
    for long r = 0l; r < rounds; r++ {
        for unsigned long k = 0ul; k < TABLE_SIZE; k++ {
            switch k & 7ul {
                case 0ul: { acc += table[k].f0; }
                case 1ul: { acc += table[k].f1; }
                case 2ul: { acc += table[k].f2; }
                case 3ul: { acc += table[k].f3; }
                case 4ul: { acc += table[k].f4; }
                case 5ul: { acc += table[k].f5; }
                case 6ul: { acc += table[k].f6; }
                default: { acc += table[k].f7; }
            }
        }
    }
    return acc;
}

f<long> structTableLoop(long rounds) {
    EightStruct[1024] table;
    for unsigned long k = 0ul; k < TABLE_SIZE; k++ {
        switch k & 7ul {
            case 0ul: { table[k].f0 = cast<long>(k); }
            case 1ul: { table[k].f1 = cast<long>(k); }
            case 2ul: { table[k].f2 = cast<long>(k); }
            case 3ul: { table[k].f3 = cast<long>(k); }
            case 4ul: { table[k].f4 = cast<long>(k); }
            case 5ul: { table[k].f5 = cast<long>(k); }
            case 6ul: { table[k].f6 = cast<long>(k); }
            default: { table[k].f7 = cast<long>(k); }
        }
    }
    long acc = 0l;
    for long r = 0l; r < rounds; r++ {
        for unsigned long k = 0ul; k < TABLE_SIZE; k++ {
            switch k & 7ul {
                case 0ul: { acc += table[k].f0; }
                case 1ul: { acc += table[k].f1; }
                case 2ul: { acc += table[k].f2; }
                case 3ul: { acc += table[k].f3; }
                case 4ul: { acc += table[k].f4; }
                case 5ul: { acc += table[k].f5; }
                case 6ul: { acc += table[k].f6; }
                default: { acc += table[k].f7; }
            }
        }
    }
    return acc;
}

#[test]
f<bool> testUnionAndStructAgree() {
    return unionLoop(1000l) == structLoop(1000l) && unionTableLoop(3l) == structTableLoop(3l);
}

f<int> main() {
    const long iterations = 400000000l;
    const long t0 = getCurrentMillis();
    const long a = unionLoop(iterations);
    const long t1 = getCurrentMillis();
    const long b = structLoop(iterations);
    const long t2 = getCurrentMillis();
    printf("union:  %ld ms (result %ld)\n", t1 - t0, a);
    printf("struct: %ld ms (result %ld)\n", t2 - t1, b);
    const long t3 = getCurrentMillis();
    const long c = unionTableLoop(400000l);
    const long t4 = getCurrentMillis();
    const long d = structTableLoop(400000l);
    const long t5 = getCurrentMillis();
    printf("union table:  %ld ms (result %ld)\n", t4 - t3, c);
    printf("struct table: %ld ms (result %ld)\n", t5 - t4, d);
    return a == b && c == d ? 0 : 1;
}
