    table[41] = &s41;
    table[42] = &s42;
    table[43] = &s43;
    table[44] = &s44;
    table[45] = &s45;
    table[46] = &s46;
    table[47] = &s47;
    table[48] = &s48;
    table[49] = &s49;
    table[50] = &s50;
    table[51] = &s51;
    table[52] = &s52;
    table[53] = &s53;
    table[54] = &s54;
    table[55] = &s55;
    table[56] = &s56;
    table[57] = &s57;
    table[58] = &s58;
    table[59] = &s59;
    table[60] = &s60;
    table[61] = &s61;
    table[62] = &s62;
    table[63] = &s63;
    table[64] = &s64;
    table[65] = &s65;
    table[66] = &s66;
    table[67] = &s67;
    table[68] = &s68;
    table[69] = &s69;
    table[70] = &s70;
    table[71] = &s71;
    table[72] = &s72;
    table[73] = &s73;
    table[74] = &s74;
    table[75] = &s75;
    table[76] = &s76;
    table[77] = &s77;
    unsigned long state = 42ul;
    INode*[4096] nodes;
    for unsigned int i = 0u; i < COUNT; i++ {
        nodes[i] = table[nextKind(state)];
    }
    long acc = 0l;
    for long r = 0l; r < rounds; r++ {
        for unsigned int i = 0u; i < COUNT; i++ {
            acc += nodes[i].eval(acc & 255l);
        }
    }
    return acc;
}

#[test]
f<bool> testSwitchAndInterfaceAgree() {
    return switchLoop(3l) == interfaceLoop(3l);
}

f<int> main() {
    const long rounds = 100000l;
    const long t0 = getCurrentMillis();
    const long a = switchLoop(rounds);
    const long t1 = getCurrentMillis();
    const long b = interfaceLoop(rounds);
    const long t2 = getCurrentMillis();
    printf("switch:    %ld ms (result %ld)\n", t1 - t0, a);
    printf("interface: %ld ms (result %ld)\n", t2 - t1, b);
    return a == b ? 0 : 1;
}
