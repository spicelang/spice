const unsigned int COUNT = 4096u;

// Pseudo random kinds, so that the branch predictor has no pattern to learn
f<unsigned int> nextKind(unsigned long& state) {
    state = state * 6364136223846793005ul + 1442695040888963407ul;
    return cast<unsigned int>((state >> 33ul) % 78ul);
}

f<long> switchLoop(long rounds) {
    unsigned long state = 42ul;
    Kind[4096] kinds;
    for unsigned int i = 0u; i < COUNT; i++ {
        kinds[i] = cast<Kind>(nextKind(state));
    }
    long acc = 0l;
    for long r = 0l; r < rounds; r++ {
        for unsigned int i = 0u; i < COUNT; i++ {
            acc += evalSwitch(kinds[i], acc & 255l, 1l);
        }
    }
    return acc;
}

