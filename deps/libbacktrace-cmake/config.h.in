/* config.h for the vendored libbacktrace, generated from deps/libbacktrace-cmake/config.h.in.

   libbacktrace ships an autotools build whose ./configure writes this file. Spice builds the library from CMake
   instead (see the CMakeLists.txt next to this file for why), so the macros the library sources actually read are
   probed with CMake's own check_* modules and substituted here. Everything configure additionally writes is only
   consumed by libbacktrace's own test suite, which Spice does not build, and is therefore omitted.

   Keep this file in sync with deps/libbacktrace when the submodule is bumped: a macro that a new upstream source
   reads but that is missing here silently disables a code path instead of failing the build. */

#pragma once

/* ELF size: 32 or 64, or 'unused' when the target's object format is not ELF. */
#define BACKTRACE_ELF_SIZE @BACKTRACE_ELF_SIZE@

/* XCOFF size: 32 or 64, or 'unused' when the target's object format is not XCOFF. */
#define BACKTRACE_XCOFF_SIZE @BACKTRACE_XCOFF_SIZE@

/* Define to 1 if you have the __atomic functions. */
#cmakedefine HAVE_ATOMIC_FUNCTIONS 1

/* Define to 1 if you have the __sync functions. */
#cmakedefine HAVE_SYNC_FUNCTIONS 1

/* Define to 1 if you have the declaration of 'getpagesize'. */
#cmakedefine HAVE_DECL_GETPAGESIZE 1

/* Define to 1 if you have the declaration of 'strnlen'. */
#cmakedefine HAVE_DECL_STRNLEN 1

/* Define to 1 if you have the declaration of '_pgmptr'. */
#cmakedefine HAVE_DECL__PGMPTR 1

/* Define to 1 if dl_iterate_phdr is available. */
#cmakedefine HAVE_DL_ITERATE_PHDR 1

/* Define to 1 if you have the fcntl function. */
#cmakedefine HAVE_FCNTL 1

/* Define to 1 if getexecname is available. */
#cmakedefine HAVE_GETEXECNAME 1

/* Define to 1 if _Unwind_GetIPInfo is available. */
#cmakedefine HAVE_GETIPINFO 1

/* Define to 1 if you have KERN_PROC and KERN_PROC_PATHNAME in <sys/sysctl.h>. */
#cmakedefine HAVE_KERN_PROC 1

/* Define to 1 if you have KERN_PROC_ARGS and KERN_PROC_PATHNAME in <sys/sysctl.h>. */
#cmakedefine HAVE_KERN_PROC_ARGS 1

/* Define to 1 if you have the <link.h> header file. */
#cmakedefine HAVE_LINK_H 1

/* Define to 1 if AIX loadquery is available. */
#cmakedefine HAVE_LOADQUERY 1

/* Define to 1 if you have the 'lstat' function. */
#cmakedefine HAVE_LSTAT 1

/* Define to 1 if you have the <mach-o/dyld.h> header file. */
#cmakedefine HAVE_MACH_O_DYLD_H 1

/* Define to 1 if you have the 'readlink' function. */
#cmakedefine HAVE_READLINK 1

/* Define to 1 if you have the <sys/ldr.h> header file. */
#cmakedefine HAVE_SYS_LDR_H 1

/* Define to 1 if you have the <sys/link.h> header file. */
#cmakedefine HAVE_SYS_LINK_H 1

/* Define to 1 if you have the <sys/mman.h> header file. */
#cmakedefine HAVE_SYS_MMAN_H 1

/* Define to 1 if you have the <tlhelp32.h> header file. */
#cmakedefine HAVE_TLHELP32_H 1

/* Define to 1 if you have the <windows.h> header file. */
#cmakedefine HAVE_WINDOWS_H 1

/* Define to 1 if you have the 'clock_gettime' function. */
#cmakedefine HAVE_CLOCK_GETTIME 1
