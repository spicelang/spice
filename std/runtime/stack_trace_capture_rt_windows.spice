#![core.compiler.alwaysKeepOnNameCollision = true]

// Frame capture for Windows - see stack_trace_capture_rt.spice for the POSIX variant.
//
// Unwinding on x64 is table-driven, through the .pdata/.xdata records that IRGenerator's 'uwtable' attribute
// causes to be emitted. RtlCaptureStackBackTrace is the documented way to ask the OS to walk them. It is
// exported from kernel32, so it needs no linker flag and works under MinGW as well as MSVC, and it needs no
// callback: one call fills the buffer.

ext f<unsigned short> RtlCaptureStackBackTrace(unsigned int /*framesToSkip*/, unsigned int /*framesToCapture*/,
                                               byte** /*backTrace*/, unsigned int* /*backTraceHash*/);

/**
 * Fills 'addresses' with up to 'capacity' return addresses, most recent call first, and returns how many were
 * written. Mirrors the POSIX overload in stack_trace_capture_rt.spice, including how 'skipFrames' is counted.
 *
 * @param addresses Buffer to write into
 * @param capacity Maximum number of addresses to write
 * @param skipFrames Number of frames to drop from the top, counted from this function's own frame
 * @return Number of addresses written
 */
public f<int> captureReturnAddresses(byte** addresses, int capacity, int skipFrames) {
    // Both bounds are checked before the casts below, which are to unsigned: a negative skip count would
    // otherwise turn into an enormous framesToSkip. This mirrors the guard the POSIX implementation applies.
    if capacity <= 0 || skipFrames < 0 {
        return 0;
    }

    // The OS does the skipping itself and does not count its own frame, so 'skipFrames' passes straight through
    // and frame 0 is this function, matching the POSIX side. Capacity is passed unclamped: the documented limit
    // is 2^16 frames, and the 'skip + capture under 63' restriction applies only to Windows XP and Server 2003.
    unsafe {
        const unsigned short capturedFrames = RtlCaptureStackBackTrace(cast<unsigned int>(skipFrames),
                                                                       cast<unsigned int>(capacity),
                                                                       addresses, nil<unsigned int*>);
        return cast<int>(capturedFrames);
    }
}
