#![core.compiler.alwaysKeepOnNameCollision = true]

// The C functions, that the other runtime modules and the code generated by LLVM call, for freestanding mode, where there is
// no libc. The compiler links this module into every freestanding program. Its functions are weak, so that the program can
// bring its own implementations (e.g. optimized ones) instead. They are marked with core.compiler.noBuiltins, since LLVM
// would turn their loops into calls to themselves otherwise.
//
// The allocation functions malloc, realloc and free are the allocator functions of the program, see the attributes
// core.compiler.allocFunction, core.compiler.reallocFunction and core.compiler.deallocFunction.

/**
 * Copy size bytes from src to dest. The memory areas must not overlap
 *
 * @param dest Destination memory area
 * @param src Source memory area
 * @param size Number of bytes
 * @return Destination memory area
 */
#[core.compiler.mangle = false, core.compiler.noBuiltins]
public f<byte*> memcpy(byte* dest, const byte* src, unsigned long size) {
    unsafe {
        for unsigned long i = 0l; i < size; i++ {
            dest[i] = src[i];
        }
    }
    return dest;
}

/**
 * Copy size bytes from src to dest. The memory areas may overlap
 *
 * @param dest Destination memory area
 * @param src Source memory area
 * @param size Number of bytes
 * @return Destination memory area
 */
#[core.compiler.mangle = false, core.compiler.noBuiltins]
public f<byte*> memmove(byte* dest, const byte* src, unsigned long size) {
    unsafe {
        if cast<unsigned long>(dest) <= cast<unsigned long>(src) {
            // Copy forwards, so that the start of src is read before it is overwritten
            for unsigned long i = 0l; i < size; i++ {
                dest[i] = src[i];
            }
        } else {
            // Copy backwards, so that the end of src is read before it is overwritten
            for unsigned long i = size; i > 0l; i-- {
                dest[i - 1l] = src[i - 1l];
            }
        }
    }
    return dest;
}

/**
 * Fill size bytes of dest with the given value
 *
 * @param dest Destination memory area
 * @param value Value, of which the lowest byte is used
 * @param size Number of bytes
 * @return Destination memory area
 */
#[core.compiler.mangle = false, core.compiler.noBuiltins]
public f<byte*> memset(byte* dest, int value, unsigned long size) {
    const byte fillValue = cast<byte>(value);
    unsafe {
        for unsigned long i = 0l; i < size; i++ {
            dest[i] = fillValue;
        }
    }
    return dest;
}

/**
 * Compare size bytes of two memory areas
 *
 * @param lhs First memory area
 * @param rhs Second memory area
 * @param size Number of bytes
 * @return 0 if equal, a negative value if the first differing byte is smaller in lhs, a positive value otherwise
 */
#[core.compiler.mangle = false, core.compiler.noBuiltins]
public f<int> memcmp(const byte* lhs, const byte* rhs, unsigned long size) {
    unsafe {
        for unsigned long i = 0l; i < size; i++ {
            if lhs[i] != rhs[i] {
                return cast<int>(lhs[i]) - cast<int>(rhs[i]);
            }
        }
    }
    return 0;
}

/**
 * Check if two memory areas are equal. LLVM turns memcmp calls, of which only the equality is used, into bcmp calls
 *
 * @param lhs First memory area
 * @param rhs Second memory area
 * @param size Number of bytes
 * @return 0 if equal, another value otherwise
 */
#[core.compiler.mangle = false, core.compiler.noBuiltins]
public f<int> bcmp(const byte* lhs, const byte* rhs, unsigned long size) {
    unsafe {
        for unsigned long i = 0l; i < size; i++ {
            if lhs[i] != rhs[i] {
                return 1;
            }
        }
    }
    return 0;
}

/**
 * Get the length of a null-terminated string
 *
 * @param str String
 * @return Number of chars before the null terminator
 */
#[core.compiler.mangle = false, core.compiler.noBuiltins]
public f<unsigned long> strlen(string str) {
    unsigned long length = 0l;
    while str[length] != '\0' {
        length++;
    }
    return length;
}

/**
 * Compare two null-terminated strings
 *
 * @param lhs First string
 * @param rhs Second string
 * @return 0 if equal, a negative value if the first differing char is smaller in lhs, a positive value otherwise
 */
#[core.compiler.mangle = false, core.compiler.noBuiltins]
public f<int> strcmp(string lhs, string rhs) {
    unsigned long i = 0l;
    while lhs[i] != '\0' && lhs[i] == rhs[i] {
        i++;
    }
    // Compare as unsigned chars, like the C function
    return cast<int>(cast<byte>(lhs[i])) - cast<int>(cast<byte>(rhs[i]));
}
