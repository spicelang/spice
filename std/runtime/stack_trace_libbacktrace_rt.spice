#![
    core.compiler.alwaysKeepOnNameCollision = true,
    core.linker.additionalSource = "stack-trace-libbacktrace.c"
]

// Symbol resolution backed by libbacktrace (deps/libbacktrace), one file for every target: ELF (Linux), Mach-O
// (macOS) and PE/COFF (Windows). It reads the symbol table straight out of the binary, so it resolves every
// function that made it in, public or not, with no '-rdynamic' needed - and, on ELF/Mach-O, reports each
// symbol's real size, so an address past the end of its function is rejected instead of misattributed.
//
// libbacktrace is linked in whenever a prebuilt archive exists for the target (see
// ExternalLinkerInterface::prepare() / SystemUtil::findLibbacktraceStaticLib()); the symbol table is never
// stripped, so there is always something for it to read. With no archive, the C shim compiles as a permanent
// no-op (stack-trace-libbacktrace.c) and every lookup here reports unresolved.
//
// The state is opened against the main executable (backtrace_create_state(NULL, ...)), but on ELF/Mach-O that
// also covers every shared library already loaded at the time of the first lookup - backtrace_initialize()
// walks them via dl_iterate_phdr()/dyld and folds each one in (see elf.c/macho.c), confirmed empirically by
// resolving '&printf'. PE/COFF has no such enumeration, so on Windows only the main executable resolves. A
// library dlopen()'d afterward, or one with no symbol table at all, stays unresolved either way.

/**
 * Outcome of one symbol lookup. 'name' is still mangled; the caller demangles it for display.
 */
public type SymbolLookup struct {
    public String name
    public unsigned long offset
    public bool resolved
}

// Mirrors SpiceSyminfoResult in stack-trace-libbacktrace.c, field for field.
type SyminfoResult struct {
    string name
    byte* address
    unsigned long size
}

// Defined in stack-trace-libbacktrace.c. Prefixed to keep a C-linkage symbol of this generality out of the way
// of anything the program being compiled might define itself.
ext f<int> spiceBacktraceSyminfo(byte* /*addr*/, SyminfoResult* /*out*/);

/**
 * Looks up the symbol containing the given address in the main executable's own symbol table.
 *
 * @param address Address to resolve
 * @return Mangled name and byte offset into that symbol, or an unresolved result if there is no match
 */
public f<SymbolLookup> resolveFromLibbacktrace(byte* address) {
    SyminfoResult syminfo;
    unsafe {
        spiceBacktraceSyminfo(address, &syminfo);
    }

    if cast<char*>(syminfo.name) == nil<char*> {
        return SymbolLookup{String(), 0l, false};
    }

    unsigned long offset = 0l;
    unsafe {
        offset = cast<unsigned long>(cast<long>(address) - cast<long>(syminfo.address));
    }

    // A size of 0 means none was recorded (always true on Windows/COFF), in which case the offset is accepted
    // as-is; otherwise an address past the end of the symbol it nominally follows is rejected outright.
    if syminfo.size != 0l && offset >= syminfo.size {
        return SymbolLookup{String(), 0l, false};
    }

    return SymbolLookup{String(syminfo.name), offset, true};
}
