#![core.compiler.alwaysKeepOnNameCollision = true]

// Symbol resolution for stack_trace_rt.spice, POSIX variant. dump() there calls resolveSymbolName() by name;
// this file (or stack_trace_symbol_rt_windows.spice, picked automatically via the compiler's OS-suffixed import
// resolution for the "std/runtime/stack_trace_symbol_rt" import in that file) supplies the platform-specific
// implementation, so the struct/capture()/dump() logic itself stays in one shared file - Spice requires a
// method to be declared in the same file as its struct, so dump() can't be split per platform directly, but the
// one piece that actually differs can live in an ordinary function instead, which faces no such restriction.
//
// Goes through the libc/POSIX dladdr(), which looks addresses up in the dynamic symbol table (.dynsym) of
// whichever loaded object contains them - not the full static symbol table, and not debug info. Spice does not
// link its executables with -rdynamic/--export-dynamic, so a Spice program's own functions are typically NOT
// present in .dynsym: dladdr() will usually resolve addresses that land in a dynamically linked library (e.g.
// libc), but not the caller's own Spice-level frames.

import "std/runtime/string_rt";

/**
 * Mirrors libc's 'Dl_info' (<dlfcn.h>), field for field, so it can be passed to dladdr() by pointer.
 */
type DlInfo struct {
    string dliFName // Pathname of the shared object that contains the address
    byte*  dliFBase // Base address at which the shared object is loaded
    string dliSName // Name of the nearest symbol with an address <= the given one, nil if none was found
    byte*  dliSAddr // Exact address of that symbol
}

ext f<int> dladdr(byte* /*addr*/, DlInfo* /*info*/);

/**
 * Resolves an address to the name of its containing symbol via dladdr(), or an empty/unallocated String if no
 * symbol could be found (see the file-level comment on why that is common for a Spice program's own frames
 * today).
 */
public f<String> resolveSymbolName(byte* address) {
    DlInfo info;
    unsafe {
        if dladdr(address, &info) != 0 && cast<char*>(info.dliSName) != nil<char*> {
            return String(info.dliSName);
        }
    }
    return String();
}
