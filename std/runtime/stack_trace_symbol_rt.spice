#![core.compiler.alwaysKeepOnNameCollision = true]

// Symbol resolution for stack_trace_rt.spice, POSIX variant. The OS-suffixed import in that file picks between
// this and stack_trace_symbol_rt_windows.spice; it is an ordinary function rather than a method because Spice
// requires a method to live in the same file as its struct, which would make the split impossible.
//
// dladdr() looks addresses up in the dynamic symbol table of whichever loaded object contains them, so it
// resolves anything exported - libc, shared libraries, and a Spice program's own 'public' functions - but not
// symbols that stayed local to their object file.

import "std/runtime/string_rt";

/**
 * Mirrors libc's 'Dl_info' (<dlfcn.h>), field for field, so it can be passed to dladdr() by pointer.
 */
type DlInfo struct {
    string dliFName // Pathname of the shared object that contains the address
    byte*  dliFBase // Base address at which the shared object is loaded
    string dliSName // Name of the nearest symbol with an address <= the given one, nil if none was found
    byte*  dliSAddr // Exact address of that symbol
}

ext f<int> dladdr(byte* /*addr*/, DlInfo* /*info*/);

/**
 * Outcome of one symbol lookup. 'name' is still mangled; the caller demangles it for display.
 */
public type SymbolLookup struct {
    public String name
    public unsigned long offset
    public bool resolved
}

/**
 * Looks up the symbol containing the given address.
 *
 * @param address Address to resolve
 * @return Mangled name and byte offset into that symbol, or an unresolved result if there is no match
 */
public f<SymbolLookup> resolveSymbol(byte* address) {
    DlInfo info;
    unsafe {
        if dladdr(address, &info) != 0 && cast<char*>(info.dliSName) != nil<char*> {
            const unsigned long offset = cast<unsigned long>(cast<long>(address) - cast<long>(info.dliSAddr));
            return SymbolLookup{String(info.dliSName), offset, true};
        }
    }
    return SymbolLookup{String(), 0l, false};
}
