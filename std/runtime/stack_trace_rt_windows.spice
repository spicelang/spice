#![core.compiler.alwaysKeepOnNameCollision = true]
#![core.windows.linker.flag = "-ldbghelp"]

// Windows variant of stack_trace_rt.spice. The frame-pointer walk itself is identical (LLVM's 'llvm.frameaddress'
// intrinsic and the saved-frame-pointer chain are portable across targets); what differs is symbol resolution,
// since Windows has no dladdr() - that is a POSIX/libdl API. This uses DbgHelp's SymFromAddr() instead, which
// resolves via loaded debug info (PDB) rather than a dynamic export table, so - unlike the POSIX dladdr() path -
// it does not depend on Spice linking with an equivalent of -rdynamic. It does depend on debug info actually
// being available for the running executable at all (SymInitialize(..., fInvadeProcess=TRUE) auto-loads it from
// the module's own PDB if present next to the executable).
//
// CAUTION: SymbolInfo below mirrors DbgHelp's SYMBOL_INFO struct (<dbghelp.h>), which is a real, non-trivial,
// padded C struct with a documented quirk (its 'SizeOfStruct' field must be set to sizeof(SYMBOL_INFO) *without*
// the trailing name buffer - see the struct's own comment). This was written from documented field order/sizes,
// not verified against a real Windows build or the actual header in this environment (no Windows toolchain was
// available to compile/run this file here) - treat this as the least-verified part of stack trace support and
// double check field offsets/sizeOfStruct against <dbghelp.h> on a real Windows machine before relying on it.
//
// See stack_trace_rt.spice for the shared design notes (frame-pointer chain layout, capture() semantics).

ext f<int> fprintf(byte* /*stream*/, string /*format*/, ...);

const int STACK_TRACE_CAPACITY = 64;

/**
 * Fixed-capacity buffer holding one captured stack trace, as raw return addresses (most recent call first).
 * Once the capacity above is hit, the walk stops early - deeper frames are silently dropped rather than
 * overwriting the ones closest to the capture point, which are the most relevant for diagnostics.
 */
public type StackTraceBuffer struct {
    public byte*[STACK_TRACE_CAPACITY] addresses
    public int count
}

/**
 * Captures the stack trace of the calling function. The first recorded address is the calling function's own
 * current instruction pointer (i.e. the return address capture() will resume at), not one of its parents' - so
 * by default the trace starts exactly at the call site of capture() itself.
 *
 * The chain's outermost frame is a sentinel, conventionally marked by a zeroed saved-frame-pointer field - but
 * on at least one observed platform (macOS/AArch64) its return-address field reads zero too, one hop before the
 * saved-frame-pointer field does. So termination is checked on the return-address value about to be recorded,
 * not only on the frame pointer itself - a zero return address means this frame is (or already looks like) the
 * sentinel, and the walk stops without recording it, rather than recording a bogus nil entry.
 *
 * @param skipFrames Number of additional frames to omit above the direct caller, for wrapper functions like
 *                    sDumpStacktrace() that call capture() on a caller's behalf and want their own frame hidden.
 */
public p StackTraceBuffer.capture(int skipFrames = 0) {
    this.count = 0;

    unsafe {
        byte** frame = cast<byte**>(__frame_address());

        while skipFrames > 0 && frame != nil<byte**> {
            frame = cast<byte**>(frame[0]);
            skipFrames--;
        }

        while frame != nil<byte**> && this.count < STACK_TRACE_CAPACITY {
            byte* returnAddress = frame[1];
            if returnAddress == nil<byte*> {
                break; // sentinel frame - no real caller above this, stop without recording it
            }
            this.addresses[this.count] = returnAddress;
            this.count++;
            frame = cast<byte**>(frame[0]); // saved frame pointer of the parent frame
        }
    }
}

/**
 * Mirrors the fixed header of DbgHelp's SYMBOL_INFO (<dbghelp.h>), with the flexible 'Name[1]' member expanded
 * into a fixed 520-byte buffer (519 usable chars + null terminator, with a few bytes of margin - see
 * SYMBOL_NAME_BUFFER_CAPACITY below). Field order/sizes below follow the documented struct layout; ULONG fields
 * are 4 bytes (Spice `unsigned int`), ULONG64 fields are 8 bytes (Spice `unsigned long`, always 64-bit
 * regardless of platform - see docs/docs/language/primitive-types.md), and struct layout is otherwise assumed
 * to follow ordinary C alignment rules (matching every other FFI struct in std/, e.g. HostEnt/SockAddrIn/
 * DirEntry), so no explicit padding fields are added here.
 */
type SymbolInfo struct {
    unsigned int  sizeOfStruct
    unsigned int  typeIndex
    unsigned long reserved0
    unsigned long reserved1
    unsigned int  index
    unsigned int  size
    unsigned long modBase
    unsigned int  flags
    unsigned long value
    unsigned long address
    unsigned int  registerNum
    unsigned int  scope
    unsigned int  tag
    unsigned int  nameLen
    unsigned int  maxNameLen
    char[520] name
}

// sizeof(SYMBOL_INFO) as declared by <dbghelp.h> on a 64-bit build - the fixed header only (through the single
// placeholder byte of 'Name[1]'), rounded up to the struct's own 8-byte alignment. SymFromAddr() documents that
// SizeOfStruct must carry this value, not sizeof(our expanded SymbolInfo) - that would include the whole 520-byte
// name buffer, which is not what the API expects there.
const unsigned int SYMBOL_INFO_SIZE = 88u;
// Capacity passed as maxNameLen: one byte under the 520-byte buffer's actual size, as a margin of safety against
// an off-by-one in how many bytes SymFromAddr() writes for a given maxNameLen (including the null terminator).
const unsigned int SYMBOL_NAME_BUFFER_CAPACITY = 511u;

ext f<byte*> GetCurrentProcess();
// Its return value is intentionally ignored where called below (the #[ignoreUnusedReturnValue] attribute exists
// for exactly this, but only targets function/procedure/lambda definitions, not ext declarations - so this just
// accepts the harmless unused-return-value warning instead): SymInitialize() fails harmlessly if the process was
// already initialized (which it will be on every call after the first), and that's not distinguishable here from
// a real failure worth handling - either way, the subsequent SymFromAddr() call already fails gracefully on its
// own.
ext f<bool> SymInitialize(byte* /*hProcess*/, byte* /*userSearchPath*/, bool /*fInvadeProcess*/);
ext f<bool> SymFromAddr(byte* /*hProcess*/, byte* /*address*/, unsigned long* /*displacement*/, SymbolInfo* /*symbol*/);

/**
 * Prints every recorded frame of this trace to stderr, resolving each address to a symbol name via SymFromAddr()
 * where possible and falling back to a fixed placeholder otherwise. A no-op if nothing was captured.
 *
 * @param includeAddresses Whether to print each frame's raw address alongside its resolved name. Off by default
 *                          makes the output deterministic (addresses vary run to run due to ASLR/PIE and are not
 *                          meaningful to compare in a test), which is what a caller that wants to assert on
 *                          dump()'s exact output should pass.
 */
public p StackTraceBuffer.dump(bool includeAddresses = true) {
    if this.count == 0 { return; }

    unsafe {
        byte* process = GetCurrentProcess();
        SymInitialize(process, nil<byte*>, true);

        fprintf(__stderr(), "Stack trace:\n");
        for int i = 0; i < this.count; i++ {
            byte* address = this.addresses[i];
            SymbolInfo info;
            info.sizeOfStruct = SYMBOL_INFO_SIZE;
            info.maxNameLen = SYMBOL_NAME_BUFFER_CAPACITY;

            if SymFromAddr(process, address, nil<unsigned long*>, &info) {
                if includeAddresses {
                    fprintf(__stderr(), "  #%d  %p  %s\n", i, address, info.name);
                } else {
                    fprintf(__stderr(), "  #%d  %s\n", i, info.name);
                }
                continue;
            }

            if includeAddresses {
                fprintf(__stderr(), "  #%d  %p\n", i, address);
            } else {
                fprintf(__stderr(), "  #%d  <unknown>\n", i);
            }
        }
    }
}

/**
 * Captures and immediately dumps the calling function's stack trace to stderr - the one-call convenience entry
 * point, auto-imported like the other 's'-prefixed runtime functions (see RuntimeModuleManager.h). Skips its own
 * frame, so the first printed frame is the call site of sDumpStacktrace() itself.
 *
 * @param includeAddresses Forwarded to dump() - see there.
 */
public p sDumpStacktrace(bool includeAddresses = true) {
    StackTraceBuffer trace;
    trace.capture(1);
    trace.dump(includeAddresses);
}
