#![core.compiler.alwaysKeepOnNameCollision = true]

// Stack trace capture via frame-pointer walking, plus best-effort symbol resolution. Relies on the
// compiler-internal __frame_address() builtin (src/irgenerator/GenBuiltinFunctions.cpp), which lowers to LLVM's
// target-independent 'llvm.frameaddress' intrinsic and hands back the calling function's own frame address - the
// same value as C's `__builtin_frame_address(0)`. From there, the walk itself is plain Spice: on every supported
// target and ABI (x86-64 System V, AArch64 AAPCS, ...) the first pointer-sized slot at a frame address holds the
// caller's saved frame pointer and the next slot holds the return address, so following that chain one hop at a
// time recovers the call stack without any further compiler support. This only works because IRGenerator
// unconditionally keeps frame pointers for every function (see the `module->setFramePointer(...)` call in
// IRGenerator.cpp) - omitting them would break the chain.
//
// This one file is shared across every target - unlike most other OS-specific std runtime pieces, it does NOT
// have an OS-suffixed sibling of its own. Only symbol resolution actually differs per platform (POSIX's
// dladdr() vs Windows' DbgHelp), and Spice requires a method to be declared in the same file as its struct, so
// dump() itself can't be split across an OS-suffixed pair of files the way the struct/capture()/dump() trio
// would need to be as a whole. Instead, dump() delegates just that one piece to the ordinary (non-method)
// resolveSymbolName() function, imported below - ordinary functions face no such restriction, so THAT import
// resolves to stack_trace_symbol_rt.spice or stack_trace_symbol_rt_windows.spice as appropriate, exactly like an
// import anywhere else would. See whichever of those applies for that platform's resolution details/caveats.
//
// This split also matters beyond code reuse: sDumpStacktrace() is reachable two ways - an explicit
// `import "std/runtime/stack_trace_rt"`, which the compiler's OS-suffixed import resolution handles correctly,
// and auto-import by name via RuntimeModuleManager (see RuntimeModuleManager.cpp's loadModule()), which builds
// its file path directly and does NOT apply OS-suffixing. Before this split, an earlier stack_trace_rt.spice /
// stack_trace_rt_windows.spice pair meant those two paths could each load a *different* file - on Windows,
// auto-import kept pulling in the POSIX file regardless of target, and if something in the same program also
// imported the file explicitly, both ended up compiled and linked together, which failed with a real
// "duplicate symbol: sDumpStacktrace()" linker error in CI. With a single, unsuffixed main file, both paths
// always resolve to the same file, so that can't happen.

import "std/runtime/stack_trace_symbol_rt";

ext f<int> fprintf(byte* /*stream*/, string /*format*/, ...);

const int STACK_TRACE_CAPACITY = 64;

/**
 * Fixed-capacity buffer holding one captured stack trace, as raw return addresses (most recent call first).
 * Once the capacity above is hit, the walk stops early - deeper frames are silently dropped rather than
 * overwriting the ones closest to the capture point, which are the most relevant for diagnostics.
 */
public type StackTraceBuffer struct {
    public byte*[STACK_TRACE_CAPACITY] addresses
    public int count
}

/**
 * Captures the stack trace of the calling function. The first recorded address is the calling function's own
 * current instruction pointer (i.e. the return address capture() will resume at), not one of its parents' - so
 * by default the trace starts exactly at the call site of capture() itself.
 *
 * The chain's outermost frame is a sentinel, conventionally marked by a zeroed saved-frame-pointer field - but
 * on at least one observed platform (macOS/AArch64) its return-address field reads zero too, one hop before the
 * saved-frame-pointer field does. So termination is checked on the return-address value about to be recorded,
 * not only on the frame pointer itself - a zero return address means this frame is (or already looks like) the
 * sentinel, and the walk stops without recording it, rather than recording a bogus nil entry.
 *
 * @param skipFrames Number of additional frames to omit above the direct caller, for wrapper functions like
 *                    sDumpStacktrace() that call capture() on a caller's behalf and want their own frame hidden.
 */
public p StackTraceBuffer.capture(int skipFrames = 0) {
    this.count = 0;

    unsafe {
        byte** frame = cast<byte**>(__frame_address());

        while skipFrames > 0 && frame != nil<byte**> {
            frame = cast<byte**>(frame[0]);
            skipFrames--;
        }

        while frame != nil<byte**> && this.count < STACK_TRACE_CAPACITY {
            byte* returnAddress = frame[1];
            if returnAddress == nil<byte*> {
                break; // sentinel frame - no real caller above this, stop without recording it
            }
            this.addresses[this.count] = returnAddress;
            this.count++;
            frame = cast<byte**>(frame[0]); // saved frame pointer of the parent frame
        }
    }
}

/**
 * Prints every recorded frame of this trace to stderr, resolving each address to a symbol name via
 * resolveSymbolName() where possible and falling back to a fixed placeholder otherwise (see
 * stack_trace_symbol_rt.spice for why that is common for a Spice program's own frames today). A no-op if
 * nothing was captured.
 *
 * No offset from the symbol's own start address is printed alongside the name: Spice has no pointer<->integer
 * cast and no pointer-difference operator today (only pointer +/- integer, which computes a new pointer, not a
 * numeric difference), so there is currently no way to compute one in Spice itself.
 *
 * @param includeAddresses Whether to print each frame's raw address alongside its resolved name. Defaults to true;
 *                          pass false for deterministic output, since addresses vary run to run due to ASLR/PIE
 *                          and are not meaningful to compare in a test.
 */
public p StackTraceBuffer.dump(bool includeAddresses = true) {
    if this.count == 0 { return; }

    fprintf(__stderr(), "Stack trace:\n");
    for int i = 0; i < this.count; i++ {
        byte* address = this.addresses[i];
        const String name = resolveSymbolName(address);
        if !name.isEmpty() {
            if includeAddresses {
                fprintf(__stderr(), "  #%d  %p  %s\n", i, address, name.getRaw());
            } else {
                fprintf(__stderr(), "  #%d  %s\n", i, name.getRaw());
            }
            continue;
        }
        if includeAddresses {
            fprintf(__stderr(), "  #%d  %p\n", i, address);
        } else {
            fprintf(__stderr(), "  #%d  <unknown>\n", i);
        }
    }
}

/**
 * Captures and immediately dumps the calling function's stack trace to stderr - the one-call convenience entry
 * point, auto-imported like the other 's'-prefixed runtime functions (see RuntimeModuleManager.h). Skips its own
 * frame, so the first printed frame is the call site of sDumpStacktrace() itself.
 *
 * @param includeAddresses Forwarded to dump() - see there.
 */
public p sDumpStacktrace(bool includeAddresses = true) {
    StackTraceBuffer trace;
    trace.capture(1);
    trace.dump(includeAddresses);
}
