#![core.compiler.alwaysKeepOnNameCollision = true]

// Stack traces: capturing them, resolving each frame to a symbol, and printing them.
//
// Both halves of the job are done by libbacktrace, through stack_trace_native_rt.spice - see there for what the
// library does. It behaves the same on every platform Spice targets, so unlike the hand-written unwinder and symbol
// resolver it replaced, this file has no OS-suffixed siblings and must not gain any: sDumpStacktrace() and
// sGetStacktrace() are reachable both through an explicit import and through auto-import by name
// (RuntimeModuleManager), and only the former applies OS-suffixing. Were this file suffixed, the two paths could
// load different copies and collide at link time.
//
// Resolving a frame to a name needs the executable's symbol table, which the linker keeps unless the build asked
// for '--strip-symbols'; in a stripped executable every frame prints as '<unknown>'. File and line numbers need
// more than that - they come from debug line info, so they only show up in a build made with '--debug-info=line-only'
// or '--debug-info=full' / '-g'.

import "std/iterator/iterable";
import "std/iterator/iterator";
import "std/data/pair";
import "std/text/demangle";
import "std/data/vector";
import "std/runtime/stack_trace_native_rt";

// Add generic type definitions. 'T' is always StackTraceEntry - a trace has exactly one kind of element - but
// the language requires an iterator to carry its item type as a generic argument, so StackTraceIterator below
// takes one rather than naming the type directly.
type T dyn;
type Numeric int|long|short;

ext f<int> fprintf(byte* /*stream*/, string /*format*/, ...);

// Frames captured per trace. Deeper ones are dropped, since the frames nearest the capture point matter most.
public const int STACK_TRACE_CAPACITY = 128;
// Frames of the stack trace runtime itself between libbacktrace and the caller: captureNativeFrames() and capture().
// Exact because Spice emits one object file per source file and stack_trace_native_rt.spice is a translation unit
// of its own, so neither can be inlined into the caller; '-lto' lifts that guarantee and can shift a trace outwards
// by a frame.
const int RUNTIME_FRAMES = 2;
// Extension of Spice source files, which is what tells a frame in Spice code apart when the program carries debug info
const string SPICE_SOURCE_EXTENSION = ".spice";
// The one Spice function whose symbol is never mangled, since the operating system calls it by that name
const string ENTRY_POINT_NAME = "main";

/**
 * One frame of a stack trace.
 */
public type StackTraceEntry struct {
    public byte* address           // return address within the function
    public unsigned long offset    // bytes from the start of that function, 0 if unresolved
    public String functionName     // demangled, empty if the symbol could not be resolved
    public String fileName         // source file, empty unless the program carries debug info
    public unsigned int lineNumber // line within that file, 0 if unknown
    public bool isSpice            // Spice code, as opposed to C, C++ or other native code; false if it could not be told
}

/**
 * Decides whether a frame belongs to Spice code, as opposed to native code the program links against - the C
 * runtime, C functions called from Spice, the C++ runtime and so on.
 *
 * Debug info is the more reliable witness, so it is asked first: a frame with a source file is Spice exactly when
 * that file is a '.spice' one. This also settles frames of C libraries whose distribution ships debug info. Without
 * it, the symbol name is all there is. Every Spice function is mangled, which the demangler can tell by whether
 * it managed to read the name, except 'main', the one function Spice leaves as it is. Names the demangler does not
 * understand, be they plain C symbols or the mangling of another language, count as native. So does a frame
 * without any name at all, since there is nothing to go by - which includes every frame of an executable built
 * with '--strip-symbols'. A Spice function opted out of mangling with #[core.compiler.mangle = false] cannot be
 * told from a C one without debug info and counts as native there.
 *
 * @param symbolName Name of the function as found in the symbol table or debug info, still mangled
 * @param demangledName The same name, run through demangle()
 * @param fileName Source file of the frame, empty if the program carries no debug info
 * @return Whether the frame is Spice code
 */
f<bool> isSpiceFrame(const String& symbolName, const String& demangledName, const String& fileName) {
    if !fileName.isEmpty() {
        return fileName.endsWith(SPICE_SOURCE_EXTENSION);
    }
    if symbolName.isEmpty() {
        return false;
    }
    return demangledName != symbolName || symbolName == ENTRY_POINT_NAME;
}

/**
 * Prints this frame to stderr, as '#<index>  <address>  <name> + 0x<offset> at <file>:<line>'. The location is left out
 * when the program carries no debug info; frames whose symbol could not be resolved print '<unknown>' in place of the
 * name and carry no offset.
 *
 * @param frameIndex Position of this frame in its trace, counted from the most recent call
 * @param includeAddress Whether to print the raw address. Pass false for deterministic output - addresses move
 *                       between runs under ASLR/PIE.
 */
public p StackTraceEntry.dump(unsigned long frameIndex, bool includeAddress = true) {
    const byte* stream = __stderr();

    // Left-aligned in a field of three, so the columns behind it line up for every index a trace can reach
    fprintf(stream, "  #%-3lu", frameIndex);
    if includeAddress {
        fprintf(stream, "%p  ", this.address);
    }
    if this.functionName.isEmpty() {
        fprintf(stream, "<unknown>");
    } else {
        fprintf(stream, "%s + %#lx", this.functionName.getRaw(), this.offset);
    }
    if !this.fileName.isEmpty() {
        fprintf(stream, " at %s:%u", this.fileName.getRaw(), this.lineNumber);
    }
    fprintf(stream, "\n");
}

/**
 * A captured stack trace: the frames of one call stack, most recent call first.
 */
public type StackTrace struct : IIterable<StackTraceEntry> {
    Vector<StackTraceEntry> entries
}

/**
 * Retrieve number of frames in this trace.
 *
 * @return Number of frames
 */
public inline f<long> StackTrace.getSize() {
    return this.entries.getSize();
}

/**
 * Check if this trace is empty.
 *
 * @return Empty or not
 */
public inline f<bool> StackTrace.isEmpty() {
    return this.entries.isEmpty();
}

/**
 * Retrieve frame at the given index, counted from the most recent call.
 *
 * @return Frame at the given index
 */
public inline f<StackTraceEntry&> StackTrace.getEntry(unsigned long index) {
    return this.entries.get(index);
}

/**
 * Retrieve frame at the given index, counted from the most recent call.
 *
 * @return Frame at the given index
 */
public inline f<StackTraceEntry&> operator[](StackTrace& trace, unsigned long index) {
    return trace.getEntry(index);
}

/**
 * Captures the stack of the calling function, resolving each frame as it goes. In an optimized build a function
 * that was inlined into another still gets a frame of its own, since libbacktrace recovers it from the debug
 * info; its offset is then counted from the start of the function it was inlined into.
 *
 * @param skipFrames Frames to omit above the direct caller, for wrappers that capture on a caller's behalf
 */
public p StackTrace.capture(unsigned int skipFrames = 0u) {
    this.entries.clear(); // cleared first, so an early return below cannot leave a previous trace behind

    NativeStackFrame[STACK_TRACE_CAPACITY] frames;

    // The runtime's own frames are physical and are dropped as such; the caller's skip counts the entries
    // it would otherwise see, which is not the same number once debug info expands an inlined frame
    unsigned int frameCount = captureNativeFrames(&frames[0], STACK_TRACE_CAPACITY, RUNTIME_FRAMES, skipFrames);

    this.entries.reserve(cast<unsigned long>(frameCount));
    for unsigned int i = 0u; i < frameCount; i++ {
        const byte* address = frames[i].address;
        const unsigned long offset = frames[i].offset;
        // The names are heap-allocated C strings, which are copied and then released
        const String symbolName = String(frames[i].functionName != nil<string> ? frames[i].functionName : "");
        const String functionName = demangle(symbolName);
        const String fileName = String(frames[i].fileName != nil<string> ? frames[i].fileName : "");
        const unsigned int lineNumber = frames[i].lineNumber;
        const bool isSpice = isSpiceFrame(symbolName, functionName, fileName);
        this.entries.pushBack(StackTraceEntry{address, offset, functionName, fileName, lineNumber, isSpice});
        releaseNativeFrame(frames[i]);
    }
}

/**
 * Prints the whole trace to stderr, one line per frame, numbered from '#0' at the most recent call. A no-op when
 * nothing was captured.
 *
 * @param includeAddresses Forwarded to StackTraceEntry.dump()
 * @param hideNonSpiceFrames Leave out the frames that are not Spice code (see StackTraceEntry.isSpice), such as the
 *                           C runtime below main. The frames that remain keep the number they have in the trace, so
 *                           a gap in the numbering marks where frames were hidden, and every number still matches
 *                           getEntry().
 */
public p StackTrace.dump(bool includeAddresses = true, bool hideNonSpiceFrames = false) {
    if this.isEmpty() { return; }

    fprintf(__stderr(), "Stack trace:\n");
    foreach unsigned long frameIndex, const StackTraceEntry& entry : this.entries {
        if hideNonSpiceFrames && !entry.isSpice { continue; }
        entry.dump(frameIndex, includeAddresses);
    }
}

/**
 * Iterator over the frames of a stack trace, most recent call first.
 *
 * A trace hands this out rather than the iterator of the Vector it currently keeps its frames in, so that how a
 * trace stores them stays its own business. 'T' is always StackTraceEntry - see the type definitions at the top
 * of this file for why it is spelled as a generic argument at all.
 */
public type StackTraceIterator<T> struct : IIterator<StackTraceEntry> {
    StackTrace& trace
    unsigned long cursor = 0l
}

/**
 * Construct a stack trace iterator over the given trace
 *
 * @param trace Stack trace to iterate over
 */
public p StackTraceIterator.ctor(StackTrace& trace) {
    this.trace = trace;
}

/**
 * Returns the current frame of the trace
 *
 * @return Reference to the current frame
 */
public inline f<StackTraceEntry&> StackTraceIterator.get() {
    return this.trace.getEntry(this.cursor);
}

/**
 * Returns the current frame number and the current frame of the trace
 *
 * @return Pair of current frame number and reference to the current frame
 */
public inline f<Pair<unsigned long, StackTraceEntry&>> StackTraceIterator.getIdx() {
    StackTraceEntry& entry = this.trace.getEntry(this.cursor);
    return Pair<unsigned long, StackTraceEntry&>(this.cursor, entry);
}

/**
 * Check if the iterator is valid
 *
 * @return true or false
 */
public inline f<bool> StackTraceIterator.isValid() {
    return this.cursor < this.trace.getSize();
}

/**
 * Moves the cursor to the next frame
 */
public inline p StackTraceIterator.next() {
    if !this.isValid() {
        panic(Error("Calling next() on invalid iterator"));
    }
    this.cursor++;
}

/**
 * Advances the cursor by one
 *
 * @param it StackTraceIterator
 */
public inline p operator++<T>(StackTraceIterator<T>& it) {
    if it.cursor >= it.trace.getSize() {
        panic(Error("Iterator out of bounds"));
    }
    it.cursor++;
}

/**
 * Move the cursor back by one
 *
 * @param it StackTraceIterator
 */
public inline p operator--<T>(StackTraceIterator<T>& it) {
    if it.cursor <= 0l {
        panic(Error("Iterator out of bounds"));
    }
    it.cursor--;
}

/**
 * Advances the cursor by the given offset
 *
 * @param it StackTraceIterator
 * @param offset Offset
 */
public inline p operator+=<T, Numeric>(StackTraceIterator<T>& it, Numeric offset) {
    if it.cursor + offset >= it.trace.getSize() || it.cursor + offset < 0l {
        panic(Error("Iterator out of bounds"));
    }
    it.cursor += offset;
}

/**
 * Move the cursor back by the given offset
 *
 * @param it StackTraceIterator
 * @param offset Offset
 */
public inline p operator-=<T, Numeric>(StackTraceIterator<T>& it, Numeric offset) {
    if it.cursor - offset >= it.trace.getSize() || it.cursor - offset < 0l {
        panic(Error("Iterator out of bounds"));
    }
    it.cursor -= offset;
}

/**
 * Retrieve a forward iterator over the frames of this trace, so it can be walked with a foreach loop
 */
public f<StackTraceIterator<StackTraceEntry>> StackTrace.getIterator() {
    return StackTraceIterator<StackTraceEntry>(*this);
}

/**
 * Returns the calling function's stack trace. Auto-imported like the other 's'-prefixed runtime functions, so
 * it needs no explicit import.
 */
public f<StackTrace> sGetStacktrace() {
    StackTrace trace;
    trace.capture(1); // hide this function's own frame
    return trace;
}

/**
 * Captures and immediately dumps the calling function's stack trace to stderr.
 *
 * @param includeAddresses Forwarded to StackTrace.dump()
 * @param hideNonSpiceFrames Forwarded to StackTrace.dump()
 */
public p sDumpStacktrace(bool includeAddresses = true, bool hideNonSpiceFrames = false) {
    StackTrace trace;
    trace.capture(1); // hide this function's own frame
    trace.dump(includeAddresses, hideNonSpiceFrames);
}
