#![core.compiler.alwaysKeepOnNameCollision = true]

// Stack traces: capturing them, resolving each frame to a symbol, and printing them.
//
// The two halves that differ per platform - capturing the frames and resolving an address to a name - live in
// their own OS-suffixed files, imported below. Spice requires a method to live in the same file as its struct,
// so the methods here delegate to ordinary functions, which face no such restriction.
//
// This file itself has no OS-suffixed sibling, and must not gain one: sDumpStacktrace() and sGetStacktrace()
// are reachable both through an explicit import and through auto-import by name (RuntimeModuleManager), and
// only the former applies OS-suffixing. Were this file suffixed, the two paths could load different copies and
// collide at link time.

import "std/runtime/stack_trace_symbol_rt";
import "std/runtime/stack_trace_capture_rt";
import "std/runtime/stack_trace_libbacktrace_rt";
import "std/text/demangle";
import "std/data/vector";

ext f<int> fprintf(byte* /*stream*/, string /*format*/, ...);

// Frames captured per trace. Deeper ones are dropped, since the frames nearest the capture point matter most.
public const int STACK_TRACE_CAPACITY = 64;
// Frames of the stack trace runtime itself between the unwinder and the caller: captureReturnAddresses() and
// capture(). Exact because Spice emits one object file per source file, so neither can be inlined into the
// caller; '-lto' lifts that guarantee and can shift a trace outwards by a frame or two.
const int RUNTIME_FRAMES = 2;

/**
 * One frame of a stack trace.
 */
public type StackTraceEntry struct {
    public byte* address          // return address within the function
    public unsigned long offset   // bytes from the start of that function, 0 if unresolved
    public String functionName    // demangled, empty if the symbol could not be resolved
}

/**
 * Prints this frame to stderr, as 'address  name + 0xoffset'. Frames whose symbol could not be resolved print
 * '<unknown>' in place of the name and carry no offset.
 *
 * @param includeAddress Whether to print the raw address. Pass false for deterministic output - addresses move
 *                        between runs under ASLR/PIE.
 */
public p StackTraceEntry.dump(bool includeAddress = true) {
    if includeAddress {
        fprintf(__stderr(), "  %p  ", this.address);
    } else {
        fprintf(__stderr(), "  ");
    }
    if this.functionName.isEmpty() {
        fprintf(__stderr(), "<unknown>\n");
    } else {
        fprintf(__stderr(), "%s + %#lx\n", this.functionName.getRaw(), this.offset);
    }
}

/**
 * A captured stack trace: the frames of one call stack, most recent call first.
 */
public type StackTrace struct {
    Vector<StackTraceEntry> entries
}

/**
 * Number of frames in this trace.
 */
public inline f<long> StackTrace.getSize() {
    return this.entries.getSize();
}

public inline f<bool> StackTrace.isEmpty() {
    return this.entries.isEmpty();
}

/**
 * Frame at the given index, counted from the most recent call.
 */
public inline f<StackTraceEntry&> StackTrace.getEntry(unsigned long index) {
    return this.entries.get(index);
}

public inline f<StackTraceEntry&> operator[](StackTrace& trace, unsigned long index) {
    return trace.getEntry(index);
}

/**
 * Captures the stack of the calling function, resolving each frame as it goes.
 *
 * @param skipFrames Frames to omit above the direct caller, for wrappers that capture on a caller's behalf
 */
public p StackTrace.capture(int skipFrames = 0) {
    this.entries.clear(); // cleared first, so an early return below cannot leave a previous trace behind

    // A negative skip would cancel out RUNTIME_FRAMES and start the trace inside the stack trace runtime itself
    if skipFrames < 0 {
        return;
    }

    byte*[STACK_TRACE_CAPACITY] addresses;
    int frameCount = 0;
    unsafe {
        frameCount = captureReturnAddresses(&addresses[0], STACK_TRACE_CAPACITY, RUNTIME_FRAMES + skipFrames);
    }

    this.entries.reserve(cast<unsigned long>(frameCount));
    for int i = 0; i < frameCount; i++ {
        // Behind '--keep-symbol-table', libbacktrace resolves this program's own functions exactly, including
        // ones the platform's own resolver cannot see - reading the symbol table directly out of the
        // executable file (ELF/Mach-O/PE-COFF) rather than through dladdr()/.dynsym or a DbgHelp-read PDB.
        // Falls through to resolveSymbol() whenever it can't: the flag is off, or there is no prebuilt
        // libbacktrace archive for this target (see stack_trace_libbacktrace_rt.spice).
        SymbolLookup symbol = resolveFromLibbacktrace(addresses[i]);
        if !symbol.resolved {
            symbol = resolveSymbol(addresses[i]);
        }
        String name = String();
        if symbol.resolved {
            name = demangle(symbol.name);
        }
        this.entries.pushBack(StackTraceEntry{addresses[i], symbol.offset, name});
    }
}

/**
 * Prints the whole trace to stderr, one line per frame. A no-op when nothing was captured.
 *
 * @param includeAddresses Forwarded to StackTraceEntry.dump()
 */
public p StackTrace.dump(bool includeAddresses = true) {
    if this.isEmpty() { return; }

    fprintf(__stderr(), "Stack trace:\n");
    foreach StackTraceEntry& entry : this.entries {
        entry.dump(includeAddresses);
    }
}

/**
 * Returns the calling function's stack trace. Auto-imported like the other 's'-prefixed runtime functions, so
 * it needs no explicit import.
 */
public f<StackTrace> sGetStacktrace() {
    StackTrace trace;
    trace.capture(1); // hide this function's own frame
    return trace;
}

/**
 * Captures and immediately dumps the calling function's stack trace to stderr.
 *
 * @param includeAddresses Forwarded to StackTrace.dump()
 */
public p sDumpStacktrace(bool includeAddresses = true) {
    StackTrace trace;
    trace.capture(1); // hide this function's own frame
    trace.dump(includeAddresses);
}
