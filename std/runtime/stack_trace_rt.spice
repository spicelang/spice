#![core.compiler.alwaysKeepOnNameCollision = true]

// Stack trace capture via frame-pointer walking, plus best-effort symbol resolution. Relies on the
// compiler-internal __frame_address() builtin (src/irgenerator/GenBuiltinFunctions.cpp), which lowers to LLVM's
// target-independent 'llvm.frameaddress' intrinsic and hands back the calling function's own frame address - the
// same value as C's `__builtin_frame_address(0)`. From there, the walk itself is plain Spice: on every supported
// target and ABI (x86-64 System V, AArch64 AAPCS, ...) the first pointer-sized slot at a frame address holds the
// caller's saved frame pointer and the next slot holds the return address, so following that chain one hop at a
// time recovers the call stack without any further compiler support. This only works because IRGenerator
// unconditionally keeps frame pointers for every function (see the `module->setFramePointer(...)` call in
// IRGenerator.cpp) - omitting them would break the chain.
//
// Symbol resolution goes through the libc/POSIX dladdr(), which looks addresses up in the dynamic symbol table
// (.dynsym) of whichever loaded object contains them - not the full static symbol table, and not debug info.
// Spice does not link its executables with -rdynamic/--export-dynamic, so a Spice program's own functions are
// typically NOT present in .dynsym: dladdr() will usually resolve addresses that land in a dynamically linked
// library (e.g. libc), but not the caller's own Spice-level frames. Until Spice exports its own symbols (or grows
// a dedicated PC->function table), dump() falls back to the raw address whenever dladdr() can't name a symbol.
//
// This file is the default (POSIX) implementation. Windows has no dladdr(), so it gets its own variant,
// stack_trace_rt_windows.spice, picked up automatically by the compiler's OS-suffixed import resolution - see
// that file for what differs.

ext f<int> fprintf(byte* /*stream*/, string /*format*/, ...);

const int STACK_TRACE_CAPACITY = 64;

/**
 * Mirrors libc's 'Dl_info' (<dlfcn.h>), field for field, so it can be passed to dladdr() by pointer.
 */
type DlInfo struct {
    string dliFName // Pathname of the shared object that contains the address
    byte*  dliFBase // Base address at which the shared object is loaded
    string dliSName // Name of the nearest symbol with an address <= the given one, nil if none was found
    byte*  dliSAddr // Exact address of that symbol
}

ext f<int> dladdr(byte* /*addr*/, DlInfo* /*info*/);

/**
 * Fixed-capacity buffer holding one captured stack trace, as raw return addresses (most recent call first).
 * Once the capacity above is hit, the walk stops early - deeper frames are silently dropped rather than
 * overwriting the ones closest to the capture point, which are the most relevant for diagnostics.
 */
public type StackTraceBuffer struct {
    public byte*[STACK_TRACE_CAPACITY] addresses
    public int count
}

/**
 * Captures the stack trace of the calling function. The first recorded address is the calling function's own
 * current instruction pointer (i.e. the return address capture() will resume at), not one of its parents' - so
 * by default the trace starts exactly at the call site of capture() itself.
 *
 * @param skipFrames Number of additional frames to omit above the direct caller, for wrapper functions like
 *                    sDumpStacktrace() that call capture() on a caller's behalf and want their own frame hidden.
 */
public p StackTraceBuffer.capture(int skipFrames = 0) {
    this.count = 0;

    unsafe {
        byte** frame = cast<byte**>(__frame_address());

        while skipFrames > 0 && frame != nil<byte**> {
            frame = cast<byte**>(frame[0]);
            skipFrames--;
        }

        while frame != nil<byte**> && this.count < STACK_TRACE_CAPACITY {
            this.addresses[this.count] = frame[1]; // return address for this frame
            this.count++;
            frame = cast<byte**>(frame[0]); // saved frame pointer of the parent frame
        }
    }
}

/**
 * Prints every recorded frame of this trace to stderr, resolving each address to a symbol name via dladdr()
 * where possible and falling back to a fixed placeholder otherwise (see the file-level comment on why that is
 * common for a Spice program's own frames today). A no-op if nothing was captured.
 *
 * No offset from the symbol's own start address is printed alongside the name: Spice has no pointer<->integer
 * cast and no pointer-difference operator today (only pointer +/- integer, which computes a new pointer, not a
 * numeric difference), so there is currently no way to compute one from dliSAddr/address in Spice itself.
 *
 * @param includeAddresses Whether to print each frame's raw address alongside its resolved name. Off by default
 *                          makes the output deterministic (addresses vary run to run due to ASLR/PIE and are not
 *                          meaningful to compare in a test), which is what a caller that wants to assert on
 *                          dump()'s exact output should pass.
 */
public p StackTraceBuffer.dump(bool includeAddresses = true) {
    if this.count == 0 { return; }

    fprintf(__stderr(), "Stack trace:\n");
    for int i = 0; i < this.count; i++ {
        byte* address = this.addresses[i];
        DlInfo info;
        unsafe {
            if dladdr(address, &info) != 0 && cast<char*>(info.dliSName) != nil<char*> {
                if includeAddresses {
                    fprintf(__stderr(), "  #%d  %p  %s\n", i, address, info.dliSName);
                } else {
                    fprintf(__stderr(), "  #%d  %s\n", i, info.dliSName);
                }
                continue;
            }
        }
        if includeAddresses {
            fprintf(__stderr(), "  #%d  %p\n", i, address);
        } else {
            fprintf(__stderr(), "  #%d  <unknown>\n", i);
        }
    }
}

/**
 * Captures and immediately dumps the calling function's stack trace to stderr - the one-call convenience entry
 * point, auto-imported like the other 's'-prefixed runtime functions (see RuntimeModuleManager.h). Skips its own
 * frame, so the first printed frame is the call site of sDumpStacktrace() itself.
 *
 * @param includeAddresses Forwarded to dump() - see there.
 */
public p sDumpStacktrace(bool includeAddresses = true) {
    StackTraceBuffer trace;
    trace.capture(1);
    trace.dump(includeAddresses);
}
