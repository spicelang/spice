#![core.compiler.alwaysKeepOnNameCollision = true]
#![core.windows.linker.flag = "-ldbghelp"]

// Windows variant of stack_trace_symbol_rt.spice - see that file for how the OS-suffixed import picks between
// the two.
//
// DbgHelp's SymFromAddr() resolves via loaded debug info rather than an export table, so it does not depend on
// symbols being exported. It does depend on debug info being available for the running executable:
// SymInitialize(..., fInvadeProcess=TRUE) loads it from the module's own PDB when one sits next to the binary.
//
// CAUTION: SymbolInfo below mirrors DbgHelp's SYMBOL_INFO (<dbghelp.h>), a padded C struct with a documented
// quirk - 'SizeOfStruct' must be sizeof(SYMBOL_INFO) *without* the trailing name buffer. It was written from
// documented field order and sizes, not checked against a real <dbghelp.h>, so verify the offsets on a Windows
// machine before relying on it.

import "std/runtime/string_rt";

/**
 * Mirrors the fixed header of DbgHelp's SYMBOL_INFO (<dbghelp.h>), with the flexible 'Name[1]' member expanded
 * into a fixed buffer. ULONG fields are 4 bytes ('unsigned int'), ULONG64 fields 8 ('unsigned long', always
 * 64-bit in Spice); layout otherwise follows ordinary C alignment, as every other FFI struct in std/ does.
 */
type SymbolInfo struct {
    unsigned int  sizeOfStruct
    unsigned int  typeIndex
    unsigned long reserved0
    unsigned long reserved1
    unsigned int  index
    unsigned int  size
    unsigned long modBase
    unsigned int  flags
    unsigned long value
    unsigned long address
    unsigned int  registerNum
    unsigned int  scope
    unsigned int  tag
    unsigned int  nameLen
    unsigned int  maxNameLen
    char[520] name
}

// SizeOfStruct must be sizeof(SYMBOL_INFO) as <dbghelp.h> declares it - the fixed header through the single
// placeholder byte of 'Name[1]', 8-byte aligned - not the size of the expanded struct above.
const unsigned int SYMBOL_INFO_SIZE = 88u;
// maxNameLen, kept under the buffer's real size as margin against an off-by-one in what SymFromAddr() writes.
const unsigned int SYMBOL_NAME_BUFFER_CAPACITY = 511u;

ext f<byte*> GetCurrentProcess();
ext f<bool> SymInitialize(byte* /*hProcess*/, byte* /*userSearchPath*/, bool /*fInvadeProcess*/);
ext f<bool> SymFromAddr(byte* /*hProcess*/, byte* /*address*/, unsigned long* /*displacement*/, SymbolInfo* /*symbol*/);
// Ordinary kernel32 exports (<synchapi.h>), used below as a lock around SymInitialize()/SymFromAddr(). The
// Interlocked* family is not usable here: MinGW's import library has no such symbol, since those are normally
// folded into a machine instruction rather than a real call.
ext p AcquireSRWLockExclusive(long* /*srwLock*/);
ext p ReleaseSRWLockExclusive(long* /*srwLock*/);

// DbgHelp documents that a second SymInitialize() without an intervening SymCleanup() is invalid, so this keeps
// initialization to one call across the many resolveSymbol() calls a trace dump makes. Capitalized because
// Spice's grammar requires every global variable name to start with an uppercase letter.
bool SymInitialized = false;
// Backing storage for a Windows SRWLOCK, guarding SymInitialize() and SymFromAddr(): DbgHelp is not safe to
// call from several threads at once, and SymInitialized above is a plain non-atomic flag. An SRWLOCK is valid
// once zero-initialized and is pointer-sized, so a 'long' global fits it - unlike a Mutex or a pointer-typed
// global, neither of which Spice's global-variable grammar can express.
long Lock = 0l;

/**
 * Outcome of one symbol lookup. 'name' is still mangled; the caller demangles it for display.
 */
public type SymbolLookup struct {
    public String name
    public unsigned long offset
    public bool resolved
}

/**
 * Looks up the symbol containing the given address.
 *
 * @param address Address to resolve
 * @return Mangled name and byte offset into that symbol, or an unresolved result if there is no match
 */
public f<SymbolLookup> resolveSymbol(byte* address) {
    unsafe {
        AcquireSRWLockExclusive(&Lock);

        byte* process = GetCurrentProcess();
        if !SymInitialized {
            // Return value intentionally ignored: a failure here is indistinguishable from any other
            // SymInitialize() failure, and the SymFromAddr() call below already fails gracefully on its own.
            // #[ignoreUnusedReturnValue] only targets definitions, not ext declarations, so the warning stands.
            SymInitialize(process, nil<byte*>, true);
            SymInitialized = true;
        }

        SymbolInfo info;
        info.sizeOfStruct = SYMBOL_INFO_SIZE;
        info.maxNameLen = SYMBOL_NAME_BUFFER_CAPACITY;

        // SymFromAddr reports the offset into the symbol through its displacement out-parameter
        unsigned long displacement = 0l;
        const bool found = SymFromAddr(process, address, &displacement, &info);
        ReleaseSRWLockExclusive(&Lock); // release, before returning either way

        if found {
            return SymbolLookup{String(cast<string>(info.name)), displacement, true};
        }
    }
    return SymbolLookup{String(), 0l, false};
}
