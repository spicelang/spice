#![core.compiler.alwaysKeepOnNameCollision = true]

// Std imports
import "std/text/analysis";

// Link external functions
// We intentionally do not use the memory_rt here to avoid dependency circles
ext f<heap char*> malloc(unsigned long);
ext f<heap char*> realloc(heap char*, unsigned long);
ext p free(heap char*);
ext f<heap char*> memcpy(heap char*, heap char*, unsigned long);
ext f<heap char*> memmove(heap char*, heap char*, unsigned long);
ext f<int> memcmp(const heap char*, const heap char*, unsigned long);
ext f<unsigned long> strlen(string);
ext f<int> strcmp(string, string);

// Constants
const unsigned long INITIAL_ALLOC_COUNT = 5l;
const unsigned int RESIZE_FACTOR = 2;

/**
 * Heap-allocated builtin String type to enable dynamic modification in contrast
 * to the primitive string type.
 *
 * An empty String stays in an unallocated default state: `contents` is nil and
 * `capacity` is 0. The heap buffer is only allocated once the first character
 * is stored, keeping default-constructed and empty strings free of heap traffic.
 */
public type String struct {
    heap char* contents = nil<heap char*> // Pointer to the first char; nil while unallocated
    unsigned long capacity = 0l           // Allocated number of chars (without null terminator); 0 while unallocated
    unsigned long length = 0l             // Used number of chars
}

// Generic type definitions
type IntLong      int|long;
type IntLongShort int|long|short;
type StrTy        String|string;
type RawStrChar   string|char;
type StrTyChar    String|string|char;

/**
 * Construct a String from a raw string value
 *
 * @param value Initial raw string value
 */
public p String.ctor(const string value = "") {
    this.length = getRawLength(value);
    // Leave the buffer unallocated for an empty initial value
    if this.length == 0l { return; }

    this.capacity = this.length > INITIAL_ALLOC_COUNT ? this.length * RESIZE_FACTOR : INITIAL_ALLOC_COUNT;

    unsafe {
        // Allocate space for the initial number of elements
        unsigned long requiredBytes = this.capacity + 1l; // +1 because of null terminator
        this.contents = malloc(requiredBytes);
        this.checkForOOM();
        // Save initial value
        memcpy(this.contents, cast<char*>(value), this.length + 1l); // +1 because of null terminator
    }
}

/**
 * Construct a String holding a single character
 *
 * @param value Initial character
 */
public p String.ctor(const char value) {
    this.length = 1l;
    this.capacity = INITIAL_ALLOC_COUNT;

    unsafe {
        // Allocate space for the initial number of elements
        unsigned long requiredBytes = this.capacity + 1l; // +1 because of null terminator
        this.contents = malloc(requiredBytes);
        this.checkForOOM();

        // Save initial value
        this.contents[0] = value;
        this.contents[1] = '\0';
    }
}

/**
 * Construct a String as a deep copy of another String
 *
 * @param original String to copy
 */
public p String.ctor(const String& original) {
    this.length = original.length;
    this.capacity = original.capacity;
    // Mirror an unallocated source: leave the buffer as nil
    if original.capacity == 0l { return; }

    unsafe {
        // Allocate space
        unsigned long requiredBytes = original.capacity + 1l; // +1 because of null terminator
        this.contents = malloc(requiredBytes);
        this.checkForOOM();

        // Copy the contents from the original string
        memcpy(this.contents, original.contents, original.length + 1l); // +1 because of null terminator
    }
}

/**
 * Copy-assign the contents of another String into this one
 *
 * @param newValue String to copy from
 */
public p operator=(String& this, const String& newValue) {
    this.length = newValue.length;
    this.capacity = newValue.capacity;

    // If the source has no allocation, drop our buffer as well and stay unallocated
    if newValue.capacity == 0l {
        unsafe {
            if this.contents != nil<heap char*> {
                free(this.contents);
                this.contents = nil<heap char*>;
            }
        }
        return;
    }

    unsafe {
        // Allocate space (realloc(nil, N) is defined as malloc(N))
        unsigned long requiredBytes = newValue.capacity + 1l; // +1 because of null terminator
        this.contents = realloc(this.contents, requiredBytes);
        this.checkForOOM();

        // Copy the contents from the given string
        memcpy(this.contents, newValue.contents, newValue.length + 1l); // +1 because of null terminator
    }
}

/**
 * Construct a String pre-allocating space for the given number of characters
 *
 * @param initialSize Number of characters to pre-allocate space for
 */
public p String.ctor<IntLong>(IntLong initialSize) {
    this.length = cast<unsigned long>(initialSize);
    // Stay unallocated when no space was requested
    if initialSize == 0 { return; }

    this.capacity = initialSize > INITIAL_ALLOC_COUNT ? cast<unsigned long>(initialSize * RESIZE_FACTOR) : INITIAL_ALLOC_COUNT;

    unsafe {
        // Allocate space for the initial number of elements
        unsigned long requiredBytes = this.capacity + 1l; // +1 because of null terminator
        this.contents = malloc(requiredBytes);
        this.checkForOOM();

        // Save the initial value
        this.contents[0] = '\0';
    }
}

/**
 * Destruct the String, freeing its heap-allocated character buffer
 */
public p String.dtor() {
    if this.contents == nil<heap char*> { return; }
    free(this.contents);
    this.contents = nil<heap char*>;
}

/**
 * Appends the given string to the current one
 *
 * @param appendix String to be appended
 */
public p String.append(const string appendix) {
    const unsigned long appendixLength = getRawLength(appendix);
    if appendixLength == 0l { return; }
    // Check if we need to re-allocate memory
    this.ensureCapacity(this.length + appendixLength);

    // Save data
    unsafe {
        memcpy(this.contents + this.length, cast<char*>(appendix), appendixLength + 1l); // +1 because of null terminator
    }
    this.length += appendixLength;
}

/**
 * Appends the given String to the current one
 *
 * @param appendix String to be appended
 */
public p String.append(const String& appendix) {
    this.append(appendix.getRaw());
}

/**
 * Appends the first `appendixLength` bytes of the given string to the current one.
 *
 * In contrast to the single-argument overload, the appendix is not required to be null-terminated
 * and may contain embedded null bytes. This makes the overload the right choice for raw payloads
 * that were read from a file, a socket or any other byte source.
 *
 * @param appendix Buffer to be appended
 * @param appendixLength Number of bytes to append from the buffer
 */
public p String.append(const string appendix, unsigned long appendixLength) {
    if appendixLength == 0l { return; }
    // Check if we need to re-allocate memory
    this.ensureCapacity(this.length + appendixLength);

    // Save data. The terminator is written separately, since the appendix does not need to carry one.
    unsafe {
        memcpy(this.contents + this.length, cast<char*>(appendix), appendixLength);
    }
    this.length += appendixLength;
    unsafe {
        this.contents[this.length] = '\0';
    }
}

/**
 * Appends the given char to the string and resize it if needed
 *
 * @param c Char to append
 */
public p String.append(const char c) {
    // Check if we need to re-allocate memory
    this.ensureCapacity(this.length + 1l);

    // Insert the char at the right position
    unsafe {
        this.contents[this.length++] = c;
        this.contents[this.length] = '\0';
    }
}

p String.prepareInsert<IntLong>(unsigned IntLong position, unsigned long strLength) {
    // Check if the position is out of bounds
    if position > this.length {
        panic(Error("Insert index out of bounds"));
    }
    // Check if we need to re-allocate memory
    this.ensureCapacity(this.length + strLength);
    unsafe {
        // Shift the whole tail, including the null terminator, to the right in one move
        const heap char* insertAddr = this.contents + position;
        memmove(insertAddr + strLength, insertAddr, this.length - position + 1l); // +1 because of null terminator
    }
    this.length += strLength;
}

/**
 * Insert a raw string into the string at the given position
 *
 * @param position Position to insert at
 * @param str Raw string to insert
 */
public p String.insert<IntLong>(unsigned IntLong position, string str) {
    const unsigned long strLength = len(str);
    if strLength == 0l { return; }
    this.prepareInsert(position, strLength);
    unsafe {
        memcpy(this.contents + position, cast<char*>(str), strLength);
    }
}

/**
 * Insert a String into the string at the given position
 *
 * @param position Position to insert at
 * @param str String to insert
 */
public p String.insert<IntLong>(unsigned IntLong position, const String& str) {
    this.insert(position, str.getRaw());
}

/**
 * Insert a single character into the string at the given position
 *
 * @param position Position to insert at
 * @param c Character to insert
 */
public p String.insert<IntLong>(unsigned IntLong position, char c) {
    this.prepareInsert(position, 1l);
    unsafe {
        this.contents[position] = c;
    }
}

/**
 * Concatenates two strings and returns the result
 *
 * @param a String a
 * @param b String b
 * @return Concatenated string
 */
public f<String> operator+<StrTy, StrTyChar>(const StrTy& a, const StrTyChar& b) {
    result = String(a);
    result.append(b);
}

/**
 * Concatenates b to the end of a
 *
 * @param a String a
 * @param b String/string/char b
 */
public p operator+=<StrTyChar>(String& a, const StrTyChar& b) {
    a.append(b);
}

/**
 * Concatenates the given string with itself n times.
 *
 * @param str Input string
 * @param n Multiplication operand
 * @return Result string
 */
public f<String> operator*<IntLongShort>(const String& str, const IntLongShort n) {
    // Shortcuts
    if n < 1 || str.length == 0l { return String(); }
    if n == 1 { return str; }

    const unsigned long srcLength = str.length;
    const unsigned long newLength = cast<unsigned long>(n) * srcLength;
    result = String();
    result.reserve(newLength);

    // Copy the input over as whole blocks instead of looking up every single char
    unsafe {
        for unsigned long offset = 0l; offset < newLength; offset += srcLength {
            memcpy(result.contents + offset, str.contents, srcLength);
        }
        result.contents[newLength] = '\0';
    }
    result.length = newLength;
}

/**
 * Concatenates the given string with itself n times
 *
 * @param n Multiplication operand
 * @param str Input string
 * @return Result string
 */
public f<String> operator*<IntLongShort>(const IntLongShort n, const String& str) {
    return str * n;
}

/**
 * Concatenates this string with itself n times
 *
 * @param str Input string
 * @param n Multiplication operand
 */
public p operator*=<IntLongShort>(String& str, const IntLongShort n) {
    // Cancel if operand is less than 2 or there is nothing to repeat
    if n < 2 || str.length == 0l { return; }

    // Reserve new length
    const unsigned long srcLength = str.length;
    const unsigned long newLength = cast<unsigned long>(n) * srcLength;
    str.reserve(newLength);

    // Append whole copies of the original block, which never overlap the block they are copied from
    unsafe {
        for unsigned long offset = srcLength; offset < newLength; offset += srcLength {
            memcpy(str.contents + offset, str.contents, srcLength);
        }
        str.contents[newLength] = '\0';
    }
    str.length = newLength;
}

/**
 * Checks if two strings have the same value
 *
 * @param a First input string
 * @param b Second input string
 * @return Equal or not
 */
public f<bool> operator==(const String& a, const String& b) {
    // Compare sizes
    if a.length != b.length { return false; }
    // Two empty strings are equal, and at least one of them may still be unallocated
    if a.length == 0l { return true; }

    // Compare contents
    unsafe {
        return memcmp(a.contents, b.contents, a.length) == 0;
    }
}

/**
 * Checks if a String and a raw string have the same value
 *
 * @param a First input string
 * @param b Second input string
 * @return Equal or not
 */
public f<bool> operator==(const String& a, string b) {
    return isRawEqual(a.getRaw(), b);
}

/**
 * Checks if a raw string and a String have the same value
 *
 * @param a First input string
 * @param b Second input string
 * @return Equal or not
 */
public f<bool> operator==(string a, const String& b) {
    return isRawEqual(a, b.getRaw());
}

/**
 * Checks if two strings have not the same value
 *
 * @param a First input string
 * @param b Second input string
 * @return Not equal or not
 */
public f<bool> operator!=(const String& a, const String& b) {
    return !(a == b);
}

/**
 * Checks if a String and a raw string do not have the same value
 *
 * @param a First input string
 * @param b Second input string
 * @return Not equal or not
 */
public f<bool> operator!=(const String& a, const string& b) {
    return !(a == b);
}

/**
 * Checks if a raw string and a String do not have the same value
 *
 * @param a First input string
 * @param b Second input string
 * @return Not equal or not
 */
public f<bool> operator!=(const string& a, const String& b) {
    return !(a == b);
}

/**
 * Extract the char at the given index and return it
 *
 * @param a Input string
 * @return Character at the given index
 */
public f<char&> operator[](String& str, unsigned long idx) {
    if idx >= str.length {
        panic(Error("Access index out of bounds"));
    }
    unsafe {
        return str.contents[idx];
    }
}

/**
 * Extract the char at the given index and return it
 *
 * @param str Input string
 * @return Character at the given index
 */
public f<char&> operator[](String& str, unsigned int idx) {
    return str[cast<unsigned long>(idx)];
}

/**
 * Get the raw and immutable string from this container instance
 *
 * @return Raw immutable string
 */
public inline f<string> String.getRaw() {
    // Return a canonical empty raw string when the buffer is unallocated
    if this.contents == nil<heap char*> { return ""; }
    unsafe {
        return cast<string>(this.contents);
    }
}

/**
 * Retrieve the current length of the string
 *
 * @return Current length of the string
 */
public inline f<unsigned long> String.getLength() {
    return this.length;
}

/**
 * Retrieve the current capacity of the string
 *
 * @return Current capacity of the string
 */
public inline f<unsigned long> String.getCapacity() {
    return this.capacity;
}

/**
 * Check if the string is empty
 */
public inline f<bool> String.isEmpty() {
    return this.length == 0;
}

/**
 * Checks if the string exhausts its capacity
 *
 * @return Full or not full
 */
public inline f<bool> String.isFull() {
    return this.length == this.capacity;
}

/**
 * Replaces the current contents of the string with an empty string
 */
public p String.clear() {
    this.length = 0l;
    // Nothing to null-terminate while we are still unallocated
    if this.contents == nil<heap char*> { return; }
    unsafe {
        this.contents[0] = '\0';
    }
}

/**
 * Searches for a substring in a string. Returns -1 if the string was not found.
 *
 * @param startIndex Index where to start the search
 * @return Index, where the substring was found / -1
 */
public f<long> String.find(string needle, unsigned long startIndex = 0l) {
    // Return -1 if the startIndex is out of bounds
    if startIndex >= this.length { return -1l; }

    const unsigned long needleLength = getRawLength(needle);
    // Return false if the needle is longer than the haystack
    if this.length < needleLength { return -1l; }

    // Search needle in haystack
    for unsigned long idx = startIndex; idx <= this.length - needleLength; idx++ {
        // Start matching at startIdx
        for unsigned long charIdx = 0l; charIdx < needleLength; charIdx++ {
            unsafe {
                if this.contents[idx + charIdx] != needle[charIdx] {
                    continue 2;
                }
            }
        }
        // Whole string was matched
        return idx;
    }
    return -1l;
}

/**
 * Searches for a substring in a string. Returns -1 if the string was not found.
 *
 * @param startIndex Index where to start the search
 * @return Index, where the substring was found / -1
 */
public f<long> String.find(string needle, unsigned int startIndex) {
    return this.find(needle, cast<unsigned long>(startIndex));
}

/**
 * Searches for a char in a string. Returns -1 if the char was not found.
 *
 * @param startIndex Index where to start the search
 * @return Index, where the char was found / -1
 */
public f<long> String.find(char needle, unsigned long startIndex = 0l) {
    if startIndex >= this.length { return -1l; }
    unsafe {
        for unsigned long idx = startIndex; idx < this.length; idx++ {
            if this.contents[idx] == needle { return idx; }
        }
    }
    return -1l;
}

/**
 * Searches for a substring in a string from the back. Returns -1 if the string was not found.
 *
 * @param startIndex Index where to start the search
 * @return Index, where the substring was found / -1
 */
public f<long> String.rfind(string needle, unsigned long startIndex = 0l) {
    // Return -1 if the startIndex is out of bounds
    if startIndex >= this.length { return -1l; }

    const unsigned long needleLength = getRawLength(needle);
    // Return false if the needle is longer than the haystack
    if this.length < needleLength { return -1l; }

    if startIndex == 0l { startIndex = this.length - needleLength; }

    // Search needle in haystack, iterating from startIndex down to 0.
    // Note: a forward counter is used (idx = startIndex - i) instead of decrementing idx directly,
    // because idx is unsigned and would underflow to a huge value once it reaches 0, causing an
    // out-of-bounds read past the buffer.
    for unsigned long i = 0l; i <= startIndex; i++ {
        const unsigned long idx = startIndex - i;
        // Start matching at idx
        for unsigned long charIdx = 0l; charIdx < needleLength; charIdx++ {
            unsafe {
                if this.contents[idx + charIdx] != needle[charIdx] {
                    continue 2;
                }
            }
        }
        // Whole string was matched
        return idx;
    }
    return -1l;
}

/**
 * Searches for a substring in a string from the back. Returns -1 if the string was not found.
 *
 * @param startIndex Index where to start the search
 * @return Index, where the substring was found / -1
 */
public f<long> String.rfind(string needle, unsigned int startIndex) {
    return this.rfind(needle, cast<unsigned long>(startIndex));
}

/**
 * Searches for a char in a string from the back. Returns -1 if the char was not found.
 *
 * @param startIndex Index where to start the search
 * @return Index, where the char was found / -1
 */
public f<long> String.rfind(char needle, unsigned long startIndex = 0l) {
    if startIndex >= this.length { return -1l; }
    if startIndex == 0l { startIndex = this.length - 1l; }
    // Count upwards and derive the index from it, since idx is unsigned and would underflow at 0
    unsafe {
        for unsigned long i = 0l; i <= startIndex; i++ {
            const unsigned long idx = startIndex - i;
            if this.contents[idx] == needle { return idx; }
        }
    }
    return -1l;
}

/**
 * Checks if the string contains a substring
 *
 * @param needle Substring to search for
 * @return Found or not
 */
public inline f<bool> String.contains(string needle) {
    return this.find(needle) != -1l;
}

/**
 * Checks if the string starts with a given prefix
 *
 * @param prefix Prefix to check for
 * @return Starts with prefix or not
 */
public f<bool> String.startsWith(string prefix) {
    const unsigned long prefixLength = getRawLength(prefix);
    if prefixLength > this.length { return false; }
    if prefixLength == 0l { return this.length > 0l; }
    unsafe {
        return memcmp(this.contents, cast<char*>(prefix), prefixLength) == 0;
    }
}

/**
 * Checks if the string ends with a given suffix
 *
 * @param prefix Suffix to check for
 * @return Ends with suffix or not
 */
public f<bool> String.endsWith(string suffix) {
    const unsigned long suffixLength = getRawLength(suffix);
    if suffixLength > this.length { return false; }
    if suffixLength == 0l { return this.length > 0l; }
    unsafe {
        return memcmp(this.contents + this.length - suffixLength, cast<char*>(suffix), suffixLength) == 0;
    }
}

/**
 * Reverse the string
 */
public p String.reverse() {
    if this.length < 2l { return; }
    unsafe {
        unsigned long lowerIdx = 0l;
        unsigned long upperIdx = this.length - 1l;
        while lowerIdx < upperIdx {
            const char tmp = this.contents[lowerIdx];
            this.contents[lowerIdx] = this.contents[upperIdx];
            this.contents[upperIdx] = tmp;
            lowerIdx++;
            upperIdx--;
        }
    }
}

/**
 * Replace occurrence of substring with the replacement string
 *
 * @param needle Substring to replace
 * @param replacement Replacement for the substring
 */
#[ignoreUnusedReturnValue]
public f<bool> String.replace(
    string needle,
    string replacement,
    unsigned long startIdx = 0l
) {
    // Abort, if needle or replacement are both nullptr
    if cast<char*>(needle) == nil<char*> || cast<char*>(replacement) == nil<char*> {
        return false;
    }

    // Find occurrence
    startIdx = this.find(needle, startIdx);
    // Return if not found
    if startIdx == -1l { return false; }

    // Calculate metrics
    const unsigned long needleLength = getRawLength(needle);
    const unsigned long replacementLength = getRawLength(replacement);
    const unsigned long suffixLength = this.length - startIdx - needleLength;
    const unsigned long finalLength = this.length - needleLength + replacementLength;

    // Resize the string if required
    this.ensureCapacity(finalLength);

    unsafe {
        // Move the suffix to the left or right. Source and destination overlap, so this needs memmove.
        const heap char* stringAddr = this.contents;
        const heap char* startAddr = stringAddr + startIdx;
        if needleLength != replacementLength {
            const heap char* oldSuffixAddr = startAddr + needleLength;
            const heap char* newSuffixAddr = startAddr + replacementLength;
            memmove(newSuffixAddr, oldSuffixAddr, suffixLength + 1l); // +1 because of null terminator
        }

        // Replace needle with replacement
        memcpy(startAddr, cast<char*>(replacement), replacementLength);
    }

    // Update length
    this.length = finalLength;

    return true;
}

/**
 * Replace all occurrences of substring with the replacement string
 *
 * @param needle Substring to replace
 * @param replacement Replacement for the substring
 */
#[ignoreUnusedReturnValue]
public f<unsigned long> String.replaceAll(string needle, string replacement) {
    unsigned long startIdx = 0l;
    unsigned long foundOccurrences = 0l;
    const unsigned long needleLength = getRawLength(needle);
    const unsigned long replacementLength = getRawLength(replacement);

    while startIdx <= this.length - needleLength {
        if !this.replace(needle, replacement, startIdx) {
            break;
        }
        startIdx += replacementLength;
        foundOccurrences++;
    }

    return foundOccurrences;
}

/**
 * Replaces all occurrences of a character with another character
 *
 * @param needle Character to search for
 * @param replacement Character to replace each occurrence with
 * @return Number of replacements made
 */
#[ignoreUnusedReturnValue]
public f<unsigned long> String.replaceAll(char needle, char replacement) {
    result = 0l;
    // Single chars never change the length, so they can be swapped in place in one pass
    unsafe {
        for unsigned long idx = 0l; idx < this.length; idx++ {
            if this.contents[idx] == needle {
                this.contents[idx] = replacement;
                result++;
            }
        }
    }
}

/**
 * Returns the substring of the current string, starting at position `startIndex` with
 * the length of `length`.
 *
 * @param startIndex Substring start index
 * @param length Length of substring
 * @return Substring
 */
public f<String> String.getSubstring<IntLongShort>(unsigned IntLongShort startIdx, long length = -1l) {
    // Return empty string if the length is 0 or the startIndex is out of bounds
    if length == 0l || startIdx >= this.length {
        return String();
    }

    // Get everything after startIndex if length is -1
    if length == -1l {
        length = this.length - startIdx;
    }

    // Do not exceed original string length
    if startIdx + length > this.length {
        length = this.length - startIdx;
    }

    // Get substring
    String substring;
    substring.reserve(length);
    substring.length = length;
    unsafe {
        memcpy(substring.contents, this.contents + startIdx, cast<unsigned long>(length));
        // Terminate string
        substring.contents[length] = '\0';
    }

    // Return the substring
    return substring;
}

/**
 * Returns a new string without leading or trailing whitespaces.
 *
 * @return Trimmed string
 */
public f<String> String.trim() {
    if this.length == 0l {
        return String();
    }
    unsigned long startIdx = 0l;
    unsigned long endIdx = this.length - 1l;

    unsafe {
        // Find first char that is not a whitespace
        while startIdx < this.length {
            if !isWhitespace(this.contents[startIdx]) { break; }
            startIdx++;
        }
        // Bail out if the string consists of whitespaces only. Without this, the backwards scan below
        // would run past the front of the buffer, since endIdx is unsigned and underflows at 0.
        if startIdx == this.length { return String(); }
        // Find last char that is not a whitespace
        while isWhitespace(this.contents[endIdx]) { endIdx--; }
    }

    const unsigned long newLength = endIdx - startIdx + 1;
    return this.getSubstring(startIdx, newLength);
}

/**
 * Reserves `charCount` items
 *
 * @param charCount Number of chars to reserve for the string
 */
public p String.reserve<IntLongShort>(unsigned IntLongShort charCount) {
    if charCount > this.capacity {
        this.resize(cast<unsigned long>(charCount));
    }
}

/**
 * Makes sure the string can hold at least `requiredCapacity` chars.
 *
 * The buffer grows geometrically to keep repeated appends amortized O(1), but jumps straight to the
 * required capacity when that is larger, so a single large append costs one re-allocation instead of
 * one per doubling step.
 *
 * @param requiredCapacity Number of chars the buffer has to be able to hold
 */
p String.ensureCapacity(unsigned long requiredCapacity) {
    if this.capacity >= requiredCapacity { return; }
    unsigned long newCapacity = this.capacity == 0l ? INITIAL_ALLOC_COUNT : this.capacity * RESIZE_FACTOR;
    if newCapacity < requiredCapacity { newCapacity = requiredCapacity; }
    this.resize(newCapacity);
}

/**
 * Re-allocates heap space for the string contents
 *
 * @param newLength new length of the string after resizing
 */
p String.resize(unsigned long newLength) {
    // Allocate the new memory
    unsafe {
        heap char* oldAddress = this.contents;
        unsigned long requiredBytes = newLength + 1l; // +1 because of null terminator
        this.contents = realloc(oldAddress, requiredBytes);
        this.checkForOOM();
    }
    // Set new capacity
    this.capacity = newLength;
}

p String.checkForOOM() {
    if this.contents == nil<heap byte*> {
        panic(Error("Could not allocate enough memory for dynamic string object"));
    }
}

// ======================================================= Static functions ======================================================

/**
 * Returns the length of a string
 *
 * @param input Input string
 * @return Length of the input string
 */
public f<unsigned long> getRawLength(string input) {
    // Handle nullptr gracefully
    if cast<char*>(input) == nil<char*> { return 0l; }
    // Otherwise let libc count the chars until the null terminator
    unsafe {
        return strlen(input);
    }
}

/**
 * Checks the equality of two raw strings
 *
 * @param lhs First input raw string
 * @param rhs Second input raw string
 * @return Equality of lhs and rhs
 */
public f<bool> isRawEqual(string lhs, string rhs) {
    // A nil string represents the absence of a string and must never be considered equal to a non-nil
    // string, even an empty one (e.g. nil<string> != ""). getRawLength() cannot tell these apart, since
    // it reports both as length 0, so the nil-ness has to be checked explicitly beforehand.
    const bool lhsIsNil = cast<const char*>(lhs) == nil<const char*>;
    const bool rhsIsNil = cast<const char*>(rhs) == nil<const char*>;
    if lhsIsNil || rhsIsNil { return lhsIsNil && rhsIsNil; }

    // Compare chars, which also covers differing lengths
    unsafe {
        return strcmp(lhs, rhs) == 0;
    }
}