#![
    core.compiler.alwaysKeepOnNameCollision = true,
    core.linker.additionalSource = "stack-trace-unwind.c"
]

// Frame capture for POSIX targets. The OS-suffixed import in stack_trace_rt.spice picks between this and
// stack_trace_capture_rt_windows.spice.
//
// _Unwind_Backtrace is the C++ ABI unwinder entry point, provided by libgcc_s on Linux and by the libunwind
// inside libSystem on macOS. It is table-driven, reading the unwind tables that IRGenerator's 'uwtable'
// attribute always emits, so it works at any optimization level and needs no frame pointers.
//
// The call is made from a C shim (stack-trace-unwind.c, compiled in via the attribute above) because the
// unwinder takes a callback, and a Spice function converted to a raw pointer is not a bare function pointer:
// it becomes a '.fatthunk' carrying an extra leading capture-struct pointer, which shifts every argument
// (spicelang/spice#1392).

// The shim's own frame, which sits between the unwinder and this function.
const int SHIM_FRAMES = 1;

// Defined in stack-trace-unwind.c. Prefixed to keep a C-linkage symbol of this generality out of the way of
// anything the program being compiled might define itself.
ext f<int> spiceCaptureReturnAddresses(byte** /*addresses*/, int /*capacity*/, int /*skipFrames*/);

/**
 * Fills 'addresses' with up to 'capacity' return addresses, most recent call first, and returns how many were
 * written.
 *
 * @param addresses Buffer to write into
 * @param capacity Maximum number of addresses to write
 * @param skipFrames Number of frames to drop from the top, counted from this function's own frame
 * @return Number of addresses written
 */
public f<int> captureReturnAddresses(byte** addresses, int capacity, int skipFrames) {
    if addresses == nil<byte**> || capacity <= 0 || skipFrames < 0 {
        return 0;
    }
    unsafe {
        return spiceCaptureReturnAddresses(addresses, capacity, skipFrames + SHIM_FRAMES);
    }
}
