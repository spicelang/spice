#![
    core.compiler.alwaysKeepOnNameCollision = true,
    // The call into the unwinder lives in C - see the note below on why it cannot be written in Spice today
    core.linker.additionalSource = "stack-trace-unwind.c"
]

// Stack trace capture for POSIX targets, split out of stack_trace_rt.spice the same way symbol resolution is -
// see stack_trace_symbol_rt.spice for why that split exists and how the OS-suffixed import picks between this
// file and stack_trace_capture_rt_windows.spice.
//
// This asks the platform unwinder to do the walk rather than following the frame-pointer chain by hand. The
// hand-rolled walk it replaces could not be made to work everywhere, for reasons that are structural rather
// than fixable (media/specs/stack-traces.md has the measurements):
//   - Windows x64 has no saved-frame-pointer chain at all, so the walk was never going to work there.
//   - Frame pointers are off unless '--keep-frame-pointers' is passed, so on most targets there is no chain to
//     walk in the first place.
// The unwinder needs neither: it is driven by the unwind tables that IRGenerator's 'uwtable' attribute always
// emits, whatever the optimization level and whether or not frame pointers are kept.
//
// The call into it goes through a small C shim (stack-trace-unwind.c, compiled in via the attribute above)
// rather than being written here, for two reasons, both properties of Spice today rather than preferences:
//   - _Unwind_Backtrace takes a callback, and a Spice function converted to a raw pointer is not a bare
//     function pointer: IRGenerator wraps it in a '.fatthunk' carrying an extra leading capture-struct pointer,
//     so the unwinder's (context, arg) arrives as (captures, context) and every argument shifts by one. See
//     spicelang/spice#1392.
//   - backtrace(3) would avoid the callback entirely, but is not equivalent across platforms: glibc's goes
//     through this same unwinder, while Apple's walks the frame-pointer chain and so finds nothing once frame
//     pointers are omitted. That is the very dependency this change exists to remove, so it cannot be relied
//     on - an earlier version of this file used it and captured zero frames on macOS.
// Going through the unwinder directly also covers musl, which has no <execinfo.h> and thus no backtrace(3).

// The shim's own frame, which sits between the unwinder and this function and is never worth showing.
const int SHIM_FRAMES = 1;

// Defined in stack-trace-unwind.c. Prefixed to keep a C-linkage symbol of this generality out of the way of
// anything the program being compiled might define itself.
ext f<int> spiceCaptureReturnAddresses(byte** /*addresses*/, int /*capacity*/, int /*skipFrames*/);

/**
 * Fills 'addresses' with up to 'capacity' return addresses, most recent call first, and returns how many were
 * written.
 *
 * @param addresses Buffer to write into
 * @param capacity Maximum number of addresses to write
 * @param skipFrames Number of frames to drop from the top, counted from this function's own frame
 * @return Number of addresses written
 */
public f<int> captureReturnAddresses(byte** addresses, int capacity, int skipFrames) {
    if capacity <= 0 || skipFrames < 0 {
        return 0;
    }
    unsafe {
        return spiceCaptureReturnAddresses(addresses, capacity, skipFrames + SHIM_FRAMES);
    }
}
