// Std imports
import "std/type/impl/number-conversion";

// Constants
const long MIN_INT_VALUE = -2147483648l;
const long MAX_INT_VALUE = 2147483647l;
const long MIN_SHORT_VALUE = -32768l;
const long MAX_SHORT_VALUE = 32767l;
const long MAX_BYTE_VALUE = 255l;

// ------------------------------------------------------ Helpers ------------------------------------------------------

/**
 * Parse the whole input as an integer in the given base and check, that it is within the given range
 *
 * @param input String value
 * @param base Base from 2 to 36 or 0
 * @param minValue Minimum allowed value
 * @param maxValue Maximum allowed value
 * @return Parsed value or an error, if the base is invalid, the input is no integer or the value is out of range
 */
f<Result<long>> parseIntegerInRange(string input, int base, long minValue, long maxValue) {
    if !isValidIntegerBase(base) { return err<long>("Invalid base, expected 0 or 2 to 36"); }
    const unsigned long length = getRawLength(input);
    if length == 0ul { return err<long>("Input is empty"); }
    if isSpaceChar(input[0]) { return err<long>("Input starts with whitespace"); }
    unsigned long end = 0ul;
    bool overflow = false;
    const long value = parseIntegerPrefix(input, base, end, overflow);
    if end == 0ul { return err<long>("Input is no integer"); }
    if end != length { return err<long>("Input has trailing characters"); }
    if overflow || value < minValue || value > maxValue { return err<long>("Value out of range"); }
    return ok(value);
}

// ----------------------------------------------- Conversions to double -----------------------------------------------

/**
 * Convert an int to a double
 *
 * @param input Int value
 * @return Double value
 */
public f<double> toDouble(int input) {
    return 0.0 + input;
}

/**
 * Convert a short to a double
 *
 * @param input Short value
 * @return Double value
 */
public f<double> toDouble(short input) {
    return 0.0 + input;
}

/**
 * Convert a long to a double
 *
 * @param input Long value
 * @return Double value
 */
public f<double> toDouble(long input) {
    return 0.0 + input;
}

/**
 * Convert a byte to a double
 *
 * @param input Byte value
 * @return Double value
 */
public f<double> toDouble(byte input) {
    return 0.0 + cast<int>(input);
}

/**
 * Convert a char to a double
 *
 * @param input Char value
 * @return Double value
 */
public f<double> toDouble(char input) {
    return 0.0 + cast<int>(input);
}

/**
 * Convert a string to a double
 *
 * @param input String value
 * @return Double value
 */
public f<double> toDouble(string input) {
    return parseDoubleText(input);
}

/**
 * Convert a string to a double. Unlike toDouble, the whole input has to be a number, without leading or trailing
 * whitespace. Decimal and hexadecimal numbers, inf, infinity and nan are accepted, like by toDouble.
 *
 * @param input String value
 * @return Double value or an error, if the input is no number or the value is too large or too small for a double
 */
public f<Result<double>> toDoubleSafe(string input) {
    const unsigned long length = getRawLength(input);
    if length == 0ul { return err<double>("Input is empty"); }
    if isSpaceChar(input[0]) { return err<double>("Input starts with whitespace"); }
    unsigned long end = 0ul;
    bool outOfRange = false;
    const double value = parseDoublePrefix(input, end, outOfRange);
    if end == 0ul { return err<double>("Input is no number"); }
    if end != length { return err<double>("Input has trailing characters"); }
    if outOfRange { return err<double>("Value out of range"); }
    return ok(value);
}

/**
 * Convert a bool to a double
 *
 * @param input Bool value
 * @return Double value
 */
public f<double> toDouble(bool input) {
    return input ? 1.0 : 0.0;
}

// ------------------------------------------------ Conversions to int -------------------------------------------------

/**
 * Convert a double to an int
 *
 * @param input Double value
 * @return Int value
 */
public f<int> toInt(double input) {
    return cast<int>(input);
}

/**
 * Convert a short to an int
 *
 * @param input Short value
 * @return Int value
 */
public f<int> toInt(short input) {
    return cast<int>(input);
}

/**
 * Convert a long to an int
 *
 * @param input Long value
 * @return Int value
 */
public f<int> toInt(long input) {
    return cast<int>(input);
}

/**
 * Convert a byte to an int
 *
 * @param input Byte value
 * @return Int value
 */
public f<int> toInt(byte input) {
    return cast<int>(input);
}

/**
 * Convert a char to an int
 *
 * @param input Char value
 * @return Int value
 */
public f<int> toInt(char input) {
    return cast<int>(input);
}

/**
 * Convert a string to an int
 *
 * @param input String value
 * @return Int value
 */
public f<int> toInt(string input, int base = 10) {
    return cast<int>(parseIntegerText(input, base));
}

/**
 * Convert a string to an int. Unlike toInt, the whole input has to be an integer, without leading or trailing
 * whitespace, and values out of the range of int (-2147483648 to 2147483647) are reported instead of wrapped around.
 *
 * @param input String value
 * @param base Base from 2 to 36, or 0 to detect it from the prefix (0x: 16, 0: 8, else 10)
 * @return Int value or an error, if the base is invalid, the input is no integer or the value is out of range
 */
public f<Result<int>> toIntSafe(string input, int base = 10) {
    Result<long> parsed = parseIntegerInRange(input, base, MIN_INT_VALUE, MAX_INT_VALUE);
    if parsed.isErr() { return err<int>(parsed.getErr()); }
    return ok(cast<int>(parsed.unwrap()));
}

/**
 * Convert a bool to an int
 *
 * @param input Bool value
 * @return Int value
 */
public f<int> toInt(bool input) {
    return input ? 1 : 0;
}

// ----------------------------------------------- Conversions to short ------------------------------------------------

/**
 * Convert a double to a short
 *
