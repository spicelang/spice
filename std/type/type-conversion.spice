// ----------------------------------------------- Conversions to string -----------------------------------------------

/**
 * Convert a double to a string
 *
 * @param input Double value
 * @return String value
 */
public f<String> toString(double input) {
    return formatFixedDouble(input, 6);
}

/**
 * Convert a double to a string with a fixed number of decimal places
 *
 * @param input Double value
 * @param precision Number of decimal places
 * @return String value
 */
public f<String> toString(double input, int precision) {
    return formatFixedDouble(input, precision);
}

/**
 * Convert an int to a string
 *
 * @param input Int value
 * @return String value
 */
public f<String> toString(int input) {
    return formatSignedInteger(cast<long>(input));
}

/**
 * Convert a short to a string
 *
 * @param input Short value
 * @return String value
 */
public f<String> toString(short input) {
    return formatSignedInteger(cast<long>(input));
}

/**
 * Convert a long to a string
 *
 * @param input Long value
 * @return String value
 */
public f<String> toString(long input) {
    return formatSignedInteger(input);
}

/**
 * Convert a byte to a string
 *
 * @param input Byte value
 * @return String value
 */
public f<String> toString(byte input) {
    return formatUnsignedInteger(cast<unsigned long>(cast<int>(input)));
}

/**
 * Convert a char to a string
 *
 * @param input Char value
 * @return String value
 */
public f<String> toString(char input) {
    return String(input);
}

/**
 * Convert a bool to a string
 *
 * @param input Bool value
 * @return String value
 */
public f<string> toString(bool input) {
    return input ? "true" : "false";
}

// ------------------------------------------------ Conversions to bool ------------------------------------------------

/**
 * Convert a double to a bool
 *
 * @param input Double value
 * @return True if the input is non-zero, false otherwise
 */
public f<bool> toBool(double input) {
    return input != 0.0;
}

/**
 * Convert an int to a bool
 *
 * @param input Int value
 * @return True if the input is non-zero, false otherwise
 */
public f<bool> toBool(int input) {
    return input != 0;
}

/**
 * Convert a short to a bool
 *
 * @param input Short value
 * @return True if the input is non-zero, false otherwise
 */
public f<bool> toBool(short input) {
    return input != 0s;
}

/**
 * Convert a long to a bool
 *
 * @param input Long value
 * @return True if the input is non-zero, false otherwise
 */
public f<bool> toBool(long input) {
    return input != 0l;
}

/**
 * Convert a byte to a bool
 *
 * @param input Byte value
 * @return True if the input is non-zero, false otherwise
 */
public f<bool> toBool(byte input) {
    return input != cast<byte>(0);
}

/**
 * Convert a char to a bool
 *
 * @param input Char value
 * @return Bool value
 */
public f<bool> toBool(char input) {
    return input == '1';
}

/**
 * Convert a string to a bool
 *
 * @param input String value
 * @return Bool value
 */
public f<bool> toBool(string input) {
    return input == "true";
}
