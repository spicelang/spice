// ===== Message =====

// Helper for obtaining and disposing heap-allocated strings, allocated by LLVM
public type Message struct {
    string message
}

public p Message.ctor(string message = nil<string>) {
    this.message = message;
}

public p Message.dtor() {
    if this.message != nil<string> {
        LLVMDisposeMessage(this.message);
        this.message = nil<string>;
    }
}

p Message.set(string message) {
    this.message = message;
}

public const f<string> Message.get() {
    return this.message;
}

// ===== LLVMError =====
public type LLVMError struct {
    LLVMErrorRef self
}

public p LLVMError.ctor(string message) {
    this.self = LLVMCreateStringError(message);
}

public p LLVMError.ctor(LLVMErrorRef error) {
    this.self = error;
}

public p LLVMError.dtor() {
    if this.self != nil<LLVMErrorRef> {
        LLVMConsumeError(this.self);
    }
}

// Check if this is an actual error (and not a success value)
public f<bool> LLVMError.isError() {
    return this.self != nil<LLVMErrorRef>;
}

// Retrieve the error message. This consumes the error
public f<Message> LLVMError.getMessage() {
    const string errorMessage = LLVMGetErrorMessage(this.self);
    this.self = nil<LLVMErrorRef>;
    // The error message has to be released with LLVMDisposeErrorMessage, a Message with LLVMDisposeMessage
    const string message = LLVMCreateMessage(errorMessage);
    LLVMDisposeErrorMessage(errorMessage);
    return Message(message);
}

// ===== LLVMContext =====
public type LLVMContext struct {
    LLVMContextRef self
}

public p LLVMContext.ctor() {
    this.self = LLVMContextCreate();
}

// Like llvm::LLVMContext::setDiscardValueNames
public p LLVMContext.setDiscardValueNames(bool discard) {
    LLVMContextSetDiscardValueNames(this.self, cast<LLVMBool>(discard));
}

public p LLVMContext.dtor() {
    LLVMContextDispose(this.self);
}

// ===== Type =====
public type Type struct {
    LLVMTypeRef self
}

public p Type.dump() {
    LLVMDumpType(this.self);
}

public f<Type> Type.getStructElementType(unsigned int idx) {
    return Type{ LLVMStructGetTypeAtIndex(this.self, idx) };
}

public f<Type> getInt1Ty(const LLVMContext& context) {
    return Type{ LLVMInt1TypeInContext(context.self) };
}

public f<Type> getInt8Ty(const LLVMContext& context) {
    return Type{ LLVMInt8TypeInContext(context.self) };
}

public f<Type> getInt16Ty(const LLVMContext& context) {
    return Type{ LLVMInt16TypeInContext(context.self) };
}

public f<Type> getInt32Ty(const LLVMContext& context) {
    return Type{ LLVMInt32TypeInContext(context.self) };
}

public f<Type> getInt64Ty(const LLVMContext& context) {
    return Type{ LLVMInt64TypeInContext(context.self) };
}

public f<Type> getDoubleTy(const LLVMContext& context) {
    return Type{ LLVMDoubleTypeInContext(context.self) };
}

public f<Type> getPtrTy(const LLVMContext& context, unsigned int addressSpace = 0) {
    return Type{ LLVMPointerTypeInContext(context.self, addressSpace) };
}

public f<Type> getArrayType(Type elementType, unsigned long numElements) {
    return Type{ LLVMArrayType2(elementType.self, numElements) };
}

// Equivalent to llvm::StructType::get: Get a literal (unnamed) struct type
public f<Type> getStructType(const LLVMContext& context, const Vector<Type>& elementTypes, bool packed = false) {
    return Type{ LLVMStructTypeInContext(context.self, &elementTypes.getDataPtr().self, cast<unsigned int>(elementTypes.getSize()), cast<LLVMBool>(packed)) };
}

// Equivalent to llvm::StructType::create: Create a named struct type with the given body
public f<Type> createStructType(const LLVMContext& context, const Vector<Type>& elementTypes, string name, bool packed = false) {
    const LLVMTypeRef structTy = LLVMStructCreateNamed(context.self, name);
    LLVMStructSetBody(structTy, &elementTypes.getDataPtr().self, cast<unsigned int>(elementTypes.getSize()), cast<LLVMBool>(packed));
    return Type{ structTy };
}

// ===== Value =====
public type Value struct {
    LLVMValueRef self
}

public p Value.ctor() {
    this.self = nil<LLVMValueRef>;
}

public p Value.dump() {
    LLVMDumpValue(this.self);
}

// ===== Constant =====
public type Constant alias Value;

// ===== StructType =====
public type StructType struct {
    LLVMTypeRef self
}

public p StructType.ctor(const LLVMContext& context, const Vector<Type>& elementTypes, bool packed = false) {
    this.self = LLVMStructTypeInContext(context.self, &elementTypes.getDataPtr().self, cast<unsigned int>(elementTypes.getSize()), cast<LLVMBool>(packed));
}

public p StructType.ctor(const LLVMContext& context, string name = "") {
    this.self = LLVMStructCreateNamed(context.self, name);
}

public f<string> StructType.getName() {
    return LLVMGetStructName(this.self);
}

public p StructType.setBody(const Vector<Type>& elementTypes, bool packed = false) {
    LLVMStructSetBody(this.self, &elementTypes.getDataPtr().self, cast<unsigned int>(elementTypes.getSize()), cast<LLVMBool>(packed));
}

public p StructType.dump() {
    LLVMDumpType(this.self);
}

// ===== DataLayout =====
public type DataLayout struct {
    LLVMTargetDataRef self
}

public p DataLayout.dtor() {
    LLVMDisposeTargetData(this.self);
}

public f<unsigned int> DataLayout.getPointerSize() {
    return LLVMPointerSize(this.self);
}

public inline f<unsigned int> DataLayout.getPointerSizeInBits() {
    return this.getPointerSize() * 8;
}

public f<unsigned long> DataLayout.getTypeSize(Type ty) {
    return this.getTypeSizeInBits(ty) / 8;
}

public f<unsigned long> DataLayout.getTypeSizeInBits(Type ty) {
    return LLVMSizeOfTypeInBits(this.self, ty.self);
}

public f<unsigned long> DataLayout.getTypeAllocSize(Type ty) {
    return LLVMABISizeOfType(this.self, ty.self);
}

public f<unsigned int> DataLayout.getTypeAlignment(Type ty) {
    return LLVMPreferredAlignmentOfType(this.self, ty.self);
}

public f<unsigned int> DataLayout.getABITypeAlign(Type ty) {
    return LLVMABIAlignmentOfType(this.self, ty.self);
}

// Equivalent to getStructLayout(structTy)->getElementOffset(idx)
public f<unsigned long> DataLayout.getStructElementOffset(Type structTy, unsigned int idx) {
    return LLVMOffsetOfElement(this.self, structTy.self, idx);
}

// ===== Triple =====
public type Triple struct {
    public string value
}

public p Triple.ctor() {
    this.value = nil<string>;
}

public p Triple.ctor(string triple) {
    this.value = LLVMCreateMessage(triple);
}

public p Triple.ctor(const String& archStr, const String& vendorStr, const String& osStr) {
    const String newString = archStr + '-' + vendorStr + '-' + osStr;
    this.value = LLVMCreateMessage(newString.getRaw());
}

// A triple owns its message, so copies have to allocate their own one. Otherwise, they would share the message and it would be
// disposed as soon as the first of the copies goes out of scope
public p Triple.ctor(const Triple& other) {
    this.value = nil<string>;
    if other.value != nil<string> {
        this.value = LLVMCreateMessage(other.value);
    }
}

public p operator=(Triple& this, const Triple& other) {
    if this.value == other.value {
        return;
    }
    if this.value != nil<string> {
        LLVMDisposeMessage(this.value);
    }
    this.value = nil<string>;
    if other.value != nil<string> {
        this.value = LLVMCreateMessage(other.value);
    }
}

public p Triple.dtor() {
    LLVMDisposeMessage(this.value);
}

public f<Triple> Triple.normalize() {
    return Triple{ LLVMNormalizeTargetTriple(this.value) };
}

f<Vector<String>> Triple.getTripleFragments() {
    return split(String(this.value), '-');
}

public f<String> Triple.getArchName() {
    const Vector<String> fragments = this.getTripleFragments();
    return fragments.get(0);
}

public f<String> Triple.getVendorName() {
    const Vector<String> fragments = this.getTripleFragments();
    return fragments.get(1);
}

public f<String> Triple.getOSName() {
    const Vector<String> fragments = this.getTripleFragments();
    return fragments.get(2);
}

// Like llvm::Triple::getArchTypeName(getArch()): the canonical name of the architecture, e.g. 'aarch64' for 'arm64'
public f<String> Triple.getArchTypeName() {
    const String archName = this.getArchName();
    // Aliases of llvm::Triple::parseArch, that do not match the canonical name
    const dyn aarch64Aliases = ["arm64", "arm64e", "arm64ec", "aarch64_lfi"];
    for unsigned long i = 0l; i < len(aarch64Aliases); i++ {
        if archName == aarch64Aliases[i] {
            return String("aarch64");
        }
    }
    if archName == "arm64_32" {
        return String("aarch64_32");
    }
    const dyn x86_64Aliases = ["amd64", "x86_64h", "x86_64_lfi"];
    for unsigned long i = 0l; i < len(x86_64Aliases); i++ {
        if archName == x86_64Aliases[i] {
            return String("x86_64");
        }
    }
    const dyn x86Aliases = ["i386", "i486", "i586", "i686", "i786", "i886", "i986"];
    for unsigned long i = 0l; i < len(x86Aliases); i++ {
        if archName == x86Aliases[i] {
            return String("i386");
        }
    }
    return archName;
}

// Like llvm::Triple::getOSTypeName(getOS()): the canonical name of the OS without version, e.g. 'darwin' for 'darwin25.6.0'
public f<String> Triple.getOSTypeName() {
    const String osName = this.getOSName();
    // OS names and their aliases in the order of llvm/TargetParser/TripleName.def. Like llvm::Triple::parseOS, the first one,
    // that the OS fragment starts with, wins. This also skips version suffixes, while keeping digits of names like 'ps4'.
    // 'mingw' and 'cygwin' are no OS names there, but llvm::Triple::normalize() turns them into Windows triples.
    const dyn osNames = [
        "darwin", "dragonfly", "freebsd", "fuchsia", "ios", "kfreebsd", "linux", "lv2", "macosx", "macos", "managarm",
        "netbsd", "openbsd", "solaris", "uefi", "windows", "win32", "zos", "haiku", "rtems", "aix", "cuda", "nvcl", "amdhsa",
        "ps4", "ps5", "elfiamcu", "tvos", "watchos", "bridgeos", "driverkit", "xros", "visionos", "mesa3d", "amdpal", "hermit",
        "hurd", "wasip1", "wasip2", "wasip3", "wasi", "emscripten", "shadermodel", "liteos", "serenity", "vulkan",
        "cheriotrtos", "opencl", "chipstar", "firmware", "qurt", "h2", "mingw", "cygwin"
    ];
    for unsigned long i = 0l; i < len(osNames); i++ {
        const string name = osNames[i];
        if !osName.startsWith(name) {
            continue;
        }
        // Map aliases to their canonical names
        const String matchedName = String(name);
        if matchedName == "macos" {
            return String("macosx");
        }
        if matchedName == "win32" || matchedName == "mingw" || matchedName == "cygwin" {
            return String("windows");
        }
        if matchedName == "visionos" {
            return String("xros");
        }
        return matchedName;
    }
    return String("unknown");
}

public f<bool> Triple.empty() {
    return this.value == nil<string> || len(this.value) == 0;
}

// The following predicates mirror the ones of llvm::Triple, based on the textual triple fragments

public f<bool> Triple.isOSLinux() {
    const String osName = this.getOSName();
    return osName.startsWith("linux");
}

public f<bool> Triple.isOSWindows() {
    const String osName = this.getOSName();
    return osName.startsWith("windows") || osName.startsWith("win32") || osName.startsWith("mingw") || osName.startsWith("cygwin");
}

// All Apple OSes are Darwin based, like llvm::Triple::isOSDarwin()
public f<bool> Triple.isOSDarwin() {
    const String osName = this.getOSName();
    if osName.startsWith("darwin") || osName.startsWith("macos") || osName.startsWith("ios") || osName.startsWith("tvos") {
        return true;
    }
    if osName.startsWith("watchos") || osName.startsWith("driverkit") || osName.startsWith("xros") || osName.startsWith("visionos") {
        return true;
    }
    return osName.startsWith("bridgeos");
}

public f<bool> Triple.isX86() {
    const String archName = this.getArchName();
    return archName == "i386" || archName == "i486" || archName == "i586" || archName == "i686" || archName == "x86";
}

public f<bool> Triple.isX86_64() {
    const String archName = this.getArchName();
    return archName == "x86_64" || archName == "amd64";
}

public f<bool> Triple.isAArch64() {
    const String archName = this.getArchName();
    return archName.startsWith("aarch64") || archName.startsWith("arm64");
}

public f<bool> Triple.isPPC() {
    const String archName = this.getArchName();
    return archName.startsWith("powerpc") || archName.startsWith("ppc");
}

public f<bool> Triple.isWasm() {
    const String archName = this.getArchName();
    return archName.startsWith("wasm");
}

// Like getObjectFormat() == llvm::Triple::MachO. Darwin based OSes use the MachO object format
public f<bool> Triple.isMachO() {
    return this.isOSDarwin();
}

public f<bool> operator==(const Triple& a, const Triple& b) {
    return a.value == b.value;
}

public f<bool> operator!=(const Triple& a, const Triple& b) {
    return !(a.value == b.value);
}

// ===== LLVMModule =====
public type Module struct {
    LLVMModuleRef self = nil<LLVMModuleRef>
}

public p Module.ctor() {
    this.self = nil<LLVMModuleRef>;
}

public p Module.ctor(string name, const LLVMContext& ctx) {
    this.self = LLVMModuleCreateWithNameInContext(name, ctx.self);
}

public p Module.dtor() {
    if this.self != nil<LLVMModuleRef> {
        LLVMDisposeModule(this.self);
    }
}

// Like llvm::Linker::linkModules: link the source module into this module. The source module is destroyed in the process
public f<bool> Module.linkInModule(Module& src) {
    const bool failed = LLVMLinkModules2(this.self, src.self) != 0;
    src.self = nil<LLVMModuleRef>;
    return failed;
}

public f<LLVMContext> Module.getContext() {
    return LLVMContext{ LLVMGetModuleContext(this.self) };
}

public p Module.dump() {
    LLVMDumpModule(this.self);
}

public f<Message> Module.print() {
    return Message(LLVMPrintModuleToString(this.self));
}

public f<string> Module.printToFile(string filename) {
    string errorMessage;
    if LLVMPrintModuleToFile(this.self, filename, errorMessage) != 0 {
        return errorMessage;
    }
    return "";
}

public p Module.setTargetTriple(Triple triple) {
    LLVMSetTarget(this.self, triple.value);
}

public p Module.setDataLayout(DataLayout dataLayout) {
    LLVMSetModuleDataLayout(this.self, dataLayout.self);
}

// ===== BasicBlock =====

public type BasicBlock struct {
    LLVMBasicBlockRef self
}

public p BasicBlock.ctor(const LLVMContext& ctx, string name = "") {
    this.self = LLVMCreateBasicBlockInContext(ctx.self, name);
}

// ===== Function =====

public type Function struct {
    LLVMFunctionRef self
    Type fctType
}

public p Function.ctor(Module module, string name, Type fctTy) {
    this.fctType = fctTy;
    this.self = LLVMAddFunction(module.self, name, fctTy.self);
}

public f<Type> Function.getType() {
    return this.fctType;
}

public p Function.setLinkage(LLVMLinkage linkage) {
    LLVMSetLinkage(this.self, linkage);
}

public p Function.pushBack(BasicBlock bb) {
    LLVMAppendExistingBasicBlock(this.self, bb.self);
}

public f<Function> Module.getOrInsertFunction(string name, Type fctType) {
    LLVMFunctionRef fctRef = LLVMGetNamedFunction(this.self, name);
    if fctRef == nil<LLVMFunctionRef> {
        fctRef = LLVMAddFunction(this.self, name, fctType.self);
    }
    return Function{ fctRef, fctType };
}

// ===== LLVMBuilder =====
public type IRBuilder struct {
    LLVMBuilderRef self = nil<LLVMBuilderRef>
    LLVMContextRef ctx = nil<LLVMContextRef>
}

public p IRBuilder.ctor() {
    this.self = nil<LLVMBuilderRef>;
    this.ctx = nil<LLVMContextRef>;
}

public p IRBuilder.ctor(const LLVMContext& parentCtx) {
    this.ctx = parentCtx.self;
    this.self = LLVMCreateBuilderInContext(this.ctx);
}

public p IRBuilder.dtor() {
    LLVMDisposeBuilder(this.self);
}

public f<Type> IRBuilder.getInt1Ty() {
    return Type{ LLVMInt1TypeInContext(this.ctx) };
}

public f<Type> IRBuilder.getInt8Ty() {
    return Type{ LLVMInt8TypeInContext(this.ctx) };
}

public f<Type> IRBuilder.getInt16Ty() {
    return Type{ LLVMInt16TypeInContext(this.ctx) };
}

