// ===== TargetMachine =====
public type TargetMachine struct {
    LLVMTargetMachineRef self = nil<LLVMTargetMachineRef>
}

p TargetMachine.ctor(LLVMTargetRef targetRef, Triple triple, string cpu, string features, LLVMCodeGenOptLevel optLevel, LLVMRelocMode relocMode, LLVMCodeModel codeModel) {
    this.self = LLVMCreateTargetMachine(targetRef, triple.value, cpu, features, optLevel, relocMode, codeModel);
}

public p TargetMachine.dtor() {
    LLVMDisposeTargetMachine(this.self);
}

public f<LLVMError> TargetMachine.emitToFile(const Module& module, string filename, LLVMCodeGenFileType codegen) {
    string errorMessage;
    const bool errorOccurred = LLVMTargetMachineEmitToFile(this.self, module.self, filename, codegen, &errorMessage) != 0;
    assert !errorOccurred;
    return LLVMError(errorMessage);
}

/**
 * Emit the given module to a file
 *
 * @param module Module to emit
 * @param filename Output file path
 * @param codegen Type of the file to emit
 * @param errorMessage Error message, if the emission failed
 * @return True if the emission failed
 */
public f<bool> TargetMachine.emitToFileWithError(const Module& module, string filename, LLVMCodeGenFileType codegen, String& errorMessage) {
    string outMessage = nil<string>;
    const bool errorOccurred = LLVMTargetMachineEmitToFile(this.self, module.self, filename, codegen, &outMessage) != 0;
    if outMessage != nil<string> {
        errorMessage = String(outMessage);
        LLVMDisposeMessage(outMessage);
    }
    return errorOccurred;
}

/**
 * Emit the given module to a string (e.g. assembly code)
 *
 * @param module Module to emit
 * @param codegen Type of the file to emit
 * @param output Emitted file content
 * @return True if the emission failed
 */
public f<bool> TargetMachine.emitToString(const Module& module, LLVMCodeGenFileType codegen, String& output) {
    string outMessage = nil<string>;
    LLVMMemoryBufferRef buffer = nil<LLVMMemoryBufferRef>;
    const bool errorOccurred = LLVMTargetMachineEmitToMemoryBuffer(this.self, module.self, codegen, &outMessage, &buffer) != 0;
    if outMessage != nil<string> {
        LLVMDisposeMessage(outMessage);
    }
    if errorOccurred {
        return true;
    }
    // The buffer is null-terminated (LLVM copies the emitted data into a null-terminated memory buffer)
    const string bufferStart = LLVMGetBufferStart(buffer);
    output = String(bufferStart);
    LLVMDisposeMemoryBuffer(buffer);
    return false;
}

public f<DataLayout> TargetMachine.createDataLayout() {
    return DataLayout{ LLVMCreateTargetDataLayout(this.self) };
}

