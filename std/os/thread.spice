#![core.compiler.requiresOs]
#![core.linker.flag = "-pthread"]

import "std/type/lambda";

// Type definitions
type Pthread_t alias long;
type Pthread_attr_t struct {
    unsigned byte detached
    char* ss_sp
    unsigned long ss_size
}

// Link external functions
// Here we use a little trick to pass the arguments:
// Spice represents the procedure type as { ptr, ptr } struct, but the pthread_create accepts ptr, ptr.
ext f<int> pthread_create(Pthread_t* /*thread*/, Pthread_attr_t* /*attr*/, p() /*start_routine + arg*/);
ext f<int> pthread_join(Pthread_t /*thread*/, byte** /*retval*/);
ext f<Pthread_t> pthread_self();

/**
 * Lightweight thread, that uses posix threads (pthread) under the hood.
 */
public type Thread struct {
    Lambda<p()> threadRoutine
    Pthread_t threadId = 0l
}

/**
 * Construct a thread from a procedure to run
 *
 * @param threadRoutine Procedure to execute on the thread
 */
public p Thread.ctor(p() threadRoutine) {
    // Wrap the routine in an owning Lambda. This takes ownership of the routine's captures (if any), so a
    // capturing lambda may safely be used as a thread routine even though its captures were created in the
    // caller's now-dying frame. Non-capturing routines work just as well (the Lambda simply owns nothing).
    this.threadRoutine = Lambda<p()>(threadRoutine);
}

/**
 * Construct a thread from a lambda to run
 *
 * @param threadRoutine Lambda to execute on the thread
 */
public p Thread.ctor(const Lambda<p()>& threadRoutine) {
    this.threadRoutine = threadRoutine;
}

/**
 * Start the thread
 *
 * @return Ok, or an error if the thread could not be created, e.g. because the system lacks the resources for another thread
 */
public f<Result<bool>> Thread.run() {
    // pthread_create may leave a stale id behind, if it fails. It is only stored on success, so that join() sees, that the
    // thread was not started
    Pthread_t newThreadId = 0l;
    if pthread_create(&newThreadId, nil<Pthread_attr_t*>, this.threadRoutine.get()) != 0 {
        return err<bool>("pthread_create failed");
    }
    this.threadId = newThreadId;
    return ok(true);
}

/**
 * Wait synchronous until the thread has terminated
 *
 * @return Ok, or an error if the thread could not be joined, e.g. because it was never started
 */
public f<Result<bool>> Thread.join() {
    // pthread_join does not validate the thread id, so joining a thread, that was never started, would crash
    if this.threadId == 0l {
        return err<bool>("Cannot join a thread, that was not started");
    }
    if pthread_join(this.threadId, nil<byte**>) != 0 {
        return err<bool>("pthread_join failed");
    }
    return ok(true);
}

/**
 * Retrieve the ID of the current thread
 */
public f<Pthread_t> Thread.getId() {
    return this.threadId;
}

/**
 * Retrieve the ID of the current thread
 */
public f<Pthread_t> getThreadId() {
    return pthread_self();
}
