import "std/os/thread";
import "std/data/vector";
import "std/os/cpu";
import "std/os/mutex";
import "std/os/system";
import "std/type/lambda";

/**
 * A thread pool that can be used to run multiple jobs in parallel.
 * Thread pools in Spice work with a fixed number of worker threads, that are created when the pool is started. After that, an
 * arbitrary number of jobs can be queued to be run by the pool. The pool will then run as many jobs as possible in parallel.
 * The jobs are started in the order, they were enqueued in.
 */
public type ThreadPool struct {
    Vector<Thread> workerThreads
    unsigned short workerThreadCount
    // The state below is shared between the worker threads and the controlling thread. It is guarded by a single mutex, so
    // that a worker decides on the next step (take a job, wait or exit) based on a consistent snapshot of it.
    Mutex mutex
    // The queued jobs are taken in order. The jobs before nextJobIndex were already taken by a worker thread
    Vector<Lambda<p()>> queuedJobs
    unsigned long nextJobIndex = 0ul
    unsigned short runningJobs = 0s
    bool stopRequested = false
    bool stopOnEmptyQueueRequested = false
    bool pauseRequested = false
}

/**
 * Create a new thread pool.
 *
 * @param maxConcurrentJobs The maximum number of jobs that can be run at the same time. If 0, the number of CPU cores is used.
 */
public p ThreadPool.ctor(unsigned short workerThreadCount = 0s) {
    this.workerThreads = Vector<Thread>();
    this.workerThreadCount = workerThreadCount > 0s ? workerThreadCount : cast<unsigned short>(getCPUCoreCount());
}

/**
 * Start the thread pool.
 */
public p ThreadPool.start() {
    p() workerRoutine = p() [[async]] {
        p() task;
        while this.waitForNextJob(task) {
            task();
            this.finishJob();
        }
    };

    // Create worker threads. Reserve the storage upfront, so that running threads are never relocated
    this.workerThreads.reserve(this.workerThreads.getSize() + cast<unsigned long>(this.workerThreadCount));
    for unsigned short i = 0s; i < this.workerThreadCount; i++ {
        this.workerThreads.pushBack(Thread(workerRoutine));
        Thread& workerThread = this.workerThreads.back();
        workerThread.run();
    }
}

/**
 * Finish the running jobs and stop the thread pool.
 */
public p ThreadPool.stop() {
    // Stop worker threads
    this.setFlag(this.stopRequested, true);
    // Wait for all worker threads to terminate
    this.joinWorkerThreads();
    // Reset the stop flag
    this.setFlag(this.stopRequested, false);
}

/**
 * Wait for all queued jobs to finish and stop the thread pool.
 */
public p ThreadPool.join() {
    // Stop worker threads
    this.setFlag(this.stopOnEmptyQueueRequested, true);
    // Wait for all worker threads to terminate
    this.joinWorkerThreads();
    // Reset the stop flag
    this.setFlag(this.stopOnEmptyQueueRequested, false);
}

/**
 * Enqueue a job to be run by the thread pool.
 *
 * @param job The job routine to enqueue.
 */
public p ThreadPool.enqueue(const p()& job) {
    // Take ownership of the captures of the job, since it might run after the frame, that created it, was left
    LockGuard _ = LockGuard(this.mutex);
    this.queuedJobs.pushBack(Lambda<p()>(job));
}

/**
 * Enqueue a job to be run by the thread pool.
 *
 * @param job The job routine to enqueue.
 */
public p ThreadPool.enqueue(const Lambda<p()>& job) {
    LockGuard _ = LockGuard(this.mutex);
    this.queuedJobs.pushBack(job);
}

/**
 * Pause the thread pool. The worker threads will finish their current job and then wait for the pool to be resumed.
 */
public p ThreadPool.pause() {
    this.setFlag(this.pauseRequested, true);
}

/**
 * Resume the thread pool.
 */
public p ThreadPool.resume() {
    this.setFlag(this.pauseRequested, false);
}

/**
 * Check if the thread pool is paused.
 */
public f<bool> ThreadPool.isPaused() {
    LockGuard _ = LockGuard(this.mutex);
    return this.pauseRequested;
}

/**
 * Retrieve the number of jobs that are currently running.
 */
public f<unsigned short> ThreadPool.getRunningJobCount() {
    LockGuard _ = LockGuard(this.mutex);
    return this.runningJobs;
}

/**
 * Retrieve the number of jobs that are currently queued.
 */
public f<unsigned short> ThreadPool.getQueuedJobCount() {
    LockGuard _ = LockGuard(this.mutex);
    return cast<unsigned short>(this.queuedJobs.getSize() - this.nextJobIndex);
}

/**
 * Retrieve the number of worker threads.
 */
public f<unsigned short> ThreadPool.getWorkerThreadCount() {
    return this.workerThreadCount;
}

/**
 * Wait for all worker threads to terminate.
 */
p ThreadPool.joinWorkerThreads() {
    foreach Thread& workerThread : this.workerThreads {
        workerThread.join();
    }
    // The joined threads must not be joined again, so they are dropped. This way, the pool can be started again.
    this.workerThreads.clear();
    // Drop the jobs, that were already taken, if the queue was drained
    LockGuard _ = LockGuard(this.mutex);
    if this.nextJobIndex == this.queuedJobs.getSize() {
        this.queuedJobs.clear();
        this.nextJobIndex = 0ul;
    }
}

/**
 * Wait until the worker thread can take the next job off the queue or has to exit. Checking the flags and taking a job
 * happens under the same lock, so that two workers can never race for the same job and a worker never exits, while the
 * state it decided on changes.
 *
 * @param task Job routine, if a job was taken
 * @return True if a job was taken and counted as running, false if the worker thread has to exit
 */
f<bool> ThreadPool.waitForNextJob(p()& task) {
    bool decided = false;
    bool jobTaken = false;
    while !decided {
        {
            LockGuard _ = LockGuard(this.mutex);
            if this.stopRequested {
                decided = true;
            } else if !this.pauseRequested {
                if this.nextJobIndex < this.queuedJobs.getSize() {
                    // The job stays owned by the queue, which keeps its captures alive while it runs. Relocating the queue
                    // keeps the captures in place, so enqueueing more jobs meanwhile is fine.
                    Lambda<p()>& job = this.queuedJobs.get(this.nextJobIndex);
                    task = job.get();
                    this.nextJobIndex++;
                    this.runningJobs++;
                    decided = true;
                    jobTaken = true;
                } else if this.stopOnEmptyQueueRequested {
                    // We are supposed to stop when the queue is empty and there are no more jobs
                    decided = true;
                }
            }
        }
        // Yield to other threads while waiting
        if !decided {
            yield();
        }
    }
    return jobTaken;
}

/**
 * Count a job, that was taken via waitForNextJob, as done.
 */
p ThreadPool.finishJob() {
    LockGuard _ = LockGuard(this.mutex);
    this.runningJobs--;
}

/**
 * Write a control flag of the pool.
 */
p ThreadPool.setFlag(bool& flag, bool value) {
    LockGuard _ = LockGuard(this.mutex);
    flag = value;
}
