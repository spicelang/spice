// Std imports
import "std/data/vector";
import "std/io/dir";
import "std/io/file";
import "std/io/filepath";
import "std/os/env";
import "std/os/os";
import "std/os/impl/process_native";

/**
 * Result of a process, that was run via runProcessCaptured()
 */
public type ProcessResult struct {
    public int exitCode
    public String output // Captured stdout (and stderr, if requested) of the process
}

/**
 * Termination status of a process, that was run via runProcessWithStatus()
 */
public type ProcessStatus struct {
    public int exitCode // Exit code of the process. 128 + signal number, if it was terminated by a signal (like a shell reports it)
    public int termSignal // Number of the signal, that terminated the process, or 0 if it exited by itself (always 0 on Windows)
}

/**
 * Run a program and wait for it to terminate. Its standard streams are connected to the ones of the calling process.
 *
 * No shell is involved: the arguments are passed verbatim to the program, so they are never interpreted as shell syntax
 * (no variable expansion, globbing, redirections, command separators, ...). Use this instead of execCmd() for any
 * command, whose arguments are influenced by (untrusted) input.
 *
 * @param program Name or path of the program. A bare name is searched for on the PATH
 * @param args Arguments for the program (without the program itself)
 * @return Exit code of the program, or an error if it could not be found or started
 */
public f<Result<int>> runProcess(const String& program, const Vector<String>& args) {
    Result<ProcessStatus> status = runProcessWithStatus(program, args);
    if status.isErr() {
        return err<int>(status.getErr());
    }
    return ok(status.unwrap().exitCode);
}

/**
 * Run a program and wait for it to terminate, like runProcess(). Additionally, this reports whether the program was
 * terminated by a signal, which the exit code alone can't tell apart from a program, that exits with 128 + signal number.
 *
 * @param program Name or path of the program. A bare name is searched for on the PATH
 * @param args Arguments for the program (without the program itself)
 * @return Termination status of the program, or an error if it could not be found or started
 */
public f<Result<ProcessStatus>> runProcessWithStatus(const String& program, const Vector<String>& args) {
    const String programPath = findProgram(program);
    if programPath.isEmpty() {
        return err<ProcessStatus>(Error("Program not found"));
    }
    String output;
    ProcessStatus status;
    // Spawn the resolved path, so that the validated program runs. Otherwise, the spawn would search again with its own rules,
    // which are different on Windows (e.g. the current directory first)
    status.exitCode = spawnProcessAndWait(programPath, args, false, false, output, status.termSignal);
    if status.exitCode == PROCESS_SPAWN_FAILED {
        return err<ProcessStatus>(Error("Program could not be started"));
    }
    return ok(status);
}

/**
 * Run a program, wait for it to terminate and capture its standard output. Like runProcess(), no shell is involved.
 *
 * @param program Name or path of the program. A bare name is searched for on the PATH
 * @param args Arguments for the program (without the program itself)
 * @param includeStdErr Also capture the standard error stream of the program, interleaved with its standard output
 * @return Exit code and captured output of the program, or an error if it could not be found or started
 */
public f<Result<ProcessResult>> runProcessCaptured(const String& program, const Vector<String>& args, bool includeStdErr = false) {
    const String programPath = findProgram(program);
    if programPath.isEmpty() {
        return err<ProcessResult>(Error("Program not found"));
    }
    ProcessResult processResult;
    // Spawn the resolved path, so that the validated program runs (see runProcess)
    int termSignal = 0;
    processResult.exitCode = spawnProcessAndWait(programPath, args, true, includeStdErr, processResult.output, termSignal);
    if processResult.exitCode == PROCESS_SPAWN_FAILED {
        return err<ProcessResult>(Error("Program could not be started"));
    }
    return ok(processResult);
}

/**
 * Get the name of the given signal, e.g. 'SIGSEGV' for signal 11. Some signals have different numbers on Linux and macOS
 *
 * @param signal Signal number
 * @return Name of the signal, or an empty string if the signal is unknown
 */
public f<string> getSignalName(int signal) {
    // Signals with the same number on Linux and macOS
    switch signal {
        case 1: { return "SIGHUP"; }
        case 2: { return "SIGINT"; }
        case 3: { return "SIGQUIT"; }
        case 4: { return "SIGILL"; }
        case 5: { return "SIGTRAP"; }
        case 6: { return "SIGABRT"; }
        case 8: { return "SIGFPE"; }
        case 9: { return "SIGKILL"; }
        case 11: { return "SIGSEGV"; }
        case 13: { return "SIGPIPE"; }
        case 14: { return "SIGALRM"; }
        case 15: { return "SIGTERM"; }
        case 21: { return "SIGTTIN"; }
        case 22: { return "SIGTTOU"; }
        case 24: { return "SIGXCPU"; }
        case 25: { return "SIGXFSZ"; }
        case 26: { return "SIGVTALRM"; }
        case 27: { return "SIGPROF"; }
    }
    // Signals with OS-specific numbers
    if isMacOS() {
        switch signal {
            case 7: { return "SIGEMT"; }
            case 10: { return "SIGBUS"; }
            case 12: { return "SIGSYS"; }
            case 16: { return "SIGURG"; }
            case 17: { return "SIGSTOP"; }
            case 18: { return "SIGTSTP"; }
            case 19: { return "SIGCONT"; }
            case 20: { return "SIGCHLD"; }
            case 23: { return "SIGIO"; }
            case 28: { return "SIGWINCH"; }
            case 29: { return "SIGINFO"; }
            case 30: { return "SIGUSR1"; }
            case 31: { return "SIGUSR2"; }
        }
    } else if isLinux() {
        switch signal {
            case 7: { return "SIGBUS"; }
            case 10: { return "SIGUSR1"; }
            case 12: { return "SIGUSR2"; }
            case 16: { return "SIGSTKFLT"; }
            case 17: { return "SIGCHLD"; }
            case 18: { return "SIGCONT"; }
            case 19: { return "SIGSTOP"; }
            case 20: { return "SIGTSTP"; }
            case 23: { return "SIGURG"; }
            case 28: { return "SIGWINCH"; }
            case 29: { return "SIGIO"; }
            case 30: { return "SIGPWR"; }
            case 31: { return "SIGSYS"; }
        }
    }
    return "";
}

/**
 * Search for a program on the PATH, like a shell would do it. On Windows, a name without an extension is searched with the
 * '.exe' extension only, because Windows cannot start a file without an executable extension.
 *
 * @param name Name of the program. A name with a path separator is not searched for, but only checked for existence
 * @return Path to the program, or an empty string if it could not be found
 */
public f<String> findProgram(const String& name) {
    // Names with a path separator are not searched on the PATH
    if name.find('/') >= 0l || name.find('\\') >= 0l {
        return isProgramFile(name) ? name : String();
    }

    Result<string> pathEnv = getEnv("PATH");
    if !pathEnv.isOk() {
        return String();
    }
    const String path = String(pathEnv.unwrap());
    const char separator = isWindows() ? ';' : ':';
    long start = 0l;
    while start <= path.getLength() {
        long separatorIdx = path.find(separator, cast<unsigned long>(start));
        if separatorIdx < 0l {
            separatorIdx = path.getLength();
        }
        const String dir = path.getSubstring(start, separatorIdx - start);
        if !dir.isEmpty() {
            const FilePath candidatePath = FilePath(dir) / name;
            const String candidate = String(candidatePath.toString());
            // On Windows, only a name with an extension is taken as it is. Windows cannot start a file without one, e.g. the
            // shell scripts of MSYS2 like /usr/bin/cmd, that would otherwise shadow cmd.exe on the PATH
            if (!isWindows() || name.find('.') >= 0l) && isProgramFile(candidate) {
                return candidate;
            }
            if isWindows() {
                const String candidateExe = candidate + ".exe";
                if isProgramFile(candidateExe) {
                    return candidateExe;
                }
            }
        }
        start = separatorIdx + 1l;
    }
    return String();
}

/**
 * Check if the given path is an existing program file (an executable file on Unix, an existing file on Windows)
 *
 * @param path Path to check
 * @return Program file or not
 */
f<bool> isProgramFile(const String& path) {
    if !fileExists(path.getRaw()) || dirExists(path.getRaw()) {
        return false;
    }
    return isWindows() || isFileExecutable(path.getRaw());
}
