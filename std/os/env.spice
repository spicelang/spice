// Link external functions
ext f<string> getenv(string);
ext f<int> putenv(string);
ext f<string> strdup(string);

/**
 * Returns the content of an environment variable as string.
 *
 * @return Env variable content or error
 */
public f<Result<string>> getEnv(string name) {
    string value = getenv(name);
    return value != nil<string> ? ok(value) : err<string>(Error("Env var not found"));
}

/**
 * Sets the content of an environment variable to the given value.
 *
 * @return Successful or not
 */
public f<bool> setEnv(string name, string value) {
    String entry = String(name);
    entry += "=";
    entry += value;
    // putenv makes the given string itself part of the environment instead of copying it, so it has to outlive this
    // function. Hence, it is copied to the heap and never freed (strdup is declared to return a string for that reason,
    // a heap pointer would be freed at the end of the scope).
    const string entryCopy = strdup(entry.getRaw());
    return putenv(entryCopy) == 0;
}