// Std imports
import "std/data/vector";

// File permission modes
public const int MODE_ALL_RWX   = 0o0000777;
public const int MODE_ALL_RW    = 0o0000666;
public const int MODE_ALL_R     = 0o0000444;

public const int MODE_OWNER_RWX = 0o0000700;
public const int MODE_OWNER_R   = 0o0000400;
public const int MODE_OWNER_W   = 0o0000200;
public const int MODE_OWNER_X   = 0o0000100;

public const int MODE_GROUP_RWX = 0o0000070;
public const int MODE_GROUP_R   = 0o0000040;
public const int MODE_GROUP_W   = 0o0000020;
public const int MODE_GROUP_X   = 0o0000010;

public const int MODE_OTHER_RWX = 0o0000007;
public const int MODE_OTHER_R   = 0o0000004;
public const int MODE_OTHER_W   = 0o0000002;
public const int MODE_OTHER_X   = 0o0000001;

const int F_OK = 0; // File existence
const int X_OK = 1; // Can execute
const int W_OK = 2; // Can write
const int R_OK = 4; // Can read

const unsigned short IF_MT  = 0o0170000us;
const unsigned short IF_DIR = 0o0040000us;

const int INVALID_HANDLE = -1; // Decimal for 0xFFFFFFFF

const int FILE_ATTRIBUTE_DIRECTORY = 16;
const int FILE_ATTRIBUTE_REPARSE_POINT = 1024; // Symbolic links and junctions

type FileStat struct {
    unsigned int st_dev    // ID of the device containing file
    unsigned short st_ino  // Inode number
    unsigned short st_mode // File type and mode
    short st_nlink         // Number of hard links
    short st_uid           // User ID of owner
    short st_gid           // Group ID of owner
    unsigned int st_rdev   // Device ID (if special file)
    int st_size            // Total size in bytes
    long st_atime          // Time of last access
    long st_mtime          // Time of last modificatio
    long st_ctime          // Time of last status change
}

type FileTime struct {
    int f1
    int f2
}

type DirEntry struct {
    int fileAttributes
    FileTime f2
    FileTime f3
    FileTime f4
    int f5
    int f6
    int f7
    int f8
    char[260] fileName
    char[14] f9
}

// Link external functions
ext f<int> mkdir(string, int);
ext f<int> rmdir(string);
ext f<int> rename(string, string);
ext f<int> access(string, int);
ext f<int> stat(string, FileStat*);
#[core.linker.dll = true, core.compiler.mangledName = "FindFirstFileA"]
ext f<byte*> findFirstFileA(string, DirEntry*);
#[core.linker.dll = true, core.compiler.mangledName = "FindNextFileA"]
ext f<bool> findNextFileA(byte*, DirEntry*);
#[core.linker.dll = true, core.compiler.mangledName = "FindClose"]
ext f<bool> findClose(byte*);

/**
 * Creates an empty directory at the specified path, with the specified mode.
 * Creates at max one directory. If the second last path element does not exist, the operation fails
 *
 * There are predefined constants for the mode available:
 * MODE_ALL_RWX, MODE_ALL_RW, MODE_ALL_R,
 * MODE_OWNER_RWX, MODE_OWNER_R, MODE_OWNER_W, MODE_OWNER_X,
 * MODE_GROUP_RWX, MODE_GROUP_R, MODE_GROUP_W, MODE_GROUP_X,
 * MODE_OTHER_RWX, MODE_OTHER_R, MODE_OTHER_W, MODE_OTHER_X
 *
 * @return Result code of the create operation: 0 = successful, -1 = failed
 */
public f<int> mkDir(string path, int mode) {
    return mkdir(path, mode);
}

/**
 * Deletes an empty directory at the specified path.
 *
 * @return Result code of the delete operation: 0 = successful, -1 = failed
 */
public f<int> rmDir(string path) {
    return rmdir(path);
}

/**
 * Renames a directory.
 *
 * @return Result code of the rename operation: 0 = successful, -1 = failed
 */
public f<int> renameDir(string oldPath, string newPath) {
    return rename(oldPath, newPath);
}

/**
 * Checks if a directory is existing.
 *
 * @return Existing or not
 */
public f<bool> dirExists(string path) {
    // Check if there exists something, a file or a dir
    if access(path, F_OK) == 0 {
        // Check if it is a dir
        dyn fs = FileStat{};
        if stat(path, &fs) != 0 {
            return false;
        }
        return (fs.st_mode & IF_MT) == IF_DIR;
    }
    return false;
}

/**
 * Creates an empty directory at the specified path, with the specified mode.
 * Unlike mkDir, mkDirs can also create nested path structures: any missing parent directories
 * are created along the way, in order. Directories that already exist anywhere along the path
 * (including the target itself) are left as is. Both '/' and '\' are accepted as separators.
 *
 * There are predefined constants for the mode available:
 * MODE_ALL_RWX, MODE_ALL_RW, MODE_ALL_R,
 * MODE_OWNER_RWX, MODE_OWNER_R, MODE_OWNER_W, MODE_OWNER_X,
 * MODE_GROUP_RWX, MODE_GROUP_R, MODE_GROUP_W, MODE_GROUP_X,
 * MODE_OTHER_RWX, MODE_OTHER_R, MODE_OTHER_W, MODE_OTHER_X
 *
 * @return Result code of the create operation: 0 = successful, -1 = failed
 */
public f<int> mkDirs(string path, int mode) {
    String fullPath = String(path);
    if fullPath.isEmpty() { return -1; }
    fullPath.replaceAll('/', '\\');

    // Walk the path component by component, creating each missing directory along the way.
    // A leading separator produces an empty first prefix and a drive letter like "C:\" a drive prefix ("C:"). Both are
    // skipped, since they always pre-exist and mkdir rejects them.
    unsigned long searchStart = 0l;
    while true {
        const long sepIndex = fullPath.find('\\', searchStart);
        const bool isLast = sepIndex == -1l;
        const long end = isLast ? cast<long>(fullPath.getLength()) : sepIndex;
        const String prefix = fullPath.getSubstring(0l, end);

        // Another process may create the directory between the check and mkdir, so only a still missing directory is an error
        const bool isDrivePrefix = prefix.getLength() == 2l && prefix.endsWith(":");
        if !prefix.isEmpty() && !isDrivePrefix && !dirExists(prefix.getRaw()) && mkdir(prefix.getRaw(), mode) != 0 && !dirExists(prefix.getRaw()) {
            return -1;
        }

        if isLast { break; }
        searchStart = cast<unsigned long>(end) + 1l;
    }

    return 0;
}

/**
 * Lists the names of all files and subdirectories directly inside the given directory. The entries '.' and '..' are left
 * out. The names are listed in the order, in which the operating system reports them.
 *
 * @param path Path to the directory
 * @return Names of the entries, or an error if the directory could not be opened
 */
public f<Result<Vector<String>>> listDir(string path) {
    Vector<String> entries;
    if !collectDirEntries(path, String(), false, entries) {
        return err<Vector<String>>(Error("Could not open directory"));
    }
    return ok(entries);
}

/**
 * Lists all files and subdirectories inside the given directory and, recursively, inside its subdirectories. Each entry
 * is reported as a path relative to the given directory, with '/' as separator. A directory is listed before its
 * contents. Symbolic links and junctions to directories are listed, but not descended into. Subdirectories, that cannot
 * be opened (e.g. due to missing permissions) are listed, but their contents are left out.
 *
 * @param path Path to the directory
 * @return Relative paths of the entries, or an error if the directory could not be opened
 */
public f<Result<Vector<String>>> listDirRecursive(string path) {
    Vector<String> entries;
    if !collectDirEntries(path, String(), true, entries) {
        return err<Vector<String>>(Error("Could not open directory"));
    }
    return ok(entries);
}

/**
 * Append the entries of a directory to the given vector
 *
 * @param dirPath Path to the directory
 * @param prefix Relative path of the directory, which is prepended to the entry names
 * @param recursive Descend into subdirectories or not
 * @param entries Vector to append the entries to
 * @return True if the directory could be opened, false if not
 */
f<bool> collectDirEntries(string dirPath, const String& prefix, bool recursive, Vector<String>& entries) {
    // FindFirstFileA expects a search pattern, so match everything inside the directory
    const String searchPattern = String(dirPath) + "\\*";
    DirEntry dirEntry = DirEntry{};
    byte* handle = findFirstFileA(searchPattern.getRaw(), &dirEntry);
    if handle == cast<unsigned long>(INVALID_HANDLE) { return false; }

    bool readMore = true;
    while readMore {
        String name;
        unsafe {
            name = String(cast<string>(&dirEntry.fileName));
        }
        if name != "." && name != ".." {
            String relativePath = prefix;
            if !relativePath.isEmpty() { relativePath += "/"; }
            relativePath += name;
            entries.pushBack(relativePath);

            // Links are not followed, so that a link cycle cannot cause endless recursion
            const bool isDir = (dirEntry.fileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0;
            const bool isLink = (dirEntry.fileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) != 0;
            if recursive && isDir && !isLink {
                const String childPath = String(dirPath) + "\\" + name;
                collectDirEntries(childPath.getRaw(), relativePath, true, entries);
            }
        }
        // Check if there is another entry
        readMore = findNextFileA(handle, &dirEntry);
    }
    findClose(handle);
    return true;
}
