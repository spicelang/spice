// Windows version of filepath_native.spice, picked by the OS suffix. The two files must offer the same symbols.
//
// Windows has no realpath(). The equivalent is to open the path and ask the OS for the final path of the opened
// handle. That resolves symlinks, junctions and '.'/'..' components, and it fails if the path does not exist, just
// like realpath() does.

// Handles are declared as 'unsigned long', which passes exactly like a pointer
ext f<unsigned long> CreateFileA(string /*fileName*/, unsigned int /*access*/, unsigned int /*shareMode*/, byte* /*security*/, unsigned int /*disposition*/, unsigned int /*flags*/, unsigned long /*template*/);
ext f<unsigned int> GetFinalPathNameByHandleA(unsigned long /*file*/, string /*buffer*/, unsigned int /*capacity*/, unsigned int /*flags*/);
ext f<int> CloseHandle(unsigned long /*handle*/);

const int CANONICAL_PATH_BUFFER_SIZE = 4096;
// FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE
const unsigned int FILE_SHARE_ALL = 7u;
const unsigned int OPEN_EXISTING = 3u;
// Directories can only be opened with this flag
const unsigned int FILE_FLAG_BACKUP_SEMANTICS = 33554432u;
const unsigned long INVALID_HANDLE_VALUE = 18446744073709551615ul;

/**
 * Resolves a path to an absolute, symlink-free, '.'/'..' -free canonical form.
 *
 * @param path Path to resolve
 * @return The canonical path, or an empty string if resolution failed (e.g. the path does not exist)
 */
public f<String> resolveCanonicalPath(const String& path) {
    // No access rights are needed, as only the metadata of the file is queried
    const unsigned long file = CreateFileA(path.getRaw(), 0u, FILE_SHARE_ALL, nil<byte*>, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, 0ul);
    if file == INVALID_HANDLE_VALUE {
        return String();
    }

    char[CANONICAL_PATH_BUFFER_SIZE] resolvedBuf;
    unsafe {
        const unsigned int capacity = cast<unsigned int>(CANONICAL_PATH_BUFFER_SIZE);
        const unsigned int length = GetFinalPathNameByHandleA(file, cast<string>(&resolvedBuf), capacity, 0u);
        CloseHandle(file);
        // Zero means failure. A length that does not fit into the buffer means the buffer was too small
        if length == 0u || length >= capacity {
            return String();
        }

        // The OS returns the extended-length form of the path ('\\?\C:\dir' or '\\?\UNC\server\share'), which the rest
        // of the path handling does not expect
        String resolved = String(cast<string>(&resolvedBuf));
        if resolved.startsWith("\\\\?\\UNC\\") {
            return "\\\\" + resolved.getSubstring(8l);
        }
        if resolved.startsWith("\\\\?\\") {
            return resolved.getSubstring(4l);
        }
        return resolved;
    }
}
