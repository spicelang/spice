import "std/os/os";
import "std/io/file";
import "std/data/vector";
import "std/os/filesystem";
import "std/io/impl/filepath_native";

const char PATH_SEPARATOR_UNIX = '/';
const char PATH_SEPARATOR_WINDOWS = '\\';

/**
 * Represents a path to a file or directory on the local file system
 */
public type FilePath struct {
    String path
}

/**
 * Construct an empty file path
 */
public p FilePath.ctor() {
    this.path = String();
}

/**
 * Construct a file path from a raw string
 *
 * @param pathStr Path string
 */
public p FilePath.ctor(string pathStr) {
    this.path = String(pathStr);
}

/**
 * Construct a file path from a String
 *
 * @param pathStr Path string
 */
public p FilePath.ctor(const String& pathStr) {
    this.path = pathStr;
}

/**
 * Replace every path separator in the path with the given one
 *
 * @param separator Separator to use
 */
public p FilePath.replaceSeparator(char separator) {
    if separator != PATH_SEPARATOR_UNIX {
        this.path.replaceAll(PATH_SEPARATOR_UNIX, separator);
    }
    if separator != PATH_SEPARATOR_WINDOWS {
        this.path.replaceAll(PATH_SEPARATOR_WINDOWS, separator);
    }
}

/**
 * Convert the path to use the generic (UNIX) path separator
 */
public inline p FilePath.makeGeneric() {
    this.replaceSeparator(PATH_SEPARATOR_UNIX);
}

/**
 * Convert the path to use the native path separator of the current platform
 */
public inline p FilePath.makeNative() {
    this.replaceSeparator(PATH_SEPARATOR);
}

/**
 * Checks if the filepath is empty
 *
 * @return Is the filepath empty
 */
public inline f<bool> FilePath.isEmpty() {
    return this.path.isEmpty();
}

/**
 * Returns the content of the filepath without modifying.
 *
 * @return The content of the filepath
 */
public inline f<string> FilePath.toString() {
    return this.path.getRaw();
}

/**
 * Returns the content of the filepath using the UNIX path separator.
 *
 * @return The content of the filepath using the UNIX path separator
 */
public inline f<string> FilePath.toGenericString() {
    this.makeGeneric();
    return this.path.getRaw();
}

/**
 * Returns the content of the filepath using the native path separator.
 *
 * @return The content of the filepath using the native path separator
 */
public inline f<string> FilePath.toNativeString() {
    this.makeNative();
    return this.path.getRaw();
}

/**
 * Returns the parent directory of the file or directory.
 *
 * Example:
 * In:  /home/user/file.txt
 * Out: file.txt
 *
 * @return The parent directory of the file or directory
 */
public inline f<String> FilePath.getFileName() {
    this.makeGeneric();
    return this.path.getSubstring(this.path.rfind(PATH_SEPARATOR_UNIX) + 1);
}

/**
 * Returns the parent directory of the file or directory.
 *
 * Example:
 * In:  /home/user/file.txt
 * Out: /home/user
 * In:  file.txt
 * Out: (empty)
 *
 * @return The parent directory of the file or directory
 */
public inline f<String> FilePath.getParentDir() {
    this.makeGeneric();
    const long separatorIdx = this.path.rfind(PATH_SEPARATOR_UNIX);
    // A path without separator has no parent dir, like std::filesystem::path::parent_path() in C++
    if separatorIdx < 0l {
        return String();
    }
    return this.path.getSubstring(0, separatorIdx);
}

/**
 * Returns the base name of the file.
 *
 * Example:
 * In:  /home/user/file.txt
 * Out: file
 *
 * @return The base name of the file
 */
public inline f<String> FilePath.getBaseName() {
    this.makeGeneric();
    const unsigned long start = this.path.rfind(PATH_SEPARATOR_UNIX) + 1;
    const unsigned long length = this.path.rfind('.') - start;
    return this.path.getSubstring(start, length);
}

/**
 * Returns the extension of the file.
 *
 * Example:
 * In:  /home/user/file.txt
 * Out: txt
 * @return The extension of the file
 */
public inline f<String> FilePath.getExtension() {
    return this.path.getSubstring(this.path.rfind('.') + 1);
}

/**
 * Replaces the current file extension with the given new one. If the file has no extension, the new one is appended. An empty
 * new extension removes the current one.
 *
 * Example:
 * In:  /home/user/file.txt
 * Out: /home/user/file.spice
 *
 * @param newExtension New file extension, with or without leading dot
 */
public inline p FilePath.replaceExtension(string newExtension) {
    // Remove the old extension including its dot. A dot at the beginning of the file name belongs to the name and the file
    // name '..' has no extension at all
    const long dotIdx = this.path.rfind('.');
    long separatorIdx = this.path.rfind(PATH_SEPARATOR_UNIX);
    const long windowsSeparatorIdx = this.path.rfind(PATH_SEPARATOR_WINDOWS);
    if windowsSeparatorIdx > separatorIdx {
        separatorIdx = windowsSeparatorIdx;
    }
    const long fileNameStart = separatorIdx + 1l;
    const bool isParentDirName = dotIdx == fileNameStart + 1l && dotIdx == cast<long>(this.path.getLength()) - 1l &&
                                 this.path[fileNameStart] == '.';
    if dotIdx > fileNameStart && !isParentDirName {
        this.path = this.path.getSubstring(0, dotIdx);
    }

    // Append the new extension. An empty one only removes the old extension
    if len(newExtension) > 0 {
        if newExtension[0] != '.' {
            this.path += '.';
        }
        this.path += newExtension;
    }
}

/**
 * Check if two file paths are equal
 *
 * @return Equal or not equal
 */
public inline f<bool> operator==(const FilePath& lhs, const FilePath& rhs) {
    return lhs.path == rhs.path;
}

/**
 * Check if two file paths are not equal
 *
 * @return Not equal or equal
 */
public inline f<bool> operator!=(const FilePath& lhs, const FilePath& rhs) {
    return lhs.path != rhs.path;
}

/**
 * Append a path component to the path, inserting a separator if needed
 *
 * @param rhs Path component to append
 */
public p operator/=(FilePath& lhs, string rhs) {
    // Insert a separator, unless the path is empty or already ends with one
    if !lhs.path.isEmpty() {
        const char lastChar = lhs.path[lhs.path.getLength() - 1l];
        if lastChar != PATH_SEPARATOR && lastChar != PATH_SEPARATOR_UNIX {
            lhs.path += PATH_SEPARATOR;
        }
    }
    lhs.path += rhs;
}

/**
 * Append a path component to the path, inserting a separator if needed
 *
 * @param rhs Path component to append
 */
public inline p operator/=(FilePath& lhs, const String& rhs) {
    lhs /= rhs.getRaw();
}

/**
 * Append a path component to the path, inserting a separator if needed
 *
 * @param rhs Path component to append
 */
public inline p operator/=(FilePath& lhs, const FilePath& rhs) {
    lhs /= rhs.path.getRaw();
}

/**
 * Join a path and a path component into a new file path, inserting a separator if needed
 *
 * @return New joined file path
 */
public inline f<FilePath> operator/(const FilePath& lhs, string rhs) {
    result = FilePath(lhs);
    result /= rhs;
}

/**
 * Join a path and a path component into a new file path, inserting a separator if needed
 *
 * @return New joined file path
 */
public inline f<FilePath> operator/(const FilePath& lhs, const String& rhs) {
    result = FilePath(lhs);
    result /= rhs.getRaw();
}

/**
 * Join two file paths into a new file path, inserting a separator if needed
 *
 * @return New joined file path
 */
public inline f<FilePath> operator/(const FilePath& lhs, const FilePath& rhs) {
    result = FilePath(lhs);
    result /= rhs.path.getRaw();
}

/**
 * Checks if the file or directory exists.
 *
 * @return True if the file or directory exists, false otherwise
 */
public inline f<bool> FilePath.exists() {
    return fileExists(this.path.getRaw());
}

/**
 * Checks whether the path is absolute (starts with the UNIX path separator).
 *
 * @return True if the path is absolute
 */
public inline f<bool> FilePath.hasRootPath() {
    return this.path.startsWith("/");
}

/**
 * Checks whether the path is absolute. Alias for hasRootPath().
 *
 * @return True if the path is absolute
 */
public inline f<bool> FilePath.isAbsolute() {
    return this.hasRootPath();
}

/**
 * Checks whether any component of the path (before any symlink resolution) is exactly '..'. This is a
 * cheap, purely lexical check meant to reject an obviously-escaping path before doing any filesystem
 * work; it does not catch a symlink that resolves outside the intended root (use canonical()/equivalent()
 * for that).
 *
 * @return True if the path has a '..' component
 */
public f<bool> FilePath.hasParentDirComponent() {
    String normalized = this.path;
    normalized.replaceAll(PATH_SEPARATOR_WINDOWS, PATH_SEPARATOR_UNIX);

    long start = 0l;
    while true {
        const long sepIdx = normalized.find(PATH_SEPARATOR_UNIX, start);
        const String segment = sepIdx < 0l ? normalized.getSubstring(start) : normalized.getSubstring(start, sepIdx - start);
        if segment == ".." {
            return true;
        }
        if sepIdx < 0l {
            break;
        }
        start = sepIdx + 1l;
    }
    return false;
}

/**
 * Resolves the path to an absolute, symlink-free, '.'/'..' -free canonical form.
 *
 * @return The canonical path, or an empty FilePath if resolution failed (e.g. the path does not exist)
 */
public f<FilePath> FilePath.canonical() {
    return FilePath(resolveCanonicalPath(this.path));
}

/**
 * Checks whether two paths refer to the same file after resolving symlinks and '.'/'..' components.
 *
 * @param other Other path to compare against
 * @return True if both paths resolve to the same canonical path (and resolution succeeded for both)
 */
public f<bool> FilePath.equivalent(const FilePath& other) {
    const FilePath a = this.canonical();
    const FilePath b = other.canonical();
    if a.isEmpty() || b.isEmpty() {
        return false;
    }
    return a == b;
}

/**
 * Lexically normalizes the path, like std::filesystem::path::lexically_normal: the separators are made generic ('/'), '.'
 * and empty components are dropped and '..' components are resolved against the preceding component. '..' components at
 * the start of a relative path are kept and '..' components directly after the root are dropped. The file system is not
 * accessed, so symlinks are not resolved.
 *
 * @return The normalized path. '.' for an empty result of a relative path
 */
public f<FilePath> FilePath.lexicallyNormal() {
    String root;
    Vector<String> components;
    splitPathComponents(this.path, root, components);

    Vector<String> normalized;
    foreach const String& component : components {
        if component == ".." {
            if !normalized.isEmpty() && normalized.back() != ".." {
                normalized.popBack();
            } else if root.isEmpty() {
                normalized.pushBack(component);
            }
            // '..' directly after the root refers to the root itself
        } else {
            normalized.pushBack(component);
        }
    }
    return FilePath(joinPathComponents(root, normalized, 0l));
}

/**
 * Computes the path relative to the given base path, purely lexically, like std::filesystem::path::lexically_relative.
 * Both paths are normalized first. The file system is not accessed, so symlinks are not resolved.
 *
 * @param base Base path
 * @return The relative path, '.' if both paths are equal, or an empty path if the roots of both paths differ (e.g. one is
 *         absolute and the other is not, or they are on different drives)
 */
public f<FilePath> FilePath.lexicallyRelative(const FilePath& base) {
    const FilePath normalizedPath = this.lexicallyNormal();
    const FilePath normalizedBase = base.lexicallyNormal();
    String pathRoot;
    Vector<String> pathComponents;
    splitPathComponents(normalizedPath.path, pathRoot, pathComponents);
    String baseRoot;
    Vector<String> baseComponents;
    splitPathComponents(normalizedBase.path, baseRoot, baseComponents);
    if pathRoot != baseRoot {
        return FilePath();
    }

    // Skip the common prefix
    unsigned long commonCount = 0l;
    while commonCount < pathComponents.getSize() && commonCount < baseComponents.getSize() &&
            pathComponents.get(commonCount) == baseComponents.get(commonCount) {
        commonCount++;
    }

    // Go up for each remaining component of the base, then down the remaining components of the path
    Vector<String> relativeComponents;
    for unsigned long i = commonCount; i < baseComponents.getSize(); i++ {
        relativeComponents.pushBack(String(".."));
    }
    for unsigned long i = commonCount; i < pathComponents.getSize(); i++ {
        relativeComponents.pushBack(pathComponents.get(i));
    }
    return FilePath(joinPathComponents(String(), relativeComponents, 0l));
}

/**
 * Computes the path relative to the current working directory, like std::filesystem::relative. Both the path and the
 * working directory are made absolute and canonical, if they exist. Otherwise, they are only normalized lexically.
 *
 * @return The relative path, or an empty path if it could not be determined (e.g. the path is on another drive)
 */
public f<FilePath> FilePath.relative() {
    const FilePath workingDir = FilePath(getCurrentWorkingDir());
    if workingDir.isEmpty() {
        return FilePath();
    }
    String root;
    Vector<String> components;
    splitPathComponents(this.path, root, components);
    const FilePath absolutePath = root.isEmpty() ? workingDir / *this : *this;
    const FilePath canonicalPath = weaklyCanonical(absolutePath);
    return canonicalPath.lexicallyRelative(weaklyCanonical(workingDir));
}

/**
 * Resolve the path canonically, if it exists. Otherwise, normalize it lexically.
 *
 * @param path Path to resolve
 * @return Resolved path
 */
f<FilePath> weaklyCanonical(const FilePath& path) {
    const FilePath canonicalPath = path.canonical();
    return canonicalPath.isEmpty() ? path.lexicallyNormal() : canonicalPath.lexicallyNormal();
}

/**
 * Split a path into its root ('/' or a drive like 'C:/', empty for relative paths) and its non-empty components other than
 * '.'. Both separators are accepted.
 *
 * @param path Path to split
 * @param root Root of the path (output)
 * @param components Components of the path (output)
 */
p splitPathComponents(const String& path, String& root, Vector<String>& components) {
    String generic = path;
    generic.replaceAll(PATH_SEPARATOR_WINDOWS, PATH_SEPARATOR_UNIX);
    long start = 0l;
    if generic.startsWith("/") {
        root = String("/");
        start = 1l;
    } else if generic.getLength() >= 3l && generic[1l] == ':' && generic[2l] == PATH_SEPARATOR_UNIX {
        root = generic.getSubstring(0l, 3l);
        start = 3l;
    }
    while start <= generic.getLength() {
        long sepIdx = generic.find(PATH_SEPARATOR_UNIX, start);
        if sepIdx < 0l {
            sepIdx = generic.getLength();
        }
        const String component = generic.getSubstring(start, sepIdx - start);
        if !component.isEmpty() && component != "." {
            components.pushBack(component);
        }
        start = sepIdx + 1l;
    }
}

/**
 * Join a root and path components with generic separators.
 *
 * @param root Root of the path, empty for relative paths
 * @param components Components to join
 * @param startIdx Index of the first component to join
 * @return Joined path. '.' if both the root and the components are empty
 */
f<String> joinPathComponents(const String& root, const Vector<String>& components, unsigned long startIdx) {
    String joined = root;
    for unsigned long i = startIdx; i < components.getSize(); i++ {
        if i > startIdx {
            joined += PATH_SEPARATOR_UNIX;
        }
        joined += components.get(i);
    }
    if joined.isEmpty() {
        joined = String(".");
    }
    return joined;
}

#[test, test.name="FilePath path-safety Smoke test"]
public f<bool> testFilePathPathSafetySmoke() {
    // hasRootPath / isAbsolute - purely lexical, no filesystem access
    const FilePath absPath = FilePath("/home/user/file.txt");
    assert absPath.hasRootPath();
    assert absPath.isAbsolute();
    const FilePath relPath = FilePath("relative/path.txt");
    assert !relPath.hasRootPath();
    assert !relPath.isAbsolute();
    const FilePath emptyPath = FilePath("");
    assert !emptyPath.hasRootPath();

    // hasParentDirComponent - purely lexical, no filesystem access
    const FilePath escaping1 = FilePath("../etc/passwd");
    assert escaping1.hasParentDirComponent();
    const FilePath escaping2 = FilePath("std/../../../etc/passwd");
    assert escaping2.hasParentDirComponent();
    const FilePath escaping3 = FilePath("a/b/..");
    assert escaping3.hasParentDirComponent();
    const FilePath safePath = FilePath("std/text/string.spice");
    assert !safePath.hasParentDirComponent();
    const FilePath lookalike1 = FilePath("..hidden/file.txt"); // ".." only matches as a whole component
    assert !lookalike1.hasParentDirComponent();
    const FilePath lookalike2 = FilePath("file..txt");
    assert !lookalike2.hasParentDirComponent();

    // canonical() / equivalent() - resolve against the real filesystem. Use "." (the current working
    // directory), which always exists, to keep this portable across environments.
    const FilePath cwd = FilePath(".");
    const FilePath cwdCanonical = cwd.canonical();
    assert !cwdCanonical.isEmpty();
    assert cwdCanonical.hasRootPath(); // canonical paths are always absolute

    // Canonicalizing the same input twice must yield the same result, and equivalent() must agree
    assert cwdCanonical == cwd.canonical();
    assert cwd.equivalent(cwd);

    // "./." should resolve to the same place as "."
    const FilePath cwdDotDot = FilePath("./.");
    assert cwd.equivalent(cwdDotDot);

    // A path that cannot possibly exist fails to resolve: canonical() is empty, equivalent() is false
    const FilePath bogus = FilePath("/this/path/almost-certainly-does-not-exist-4b6f3f2e9c1a");
    const FilePath bogusCanonical = bogus.canonical();
    assert bogusCanonical.isEmpty();
    assert !bogus.equivalent(cwd);
    assert !cwd.equivalent(bogus);

    return true;
}