import "std/io/cli-option";
import "std/text/print";
import "std/type/lambda";
import "std/type/type-conversion";
import "std/data/vector";
import "std/data/algorithm";
import "std/os/os";
import "std/io/filepath";
import "std/text/stringstream";

// Generic type defs
type StrOrConstStrObjRef string|const String&;
type TargetVarOrCallbackString string&|p(const string&);
type TargetVarOrCallbackStringObj String&|p(const String&);
type TargetVarOrCallbackInt int&|p(const int&);
type TargetVarOrCallbackFilePath FilePath&|p(const FilePath&);
type TargetVarOrCallbackBool bool&|p(const bool&);

// Type tags used by the positional argument registry to dispatch to
// the per-type option vectors below.
const unsigned int POSITIONAL_TAG_STRING = 0u;
const unsigned int POSITIONAL_TAG_STRING_OBJ = 1u;
const unsigned int POSITIONAL_TAG_INT = 2u;
const unsigned int POSITIONAL_TAG_FILEPATH = 3u;

/**
 * A subcommand of a CLI parser. It groups options, flags and nested subcommands under a name and
 * is responsible for parsing the slice of arguments that belongs to it. The root of a CliParser is
 * itself a CliSubcommand.
 */
public type CliSubcommand struct {
    String name
    String description
    CliSubcommand* parent
    String versionString
    String footerString
    Lambda<p()> callback
    Vector<String> aliases
    Vector<CliSubcommand> subcommands
    Vector<CliOption<bool>> boolOptions
    Vector<CliOption<string>> stringOptions
    Vector<CliOption<String>> stringObjOptions
    Vector<CliOption<int>> intOptions
    Vector<CliOption<FilePath>> filePathOptions
    // Positional argument registry preserving registration order across types.
    // Each entry pairs a type tag (POSITIONAL_TAG_*) with the index into the
    // matching per-type option vector.
    Vector<unsigned int> positionalTypeTags
    Vector<unsigned int> positionalIndices
    // Owning storage for the values split off "--name=value" arguments. Reserved to the argument count before parsing, so
    // pointers into these strings (e.g. of a raw string option in set-value mode) stay valid for the whole parse run.
    Vector<String> inlineValues
    bool allowUnknownOptions = false
}

/**
 * Construct a subcommand
 *
 * @param parent Parent subcommand, or nil for the root subcommand
 * @param versionString Version string inherited from the parent
 * @param name Name of the subcommand
 * @param description Description of the subcommand shown in the help output
 */
public p CliSubcommand.ctor(CliSubcommand* parent, const String& versionString, const String& name, const String& description = String("")) {
    this.name = name;
    this.description = description;
    this.versionString = versionString;
    this.parent = parent;
}

f<bool> CliSubcommand.nameOrAliasMatches(const String& name, const Vector<String>& aliases, string input) {
    if name == input {
        return true;
    }
    return contains<String>(aliases, String(input));
}

/**
 * Parse the arguments belonging to this subcommand, dispatching to nested subcommands as needed
 *
 * @param argc Number of arguments
 * @param argv Array of argument strings
 * @param layer Index of the first argument that belongs to this subcommand
 * @return Exit code of the parse run
 */
public f<int> CliSubcommand.parse(unsigned int argc, string[] argv, int layer = 1) {
    // Check if we have any arguments
    if argc == layer {
        if !this.positionalTypeTags.isEmpty() {
            printf("Missing required positional argument(s).\n");
            return EXIT_CODE_ERROR;
        }
        if this.callback.isEmpty() {
            this.printHelp(argv, layer);
            return EXIT_CODE_SUCCESS;
        }
    }

    unsigned int positionalConsumed = 0u;
    // Reset and pre-size the storage for inline option values ("--name=value"). Reserving up front keeps the buffer from
    // reallocating during parsing, so pointers into its strings remain valid.
    this.inlineValues.clear();
    this.inlineValues.reserve(argc);
    for unsigned int argNo = layer; argNo < argc; argNo++ {
        string arg = argv[argNo];

        // Support the "--name=value" syntax by splitting the inline value off the option name, so it is handled like
        // "--name value". The split-off value is stored in a stable buffer (see this.inlineValues), because a raw string
        // option in set-value mode keeps a pointer to it. The name only needs to be valid within this iteration.
        String optNameStr = String(arg);
        string optName = arg;
        string inlineValue = arg;
        bool hasInlineValue = false;
        if this.isOptionLike(arg) {
            const long eqPos = optNameStr.find('=');
            if eqPos > 0l {
                this.inlineValues.pushBack(optNameStr.getSubstring(cast<unsigned long>(eqPos + 1l)));
                const String& valueRef = this.inlineValues.back();
                inlineValue = valueRef.getRaw();
                optNameStr = optNameStr.getSubstring(0u, eqPos);
                optName = optNameStr.getRaw();
                hasInlineValue = true;
            }
        }

        // Check for subcommands
        foreach const CliSubcommand& subcommand : this.subcommands {
            if this.nameOrAliasMatches(subcommand.getName(), subcommand.aliases, arg) {
                return subcommand.parse(argc, argv, layer + 1);
            }
        }

        // Check all commonly used flags
        if arg == "-h" || arg == "--help" { // Help
            this.printHelp(argv, layer);
            return EXIT_CODE_SUCCESS;
        }
        if layer == 1 && (arg == "-v" || arg == "--version") { // Version
            printf("%s\n", this.versionString);
            return EXIT_CODE_SUCCESS;
        }

        // Check for flags, whose name contains a value (e.g. "--debug-info=none"). They are matched against the whole argument
        // first, so that they take precedence over a flag with the bare name (e.g. "--debug-info")
        if hasInlineValue {
            foreach const CliOption<bool>& boolOption : this.boolOptions {
                if boolOption.isPositional() { continue; }
                if this.nameOrAliasMatches(boolOption.getName(), boolOption.getAliases(), arg) {
                    bool value = true;
                    boolOption.setTargetValue(value);
                    boolOption.callCallback(value);
                    continue 2; // Continue with next argument
                }
            }
        }

        // Check for options (positional options are matched separately below). A flag takes no value, so an argument with an
        // inline value is left to the options with the same name, that take one. Without such an option, it is rejected below
        if !hasInlineValue {
            foreach const CliOption<bool>& boolOption : this.boolOptions {
                if boolOption.isPositional() { continue; }
                if this.nameOrAliasMatches(boolOption.getName(), boolOption.getAliases(), optName) {
                    bool value = true;
                    boolOption.setTargetValue(value);
                    boolOption.callCallback(value);
                    continue 2; // Continue with next argument
                }
            }
        }
        foreach const CliOption<string>& stringOption : this.stringOptions {
            if stringOption.isPositional() { continue; }
            if this.nameOrAliasMatches(stringOption.getName(), stringOption.getAliases(), optName) {
                // Take an inline "--name=value" value directly, if present. It is the first value; for options that accept
                // multiple values, the following arguments are taken as further values, like in the space-separated form.
                if hasInlineValue {
                    stringOption.setTargetValue(inlineValue);
                    stringOption.callCallback(inlineValue);
                    while stringOption.acceptsMultipleValues() && this.hasAnotherValue(argc, argv, argNo, positionalConsumed) {
                        argNo++;
                        string value = argv[argNo];
                        stringOption.setTargetValue(value);
                        stringOption.callCallback(value);
                    }
                    continue 2; // Continue with next argument
                }
                // Check if a value is present
                if argNo + 1u >= argc {
                    printf("Option %s requires a value.\n", arg);
                    return EXIT_CODE_ERROR;
                }
                // Take the value. Options, that accept multiple values, take all following values
                do {
                    argNo++;
                    string value = argv[argNo];
                    stringOption.setTargetValue(value);
                    stringOption.callCallback(value);
                } while stringOption.acceptsMultipleValues() && this.hasAnotherValue(argc, argv, argNo, positionalConsumed);
                continue 2; // Continue with next argument
            }
        }
        foreach const CliOption<String>& stringObjOption : this.stringObjOptions {
            if stringObjOption.isPositional() { continue; }
            if this.nameOrAliasMatches(stringObjOption.getName(), stringObjOption.getAliases(), optName) {
                // Take an inline "--name=value" value directly, if present. It is the first value; for options that accept
                // multiple values, the following arguments are taken as further values, like in the space-separated form.
                if hasInlineValue {
                    String parsedArg = String(inlineValue);
                    stringObjOption.setTargetValue(parsedArg);
                    stringObjOption.callCallback(parsedArg);
                    while stringObjOption.acceptsMultipleValues() && this.hasAnotherValue(argc, argv, argNo, positionalConsumed) {
                        argNo++;
                        String nextArg = String(argv[argNo]);
                        stringObjOption.setTargetValue(nextArg);
                        stringObjOption.callCallback(nextArg);
                    }
                    continue 2; // Continue with next argument
                }
                // Check if a value is present
                if argNo + 1u >= argc {
                    printf("Option %s requires a value.\n", arg);
                    return EXIT_CODE_ERROR;
                }
                // Take the value. Options, that accept multiple values, take all following values
                do {
                    argNo++;
                    String parsedArg = String(argv[argNo]);
                    stringObjOption.setTargetValue(parsedArg);
                    stringObjOption.callCallback(parsedArg);
                } while stringObjOption.acceptsMultipleValues() && this.hasAnotherValue(argc, argv, argNo, positionalConsumed);
                continue 2; // Continue with next argument
            }
        }
        foreach const CliOption<int>& intOption : this.intOptions {
            if intOption.isPositional() { continue; }
            if this.nameOrAliasMatches(intOption.getName(), intOption.getAliases(), optName) {
                // Take an inline "--name=value" value directly, if present. It is the first value; for options that accept
                // multiple values, the following arguments are taken as further values, like in the space-separated form.
                if hasInlineValue {
                    int parsedArg = toInt(inlineValue);
                    intOption.setTargetValue(parsedArg);
                    intOption.callCallback(parsedArg);
                    while intOption.acceptsMultipleValues() && this.hasAnotherValue(argc, argv, argNo, positionalConsumed) {
                        argNo++;
                        int nextArg = toInt(argv[argNo]);
                        intOption.setTargetValue(nextArg);
                        intOption.callCallback(nextArg);
                    }
                    continue 2; // Continue with next argument
                }
                // Check if a value is present
                if argNo + 1u >= argc {
                    printf("Option %s requires a value.\n", arg);
                    return EXIT_CODE_ERROR;
                }
                // Take the value. Options, that accept multiple values, take all following values
                do {
                    argNo++;
                    int parsedArg = toInt(argv[argNo]);
                    intOption.setTargetValue(parsedArg);
                    intOption.callCallback(parsedArg);
                } while intOption.acceptsMultipleValues() && this.hasAnotherValue(argc, argv, argNo, positionalConsumed);
                continue 2; // Continue with next argument
            }
        }
        foreach const CliOption<FilePath>& filePathOption : this.filePathOptions {
            if filePathOption.isPositional() { continue; }
            if this.nameOrAliasMatches(filePathOption.getName(), filePathOption.getAliases(), optName) {
                // Take an inline "--name=value" value directly, if present. It is the first value; for options that accept
                // multiple values, the following arguments are taken as further values, like in the space-separated form.
                if hasInlineValue {
                    FilePath parsedArg = FilePath(inlineValue);
                    filePathOption.setTargetValue(parsedArg);
                    filePathOption.callCallback(parsedArg);
                    while filePathOption.acceptsMultipleValues() && this.hasAnotherValue(argc, argv, argNo, positionalConsumed) {
                        argNo++;
                        FilePath nextArg = FilePath(argv[argNo]);
                        filePathOption.setTargetValue(nextArg);
                        filePathOption.callCallback(nextArg);
                    }
                    continue 2; // Continue with next argument
                }
                // Check if a value is present
                if argNo + 1u >= argc {
                    printf("Option %s requires a value.\n", arg);
                    return EXIT_CODE_ERROR;
                }
                // Take the value. Options, that accept multiple values, take all following values
                do {
                    argNo++;
                    FilePath parsedArg = FilePath(argv[argNo]);
                    filePathOption.setTargetValue(parsedArg);
                    filePathOption.callCallback(parsedArg);
                } while filePathOption.acceptsMultipleValues() && this.hasAnotherValue(argc, argv, argNo, positionalConsumed);
                continue 2; // Continue with next argument
            }
        }

        // Treat the argument as the next unconsumed positional, if any remain. An unmatched option is no positional value
        if !this.isOptionLike(arg) && positionalConsumed < cast<unsigned int>(this.positionalTypeTags.getSize()) {
            this.applyPositional(positionalConsumed, arg);
            positionalConsumed++;
            continue;
        }

        // We could not match the argument
        if !this.allowUnknownOptions {
            printf("Unknown argument: %s\n", arg);
            return EXIT_CODE_ERROR;
        }
    }

    // Ensure all positional arguments were supplied
    if positionalConsumed < cast<unsigned int>(this.positionalTypeTags.getSize()) {
        printf("Missing required positional argument(s).\n");
        return EXIT_CODE_ERROR;
    }

    // Parsing was successful, so this is the selected subcommand. Invoke its callback now that all options are set
    if !this.callback.isEmpty() {
        p() rc = this.callback.get();
        rc();
    }

    return EXIT_CODE_SUCCESS; // Parsing was successful, return success exit code
}

/**
 * Check if the argument after the given one can be taken as another value of an option, that accepts multiple values.
 * This is the case, if it does not look like an option and enough arguments remain for the positional arguments, that are
 * still missing.
 *
 * @param argc Number of arguments
 * @param argv Array of argument strings
 * @param argNo Index of the last consumed argument
 * @param positionalConsumed Number of positional arguments, that were already consumed
 * @return true if the next argument is another value, false otherwise
 */
f<bool> CliSubcommand.hasAnotherValue(unsigned int argc, string[] argv, unsigned int argNo, unsigned int positionalConsumed) {
    const unsigned int nextArgNo = argNo + 1u;
    if nextArgNo >= argc || this.isOptionLike(argv[nextArgNo]) {
        return false;
    }
    const unsigned int missingPositionals = cast<unsigned int>(this.positionalTypeTags.getSize()) - positionalConsumed;
    return this.countPositionalCandidates(argc, argv, nextArgNo) > missingPositionals;
}

/**
 * Check if the given argument looks like an option, i.e. starts with a dash. Negative numbers and a single dash are values.
 *
 * @param arg Argument to check
 * @return true if the argument looks like an option, false otherwise
 */
f<bool> CliSubcommand.isOptionLike(string arg) {
    String argStr = String(arg);
    if !argStr.startsWith("-") || argStr.getLength() < 2l {
        return false;
    }
    const char secondChar = argStr[1l];
    return (secondChar < '0' || secondChar > '9') && secondChar != '.';
}

/**
 * Check if the given argument is the name or an alias of an option of this subcommand, that takes a value
 *
 * @param arg Argument to check
 * @return true if the argument is an option, that takes a value, false otherwise
 */
f<bool> CliSubcommand.isValueOption(string arg) {
    // The bare name of a flag never takes a value, even if an option with the same name takes one (e.g. "--name=value")
    foreach const CliOption<bool>& boolOption : this.boolOptions {
        if !boolOption.isPositional() && this.nameOrAliasMatches(boolOption.getName(), boolOption.getAliases(), arg) {
            return false;
        }
    }
    foreach const CliOption<string>& stringOption : this.stringOptions {
        if !stringOption.isPositional() && this.nameOrAliasMatches(stringOption.getName(), stringOption.getAliases(), arg) {
            return true;
        }
    }
    foreach const CliOption<String>& stringObjOption : this.stringObjOptions {
        if !stringObjOption.isPositional() && this.nameOrAliasMatches(stringObjOption.getName(), stringObjOption.getAliases(), arg) {
            return true;
        }
    }
    foreach const CliOption<int>& intOption : this.intOptions {
        if !intOption.isPositional() && this.nameOrAliasMatches(intOption.getName(), intOption.getAliases(), arg) {
            return true;
        }
    }
    foreach const CliOption<FilePath>& filePathOption : this.filePathOptions {
        if !filePathOption.isPositional() && this.nameOrAliasMatches(filePathOption.getName(), filePathOption.getAliases(), arg) {
            return true;
        }
    }
    return false;
}

/**
 * Count the arguments from the given index on, that can become positional arguments. Arguments, that look like options, and
 * the values of options, that take a value, are skipped.
 *
 * @param argc Number of arguments
 * @param argv Array of argument strings
 * @param startArgNo Index of the first argument to count
 * @return Number of positional argument candidates
 */
f<unsigned int> CliSubcommand.countPositionalCandidates(unsigned int argc, string[] argv, unsigned int startArgNo) {
    unsigned int count = 0u;
    unsigned int argNo = startArgNo;
    while argNo < argc {
        const string arg = argv[argNo];
        if !this.isOptionLike(arg) {
            count++;
        } else if this.isValueOption(arg) {
            argNo++; // Skip the value of the option
        }
        argNo++;
    }
    return count;
}

f<const String&> CliSubcommand.getPositionalName(unsigned int slot) {
    unsigned int typeTag = this.positionalTypeTags.get(slot);
    unsigned int idx = this.positionalIndices.get(slot);
    if typeTag == POSITIONAL_TAG_STRING {
        const CliOption<string>& opt = this.stringOptions.get(idx);
        return opt.getName();
    } else if typeTag == POSITIONAL_TAG_STRING_OBJ {
        const CliOption<String>& opt = this.stringObjOptions.get(idx);
        return opt.getName();
    } else if typeTag == POSITIONAL_TAG_INT {
        const CliOption<int>& opt = this.intOptions.get(idx);
        return opt.getName();
    }
    const CliOption<FilePath>& opt = this.filePathOptions.get(idx);
    return opt.getName();
}

// Assigns `value` to the positional option registered at slot `slot`,
// dispatching on the recorded type tag.
p CliSubcommand.applyPositional(unsigned int slot, string value) {
    unsigned int typeTag = this.positionalTypeTags.get(slot);
    unsigned int idx = this.positionalIndices.get(slot);
    if typeTag == POSITIONAL_TAG_STRING {
        const CliOption<string>& opt = this.stringOptions.get(idx);
        opt.setTargetValue(value);
        opt.callCallback(value);
    } else if typeTag == POSITIONAL_TAG_STRING_OBJ {
        const CliOption<String>& opt = this.stringObjOptions.get(idx);
        String parsedArg = String(value);
        opt.setTargetValue(parsedArg);
        opt.callCallback(parsedArg);
    } else if typeTag == POSITIONAL_TAG_INT {
        const CliOption<int>& opt = this.intOptions.get(idx);
        int parsedArg = toInt(value);
        opt.setTargetValue(parsedArg);
        opt.callCallback(parsedArg);
    } else if typeTag == POSITIONAL_TAG_FILEPATH {
        const CliOption<FilePath>& opt = this.filePathOptions.get(idx);
        FilePath parsedArg = FilePath(value);
        opt.setTargetValue(parsedArg);
        opt.callCallback(parsedArg);
    }
}

/**
 * Retrieve the name of the subcommand
 *
 * @return Name of the subcommand
 */
public const f<const String&> CliSubcommand.getName() {
    return this.name;
}

/**
 * Retrieve the description of the subcommand
 *
 * @return Description of the subcommand
 */
public const f<const String&> CliSubcommand.getDescription() {
    return this.description;
}

/**
 * Set the version string reported by the subcommand
 *
 * @param versionString Version string to report
 */
public p CliSubcommand.setVersion(const String& versionString) {
    this.versionString = versionString;
}

/**
 * Set the footer text shown at the bottom of the subcommand's help output
 *
 * @param footerString Footer text
 */
public p CliSubcommand.setFooter(const String& footerString) {
    this.footerString = footerString;
}

/**
 * Set the callback invoked when this subcommand is selected without a nested subcommand
 *
 * @param callback Callback to invoke
 */
public p CliSubcommand.setCallback(p() callback) {
    this.callback = Lambda<p()>(callback);
}

public p CliSubcommand.setCallback(const Lambda<p()>& callback) {
    this.callback = callback;
}

/**
 * Allow unknown options on this subcommand and all of its nested subcommands
 */
public p CliSubcommand.allowUnknownOptions() {
    this.allowUnknownOptions = true;
    foreach CliSubcommand& subcommand : this.subcommands {
        subcommand.allowUnknownOptions();
    }
}

/**
 * Add an alternative name (alias) for the subcommand
 *
 * @param subCommand Alias to add
 */
public p CliSubcommand.addAlias(string subCommand) {
    this.aliases.pushBack(String(subCommand));
}

/**
 * Add an alternative name (alias) for the subcommand
 *
 * @param subCommand Alias to add
 */
public p CliSubcommand.addAlias(const String& subCommand) {
    this.aliases.pushBack(subCommand);
}

/**
 * Register a nested subcommand
 *
 * @param name Name of the subcommand
 * @param description Description of the subcommand
 * @return Reference to the newly created subcommand
 */
public f<CliSubcommand&> CliSubcommand.addSubcommand(string name, string description) {
    this.subcommands.pushBack(CliSubcommand(this, this.versionString, String(name), String(description)));
    return this.subcommands.back();
}

/**
 * Register a nested subcommand
 *
 * @param name Name of the subcommand
 * @param description Description of the subcommand
 * @return Reference to the newly created subcommand
 */
public f<CliSubcommand&> CliSubcommand.addSubcommand(const String& name, const String& description) {
    return this.addSubcommand(name.getRaw(), description.getRaw());
}

/**
 * Register a string option on the subcommand. If the name does not start with a dash, the option
 * is treated as a positional argument.
 *
 * @param name Name of the option
 * @param output Target variable or callback receiving the parsed value
 * @param description Description of the option
 * @return Reference to the newly created option
 */
#[ignoreUnusedReturnValue]
public f<CliOption<string>&> CliSubcommand.addOption<StrOrConstStrObjRef, TargetVarOrCallbackString>(StrOrConstStrObjRef name, TargetVarOrCallbackString output, StrOrConstStrObjRef description) {
    this.stringOptions.pushBack(CliOption<string>(name, output, description));
    CliOption<string>& opt = this.stringOptions.back();
    if opt.isPositional() {
        this.positionalTypeTags.pushBack(POSITIONAL_TAG_STRING);
        this.positionalIndices.pushBack(cast<unsigned int>(this.stringOptions.getSize() - 1l));
    }
    return opt;
}

/**
 * Register a String option on the subcommand. If the name does not start with a dash, the option
 * is treated as a positional argument.
 *
 * @param name Name of the option
 * @param output Target variable or callback receiving the parsed value
 * @param description Description of the option
 * @return Reference to the newly created option
 */
#[ignoreUnusedReturnValue]
public f<CliOption<String>&> CliSubcommand.addOption<StrOrConstStrObjRef, TargetVarOrCallbackStringObj>(StrOrConstStrObjRef name, TargetVarOrCallbackStringObj output, StrOrConstStrObjRef description) {
    this.stringObjOptions.pushBack(CliOption<String>(name, output, description));
    CliOption<String>& opt = this.stringObjOptions.back();
    if opt.isPositional() {
        this.positionalTypeTags.pushBack(POSITIONAL_TAG_STRING_OBJ);
        this.positionalIndices.pushBack(cast<unsigned int>(this.stringObjOptions.getSize() - 1l));
    }
    return opt;
}

/**
 * Register an int option on the subcommand. If the name does not start with a dash, the option
 * is treated as a positional argument.
 *
 * @param name Name of the option
 * @param output Target variable or callback receiving the parsed value
 * @param description Description of the option
 * @return Reference to the newly created option
 */
#[ignoreUnusedReturnValue]
public f<CliOption<int>&> CliSubcommand.addOption<StrOrConstStrObjRef, TargetVarOrCallbackInt>(StrOrConstStrObjRef name, TargetVarOrCallbackInt output, StrOrConstStrObjRef description) {
    this.intOptions.pushBack(CliOption<int>(name, output, description));
    CliOption<int>& opt = this.intOptions.back();
    if opt.isPositional() {
        this.positionalTypeTags.pushBack(POSITIONAL_TAG_INT);
        this.positionalIndices.pushBack(cast<unsigned int>(this.intOptions.getSize() - 1l));
    }
    return opt;
}

/**
 * Register a FilePath option on the subcommand. If the name does not start with a dash, the option
 * is treated as a positional argument.
 *
 * @param name Name of the option
 * @param output Target variable or callback receiving the parsed value
 * @param description Description of the option
 * @return Reference to the newly created option
 */
#[ignoreUnusedReturnValue]
public f<CliOption<FilePath>&> CliSubcommand.addOption<StrOrConstStrObjRef, TargetVarOrCallbackFilePath>(StrOrConstStrObjRef name, TargetVarOrCallbackFilePath output, StrOrConstStrObjRef description) {
    this.filePathOptions.pushBack(CliOption<FilePath>(name, output, description));
    CliOption<FilePath>& opt = this.filePathOptions.back();
    if opt.isPositional() {
        this.positionalTypeTags.pushBack(POSITIONAL_TAG_FILEPATH);
        this.positionalIndices.pushBack(cast<unsigned int>(this.filePathOptions.getSize() - 1l));
    }
    return opt;
}

/**
 * Register a boolean flag on the subcommand
 *
 * @param name Name of the flag
 * @param output Target variable set to true, or callback invoked, when the flag is present
 * @param description Description of the flag
 * @return Reference to the newly created flag
 */
#[ignoreUnusedReturnValue]
public f<CliOption<bool>&> CliSubcommand.addFlag<StrOrConstStrObjRef, TargetVarOrCallbackBool>(StrOrConstStrObjRef name, TargetVarOrCallbackBool output, StrOrConstStrObjRef description) {
    this.boolOptions.pushBack(CliOption<bool>(name, output, description));
    return this.boolOptions.back();
}

/**
 * Print the subcommand's name, aliases and description as a single help entry
 */
public p CliSubcommand.printHelpItem() {
    // Print name and aliases
    StringStream ss;
    ss << "  " << this.name;
    foreach const String& subcommandAlias : this.aliases {
        ss << ", " << subcommandAlias;
    }
    printFixedWidth(ss.str(), 25, true);
    // Description
    printFixedWidth(this.description, 85, true);
    lineBreak();
}

p CliSubcommand.printHelp(string[] argv, int layer) {
    // Build subcommand string
    String subcommand = String(argv[0]);
    for int i = 1; i < layer; i++ {
        subcommand += " " + argv[i];
    }

    // Print usage, including any positional arguments in declaration order
    StringStream usage;
    usage << "Usage: " << subcommand << " [options]";
    for unsigned int i = 0u; i < cast<unsigned int>(this.positionalTypeTags.getSize()); i++ {
        usage << " <" << this.getPositionalName(i) << ">";
    }
    printf("%s\n\n%s\n", this.description, usage.str());
    // Print subcommands
    if !this.subcommands.isEmpty() {
        printf("\nSubcommands:\n");
        foreach const CliSubcommand& subCommand : this.subcommands {
            subCommand.printHelpItem();
        }
    }

    // Print positional arguments
    if !this.positionalTypeTags.isEmpty() {
        printf("\nPositional arguments:\n");
        for unsigned int i = 0u; i < cast<unsigned int>(this.positionalTypeTags.getSize()); i++ {
            unsigned int typeTag = this.positionalTypeTags.get(i);
            unsigned int idx = this.positionalIndices.get(i);
            if typeTag == POSITIONAL_TAG_STRING {
                CliOption<string>& sOpt = this.stringOptions.get(idx);
                sOpt.printHelpItem();
            } else if typeTag == POSITIONAL_TAG_STRING_OBJ {
                CliOption<String>& soOpt = this.stringObjOptions.get(idx);
                soOpt.printHelpItem();
            } else if typeTag == POSITIONAL_TAG_INT {
                CliOption<int>& iOpt = this.intOptions.get(idx);
                iOpt.printHelpItem();
            } else if typeTag == POSITIONAL_TAG_FILEPATH {
                CliOption<FilePath>& fOpt = this.filePathOptions.get(idx);
                fOpt.printHelpItem();
            }
        }
    }

    // Print options (only the non-positional ones)
    long nonPositionalOptionCount = this.stringOptions.getSize() + this.stringObjOptions.getSize()
        + this.intOptions.getSize() + this.filePathOptions.getSize() - this.positionalTypeTags.getSize();
    if nonPositionalOptionCount > 0 {
        printf("\nOptions:\n");
        foreach const CliOption<string>& option : this.stringOptions {
            if option.isPositional() { continue; }
            option.printHelpItem();
        }
        foreach const CliOption<int>& option : this.intOptions {
            if option.isPositional() { continue; }
            option.printHelpItem();
        }
    }

    // Print flags
    printf("\nFlags:\n");
    foreach const CliOption<bool>& flag : this.boolOptions {
        flag.printHelpItem();
    }

    // Print help and version flags
    bool target;
    const dyn helpFlag = CliOption<bool>(String("--help,-h"), target, String("Print this help message"));
    helpFlag.printHelpItem();
    if layer == 1 {
        const dyn versionFlag = CliOption<bool>(String("--version,-v"), target, String("Print the version of the application"));
        versionFlag.printHelpItem();
    }

    // Print footer
    if !this.footerString.isEmpty() {
        printf("\n%s\n", this.footerString);
    }
}