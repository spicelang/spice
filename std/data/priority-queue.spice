// Constants
const unsigned long INITIAL_CAPACITY = 5l;
const unsigned int RESIZE_FACTOR = 2;

// Add generic type definition
type T dyn;

/**
 * A priority queue in Spice is a commonly used data structure, in which every item has a priority
 * attached to it. It is implemented as a binary max-heap stored in a contiguous array, so the item
 * with the highest priority (the largest one according to the `<` operator) is always served first.
 *
 * Time complexity:
 * Insert: O(log n)
 * Delete: O(log n)
 * Peek:   O(1)
 *
 * Priority queues pre-allocate space using an initial size and a resize factor to not have to
 * re-allocate with every item pushed. A default-constructed priority queue stays in an unallocated
 * state (contents = nil, capacity = 0) until the first push.
 *
 * The priority queue owns its items: they are copy-constructed on insertion and destructed on removal, so items that own
 * resources themselves (e.g. strings or other containers) are safe to store.
 */
public type PriorityQueue<T> struct {
    heap T* contents = nil<heap T*> // Pointer to the first data element; nil while unallocated
    unsigned long capacity = 0l     // Allocated number of items; 0 while unallocated
    unsigned long size = 0l         // Current number of items
}

/**
 * Construct a priority queue pre-filled with a number of copies of a default value
 *
 * @param initAllocItems Number of items to insert
 * @param defaultValue Value to fill the priority queue with
 */
public p PriorityQueue.ctor(unsigned long initAllocItems, const T& defaultValue) {
    // Allocate space for the initial number of elements
    this.ctor(initAllocItems);
    // Fill in the default values. All items are equal, so the heap property holds trivially.
    for unsigned long index = 0ul; index < initAllocItems; index++ {
        unsafe {
            __placement_new<T>(&this.contents[index], defaultValue);
        }
    }
    this.size = initAllocItems;
}

/**
 * Construct a priority queue, pre-allocating space for the given number of items
 *
 * @param initAllocItems Number of items to pre-allocate space for
 */
public p PriorityQueue.ctor(unsigned int initAllocItems) {
    this.ctor(cast<unsigned long>(initAllocItems));
}

/**
 * Construct a priority queue, pre-allocating space for the given number of items
 *
 * @param initAllocItems Number of items to pre-allocate space for
 */
public p PriorityQueue.ctor(unsigned long initAllocItems = 0l) {
    // Leave the buffer unallocated when no capacity was requested
    if initAllocItems == 0l { return; }
    // Allocate space for the initial number of elements
    const unsigned long itemSize = sizeof<T>();
    unsafe {
        Result<heap byte*> allocResult = sAlloc(itemSize * initAllocItems);
        this.contents = cast<heap T*>(allocResult.unwrapAndMove());
    }
    this.capacity = initAllocItems;
}

/**
 * Construct a priority queue as a deep copy of another priority queue
 *
 * @param original Priority queue to copy
 */
public p PriorityQueue.ctor(const PriorityQueue<T>& original) {
    this.ctor(original.capacity);
    // Copying the underlying array in order preserves the heap property. Copy-construct each item, so items that own
    // resources get their own copies instead of aliasing the ones of the original (a bitwise copy would do the latter)
    for unsigned long index = 0ul; index < original.size; index++ {
        unsafe {
            __placement_new<T>(&this.contents[index], original.contents[index]);
        }
    }
    this.size = original.size;
}

/**
 * Copy-assign the contents of another priority queue into this one
 *
 * @param newValue Priority queue to copy from
 */
public p operator=<T>(PriorityQueue<T>& this, const PriorityQueue<T>& newValue) {
    // Self-assignment: leave the priority queue as is, clearing it first would destroy the items to copy
    if &this == &newValue { return; }
    // Destruct our currently owned items before their slots get overwritten
    this.clear();
    const unsigned long itemSize = sizeof<T>();
    if newValue.capacity != this.capacity {
        if newValue.capacity == 0l {
            // Drop our buffer to match the unallocated source
            unsafe {
                heap byte*& oldAddress = cast<heap byte*>(this.contents);
                sDealloc(oldAddress);
                this.contents = nil<heap T*>;
            }
        } else {
            unsafe {
                Result<heap byte*> allocResult = sRealloc(cast<heap byte*>(this.contents), itemSize * newValue.capacity);
                this.contents = cast<heap T*>(allocResult.unwrapAndMove());
            }
        }
        this.capacity = newValue.capacity;
    }
    // Copy-construct each item in order, which preserves the heap property
    for unsigned long index = 0ul; index < newValue.size; index++ {
        unsafe {
            __placement_new<T>(&this.contents[index], newValue.contents[index]);
        }
    }
    this.size = newValue.size;
}

/**
 * Destructs the priority queue, destructing all owned items and freeing the buffer
 */
public p PriorityQueue.dtor() {
    this.clear();
    unsafe {
        heap byte*& oldAddress = cast<heap byte*>(this.contents);
        sDealloc(oldAddress);
    }
    this.capacity = 0l;
}

/**
 * Add an item to the priority queue
 */
public p PriorityQueue.push(const T& item) {
    // Check if we need to (re-)allocate memory. Treat an unallocated priority queue the same as a full one.
    if this.size == this.capacity {
        const unsigned long newCapacity = this.capacity == 0l ? INITIAL_CAPACITY : this.capacity * cast<unsigned long>(RESIZE_FACTOR);
        this.resize(newCapacity);
    }

    // Insert the element at the back and restore the heap property by sifting it up
    unsafe {
        __placement_new<T>(&this.contents[this.size], item);
    }
    this.size++;
    this.siftUp(this.size - 1l);
}

/**
 * Retrieve the item with the highest priority and remove it from the priority queue
 *
 * @return Item with the highest priority
 */
#[ignoreUnusedReturnValue]
public f<T> PriorityQueue.pop() {
    if this.isEmpty() { panic(Error("The priority queue is empty")); }
    // Swap the root (highest priority) item with the last one and shrink, then restore the heap property
    this.size--;
    this.swapItems(0l, this.size);
    this.siftDown(0l);
    unsafe {
        // Copy out the removed item via a reference to its slot and destruct the slot. Assigning the subscript expression
        // directly would move it bitwise, so destructing the slot afterwards would free resources, that the returned item
        // still uses
        T& item = this.contents[this.size];
        result = item;
        sDestruct(item);
    }
}

/**
 * Retrieve the item with the highest priority without removing it from the priority queue
 *
 * @return Item with the highest priority
 */
public f<T&> PriorityQueue.peek() {
    if this.isEmpty() { panic(Error("The priority queue is empty")); }
    unsafe {
        return this.contents[0];
    }
}

/**
 * Retrieve the current size of the priority queue
 *
 * @return Current size of the priority queue
 */
public f<long> PriorityQueue.getSize() {
    return this.size;
}

/**
 * Retrieve the current capacity of the priority queue
 *
 * @return Current capacity of the priority queue
 */
public f<long> PriorityQueue.getCapacity() {
    return this.capacity;
}

/**
 * Checks if the priority queue contains any items at the moment
 *
 * @return Empty or not empty
 */
public f<bool> PriorityQueue.isEmpty() {
    return this.size == 0;
}

/**
 * Checks if the priority queue exhausts its capacity and needs to resize at the next call of push.
 * A priority queue with no allocated capacity is not considered full — the next push will simply
 * bootstrap the buffer.
 *
 * @return Full or not full
 */
public f<bool> PriorityQueue.isFull() {
    return this.capacity != 0l && this.size == this.capacity;
}

/**
 * Removes all items from the priority queue. The allocated capacity is kept.
 */
public p PriorityQueue.clear() {
    // Destruct owned items before dropping them
    for unsigned long index = 0ul; index < this.size; index++ {
        unsafe {
            sDestruct(this.contents[index]);
        }
    }
    this.size = 0l;
}

/**
 * Reserves `itemCount` items
 */
public p PriorityQueue.reserve(unsigned long itemCount) {
    if itemCount > this.capacity {
        this.resize(itemCount);
    }
}

/**
 * Frees allocated memory that is not used by the priority queue
 */
public p PriorityQueue.pack() {
    // Return if no packing is required
    if this.isFull() { return; }
    // Pack the array
    this.resize(this.size);
}

/**
 * Check if two priority queues are equal, i.e. they hold the same items in the same priority order
 *
 * @return Equal or not equal
 */
public f<bool> operator==<T>(const PriorityQueue<T>& lhs, const PriorityQueue<T>& rhs) {
    // Compare the sizes
    if lhs.size != rhs.size { return false; }
    // Two heaps are equal if they hold the same items in the same priority order. Since two equal
    // multisets can have different internal array layouts, compare by draining copies in priority order.
    PriorityQueue<T> a = PriorityQueue<T>(lhs);
    PriorityQueue<T> b = PriorityQueue<T>(rhs);
    while !a.isEmpty() {
        if a.pop() != b.pop() { return false; }
    }
    return true;
}

/**
 * Check if two priority queues are not equal
 *
 * @return Not equal or equal
 */
public f<bool> operator!=<T>(const PriorityQueue<T>& lhs, const PriorityQueue<T>& rhs) {
    return !(lhs == rhs);
}

/**
 * Restores the heap property by moving the item at `index` up towards the root
 */
p PriorityQueue.siftUp(unsigned long index) {
    unsafe {
        while index > 0l {
            const unsigned long parent = (index - 1l) / 2l;
            // Stop as soon as the parent is not lower in priority than the current item
            if !(this.contents[parent] < this.contents[index]) {
                break;
            }
            this.swapItems(parent, index);
            index = parent;
        }
    }
}

/**
 * Restores the heap property by moving the item at `index` down towards the leaves
 */
p PriorityQueue.siftDown(unsigned long index) {
    unsafe {
        while true {
            const unsigned long left = 2l * index + 1l;
            const unsigned long right = 2l * index + 2l;
            unsigned long largest = index;
            if left < this.size && this.contents[largest] < this.contents[left] {
                largest = left;
            }
            if right < this.size && this.contents[largest] < this.contents[right] {
                largest = right;
            }
            // Stop as soon as the item is not lower in priority than either child
            if largest == index {
                break;
            }
            this.swapItems(index, largest);
            index = largest;
        }
    }
}

/**
 * Swaps two items bitwise. The items are relocated, not copied, so neither copy ctors nor dtors run and items that own
 * resources keep owning exactly the same ones.
 */
p PriorityQueue.swapItems(unsigned long indexA, unsigned long indexB) {
    if indexA == indexB { return; }
    const unsigned long itemSize = sizeof<T>();
    unsafe {
        byte* itemA = cast<byte*>(&this.contents[indexA]);
        byte* itemB = cast<byte*>(&this.contents[indexB]);
        for unsigned long i = 0ul; i < itemSize; i++ {
            const byte tmp = itemA[i];
            itemA[i] = itemB[i];
            itemB[i] = tmp;
        }
    }
}

/**
 * Re-allocates heap space for the priority queue contents
 */
p PriorityQueue.resize(unsigned long itemCount) {
    // Free the buffer if we are shrinking down to zero capacity
    if itemCount == 0l {
        unsafe {
            heap byte*& oldAddress = cast<heap byte*>(this.contents);
            sDealloc(oldAddress);
            this.contents = nil<heap T*>;
        }
        this.capacity = 0l;
        return;
    }
    // Allocate the new memory
    const unsigned long itemSize = sizeof<T>();
    unsafe {
        heap byte*& oldAddress = cast<heap byte*>(this.contents);
        unsigned long newSize = cast<unsigned long>(itemSize * itemCount);
        Result<heap byte*> allocResult = sRealloc(oldAddress, newSize);
        this.contents = cast<heap T*>(allocResult.unwrapAndMove());
    }
    // Set new capacity
    this.capacity = itemCount;
}
