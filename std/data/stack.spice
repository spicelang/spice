// Constants
const unsigned long INITIAL_CAPACITY = 5l;
const unsigned int RESIZE_FACTOR = 2;

// Add generic type definition
type T dyn;

/**
 * A stack in Spice is a commonly used data structure, which uses the FiLo (first in, last out) principle.
 *
 * Time complexity:
 * Insert: O(1)
 * Delete: O(1)
 * Search: O(n)
 *
 * Stacks pre-allocate space using an initial size and a resize factor to not have to re-allocate
 * with every item pushed. A default-constructed stack stays in an unallocated state (contents = nil,
 * capacity = 0) until the first push.
 */
public type Stack<T> struct {
    heap T* contents = nil<heap T*> // Pointer to the first data element; nil while unallocated
    unsigned long capacity = 0l     // Allocated number of items; 0 while unallocated
    unsigned long size = 0l         // Current number of items
}

/**
 * Construct a stack, pre-allocating space for the given number of items
 *
 * @param initAllocItems Number of items to pre-allocate space for
 */
public inline p Stack.ctor(unsigned long initAllocItems = 0l) {
    this.resize(initAllocItems);
}

/**
 * Construct a stack, pre-allocating space for the given number of items
 *
 * @param initAllocItems Number of items to pre-allocate space for
 */
public inline p Stack.ctor(unsigned int initAllocItems) {
    this.resize(cast<unsigned long>(initAllocItems));
}

/**
 * Construct a stack pre-filled with a number of copies of a default value
 *
 * @param initAllocItems Number of items to insert
 * @param defaultValue Value to fill the stack with
 */
public p Stack.ctor(unsigned long initAllocItems, const T& defaultValue) {
    // Allocate space for the initial number of elements
    this.resize(initAllocItems);
    // Fill in the default values
    for unsigned long index = 0ul; index < initAllocItems; index++ {
        unsafe {
            __placement_new<T>(&this.contents[index], defaultValue);
        }
    }
    this.size = initAllocItems;
}

/**
 * Construct a stack as a deep copy of another stack
 *
 * @param original Stack to copy
 */
public p Stack.ctor(const Stack<T>& original) {
    this.resize(original.capacity);
    // Copy-construct each element individually, so non-trivial elements get their own owned resources
    // instead of aliasing the source's (a raw memcpy of the buffer would do the latter)
    for unsigned long index = 0ul; index < original.size; index++ {
        unsafe {
            __placement_new<T>(&this.contents[index], original.contents[index]);
        }
    }
    this.size = original.size;
}

/**
 * Copy-assign the contents of another stack into this one
 *
 * @param newValue Stack to copy from
 */
public p operator=<T>(Stack<T>& this, const Stack<T>& newValue) {
    // Self-assignment: leave the queue as is; normalizing in place would
    // overwrite source slots before the wrapped index reads them.
    if &this == &newValue { return; }
    // Clear the old, resize the new one
    this.clear();
    this.resize(newValue.capacity);
    // Copy-construct each element individually, so non-trivial elements get their own owned resources
    // instead of aliasing the source's (a raw memcpy of the buffer would do the latter)
    for unsigned long index = 0ul; index < newValue.size; index++ {
        unsafe {
            __placement_new<T>(&this.contents[index], newValue.contents[index]);
        }
    }
    this.size = newValue.size;
}

/**
 * Destructs the stack, destructing all owned elements and freeing the buffer
 */
public p Stack.dtor() {
    this.clear();
    unsafe {
        heap byte*& oldAddress = cast<heap byte*>(this.contents);
        sDealloc(oldAddress);
    }
    this.capacity = 0l;
}

/**
 * Removes all items from the stack. The allocated capacity is kept.
 */
public p Stack.clear() {
    for unsigned long index = 0l; index < this.size; index++ {
        unsafe {
            sDestruct(this.contents[index]);
        }
    }
    this.size = 0l;
}

/**
 * Add an item to the stack
 */
public p Stack.push(const T& item) {
    // The item may be an element of this stack, so remember its index to find it again after a reallocation
    const unsigned long itemIdx = this.getElementIndex(item);
    // Check if we need to (re-)allocate memory. Treat an unallocated stack the same as a full one.
    if this.size == this.capacity {
        this.resize(this.capacity == 0l ? INITIAL_CAPACITY : this.capacity * RESIZE_FACTOR);
    }

    // Insert the element at the back
    unsafe {
        const T* source = itemIdx < this.size ? &this.contents[itemIdx] : &item;
        __placement_new<T>(&this.contents[this.size++], *source);
    }
}

/**
 * Retrieve the topmost item and remove it. The item is returned by value, because its slot in the stack is destructed.
 *
 * @return Topmost item
 */
#[ignoreUnusedReturnValue]
public f<T> Stack.pop() {
    if this.isEmpty() {
        panic(Error("The stack is empty"));
    }
    unsafe {
        // Copy the item via a reference to its slot. Assigning the subscript expression directly would move it bitwise,
        // so destructing the slot afterwards would free resources, that the returned item still uses
        T& item = this.contents[--this.size];
        result = item;
        sDestruct(item);
    }
}

/**
 * Retrieve topmost without removing it from the stack
 */
public f<T&> Stack.top() {
    if this.isEmpty() {
        panic(Error("The stack is empty"));
    }
    // Peek the element from the stack
    unsafe {
        return this.contents[this.size - 1l];
    }
}

/**
 * Retrieve the current size of the stack
 *
 * @return Current size of the stack
 */
public f<unsigned long> Stack.getSize() {
    return this.size;
}

/**
 * Retrieve the current capacity of the stack
 *
 * @return Current capacity of the stack
 */
public inline f<unsigned long> Stack.getCapacity() {
    return this.capacity;
}

/**
 * Checks if the stack contains any items at the moment
 *
 * @return Empty or not empty
 */
public inline f<bool> Stack.isEmpty() {
    return this.size == 0;
}

/**
 * Checks if the stack exhausts its capacity and needs to resize at the next call of push.
 * A stack with no allocated capacity is not considered full — the next push will simply
 * bootstrap the buffer.
 *
 * @return Full or not full
 */
public inline f<bool> Stack.isFull() {
    return this.capacity != 0l && this.size == this.capacity;
}

/**
 * Frees unused allocated memory
 */
public p Stack.pack() {
    // Pack the array if necessary
    if !this.isFull() {
        this.resize(this.size);
    }
}

/**
 * Check if two stacks are equal, i.e. they have the same size and equal contents
 *
 * @return Equal or not equal
 */
public f<bool> operator==<T>(const Stack<T>& lhs, const Stack<T>& rhs) {
    // Compare the sizes
    if lhs.size != rhs.size { return false; }
    // Compare the contents element-wise, since a byte-wise comparison is wrong for non-trivial types
    for unsigned long index = 0l; index < lhs.size; index++ {
        unsafe {
            if lhs.contents[index] != rhs.contents[index] {
                return false;
            }
        }
    }
    return true;
}

/**
 * Check if two stacks are not equal
 *
 * @return Not equal or equal
 */
public inline f<bool> operator!=<T>(const Stack<T>& lhs, const Stack<T>& rhs) {
    return !(lhs == rhs);
}

/**
 * Retrieve the index of an item, that is an element of this stack. Inserting methods use it to find the item again, after
 * they reallocated the buffer
 *
 * @param item Item to look up
 * @return Index of the item or the size of the stack, if the item is not an element of this stack
 */
f<unsigned long> Stack.getElementIndex(const T& item) {
    unsafe {
        const unsigned long itemAddress = cast<unsigned long>(&item);
        const unsigned long contentsAddress = cast<unsigned long>(this.contents);
        const unsigned long itemSize = sizeof<T>();
        if itemAddress < contentsAddress || itemAddress >= contentsAddress + this.size * itemSize {
            return this.size;
        }
        return (itemAddress - contentsAddress) / itemSize;
    }
}

/**
 * Re-allocates heap space for the stack contents
 */
p Stack.resize(unsigned long itemCount) {
    if itemCount == this.capacity {
        return;
    }

    // Free the buffer if we are shrinking down to zero capacity
    if itemCount == 0l {
        unsafe {
            heap byte*& oldAddress = cast<heap byte*>(this.contents);
            sDealloc(oldAddress);
            this.contents = nil<heap T*>;
        }
        this.capacity = 0l;
        return;
    }
    // Allocate the new memory
    unsafe {
        heap byte*& oldAddress = cast<heap byte*>(this.contents);
        const unsigned long newSize = sizeof<T>() * itemCount;
        Result<heap byte*> allocResult = sRealloc(oldAddress, newSize);
        this.contents = cast<heap T*>(allocResult.unwrapAndMove());
    }
    // Set new capacity
    this.capacity = itemCount;
}
