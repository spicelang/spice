import "std/math/hash";
import "std/iterator/iterable";
import "std/iterator/iterator";
import "std/data/pair";

// Smallest slot array the table ever allocates. Always a power of two, like every capacity.
const unsigned long MIN_CAPACITY = 16l;
// The table grows once MAX_LOAD_NUMERATOR / MAX_LOAD_DENOMINATOR of its slots are in use
const unsigned long MAX_LOAD_NUMERATOR = 3l;
const unsigned long MAX_LOAD_DENOMINATOR = 4l;

// Reserved hash values that mark a slot as free. A key hash is moved out of this range by hashKey(),
// so the cached hash of a slot doubles as its state and can be read without touching the entry.
const Hash HASH_EMPTY = 0ul;     // Slot was never used; it terminates a probe chain
const Hash HASH_TOMBSTONE = 1ul; // Slot was vacated by remove(); a probe chain continues past it
const Hash HASH_FIRST_VALID = 2ul;

// Generic types for key and value
type K dyn;
type V dyn;

/**
 * A single key-value pair, allocated on its own so that it never moves.
 */
type Entry<K, V> struct {
    K key
    V value
}

/**
 * One position in the slot array. It caches the key hash next to a pointer to the entry, so a probe
 * can reject a mismatch by comparing two integers and only follows the pointer once the hashes match.
 */
type Slot<K, V> struct {
    Entry<K, V>* entry
    Hash hash
}

/**
 * A hash table in Spice is a commonly used data structure, which stores key-value pairs and allows
 * fast access to a value by its key. Collisions are resolved by open addressing with linear probing
 * over a contiguous slot array, and the table grows once it reaches its maximum load factor.
 *
 * Time complexity:
 * Insert: O(1) (amortized average case), O(n) (worst case)
 * Delete: O(1) (average case), O(n) (worst case)
 * Lookup: O(1) (average case), O(n) (worst case)
 *
 * The average case assumes a good hash distribution. In the worst case, all keys probe the same
 * chain of slots, degrading every operation to a linear scan.
 *
 * The entries themselves live in their own allocations and are never relocated, only the slot array
 * is rebuilt when the table grows. A reference obtained from get() therefore stays valid until that
 * particular key is removed, the table is cleared or the table is destructed - inserting other keys
 * never invalidates it.
 */
public type HashTable<K, V> struct : IIterable<Pair<K, V>> {
    Slot<K, V>* slots = nil<Slot<K, V>*> // Slot array; nil while unallocated
    unsigned long capacity = 0l          // Number of slots, always a power of two; 0 while unallocated
    unsigned long size = 0l              // Number of occupied slots
    unsigned long tombstones = 0l        // Number of slots vacated by remove()
}

/**
 * Construct an empty hash table with room for the given number of entries. Passing 0 keeps the
 * hash table in an unallocated state; the slot array is materialized lazily on the first insertion.
 *
 * @param initialCapacity Number of entries to pre-allocate slots for
 */
public p HashTable.ctor(unsigned long initialCapacity = 0l) {
    if initialCapacity == 0l { return; }
    // Reserve enough slots that the requested number of entries fits below the load factor
    this.rehash(toPowerOfTwo(initialCapacity * MAX_LOAD_DENOMINATOR / MAX_LOAD_NUMERATOR));
}

/**
 * Construct a hash table as a deep copy of another hash table
 *
 * @param original Hash table to copy
 */
public p HashTable.ctor(const HashTable<K, V>& original) {
    this.ctor(original.size);
    this.copyEntriesFrom(original);
}

/**
 * Copy-assign the contents of another hash table into this one
 *
 * @param newValue Hash table to copy from
 */
public p operator=<K, V>(HashTable<K, V>& this, const HashTable<K, V>& newValue) {
    this.clear();
    this.copyEntriesFrom(newValue);
}

/**
 * Destructs the hash table, destructing all entries and freeing the slot array
 */
public p HashTable.dtor() {
    this.clear();
    if this.capacity == 0l { return; }
    unsafe {
        heap byte* rawSlots = cast<heap byte*>(this.slots);
        sDealloc(rawSlots);
    }
    this.slots = nil<Slot<K, V>*>;
    this.capacity = 0l;
}

/**
 * Insert a key-value pair into the hash table.
 * If the key already exists, the value is updated.
 *
 * @param key The key to insert
 * @param value The value to insert
 */
public p HashTable.upsert(const K& key, const V& value) {
    // Grow up front, so the slot picked below already belongs to the final slot array
    this.growIfRequired();

    const Hash keyHash = this.hashKey(key);
    const unsigned long existingIdx = this.findSlot(key, keyHash);
    if existingIdx != this.capacity {
        // The key is already present. Overwriting the value in place keeps the entry where it is,
        // which is what keeps references handed out for this key valid.
        unsafe {
            this.slots[existingIdx].entry.value = value;
        }
        return;
    }

    // Otherwise occupy the first free slot on the probe chain
    const unsigned long freeIdx = this.findFreeSlot(keyHash);
    unsafe {
        Slot<K, V>& slot = this.slots[freeIdx];
        if slot.hash == HASH_TOMBSTONE { this.tombstones--; }
        slot.entry = this.createEntry(key, value);
        slot.hash = keyHash;
    }
    this.size++;
}

/**
 * Retrieve the value associated with the given key.
 * If the key is not found, panic.
 *
 * @param key The key to look up
 * @return The value associated with the key
 */
public f<V&> HashTable.get(const K& key) {
    const unsigned long idx = this.findSlot(key, this.hashKey(key));
    if idx == this.capacity { panic(Error("The provided key was not found")); }
    unsafe {
        return this.slots[idx].entry.value;
    }
}

/**
 * Retrieve the value associated with the given key as Result<V>.
 * If the key is not found, return an error.
 *
 * @param key The key to look up
 * @return Result<V>, containing the value associated with the key or an error if the key is not found
 */
public f<Result<V>> HashTable.getSafe(const K& key) {
    const unsigned long idx = this.findSlot(key, this.hashKey(key));
    if idx == this.capacity { return err<V>(Error("The provided key was not found")); }
    unsafe {
        return ok(this.slots[idx].entry.value);
    }
}

/**
 * Remove the key-value pair associated with the given key.
 * If the key is not found, do nothing.
 *
 * @param key The key to remove
 */
public p HashTable.remove(const K& key) {
    const unsigned long idx = this.findSlot(key, this.hashKey(key));
    if idx == this.capacity { return; }
    unsafe {
        Slot<K, V>& slot = this.slots[idx];
        this.deleteEntry(slot.entry);
        // Leave a tombstone behind. Marking the slot empty would cut every probe chain running
        // through it, hiding keys that were inserted after a collision on this slot.
        slot.hash = HASH_TOMBSTONE;
    }
    this.size--;
    this.tombstones++;
}

/**
 * Check if the hash table contains the given key.
 *
 * @param key The key to check for
 * @return True if the key is found, false otherwise
 */
public f<bool> HashTable.contains(const K& key) {
    return this.findSlot(key, this.hashKey(key)) != this.capacity;
}

/**
 * Get the size of the hash table.
 *
 * @return The number of key-value pairs in the hash table
 */
public inline f<unsigned long> HashTable.getSize() {
    return this.size;
}

/**
 * Checks if the hash table is empty.
 *
 * @return True if empty, false otherwise.
 */
public inline f<bool> HashTable.isEmpty() {
    return this.size == 0l;
}

/**
 * Clear the hash table, removing all key-value pairs. The slot array is kept for reuse.
 */
public p HashTable.clear() {
    for unsigned long i = 0l; i < this.capacity; i++ {
        unsafe {
            Slot<K, V>& slot = this.slots[i];
            if slot.hash >= HASH_FIRST_VALID {
                this.deleteEntry(slot.entry);
            }
            slot.hash = HASH_EMPTY;
        }
    }
    this.size = 0l;
    this.tombstones = 0l;
}

/**
 * Hash the given key and move the result out of the reserved sentinel range, so that the hash cached
 * in a slot can double as the marker for an empty or vacated slot.
 *
 * The result is mixed before it is returned, because the slot index is masked out of its low bits
 * and some of the hash() overloads (e.g. the multiplicative one for int) have weak low bits.
 *
 * @param key The key to hash
 * @return Mixed, non-reserved hash of the key
 */
inline f<Hash> HashTable.hashKey(const K& key) {
    result = hash(key);
    result ^= result >> 33ul;
    result *= 0xff51afd7ed558ccdul;
    result ^= result >> 29ul;
    if result < HASH_FIRST_VALID { result += HASH_FIRST_VALID; }
}

/**
 * Find the slot holding the given key.
 *
 * @param key The key to search for
 * @param keyHash Mixed hash of the key, as returned by hashKey()
 * @return Index of the slot holding the key, or this.capacity if the key is not present
 */
f<unsigned long> HashTable.findSlot(const K& key, Hash keyHash) {
    if this.capacity == 0l { return 0l; }
    const unsigned long mask = this.capacity - 1l;
    unsigned long idx = keyHash & mask;
    for unsigned long probe = 0l; probe < this.capacity; probe++ {
        unsafe {
            const Slot<K, V>& slot = this.slots[idx];
            // An empty slot ends the probe chain, so the key cannot be stored behind it
            if slot.hash == HASH_EMPTY { return this.capacity; }
            // Compare the cached hash first and only touch the entry once it matches
            if slot.hash == keyHash && slot.entry.key == key { return idx; }
        }
        idx = (idx + 1l) & mask;
    }
    return this.capacity;
}

/**
 * Find the slot a new entry with the given hash has to be placed in. The first vacated slot on the
 * probe chain is reused, which keeps the chains from growing with every remove/insert cycle.
 *
 * @param keyHash Mixed hash of the key, as returned by hashKey()
 * @return Index of the free slot to occupy
 */
f<unsigned long> HashTable.findFreeSlot(Hash keyHash) {
    const unsigned long mask = this.capacity - 1l;
    unsigned long idx = keyHash & mask;
    for unsigned long probe = 0l; probe < this.capacity; probe++ {
        unsafe {
            if this.slots[idx].hash < HASH_FIRST_VALID { return idx; }
        }
        idx = (idx + 1l) & mask;
    }
    // Unreachable: the load factor keeps at least one slot of every table free
    panic(Error("Hash table has no free slot left"));
}

/**
 * Grow the table if inserting one more entry would push it beyond its maximum load factor.
 */
p HashTable.growIfRequired() {
    if this.capacity == 0l {
        this.rehash(MIN_CAPACITY);
        return;
    }
    // Tombstones keep occupying their slot for probing purposes, so they count towards the load
    const unsigned long load = this.size + this.tombstones + 1l;
    if load * MAX_LOAD_DENOMINATOR <= this.capacity * MAX_LOAD_NUMERATOR { return; }
    // Only double when the live entries justify it. A table that is merely littered with tombstones
    // is rebuilt at the same capacity, which drops them.
    const bool entriesJustifyGrowth = (this.size + 1l) * MAX_LOAD_DENOMINATOR > this.capacity * MAX_LOAD_NUMERATOR;
    this.rehash(entriesJustifyGrowth ? this.capacity * 2l : this.capacity);
}

/**
 * Rebuild the slot array at the given capacity, re-distributing the existing entries over it.
 * Only the slot array is replaced - the entries keep their addresses, which is what makes references
 * to them survive a rehash.
 *
 * @param newCapacity Number of slots of the new slot array, must be a power of two
 */
p HashTable.rehash(unsigned long newCapacity) {
    Slot<K, V>* oldSlots = this.slots;
    const unsigned long oldCapacity = this.capacity;

    this.slots = allocSlots<K, V>(newCapacity);
    this.capacity = newCapacity;
    this.tombstones = 0l;

    // Move the cached hashes and entry pointers over. The keys are known to be distinct here, so no
    // key comparison is needed and the first free slot on each probe chain is the right one.
    for unsigned long i = 0l; i < oldCapacity; i++ {
        unsafe {
            const Slot<K, V>& oldSlot = oldSlots[i];
            if oldSlot.hash >= HASH_FIRST_VALID {
                Slot<K, V>& newSlot = this.slots[this.findFreeSlot(oldSlot.hash)];
                newSlot.entry = oldSlot.entry;
                newSlot.hash = oldSlot.hash;
            }
        }
    }

    if oldCapacity > 0l {
        unsafe {
            heap byte* rawSlots = cast<heap byte*>(oldSlots);
            sDealloc(rawSlots);
        }
    }
}

/**
 * Copy every entry of the given hash table into this one, allocating own entries for them.
 *
 * @param original Hash table to copy the entries from
 */
p HashTable.copyEntriesFrom(const HashTable<K, V>& original) {
    for unsigned long i = 0l; i < original.capacity; i++ {
        unsafe {
            const Slot<K, V>& slot = original.slots[i];
            if slot.hash >= HASH_FIRST_VALID {
                this.upsert(slot.entry.key, slot.entry.value);
            }
        }
    }
}

/**
 * Allocate an entry for the given key-value pair.
 *
 * @param key The key to store
 * @param value The value to store
 * @return Pointer to the newly allocated entry
 */
f<Entry<K, V>*> HashTable.createEntry(const K& key, const V& value) {
    Entry<K, V>* entry;
    unsafe {
        Result<heap byte*> allocResult = sAlloc(sizeof<Entry<K, V>>());
        entry = cast<Entry<K, V>*>(sMove(allocResult.unwrap()));
        // Copy-construct into the raw allocation, so non-trivial keys and values get their own owned
        // resources instead of aliasing the caller's
        __placement_new<K>(&entry.key, key);
        __placement_new<V>(&entry.value, value);
    }
    return entry;
}

/**
 * Destruct the given entry and free its allocation.
 *
 * @param entry Entry to delete; set to nil afterwards
 */
p HashTable.deleteEntry(Entry<K, V>*& entry) {
    if entry == nil<Entry<K, V>*> { return; }
    unsafe {
        sDestruct(entry.key);
        sDestruct(entry.value);
        heap byte* rawEntry = cast<heap byte*>(entry);
        sDealloc(rawEntry);
    }
    entry = nil<Entry<K, V>*>;
}

/**
 * Allocate a slot array of the given size, with every slot marked empty.
 *
 * @param slotCount Number of slots to allocate
 * @return Pointer to the first slot
 */
f<Slot<K, V>*> allocSlots<K, V>(unsigned long slotCount) {
    Slot<K, V>* slots;
    unsafe {
        Result<heap byte*> allocResult = sAlloc(sizeof<Slot<K, V>>() * slotCount);
        slots = cast<Slot<K, V>*>(sMove(allocResult.unwrap()));
        // sAlloc hands out uninitialized memory, so the empty markers have to be written explicitly
        for unsigned long i = 0l; i < slotCount; i++ {
            slots[i].entry = nil<Entry<K, V>*>;
            slots[i].hash = HASH_EMPTY;
        }
    }
    return slots;
}

/**
 * Round the given value up to the next power of two, but never below MIN_CAPACITY. A power of two
 * capacity lets the slot index be masked out of the hash instead of taken modulo, which avoids an
 * integer division on every single access.
 *
 * @param value Value to round up
 * @return Smallest power of two that is >= value and >= MIN_CAPACITY
 */
f<unsigned long> toPowerOfTwo(unsigned long value) {
    result = MIN_CAPACITY;
    while result < value {
        result *= 2l;
    }
}

/**
 * Iterator to iterate over a hash table data structure
 */
public type HashTableIterator<K, V> struct : IIterator<Pair<const K&, V&>> {
    HashTable<K, V>& hashTable
    Pair<const K&, V&> currentPair
    unsigned long slotIdx = 0l
    unsigned long cursor = 0l
}

/**
 * Construct a hash table iterator over the given hash table
 *
 * @param hashTable Hash table to iterate over
 */
public p HashTableIterator.ctor<K, V>(HashTable<K, V>& hashTable) {
    this.hashTable = hashTable;
    // Establish the invariant: the slot index addresses an occupied slot or has run past the last one
    this.skipFreeSlots();
}

/**
 * Returns the current key-value pair of the hash table
 *
 * @return Current key/value pair
 */
public inline f<Pair<const K&, V&>&> HashTableIterator.get() {
    unsafe {
        Entry<K, V>* entry = this.hashTable.slots[this.slotIdx].entry;
        this.currentPair = Pair<const K&, V&>(entry.key, entry.value);
    }
    return this.currentPair;
}

/**
 * Returns the current index and the current item of the hash table
 *
 * @return Pair of current index and current key/value pair
 */
public inline f<Pair<unsigned long, Pair<const K&, V&>&>> HashTableIterator.getIdx() {
    return Pair<unsigned long, Pair<const K&, V&>&>(this.cursor, this.get());
}

/**
 * Check if the iterator is valid
 *
 * The iterator maintains the invariant that its slot index either addresses an occupied slot or has
 * run past the last one, so validity is a single comparison.
 *
 * @return true or false
 */
public inline f<bool> HashTableIterator.isValid() {
    return this.slotIdx < this.hashTable.capacity;
}

/**
 * Advance the slot index until it addresses an occupied slot or has run past the last one
 */
p HashTableIterator.skipFreeSlots() {
    while this.slotIdx < this.hashTable.capacity {
        unsafe {
            if this.hashTable.slots[this.slotIdx].hash >= HASH_FIRST_VALID { break; }
        }
        this.slotIdx++;
    }
}

/**
 * Moves the cursor to the next key/value pair
 */
public inline p HashTableIterator.next() {
    if !this.isValid() { panic(Error("Calling next() on invalid iterator")); }

    // Move to the next occupied slot
    this.slotIdx++;
    this.skipFreeSlots();

    // Increment cursor to reflect the current item position
    this.cursor++;
}

/**
 * Retrieve a forward iterator for the hash table
 */
public f<HashTableIterator<K, V>> HashTable.getIterator() {
    return HashTableIterator<K, V>(*this);
}
