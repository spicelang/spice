// External functions
ext f<byte*> memmove(byte*, byte*, unsigned long);

// Constants
const unsigned long INITIAL_ALLOC_COUNT = 5l;
const unsigned int RESIZE_FACTOR = 2;

// Add generic type definition
type T dyn;
type UIntOrULong unsigned int|unsigned long;

/**
 * A deque in Spice is a commonly used data structure that allows insertion and removal
 * of elements from both ends: front and back.
 *
 * Time complexity:
 * Insert at front: O(1)
 * Insert at back: O(1)
 * Delete from front: O(1)
 * Delete from back: O(1)
 * Search: O(n)
 *
 * Deques pre-allocate space using an initial size and a resize factor to not have to re-allocate
 * with every item pushed. This implementation uses a ring buffer, that wraps around when one of the
 * indices reach the start or end of the allocated heap space. A default-constructed deque stays in
 * an unallocated state (contents = nil, capacity = 0) until the first push.
 */
public type Deque<T> struct {
    heap T* contents = nil<heap T*>  // Pointer to the first data element; nil while unallocated
    unsigned long capacity = 0l      // Allocated number of items; 0 while unallocated
    unsigned long size = 0l          // Current number of items
    long idxFront = 0l               // Index for front access
    long idxBack = 0l                // Index for back access
}

/**
 * Construct a deque, pre-allocating space for the given number of items
 *
 * @param initAllocItems Number of items to pre-allocate space for
 */
public inline p Deque.ctor(unsigned long initAllocItems = 0l) {
    this.resize(initAllocItems);
}

/**
 * Construct a deque, pre-allocating space for the given number of items
 *
 * @param initAllocItems Number of items to pre-allocate space for
 */
public inline p Deque.ctor(unsigned int initAllocItems) {
    this.resize(cast<unsigned long>(initAllocItems));
}

/**
 * Construct a deque pre-filled with a number of copies of a default value
 *
 * @param initAllocItems Number of items to insert
 * @param defaultValue Value to fill the deque with
 */
public p Deque.ctor(unsigned long initAllocItems, const T& defaultValue) {
    // Allocate space for the initial number of elements
    this.ctor(initAllocItems);
    // Fill in the default values
    for unsigned long index = 0l; index < initAllocItems; index++ {
        unsafe {
            __placement_new<T>(&this.contents[index], defaultValue);
        }
    }
    this.size = initAllocItems;
    this.idxBack = this.capacity == 0l ? 0l : initAllocItems % this.capacity;
}

/**
 * Construct a deque as a deep copy of another deque
 *
 * @param original Deque to copy
 */
public p Deque.ctor(const Deque<T>& original) {
    this.resize(original.capacity);
    // Copy-construct elements in logical order, normalizing the layout so idxFront = 0. The slots are uninitialized, so
    // they must not be assigned to
    unsafe {
        for unsigned long i = 0l; i < original.size; i++ {
            const unsigned long srcIdx = (original.idxFront + i) % original.capacity;
            __placement_new<T>(&this.contents[i], original.contents[srcIdx]);
        }
    }
    this.size = original.size;
    this.idxFront = 0l;
    this.idxBack = this.capacity == 0l ? 0l : original.size % this.capacity;
}

/**
 * Copy-assign the contents of another deque into this one
 *
 * @param newValue Deque to copy from
 */
public p operator=<T>(Deque<T>& this, const Deque<T>& newValue) {
    // Self-assignment: leave the deque as is; normalizing in place would
    // overwrite source slots before the wrapped index reads them.
    if &this == &newValue { return; }
    // Clear the old, resize the new one
    this.clear();
    this.resize(newValue.capacity);
    // Copy-construct elements in logical order, normalizing the layout so idxFront = 0
    unsafe {
        for unsigned long i = 0ul; i < newValue.size; i++ {
            const unsigned long srcIdx = (newValue.idxFront + i) % newValue.capacity;
            __placement_new<T>(&this.contents[i], newValue.contents[srcIdx]);
        }
    }
    this.size = newValue.size;
    this.idxFront = 0l;
    this.idxBack = this.capacity == 0l ? 0l : newValue.size % this.capacity;
}

/**
 * Destructs the deque, destructing all owned elements and freeing the buffer
 */
public p Deque.dtor() {
    this.clear();
    unsafe {
        heap byte*& oldAddress = cast<heap byte*>(this.contents);
        sDealloc(oldAddress);
    }
    this.capacity = 0l;
}

/**
 * Removes all items from the deque. The allocated capacity is kept.
 */
public p Deque.clear() {
    // Destruct owned elements in logical order before dropping them
    for unsigned long i = 0l; i < this.size; i++ {
        unsafe {
            sDestruct(this.contents[(this.idxFront + i) % this.capacity]);
        }
    }
    this.size = 0l;
    this.idxFront = 0l;
    this.idxBack = 0l;
}

/**
 * Add an item at the back of the deque
 */
public p Deque.pushBack(const T& item) {
    // The item may be an element of this deque, so remember its index to find it again after a reallocation
    const unsigned long itemIdx = this.getElementIndex(item);
    // Check if we need to (re-)allocate memory. Treat an unallocated deque the same as a full one.
    if this.size == this.capacity {
        const unsigned long newCapacity = this.capacity == 0l ? INITIAL_ALLOC_COUNT : this.capacity * RESIZE_FACTOR;
        this.resize(newCapacity);
    }

    // Insert the element at the back
    unsafe {
        const T* source = itemIdx < this.size ? &this.contents[(this.idxFront + itemIdx) % this.capacity] : &item;
        __placement_new<T>(&this.contents[this.idxBack], *source);
    }
    this.idxBack++;
    this.idxBack %= this.capacity;

    // Increase size
    this.size++;
}

/**
 * Add an item at the front of the deque
 */
public p Deque.pushFront(const T& item) {
    // The item may be an element of this deque, so remember its index to find it again after a reallocation
    const unsigned long itemIdx = this.getElementIndex(item);
    // Check if we need to (re-)allocate memory. Treat an unallocated deque the same as a full one.
    if this.size == this.capacity {
        const unsigned long newCapacity = this.capacity == 0l ? INITIAL_ALLOC_COUNT : this.capacity * RESIZE_FACTOR;
        this.resize(newCapacity);
    }

    // Insert the element at the front. Look up the item before moving the front index, which shifts the logical indices
    unsafe {
        const T* source = itemIdx < this.size ? &this.contents[(this.idxFront + itemIdx) % this.capacity] : &item;
        this.idxFront = this.idxFront + this.capacity - 1;
        this.idxFront %= this.capacity;
        __placement_new<T>(&this.contents[this.idxFront], *source);
    }

    // Increase size
    this.size++;
}

/**
 * Retrieve the first item and remove it. The item is returned by value, because its slot in the deque is destructed.
 *
 * @return First item
 */
#[ignoreUnusedReturnValue]
public f<T> Deque.popFront() {
    if this.isEmpty() {
        panic(Error("Deque is empty"));
    }

    // Get item value
    unsafe {
        // Copy the item via a reference to its slot. Assigning the subscript expression directly would move it bitwise,
        // so destructing the slot afterwards would free resources, that the returned item still uses
        T& item = this.contents[this.idxFront];
        result = item;
        sDestruct(item);
    }

    // Adjust indices and size
    this.idxFront++;
    this.idxFront %= this.capacity;
    this.size--;
}

/**
 * Retrieve the last item and remove it. The item is returned by value, because its slot in the deque is destructed.
 *
 * @return Last item
 */
#[ignoreUnusedReturnValue]
public f<T> Deque.popBack() {
    if this.isEmpty() {
        panic(Error("Deque is empty"));
    }

    // Adjust indices and size
    this.idxBack = this.idxBack - 1 + this.capacity;
    this.idxBack %= this.capacity;

    // Get item value
    unsafe {
        // Copy the item via a reference to its slot, for the same reason as in popFront()
        T& item = this.contents[this.idxBack];
        result = item;
        sDestruct(item);
    }
    this.size--;
}

/**
 * Retrieve the first item without removing it from the deque
 *
 * @return First item
 */
public f<T&> Deque.front() {
    if this.isEmpty() {
        panic(Error("Access index out of bounds"));
    }
    unsafe {
        return this.contents[this.idxFront];
    }
}

/**
 * Retrieve the last item without removing it from the deque
 *
 * @return Last item
 */
public f<T&> Deque.back() {
    if this.isEmpty() {
        panic(Error("Access index out of bounds"));
    }
    unsafe {
        return this.contents[(this.idxBack - 1 + this.capacity) % this.capacity];
    }
}

/**
 * Retrieve the current size of the deque
 *
 * @return Current size of the deque
 */
public inline f<unsigned long> Deque.getSize() {
    return this.size;
}

/**
 * Retrieve the current capacity of the deque
 *
 * @return Current capacity of the deque
 */
public inline f<unsigned long> Deque.getCapacity() {
    return this.capacity;
}

/**
 * Checks if the deque contains any items at the moment
 *
 * @return Empty or not empty
 */
public inline f<bool> Deque.isEmpty() {
    return this.size == 0;
}

/**
 * Checks if the deque exhausts its capacity and needs to resize at the next call of push.
 * A deque with no allocated capacity is not considered full — the next push will simply
 * bootstrap the buffer.
 *
 * @return Full or not full
 */
public inline f<bool> Deque.isFull() {
    return this.capacity != 0l && this.size == this.capacity;
}

/**
 * Reserves `itemCount` items
 */
public p Deque.reserve<UIntOrULong>(UIntOrULong itemCount) {
    if itemCount > this.capacity {
        this.resize(cast<unsigned long>(itemCount));
    }
}

/**
 * Frees allocated memory that is not used by the deque
 */
public p Deque.pack() {
    // Pack the array if necessary
    if !this.isFull() {
        this.resize(this.size);
    }
}

/**
 * Check if two deques are equal, i.e. they have the same size and equal contents in order
 *
 * @return Equal or not equal
 */
public f<bool> operator==<T>(const Deque<T>& lhs, const Deque<T>& rhs) {
    // Compare the sizes
    if lhs.size != rhs.size { return false; }
    // Compare the contents
    for unsigned long index = 0l; index < lhs.size; index++ {
        const unsigned long lhsIdx = (lhs.idxFront + index) % lhs.capacity;
        const unsigned long rhsIdx = (rhs.idxFront + index) % rhs.capacity;
        unsafe {
            if lhs.contents[lhsIdx] != rhs.contents[rhsIdx] {
                return false;
            }
        }
    }
    return true;
}

/**
 * Check if two deques are not equal
 *
 * @return Not equal or equal
 */
public inline f<bool> operator!=<T>(const Deque<T>& lhs, const Deque<T>& rhs) {
    return !(lhs == rhs);
}

/**
 * Retrieve the logical index of an item, that is an element of this deque, counted from the front. Inserting methods use it
 * to find the item again, after they reallocated the buffer
 *
 * @param item Item to look up
 * @return Logical index of the item or the size of the deque, if the item is not an element of this deque
 */
f<unsigned long> Deque.getElementIndex(const T& item) {
    unsafe {
        const unsigned long itemAddress = cast<unsigned long>(&item);
        const unsigned long contentsAddress = cast<unsigned long>(this.contents);
        const unsigned long itemSize = sizeof<T>();
        if itemAddress < contentsAddress || itemAddress >= contentsAddress + this.capacity * itemSize {
            return this.size;
        }
        // The elements may wrap around the end of the buffer, so count from the front slot
        const unsigned long slotIdx = (itemAddress - contentsAddress) / itemSize;
        const unsigned long logicalIdx = (slotIdx + this.capacity - this.idxFront) % this.capacity;
        return logicalIdx < this.size ? logicalIdx : this.size;
    }
}

/**
 * Re-allocates heap space for the deque contents
 */
p Deque.resize(unsigned long itemCount) {
    if itemCount == this.capacity {
        return;
    }

    // Free the buffer if we are shrinking down to zero capacity
    if itemCount == 0l {
        unsafe {
            heap byte*& oldAddress = cast<heap byte*>(this.contents);
            sDealloc(oldAddress);
            this.contents = nil<heap T*>;
        }
        this.capacity = 0l;
        this.size = 0l;
        this.idxFront = 0l;
        this.idxBack = 0l;
        return;
    }
    // Allocate the new memory
    const unsigned long itemSize = sizeof<T>();
    unsafe {
        // Allocate a new chunk of memory with the requested size
        unsigned long newSize = itemSize * itemCount;
        Result<heap byte*> allocResult = sAlloc(newSize);
        heap T* newContents = cast<heap T*>(allocResult.unwrapAndMove());
        // Relocate the elements bitwise in logical order. They are moved, not copied, so they are neither copy-constructed
        // in the new slots nor destructed in the old ones. The elements may wrap around the end of the old buffer, so they
        // are moved in up to two chunks
        if this.size > 0l {
            const unsigned long firstChunkSize = this.size < this.capacity - this.idxFront ? this.size : this.capacity - this.idxFront;
            memmove(cast<byte*>(&newContents[0]), cast<byte*>(&this.contents[this.idxFront]), firstChunkSize * itemSize);
            if firstChunkSize < this.size {
                const unsigned long secondChunkSize = this.size - firstChunkSize;
                memmove(cast<byte*>(&newContents[firstChunkSize]), cast<byte*>(&this.contents[0]), secondChunkSize * itemSize);
            }
        }
        // Free the old buffer without destructing the relocated elements
        heap byte*& oldAddress = cast<heap byte*>(this.contents);
        sDealloc(oldAddress);
        this.contents = sMove(newContents);
    }
    // Set new capacity and normalize indices
    this.capacity = itemCount;
    this.idxFront = 0l;
    this.idxBack = this.size % itemCount;
}
