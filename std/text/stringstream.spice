/**
 * Helper data structure to construct strings.
 * It is useful to avoid copying large strings around.
 */
public type StringStream struct {
    String buffer
}

/**
 * Construct an empty string stream
 */
public p StringStream.ctor() {
    // Initialize buffer empty
    this.buffer = String();
}

/**
 * Construct a string stream initialized with a raw string
 *
 * @param input Initial buffer content
 */
public p StringStream.ctor(string input) {
    // Initialize buffer with an initial string
    this.buffer = String(input);
}

/**
 * Construct a string stream initialized with a String
 *
 * @param input Initial buffer content
 */
public p StringStream.ctor(const String& input) {
    // Initialize buffer with an initial string
    this.buffer = input;
}

/**
 * Clear the buffer
 */
public inline p StringStream.clear() {
    this.buffer.clear();
}

/**
 * Check if the underlying buffer is empty
 *
 * @return Empty or not
 */
public inline f<bool> StringStream.isEmpty() {
    return this.buffer.isEmpty();
}

/**
 * Get the value of the buffer
 *
 * @return Resulting String object
 */
public f<const String&> StringStream.str() {
    return this.buffer;
}

/**
 * Append a raw string to the buffer
 */
#[ignoreUnusedReturnValue]
public inline f<StringStream&> operator<<(StringStream& ss, string input) {
    ss.buffer += input;
    return ss;
}

/**
 * Append a String to the buffer
 */
#[ignoreUnusedReturnValue]
public inline f<StringStream&> operator<<(StringStream& ss, const String& input) {
    ss.buffer += input;
    return ss;
}

/**
 * Append a single char to the buffer
 */
#[ignoreUnusedReturnValue]
public inline f<StringStream&> operator<<(StringStream& ss, char input) {
    ss.buffer += input;
    return ss;
}

/**
 * Return end line character
 *
 * @return End line character
 */
public inline f<char> endl() {
    return '\n';
}
