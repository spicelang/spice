#![core.compiler.requiresOs]

// Link WinSock, the IP helper library (network adapters) and the CNG library (random numbers)
#![core.windows.linker.flag = "-lws2_32 -liphlpapi -lbcrypt"]

// Address-family-independent socket helpers for Windows, that "std/net/dns" and "std/net/socket" build on.
// The socket address structs are laid out by hand here, so that one code path serves IPv4 and IPv6.
// Besides, the helpers hide where the resolver of "std/net/dns" finds its configuration: Windows has no
// resolv.conf, so the name servers and DNS suffixes of the network adapters are turned into one.

// Imports
import "std/data/vector";
import "std/net/impl/socket-address";
import "std/net/ip-address";
import "std/os/env";

// Constants
const int NATIVE_AF_UNSPEC = 0;          // Any address family
const int NATIVE_AF_INET = 2;            // IPv4
const int NATIVE_AF_INET6 = 23;          // IPv6
const int NATIVE_SOCK_STREAM = 1;        // Stream socket (TCP)
const int NATIVE_SOL_SOCKET = 65535;     // Option level for socket-level options (0xFFFF)
const int NATIVE_SO_REUSEADDR = 4;       // Allow binding to a local address that is still in TIME_WAIT
const int NATIVE_SO_RCVTIMEO = 4102;     // Timeout for receive operations
const int NATIVE_SO_SNDTIMEO = 4101;     // Timeout for send operations
const unsigned short NATIVE_WSA_VERSION = 514s; // Winsock 2.2
const unsigned int NATIVE_BCRYPT_USE_SYSTEM_PREFERRED_RNG = 2u;
const unsigned int NATIVE_ERROR_SUCCESS = 0u;
const unsigned int NATIVE_ERROR_BUFFER_OVERFLOW = 111u;
// GAA_FLAG_SKIP_UNICAST | GAA_FLAG_SKIP_ANYCAST | GAA_FLAG_SKIP_MULTICAST | GAA_FLAG_SKIP_FRIENDLY_NAME
const unsigned int NATIVE_ADAPTER_FLAGS = 0x27u;
const int NATIVE_IF_OPER_STATUS_UP = 1;
// Offsets into IP_ADAPTER_ADDRESSES (64 bit layout)
const long NATIVE_ADAPTER_NEXT_OFFSET = 8l;
const long NATIVE_ADAPTER_DNS_SERVERS_OFFSET = 48l;
const long NATIVE_ADAPTER_DNS_SUFFIX_OFFSET = 56l;
const long NATIVE_ADAPTER_OPER_STATUS_OFFSET = 104l;
// Offsets into IP_ADAPTER_DNS_SERVER_ADDRESS (64 bit layout)
const long NATIVE_DNS_SERVER_NEXT_OFFSET = 8l;
const long NATIVE_DNS_SERVER_SOCKADDR_OFFSET = 16l;
// Offset of the scope id in SOCKADDR_IN6
const long NATIVE_SOCKADDR_IN6_SCOPE_ID_OFFSET = 24l;
// Largest timeout, that the timeout socket options can take
const unsigned long NATIVE_MAX_TIMEOUT_MS = 2147483647ul;
// Largest number of random bytes, that one BCryptGenRandom call is asked for
const unsigned long NATIVE_MAX_RANDOM_CHUNK_SIZE = 65536ul;

// Global variables
bool NATIVE_WINSOCK_STARTED = false; // Winsock was started for this process
// SRWLOCK, that guards the startup of Winsock. An SRWLOCK is a single pointer, that starts out as zero, which a global
// of primitive type can hold.
unsigned long NATIVE_WINSOCK_LOCK = 0ul;

/**
 * Mirrors `WSADATA` from the Winsock headers (64 bit layout)
 */
type NativeWsaData struct {
    unsigned short wVersion
    unsigned short wHighVersion
    unsigned short iMaxSockets
    unsigned short iMaxUdpDg
    char* lpVendorInfo
    char[257] szDescription
    char[129] szSystemStatus
}

// External functions
ext f<int> WSAStartup(short /*versionRequested*/, NativeWsaData* /*wsaData*/);
ext p AcquireSRWLockExclusive(unsigned long* /*lock*/);
ext p ReleaseSRWLockExclusive(unsigned long* /*lock*/);
ext f<int> socket(int /*domain*/, int /*type*/, int /*protocol*/);
ext f<int> connect(int /*sockfd*/, byte* /*address*/, int /*address_len*/);
ext f<int> bind(int /*sockfd*/, byte* /*address*/, int /*address_len*/);
ext f<int> listen(int /*sockfd*/, int /*backlog*/);
ext f<int> accept(int /*sockfd*/, byte* /*address*/, int* /*address_len*/);
ext f<int> setsockopt(int /*sockfd*/, int /*level*/, int /*optname*/, byte* /*optval*/, int /*optlen*/);
ext f<int> recv(int /*sockfd*/, byte* /*buf*/, int /*length*/, int /*flags*/);
ext f<int> send(int /*sockfd*/, byte* /*buf*/, int /*length*/, int /*flags*/);
ext f<int> closesocket(int /*sockfd*/);
ext f<int> BCryptGenRandom(byte* /*hAlgorithm*/, byte* /*pbBuffer*/, unsigned int /*cbBuffer*/, unsigned int /*dwFlags*/);
ext f<unsigned long> GetTickCount64();
ext f<unsigned int> GetAdaptersAddresses(unsigned int /*family*/, unsigned int /*flags*/, byte* /*reserved*/, byte* /*adapterAddresses*/, unsigned int* /*sizePointer*/);

/**
 * Returns the address family constant (AF_INET or AF_INET6) of the given address
 *
 * @param address IP address
 * @return Address family
 */
public f<int> getNativeAddressFamily(const IpAddress& address) {
    return address.isIpv6() ? NATIVE_AF_INET6 : NATIVE_AF_INET;
}

/**
 * Opens a socket of the family of the given address and connects it to the given address and port.
 * For a datagram socket, connecting only fixes the peer, so that plain receives and sends can be used
 * and datagrams from any other sender are dropped.
 *
 * @param address Address to connect to
 * @param port Port to connect to
 * @param socketType SOCK_STREAM or SOCK_DGRAM
 * @param timeoutMs Timeout for the single reads and writes on the socket in milliseconds, 0 for none
 * @return Handle of the connected socket
 */
public f<Result<int>> openNativeSocket(const IpAddress& address, unsigned short port, int socketType, unsigned long timeoutMs) {
    if !startNativeWinsock() { return err<int>(Error("Error starting Winsock")); }

    const int sockFd = socket(getNativeAddressFamily(address), socketType, 0);
    if sockFd == -1 { return err<int>(Error("Error opening socket")); }
    if timeoutMs != 0ul && !setNativeSocketTimeout(sockFd, timeoutMs) {
        closesocket(sockFd);
        return err<int>(Error("Error setting socket timeout"));
    }

    NativeSockAddr sockAddr = createNativeSockAddr(address, port, getNativeAddressFamily(address), SockAddrLayout::FAMILY_16_BIT);
    int connectResult = 0;
    unsafe {
        unsigned byte* sockAddrPtr = sockAddr.bytes;
        connectResult = connect(sockFd, sockAddrPtr, cast<int>(sockAddr.size));
    }
    if connectResult != 0 {
        closesocket(sockFd);
        return err<int>(Error("Error connecting socket"));
    }
    return ok(sockFd);
}

/**
 * Opens a stream socket of the family of the given address, binds it to the given address and port and
 * starts listening for incoming connections on it.
 *
 * @param address Local address to bind to, e.g. 0.0.0.0 for all IPv4 addresses of the host
 * @param port Port to bind to
 * @param maxWaitingConnections Maximum length of the queue of pending connections
 * @return Handle of the listening socket
 */
public f<Result<int>> openNativeServerSocket(const IpAddress& address, unsigned short port, int maxWaitingConnections) {
    if !startNativeWinsock() { return err<int>(Error("Error starting Winsock")); }

    const int sockFd = socket(getNativeAddressFamily(address), NATIVE_SOCK_STREAM, 0);
    if sockFd == -1 { return err<int>(Error("Error creating socket")); }

    // Allow rebinding the port right away instead of waiting out the TIME_WAIT of the previous socket
    int reuseAddr = 1;
    unsafe {
        setsockopt(sockFd, NATIVE_SOL_SOCKET, NATIVE_SO_REUSEADDR, cast<byte*>(&reuseAddr), cast<int>(sizeof<int>()));
    }

    NativeSockAddr sockAddr = createNativeSockAddr(address, port, getNativeAddressFamily(address), SockAddrLayout::FAMILY_16_BIT);
    int bindResult = 0;
    unsafe {
        unsigned byte* sockAddrPtr = sockAddr.bytes;
        bindResult = bind(sockFd, sockAddrPtr, cast<int>(sockAddr.size));
    }
    if bindResult != 0 {
        closesocket(sockFd);
        return err<int>(Error("Error binding to address"));
    }
    if listen(sockFd, maxWaitingConnections) != 0 {
        closesocket(sockFd);
        return err<int>(Error("Error listening on address"));
    }
    return ok(sockFd);
}

/**
 * Accepts an incoming connection on the given listening socket. Blocks until a client connects.
 *
 * @param sockFd Handle of the listening socket
 * @return Handle of the connection, -1 on error
 */
public f<int> acceptNativeConnection(int sockFd) {
    return accept(sockFd, nil<byte*>, nil<int*>);
}

/**
 * Starts Winsock for this process, unless it was started already. Winsock is never cleaned up, since
 * sockets can live until the end of the process. Threads, that open their first socket at the same time,
 * start it only once. A failed startup is tried again on the next call.
 *
 * @return Winsock is ready or not
 */
f<bool> startNativeWinsock() {
    AcquireSRWLockExclusive(&NATIVE_WINSOCK_LOCK);
    if !NATIVE_WINSOCK_STARTED {
        NativeWsaData wsaData = NativeWsaData{};
        NATIVE_WINSOCK_STARTED = WSAStartup(cast<short>(NATIVE_WSA_VERSION), &wsaData) == 0;
    }
    const bool started = NATIVE_WINSOCK_STARTED;
    ReleaseSRWLockExclusive(&NATIVE_WINSOCK_LOCK);
    return started;
}

/**
 * Limits how long a single read or write on the given socket may block.
 * Note: Winsock takes the timeout as a plain millisecond count instead of a timeval. Longer timeouts,
 * than it can take, are cut down to the longest one, that it can take.
 *
 * @param sockFd Socket handle
 * @param timeoutMs Timeout in milliseconds, 0 to block indefinitely
 * @return Setting the timeout was successful or not
 */
public f<bool> setNativeSocketTimeout(int sockFd, unsigned long timeoutMs) {
    int timeout = cast<int>(timeoutMs > NATIVE_MAX_TIMEOUT_MS ? NATIVE_MAX_TIMEOUT_MS : timeoutMs);
    int receiveResult = 0;
    int sendResult = 0;
    unsafe {
        const int optLen = cast<int>(sizeof<int>());
        receiveResult = setsockopt(sockFd, NATIVE_SOL_SOCKET, NATIVE_SO_RCVTIMEO, cast<byte*>(&timeout), optLen);
        sendResult = setsockopt(sockFd, NATIVE_SOL_SOCKET, NATIVE_SO_SNDTIMEO, cast<byte*>(&timeout), optLen);
    }
    return receiveResult == 0 && sendResult == 0;
}

/**
 * Fills the given buffer with random bytes from the system, that are fit for values an attacker must
 * not be able to predict (like the IDs of DNS queries)
 *
 * @param buffer Buffer to fill
 * @param size Number of bytes to fill
 * @return Filling the buffer was successful or not
 */
public f<bool> fillNativeRandomBytes(byte* buffer, unsigned long size) {
    // BCryptGenRandom takes the size as 32 bit integer, so larger buffers are filled in chunks
    unsigned long filled = 0ul;
    while filled < size {
        const unsigned long chunkSize = size - filled > NATIVE_MAX_RANDOM_CHUNK_SIZE ? NATIVE_MAX_RANDOM_CHUNK_SIZE : size - filled;
        int status = 0;
        unsafe {
            status = BCryptGenRandom(nil<byte*>, buffer + filled, cast<unsigned int>(cast<int>(chunkSize)), NATIVE_BCRYPT_USE_SYSTEM_PREFERRED_RNG);
        }
        if status != 0 { return false; }
        filled += chunkSize;
    }
    return true;
}

/**
 * Reads from the given socket. Blocks until data arrives, the timeout of the socket expires or the
 * connection breaks.
 *
 * @param sockFd Socket handle
 * @param buffer Buffer to read into
 * @param size Size of the buffer
 * @return Number of bytes read, 0 or less on timeout, error or end of the connection
 */
public f<long> readNativeSocket(int sockFd, byte* buffer, unsigned long size) {
    return cast<long>(recv(sockFd, buffer, cast<int>(size), 0));
}

/**
 * Writes to the given socket. A single call may write only a part of the buffer.
 *
 * @param sockFd Socket handle
 * @param buffer Buffer to write
 * @param size Number of bytes to write
 * @return Number of bytes written, 0 or less on timeout or error
 */
public f<long> writeNativeSocket(int sockFd, byte* buffer, unsigned long size) {
    return cast<long>(send(sockFd, buffer, cast<int>(size), 0));
}

/**
 * Closes the given socket
 *
 * @param sockFd Socket handle
 * @return Closing the socket was successful or not
 */
#[ignoreUnusedReturnValue]
public f<bool> closeNativeSocket(int sockFd) {
    return closesocket(sockFd) == 0;
}

/**
 * Returns the time of a monotonic clock, that is not affected by changes of the system time. Only the
 * difference between two values has a meaning.
 *
 * @return Monotonic time in milliseconds
 */
public f<long> getNativeMonotonicMillis() {
    return cast<long>(GetTickCount64());
}

/**
 * Returns the path of the hosts file of the system
 *
 * @return Path of the hosts file, usually C:\Windows\System32\drivers\etc\hosts
 */
public f<String> getNativeHostsFilePath() {
    const Result<string> systemRoot = getEnv("SystemRoot");
    String path = systemRoot.isOk() ? String(systemRoot.unwrap()) : String("C:\\Windows");
    path += "\\System32\\drivers\\etc\\hosts";
    return path;
}

/**
 * Collects the name servers and DNS suffixes of all network adapters, that are up, and writes them
 * down in the format of resolv.conf(5), so that "std/net/dns" can treat them like on any other
 * system. The site-local name servers fec0:0:0:ffff::1 to ::3, that Windows assigns to IPv6 adapters
 * without a configured name server, are left out, since they answer nowhere these days. IPv6 name
 * servers with a scope (like link-local ones) are left out as well, since resolv.conf has no way to
 * express which adapter they can be reached over.
 *
 * @return Resolver configuration in the format of resolv.conf
 */
public f<Result<String>> readNativeResolverConfig() {
    // The required buffer size can grow between two calls, if an adapter comes up in between
    unsigned int bufferSize = 16384u;
    Vector<unsigned byte> buffer = Vector<unsigned byte>();
    unsigned int status = NATIVE_ERROR_BUFFER_OVERFLOW;
    for int attempt = 0; attempt < 3 && status == NATIVE_ERROR_BUFFER_OVERFLOW; attempt++ {
        buffer = Vector<unsigned byte>(cast<unsigned long>(bufferSize), cast<unsigned byte>(0));
        status = GetAdaptersAddresses(cast<unsigned int>(NATIVE_AF_UNSPEC), NATIVE_ADAPTER_FLAGS, nil<byte*>, buffer.getDataPtr(), &bufferSize);
    }
    if status != NATIVE_ERROR_SUCCESS { return err<String>(Error("Could not query the network adapters")); }

    Vector<String> nameServers = Vector<String>();
    Vector<String> searchDomains = Vector<String>();
    unsigned byte* adapter = buffer.getDataPtr();
    while adapter != nil<unsigned byte*> {
        if readIntAt(adapter, NATIVE_ADAPTER_OPER_STATUS_OFFSET) == NATIVE_IF_OPER_STATUS_UP {
            unsigned byte* dnsServer = readPointerAt(adapter, NATIVE_ADAPTER_DNS_SERVERS_OFFSET);
            while dnsServer != nil<unsigned byte*> {
                const unsigned byte* sockAddr = readPointerAt(dnsServer, NATIVE_DNS_SERVER_SOCKADDR_OFFSET);
                const Result<IpAddress> addressResult = readNativeSockAddr(sockAddr, NATIVE_AF_INET, NATIVE_AF_INET6, SockAddrLayout::FAMILY_16_BIT);
                if addressResult.isOk() {
                    const String address = addressResult.unwrap().toString();
                    const bool isDeprecatedSiteLocal = address == "fec0:0:0:ffff::1" || address == "fec0:0:0:ffff::2" || address == "fec0:0:0:ffff::3";
                    const bool isScoped = addressResult.unwrap().isIpv6() && readIntAt(sockAddr, NATIVE_SOCKADDR_IN6_SCOPE_ID_OFFSET) != 0;
                    if !isDeprecatedSiteLocal && !isScoped { addUnique(nameServers, address); }
                }
                dnsServer = readPointerAt(dnsServer, NATIVE_DNS_SERVER_NEXT_OFFSET);
            }
            const String dnsSuffix = readWideString(readPointerAt(adapter, NATIVE_ADAPTER_DNS_SUFFIX_OFFSET));
            if !dnsSuffix.isEmpty() { addUnique(searchDomains, dnsSuffix); }
        }
        adapter = readPointerAt(adapter, NATIVE_ADAPTER_NEXT_OFFSET);
    }

    String config = String();
    foreach const String& nameServer : nameServers {
        config += "nameserver ";
        config += nameServer;
        config += '\n';
    }
    if !searchDomains.isEmpty() {
        config += "search";
        foreach const String& searchDomain : searchDomains {
            config += ' ';
            config += searchDomain;
        }
        config += '\n';
    }
    return ok(config);
}

/**
 * Reads a nil-terminated UTF-16 string, that only consists of ASCII chars (like a DNS suffix)
 *
 * @param wideString Pointer to the first char, may be nil
 * @return String, empty if there is none or it contains chars outside of ASCII
 */
f<String> readWideString(const unsigned byte* wideString) {
    String output = String();
    if wideString == nil<unsigned byte*> { return output; }
    unsafe {
        for long i = 0l; i < 512l; i += 2l {
            const int c = cast<int>(wideString[i]) | (cast<int>(wideString[i + 1l]) << 8);
            if c == 0 { return output; }
            if c >= 128 { return String(); }
            output += cast<char>(c);
        }
    }
    return String();
}

/**
 * Reads a pointer from the given offset of a struct
 *
 * @param base Pointer to the struct
 * @param offset Offset of the pointer field
 * @return Value of the pointer field
 */
f<unsigned byte*> readPointerAt(const unsigned byte* base, long offset) {
    unsafe {
        unsigned byte** field = cast<unsigned byte**>(base + offset);
        return *field;
    }
}

/**
 * Reads a 32 bit integer from the given offset of a struct
 *
 * @param base Pointer to the struct
 * @param offset Offset of the integer field
 * @return Value of the integer field
 */
f<int> readIntAt(const unsigned byte* base, long offset) {
    unsafe {
        int* field = cast<int*>(base + offset);
        return *field;
    }
}

/**
 * Appends a string to a list, if the list does not contain it yet
 *
 * @param list List to append to
 * @param value String to append
 */
p addUnique(Vector<String>& list, const String& value) {
    foreach const String& existing : list {
        if existing == value { return; }
    }
    list.pushBack(value);
}
