#![core.compiler.requiresOs]

// Address-family-independent socket helpers for Linux, that "std/net/dns" and "std/net/socket" build on.
// The socket address structs are laid out by hand here, so that one code path serves IPv4 and IPv6.
// Besides, the helpers hide where the resolver of "std/net/dns" finds its configuration.

// Imports
import "std/io/file";
import "std/net/impl/socket-address";
import "std/net/ip-address";

// Constants
const int NATIVE_AF_INET = 2;            // IPv4
const int NATIVE_AF_INET6 = 10;          // IPv6
const int NATIVE_SOCK_STREAM = 1;        // Stream socket (TCP)
const int NATIVE_SOL_SOCKET = 1;         // Option level for socket-level options
const int NATIVE_SO_REUSEADDR = 2;       // Allow binding to a local address that is still in TIME_WAIT
const int NATIVE_SO_RCVTIMEO = 20;       // Timeout for receive operations
const int NATIVE_SO_SNDTIMEO = 21;       // Timeout for send operations
const int NATIVE_MSG_NOSIGNAL = 16384;   // Do not raise SIGPIPE when writing to a broken connection (0x4000)
const int NATIVE_CLOCK_MONOTONIC = 1;    // Clock, that is not affected by changes of the system time
const string NATIVE_RESOLV_CONF_PATH = "/etc/resolv.conf";
const string NATIVE_HOSTS_FILE_PATH = "/etc/hosts";

/**
 * Time span with microsecond resolution, as taken by the timeout socket options. Mirrors
 * `struct timeval` from the C headers.
 */
type NativeTimeVal struct {
    long tvSec  // Whole seconds
    long tvUsec // Microseconds
}

/**
 * Point in time with nanosecond resolution, as filled in by clock_gettime. Mirrors `struct timespec`
 * from the C headers.
 */
type NativeTimeSpec struct {
    long tvSec  // Whole seconds
    long tvNsec // Nanoseconds
}

// External functions
ext f<int> socket(int /*domain*/, int /*type*/, int /*protocol*/);
ext f<int> connect(int /*sockfd*/, byte* /*address*/, unsigned int /*address_len*/);
ext f<int> bind(int /*sockfd*/, byte* /*address*/, unsigned int /*address_len*/);
ext f<int> listen(int /*sockfd*/, int /*backlog*/);
ext f<int> accept(int /*sockfd*/, byte* /*address*/, unsigned int* /*address_len*/);
ext f<int> setsockopt(int /*sockfd*/, int /*level*/, int /*optname*/, byte* /*optval*/, unsigned int /*optlen*/);
ext f<long> read(int /*fd*/, byte* /*buf*/, unsigned long /*length*/);
ext f<long> send(int /*sockfd*/, byte* /*buf*/, unsigned long /*length*/, int /*flags*/);
ext f<int> clock_gettime(int /*clockId*/, NativeTimeSpec* /*time*/);
ext f<int> close(int /*fd*/);
ext f<long> getrandom(byte* /*buf*/, unsigned long /*buflen*/, unsigned int /*flags*/);

/**
 * Returns the address family constant (AF_INET or AF_INET6) of the given address
 *
 * @param address IP address
 * @return Address family
 */
public f<int> getNativeAddressFamily(const IpAddress& address) {
    return address.isIpv6() ? NATIVE_AF_INET6 : NATIVE_AF_INET;
}

/**
 * Opens a socket of the family of the given address and connects it to the given address and port.
 * For a datagram socket, connecting only fixes the peer, so that plain reads and writes can be used
 * and the kernel drops datagrams from any other sender.
 *
 * @param address Address to connect to
 * @param port Port to connect to
 * @param socketType SOCK_STREAM or SOCK_DGRAM
 * @param timeoutMs Timeout for the single reads and writes on the socket in milliseconds, 0 for none
 * @return File descriptor of the connected socket
 */
public f<Result<int>> openNativeSocket(const IpAddress& address, unsigned short port, int socketType, unsigned long timeoutMs) {
    const int sockFd = socket(getNativeAddressFamily(address), socketType, 0);
    if sockFd == -1 { return err<int>(Error("Error opening socket")); }
    if timeoutMs != 0ul && !setNativeSocketTimeout(sockFd, timeoutMs) {
        close(sockFd);
        return err<int>(Error("Error setting socket timeout"));
    }

    NativeSockAddr sockAddr = createNativeSockAddr(address, port, getNativeAddressFamily(address), SockAddrLayout::FAMILY_16_BIT);
    int connectResult = 0;
    unsafe {
        unsigned byte* sockAddrPtr = sockAddr.bytes;
        connectResult = connect(sockFd, sockAddrPtr, sockAddr.size);
    }
    if connectResult < 0 {
        close(sockFd);
        return err<int>(Error("Error connecting socket"));
    }
    return ok(sockFd);
}

/**
 * Opens a stream socket of the family of the given address, binds it to the given address and port and
 * starts listening for incoming connections on it.
 *
 * @param address Local address to bind to, e.g. 0.0.0.0 for all IPv4 addresses of the host
 * @param port Port to bind to
 * @param maxWaitingConnections Maximum length of the queue of pending connections
 * @return File descriptor of the listening socket
 */
public f<Result<int>> openNativeServerSocket(const IpAddress& address, unsigned short port, int maxWaitingConnections) {
    const int sockFd = socket(getNativeAddressFamily(address), NATIVE_SOCK_STREAM, 0);
    if sockFd == -1 { return err<int>(Error("Error creating socket")); }

    // Allow rebinding the port right away instead of waiting out the TIME_WAIT of the previous socket
    int reuseAddr = 1;
    unsafe {
        setsockopt(sockFd, NATIVE_SOL_SOCKET, NATIVE_SO_REUSEADDR, cast<byte*>(&reuseAddr), cast<unsigned int>(cast<int>(sizeof<int>())));
    }

    NativeSockAddr sockAddr = createNativeSockAddr(address, port, getNativeAddressFamily(address), SockAddrLayout::FAMILY_16_BIT);
    int bindResult = 0;
    unsafe {
        unsigned byte* sockAddrPtr = sockAddr.bytes;
        bindResult = bind(sockFd, sockAddrPtr, sockAddr.size);
    }
    if bindResult < 0 {
        close(sockFd);
        return err<int>(Error("Error binding to address"));
    }
    if listen(sockFd, maxWaitingConnections) < 0 {
        close(sockFd);
        return err<int>(Error("Error listening on address"));
    }
    return ok(sockFd);
}

/**
 * Accepts an incoming connection on the given listening socket. Blocks until a client connects.
 *
 * @param sockFd File descriptor of the listening socket
 * @return File descriptor of the connection, a negative value on error
 */
public f<int> acceptNativeConnection(int sockFd) {
    return accept(sockFd, nil<byte*>, nil<unsigned int*>);
}

/**
 * Limits how long a single read or write on the given socket may block
 *
 * @param sockFd Socket file descriptor
 * @param timeoutMs Timeout in milliseconds, 0 to block indefinitely
 * @return Setting the timeout was successful or not
 */
public f<bool> setNativeSocketTimeout(int sockFd, unsigned long timeoutMs) {
    NativeTimeVal timeout = NativeTimeVal { cast<long>(timeoutMs / 1000ul), cast<long>((timeoutMs % 1000ul) * 1000ul) };
    int receiveResult = 0;
    int sendResult = 0;
    unsafe {
        const unsigned int optLen = cast<unsigned int>(cast<int>(sizeof<NativeTimeVal>()));
        receiveResult = setsockopt(sockFd, NATIVE_SOL_SOCKET, NATIVE_SO_RCVTIMEO, cast<byte*>(&timeout), optLen);
        sendResult = setsockopt(sockFd, NATIVE_SOL_SOCKET, NATIVE_SO_SNDTIMEO, cast<byte*>(&timeout), optLen);
    }
    return receiveResult == 0 && sendResult == 0;
}

/**
 * Fills the given buffer with random bytes from the kernel, that are fit for values an attacker must
 * not be able to predict (like the IDs of DNS queries)
 *
 * @param buffer Buffer to fill
 * @param size Number of bytes to fill
 * @return Filling the buffer was successful or not
 */
public f<bool> fillNativeRandomBytes(byte* buffer, unsigned long size) {
    unsigned long filled = 0ul;
    while filled < size {
        long result = 0l;
        unsafe {
            result = getrandom(buffer + filled, size - filled, 0u);
        }
        if result <= 0l { return false; }
        filled += cast<unsigned long>(result);
    }
    return true;
}

/**
 * Reads from the given socket. Blocks until data arrives, the timeout of the socket expires or the
 * connection breaks.
 *
 * @param sockFd Socket file descriptor
 * @param buffer Buffer to read into
 * @param size Size of the buffer
 * @return Number of bytes read, 0 or less on timeout, error or end of the connection
 */
public f<long> readNativeSocket(int sockFd, byte* buffer, unsigned long size) {
    return read(sockFd, buffer, size);
}

/**
 * Writes to the given socket. A single call may write only a part of the buffer. A connection, that
 * the peer has closed, makes the call fail instead of raising SIGPIPE, which would end the program.
 *
 * @param sockFd Socket file descriptor
 * @param buffer Buffer to write
 * @param size Number of bytes to write
 * @return Number of bytes written, 0 or less on timeout or error
 */
public f<long> writeNativeSocket(int sockFd, byte* buffer, unsigned long size) {
    return send(sockFd, buffer, size, NATIVE_MSG_NOSIGNAL);
}

/**
 * Returns the time of a monotonic clock, that is not affected by changes of the system time. Only the
 * difference between two values has a meaning.
 *
 * @return Monotonic time in milliseconds
 */
public f<long> getNativeMonotonicMillis() {
    NativeTimeSpec time = NativeTimeSpec {};
    clock_gettime(NATIVE_CLOCK_MONOTONIC, &time);
    return time.tvSec * 1000l + time.tvNsec / 1000000l;
}

/**
 * Closes the given socket
 *
 * @param sockFd Socket file descriptor
 * @return Closing the socket was successful or not
 */
#[ignoreUnusedReturnValue]
public f<bool> closeNativeSocket(int sockFd) {
    return close(sockFd) == 0;
}

/**
 * Returns the path of the hosts file of the system
 *
 * @return Path of the hosts file
 */
public f<String> getNativeHostsFilePath() {
    return String(NATIVE_HOSTS_FILE_PATH);
}

/**
 * Reads the resolver configuration of the system in the format of resolv.conf(5)
 *
 * @return Content of /etc/resolv.conf
 */
public f<Result<String>> readNativeResolverConfig() {
    return readFile(NATIVE_RESOLV_CONF_PATH);
}
