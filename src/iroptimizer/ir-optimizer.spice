// Std imports
import "std/text/print";
import "std/type/type-conversion";
import "std/bindings/llvm/llvm" as llvm;

// Own imports
import "bootstrap/compiler-pass";
import "bootstrap/driver";
import "bootstrap/source-file";
import "bootstrap/global/global-resource-manager";

/**
 * Runs the LLVM optimization pipelines on the modules of the source files.
 *
 * The LLVM C API only allows to run a textual pass pipeline, which sets up an llvm::PassBuilder with its analysis managers
 * internally. So the pipelines are described textually here, e.g. the pipeline of buildPerModuleDefaultPipeline(O2) is
 * 'default<O2>'.
 */
public type IROptimizer struct {
    compose public CompilerPass compilerPass
    llvm::PassBuilderOptions passBuilderOptions
}

public p IROptimizer.ctor(GlobalResourceManager& resourceManager, SourceFile* sourceFile) {
    this.compilerPass = CompilerPass(resourceManager, sourceFile);
}

public p IROptimizer.prepare() {
    // Verify the IR after each pass in test mode
    this.passBuilderOptions.setVerifyEach(this.resourceManager.cliOptions.testMode);
}

public p IROptimizer.optimizeDefault() {
    if this.cliOptions.printDebugOutput && this.cliOptions.dump.dumpIR && !this.cliOptions.dump.dumpToFiles { // LCOV_EXCL_LINE
        println("\nOptimizing on level " + toString(this.cliOptions.optLevel) + " ...");                      // LCOV_EXCL_LINE
    }                                                                                                         // LCOV_EXCL_LINE

    // Prepare pipeline
    llvm::PassBuilder passBuilder = llvm::PassBuilder(this.passBuilderOptions);
    passBuilder.addPass("default<" + this.getLLVMOptLevelName() + ">");

    // Add optional passes
    this.addInstrumentationPassToPipeline(passBuilder);
    this.addCoveragePassToPipeline(passBuilder);

    // Run pipeline
    this.runPipeline(passBuilder, this.sourceFile.llvmModule);
}

public p IROptimizer.optimizePreLink() {
    if this.cliOptions.printDebugOutput && this.cliOptions.dump.dumpIR && !this.cliOptions.dump.dumpToFiles { // LCOV_EXCL_LINE
        println("\nOptimizing on level " + toString(this.cliOptions.optLevel) + " (pre-link) ...");           // LCOV_EXCL_LINE
    }                                                                                                         // LCOV_EXCL_LINE

    // Prepare pipeline
    llvm::PassBuilder passBuilder = llvm::PassBuilder(this.passBuilderOptions);
    passBuilder.addPass("lto-pre-link<" + this.getLLVMOptLevelName() + ">");

    // Run pipeline
    // Note: The LLVM C API does not offer to generate the module summary index here
    this.runPipeline(passBuilder, this.sourceFile.llvmModule);
}

public p IROptimizer.optimizePostLink() {
    if this.cliOptions.printDebugOutput && this.cliOptions.dump.dumpIR && !this.cliOptions.dump.dumpToFiles { // LCOV_EXCL_LINE
        println("\nOptimizing on level " + toString(this.cliOptions.optLevel) + " (post-link) ...");          // LCOV_EXCL_LINE
    }                                                                                                         // LCOV_EXCL_LINE

    // Prepare pipeline
    // Note: The LLVM C API does not offer to pass a module summary index with whole program visibility
    llvm::PassBuilder passBuilder = llvm::PassBuilder(this.passBuilderOptions);
    passBuilder.addPass("lto<" + this.getLLVMOptLevelName() + ">");

    // Add optional passes
    this.addInstrumentationPassToPipeline(passBuilder);

    // Run pipeline
    this.runPipeline(passBuilder, this.resourceManager.ltoModule);
}

p IROptimizer.runPipeline(llvm::PassBuilder& passBuilder, llvm::Module& module) {
    passBuilder.buildCustomPipeline();
    llvm::LLVMError error = passBuilder.run(module, this.sourceFile.targetMachine);
    if error.isError() {                                       // LCOV_EXCL_LINE
        const llvm::Message errorMessage = error.getMessage(); // LCOV_EXCL_LINE
        panic(Error(errorMessage.get()));                      // LCOV_EXCL_LINE
    }                                                          // LCOV_EXCL_LINE
}

p IROptimizer.addInstrumentationPassToPipeline(llvm::PassBuilder& passBuilder) {
    switch this.cliOptions.instrumentation.sanitizer {
        case Sanitizer::NONE: {
            return;
        }
        case Sanitizer::ADDRESS: {
            // AddressSanitizerPass with UseAfterScope enabled
            passBuilder.addPass("asan<use-after-scope>");
        }
        case Sanitizer::THREAD: {
            passBuilder.addPass("tsan-module");
            passBuilder.addPass("function(tsan)");
        }
        case Sanitizer::MEMORY: {
            // MemorySanitizerPass with EagerChecks enabled
            passBuilder.addPass("msan<eager-checks>");
        }
        case Sanitizer::TYPE: {
            passBuilder.addPass("tysan");
        }
    }
}

p IROptimizer.addCoveragePassToPipeline(llvm::PassBuilder& passBuilder) {
    if !this.cliOptions.instrumentation.codeCoverage {
        return;
    }
    // Note: The LLVM C API does not offer to pass a virtual file system with the output dir as working dir
    passBuilder.addPass("insert-gcov-profiling");
}

// Get the name of the LLVM optimization level for the pass pipeline
f<string> IROptimizer.getLLVMOptLevelName() {
    switch this.cliOptions.optLevel {
        case OptLevel::O1: {
            return "O1";
        }
        case OptLevel::Os, OptLevel::Oz, OptLevel::O2: { // Os = O2 + optsize, Oz = O2 + optsize + minsize function attributes
            return "O2";
        }
        case OptLevel::O3: {
            return "O3";
        }
        default: {
            return "O0";
        }
    }
}
