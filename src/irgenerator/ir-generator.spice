/**
 * Get the producer string, that is attached to the generated modules
 *
 * @return Producer string
 */
public f<String> getProducerString() {
    const string version = __get_build_var<string>("SPICE_VERSION", "dev");
    return String("spice version ") + version + " (https://github.com/spicelang/spice)";
}

public type Likelihood enum {
    UNSPECIFIED,
    LIKELY,
    UNLIKELY
}

public type CommonLLVMTypes struct {
    public llvm::Type lambdaFatPtrType
}

// A break/continue target: the scope to run cleanup (dtor calls) up to (inclusive) before jumping, since the
// jump skips the normal fall-through cleanup of enclosing scopes, paired with the block to jump to.
public type BreakContinueTarget struct {
    public Scope* scope
    public llvm::BasicBlock block
}

// Name and symbol table entry of a parameter
public type ParamInfo struct {
    public String name
    public const SymbolTableEntry* entry
}

public type ParamInfoList alias Vector<ParamInfo>;

/**
 * Generates the LLVM IR of a source file.
 *
 * Spice requires all methods of a struct to live in the file of the struct, so this file is split into sections, that are
 * named after the generated constructs (top level definitions, statements, expressions, ...).
 *
 * Notes:
 * - The LLVM C API offers no way to set the dso_local flag of global values, so the generated IR has no dso_local markers.
 *   This does not change the generated code, since the target machine assumes dso_local for all symbols of the executable.
 * - Implicit functions and procedures are generated by a prologue and an epilogue, that surround the body generation at the
 *   call site.
 * - If an instruction takes two operands, which both emit IR (e.g. the lhs and rhs of an addition), the rhs is emitted first.
 */
public type IRGenerator struct : IAbstractAstVisitor {
    compose public CompilerPass compilerPass
    public llvm::LLVMContext* context
    public llvm::IRBuilder* builder
    public llvm::Module* module
    ABIInfo abiInfo
    public OpRuleConversionManager conversionManager
    public StdFunctionManager stdFunctionManager
    public DebugInfoGenerator diGenerator
    public MetadataGenerator mdGenerator
    public CommonLLVMTypes llvmTypes
    Vector<BreakContinueTarget> breakTargets
    Vector<BreakContinueTarget> continueTargets
    Stack<llvm::BasicBlock> fallthroughBlocks
    llvm::BasicBlock allocaInsertBlock
    llvm::Value allocaInsertInst
    bool blockAlreadyTerminated = false
    bool isInCtorBody = false
    Vector<const StructBase*> deferredVTableInitializations
    // IR-side state: separate from semantic objects to keep the type-checker model clean. Both maps are keyed by the address of
    // the symbol table entry / function, since pointers cannot be hashed.
    UnorderedMap<long, Stack<llvm::Value>> addressMap
    UnorderedMap<long, llvm::Function> llvmFunctions
}

public p IRGenerator.ctor(GlobalResourceManager& resourceManager, SourceFile* sourceFile) {
    this.compilerPass = CompilerPass(resourceManager, sourceFile);
    llvm::LLVMContext& llvmContext = sourceFile.getLLVMContext();
    this.context = &llvmContext;
    this.builder = &sourceFile.builder;
    this.module = &sourceFile.llvmModule;
    this.abiInfo = ABIInfo(this.cliOptions.targetTriple, this.module, this.context);
    this.stdFunctionManager = StdFunctionManager(sourceFile, this.module, this);
    this.conversionManager = OpRuleConversionManager(this);
    this.diGenerator = DebugInfoGenerator(this);
    this.mdGenerator = MetadataGenerator(this);

    // Attach information to the module
    this.module.setTargetTriple(this.cliOptions.targetTriple);
    this.module.setDataLayout(sourceFile.targetMachine.createDataLayout());
    if this.cliOptions.outputContainer == OutputContainer::SHARED_LIBRARY {
        this.module.addModuleFlag(llvm::MOD_FLAG_BEHAVIOR_MIN, "PIC Level", 1); // llvm::PICLevel::SmallPIC
        this.module.addModuleFlag(llvm::MOD_FLAG_BEHAVIOR_MAX, "PIE Level", 0); // llvm::PIELevel::Default
    } else {
        this.module.addModuleFlag(llvm::MOD_FLAG_BEHAVIOR_MIN, "PIC Level", 2); // llvm::PICLevel::BigPIC
        this.module.addModuleFlag(llvm::MOD_FLAG_BEHAVIOR_MAX, "PIE Level", 2); // llvm::PIELevel::Large
    }
    this.module.addModuleFlag(llvm::MOD_FLAG_BEHAVIOR_MAX, "uwtable", 2); // llvm::UWTableKind::Default
    // llvm::FramePointerKind::All or llvm::FramePointerKind::None
    this.module.addModuleFlag(llvm::MOD_FLAG_BEHAVIOR_MAX, "frame-pointer", this.cliOptions.keepFramePointers ? 2 : 0);

    // Add module identifier metadata
    this.module.addNamedStringMetadata("llvm.ident", getProducerString());

    // Initialize common LLVM types
    Vector<llvm::Type> fatPtrFieldTypes;
    fatPtrFieldTypes.pushBack(this.builder.getPtrTy());
    fatPtrFieldTypes.pushBack(this.builder.getPtrTy());
    fatPtrFieldTypes.pushBack(this.builder.getInt64Ty());
    this.llvmTypes.lambdaFatPtrType = llvm::getStructType(*this.context, fatPtrFieldTypes);

    // Initialize debug info generator
    if this.cliOptions.instrumentation.emitsDebugInfo() {
        this.diGenerator.initialize(sourceFile.fileName, sourceFile.fileDir);
    }
}

// ============================================================= Visit ===========================================================

// Visit a node, which evaluates to an expression result
f<LLVMExprResult> IRGenerator.visitExpr(IVisitable* node) {
    Any visitResult = this.visit(node);
    return visitResult.get<LLVMExprResult>();
}

// Visit a node, which evaluates to a constant (e.g. a constant node)
f<llvm::Value> IRGenerator.visitConst(IVisitable* node) {
    Any visitResult = this.visit(node);
    return visitResult.get<llvm::Value>();
}

// Visit a node, which evaluates to a type (e.g. a data type node)
f<llvm::Type> IRGenerator.visitType(IVisitable* node) {
    Any visitResult = this.visit(node);
    return visitResult.get<llvm::Type>();
}

// Return value of a visit method, that evaluates to an expression result
f<Any> exprResultAny(const LLVMExprResult& exprResult) {
    return Any(exprResult);
}

// Get the evaluated symbol type of an expression node, that is stored as IVisitable*
f<QualType> IRGenerator.getEvaluatedType(IVisitable* node) {
    ASTExprNode* exprNode = asExprNode(getASTNode(node));
    return exprNode.getEvaluatedSymbolType(this.manIdx);
}

// Check if an expression node, that is stored as IVisitable*, has a compile time value
f<bool> IRGenerator.hasCompileTimeValue(IVisitable* node) {
    ASTNode* astNode = getASTNode(node);
    return astNode.hasCompileTimeValue(this.manIdx);
}

// Get the compile time value of an expression node, that is stored as IVisitable*
f<CompileTimeValue> IRGenerator.getCompileTimeValue(IVisitable* node) {
    ASTNode* astNode = getASTNode(node);
    return astNode.getCompileTimeValue(this.manIdx);
}

// Address of a symbol table entry, function or struct, which is used as map key (pointers cannot be hashed)
f<long> getAddressKey(const byte* ptr) {
    long address = 0l;
    unsafe {
        address = cast<long>(ptr);
    }
    return address;
}

f<long> getEntryKey(const SymbolTableEntry* entry) {
    unsafe {
        return getAddressKey(cast<const byte*>(entry));
    }
}

f<long> getFunctionKey(const model::Function* function) {
    unsafe {
        return getAddressKey(cast<const byte*>(function));
    }
}

// Abort the compilation with a compiler error
p raiseCompilerError(const CodeLoc& codeLoc, CompilerErrorType errorType, const String& message) {
    const CompilerError compilerError = CompilerError(codeLoc, errorType, message.getRaw());
    abortWithError(compilerError.getMessage());
}

// Abort the compilation with a semantic error
p raiseSemanticError(const ASTNode* node, SemanticErrorType errorType, const String& message) {
    const SemanticError semanticError = SemanticError(node, errorType, message.getRaw());
    abortWithError(semanticError.getMessage());
}

// Integer constants. The values are masked to the bit width, so that negative values of signed types are represented
// correctly.
f<llvm::Value> IRGenerator.getInt8(long value) {
    return llvm::getConstInt(this.builder.getInt8Ty(), cast<unsigned long>(value) & 255ul);
}

f<llvm::Value> IRGenerator.getInt16(long value) {
    return llvm::getConstInt(this.builder.getInt16Ty(), cast<unsigned long>(value) & 65535ul);
}

f<llvm::Value> IRGenerator.getInt32(long value) {
    return llvm::getConstInt(this.builder.getInt32Ty(), cast<unsigned long>(value) & 4294967295ul);
}

f<llvm::Value> IRGenerator.getInt64(long value) {
    return llvm::getConstInt(this.builder.getInt64Ty(), cast<unsigned long>(value));
}

f<llvm::Value> IRGenerator.getInt1(bool value) {
    return value ? this.builder.getTrue() : this.builder.getFalse();
}

// ======================================================== IR generator =========================================================

public f<Any> IRGenerator.visitEntry(ASTEntryNode* node) {
    // Generate IR
    this.visitChildren(cast<ASTNode*>(node));

    // Generate test main if required
    if this.sourceFile.isMainFile && this.cliOptions.generateTestMain {
        this.generateTestMain();
    }

    // Execute deferred VTable initializations
    foreach const StructBase* spiceStruct : this.deferredVTableInitializations {
        this.generateVTableInitializer(spiceStruct);
    }

    // Finalize debug info generator
    this.diGenerator.finalize();

    // Verify module
    this.verifyModule(node.codeLoc);

    return Any();
}

public f<llvm::Value> IRGenerator.insertAlloca(llvm::Type llvmType, const String& varName = String()) {
    if !this.allocaInsertInst.isNull() { // If there is already an alloca inst, insert right after that
        // The alloca belongs after the last alloca. The LLVM C API cannot move instructions, so the alloca is created at its
        // final position right away
        // Positioning the builder before an instruction also takes over its debug location, so save and restore it
        const llvm::BasicBlock currentBlock = this.builder.getInsertBlock();
        const llvm::Metadata currentDebugLoc = this.builder.getCurrentDebugLocation();
        const llvm::Value nextInst = this.allocaInsertInst.getNextInstruction();
        if nextInst.isNull() {
            this.builder.setInsertPoint(this.allocaInsertBlock);
        } else {
            this.builder.setInsertPointBefore(this.allocaInsertBlock, nextInst);
        }
        llvm::Value allocaInst = this.builder.createAlloca(llvmType, varName.getRaw());
        allocaInst.dropLocation(); // Part of prologue
        this.allocaInsertInst = allocaInst;
        this.builder.setInsertPoint(currentBlock);
        this.builder.setCurrentDebugLocation(currentDebugLoc);
    } else { // This is the first alloca inst in the current function -> insert at the entry block
        // Save current basic block and debug location and move insert cursor to entry block of the current function
        const llvm::BasicBlock currentBlock = this.builder.getInsertBlock();
        const llvm::Metadata currentDebugLoc = this.builder.getCurrentDebugLocation();
        const llvm::Value firstInst = this.allocaInsertBlock.getFirstInstruction();
        if firstInst.isNull() {
            this.builder.setInsertPoint(this.allocaInsertBlock);
        } else {
            this.builder.setInsertPointBefore(this.allocaInsertBlock, firstInst);
        }

        // Allocate the size of the given LLVM type
        this.allocaInsertInst = this.builder.createAlloca(llvmType, varName.getRaw());
        this.allocaInsertInst.dropLocation(); // Part of prologue

        // Restore old basic block and debug location
        this.builder.setInsertPoint(currentBlock);
        this.builder.setCurrentDebugLocation(currentDebugLoc);
    }

    // Insert lifetime start marker
    if this.cliOptions.useLifetimeMarkers {
        this.createLifetimeMarker("llvm.lifetime.start", this.allocaInsertInst);
    }

    return this.allocaInsertInst;
}

public f<llvm::Value> IRGenerator.insertAlloca(const QualType& qualType, const String& varName = String()) {
    const llvm::Type llvmType = qualType.toLLVMType(this.sourceFile);
    const llvm::Value alloca = this.insertAlloca(llvmType, varName);

    // Insert type metadata
    if this.cliOptions.useTBAAMetadata {
        this.mdGenerator.generateTypeMetadata(this.allocaInsertInst, qualType);
    }

    return alloca;
}

// Like builder.CreateLifetimeStart/CreateLifetimeEnd
p IRGenerator.createLifetimeMarker(string intrinsicName, llvm::Value ptr) {
    Vector<llvm::Type> overloadTypes;
    overloadTypes.pushBack(this.builder.getPtrTy());
    const llvm::Function markerFct = this.module.getIntrinsicDeclaration(intrinsicName, overloadTypes);
    Vector<llvm::Value> args;
    args.pushBack(ptr);
    this.builder.createCall(markerFct, args);
}

public f<llvm::Value> IRGenerator.insertLoad(llvm::Type llvmType, llvm::Value ptr, bool isVolatile = false, const String& varName = String()) {
    const llvm::Type ptrType = ptr.getType();
    assert ptrType.isPointerTy();
    return this.builder.createLoad(ptr, llvmType, varName.getRaw(), isVolatile);
}

public f<llvm::Value> IRGenerator.insertLoad(const QualType& qualType, llvm::Value ptr, bool isVolatile = false, const String& varName = String()) {
    const llvm::Type llvmType = qualType.toLLVMType(this.sourceFile);
    const llvm::Value load = this.insertLoad(llvmType, ptr, isVolatile, varName);
    if this.cliOptions.useTBAAMetadata {
        this.mdGenerator.generateTBAAMetadata(load, qualType);
    }
    return load;
}

#[ignoreUnusedReturnValue]
public f<llvm::Value> IRGenerator.insertStore(llvm::Value val, llvm::Value ptr, bool isVolatile = false) {
    const llvm::Type ptrType = ptr.getType();
    assert ptrType.isPointerTy();
    return this.builder.createStore(val, ptr, isVolatile);
}

public p IRGenerator.insertStore(llvm::Value val, llvm::Value ptr, const QualType& qualType, bool isVolatile = false) {
    const llvm::Value store = this.insertStore(val, ptr, isVolatile);
    if this.cliOptions.useTBAAMetadata {
        this.mdGenerator.generateTBAAMetadata(store, qualType);
    }
}

public f<llvm::Value> IRGenerator.insertInBoundsGEP(llvm::Type ty, llvm::Value basePtr, const Vector<llvm::Value>& indices, const String& varName = String()) {
    const llvm::Type basePtrType = basePtr.getType();
    assert basePtrType.isPointerTy();
    assert !indices.isEmpty();
    foreach const llvm::Value& index : indices {
        const llvm::Type indexType = index.getType();
        assert indexType.isIntegerTy(32) || indexType.isIntegerTy(64);
    }

    // Insert GEP
    return this.builder.createInBoundsGEP(ty, basePtr, indices, varName.getRaw());
}

public f<llvm::Value> IRGenerator.insertInBoundsGEP(llvm::Type ty, llvm::Value basePtr, llvm::Value index, const String& varName = String()) {
    Vector<llvm::Value> indices;
    indices.pushBack(index);
    return this.insertInBoundsGEP(ty, basePtr, indices, varName);
}

public f<llvm::Value> IRGenerator.insertStructGEP(llvm::Type ty, llvm::Value basePtr, unsigned int index, const String& varName = String()) {
    const llvm::Type basePtrType = basePtr.getType();
    assert basePtrType.isPointerTy();

    // If we use index 0 we can use the base pointer directly
    if index == 0 {
        return basePtr;
    }

    // Insert GEP
    return this.builder.createStructGEP(ty, basePtr, index, varName.getRaw());
}

#[ignoreUnusedReturnValue]
public f<llvm::Value> IRGenerator.resolveValue(IVisitable* node) {
    // Visit the given AST node
    LLVMExprResult exprResult = this.visitExpr(node);
    return this.resolveValue(node, exprResult);
}

/**
 * Resolve the value of an expression in its expression scope, if it has one, and destruct the temporaries of the expression right
 * afterwards. The value is already loaded at that point, so it does not depend on the temporaries anymore.
 *
 * @param expr Expression to resolve the value of
 * @return Value of the expression
 */
public f<llvm::Value> IRGenerator.resolveValueInExprScope(IVisitable* expr) {
    ExprScopeHandle exprScopeHandle = ExprScopeHandle(&this.compilerPass, expr);
    const llvm::Value value = this.resolveValue(expr);
    const Scope* exprScope = exprScopeHandle.getExprScope();
    if exprScope != nil<Scope*> {
        this.generateTemporariesCleanup(exprScope, getASTNode(expr));
    }
    return value;
}

#[ignoreUnusedReturnValue]
public f<llvm::Value> IRGenerator.resolveValue(IVisitable* node, LLVMExprResult& exprResult) {
    return this.resolveValue(this.getEvaluatedType(node), exprResult);
}

#[ignoreUnusedReturnValue]
public f<llvm::Value> IRGenerator.resolveValue(const QualType& qualType, LLVMExprResult& exprResult) {
    // Check if the value is already present
    if !exprResult.value.isNull() {
        return exprResult.value;
    }

    // Check if a constant is present
    if !exprResult.constant.isNull() {
        materializeConstant(exprResult);
        return exprResult.value;
    }

    assert !exprResult.ptr.isNull() || !exprResult.refPtr.isNull();

    // De-reference if reference type
    const bool isVolatile = exprResult.entry != nil<const SymbolTableEntry*> && exprResult.entry.isVolatile;
    if !exprResult.refPtr.isNull() && exprResult.ptr.isNull() {
        exprResult.ptr = this.insertLoad(this.builder.getPtrTy(), exprResult.refPtr, isVolatile);
    }

    // Load the value from the pointer
    const QualType referencedType = qualType.removeReferenceWrapper();
    exprResult.value = this.insertLoad(referencedType, exprResult.ptr, isVolatile);

    return exprResult.value;
}

#[ignoreUnusedReturnValue]
public f<llvm::Value> IRGenerator.resolveAddress(IVisitable* node) {
    // Visit the given AST node
    LLVMExprResult exprResult = this.visitExpr(node);
    return this.resolveAddress(exprResult);
}

#[ignoreUnusedReturnValue]
public f<llvm::Value> IRGenerator.resolveAddress(LLVMExprResult& exprResult) {
    // Check if an address is already present
    if !exprResult.ptr.isNull() {
        return exprResult.ptr;
    }

    // Check if the reference address is already present
    const bool isVolatile = exprResult.entry != nil<const SymbolTableEntry*> && exprResult.entry.isVolatile;
    if !exprResult.refPtr.isNull() && exprResult.ptr.isNull() {
        exprResult.ptr = this.insertLoad(this.builder.getPtrTy(), exprResult.refPtr, isVolatile);
        return exprResult.ptr;
    }

    // If not, store the value or constant
    materializeConstant(exprResult);
    assert !exprResult.value.isNull();
    const String varName = exprResult.entry != nil<const SymbolTableEntry*> ? exprResult.entry.name : String();
    exprResult.ptr = this.insertAlloca(exprResult.value.getType(), varName);
    this.insertStore(exprResult.value, exprResult.ptr, isVolatile);

    return exprResult.ptr;
}

// Resolve a resolver, see Resolver
public f<llvm::Value> IRGenerator.resolve(const Resolver& resolver) {
    switch resolver.kind {
        case ResolverKind::NONE: { return llvm::Value(); }
        case ResolverKind::VALUE: { return this.resolveValue(resolver.qualType, *resolver.exprResult); }
        case ResolverKind::ADDRESS: { return this.resolveAddress(*resolver.exprResult); }
        case ResolverKind::EXPR_VALUE: { return this.resolveValue(resolver.expr); }
        case ResolverKind::EXPR_ADDRESS: { return this.resolveAddress(resolver.expr); }
        case ResolverKind::FIXED: { return resolver.fixedValue; }
    }
}

/**
 * Pack a scalar compile-time constant (integer, float, or a null pointer/aggregate) into a raw byte-array constant of
 * the given type, using the target's endianness. This is used to embed a union's default field value into its
 * byte-buffer payload without needing a bitcast between unrelated LLVM types (which is not something opaque-pointer-
 * era LLVM supports between arbitrary aggregate/scalar types).
 *
 * Non-null pointer-shaped constants (e.g. a string literal's global address) cannot be represented this way, since
 * their real value is only known at link/load time (a relocation) and a plain byte array cannot carry one.
 *
 * @param value Compile-time constant to pack
 * @param byteArrayType Target byte-array type (element type i8)
 * @return Packed byte-array constant
 */
f<llvm::Value> IRGenerator.packConstantAsByteArray(llvm::Value value, llvm::Type byteArrayType) {
    const llvm::Type elementType = byteArrayType.getArrayElementType();
    assert elementType.isIntegerTy(8);
    const unsigned long numBytes = byteArrayType.getArrayNumElements();

    // A null/zero constant (e.g. a null pointer, or a zero-initialized aggregate) packs trivially as all-zero bytes.
    if value.isNullValue() {
        return llvm::getNullValue(byteArrayType);
    }

    // Spice constants have at most 64 bits, so this works on the plain 64 bit value instead of an arbitrary precision integer.
    unsigned long bits = 0l;
    if value.isConstantInt() {
        bits = value.getZExtValue();
    } else if value.isConstantFP() {
        const double doubleValue = value.getDoubleValue();
        unsafe {
            const unsigned long* bitsPtr = cast<unsigned long*>(&doubleValue);
            bits = *bitsPtr;
        }
    } else {
        // See the function comment: this is a rare case in practice (most union field defaults are numeric), so it is
        // deliberately unsupported for now rather than silently producing a wrong default value.
        panic(Error("Unsupported default value for a union field of this type")); // LCOV_EXCL_LINE
    }

    const bool isLittleEndian = this.module.isLittleEndian();
    Vector<char> bytes;
    for unsigned long i = 0l; i < numBytes; i++ {
        bytes.pushBack('\0');
    }
    for unsigned long i = 0l; i < numBytes; i++ {
        const unsigned long byteIndex = isLittleEndian ? i : numBytes - 1l - i;
        const unsigned long byteValue = i < 8l ? (bits >> (i * 8l)) & 255ul : 0ul;
        char& byteSlot = bytes.get(byteIndex);
        byteSlot = cast<char>(byteValue);
    }

    return llvm::getConstByteArray(*this.context, bytes);
}

public f<llvm::Value> IRGenerator.getDefaultValueForSymbolType(const QualType& symbolType) {
    // Double
    if symbolType.is(SuperType::TY_DOUBLE) {
        return llvm::getConstDouble(this.builder.getDoubleTy(), 0.0);
    }

    // Int
    if symbolType.is(SuperType::TY_INT) {
        return this.getInt32(0l);
    }

    // Short
    if symbolType.is(SuperType::TY_SHORT) {
        return this.getInt16(0l);
    }

    // Long
    if symbolType.is(SuperType::TY_LONG) {
        return this.getInt64(0l);
    }

    // Byte or char
    if symbolType.is(SuperType::TY_BYTE) || symbolType.is(SuperType::TY_CHAR) {
        return this.getInt8(0l);
    }

    // String
    if symbolType.is(SuperType::TY_STRING) {
        llvm::Value globalString = this.module.createGlobalString(String(""), "");
        if this.cliOptions.comparableOutput {
            globalString.setAlignment(4);
        }
        return globalString;
    }

    // Bool
    if symbolType.is(SuperType::TY_BOOL) {
        return this.builder.getFalse();
    }

    // Pointer or reference
    if symbolType.is(SuperType::TY_PTR) || symbolType.is(SuperType::TY_REF) {
        return llvm::getNullValue(this.builder.getPtrTy());
    }

    // Array
    if symbolType.isArray() {
        // Get array size
        const unsigned long arraySize = cast<unsigned long>(symbolType.getArraySize());

        // Get default value for item
        const QualType itemSymbolType = symbolType.getContained();
        const llvm::Value defaultItemValue = this.getDefaultValueForSymbolType(itemSymbolType);

        // Retrieve array and item type
        const llvm::Type itemType = itemSymbolType.toLLVMType(this.sourceFile);

        // Create a constant array with n times the default value
        Vector<llvm::Value> itemConstants;
        for unsigned long i = 0l; i < arraySize; i++ {
            itemConstants.pushBack(defaultItemValue);
        }
        return llvm::getConstArray(itemType, itemConstants);
    }

    // Function or procedure
    if symbolType.is(SuperType::TY_FUNCTION) || symbolType.is(SuperType::TY_PROCEDURE) {
        const llvm::Value ptrDefaultValue = this.getDefaultValueForSymbolType(QualType(SuperType::TY_PTR));
        const llvm::Value sizeDefaultValue = this.getInt64(0l);
        Vector<llvm::Value> fieldValues;
        fieldValues.pushBack(ptrDefaultValue);
        fieldValues.pushBack(ptrDefaultValue);
        fieldValues.pushBack(sizeDefaultValue);
        return llvm::getConstNamedStruct(this.llvmTypes.lambdaFatPtrType, fieldValues);
    }

    // Struct
    if symbolType.is(SuperType::TY_STRUCT) {
        // Retrieve field count
        Scope* structScope = symbolType.getBodyScope();
        assert structScope != nil<Scope*>;
        const unsigned long fieldCount = structScope.getFieldCount();

        // Get default values for all fields of the struct
        Vector<llvm::Value> fieldConstants;
        fieldConstants.reserve(fieldCount + 1l);

        // Add the VTable address point for the synthesized vtable pointer if required
        const Struct* spiceStruct = symbolType.getStruct(nil<ASTNode*>);
        assert spiceStruct != nil<const Struct*>;
        if spiceStruct.hasSynthesizedVTablePtr() {
            fieldConstants.pushBack(this.getVTableAddressPoint(&spiceStruct.structBase));
        }

        // Add default value for each struct field
        for unsigned long i = 0l; i < fieldCount; i++ {
            // Get entry of the field
            const SymbolTableEntry* fieldEntry = structScope.lookupField(cast<unsigned int>(i));
            assert fieldEntry != nil<const SymbolTableEntry*> && fieldEntry.isField();

            // Retrieve default field value
            llvm::Value defaultFieldValue;
            const ASTFieldNode* fieldNode = getFieldNode(fieldEntry);
            if fieldNode != nil<const ASTFieldNode*> && fieldNode.defaultValue != nil<IVisitable*> {
                const CompileTimeValue defaultValue = this.getCompileTimeValue(fieldNode.defaultValue);
                defaultFieldValue = this.getConst(defaultValue, fieldEntry.getQualType(), cast<ASTNode*>(fieldNode));
            } else {
                defaultFieldValue = this.getDefaultValueForSymbolType(fieldEntry.getQualType());
            }

            fieldConstants.pushBack(defaultFieldValue);
        }

        const llvm::Type structType = symbolType.toLLVMType(this.sourceFile);
        return llvm::getConstNamedStruct(structType, fieldConstants);
    }

    // Union
    if symbolType.is(SuperType::TY_UNION) {
        Scope* unionScope = symbolType.getBodyScope();
        assert unionScope != nil<Scope*>;
        const unsigned long fieldCount = unionScope.getFieldCount();

        // Find the (at most one) field with a default value. Tag 0 is reserved for the "unset" state (see the matching
        // comment in IRGenerator::visitPostfixUnaryExpr's TY_UNION branch), so a field's tag is its index shifted by one.
        unsigned int defaultFieldTag = 0; // Sentinel: no field is active ("unset" state)
        llvm::Value defaultFieldValue;
        for unsigned long i = 0l; i < fieldCount; i++ {
            const SymbolTableEntry* fieldEntry = unionScope.lookupField(cast<unsigned int>(i));
            assert fieldEntry != nil<const SymbolTableEntry*> && fieldEntry.isField();
            const ASTFieldNode* fieldNode = getFieldNode(fieldEntry);
            if fieldNode != nil<const ASTFieldNode*> && fieldNode.defaultValue != nil<IVisitable*> {
                defaultFieldTag = cast<unsigned int>(i) + 1;
                const CompileTimeValue defaultValue = this.getCompileTimeValue(fieldNode.defaultValue);
                defaultFieldValue = this.getConst(defaultValue, fieldEntry.getQualType(), cast<ASTNode*>(fieldNode));
                break;
            }
        }

        const llvm::Type unionType = symbolType.toLLVMType(this.sourceFile);

        // With no default field, tag 0 and an all-zero payload is exactly the "unset" state, so the whole constant
        // collapses to a plain zero value. This also makes such a union eligible for zero-initialized (.bss) storage
        // when used as a global, rather than requiring an explicit non-zero initializer.
        if defaultFieldValue.isNull() {
            return llvm::getNullValue(unionType);
        }

        const llvm::Value tagConstant = this.getInt32(cast<long>(defaultFieldTag));
        const llvm::Value alignPadConstant = llvm::getNullValue(unionType.getStructElementType(1));
        const llvm::Type payloadType = unionType.getStructElementType(2);
        const llvm::Value payloadConstant = this.packConstantAsByteArray(defaultFieldValue, payloadType);

        Vector<llvm::Value> fieldValues;
        fieldValues.pushBack(tagConstant);
        fieldValues.pushBack(alignPadConstant);
        fieldValues.pushBack(payloadConstant);
        return llvm::getConstNamedStruct(unionType, fieldValues);
    }

    // Interface
    if symbolType.is(SuperType::TY_INTERFACE) {
        const llvm::Type structType = symbolType.toLLVMType(this.sourceFile);
        Vector<llvm::Value> fieldValues;
        fieldValues.pushBack(llvm::getNullValue(this.builder.getPtrTy()));
        return llvm::getConstNamedStruct(structType, fieldValues);
    }

    panic(Error("Cannot determine default value for symbol type")); // LCOV_EXCL_LINE
}

// Get the field node, a field entry is declared by, if it is declared by a field node
f<const ASTFieldNode*> getFieldNode(const SymbolTableEntry* fieldEntry) {
    const ASTNode* declNode = fieldEntry.declNode;
    if declNode == nil<const ASTNode*> || declNode.kind != ASTNodeKind::FIELD {
        return nil<const ASTFieldNode*>;
    }
    return downcast<ASTFieldNode>(declNode);
}

f<llvm::Value> IRGenerator.getConst(const CompileTimeValue& compileTimeValue, const QualType& qualType, const ASTNode* node) {
    if qualType.is(SuperType::TY_DOUBLE) {
        return llvm::getConstDouble(this.builder.getDoubleTy(), compileTimeValue.getDoubleValue());
    }

    if qualType.is(SuperType::TY_INT) {
        return this.getInt32(cast<long>(compileTimeValue.getIntValue()));
    }

    if qualType.is(SuperType::TY_SHORT) {
        return this.getInt16(cast<long>(compileTimeValue.getShortValue()));
    }

    if qualType.is(SuperType::TY_LONG) {
        return this.getInt64(compileTimeValue.getLongValue());
    }

    if qualType.is(SuperType::TY_BYTE) || qualType.is(SuperType::TY_CHAR) {
        return this.getInt8(cast<long>(cast<int>(compileTimeValue.getCharValue())));
    }

    if qualType.is(SuperType::TY_STRING) {
        const String& stringValue = this.resourceManager.compileTimeStringValues.get(compileTimeValue.getStringValueOffset());
        return this.createGlobalStringConst(String(ANON_GLOBAL_STRING_NAME), stringValue, node.codeLoc);
    }

    if qualType.is(SuperType::TY_BOOL) {
        return this.getInt1(compileTimeValue.getBoolValue());
    }

    if qualType.is(SuperType::TY_PTR) {
        return llvm::getNullValue(this.builder.getPtrTy());
    }

    // The only compile-time value of a function or procedure type is nil, which is represented as a null fat pointer
    if qualType.is(SuperType::TY_FUNCTION) || qualType.is(SuperType::TY_PROCEDURE) {
        return llvm::getNullValue(this.llvmTypes.lambdaFatPtrType);
    }

    panic(Error("Constant fall-through")); // LCOV_EXCL_LINE
}

f<llvm::BasicBlock> IRGenerator.createBlock(const String& blockName = String()) {
    return llvm::BasicBlock(*this.context, blockName.getRaw());
}

p IRGenerator.switchToBlock(llvm::BasicBlock block, llvm::Function parentFct = llvm::Function()) {
    assert !block.hasParent(); // Ensure that the block was not added to a function already
    // If no parent function were passed, use the current function
    if parentFct.isNull() {
        const llvm::BasicBlock insertBlock = this.builder.getInsertBlock();
        parentFct = insertBlock.getParent();
    }
    // Append block to current function
    parentFct.pushBack(block);
    // Set insert point to the block
    this.builder.setInsertPoint(block);
    this.blockAlreadyTerminated = false;
}

p IRGenerator.terminateBlock(ASTStmtLstNode* stmtLstNode) {
    this.generateScopeCleanup(stmtLstNode);
    this.blockAlreadyTerminated = true;
}

p IRGenerator.insertJump(llvm::BasicBlock targetBlock) {
    if this.blockAlreadyTerminated {
        return;
    }
    this.builder.createBr(targetBlock);
    this.blockAlreadyTerminated = true;
}

p IRGenerator.insertCondJump(llvm::Value condition, llvm::BasicBlock trueBlock, llvm::BasicBlock falseBlock, Likelihood likelihood = Likelihood::UNSPECIFIED) {
    if this.blockAlreadyTerminated {
        return;
    }
    const llvm::Value jumpInst = this.builder.createCondBr(condition, trueBlock, falseBlock);
    this.blockAlreadyTerminated = true;

    if likelihood != Likelihood::UNSPECIFIED {
        this.mdGenerator.generateBranchWeightsMetadata(jumpInst, likelihood);
    }
}

p IRGenerator.verifyFunction(llvm::Function fct, const CodeLoc& codeLoc) {
    // Skip the verifying step if the verifier was disabled manually or debug info is emitted
    if this.cliOptions.disableVerifier {
        return;
    }

    // Verify function. The LLVM C API does not return the output of the function verifier, so it is printed to stderr
    if llvm::verifyFunction(fct, llvm::LLVMVerifierFailureAction::PrintMessageAction) { // LCOV_EXCL_LINE
        raiseCompilerError(codeLoc, CompilerErrorType::INVALID_FUNCTION, String("Function verification failed")); // LCOV_EXCL_LINE
    }
}

p IRGenerator.verifyModule(const CodeLoc& codeLoc) {
    // Skip the verifying step if the verifier was disabled manually or debug info is emitted
    if this.cliOptions.disableVerifier {
        return;
    }

    // Verify module
    String output;
    if this.module.verify(output) { // LCOV_EXCL_LINE
        raiseCompilerError(codeLoc, CompilerErrorType::INVALID_MODULE, output); // LCOV_EXCL_LINE
    }
}

#[ignoreUnusedReturnValue]
f<LLVMExprResult> IRGenerator.doAssignment(IVisitable* lhsNode, IVisitable* rhsNode, ASTNode* node) {
    // Get entry of left side
    LLVMExprResult exprResult = this.visitExpr(lhsNode);
    const SymbolTableEntry* entry = exprResult.entry;
    llvm::Value lhsAddress;
    if entry != nil<const SymbolTableEntry*> && isRefEntry(entry) {
        lhsAddress = exprResult.refPtr;
    } else {
        lhsAddress = this.resolveAddress(exprResult);
    }
    return this.doAssignment(lhsAddress, entry, rhsNode, node);
}

#[ignoreUnusedReturnValue]
f<LLVMExprResult> IRGenerator.doAssignment(llvm::Value lhsAddress, const SymbolTableEntry* lhsEntry, IVisitable* rhsNode, ASTNode* node, bool isDecl = false) {
    // Get symbol type of right side
    const QualType rhsSType = this.getEvaluatedType(rhsNode);
    LLVMExprResult rhs = this.visitExpr(rhsNode);
    return this.doAssignment(lhsAddress, lhsEntry, rhs, rhsSType, node, isDecl);
}

#[ignoreUnusedReturnValue]
f<LLVMExprResult> IRGenerator.doAssignment(llvm::Value lhsAddress, const SymbolTableEntry* lhsEntry, LLVMExprResult& rhs, const QualType& rhsSType, ASTNode* node, bool isDecl) {
    // Deduce some information about the assignment
    const bool isRefAssign = lhsEntry != nil<const SymbolTableEntry*> && isRefEntry(lhsEntry);
    // A non-temporary struct value assigned by value needs a deep copy. This holds whether the destination is a direct
    // lvalue or the value behind an already-bound reference (assign-through): the binding cases of a reference assignment
    // (declaration/initial field ref/return value) all return early above before this is consumed, so the remaining
    // reference assignments are assign-throughs that must copy into the referent instead of shallow-copying (which would
    // alias the rhs' owned members and double-free).
    // A reference rhs never denotes a temporary that could be stolen, even without an entry (e.g. a call returning a
    // reference), because the referenced value is owned elsewhere.
    const QualType rhsSTypeNoRef = rhsSType.removeReferenceWrapper();
    const bool needsCopy = rhsSTypeNoRef.is(SuperType::TY_STRUCT) && (rhsSType.isRef() || !rhs.isTemporary());

    if isRefAssign {
        assert lhsEntry != nil<const SymbolTableEntry*>;
        if isDecl { // Reference gets initially assigned
            // Store lhs pointer to rhs
            const llvm::Value refAddress = this.insertAlloca(this.builder.getPtrTy());
            this.updateAddress(lhsEntry, refAddress);

            // Generate debug info for variable declaration
            this.diGenerator.generateLocalVarDebugInfo(lhsEntry.name, refAddress);

            // Get address of right side
            const llvm::Value rhsAddress = this.resolveAddress(rhs);
            assert !rhsAddress.isNull();
            this.insertStore(rhsAddress, refAddress);

            LLVMExprResult res;
            res.value = rhsAddress;
            res.ptr = refAddress;
            res.entry = lhsEntry;
            return res;
        }

        // Reference to reference assignment (only for struct fields that are not initialized yet)
        // These are only allowed inside a ctor body. In other cases, the value of the reference gets assigned, not the ref itself.
        const bool isInitialFieldRefAssign = this.isInCtorBody && rhsSType.isRef() && rhs.entry != nil<const SymbolTableEntry*> && lhsEntry.isField();
        // Assigning the result variable
        const bool isReturnValAssign = lhsEntry.name == RETURN_VARIABLE_NAME;
        if isInitialFieldRefAssign || isReturnValAssign {
            // Get address of right side
            const llvm::Value referencedAddress = this.resolveAddress(rhs);
            assert !referencedAddress.isNull();

            // Store the rhs* to the lhs**
            this.insertStore(referencedAddress, lhsAddress);

            LLVMExprResult res;
            res.value = referencedAddress;
            res.ptr = lhsAddress;
            res.entry = lhsEntry;
            return res;
        }

        // Load referenced address
        lhsAddress = this.insertLoad(this.builder.getPtrTy(), lhsAddress);
    }

    if isDecl && rhsSType.is(SuperType::TY_STRUCT) && rhs.isTemporary() {
        assert lhsEntry != nil<const SymbolTableEntry*>;
        const llvm::Value rhsAddress = this.resolveAddress(rhs);
        // Only adopt the temporary's storage directly (temp stealing) unless it is a phi merging two independently
        // materialized pointers (e.g. a ternary whose branches each own their own storage). Lifetime markers require
        // their operand to be a real alloca, so stealing such a phi here would emit an invalid llvm.lifetime.end
        // under --sanitizer=address. Any other pointer (a plain alloca, or one derived from it via GEP/load, as in
        // the foreach-loop item extraction below) denotes a single, stable piece of storage and is safe to adopt.
        // The temporary's ownership fully transfers to lhsEntry either way (its underlying storage is never
        // separately destructed), so falling back to a shallow copy into a dedicated alloca is exactly as correct,
        // just gives up the pointer-adoption optimization for the phi case.
        if !rhsAddress.isPHINode() {
            // Directly set the address to the lhs entry (temp stealing)
            this.updateAddress(lhsEntry, rhsAddress);
            rhs.entry = lhsEntry;
            // Generate debug info for variable declaration
            this.diGenerator.generateLocalVarDebugInfo(lhsEntry.name, rhsAddress);
            return rhs;
        }
        // Size the copy off lhsEntry's own type, not rhsSType: some callers (e.g. the foreach-loop item
        // extraction below) pass a struct rhsSType only to steer this branch, while rhs itself resolves (through
        // refPtr indirection) to a differently-typed value; lhsEntry's type is always the authoritative one here.
        const QualType& lhsQualType = lhsEntry.getQualType();
        const llvm::Value lhsAddr = this.insertAlloca(lhsQualType);
        this.updateAddress(lhsEntry, lhsAddr);
        this.diGenerator.generateLocalVarDebugInfo(lhsEntry.name, lhsAddr);
        this.generateShallowCopy(rhsAddress, lhsQualType.toLLVMType(this.sourceFile), lhsAddr, lhsEntry.isVolatile);
        rhs.ptr = lhsAddr;
        rhs.entry = lhsEntry;
        return rhs;
    }

    // Allocate new memory if the lhs address does not exist
    if lhsAddress.isNull() {
        assert lhsEntry != nil<const SymbolTableEntry*>;
        lhsAddress = this.insertAlloca(lhsEntry.getQualType());
        this.updateAddress(lhsEntry, lhsAddress);
        // Generate debug info for variable declaration
        this.diGenerator.generateLocalVarDebugInfo(lhsEntry.name, lhsAddress);
    }

    // Check if we try to assign an array by value to a pointer. Here we have to store the address of the first element to the lhs
    if lhsEntry != nil<const SymbolTableEntry*> && isPtrEntry(lhsEntry) && rhsSType.isArray() && cast<unsigned long>(rhsSType.getArraySize()) != ARRAY_SIZE_UNKNOWN {
        // Get address of right side
        const llvm::Value rhsAddress = this.resolveAddress(rhs);
        assert !rhsAddress.isNull();
        const llvm::Type elementTy = rhsSType.toLLVMType(this.sourceFile);
        Vector<llvm::Value> indices;
        indices.pushBack(this.getInt64(0l));
        indices.pushBack(this.getInt32(0l));
        const llvm::Value firstItemAddress = this.insertInBoundsGEP(elementTy, rhsAddress, indices);
        this.insertStore(firstItemAddress, lhsAddress);
        LLVMExprResult res;
        res.value = rhsAddress;
        res.ptr = lhsAddress;
        res.entry = lhsEntry;
        return res;
    }

    // Handle operator overloads
    if !isDecl && this.conversionManager.callsOverloadedOpFct(node, DEFAULT_OP_IDX) {
        const Resolver lhsV = noneResolver();
        const Resolver rhsV = valueResolver(rhsSType, &rhs);
        const Resolver lhsP = fixedResolver(lhsAddress);
        const Resolver rhsP = addressResolver(&rhs);
        const OperandResolvers resolvers = OperandResolvers(lhsV, lhsP, rhsV, rhsP);
        return this.conversionManager.callOperatorOverloadFct(node, resolvers, 2l, DEFAULT_OP_IDX);
    }

    // Check if we need to copy the rhs to the lhs. This happens for structs
    if needsCopy {
        // Get address of right side
        const llvm::Value rhsAddress = this.resolveAddress(rhs);
        assert !rhsAddress.isNull();

        // If the lhs already holds an initialized, non-trivially-destructible struct, its old value must be
        // destructed before the copy overwrites it, otherwise its owning members (heap pointers, strings, ...)
        // would leak. The typechecker only sets a dtor in exactly those cases. To stay correct for a self-
        // assignment like 'a = a', the destruct + copy are skipped entirely when both sides share the address
        // (the assignment is a no-op in that case, and destructing first would corrupt the value to copy from).
        const model::Function* lhsDtor = this.getLhsDtorFct(node);
        llvm::BasicBlock bCopyEnd;
        if lhsDtor != nil<const model::Function*> {
            const llvm::BasicBlock bCopy = this.createBlock(String("assign.copy"));
            bCopyEnd = this.createBlock(String("assign.copy.end"));
            const llvm::Value selfAssign = this.builder.createICmp(llvm::LLVMIntPredicate::EQ, lhsAddress, rhsAddress);
            this.insertCondJump(selfAssign, bCopyEnd, bCopy);
            this.switchToBlock(bCopy);
            const Vector<llvm::Value> noArgs;
            this.generateCtorOrDtorCall(lhsAddress, lhsDtor, noArgs);
        }

        const QualType rhsSTypeNonRef = rhsSTypeNoRef.toNonConst();
        if rhsSTypeNonRef.isTriviallyCopyable(node) {
            // Create shallow copy
            const llvm::Type rhsType = rhsSTypeNonRef.toLLVMType(this.sourceFile);
            this.generateShallowCopy(rhsAddress, rhsType, lhsAddress, lhsEntry != nil<const SymbolTableEntry*> && lhsEntry.isVolatile);
        } else {
            // Check if we have a copy ctor
            Scope* structScope = rhsSTypeNonRef.getBodyScope();
            ArgList args;
            args.pushBack(Pair<QualType, bool>(rhsSTypeNonRef.toConstRef(node), rhs.isTemporary()));
            const model::Function* copyCtor = lookupFunction(structScope, String(CTOR_FUNCTION_NAME), rhsSTypeNonRef, args, true);
            if copyCtor != nil<const model::Function*> {
                // Call copy ctor
                Vector<llvm::Value> ctorArgs;
                ctorArgs.pushBack(rhsAddress);
                this.generateCtorOrDtorCall(lhsAddress, copyCtor, ctorArgs);
            } else {
                const String structName = rhsSTypeNonRef.getName();
                const String msg = "Cannot copy struct '" + structName + "', as it is not trivially copyable and has no copy ctor";
                raiseSemanticError(node, SemanticErrorType::COPY_CTOR_REQUIRED, msg);
            }
        }

        // Close the self-assignment guard
        if !bCopyEnd.isNull() {
            this.insertJump(bCopyEnd);
            this.switchToBlock(bCopyEnd);
        }
        LLVMExprResult res;
        res.ptr = lhsAddress;
        res.entry = lhsEntry;
        return res;
    }

    // If a temporary struct is moved into an already initialized lhs (temp stealing), the old value of the lhs must be
    // destructed before it gets overwritten, otherwise its owning members would leak. The typechecker only sets a dtor in
    // exactly those cases. The rhs is already evaluated at this point and, being a temporary, never aliases the lhs.
    if rhsSType.is(SuperType::TY_STRUCT) && rhs.isTemporary() {
        const model::Function* lhsDtor = this.getLhsDtorFct(node);
        if lhsDtor != nil<const model::Function*> {
            const Vector<llvm::Value> noArgs;
            this.generateCtorOrDtorCall(lhsAddress, lhsDtor, noArgs);
        }
    }

    // Optimization: If we have the address of both sides, we can do a memcpy instead of loading and storing the value
    llvm::Value rhsValue;
    if rhsSType.is(SuperType::TY_STRUCT) && rhs.value.isNull() && rhs.constant.isNull() {
        // Create shallow copy
        const QualType rhsSTypeNonRef = rhsSTypeNoRef.toNonConst();
        const llvm::Type rhsType = rhsSTypeNonRef.toLLVMType(this.sourceFile);
        const llvm::Value rhsAddress = this.resolveAddress(rhs);
        assert !rhsAddress.isNull();
        this.generateShallowCopy(rhsAddress, rhsType, lhsAddress, lhsEntry != nil<const SymbolTableEntry*> && lhsEntry.isVolatile);
    } else {
        // We can load the value from the right side and store it to the left side
        // Retrieve value of the right side
        rhsValue = this.resolveValue(rhsSType, rhs);
        // Store the value to the address
        this.insertStore(rhsValue, lhsAddress, rhsSType);
    }

    LLVMExprResult res;
    res.value = rhsValue;
    res.ptr = lhsAddress;
    res.entry = lhsEntry;
    return res;
}

// Check if the type of the given entry is a reference
f<bool> isRefEntry(const SymbolTableEntry* entry) {
    const QualType& qualType = entry.getQualType();
    return qualType.isRef();
}

// Check if the type of the given entry is a pointer
f<bool> isPtrEntry(const SymbolTableEntry* entry) {
    const QualType& qualType = entry.getQualType();
    return qualType.isPtr();
}

// Get the dtor of the lhs of an assignment, if the lhs gets overwritten
f<const model::Function*> IRGenerator.getLhsDtorFct(ASTNode* node) {
    if node.kind != ASTNodeKind::ASSIGN_EXPR {
        return nil<const model::Function*>;
    }
    ASTAssignExprNode* assignNode = downcast<ASTAssignExprNode>(node);
    return assignNode.lhsDtorFct.get(this.manIdx);
}

p IRGenerator.generateShallowCopy(llvm::Value oldAddress, llvm::Type varType, llvm::Value targetAddress, bool isVolatile) {
    // Retrieve size to copy
    const unsigned long typeSize = this.module.getTypeAllocSize(varType);

    // Create values for memcpy intrinsic
    const llvm::Value structSize = this.builder.getInt64(typeSize);
    const llvm::Value copyVolatile = this.getInt1(isVolatile);

    // Call memcpy intrinsic to execute the shallow copy
    const llvm::Function memcpyFct = this.stdFunctionManager.getMemcpyIntrinsic();
    assert !targetAddress.isNull();
    Vector<llvm::Value> args;
    args.pushBack(targetAddress);
    args.pushBack(oldAddress);
    args.pushBack(structSize);
    args.pushBack(copyVolatile);
    this.builder.createCall(memcpyFct, args);
}

p IRGenerator.autoDeReferencePtr(llvm::Value& ptr, QualType& symbolType) {
    while symbolType.isPtr() || symbolType.isRef() {
        ptr = this.insertLoad(symbolType, ptr);
        symbolType = symbolType.getContained();
    }
}

f<llvm::Value> IRGenerator.createGlobalConst(const String& baseName, llvm::Value constant) {
    // Get unused name
    const String globalName = this.getUnusedGlobalName(baseName);
    // Create global
    llvm::Value global = this.module.getOrInsertGlobal(globalName.getRaw(), constant.getType());
    // Set initializer to the given constant
    global.setInitializer(constant);
    global.setConstant(true);
    global.setLinkage(llvm::LLVMLinkage::PrivateLinkage);
    global.setUnnamedAddr(llvm::LLVMUnnamedAddr::GlobalUnnamedAddr);
    return global;
}

f<llvm::Value> IRGenerator.createGlobalStringConst(const String& baseName, const String& value) {
    // Get unused name
    const String globalName = this.getUnusedGlobalName(baseName);
    // Create global
    llvm::Value global = this.module.createGlobalString(value, globalName.getRaw());
    // If the output should be comparable, fix alignment to 4 bytes
    if this.cliOptions.comparableOutput {
        global.setAlignment(4);
    }
    return global;
}

f<llvm::Value> IRGenerator.createGlobalStringConst(const String& baseName, const String& value, const CodeLoc& codeLoc) {
    const llvm::Value global = this.createGlobalStringConst(baseName, value);
    // Create debug info
    if this.cliOptions.instrumentation.emitsFullDebugInfo() {
        this.diGenerator.generateGlobalStringDebugInfo(global, global.getName(), value.getLength(), codeLoc);
    }
    return global;
}

f<String> IRGenerator.getUnusedGlobalName(const String& baseName) {
    // Find an unused global name
    String globalName;
    unsigned int suffixNumber = 0;
    do {
        globalName = baseName + toString(suffixNumber);
        suffixNumber++;
        const llvm::Value existingGlobal = this.module.getNamedGlobal(globalName.getRaw());
        if existingGlobal.isNull() {
            break;
        }
    } while true;
    return globalName;
}

p materializeConstant(LLVMExprResult& exprResult) {
    // Skip results, that do not contain a constant or already have a value
    if !exprResult.value.isNull() || exprResult.constant.isNull() {
        return;
    }

    // Default case: the value to the constant
    exprResult.value = exprResult.constant;
}

f<bool> IRGenerator.isSymbolDSOLocal(bool isPublic) {
    // If we are compiling a shared library and export the global symbol, we need to drop dso_local
    // because it may be interposed by other shared objects by the dynamic linker.
    return !(isPublic && this.cliOptions.outputContainer == OutputContainer::SHARED_LIBRARY);
}

f<llvm::LLVMLinkage> IRGenerator.getSymbolLinkageType(bool isPublic) {
    return isPublic ? llvm::LLVMLinkage::ExternalLinkage : llvm::LLVMLinkage::InternalLinkage;
}

f<llvm::LLVMLinkage> IRGenerator.getVTableLinkageType(bool isPublic) {
    // VTables, type infos and type info names are ODR entities that may legitimately be emitted in more than one
    // translation unit (e.g. an interface that is defined in one file and used from several importing files). Giving
    // them weak ODR linkage lets the linker coalesce the duplicates. On ELF this pairs with the comdat group below; on
    // MachO, which has no comdat support, the weak/coalesced linkage is what prevents a duplicate-symbol error.
    return isPublic ? llvm::LLVMLinkage::WeakODRLinkage : llvm::LLVMLinkage::PrivateLinkage;
}

p IRGenerator.attachComdatToSymbol(llvm::Value global, const String& comdatName, bool isPublic) {
    // MachO does not support comdat annotations
    if isPublic && !this.cliOptions.targetTriple.isMachO() {
        global.setComdat(this.module.getOrInsertComdat(comdatName.getRaw()));
    }
}

/**
 * Attach the function attributes that all functions we emit have in common.
 *
 * Spice does not know exceptions and we never emit landing pads, so none of our functions can unwind. We still request
 * an unwind table, so that debuggers and profilers are able to produce correct stack traces.
 *
 * Frame pointers are off by default and are requested per function by '--keep-frame-pointers'. This attribute is the
 * only thing the backend reads. The 'frame-pointer' module flag that IRGenerator's constructor sets from the same
 * option covers a different set of functions - Function::createWithDefaultAttr() stamps it onto the functions LLVM
 * itself synthesizes, such as the sanitizer module ctors - so both have to be set, and the module flag alone changes
 * nothing about the functions we emit: x86-64 Linux then omits the frame pointer at every optimization level, and
 * AArch64 spills the frame record but never links the chain up.
 *
 * Nothing is emitted in the default case, rather than an explicit "none", which is exactly what LLVM does for its own
 * synthesized functions. It also leaves the decision to the backend, so targets whose ABI mandates a frame pointer
 * (e.g. AArch64 on Darwin) keep theirs.
 *
 * The size levels are not communicated to LLVM by the pass pipeline alone - since Os and Oz both select the O2
 * pipeline, 'optsize' and 'minsize' on the individual function are what actually distinguishes them. Without 'minsize',
 * Oz is indistinguishable from Os.
 *
 * @param fct Function to attach the attributes to
 * @param isAlwaysInline Whether the function was declared as inline
 */
p IRGenerator.addCommonFctAttrs(llvm::Function fct, bool isAlwaysInline = false) {
    fct.addFnAttr("nounwind");
    fct.addFnAttr("uwtable", 2l); // llvm::UWTableKind::Default
    if this.cliOptions.keepFramePointers {
        fct.addFnStringAttr("frame-pointer", "all");
    }

    // Explicitly inlined functions must not be marked as 'optnone', because that is incompatible with 'alwaysinline'.
    // This matches the behavior of other frontends: an inline request is honored, even at O0.
    if isAlwaysInline {
        fct.addFnAttr("alwaysinline");
    } else if this.cliOptions.optLevel == OptLevel::O0 {
        fct.addFnAttr("optnone");
        fct.addFnAttr("noinline"); // 'optnone' requires 'noinline'
    }

    if this.cliOptions.optLevel >= OptLevel::Os {
        fct.addFnAttr("optsize");
        if this.cliOptions.optLevel == OptLevel::Oz {
            fct.addFnAttr("minsize");
        }
    }
}

public f<llvm::Value> IRGenerator.getAddress(const SymbolTableEntry* entry) {
    const long key = getEntryKey(entry);
    if !this.addressMap.contains(key) {
        return llvm::Value();
    }
    Stack<llvm::Value>& stack = this.addressMap.get(key);
    if stack.isEmpty() {
        return llvm::Value();
    }
    return stack.top();
}

public p IRGenerator.updateAddress(const SymbolTableEntry* entry, llvm::Value address) {
    assert !address.isNull();
    const llvm::Type addressType = address.getType();
    assert addressType.isPointerTy();
    const long key = getEntryKey(entry);
    if !this.addressMap.contains(key) {
        Stack<llvm::Value> newStack;
        this.addressMap.upsert(key, newStack);
    }
    Stack<llvm::Value>& stack = this.addressMap.get(key);
    if !stack.isEmpty() {
        stack.pop();
    }
    stack.push(address);
}

public p IRGenerator.pushAddress(const SymbolTableEntry* entry, llvm::Value address) {
    assert !address.isNull();
    const long key = getEntryKey(entry);
    if !this.addressMap.contains(key) {
        Stack<llvm::Value> newStack;
        this.addressMap.upsert(key, newStack);
    }
    Stack<llvm::Value>& stack = this.addressMap.get(key);
    stack.push(address);
}

public p IRGenerator.popAddress(const SymbolTableEntry* entry) {
    const long key = getEntryKey(entry);
    assert this.addressMap.contains(key);
    Stack<llvm::Value>& stack = this.addressMap.get(key);
    assert !stack.isEmpty();
    stack.pop();
}

public f<llvm::Function> IRGenerator.getLLVMFunction(const model::Function* spiceFunc) {
    const long key = getFunctionKey(spiceFunc);
    if !this.llvmFunctions.contains(key) {
        return llvm::Function();
    }
    return this.llvmFunctions.get(key);
}

public p IRGenerator.setLLVMFunction(const model::Function* spiceFunc, llvm::Function llvmFunction) {
    assert !llvmFunction.isNull();
    this.llvmFunctions.upsert(getFunctionKey(spiceFunc), llvmFunction);
}

/**
 * Get the information, how a value of the given type is returned from a function on the current target
 *
 * @param returnType Return type of the function, dyn for procedures
 * @return Return ABI info
 */
public f<ReturnABIInfo> IRGenerator.getReturnABIInfo(const QualType& returnType) {
    if returnType.is(SuperType::TY_DYN) {
        return ReturnABIInfo{ReturnABIKind::DIRECT, this.builder.getVoidTy(), llvm::Type()};
    }
    llvm::Type llvmType = returnType.toLLVMType(this.sourceFile);
    // Types with a copy ctor or dtor are non-trivial for the purpose of calls and therefore returned via memory
    const bool isNonTrivial = llvmType.isAggregateType() &&
        (!returnType.isTriviallyCopyable(nil<const ASTNode*>) || !returnType.isTriviallyDestructible(nil<const ASTNode*>));
    return this.abiInfo.classifyReturnType(llvmType, isNonTrivial);
}

/**
 * Get the LLVM function type for a function with the given return and param types, with the return value lowered to the
 * calling convention of the target. If the value is returned via memory, the sret pointer is the first parameter.
 *
 * @param returnType Return type of the function, dyn for procedures
 * @param paramTypes LLVM types of the parameters, including the 'this' pointer for methods
 * @param isVarArg Variadic function or not
 * @return Lowered LLVM function type
 */
public f<llvm::Type> IRGenerator.getFunctionType(const QualType& returnType, const Vector<llvm::Type>& paramTypes, bool isVarArg = false) {
    const ReturnABIInfo returnABI = this.getReturnABIInfo(returnType);
    if returnABI.isCoerced() {
        return llvm::getFunctionType(returnABI.coercedType, paramTypes, isVarArg);
    }
    if returnABI.isIndirect() {
        Vector<llvm::Type> loweredParamTypes;
        loweredParamTypes.pushBack(this.builder.getPtrTy());
        foreach const llvm::Type& paramType : paramTypes {
            loweredParamTypes.pushBack(paramType);
        }
        return llvm::getFunctionType(this.builder.getVoidTy(), loweredParamTypes, isVarArg);
    }
    return llvm::getFunctionType(returnABI.memoryType, paramTypes, isVarArg);
}

/**
 * Get the index of the first actual parameter of a function with the given return type. It is shifted by one, if the
 * function has an sret parameter.
 *
 * @param returnType Return type of the function, dyn for procedures
 * @return Index of the first actual parameter
 */
public f<unsigned int> IRGenerator.getArgOffset(const QualType& returnType) {
    const ReturnABIInfo returnABI = this.getReturnABIInfo(returnType);
    return returnABI.isIndirect() ? 1 : 0;
}

/**
 * Insert a call to a function, that returns a value of the given type, lowered to the calling convention of the target.
 * If the value is returned via memory or coerced, its address is returned via resultAddr. Otherwise, resultAddr is
 * set to a null value and the call itself is the returned value.
 *
 * @param fctType Lowered function type of the callee
 * @param callee Callee
 * @param args Arguments, not including the sret pointer
 * @param returnType Return type of the callee, dyn for procedures
 * @param resultAddr Address of the returned value, if it is returned via memory or coerced
 * @param sretAddr Memory to return the value to, if it is returned via memory. A new temporary is used, if null
 * @return Call instruction
 */
public f<llvm::Value> IRGenerator.insertCall(llvm::Type fctType, llvm::Value callee, const Vector<llvm::Value>& args,
                                            const QualType& returnType, llvm::Value& resultAddr, llvm::Value sretAddr = llvm::Value()) {
    const ReturnABIInfo returnABI = this.getReturnABIInfo(returnType);
    resultAddr = llvm::Value();
    Vector<llvm::Value> loweredArgs;
    if returnABI.isIndirect() {
        resultAddr = sretAddr.isNull() ? this.insertAlloca(returnABI.memoryType) : sretAddr;
        loweredArgs.pushBack(resultAddr);
    }
    foreach const llvm::Value& arg : args {
        loweredArgs.pushBack(arg);
    }

    llvm::Value callInst = this.builder.createCall(fctType, callee, loweredArgs);

    if returnABI.isIndirect() {
        this.addSRetCallParamAttrs(callInst, returnABI.memoryType);
    } else if returnABI.isCoerced() {
        // Store the coerced value to memory, which can be accessed as the actual return type
        resultAddr = this.insertCoercionAlloca(returnABI.memoryType, returnABI.coercedType);
        this.insertStore(callInst, resultAddr);
    }
    return callInst;
}

/**
 * Insert a call to the given function, that returns a value of the given type (see the overload above)
 */
public f<llvm::Value> IRGenerator.insertCall(llvm::Function callee, const Vector<llvm::Value>& args, const QualType& returnType,
                                            llvm::Value& resultAddr, llvm::Value sretAddr = llvm::Value()) {
    return this.insertCall(callee.getFunctionType(), callee.asValue(), args, returnType, resultAddr, sretAddr);
}

/**
 * Insert a return instruction for the current function, lowered to the calling convention of the target
 *
 * @param returnValue Value to return or a null value. For functions with an sret parameter, a null value means, that the
 *                    value was already stored to the sret memory
 */
public p IRGenerator.insertReturn(llvm::Value returnValue) {
    const llvm::BasicBlock currentBlock = this.builder.getInsertBlock();
    llvm::Function function = currentBlock.getParent();

    // Store the value to the memory of the caller
    const llvm::Value sretArg = getSRetArg(function);
    if !sretArg.isNull() {
        if !returnValue.isNull() {
            this.insertStore(returnValue, sretArg);
        }
        this.builder.createRetVoid();
        return;
    }

    if returnValue.isNull() {
        this.builder.createRetVoid();
        return;
    }

    // Coerce the value to the return type via memory
    const llvm::Type returnType = function.getReturnType();
    const llvm::Type valueType = returnValue.getType();
    if !valueType.isSameAs(returnType) {
        const llvm::Value coercionAddr = this.insertCoercionAlloca(valueType, returnType);
        this.insertStore(returnValue, coercionAddr);
        returnValue = this.insertLoad(returnType, coercionAddr);
    }
    this.builder.createRet(returnValue);
}

/**
 * Allocate memory, that can hold a value of both given types
 *
 * @param llvmType Actual type of the value
 * @param coercedType Type, the value is coerced to
 * @return Memory address
 */
f<llvm::Value> IRGenerator.insertCoercionAlloca(llvm::Type llvmType, llvm::Type coercedType) {
    const bool isCoercedTypeLarger = this.module.getTypeAllocSize(coercedType) > this.module.getTypeAllocSize(llvmType);
    llvm::Value alloca = this.insertAlloca(isCoercedTypeLarger ? coercedType : llvmType);
    const unsigned int typeAlign = this.module.getPrefTypeAlign(llvmType);
    const unsigned int coercedTypeAlign = this.module.getPrefTypeAlign(coercedType);
    alloca.setAlignment(typeAlign > coercedTypeAlign ? typeAlign : coercedTypeAlign);
    return alloca;
}

/**
 * Get the sret parameter of the given function
 *
 * @param function LLVM function
 * @return sret parameter or a null value, if the function does not return via memory
 */
public f<llvm::Value> getSRetArg(llvm::Function function) {
    if !function.hasParamAttr(0, "sret") {
        return llvm::Value();
    }
    return function.getArg(0);
}

public p IRGenerator.addSRetParamAttrs(llvm::Function function, llvm::Type llvmType) {
    function.addParamAttr(0, "dead_on_unwind");
    function.addParamAttr(0, "noalias");
    function.addParamAttr(0, "writable");
    function.addParamTypeAttr(0, "sret", llvmType);
    function.addParamAttr(0, "align", cast<unsigned long>(this.module.getABITypeAlign(llvmType)));
}

public p IRGenerator.addSRetCallParamAttrs(llvm::Value callInst, llvm::Type llvmType) {
    callInst.addCallParamAttr(0, "dead_on_unwind");
    callInst.addCallParamAttr(0, "writable");
    callInst.addCallParamTypeAttr(0, "sret", llvmType);
    callInst.addCallParamAttr(0, "align", cast<unsigned long>(this.module.getABITypeAlign(llvmType)));
}

/**
 * Print the given module to a string
 *
 * @param llvmModule LLVM module
 * @param cliOptions Cli options
 * @return IR string
 */
public f<String> getIRString(llvm::Module* llvmModule, const CliOptions& cliOptions) {
    const bool eliminateTarget = cliOptions.comparableOutput && cliOptions.isNativeTarget;

    // Backup target triple and data layout
    const String targetTriple = llvmModule.getTargetTripleString();
    const String targetDataLayout = llvmModule.getDataLayoutString();
    // Remove target triple and data layout
    if eliminateTarget {
        llvmModule.setTargetTripleString("");
        llvmModule.setDataLayoutString("");
    }

    // Get IR string
    const String output = llvmModule.printToString();

    // Restore target triple and data layout
    if eliminateTarget {
        llvmModule.setTargetTripleString(targetTriple.getRaw());
        llvmModule.setDataLayoutString(targetDataLayout.getRaw());
    }

    return output;
}

/**
 * Returns the operator function list for the current manifestation and the given node
 *
 * @param node Node to retrieve the op fct pointer list from
 * @return Op fct pointer list
 */
public f<const Vector<const model::Function*>&> IRGenerator.getOpFctPointers(ASTNode* node) {
    const Vector<Vector<const model::Function*>>* opFctPointers = node.getOpFctPointers();
    assert opFctPointers.getSize() > this.manIdx;
    return opFctPointers.get(this.manIdx);
}

// ==================================================== Top level definitions ====================================================

public f<Any> IRGenerator.visitMainFctDef(ASTMainFctDefNode* node) {
    // Ignore main function definitions if this is not the main source file
    if !this.sourceFile.isMainFile {
        return Any();
    }

    // Do not generate main function if it is explicitly specified
    if this.cliOptions.noEntryFct {
        return Any();
    }

    // Change scope to function scope
    this.currentScope = node.bodyScope;
    assert this.currentScope != nil<Scope*>;

    // Visit parameters
    ParamInfoList paramInfoList;
    QualTypeList paramSymbolTypes;
    Vector<llvm::Type> paramTypes;
    if node.takesArgs {
        ASTParamLstNode* paramLst = downcast<ASTParamLstNode>(node.paramLst);
        const unsigned long numOfParams = paramLst.params.getSize();
        paramInfoList.reserve(numOfParams);
        paramSymbolTypes.reserve(numOfParams);
        paramTypes.reserve(numOfParams);
        foreach ASTDeclStmtNode* param : paramLst.params {
            // Get symbol table entry of param
            const SymbolTableEntry* paramSymbol = node.bodyScope.lookupStrict(param.varName);
            assert paramSymbol != nil<const SymbolTableEntry*>;
            // Retrieve type of param
            const QualType paramSymbolType = paramSymbol.getQualType();
            // Add it to the lists
            paramInfoList.pushBack(ParamInfo{param.varName, paramSymbol});
            paramSymbolTypes.pushBack(paramSymbolType);
            paramTypes.pushBack(paramSymbolType.getParamLLVMType(this.sourceFile));
        }
    }

    // Build the function
    const llvm::Type returnType = this.builder.getInt32Ty();
    const llvm::Type fctType = llvm::getFunctionType(returnType, paramTypes, false);
    llvm::Function fct = this.module.createFunction(fctType, llvm::LLVMLinkage::ExternalLinkage, MAIN_FUNCTION_NAME);
    // ToDo: Set dso_local as soon as the LLVM C API allows it

    // Add function attributes. The main function is the entry point, so nobody can call or inline it.
    fct.addFnAttr("mustprogress");
    fct.addFnAttr("noinline");
    fct.addFnAttr("norecurse");
    this.addCommonFctAttrs(fct);
    this.enableFunctionInstrumentation(fct);

    // Add return value attributes
    fct.addRetAttr("noundef");

    // Add debug info
    if this.cliOptions.instrumentation.emitsDebugInfo() {
        const model::Function spiceFunc = createMainFunction(node.entry, paramSymbolTypes, cast<ASTNode*>(node));
        this.diGenerator.generateFunctionDebugInfo(fct, &spiceFunc);
        this.diGenerator.setSourceLocation(cast<ASTNode*>(node));
    }

    // Create entry block
    const llvm::BasicBlock bEntry = this.createBlock();
    this.switchToBlock(bEntry, fct);

    // Reset alloca insert markers to this block
    this.allocaInsertBlock = bEntry;
    this.allocaInsertInst = llvm::Value();

    // Result variable
    const SymbolTableEntry* resultEntry = this.currentScope.lookupStrict(String(RETURN_VARIABLE_NAME));
    assert resultEntry != nil<const SymbolTableEntry*>;
    if resultEntry.isInitialized() {
        // Allocate result variable
        const llvm::Value resultAddr = this.insertAlloca(QualType(SuperType::TY_INT), String(RETURN_VARIABLE_NAME));
        // Update the symbol table entry
        this.updateAddress(resultEntry, resultAddr);
        // Generate debug info
        this.diGenerator.generateLocalVarDebugInfo(String(RETURN_VARIABLE_NAME), resultAddr);
    }

    // Store function argument values
    const unsigned int argCount = fct.argSize();
    for unsigned int argNumber = 0; argNumber < argCount; argNumber++ {
        const llvm::Value arg = fct.getArg(argNumber);
        // Get information about the parameter
        const ParamInfo& paramInfo = paramInfoList.get(argNumber);
        const SymbolTableEntry* paramSymbol = paramInfo.entry;
        assert paramSymbol != nil<const SymbolTableEntry*>;
        // Decayed array params already carry the address of the array, so they do not need a local copy
        if this.bindDecayedArrayParam(arg, argNumber, paramInfo.name, paramSymbol) {
            continue;
        }
        // Allocate space for it
        const llvm::Value paramAddress = this.insertAlloca(paramSymbol.getQualType(), paramInfo.name);
        // Update the symbol table entry
        this.updateAddress(paramSymbol, paramAddress);
        // Generate debug info
        this.diGenerator.generateLocalVarDebugInfo(paramInfo.name, paramAddress, cast<unsigned long>(argNumber) + 1l);
        // Store the value at the new address
        this.insertStore(arg, paramAddress);
    }

    // Visit function body
    this.visit(node.body);

    // Create return statement if the block is not terminated yet
    if !this.blockAlreadyTerminated {
        llvm::Value res = this.getInt32(0l);
        if resultEntry.isInitialized() {
            res = this.insertLoad(fct.getReturnType(), this.getAddress(resultEntry));
        }
        this.builder.createRet(res);
    }

    // Conclude debug info for function
    this.diGenerator.concludeFunctionDebugInfo();

    // Verify function
    this.verifyFunction(fct, node.codeLoc);

    // Change back to root scope
    this.currentScope = this.rootScope;
    assert this.currentScope != nil<Scope*>;

    return Any();
}

public f<Any> IRGenerator.visitFctDef(ASTFctDefNode* node) {
    return this.visitFctOrProcDef(cast<ASTNode*>(node), &node.node, true, false);
}

public f<Any> IRGenerator.visitProcDef(ASTProcDefNode* node) {
    return this.visitFctOrProcDef(cast<ASTNode*>(node), &node.node, false, node.isCtor);
}

/**
 * Shared implementation of visitFctDef and visitProcDef. The differences are marked below.
 *
 * @param baseNode Function or procedure definition node
 * @param node Function definition base of the node
 * @param isFunction Function or procedure
 * @param isCtor Whether the procedure is a constructor
 */
f<Any> IRGenerator.visitFctOrProcDef(ASTNode* baseNode, ASTFctDefBaseNode* node, bool isFunction, bool isCtor) {
    // Loop through manifestations
    this.manIdx = 0l; // Reset the symbolTypeIndex
    foreach const model::Function* manifestation : node.manifestations {
        assert manifestation.entry != nil<SymbolTableEntry*>;

        // Check if the manifestation is substantiated or not public and not used by anybody
        const QualType& entryType = manifestation.entry.getQualType();
        const bool isPublic = isExportedFunction(manifestation);
        if !manifestation.isFullySubstantiated() || (!isPublic && !manifestation.used) {
            this.manIdx++; // Increment symbolTypeIndex
            continue;
        }
        if !isFunction {
            assert manifestation.alreadyTypeChecked;
        }

        // Change to struct scope or to the interface scope for default methods
        if manifestation.isMethod() {
            const QualType& thisType = manifestation.thisType;
            const QualTypeList noTemplateTypes;
            const String scopeName = manifestation.isInterfaceDefaultMethod ? getInterfaceScopeName(thisType.getSubType(), noTemplateTypes) : getStructScopeName(thisType.getSubType(), thisType.getTemplateTypes());
            this.currentScope = this.currentScope.getChildScope(scopeName);
            assert this.currentScope != nil<Scope*>;
        }

        // Change scope
        this.currentScope = this.currentScope.getChildScope(manifestation.getScopeName());
        assert this.currentScope != nil<Scope*>;

        // Get 'this' entry
        ParamInfoList paramInfoList;
        Vector<llvm::Type> paramTypes;
        if manifestation.isMethod() {
            const SymbolTableEntry* thisEntry = this.currentScope.lookupStrict(String(THIS_VARIABLE_NAME));
            assert thisEntry != nil<const SymbolTableEntry*>;
            paramInfoList.pushBack(ParamInfo{String(THIS_VARIABLE_NAME), thisEntry});
            paramTypes.pushBack(this.builder.getPtrTy());
        }

        // Visit parameters
        unsigned long argIdx = 0l;
        if node.hasParams {
            ASTParamLstNode* paramLst = downcast<ASTParamLstNode>(node.paramLst);
            const unsigned long numOfParams = manifestation.paramList.getSize();
            const QualTypeList manifestationParamTypes = manifestation.getParamTypes();
            paramInfoList.reserve(numOfParams);
            paramTypes.reserve(numOfParams);
            while argIdx < numOfParams {
                const ASTDeclStmtNode* param = paramLst.params.get(argIdx);
                // Get symbol table entry of param
                const SymbolTableEntry* paramSymbol = this.currentScope.lookupStrict(param.varName);
                assert paramSymbol != nil<const SymbolTableEntry*>;
                const QualType& paramSymbolType = manifestationParamTypes.get(argIdx);
                // Retrieve type of param
                const llvm::Type paramType = paramSymbolType.getParamLLVMType(this.sourceFile);
                // Add it to the lists
                paramInfoList.pushBack(ParamInfo{param.varName, paramSymbol});
                paramTypes.pushBack(paramType);
                argIdx++;
            }
        }

        // Get return type
        llvm::Type returnType = this.builder.getVoidTy();
        const QualType returnSType = isFunction ? manifestation.returnType : QualType(SuperType::TY_DYN);
        if isFunction {
            returnType = manifestation.returnType.toLLVMType(this.sourceFile);
        }
        const unsigned int argOffset = this.getArgOffset(returnSType);

        // Create function or implement declared function
        const String mangledName = manifestation.getMangledName();
        const llvm::Type fctType = this.getFunctionType(returnSType, paramTypes);
        this.module.getOrInsertFunction(mangledName.getRaw(), fctType);
        llvm::Function func = this.module.getFunction(mangledName.getRaw());
        this.updateAddress(node.entry, func.asValue());
        this.setLLVMFunction(manifestation, func);
        assert func.isEmpty();

        // Set attributes to function
        // ToDo: Set dso_local as soon as the LLVM C API allows it (isSymbolDSOLocal(isPublic))
        func.setLinkage(this.getSymbolLinkageType(isPublic));
        this.addCommonFctAttrs(func, entryType.isInline());
        this.enableFunctionInstrumentation(func);
        // Set attributes to function parameters and return value
        this.setParamAttrs(func, paramInfoList, argOffset);
        if isFunction {
            this.setFunctionReturnValAttrs(func, manifestation.returnType);
        }

        // Add debug info
        this.diGenerator.generateFunctionDebugInfo(func, manifestation);
        this.diGenerator.setSourceLocation(baseNode);

        // Create entry block
        const llvm::BasicBlock bEntry = this.createBlock();
        this.switchToBlock(bEntry, func);

        // Reset alloca insert markers to this block
        this.allocaInsertBlock = bEntry;
        this.allocaInsertInst = llvm::Value();

        // Result variable
        const SymbolTableEntry* resultEntry = nil<const SymbolTableEntry*>;
        if isFunction {
            resultEntry = this.currentScope.lookupStrict(String(RETURN_VARIABLE_NAME));
            assert resultEntry != nil<const SymbolTableEntry*>;
            if resultEntry.isInitialized() {
                // Allocate result variable. If the value is returned via memory, the result variable lives in the caller's memory
                llvm::Value resultAddr = getSRetArg(func);
                if resultAddr.isNull() {
                    resultAddr = this.insertAlloca(manifestation.returnType, String(RETURN_VARIABLE_NAME));
                }
                // Update the symbol table entry
                this.updateAddress(resultEntry, resultAddr);
                // Generate debug info
                this.diGenerator.generateLocalVarDebugInfo(String(RETURN_VARIABLE_NAME), resultAddr);
            }
        }

        // Store function argument values. The sret parameter is skipped
        const unsigned int argCount = func.argSize() - argOffset;
        for unsigned int argNumber = 0; argNumber < argCount; argNumber++ {
            const llvm::Value arg = func.getArg(argOffset + argNumber);
            // Get information about the parameter
            const ParamInfo& paramInfo = paramInfoList.get(argNumber);
            const SymbolTableEntry* paramSymbol = paramInfo.entry;
            assert paramSymbol != nil<const SymbolTableEntry*>;
            // Decayed array params already carry the address of the array, so they do not need a local copy
            if this.bindDecayedArrayParam(arg, argNumber, paramInfo.name, paramSymbol) {
                continue;
            }
            // Allocate space for it
            const llvm::Value paramAddress = this.insertAlloca(paramSymbol.getQualType(), paramInfo.name);
            // Update the symbol table entry
            this.updateAddress(paramSymbol, paramAddress);
            // Set source location
            this.diGenerator.setSourceLocation(paramSymbol.declNode);
            // Generate debug info to declare variable
            this.diGenerator.generateLocalVarDebugInfo(paramInfo.name, paramAddress, cast<unsigned long>(argNumber) + 1l);
            // Store the value at the new address
            this.insertStore(arg, paramAddress);
        }

        // Store the default values for optional function args
        if node.paramLst != nil<IVisitable*> {
            ASTParamLstNode* paramLst = downcast<ASTParamLstNode>(node.paramLst);
            while argIdx < paramLst.params.getSize() {
                ASTDeclStmtNode* param = paramLst.params.get(argIdx);
                this.visit(cast<IVisitable*>(param));
                argIdx++;
            }
        }

        // Generate special ctor preamble before generating the body to store VTable, default field values, etc. if required
        if isCtor {
            this.isInCtorBody = true;
            this.generateCtorBodyPreamble(this.currentScope);
        }

        // Visit function body
        this.visit(node.body);

        if isCtor {
            this.isInCtorBody = false;
        }

        // Create return statement if the block is not terminated yet
        if !this.blockAlreadyTerminated {
            if isFunction {
                llvm::Value res = this.getDefaultValueForSymbolType(manifestation.returnType);
                if resultEntry.isInitialized() {
                    const llvm::Value resultAddr = this.getAddress(resultEntry);
                    res = resultAddr.isSameAs(getSRetArg(func)) ? llvm::Value() : this.insertLoad(returnType, resultAddr);
                }
                this.insertReturn(res);
            } else {
                this.builder.createRetVoid();
            }
        }

        // Conclude debug info for function
        this.diGenerator.concludeFunctionDebugInfo();

        // Verify function
        this.verifyFunction(func, baseNode.codeLoc);

        // Change to root scope
        this.currentScope = this.rootScope;

        this.manIdx++; // Increment symbolTypeIndex
    }
    this.manIdx = 0l; // Reset the symbolTypeIndex

    // Ensure that we are at the root scope again
    assert this.currentScope == this.rootScope;

    return Any();
}

/**
 * Bind a function argument that carries a decayed array to its parameter symbol. Since the argument already is the
 * address of the array, it can be used as the address of the parameter directly, without allocating a local copy.
 *
 * @param arg Argument of the LLVM function
 * @param argNumber Number of the argument
 * @param paramName Name of the parameter
 * @param paramSymbol Symbol table entry of the parameter
 * @return Whether the argument was bound (false if the parameter does not carry a decayed array)
 */
f<bool> IRGenerator.bindDecayedArrayParam(llvm::Value arg, unsigned int argNumber, const String& paramName, const SymbolTableEntry* paramSymbol) {
    if paramSymbol == nil<const SymbolTableEntry*> {
        return false;
    }
    const QualType& paramType = paramSymbol.getQualType();
    if !paramType.isDecayedArray() {
        return false;
    }

    arg.setName(paramName.getRaw());
    this.updateAddress(paramSymbol, arg);
    // Set source location and generate debug info to declare the variable
    this.diGenerator.setSourceLocation(paramSymbol.declNode);
    this.diGenerator.generateLocalVarDebugInfo(paramName, arg, cast<unsigned long>(argNumber) + 1l);
    return true;
}

/**
 * Materialize an argument that is passed to a decayed array parameter, so that the callee receives the address of a
 * writable array.
 *
 * Two cases need fixing up: if the argument was produced as the array itself instead of its address, it has to be put
 * into memory. And if it was produced as the address of a read-only constant - array literals are emitted as global
 * constants - it has to be copied into a mutable stack slot, because the callee may assign through the parameter. The
 * latter matches how C frontends materialize array compound literals.
 *
 * @param argValue Value that was produced for the argument
 * @param paramType Type of the parameter
 * @return Address of the array to hand to the callee
 */
public f<llvm::Value> IRGenerator.materializeDecayedArrayArg(llvm::Value argValue, const QualType& paramType) {
    assert paramType.isDecayedArray();
    const llvm::Type paramArrayType = paramType.toLLVMType(this.sourceFile);

    // The array itself was produced (e.g. as the result of an implicit cast) -> put it into memory
    const llvm::Type argType = argValue.getType();
    if !argType.isPointerTy() {
        const llvm::Value argAddress = this.insertAlloca(paramArrayType, String("arg.decay"));
        this.insertStore(argValue, argAddress);
        return argAddress;
    }

    // Look through constant offsets, because the implicit array-to-array cast GEPs into the global constant
    const llvm::Value global = argValue.stripInBoundsConstantOffsets();
    if !global.isGlobalVariable() || !global.isConstant() {
        return argValue;
    }

    // Copy the constant into a mutable stack slot. Function matching does not enforce that the argument array has the
    // same size as the parameter array, so copy the smaller of the two to never read past the end of the global.
    const llvm::Type globalType = global.getValueType();
    const bool globalIsSmaller = this.module.getTypeAllocSize(globalType) < this.module.getTypeAllocSize(paramArrayType);
    const llvm::Value argAddress = this.insertAlloca(paramArrayType, String("arg.decay"));
    this.generateShallowCopy(argValue, globalIsSmaller ? globalType : paramArrayType, argAddress, false);
    return argAddress;
}

p IRGenerator.setParamAttrs(llvm::Function function, const ParamInfoList& paramInfo, unsigned int argOffset = 0) {
    assert cast<unsigned long>(function.argSize()) == cast<unsigned long>(argOffset) + paramInfo.getSize();
    for unsigned int paramIdx = 0; paramIdx < cast<unsigned int>(paramInfo.getSize()); paramIdx++ {
        const unsigned int i = argOffset + paramIdx;
        const ParamInfo& info = paramInfo.get(paramIdx);
        const QualType& paramType = info.entry.getQualType();

        // NoUndef attribute
        function.addParamAttr(i, "noundef");

        if paramType.isPtr() {
            const QualType pointeeSType = paramType.getContained();
            const llvm::Type pointeeType = pointeeSType.toLLVMType(this.sourceFile);
            assert !pointeeType.isNull();
            // NonNull and dereferenceable attributes. Only 'this' is guaranteed to point to a valid object, other pointers may be nil
            if info.name == THIS_VARIABLE_NAME {
                function.addParamAttr(i, "nonnull");
                function.addDereferenceableParamAttr(i, this.module.getTypeStoreSize(pointeeType));
            }
            // Alignment attribute
            function.addParamAttr(i, "align", cast<unsigned long>(this.module.getABITypeAlign(pointeeType)));
        }

        // ZExt or SExt attribute
        const string extAttrKind = this.getExtAttrKindForType(paramType);
        if extAttrKind != nil<string> {
            function.addParamAttr(i, extAttrKind);
        }
    }
}

p IRGenerator.setFunctionReturnValAttrs(llvm::Function function, const QualType& returnType) {
    if returnType.is(SuperType::TY_DYN) {
        return;
    }

    // Values, that are returned via memory, have attributes on the sret parameter. Coerced values might contain padding
    const ReturnABIInfo returnABI = this.getReturnABIInfo(returnType);
    if returnABI.isIndirect() {
        this.addSRetParamAttrs(function, returnABI.memoryType);
        return;
    }
    if returnABI.isCoerced() {
        return;
    }

    // NoUndef attribute
    function.addRetAttr("noundef");
    // ZExt or SExt attribute
    const string extAttrKind = this.getExtAttrKindForType(returnType);
    if extAttrKind != nil<string> {
        function.addRetAttr(extAttrKind);
    }
}

// Get the name of the ext attribute kind (zeroext/signext) for the given type, or nil if none is required (llvm::Attribute::None)
f<string> IRGenerator.getExtAttrKindForType(const QualType& qualType) {
    if qualType.is(SuperType::TY_DYN) {
        return nil<string>;
    }

    const llvm::Type llvmType = qualType.toLLVMType(this.sourceFile);
    const unsigned int maxExtWidth = this.cliOptions.targetTriple.isPPC() ? 64 : 32;
    if llvmType.isIntegerTy() && llvmType.getIntegerBitWidth() < maxExtWidth {
        return qualType.isSigned() ? "signext" : "zeroext";
    }
    return nil<string>;
}

public f<Any> IRGenerator.visitStructDef(ASTStructDefNode* node) {
    // Get all substantiated structs which result from this struct def
    Vector<Struct*> manifestations = node.structManifestations;

    // Sort the manifestations to prevent generating the struct types in the wrong order (in case of dependencies between
    // structs). Insertion sort, the lists are small
    for unsigned long i = 1l; i < manifestations.getSize(); i++ {
        Struct* current = manifestations.get(i);
        unsigned long j = i;
        while j > 0l {
            Struct* previous = manifestations.get(j - 1l);
            if previous.manifestationIndex <= current.manifestationIndex {
                break;
            }
            Struct*& slot = manifestations.get(j);
            slot = previous;
            j--;
        }
        Struct*& targetSlot = manifestations.get(j);
        targetSlot = current;
    }

    foreach Struct* spiceStruct : manifestations {
        // Skip structs, that are not fully substantiated
        if !spiceStruct.structBase.isFullySubstantiated() {
            continue;
        }

        // Do not generate this struct if it is private and used by nobody
        const QualType& structEntryType = spiceStruct.entry.getQualType();
        if !spiceStruct.used && !structEntryType.isPublic() {
            continue;
        }

        // Change scope to struct scope, specific to substantiation
        this.currentScope = spiceStruct.scope;
        assert this.currentScope != nil<Scope*>;

        // Set LLVM type to the struct entry
        const SymbolTableEntry* structEntry = spiceStruct.entry;
        assert structEntry != nil<const SymbolTableEntry*>;

        // Generate VTable if required
        if node.emitVTable {
            this.generateVTable(&spiceStruct.structBase);
            this.deferredVTableInitializations.pushBack(&spiceStruct.structBase);
        }

        // Generate default ctor if required
        const QualType& thisType = structEntry.getQualType();
        const ArgList noArgs;
        const model::Function* ctorFunc = lookupFunction(this.currentScope, String(CTOR_FUNCTION_NAME), thisType, noArgs, true);
        if ctorFunc != nil<const model::Function*> && ctorFunc.implicitDefault {
            this.generateDefaultCtor(ctorFunc);
        }

        // Generate default copy ctor if required
        ArgList args;
        args.pushBack(Pair<QualType, bool>(thisType.toConstRef(cast<ASTNode*>(node)), false /* always non-temporary */));
        const model::Function* copyCtorFunc = lookupFunction(this.currentScope, String(CTOR_FUNCTION_NAME), thisType, args, true);
        if copyCtorFunc != nil<const model::Function*> && copyCtorFunc.implicitDefault {
            this.generateDefaultCopyCtor(copyCtorFunc);
        }

        // Generate default move ctor if required. We can't use FunctionManager::lookup with a non-const ref arg
        // here, because the lookup permits const-param-to-non-const-arg matching ("constify") and may return the
        // copy ctor as a false positive. findMoveCtor scans the manifestations directly and only matches the
        // strict move ctor signature.
        const model::Function* moveCtorFunc = findMoveCtor(this.currentScope);
        if moveCtorFunc != nil<const model::Function*> && moveCtorFunc.implicitDefault {
            this.generateDefaultMoveCtor(moveCtorFunc);
        }

        // Generate default dtor if required
        const model::Function* dtorFunc = lookupFunction(this.currentScope, String(DTOR_FUNCTION_NAME), thisType, noArgs, true);
        if dtorFunc != nil<const model::Function*> && dtorFunc.implicitDefault {
            this.generateDefaultDtor(dtorFunc);
        }

        // Return to root scope
        this.currentScope = this.rootScope;
        assert this.currentScope != nil<Scope*>;
    }

    return Any();
}

public f<Any> IRGenerator.visitInterfaceDef(ASTInterfaceDefNode* node) {
    // Get all substantiated structs which result from this struct def
    Vector<Interface*> manifestations = node.interfaceManifestations;

    // Sort the manifestations to prevent generating the struct types in the wrong order (in case of dependencies between
    // structs). Insertion sort, the lists are small
    for unsigned long i = 1l; i < manifestations.getSize(); i++ {
        Interface* current = manifestations.get(i);
        unsigned long j = i;
        while j > 0l {
            Interface* previous = manifestations.get(j - 1l);
            if previous.manifestationIndex <= current.manifestationIndex {
                break;
            }
            Interface*& slot = manifestations.get(j);
            slot = previous;
            j--;
        }
        Interface*& targetSlot = manifestations.get(j);
        targetSlot = current;
    }

    foreach Interface* spiceInterface : manifestations {
        // Skip interfaces, that are not fully substantiated
        if !spiceInterface.structBase.isFullySubstantiated() {
            continue;
        }

        // Do not generate this interface if it is private and used by nobody
        const QualType& interfaceEntryType = spiceInterface.entry.getQualType();
        if !spiceInterface.used && !interfaceEntryType.isPublic() {
            continue;
        }

        // Generate VTable information
        this.generateVTable(&spiceInterface.structBase);
        this.deferredVTableInitializations.pushBack(&spiceInterface.structBase);
    }

    return Any();
}

public f<Any> IRGenerator.visitUnionDef(ASTUnionDefNode* _) {
    return Any(); // Noop (unions carry no per-definition IR work; their LLVM type is materialized lazily on first use)
}

public f<Any> IRGenerator.visitEnumDef(ASTEnumDefNode* _) {
    return Any(); // Noop (enums are high-level semantic-only structures)
}

public f<Any> IRGenerator.visitGenericTypeDef(ASTGenericTypeDefNode* _) {
    return Any(); // Noop (generic types are high-level semantic-only structures)
}

public f<Any> IRGenerator.visitAliasDef(ASTAliasDefNode* _) {
    return Any(); // Noop (alias definitions are high-level semantic-only structures)
}

public f<Any> IRGenerator.visitGlobalVarDef(ASTGlobalVarDefNode* node) {
    // Retrieve some information about the variable
    assert node.entry != nil<SymbolTableEntry*>;
    const QualType& entryType = node.entry.getQualType();
    const bool isPublic = entryType.isPublic();
    const bool isConst = entryType.isConst();

    // Get correct type and linkage type
    const llvm::Type varType = this.visitType(cast<IVisitable*>(node.dataType));

    // Create global var
    const llvm::Value varAddress = this.module.getOrInsertGlobal(node.varName.getRaw(), varType);
    llvm::Value var = this.module.getNamedGlobal(node.varName.getRaw());
    // Set some attributes, based on the given information
    var.setConstant(isConst);
    var.setLinkage(this.getSymbolLinkageType(isPublic));
    // ToDo: Set dso_local as soon as the LLVM C API allows it (isSymbolDSOLocal(isPublic))

    // Set initializer
    if node.hasValue { // Set the constant value as variable initializer
        const llvm::Value constantValue = this.visitConst(cast<IVisitable*>(node.constant));
        var.setInitializer(constantValue);
    } else if this.cliOptions.buildMode != BuildMode::RELEASE || entryType.is(SuperType::TY_UNION) {
        // Set the default value as variable initializer. For a union this is not just a debug convenience (unlike for a
        // struct): the tag bits carry real runtime safety meaning, so they must be initialized unconditionally.
        const llvm::Value constantValue = this.getDefaultValueForSymbolType(entryType);
        var.setInitializer(constantValue);
    }

    this.updateAddress(node.entry, varAddress);

    // Add debug info
    this.diGenerator.generateGlobalVarDebugInfo(var, node.entry);

    return Any();
}

public f<Any> IRGenerator.visitExtDecl(ASTExtDeclNode* node) {
    const model::Function* spiceFunc = node.extFunction;
    assert spiceFunc != nil<const model::Function*>;
    const unsigned int argOffset = this.getArgOffset(spiceFunc.returnType);

    // Get arg types
    const QualTypeList paramTypes = spiceFunc.getParamTypes();
    Vector<llvm::Type> argTypes;
    argTypes.reserve(paramTypes.getSize());
    foreach const QualType& paramType : paramTypes {
        argTypes.pushBack(paramType.getParamLLVMType(this.sourceFile));
    }

    // Declare function
    bool isVarArg = false;
    if node.argTypeLst != nil<IVisitable*> {
        const ASTTypeLstWithEllipsisNode* argTypeLst = downcast<ASTTypeLstWithEllipsisNode>(node.argTypeLst);
        isVarArg = argTypeLst.hasEllipsis;
    }
    const llvm::Type functionType = this.getFunctionType(spiceFunc.returnType, argTypes, isVarArg);
    const String mangledName = spiceFunc.getMangledName();
    this.module.getOrInsertFunction(mangledName.getRaw(), functionType);
    llvm::Function fct = this.module.getFunction(mangledName.getRaw());

    // The external function is assumed not to unwind into Spice code
    fct.addFnAttr("nounwind");

    // Add noundef attribute to all parameters and, for sub-32-bit integers, the ABI-required sext/zext attribute
    for unsigned int i = 0; i < cast<unsigned int>(paramTypes.getSize()); i++ {
        fct.addParamAttr(argOffset + i, "noundef");
        const string extAttrKind = this.getExtAttrKindForType(paramTypes.get(i));
        if extAttrKind != nil<string> {
            fct.addParamAttr(argOffset + i, extAttrKind);
        }
    }

    // Add the same noundef/sext/zext treatment to the return value
    this.setFunctionReturnValAttrs(fct, spiceFunc.returnType);

    // If the function should be imported as dll, add the dll attribute
    if node.attrs != nil<IVisitable*> {
        const ASTTopLevelDefAttrNode* attrs = downcast<ASTTopLevelDefAttrNode>(node.attrs);
        const String dllAttrName = String(ATTR_CORE_LINKER_DLL);
        if attrs.attrLst.hasAttr(dllAttrName) {
            const CompileTimeValue dllAttrValue = attrs.attrLst.getAttrValueByName(dllAttrName);
            if dllAttrValue.getBoolValue() {
                fct.setDLLStorageClass(llvm::LLVMDLLStorageClass::DLLImport);
            }
        }
    }

    return Any();
}

// ===================================================== Control structures ======================================================

public f<Any> IRGenerator.visitUnsafeBlock(ASTUnsafeBlockNode* node) {
    // Change scope
    ScopeHandle _ = ScopeHandle(this, node.getScopeId(), ScopeType::UNSAFE_BODY, cast<ASTNode*>(node));

    // Visit instructions in the block
    this.visit(node.body);

    return Any();
}

public f<Any> IRGenerator.visitForLoop(ASTForLoopNode* node) {
    // Create blocks
    const String codeLine = node.codeLoc.toPrettyLine();
    const llvm::BasicBlock bHead = this.createBlock("for.head." + codeLine);
    const llvm::BasicBlock bBody = this.createBlock("for.body." + codeLine);
    const llvm::BasicBlock bTail = this.createBlock("for.tail." + codeLine);
    const llvm::BasicBlock bExit = this.createBlock("for.exit." + codeLine);

    // Change to head scope
    ScopeHandle _ = ScopeHandle(this, node.getScopeId(), ScopeType::LOOP_HEAD, cast<ASTNode*>(node));
    Scope* bodyScope = this.currentScope.getChildScope(node.getBodyScopeId());

    // Save the break/continue targets, paired with the scope to clean up to when jumping there. The head scope is cleaned up in
    // the exit block, so break does not clean it up itself
    this.breakTargets.pushBack(BreakContinueTarget{bodyScope, bExit});
    this.continueTargets.pushBack(BreakContinueTarget{bodyScope, bTail});

    // Init statement
    this.visit(node.initDecl);
    // Create jump from original to head block
    this.insertJump(bHead);

    // Switch to head block
    this.switchToBlock(bHead);
    // Condition evaluation
    const llvm::Value condValue = this.resolveValueInExprScope(node.condAssign);
    // Create conditional jump from head to body or exit block
    this.insertCondJump(condValue, bBody, bExit);

    // Switch to body block
    this.switchToBlock(bBody);
    // Visit body
    ScopeHandle bodyScopeHandle = ScopeHandle(&this.compilerPass, bodyScope, ScopeType::FOR_BODY);
    this.visit(node.body);
    bodyScopeHandle.leaveScopeEarly();
    // Create jump from body to tail block
    this.insertJump(bTail);

    // Switch to tail block
    this.switchToBlock(bTail);
    // Inc statement
    {
        ExprScopeHandle exprScopeHandle = ExprScopeHandle(&this.compilerPass, node.incAssign);
        this.visit(node.incAssign);
        const Scope* exprScope = exprScopeHandle.getExprScope();
        if exprScope != nil<Scope*> {
            this.generateTemporariesCleanup(exprScope, getASTNode(node.incAssign));
        }
    }
    // Create jump from tail to head
    this.insertJump(bHead);

    // Switch to exit block
    this.switchToBlock(bExit);
    // Clean up the head scope, e.g. destruct the loop variable
    this.generateLoopHeadCleanup(cast<ASTNode*>(node), this.currentScope);

    // Pop break/continue targets
    this.breakTargets.popBack();
    this.continueTargets.popBack();

    return Any();
}

public f<Any> IRGenerator.visitForeachLoop(ASTForeachLoopNode* node) {
    // Create blocks
    const String codeLine = node.codeLoc.toPrettyLine();
    const llvm::BasicBlock bHead = this.createBlock("foreach.head." + codeLine);
    const llvm::BasicBlock bBody = this.createBlock("foreach.body." + codeLine);
    const llvm::BasicBlock bTail = this.createBlock("foreach.tail." + codeLine);
    const llvm::BasicBlock bExit = this.createBlock("foreach.exit." + codeLine);

    // Change to head scope
    ScopeHandle _ = ScopeHandle(this, node.getScopeId(), ScopeType::LOOP_HEAD, cast<ASTNode*>(node));
    Scope* bodyScope = this.currentScope.getChildScope(node.getBodyScopeId());

    // Save the break/continue targets, paired with the scope to clean up to when jumping there. The head scope is cleaned up in
    // the exit block, so break does not clean it up itself
    this.breakTargets.pushBack(BreakContinueTarget{bodyScope, bExit});
    this.continueTargets.pushBack(BreakContinueTarget{bodyScope, bTail});

    // Resolve iterator
    IVisitable* iteratorAssignNode = node.iteratorAssign;
    llvm::Value iteratorPtr;
    if node.getIteratorFct != nil<model::Function*> { // The iteratorAssignExpr is of type Iterable
        const llvm::Value iterablePtr = this.resolveAddress(iteratorAssignNode);

        llvm::Value iterator;
        llvm::Value iteratorAddr;
        const QualTypeList getIteratorParamTypes = node.getIteratorFct.getParamTypes();
        bool isArrayIterable = false;
        if !node.getIteratorFct.isMethod() {
            const QualType& firstParamType = getIteratorParamTypes.front();
            isArrayIterable = firstParamType.isArray();
        }
        if isArrayIterable { // Array as iterable
            // Call iterate() function from std/iterator/array-iterator
            const llvm::Function iterateFct = this.stdFunctionManager.getIterateFct(node.getIteratorFct);
            const QualType iterableType = this.getEvaluatedType(iteratorAssignNode);
            const unsigned long arraySize = cast<unsigned long>(iterableType.getArraySize());
            assert arraySize > 0l;
            Vector<llvm::Value> args;
            args.pushBack(iterablePtr);
            args.pushBack(this.builder.getInt64(arraySize));
            iterator = this.insertCall(iterateFct, args, node.getIteratorFct.returnType, iteratorAddr);
        } else { // Struct as iterable
            // Call .getIterator() on iterable
            const llvm::Function getIteratorFct = this.stdFunctionManager.getIteratorFct(node.getIteratorFct);
            Vector<llvm::Value> args;
            args.pushBack(iterablePtr);
            iterator = this.insertCall(getIteratorFct, args, node.getIteratorFct.returnType, iteratorAddr);
        }

        // Resolve address of iterator. If it is returned via memory or coerced, it already lives in memory
        LLVMExprResult callResult;
        if !iteratorAddr.isNull() {
            callResult.ptr = iteratorAddr;
        } else {
            callResult.value = iterator;
        }
        callResult.node = iteratorAssignNode;
        iteratorPtr = this.resolveAddress(callResult);

        // If an anonymous symbol exists, set its address
        const SymbolTableEntry* returnSymbol = this.currentScope.symbolTable.lookupAnonymous(getASTNode(iteratorAssignNode));
        if returnSymbol != nil<const SymbolTableEntry*> {
            this.updateAddress(returnSymbol, iteratorPtr);
        }
    } else { // The iteratorAssignExpr is of type Iterator
        iteratorPtr = this.resolveAddress(iteratorAssignNode);
    }

    // Check we have an idx
    const bool hasIdx = node.idxVarDecl != nil<IVisitable*>;
    // Retrieve item ref type
    if hasIdx {
        assert node.getIdxFct != nil<model::Function*>;
    } else {
        assert node.getFct != nil<model::Function*>;
    }
    const QualType itemRefSTy = hasIdx ? node.getIdxFct.returnType : node.getFct.returnType;

    // Visit idx variable declaration if required
    const SymbolTableEntry* idxEntry = nil<const SymbolTableEntry*>;
    llvm::Value idxAddress;
    if hasIdx {
        this.visit(node.idxVarDecl);
        // Get address of idx variable
        const ASTDeclStmtNode* idxDeclNode = downcast<ASTDeclStmtNode>(node.idxVarDecl);
        idxEntry = idxDeclNode.entries.get(this.manIdx);
        idxAddress = this.getAddress(idxEntry);
        assert !idxAddress.isNull();
    }

    // Create jump from original to head block
    this.insertJump(bHead);

    // Switch to head block
    this.switchToBlock(bHead);
    this.diGenerator.setSourceLocation(cast<ASTNode*>(node));
    // Call .isValid() on iterator
    assert node.isValidFct != nil<model::Function*>;
    const llvm::Function isValidFct = this.stdFunctionManager.getIteratorIsValidFct(node.isValidFct);
    Vector<llvm::Value> iteratorArgs;
    iteratorArgs.pushBack(iteratorPtr);
    const llvm::Value isValid = this.builder.createCall(isValidFct, iteratorArgs);
    // Create conditional jump from head to body or exit block
    this.insertCondJump(isValid, bBody, bExit);

    // Switch to body block
    this.switchToBlock(bBody);
    // Change to body scope
    ScopeHandle bodyScopeHandle = ScopeHandle(&this.compilerPass, bodyScope, ScopeType::FOREACH_BODY);

    // Visit item variable declaration. The item belongs to the body, so its lifetime begins anew in each round
    this.visit(node.itemVarDecl);
    // Get address of item variable
    const ASTDeclStmtNode* itemDeclNode = downcast<ASTDeclStmtNode>(node.itemVarDecl);
    const SymbolTableEntry* itemEntry = itemDeclNode.entries.get(this.manIdx);
    const llvm::Value itemAddress = this.getAddress(itemEntry);
    assert !itemAddress.isNull();

    // Get the current iterator values
    LLVMExprResult itemResult;
    if hasIdx {
        const QualType& pairSTy = node.getIdxFct.returnType;
        const llvm::Type pairTy = pairSTy.toLLVMType(this.sourceFile);
        // Call .getIdx() on iterator. If the pair is returned via memory or coerced, it already lives in memory
        assert node.getIdxFct != nil<model::Function*>;
        const llvm::Function getIdxFct = this.stdFunctionManager.getIteratorGetIdxFct(node.getIdxFct);
        llvm::Value pairPtr;
        llvm::Value pair = this.insertCall(getIdxFct, iteratorArgs, pairSTy, pairPtr);
        if pairPtr.isNull() {
            pairPtr = this.insertAlloca(pairSTy, String("pair.addr"));
            pair.setName("pair");
            this.insertStore(pair, pairPtr);
        }
        // Store idx to idx var
        const llvm::Value idxAddrInPair = this.insertStructGEP(pairTy, pairPtr, 0, String("idx.addr"));
        LLVMExprResult idxResult;
        idxResult.ptr = idxAddrInPair;
        assert !idxAddress.isNull() && idxEntry != nil<const SymbolTableEntry*>;
        this.doAssignment(idxAddress, idxEntry, idxResult, QualType(SuperType::TY_LONG), cast<ASTNode*>(node), true);
        // Store item to item var
        itemResult.refPtr = this.insertStructGEP(pairTy, pairPtr, 1, String("item.addr"));
    } else {
        // Call .get() on iterator
        assert node.getFct != nil<model::Function*>;
        const llvm::Function getFct = this.stdFunctionManager.getIteratorGetFct(node.getFct);
        itemResult.ptr = this.builder.createCall(getFct, iteratorArgs);
    }
    if node.calledItemCopyCtor != nil<model::Function*> {
        // Call copy ctor
        const llvm::Value rhsAddress = this.resolveAddress(itemResult);
        assert !rhsAddress.isNull();
        Vector<llvm::Value> ctorArgs;
        ctorArgs.pushBack(rhsAddress);
        this.generateCtorOrDtorCall(itemEntry, node.calledItemCopyCtor, ctorArgs);
    } else {
        // Perform normal assignment
        this.doAssignment(itemAddress, itemEntry, itemResult, itemRefSTy, cast<ASTNode*>(node), true);
    }
    // Visit body
    this.visit(node.body);
    // Leave body scope
    bodyScopeHandle.leaveScopeEarly();
    // Create jump from body to tail block
    this.insertJump(bTail);

    // Switch to tail block
    this.switchToBlock(bTail);
    this.diGenerator.setSourceLocation(cast<ASTNode*>(node));
    // Call .next() on iterator
    assert node.nextFct != nil<model::Function*>;
    const llvm::Function nextFct = this.stdFunctionManager.getIteratorNextFct(node.nextFct);
    this.builder.createCall(nextFct, iteratorArgs);
    // Create jump from tail to head block
    this.insertJump(bHead);

    // Switch to exit block
    this.switchToBlock(bExit);
    // Clean up the head scope, e.g. end the lifetime of the index variable
    this.generateLoopHeadCleanup(cast<ASTNode*>(node), this.currentScope);

    // Pop break/continue targets
    this.breakTargets.popBack();
    this.continueTargets.popBack();

    return Any();
}

public f<Any> IRGenerator.visitWhileLoop(ASTWhileLoopNode* node) {
    // Create blocks
    const String codeLine = node.codeLoc.toPrettyLine();
    const llvm::BasicBlock bHead = this.createBlock("while.head." + codeLine);
    const llvm::BasicBlock bBody = this.createBlock("while.body." + codeLine);
    const llvm::BasicBlock bExit = this.createBlock("while.exit." + codeLine);

    // Change scope
    ScopeHandle _ = ScopeHandle(this, node.getScopeId(), ScopeType::WHILE_BODY, cast<ASTNode*>(node));

    // Save the break/continue targets, paired with the scope to clean up to when jumping there
    this.breakTargets.pushBack(BreakContinueTarget{this.currentScope, bExit});
    this.continueTargets.pushBack(BreakContinueTarget{this.currentScope, bHead});

    // Jump to head block
    this.insertJump(bHead);

    // Switch to head block
    this.switchToBlock(bHead);
    // Evaluate condition
    const llvm::Value condValue = this.resolveValueInExprScope(node.condition);
    // Jump to body or exit block, depending on the condition
    this.insertCondJump(condValue, bBody, bExit);

    // Switch to body block
    this.switchToBlock(bBody);
    // Visit body
    this.visit(node.body);
    // Create jump to head block
    this.insertJump(bHead);

    // Switch to exit block
    this.switchToBlock(bExit);

    // Pop break/continue targets
    this.breakTargets.popBack();
    this.continueTargets.popBack();

    return Any();
}

public f<Any> IRGenerator.visitDoWhileLoop(ASTDoWhileLoopNode* node) {
    // Create blocks
    const String codeLine = node.codeLoc.toPrettyLine();
    const llvm::BasicBlock bBody = this.createBlock("dowhile.body." + codeLine);
    const llvm::BasicBlock bFoot = this.createBlock("dowhile.foot." + codeLine);
    const llvm::BasicBlock bExit = this.createBlock("dowhile.exit." + codeLine);

    // Change scope
    ScopeHandle _ = ScopeHandle(this, node.getScopeId(), ScopeType::WHILE_BODY, cast<ASTNode*>(node));

    // Save the break/continue targets, paired with the scope to clean up to when jumping there
    this.breakTargets.pushBack(BreakContinueTarget{this.currentScope, bExit});
    this.continueTargets.pushBack(BreakContinueTarget{this.currentScope, bFoot});

    // Jump to body block
    this.insertJump(bBody);

    // Switch to body block
    this.switchToBlock(bBody);
    // Visit body
    this.visit(node.body);
    // Create jump to foot block
    this.insertJump(bFoot);

    // Switch to head block
    this.switchToBlock(bFoot);
    // Evaluate condition
    const llvm::Value condValue = this.resolveValueInExprScope(node.condition);
    // Jump to body or exit block, depending on the condition
    this.insertCondJump(condValue, bBody, bExit);

    // Switch to exit block
    this.switchToBlock(bExit);

    // Pop break/continue targets
    this.breakTargets.popBack();
    this.continueTargets.popBack();

    return Any();
}

public f<Any> IRGenerator.visitIfStmt(ASTIfStmtNode* node) {
    // If we have a compile time decision, only evaluate the respective branch
    const bool doCompileThenBranch = node.doCompileThenBranch(this.manIdx);
    const bool doCompileElseBranch = node.doCompileElseBranch(this.manIdx);
    if doCompileThenBranch && !doCompileElseBranch {
        ScopeHandle _ = ScopeHandle(this, node.getScopeId(), ScopeType::IF_ELSE_BODY, cast<ASTNode*>(node));
        this.visit(node.thenBody);
        return Any(this.builder.getTrue());
    }
    if !doCompileThenBranch && doCompileElseBranch {
        if node.elseStmt != nil<IVisitable*> {
            this.visit(node.elseStmt);
        }
        return Any(this.builder.getFalse());
    }

    // Create blocks
    const String codeLine = node.codeLoc.toPrettyLine();
    const llvm::BasicBlock bThen = this.createBlock("if.then." + codeLine);
    llvm::BasicBlock bElse;
    if node.elseStmt != nil<IVisitable*> {
        bElse = this.createBlock("if.else." + codeLine);
    }
    const llvm::BasicBlock bExit = this.createBlock("if.exit." + codeLine);

    // Change scope
    ScopeHandle scopeHandle = ScopeHandle(this, node.getScopeId(), ScopeType::IF_ELSE_BODY, cast<ASTNode*>(node));

    // Retrieve condition value
    const llvm::Value condValue = this.resolveValueInExprScope(node.condition);
    // Check if condition is fulfilled
    this.insertCondJump(condValue, bThen, node.elseStmt != nil<IVisitable*> ? bElse : bExit);

    // Switch to then block
    this.switchToBlock(bThen);
    // Visit then body
    this.visit(node.thenBody);
    // Create jump from then to end block
    this.insertJump(bExit);

    // Change scope back
    scopeHandle.leaveScopeEarly();

    if node.elseStmt != nil<IVisitable*> {
        // Switch to else block
        this.switchToBlock(bElse);
        // Visit else block
        this.visit(node.elseStmt);
        // Create jump from else to end block
        this.insertJump(bExit);
    }

    // Switch to exit block
    this.switchToBlock(bExit);

    // Return conditional value as result for the 'if' stmt
    return Any(condValue);
}

public f<Any> IRGenerator.visitElseStmt(ASTElseStmtNode* node) {
    if node.ifStmt != nil<IVisitable*> { // It is an else if branch
        this.visit(node.ifStmt);
    } else { // It is an else branch
        // Change scope
        ScopeHandle _ = ScopeHandle(this, node.getScopeId(), ScopeType::IF_ELSE_BODY, cast<ASTNode*>(node));

        // Generate IR for nested statements
        this.visit(node.body);
    }

    return Any();
}

public f<Any> IRGenerator.visitSwitchStmt(ASTSwitchStmtNode* node) {
    // Create blocks
    Vector<llvm::BasicBlock> bCases;
    bCases.reserve(node.caseBranches.getSize());
    foreach IVisitable* caseBranch : node.caseBranches {
        const CodeLoc& caseBranchCodeLoc = caseBranch.getCodeLoc();
        bCases.pushBack(this.createBlock("switch.case." + caseBranchCodeLoc.toPrettyLine()));
    }
    llvm::BasicBlock bDefault;
    if node.hasDefaultBranch {
        const CodeLoc& defaultBranchCodeLoc = node.defaultBranch.getCodeLoc();
        bDefault = this.createBlock("switch.default." + defaultBranchCodeLoc.toPrettyLine());
    }
    const String codeLine = node.codeLoc.toPrettyLine();
    const llvm::BasicBlock bExit = this.createBlock("switch.exit." + codeLine);

    // Save the break target. The scope to clean up to is set by each case/default branch as it is visited below,
    // since it changes per branch (there is no single scope spanning the whole switch statement).
    this.breakTargets.pushBack(BreakContinueTarget{nil<Scope*>, bExit});

    // Visit switch expression
    const llvm::Value exprValue = this.resolveValue(node.assignExpr);

    // Generate switch instruction
    llvm::Value switchInst = this.builder.createSwitch(exprValue, node.hasDefaultBranch ? bDefault : bExit, cast<unsigned int>(node.caseBranches.getSize()));

    // Generate case branches
    for unsigned long i = 0l; i < node.caseBranches.getSize(); i++ {
        const ASTCaseBranchNode* caseBranch = downcast<ASTCaseBranchNode>(node.caseBranches.get(i));

        // Push fallthrough block
        llvm::BasicBlock bFallthrough = bDefault;
        if i + 1l < node.caseBranches.getSize() {
            bFallthrough = bCases.get(i + 1l);
        }
        this.fallthroughBlocks.push(bFallthrough);

        // Switch to case block
        this.switchToBlock(bCases.get(i));

        // Visit case body
        this.visit(node.caseBranches.get(i));

        // Create jump from case to exit block
        this.insertJump(bExit);

        // Pop fallthrough block
        this.fallthroughBlocks.pop();

        // Add case to switch instruction
        foreach IVisitable* caseConstantNode : caseBranch.caseConstants {
            const llvm::Value caseValue = this.visitConst(caseConstantNode);
            switchInst.addCase(caseValue, bCases.get(i));
        }
    }

    // Generate default branch
    if node.hasDefaultBranch {
        // Switch to default block
        this.switchToBlock(bDefault);

        // Visit default body
        this.visit(node.defaultBranch);

        // Create jump from default to exit block
        this.insertJump(bExit);
    }

    // Switch to exit block
    this.switchToBlock(bExit);

    // Pop break target
    this.breakTargets.popBack();

    return Any();
}

public f<Any> IRGenerator.visitCaseBranch(ASTCaseBranchNode* node) {
    // Change to case body scope
    ScopeHandle _ = ScopeHandle(&this.compilerPass, node.getScopeId(), ScopeType::CASE_BODY);

    // A 'break' within this branch targets the enclosing switch; point it at this branch's own scope
    BreakContinueTarget& breakTarget = this.breakTargets.back();
    breakTarget.scope = this.currentScope;

    // Visit case body
    this.visit(node.body);

    return Any();
}

public f<Any> IRGenerator.visitDefaultBranch(ASTDefaultBranchNode* node) {
    // Change to default body scope
    ScopeHandle _ = ScopeHandle(&this.compilerPass, node.getScopeId(), ScopeType::DEFAULT_BODY);

    // A 'break' within this branch targets the enclosing switch; point it at this branch's own scope
    BreakContinueTarget& breakTarget = this.breakTargets.back();
    breakTarget.scope = this.currentScope;

    // Visit case body
    this.visit(node.body);

    return Any();
}

public f<Any> IRGenerator.visitAnonymousBlockStmt(ASTAnonymousBlockStmtNode* node) {
    // Change scope
    node.bodyScope.parent = this.currentScope;                           // Needed for nested scopes in generic functions
    node.bodyScope.symbolTable.parent = &this.currentScope.symbolTable; // Needed for nested scopes in generic functions
    ScopeHandle _ = ScopeHandle(this, node.getScopeId(), ScopeType::ANONYMOUS_BLOCK_BODY, cast<ASTNode*>(node));

    // Visit instructions in the block
    this.visit(node.body);

    return Any();
}

// ========================================================= Statements ==========================================================

public f<Any> IRGenerator.visitStmtLst(ASTStmtLstNode* node) {
    // Generate instructions in the scope
    foreach IVisitable* stmt : node.statements {
        // Check if we can cancel generating instructions for this code branch
        const ASTStmtNode* stmtNode = asStmtNode(getASTNode(stmt));
        if this.blockAlreadyTerminated || stmtNode.unreachable {
            break;
        }

        // Set source location for debug info
        this.diGenerator.setSourceLocation(getASTNode(stmt));

        // Visit child
        this.visit(stmt);
    }

    // Generate cleanup code of this scope, e.g. dtor calls for struct instances
    this.generateScopeCleanup(node);

    return Any();
}

public f<Any> IRGenerator.visitTypeAltsLst(ASTTypeAltsLstNode* _) {
    return Any(); // Noop
}

public f<Any> IRGenerator.visitDeclStmt(ASTDeclStmtNode* node) {
    // Get variable entry
    const SymbolTableEntry* varEntry = node.entries.get(this.manIdx);
    assert varEntry != nil<const SymbolTableEntry*>;
    const QualType varSymbolType = varEntry.getQualType();

    // Get LLVM type of variable
    const llvm::Type varTy = varSymbolType.toLLVMType(this.sourceFile);

    // Check if the declaration is with an assignment or the default value
    llvm::Value varAddress;
    if node.hasAssignment { // Assignment
        if node.calledCopyCtor != nil<model::Function*> {
            // Allocate memory
            varAddress = this.insertAlloca(varTy);
            this.updateAddress(varEntry, varAddress);
            // Generate debug info for variable declaration
            this.diGenerator.generateLocalVarDebugInfo(node.varName, varAddress);
            // Call copy ctor
            const llvm::Value rhsAddress = this.resolveAddress(node.assignExpr);
            assert !rhsAddress.isNull();
            Vector<llvm::Value> ctorArgs;
            ctorArgs.pushBack(rhsAddress);
            this.generateCtorOrDtorCall(varEntry, node.calledCopyCtor, ctorArgs);
        } else {
            // Assign rhs to lhs
            const LLVMExprResult assignResult = this.doAssignment(varAddress, varEntry, node.assignExpr, cast<ASTNode*>(node), true);
            assert assignResult.entry == varEntry;
            varAddress = this.getAddress(varEntry);
            this.updateAddress(varEntry, varAddress);
        }
    } else { // Default value
        // Allocate memory
        varAddress = this.insertAlloca(varTy);
        this.updateAddress(varEntry, varAddress);

        // Generate debug info for variable declaration
        this.diGenerator.generateLocalVarDebugInfo(node.varName, varAddress);

        if node.calledInitCtor != nil<model::Function*> {
            // Call no-args constructor
            const Vector<llvm::Value> noArgs;
            this.generateCtorOrDtorCall(varEntry, node.calledInitCtor, noArgs);
            // A union with no default field must start in the "unset" tag state, and a union with a default field must
            // start with that field active. Either way, the tag bits carry real runtime safety meaning (unlike a struct's
            // all-zero debug-only default), so they must be initialized unconditionally, in every build mode.
        } else if !node.isForEachItem && (this.cliOptions.buildMode != BuildMode::RELEASE || varSymbolType.is(SuperType::TY_UNION)) {
            assert !node.isCtorCallRequired;
            // Retrieve default value for lhs symbol type and store it
            const llvm::Value defaultValue = this.getDefaultValueForSymbolType(varSymbolType);
            this.insertStore(defaultValue, varAddress);
        }
    }
    assert !varAddress.isNull();

    // Attach the variable name to the LLVM value.
    varAddress.setName(varEntry.name.getRaw());

    return Any();
}

public f<Any> IRGenerator.visitQualifierLst(ASTQualifierLstNode* _) {
    return Any(); // Noop
}

public f<Any> IRGenerator.visitModAttr(ASTModAttrNode* _) {
    return Any(); // Noop
}

public f<Any> IRGenerator.visitTopLevelDefinitionAttr(ASTTopLevelDefAttrNode* _) {
    return Any(); // Noop
}

public f<Any> IRGenerator.visitCaseConstant(ASTCaseConstantNode* node) {
    if node.constant != nil<ASTConstantNode*> {
        return this.visit(cast<IVisitable*>(node.constant));
    }

    const SymbolTableEntry* constantEntry = node.entry;
    const CompileTimeValue compileTimeValue = constantEntry.declNode.getCompileTimeValue(this.manIdx);
    const QualType evaluatedType = this.getEvaluatedType(cast<IVisitable*>(node));
    return Any(this.getConst(compileTimeValue, evaluatedType, cast<ASTNode*>(node)));
}

public f<Any> IRGenerator.visitReturnStmt(ASTReturnStmtNode* node) {
    // If the value is returned via memory, it is directly put into the memory of the caller
    const llvm::BasicBlock currentBlock = this.builder.getInsertBlock();
    const llvm::Value sretArg = getSRetArg(currentBlock.getParent());

    llvm::Value returnValue;
    if node.hasReturnValue { // Return value is attached to the return statement
        IVisitable* returnExpr = node.assignExpr;
        if node.calledCopyCtor != nil<model::Function*> {
            // Perform a copy
            const llvm::Value originalAddress = this.resolveAddress(returnExpr);
            const llvm::Type returnTy = node.returnType.toLLVMType(this.sourceFile);
            const llvm::Value newAddress = sretArg.isNull() ? this.insertAlloca(returnTy) : sretArg;
            Vector<llvm::Value> ctorArgs;
            ctorArgs.pushBack(originalAddress);
            this.generateCtorOrDtorCall(newAddress, node.calledCopyCtor, ctorArgs);
            if sretArg.isNull() {
                returnValue = this.insertLoad(returnTy, newAddress);
            }
        } else {
            returnValue = node.returnType.isRef() ? this.resolveAddress(returnExpr) : this.resolveValue(returnExpr);
        }
    } else { // Try to load result variable value
        const SymbolTableEntry* resultEntry = this.currentScope.lookup(String(RETURN_VARIABLE_NAME));
        if resultEntry != nil<const SymbolTableEntry*> {
            const llvm::Value returnValueAddr = this.getAddress(resultEntry);
            // The result variable of functions, that return via memory, already lives in the memory of the caller
            if !returnValueAddr.isSameAs(sretArg) {
                const QualType& resultType = resultEntry.getQualType();
                const llvm::Type resultSTy = resultType.toLLVMType(this.sourceFile);
                returnValue = this.insertLoad(resultSTy, returnValueAddr);
            }
        }
    }

    // Clean up all scopes between here and the enclosing function/procedure/lambda body, then terminate the block. A local
    // variable, that is returned without a copy, is destructed by the caller
    this.generateScopeCleanupUpTo(cast<ASTNode*>(node), this.currentScope.getFunctionScope(), node.returnedLocals.get(this.manIdx));
    this.blockAlreadyTerminated = true;

    // Create return instruction
    this.insertReturn(returnValue);

    return Any();
}

public f<Any> IRGenerator.visitBreakStmt(ASTBreakStmtNode* node) {
    const BreakContinueTarget target = this.breakTargets.get(this.breakTargets.getSize() - cast<unsigned long>(node.breakTimes));

    // Clean up all scopes between here and the loop/switch statement we are breaking out of
    this.generateScopeCleanupUpTo(cast<ASTNode*>(node), target.scope);

    // Jump to destination block
    this.insertJump(target.block);

    return Any();
}

public f<Any> IRGenerator.visitContinueStmt(ASTContinueStmtNode* node) {
    const BreakContinueTarget target = this.continueTargets.get(this.continueTargets.getSize() - cast<unsigned long>(node.continueTimes));

    // Clean up all scopes between here and the loop statement we are continuing
    this.generateScopeCleanupUpTo(cast<ASTNode*>(node), target.scope);

    // Jump to destination block
    this.insertJump(target.block);

    return Any();
}

public f<Any> IRGenerator.visitFallthroughStmt(ASTFallthroughStmtNode* _) {
    // Jump to destination block
    this.insertJump(this.fallthroughBlocks.top());

    return Any();
}

// Generate the body of a failed assertion
p IRGenerator.generateAssertBody(ASTAssertStmtNode* node) {
    // Create constant for error message. It is the format string of the fprintf call below, so the condition's source text
    // must not be mistaken for conversion specifiers
    String expressionString = node.expressionString;
    expressionString.replaceAll("%", "%%");
    const String errorMsg = "Assertion failed: Condition '" + expressionString + "' evaluated to false.\n";
    const String globalName = this.getUnusedGlobalName(String(ANON_GLOBAL_STRING_NAME));
    llvm::Value globalString = this.module.createGlobalString(errorMsg, globalName.getRaw());
    // If the output should be comparable, fix alignment to 4 bytes
    if this.cliOptions.comparableOutput {
        globalString.setAlignment(4);
    }
    // Print the error message to stderr, like panic does
    const llvm::Function fprintfFct = this.stdFunctionManager.getFPrintfFct();
    Vector<llvm::Value> fprintfArgs;
    fprintfArgs.pushBack(this.getStdErrValue());
    fprintfArgs.pushBack(globalString);
    this.builder.createCall(fprintfFct, fprintfArgs);
    // Print the stack trace of the failed assertion
    if this.cliOptions.printsStackTraceOnAbort() {
        Vector<llvm::Value> dumpArgs;
        dumpArgs.pushBack(this.builder.getTrue());
        dumpArgs.pushBack(this.builder.getFalse());
        this.builder.createCall(this.stdFunctionManager.getDumpStacktraceFct(), dumpArgs);
    }
    // Generate call to exit()
    const llvm::Function exitFct = this.stdFunctionManager.getExitFct();
    Vector<llvm::Value> exitArgs;
    exitArgs.pushBack(this.getInt32(cast<long>(EXIT_FAILURE)));
    this.builder.createCall(exitFct, exitArgs);
    // Create unreachable instruction
    this.builder.createUnreachable();
    this.blockAlreadyTerminated = true;
}

public f<Any> IRGenerator.visitAssertStmt(ASTAssertStmtNode* node) {
    // Do not generate assertions in release mode
    if this.cliOptions.buildMode == BuildMode::RELEASE {
        return Any();
    }

    // If we have a compile time decision, only evaluate the respective branch
    if this.hasCompileTimeValue(node.assignExpr) {
        const CompileTimeValue compileTimeValue = this.getCompileTimeValue(node.assignExpr);
        if !compileTimeValue.getBoolValue() {
            this.generateAssertBody(node);
        }
        return Any();
    }

    // Create blocks
    const String codeLine = node.codeLoc.toPrettyLine();
    const llvm::BasicBlock bThen = this.createBlock("assert.then." + codeLine);
    const llvm::BasicBlock bExit = this.createBlock("assert.exit." + codeLine);

    // Visit the assignExpr
    const llvm::Value condValue = this.resolveValue(node.assignExpr);

    // Create condition check
    this.insertCondJump(condValue, bExit, bThen, Likelihood::LIKELY);

    // Switch to then block
    this.switchToBlock(bThen);
    this.generateAssertBody(node);

    // Switch to exit block
    this.switchToBlock(bExit);

    return Any();
}

// ========================================================= Expressions =========================================================

public f<Any> IRGenerator.visitAssignExpr(ASTAssignExprNode* node) {
    // Visit ternary expression
    if node.ternaryExpr != nil<IVisitable*> {
        return this.visit(node.ternaryExpr);
    }

    this.diGenerator.setSourceLocation(cast<ASTNode*>(node));

    // Assign or compound assign operation
    if node.op != AssignOp::OP_NONE {
        IVisitable* lhsNode = node.lhs;
        IVisitable* rhsNode = node.rhs;
        ASTNode* baseNode = cast<ASTNode*>(node);

        // Normal assignment
        if node.op == AssignOp::OP_ASSIGN {
            return exprResultAny(this.doAssignment(lhsNode, rhsNode, baseNode));
        }

        // Compound assignment
        // Get symbol types of left and right side
        const QualType lhsSTy = this.getEvaluatedType(lhsNode);
        const QualType rhsSTy = this.getEvaluatedType(rhsNode);

        // Retrieve rhs
        LLVMExprResult rhs = this.visitExpr(rhsNode);
        // Retrieve lhs
        LLVMExprResult lhs = this.visitExpr(lhsNode);

        LLVMExprResult res;
        switch node.op {
            case AssignOp::OP_PLUS_EQUAL: { res = this.conversionManager.getPlusEqualInst(baseNode, lhs, lhsSTy, rhs, rhsSTy); }
            case AssignOp::OP_MINUS_EQUAL: { res = this.conversionManager.getMinusEqualInst(baseNode, lhs, lhsSTy, rhs, rhsSTy); }
            case AssignOp::OP_MUL_EQUAL: { res = this.conversionManager.getMulEqualInst(baseNode, lhs, lhsSTy, rhs, rhsSTy); }
            case AssignOp::OP_DIV_EQUAL: { res = this.conversionManager.getDivEqualInst(baseNode, lhs, lhsSTy, rhs, rhsSTy); }
            case AssignOp::OP_REM_EQUAL: { res = this.conversionManager.getRemEqualInst(baseNode, lhs, lhsSTy, rhs, rhsSTy); }
            case AssignOp::OP_SHL_EQUAL: { res = this.conversionManager.getSHLEqualInst(baseNode, lhs, lhsSTy, rhs, rhsSTy); }
            case AssignOp::OP_SHR_EQUAL: { res = this.conversionManager.getSHREqualInst(baseNode, lhs, lhsSTy, rhs, rhsSTy); }
            case AssignOp::OP_AND_EQUAL: { res = this.conversionManager.getAndEqualInst(baseNode, lhs, lhsSTy, rhs, rhsSTy); }
            case AssignOp::OP_OR_EQUAL: { res = this.conversionManager.getOrEqualInst(baseNode, lhs, lhsSTy, rhs, rhsSTy); }
            case AssignOp::OP_XOR_EQUAL: { res = this.conversionManager.getXorEqualInst(baseNode, lhs, lhsSTy, rhs, rhsSTy); }
            default: { panic(Error("Assign op fall-through")); } // LCOV_EXCL_LINE
        }

        if !res.ptr.isNull() { // The operation allocated more memory
            if lhs.entry != nil<const SymbolTableEntry*> {
                this.updateAddress(lhs.entry, res.ptr);
            }
        } else if !res.value.isNull() { // The operation only updated the value
            // Store the result
            lhs.value = res.value;
            this.insertStore(lhs.value, lhs.ptr, lhs.entry != nil<const SymbolTableEntry*> && lhs.entry.isVolatile);
        }
        return exprResultAny(lhs);
    }

    // This is a fallthrough case -> throw an error
    panic(Error("AssignStmt fall-through")); // LCOV_EXCL_LINE
}

// Enter the expression scope of the given expression, if it has one
f<Scope*> IRGenerator.enterExprScope(IVisitable* expr) {
    Scope* exprScope = this.currentScope.getChildScope(getExprScopeId(expr));
    if exprScope != nil<Scope*> {
        this.compilerPass.changeToScope(exprScope, ScopeType::EXPR_BODY);
    }
    return exprScope;
}

// Leave the given expression scope, if it exists
p IRGenerator.leaveExprScope(Scope* exprScope) {
    if exprScope != nil<Scope*> {
        this.compilerPass.changeToParentScope(ScopeType::EXPR_BODY);
    }
}

public f<Any> IRGenerator.visitTernaryExpr(ASTTernaryExprNode* node) {
    // Check if only one operand is present -> loop through
    if node.falseExpr == nil<IVisitable*> {
        return this.visit(node.condition);
    }

    this.diGenerator.setSourceLocation(cast<ASTNode*>(node));

    // It is a ternary
    // Retrieve the condition value
    const llvm::Value condValue = this.resolveValue(node.condition);
    IVisitable* trueNode = node.isShortened ? node.condition : node.trueExpr;
    IVisitable* falseNode = node.falseExpr;

    llvm::Value resultValue;
    llvm::Value resultPtr;
    const SymbolTableEntry* anonymousSymbol = nil<const SymbolTableEntry*>;
    if this.hasCompileTimeValue(trueNode) && this.hasCompileTimeValue(falseNode) {
        // If both are constants, we can simply emit a selection instruction
        const llvm::Value trueValue = this.resolveValue(trueNode);
        const llvm::Value falseValue = this.resolveValue(falseNode);
        resultValue = this.builder.createSelect(condValue, trueValue, falseValue);
    } else {
        // We have at least one non-constant value, use branching to not perform both sides
        const String codeLoc = node.codeLoc.toPrettyLineAndColumn();
        llvm::BasicBlock condTrue = this.createBlock("cond.true." + codeLoc);
        llvm::BasicBlock condFalse = this.createBlock("cond.false." + codeLoc);
        const llvm::BasicBlock condExit = this.createBlock("cond.exit." + codeLoc);

        // Jump from original block to true or false block, depending on condition
        this.insertCondJump(condValue, condTrue, condFalse);

        // Fill true block
        this.switchToBlock(condTrue);
        const QualType resultType = this.getEvaluatedType(cast<IVisitable*>(node));
        llvm::Value trueValue;
        llvm::Value truePtr;
        // The true branch has an expression scope for its temporaries, except for shortened ternaries (the condition is the branch)
        Scope* trueScope = nil<Scope*>;
        if !node.isShortened {
            trueScope = this.enterExprScope(trueNode);
        }
        if node.falseSideCallsCopyCtor || resultType.isRef() { // both sides or only the false side needs copy ctor call
            truePtr = this.resolveAddress(trueNode);
        } else if node.trueSideCallsCopyCtor { // only true side needs copy ctor call
            const llvm::Value originalPtr = this.resolveAddress(trueNode);
            // Allocate storage for the copy using the ternary's own result type, not trueNode's own evaluated type:
            // trueNode may be a reference (e.g. a 'const T&' parameter), whose LLVM type is just a pointer and would
            // undersize this alloca for the struct value the copy ctor is about to write into it.
            truePtr = this.insertAlloca(resultType);
            Vector<llvm::Value> ctorArgs;
            ctorArgs.pushBack(originalPtr);
            this.generateCtorOrDtorCall(truePtr, node.calledCopyCtor, ctorArgs);
        } else { // neither true nor false side need copy ctor call
            trueValue = this.resolveValue(trueNode);
        }
        this.leaveExprScope(trueScope);
        // Set the true block to the current insert point, since it could have changed in the meantime
        condTrue = this.builder.getInsertBlock();
        this.insertJump(condExit);

        // Fill false block
        this.switchToBlock(condFalse);
        llvm::Value falseValue;
        llvm::Value falsePtr;
        // The false branch has an expression scope for its temporaries
        Scope* falseScope = this.enterExprScope(falseNode);
        if node.trueSideCallsCopyCtor || resultType.isRef() { // both sides or only the true side needs copy ctor call
            falsePtr = this.resolveAddress(falseNode);
        } else if node.falseSideCallsCopyCtor { // only false side needs copy ctor call
            const llvm::Value originalPtr = this.resolveAddress(falseNode);
            // See the analogous truePtr allocation above: use the ternary's result type, not falseNode's own
            // (possibly reference-qualified) evaluated type.
            falsePtr = this.insertAlloca(resultType);
            Vector<llvm::Value> ctorArgs;
            ctorArgs.pushBack(originalPtr);
            this.generateCtorOrDtorCall(falsePtr, node.calledCopyCtor, ctorArgs);
        } else { // neither true nor false side need copy ctor call
            falseValue = this.resolveValue(falseNode);
        }
        this.leaveExprScope(falseScope);
        // Set the true block to the current insert point, since it could have changed in the meantime
        condFalse = this.builder.getInsertBlock();
        this.insertJump(condExit);

        // Fill the exit block
        this.switchToBlock(condExit);
        if node.trueSideCallsCopyCtor || node.falseSideCallsCopyCtor || resultType.isRef() { // one side calls copy ctor
            llvm::Value phiInst = this.builder.createPhi(this.builder.getPtrTy(), "cond.result");
            phiInst.addIncoming(truePtr, condTrue);
            phiInst.addIncoming(falsePtr, condFalse);
            if node.trueSideCallsCopyCtor && node.falseSideCallsCopyCtor { // both sides need copy ctor call
                resultPtr = this.insertAlloca(resultType);
                Vector<llvm::Value> ctorArgs;
                ctorArgs.pushBack(phiInst);
                this.generateCtorOrDtorCall(resultPtr, node.calledCopyCtor, ctorArgs);
            } else {
                resultPtr = phiInst;
            }
        } else { // neither true nor false side calls copy ctor
            assert !trueValue.isNull();
            llvm::Value phiInst = this.builder.createPhi(resultType.toLLVMType(this.sourceFile), "cond.result");
            phiInst.addIncoming(trueValue, condTrue);
            phiInst.addIncoming(falseValue, condFalse);
            resultValue = phiInst;
        }

        // If we have an anonymous symbol for this ternary expr, make sure that it has an address to reference.
        anonymousSymbol = this.currentScope.symbolTable.lookupAnonymous(cast<ASTNode*>(node));
        if anonymousSymbol != nil<const SymbolTableEntry*> {
            if resultPtr.isNull() {
                resultPtr = this.insertAlloca(anonymousSymbol.getQualType());
                this.insertStore(resultValue, resultPtr);
            }
            this.updateAddress(anonymousSymbol, resultPtr);
        }

        // Destruct the temporaries of the branch that was evaluated. This must happen here, after the result was copied out of the
        // branch and only for the branch that was taken, since the temporaries of the other one were never constructed.
        const bool trueNeedsCleanup = trueScope != nil<Scope*> && !trueScope.temporaryDtorsToCall.isEmpty();
        const bool falseNeedsCleanup = falseScope != nil<Scope*> && !falseScope.temporaryDtorsToCall.isEmpty();
        if trueNeedsCleanup || falseNeedsCleanup {
            const llvm::BasicBlock bCleanTrue = this.createBlock("cond.cleanup.true." + codeLoc);
            const llvm::BasicBlock bCleanFalse = this.createBlock("cond.cleanup.false." + codeLoc);
            const llvm::BasicBlock bCleanExit = this.createBlock("cond.cleanup.exit." + codeLoc);
            this.insertCondJump(condValue, bCleanTrue, bCleanFalse);

            this.switchToBlock(bCleanTrue);
            if trueNeedsCleanup {
                this.generateTemporariesCleanup(trueScope, getASTNode(trueNode));
            }
            this.insertJump(bCleanExit);

            this.switchToBlock(bCleanFalse);
            if falseNeedsCleanup {
                this.generateTemporariesCleanup(falseScope, getASTNode(falseNode));
            }
            this.insertJump(bCleanExit);

            this.switchToBlock(bCleanExit);
        }
    }

    LLVMExprResult res;
    res.value = resultValue;
    res.ptr = resultPtr;
    res.entry = anonymousSymbol;
    return exprResultAny(res);
}

// Shared implementation of visitLogicalOrExpr and visitLogicalAndExpr
f<Any> IRGenerator.visitLogicalExpr(ASTNode* node, const Vector<IVisitable*>& operands, bool isOr) {
    this.diGenerator.setSourceLocation(node);

    // Create exit block for short-circuiting
    const String codeLoc = node.codeLoc.toPrettyLineAndColumn();
    const String prefix = String(isOr ? "lor" : "land");
    const llvm::BasicBlock bExit = this.createBlock(prefix + ".exit." + codeLoc);

    // Visit the first operand
    const llvm::Value firstOperandValue = this.resolveValue(operands.front());

    // Prepare an array for value-to-block-mapping
    Vector<llvm::BasicBlock> shortCircuitBlocks;
    Vector<llvm::Value> shortCircuitValues;
    shortCircuitBlocks.reserve(operands.getSize());
    shortCircuitValues.reserve(operands.getSize());
    // The first element is the first operand value with the original block
    shortCircuitBlocks.pushBack(this.builder.getInsertBlock());
    shortCircuitValues.pushBack(firstOperandValue);
    // Create a block for each additional operand and save it to the mapping
    for unsigned long i = 1l; i < operands.getSize(); i++ {
        shortCircuitBlocks.pushBack(this.createBlock(prefix + "." + toString(i) + "." + codeLoc));
        shortCircuitValues.pushBack(llvm::Value());
    }
    // Create conditional jump to the exit block if the first operand was true (or), otherwise to the next block
    if isOr {
        this.insertCondJump(firstOperandValue, bExit, shortCircuitBlocks.get(1l));
    } else {
        this.insertCondJump(firstOperandValue, shortCircuitBlocks.get(1l), bExit);
    }

    // Create block for each operand
    for unsigned long i = 1l; i < operands.getSize(); i++ {
        // Switch to the next block
        this.switchToBlock(shortCircuitBlocks.get(i));
        // Evaluate operand and save the result in the mapping. The temporaries of the operand are destructed within its block, since
        // they only exist if the operand was evaluated
        llvm::Value& operandValue = shortCircuitValues.get(i);
        operandValue = this.resolveValueInExprScope(operands.get(i));
        // Replace the array entry with the current insert block, since the insert block could have changed in the meantime
        llvm::BasicBlock& operandBlock = shortCircuitBlocks.get(i);
        operandBlock = this.builder.getInsertBlock();
        // Check if there are more blocks to process
        if i == operands.getSize() - 1l {
            // Insert a simple jump to the exit block for the last block
            this.insertJump(bExit);
        } else if isOr {
            // Create conditional jump to the exit block if the operand was true, otherwise to the next block
            this.insertCondJump(operandValue, bExit, shortCircuitBlocks.get(i + 1l));
        } else {
            // Create conditional jump to the next block if the operand was true, otherwise to the exit block
            this.insertCondJump(operandValue, shortCircuitBlocks.get(i + 1l), bExit);
        }
    }

    // Get the result with the phi node
    this.switchToBlock(bExit);
    llvm::Value res = this.builder.createPhi(firstOperandValue.getType(), isOr ? "lor_phi" : "land_phi");
    for unsigned long i = 0l; i < shortCircuitBlocks.getSize(); i++ {
        res.addIncoming(shortCircuitValues.get(i), shortCircuitBlocks.get(i));
    }

    // Return the result
    return exprResultAny(exprResultWithValue(res));
}

public f<Any> IRGenerator.visitLogicalOrExpr(ASTLogicalOrExprNode* node) {
    // Check if only one operand is present -> loop through
    if node.operands.getSize() == 1l {
        return this.visit(node.operands.front());
    }

    // It is a logical or expression
    return this.visitLogicalExpr(cast<ASTNode*>(node), node.operands, true);
}

public f<Any> IRGenerator.visitLogicalAndExpr(ASTLogicalAndExprNode* node) {
    // Check if only one operand is present -> loop through
    if node.operands.getSize() == 1l {
        return this.visit(node.operands.front());
    }

    // It is a logical and expression
    return this.visitLogicalExpr(cast<ASTNode*>(node), node.operands, false);
}

// Kinds of bitwise expressions
type BitwiseExprKind enum {
    OR,
    XOR,
    AND
}

// Shared implementation of visitBitwiseOrExpr, visitBitwiseXorExpr and visitBitwiseAndExpr
f<Any> IRGenerator.visitBitwiseExpr(ASTNode* node, const Vector<IVisitable*>& operands, BitwiseExprKind kind) {
    this.diGenerator.setSourceLocation(node);

    // Evaluate first operand
    IVisitable* lhsNode = operands.front();
    const QualType lhsSTy = this.getEvaluatedType(lhsNode);
    LLVMExprResult res = this.visitExpr(lhsNode);

    // Evaluate all additional operands
    for unsigned long i = 1l; i < operands.getSize(); i++ {
        // Evaluate the operand
        IVisitable* rhsNode = operands.get(i);
        const QualType rhsSTy = this.getEvaluatedType(rhsNode);
        LLVMExprResult rhs = this.visitExpr(rhsNode);
        switch kind {
            case BitwiseExprKind::OR: { res = this.conversionManager.getBitwiseOrInst(node, res, lhsSTy, rhs, rhsSTy, i - 1l); }
            case BitwiseExprKind::XOR: { res = this.conversionManager.getBitwiseXorInst(node, res, lhsSTy, rhs, rhsSTy, i - 1l); }
            case BitwiseExprKind::AND: { res = this.conversionManager.getBitwiseAndInst(node, res, lhsSTy, rhs, rhsSTy, i - 1l); }
        }
    }

    // Return result
    return exprResultAny(res);
}

public f<Any> IRGenerator.visitBitwiseOrExpr(ASTBitwiseOrExprNode* node) {
    // Check if only one operand is present -> loop through
    if node.operands.getSize() == 1l {
        return this.visit(node.operands.front());
    }
    // It is a bitwise or expression
    return this.visitBitwiseExpr(cast<ASTNode*>(node), node.operands, BitwiseExprKind::OR);
}

public f<Any> IRGenerator.visitBitwiseXorExpr(ASTBitwiseXorExprNode* node) {
    // Check if only one operand is present -> loop through
    if node.operands.getSize() == 1l {
        return this.visit(node.operands.front());
    }
    // It is a bitwise xor expression
    return this.visitBitwiseExpr(cast<ASTNode*>(node), node.operands, BitwiseExprKind::XOR);
}

public f<Any> IRGenerator.visitBitwiseAndExpr(ASTBitwiseAndExprNode* node) {
    // Check if only one operand is present -> loop through
    if node.operands.getSize() == 1l {
        return this.visit(node.operands.front());
    }
    // It is a bitwise and expression
    return this.visitBitwiseExpr(cast<ASTNode*>(node), node.operands, BitwiseExprKind::AND);
}

public f<Any> IRGenerator.visitEqualityExpr(ASTEqualityExprNode* node) {
    // Check if only one operand is present -> loop through
    if node.operands.getSize() == 1l {
        return this.visit(node.operands.front());
    }

    this.diGenerator.setSourceLocation(cast<ASTNode*>(node));

    // It is an equality expression
    // Evaluate lhs
    IVisitable* lhsNode = node.operands.get(0l);
    const QualType lhsSTy = this.getEvaluatedType(lhsNode);
    LLVMExprResult res = this.visitExpr(lhsNode);

    // Evaluate rhs
    IVisitable* rhsNode = node.operands.get(1l);
    const QualType rhsSTy = this.getEvaluatedType(rhsNode);
    LLVMExprResult rhs = this.visitExpr(rhsNode);

    // Retrieve the result value, based on the exact operator
    ASTNode* baseNode = cast<ASTNode*>(node);
    switch node.op {
        case EqualityOp::OP_EQUAL: { res = this.conversionManager.getEqualInst(baseNode, res, lhsSTy, rhs, rhsSTy); }
        case EqualityOp::OP_NOT_EQUAL: { res = this.conversionManager.getNotEqualInst(baseNode, res, lhsSTy, rhs, rhsSTy); }
        default: { panic(Error("EqualityExpr fall-through")); } // LCOV_EXCL_LINE
    }

    // Return the result
    return exprResultAny(res);
}

public f<Any> IRGenerator.visitRelationalExpr(ASTRelationalExprNode* node) {
    // Check if only one operand is present -> loop through
    if node.operands.getSize() == 1l {
        return this.visit(node.operands.front());
    }

    this.diGenerator.setSourceLocation(cast<ASTNode*>(node));

    // It is a relational expression
    // Evaluate lhs
    IVisitable* lhsNode = node.operands.get(0l);
    const QualType lhsSTy = this.getEvaluatedType(lhsNode);
    LLVMExprResult res = this.visitExpr(lhsNode);

    // Evaluate rhs
    IVisitable* rhsNode = node.operands.get(1l);
    const QualType rhsSTy = this.getEvaluatedType(rhsNode);
    LLVMExprResult rhs = this.visitExpr(rhsNode);

    // Retrieve the result value, based on the exact operator
    ASTNode* baseNode = cast<ASTNode*>(node);
    switch node.op {
        case RelationalOp::OP_LESS: { res = this.conversionManager.getLessInst(baseNode, res, lhsSTy, rhs, rhsSTy); }
        case RelationalOp::OP_GREATER: { res = this.conversionManager.getGreaterInst(baseNode, res, lhsSTy, rhs, rhsSTy); }
        case RelationalOp::OP_LESS_EQUAL: { res = this.conversionManager.getLessEqualInst(baseNode, res, lhsSTy, rhs, rhsSTy); }
        case RelationalOp::OP_GREATER_EQUAL: { res = this.conversionManager.getGreaterEqualInst(baseNode, res, lhsSTy, rhs, rhsSTy); }
        default: { panic(Error("EqualityExpr fall-through")); } // LCOV_EXCL_LINE
    }

    // Return the result
    return exprResultAny(res);
}

public f<Any> IRGenerator.visitShiftExpr(ASTShiftExprNode* node) {
    // Check if only one operand is present -> loop through
    if node.operands.getSize() == 1l {
        return this.visit(node.operands.front());
    }

    this.diGenerator.setSourceLocation(cast<ASTNode*>(node));

    // It is a shift expression
    // Evaluate first operand
    IVisitable* lhsNode = node.operands.front();
    QualType lhsSTy = this.getEvaluatedType(lhsNode);
    LLVMExprResult lhs = this.visitExpr(lhsNode);

    ASTNode* baseNode = cast<ASTNode*>(node);
    ShiftOpQueue opQueue = node.opQueue;
    unsigned long operandIndex = 1l;
    while !opQueue.isEmpty() {
        const unsigned long operatorIndex = operandIndex - 1l;
        // Evaluate next operand
        IVisitable* rhsNode = node.operands.get(operandIndex);
        operandIndex++;
        assert rhsNode != nil<IVisitable*>;
        const QualType rhsSTy = this.getEvaluatedType(rhsNode);
        LLVMExprResult rhs = this.visitExpr(rhsNode);

        // Retrieve the result, based on the exact operator
        const Pair<ShiftOp, QualType>& opPair = opQueue.front();
        const ShiftOp currentOp = opPair.getFirst();
        switch currentOp {
            case ShiftOp::OP_SHIFT_LEFT: { lhs = this.conversionManager.getShiftLeftInst(baseNode, lhs, lhsSTy, rhs, rhsSTy, operatorIndex); }
            case ShiftOp::OP_SHIFT_RIGHT: { lhs = this.conversionManager.getShiftRightInst(baseNode, lhs, lhsSTy, rhs, rhsSTy, operatorIndex); }
            default: { panic(Error("AdditiveExpr fall-through")); } // LCOV_EXCL_LINE
        }

        // Retrieve the new lhs symbol type
        lhsSTy = opPair.getSecond();

        opQueue.pop();
    }

    // Return the result
    return exprResultAny(lhs);
}

public f<Any> IRGenerator.visitAdditiveExpr(ASTAdditiveExprNode* node) {
    // Check if only one operand is present -> loop through
    if node.operands.getSize() == 1l {
        return this.visit(node.operands.front());
    }

    this.diGenerator.setSourceLocation(cast<ASTNode*>(node));

    // It is an additive expression
    // Evaluate first operand
    IVisitable* lhsNode = node.operands.get(0l);
    QualType lhsSTy = this.getEvaluatedType(lhsNode);
    LLVMExprResult lhs = this.visitExpr(lhsNode);

    ASTNode* baseNode = cast<ASTNode*>(node);
    AdditiveOpQueue opQueue = node.opQueue;
    unsigned long operandIndex = 1l;
    while !opQueue.isEmpty() {
        const unsigned long operatorIndex = operandIndex - 1l;
        // Evaluate next operand
        IVisitable* rhsNode = node.operands.get(operandIndex);
        operandIndex++;
        assert rhsNode != nil<IVisitable*>;
        const QualType rhsSTy = this.getEvaluatedType(rhsNode);
        LLVMExprResult rhs = this.visitExpr(rhsNode);

        // Retrieve the result, based on the exact operator
        const Pair<AdditiveOp, QualType>& opPair = opQueue.front();
        const AdditiveOp currentOp = opPair.getFirst();
        switch currentOp {
            case AdditiveOp::OP_PLUS: { lhs = this.conversionManager.getPlusInst(baseNode, lhs, lhsSTy, rhs, rhsSTy, operatorIndex); }
            case AdditiveOp::OP_MINUS: { lhs = this.conversionManager.getMinusInst(baseNode, lhs, lhsSTy, rhs, rhsSTy, operatorIndex); }
            default: { panic(Error("AdditiveExpr fall-through")); } // LCOV_EXCL_LINE
        }

        // Retrieve the new lhs symbol type
        lhsSTy = opPair.getSecond();

        opQueue.pop();
    }

    // Return the result
    return exprResultAny(lhs);
}

public f<Any> IRGenerator.visitMultiplicativeExpr(ASTMultiplicativeExprNode* node) {
    // Check if only one operand is present -> loop through
    if node.operands.getSize() == 1l {
        return this.visit(node.operands.front());
    }

    this.diGenerator.setSourceLocation(cast<ASTNode*>(node));

    // It is an additive expression
    // Evaluate first operand
    IVisitable* lhsNode = node.operands.get(0l);
    QualType lhsSTy = this.getEvaluatedType(lhsNode);
    LLVMExprResult res = this.visitExpr(lhsNode);

    ASTNode* baseNode = cast<ASTNode*>(node);
    MultiplicativeOpQueue opQueue = node.opQueue;
    unsigned long operandIndex = 1l;
    while !opQueue.isEmpty() {
        const unsigned long operatorIndex = operandIndex - 1l;
        // Evaluate next operand
        IVisitable* rhsNode = node.operands.get(operandIndex);
        operandIndex++;
        assert rhsNode != nil<IVisitable*>;
        const QualType rhsSTy = this.getEvaluatedType(rhsNode);
        LLVMExprResult rhs = this.visitExpr(rhsNode);

        // Retrieve the result, based on the exact operator
        const Pair<MultiplicativeOp, QualType>& opPair = opQueue.front();
        const MultiplicativeOp currentOp = opPair.getFirst();
        switch currentOp {
            case MultiplicativeOp::OP_MUL: { res = this.conversionManager.getMulInst(baseNode, res, lhsSTy, rhs, rhsSTy, operatorIndex); }
            case MultiplicativeOp::OP_DIV: { res = this.conversionManager.getDivInst(baseNode, res, lhsSTy, rhs, rhsSTy, operatorIndex); }
            case MultiplicativeOp::OP_REM: { res = this.conversionManager.getRemInst(baseNode, res, lhsSTy, rhs, rhsSTy); }
            default: { panic(Error("MultiplicativeExpr fall-through")); } // LCOV_EXCL_LINE
        }

        // Retrieve the new lhs symbol type
        lhsSTy = opPair.getSecond();
        opQueue.pop();
    }

    // Return the result
    return exprResultAny(res);
}

public f<Any> IRGenerator.visitCastExpr(ASTCastExprNode* node) {
    // Check if only one operand is present -> loop through
    if !node.isCast {
        return this.visit(node.prefixUnaryExpr);
    }

    this.diGenerator.setSourceLocation(cast<ASTNode*>(node));

    // It is a cast expression
    // Retrieve target symbol type
    const QualType targetSTy = this.getEvaluatedType(cast<IVisitable*>(node));

    // Evaluate rhs
    IVisitable* rhsNode = node.assignExpr;
    const QualType rhsSTy = this.getEvaluatedType(rhsNode);
    LLVMExprResult rhs = this.visitExpr(rhsNode);

    // Retrieve the result value
    const LLVMExprResult res = this.conversionManager.getCastInst(cast<ASTNode*>(node), targetSTy, rhs, rhsSTy);

    // Return the result
    return exprResultAny(res);
}

public f<Any> IRGenerator.visitPrefixUnaryExpr(ASTPrefixUnaryExprNode* node) {
    // If no operator is applied, simply visit the atomic expression
    if node.op == PrefixUnaryOp::OP_NONE {
        return this.visit(node.postfixUnaryExpr);
    }

    this.diGenerator.setSourceLocation(cast<ASTNode*>(node));

    // Evaluate lhs
    IVisitable* lhsNode = node.prefixUnaryExpr;
    const QualType lhsSTy = this.getEvaluatedType(lhsNode);
    LLVMExprResult lhs = this.visitExpr(lhsNode);
    ASTNode* baseNode = cast<ASTNode*>(node);

    switch node.op {
        case PrefixUnaryOp::OP_MINUS: {
            // Execute operation
            lhs = this.conversionManager.getPrefixMinusInst(baseNode, lhs, lhsSTy);

            // This operator can not work in-place, so we need additional memory
            lhs.ptr = this.insertAlloca(lhs.value.getType());

            // Store the new value
            this.insertStore(lhs.value, lhs.ptr);
        }
        case PrefixUnaryOp::OP_PLUS_PLUS: {
            // Execute operation
            const LLVMExprResult res = this.conversionManager.getPrefixPlusPlusInst(baseNode, lhs, lhsSTy);
            lhs.value = res.value;

            // If this operation happens on a volatile variable, store the value directly
            if lhs.entry != nil<const SymbolTableEntry*> && lhs.entry.isVolatile {
                this.insertStore(lhs.value, lhs.ptr, true);
            }

            // Save to the existing address if possible, otherwise (e.g. for literals) allocate new space
            if lhs.ptr.isNull() {
                lhs.ptr = this.insertAlloca(lhs.value.getType());
            }

            // Store the new value
            this.insertStore(lhs.value, lhs.ptr);
        }
        case PrefixUnaryOp::OP_MINUS_MINUS: {
            // Execute operation
            const LLVMExprResult res = this.conversionManager.getPrefixMinusMinusInst(baseNode, lhs, lhsSTy);
            lhs.value = res.value;

            // If this operation happens on a volatile variable, store the value directly
            if lhs.entry != nil<const SymbolTableEntry*> && lhs.entry.isVolatile {
                this.insertStore(lhs.value, lhs.ptr, true);
            }

            // Save to the existing address if possible, otherwise (e.g. for literals) allocate new space
            if lhs.ptr.isNull() {
                lhs.ptr = this.insertAlloca(lhs.value.getType());
            }

            // Store the new value
            this.insertStore(lhs.value, lhs.ptr);
        }
        case PrefixUnaryOp::OP_NOT: {
            // Execute operation
            lhs = this.conversionManager.getPrefixNotInst(baseNode, lhs, lhsSTy);
        }
        case PrefixUnaryOp::OP_BITWISE_NOT: {
            // Execute operation
            lhs = this.conversionManager.getPrefixBitwiseNotInst(baseNode, lhs, lhsSTy);
        }
        case PrefixUnaryOp::OP_DEREFERENCE: {
            // If only .refPtr is filled, we can't simply rewire the fields, but need to actually perform a load.
            // For that we can use resolveValue().
            const bool onlyRefPtrIsFilled = lhs.value.isNull() && lhs.ptr.isNull();
            // Rewire the fields
            const llvm::Value newRefPtr = onlyRefPtrIsFilled ? this.resolveValue(lhsNode, lhs) : lhs.ptr;
            const llvm::Value newPtr = lhs.value;
            LLVMExprResult newLhs;
            newLhs.ptr = newPtr;
            newLhs.refPtr = newRefPtr;
            lhs = newLhs;
        }
        case PrefixUnaryOp::OP_ADDRESS_OF: {
            // If only .value is filled, we can't simply rewire the fields, but need to actually perform alloca + store.
            // For that we can use resolveAddress().
            const bool onlyValueIsFilled = lhs.ptr.isNull() && lhs.refPtr.isNull();
            // Rewire the fields
            const llvm::Value newValue = onlyValueIsFilled ? this.resolveAddress(lhs) : lhs.ptr;
            const llvm::Value newPtr = lhs.refPtr;
            LLVMExprResult newLhs;
            newLhs.value = newValue;
            newLhs.ptr = newPtr;
            lhs = newLhs;
        }
        default: {
            panic(Error("PrefixUnaryExpr fall-through")); // LCOV_EXCL_LINE
        }
    }

    return exprResultAny(lhs);
}

public f<Any> IRGenerator.visitPostfixUnaryExpr(ASTPostfixUnaryExprNode* node) {
    // If no operator is applied, simply visit the atomic expression
    if node.op == PostfixUnaryOp::OP_NONE {
        return this.visit(node.atomicExpr);
    }

    this.diGenerator.setSourceLocation(cast<ASTNode*>(node));

    // Evaluate lhs
    IVisitable* lhsNode = node.postfixUnaryExpr;
    QualType lhsSTy = this.getEvaluatedType(lhsNode);
    LLVMExprResult lhs = this.visitExpr(lhsNode);
    ASTNode* baseNode = cast<ASTNode*>(node);

    switch node.op {
        case PostfixUnaryOp::OP_SUBSCRIPT: {
            IVisitable* indexExpr = node.subscriptIndexExpr;

            // Check if we need to generate a call to an overloaded operator function
            if this.conversionManager.callsOverloadedOpFct(baseNode, 0l) {
                const Resolver lhsV = valueResolver(lhsSTy, &lhs);
                const Resolver lhsP = addressResolver(&lhs);
                const Resolver idxV = exprValueResolver(indexExpr);
                const Resolver idxP = exprAddressResolver(indexExpr);
                const OperandResolvers resolvers = OperandResolvers(lhsV, lhsP, idxV, idxP);
                lhs = this.conversionManager.callOperatorOverloadFct(baseNode, resolvers, 2l, 0l);
            } else {
                lhsSTy = lhsSTy.removeReferenceWrapper();

                // Get the index value
                const llvm::Value indexValue = this.resolveValue(indexExpr);
                // Come up with the address
                if lhsSTy.isArray() && cast<unsigned long>(lhsSTy.getArraySize()) != ARRAY_SIZE_UNKNOWN { // Array
                    // Make sure the address is present
                    this.resolveAddress(lhs);

                    // Calculate address of array item
                    const llvm::Type lhsTy = lhsSTy.toLLVMType(this.sourceFile);
                    Vector<llvm::Value> indices;
                    indices.pushBack(this.getInt64(0l));
                    indices.pushBack(indexValue);
                    lhs.ptr = this.insertInBoundsGEP(lhsTy, lhs.ptr, indices);
                } else { // Pointer
                    // Now the pointer is the value
                    lhs.ptr = this.resolveValue(lhsNode, lhs);

                    const QualType lhsContainedSTy = lhsSTy.getContained();
                    const llvm::Type lhsTy = lhsContainedSTy.toLLVMType(this.sourceFile);
                    // Calculate address of pointer item
                    lhs.ptr = this.insertInBoundsGEP(lhsTy, lhs.ptr, indexValue);
                }

                // Reset value and entry
                lhs.value = llvm::Value();
                lhs.entry = nil<const SymbolTableEntry*>;
            }
        }
        case PostfixUnaryOp::OP_MEMBER_ACCESS: {
            // Get the address of the struct/union instance
            this.resolveAddress(lhs);
            lhsSTy = lhsSTy.removeReferenceWrapper();

            // Auto de-reference pointer
            this.autoDeReferencePtr(lhs.ptr, lhsSTy);

            const String& fieldName = node.identifier;

            // Union field access is handled separately, since it is backed by a tagged { i32 tag, ..., payload } layout
            // instead of one LLVM struct member per Spice field (see Type::toLLVMType's TY_UNION branch), and needs a
            // runtime tag read-guard/write-update around the payload access.
            if lhsSTy.is(SuperType::TY_UNION) {
                this.generateUnionFieldAccess(node, lhs, lhsSTy, fieldName);
            } else {
                assert lhsSTy.is(SuperType::TY_STRUCT);

                // Retrieve struct
                Struct* spiceStruct = lhsSTy.getStruct(cast<ASTNode*>(node));
                assert spiceStruct != nil<Struct*>;

                // Retrieve field entry
                Vector<unsigned long> indexPath;
                lhs.entry = spiceStruct.lookupInComposedFields(fieldName, indexPath);
                assert lhs.entry != nil<const SymbolTableEntry*>;
                const QualType fieldSymbolType = lhs.entry.getQualType();

                // Get address of the field in the struct instance
                Vector<llvm::Value> indices;
                indices.pushBack(this.getInt64(0l));
                foreach const unsigned long index : indexPath {
                    indices.pushBack(this.getInt32(cast<long>(index)));
                }
                const String name = fieldName + ".addr";
                const llvm::Value memberAddr = this.insertInBoundsGEP(lhsSTy.toLLVMType(this.sourceFile), lhs.ptr, indices, name);

                // Set as ptr or refPtr, depending on the type
                if fieldSymbolType.isRef() {
                    lhs.ptr = llvm::Value();
                    lhs.refPtr = memberAddr;
                } else {
                    lhs.ptr = memberAddr;
                    lhs.refPtr = llvm::Value();
                }

                // Reset the value
                lhs.value = llvm::Value();
            }
        }
        case PostfixUnaryOp::OP_PLUS_PLUS: {
            // Make sure a value is present
            this.resolveValue(lhsNode, lhs);

            // Allocate new local variable if required
            if lhs.ptr.isNull() {
                assert !lhs.value.isNull();
                lhs.ptr = this.insertAlloca(lhs.value.getType());
            }

            // Execute operation
            const LLVMExprResult res = this.conversionManager.getPostfixPlusPlusInst(baseNode, lhs, lhsSTy);

            // Save the new value to the old address
            if this.conversionManager.callsOverloadedOpFct(baseNode, 0l) {
                lhs.value = res.value;
                lhs.ptr = res.ptr;
            } else {
                this.insertStore(res.value, lhs.ptr, lhs.entry != nil<const SymbolTableEntry*> && lhs.entry.isVolatile);
                lhs.ptr = llvm::Value();
            }
        }
        case PostfixUnaryOp::OP_MINUS_MINUS: {
            // Make sure a value is present
            this.resolveValue(lhsNode, lhs);

            // Allocate new local variable if required
            if lhs.ptr.isNull() {
                assert !lhs.value.isNull();
                lhs.ptr = this.insertAlloca(lhs.value.getType());
            }

            // Execute operation
            const LLVMExprResult res = this.conversionManager.getPostfixMinusMinusInst(baseNode, lhs, lhsSTy);

            // Save the new value to the old address
            if this.conversionManager.callsOverloadedOpFct(baseNode, 0l) {
                lhs.value = res.value;
                lhs.ptr = res.ptr;
            } else {
                this.insertStore(res.value, lhs.ptr, lhs.entry != nil<const SymbolTableEntry*> && lhs.entry.isVolatile);
                lhs.ptr = llvm::Value();
            }
        }
        case PostfixUnaryOp::OP_ERR_PROPAGATION: {
            lhs = this.generateErrorPropagation(node, lhs);
        }
        default: {
            panic(Error("PostfixUnaryExpr fall-through")); // LCOV_EXCL_LINE
        }
    }

    return exprResultAny(lhs);
}

// Union branch of the member access in visitPostfixUnaryExpr
p IRGenerator.generateUnionFieldAccess(ASTPostfixUnaryExprNode* node, LLVMExprResult& lhs, const QualType& lhsSTy, const String& fieldName) {
    Scope* unionScope = lhsSTy.getBodyScope();
    const SymbolTableEntry* fieldEntry = unionScope.symbolTable.lookupStrict(fieldName);
    assert fieldEntry != nil<const SymbolTableEntry*>;
    const QualType fieldSymbolType = fieldEntry.getQualType();
    // Tag 0 is reserved for the "unset" state, so a field's tag is its order index shifted up by one. This makes
    // an all-zero union (e.g. from .bss, a generic memset, or a nested aggregate's zero default) correctly unset
    // rather than aliasing field 0, so the tag-mismatch guard below also catches accidental zero-initialization.
    const long fieldTagIndex = cast<long>(fieldEntry.orderIndex) + 1l;

    const llvm::Type unionLLVMTy = lhsSTy.toLLVMType(this.sourceFile);
    const llvm::Value unionBasePtr = lhs.ptr;
    const llvm::Value tagAddr = this.insertStructGEP(unionLLVMTy, unionBasePtr, 0, String("tag.addr"));

    // A plain `u.field = value` assignment is the only access that should update the tag instead of checking it:
    // it is the sole case where this exact node is the direct, unwrapped left-hand side of a plain '=' assignment.
    // Every other use (reads, compound-assign's read-then-store-back, address-of, pass-by-ref, or descending
    // further into a by-value struct/union field) must first prove the field is currently active.
    bool isDirectAssignTarget = false;
    const ASTNode* parent = node.parent;
    if parent != nil<const ASTNode*> && parent.kind == ASTNodeKind::ASSIGN_EXPR {
        const ASTAssignExprNode* assignParent = downcast<ASTAssignExprNode>(parent);
        isDirectAssignTarget = assignParent.lhs != nil<IVisitable*> && getASTNode(assignParent.lhs) == cast<ASTNode*>(node) && assignParent.op == AssignOp::OP_ASSIGN;
    }

    if isDirectAssignTarget {
        this.insertStore(this.getInt32(fieldTagIndex), tagAddr);
    } else {
        // Guard the read with a runtime tag check. This is an always-on safety check (unlike e.g. the assert
        // statement, which is skipped in release builds), since it protects a core invariant of the union type
        // itself, not an optional user-level debug assertion.
        const llvm::Value tagValue = this.insertLoad(this.builder.getInt32Ty(), tagAddr);
        const llvm::Value tagMatches = this.builder.createICmp(llvm::LLVMIntPredicate::EQ, tagValue, this.getInt32(fieldTagIndex));

        const String codeLine = node.codeLoc.toPrettyLine();
        const llvm::BasicBlock bOk = this.createBlock("union.tag.ok." + codeLine);
        const llvm::BasicBlock bPanic = this.createBlock("union.tag.panic." + codeLine);
        this.insertCondJump(tagMatches, bOk, bPanic, Likelihood::LIKELY);

        this.switchToBlock(bPanic);
        const llvm::Value stdErrValue = this.getStdErrValue();
        const String errorMsg = "Program panicked at " + node.codeLoc.toPrettyString() + ": active field mismatch on union field access '" + fieldName + "'\n";
        const String globalName = this.getUnusedGlobalName(String(ANON_GLOBAL_STRING_NAME));
        llvm::Value globalString = this.module.createGlobalString(errorMsg, globalName.getRaw());
        if this.cliOptions.comparableOutput {
            globalString.setAlignment(4);
        }
        Vector<llvm::Value> fprintfArgs;
        fprintfArgs.pushBack(stdErrValue);
        fprintfArgs.pushBack(globalString);
        this.builder.createCall(this.stdFunctionManager.getFPrintfFct(), fprintfArgs);
        if this.cliOptions.printsStackTraceOnAbort() {
            Vector<llvm::Value> dumpArgs;
            dumpArgs.pushBack(this.builder.getTrue());
            dumpArgs.pushBack(this.builder.getFalse());
            this.builder.createCall(this.stdFunctionManager.getDumpStacktraceFct(), dumpArgs);
        }
        Vector<llvm::Value> exitArgs;
        exitArgs.pushBack(this.getInt32(cast<long>(EXIT_FAILURE)));
        this.builder.createCall(this.stdFunctionManager.getExitFct(), exitArgs);
        this.builder.createUnreachable();

        this.switchToBlock(bOk);
    }

    // Get address of the payload (index 2: { tag, alignPad, payload })
    const llvm::Value memberAddr = this.insertStructGEP(unionLLVMTy, unionBasePtr, 2, fieldName + ".addr");

    // Set as ptr or refPtr, depending on the type
    if fieldSymbolType.isRef() {
        lhs.ptr = llvm::Value();
        lhs.refPtr = memberAddr;
    } else {
        lhs.ptr = memberAddr;
        lhs.refPtr = llvm::Value();
    }

    lhs.entry = fieldEntry;
    lhs.value = llvm::Value();
}

// Error propagation branch of visitPostfixUnaryExpr
f<LLVMExprResult> IRGenerator.generateErrorPropagation(ASTPostfixUnaryExprNode* node, LLVMExprResult& lhs) {
    // Get the address of the Result<T> operand
    const llvm::Value operandPtr = this.resolveAddress(lhs);
    Vector<llvm::Value> operandArgs;
    operandArgs.pushBack(operandPtr);

    // Call isErr() on the operand
    assert node.errPropIsErrFct != nil<const model::Function*>;
    const llvm::Function isErrFct = this.stdFunctionManager.getResultIsErrFct(node.errPropIsErrFct);
    const llvm::Value isErr = this.builder.createCall(isErrFct, operandArgs);

    // Create blocks
    const String codeLine = node.codeLoc.toPrettyLine();
    const llvm::BasicBlock bThen = this.createBlock("err.prop.then." + codeLine);
    const llvm::BasicBlock bExit = this.createBlock("err.prop.exit." + codeLine);
    this.insertCondJump(isErr, bThen, bExit, Likelihood::UNLIKELY);

    // Switch to then block: propagate the error as the enclosing function's Result<U>
    this.switchToBlock(bThen);
    assert node.errPropGetErrFct != nil<const model::Function*> && node.errPropCtorFct != nil<const model::Function*>;
    const llvm::Function getErrFct = this.stdFunctionManager.getResultGetErrFct(node.errPropGetErrFct);
    const llvm::Value errorPtr = this.builder.createCall(getErrFct, operandArgs);
    const llvm::Function errCtorFct = this.stdFunctionManager.getResultErrCtorFct(node.errPropCtorFct);
    Vector<llvm::Value> errCtorArgs;
    errCtorArgs.pushBack(errorPtr);
    // If the enclosing function returns via memory, construct the result directly in the memory of its caller
    const QualType& propagatedResultType = node.errPropCtorFct.returnType;
    const llvm::BasicBlock currentBlock = this.builder.getInsertBlock();
    const llvm::Value sretArg = getSRetArg(currentBlock.getParent());
    llvm::Value propagatedResultAddr;
    llvm::Value propagatedResult = this.insertCall(errCtorFct, errCtorArgs, propagatedResultType, propagatedResultAddr, sretArg);
    if !sretArg.isNull() && propagatedResultAddr.isSameAs(sretArg) {
        propagatedResult = llvm::Value();
    } else if !propagatedResultAddr.isNull() {
        propagatedResult = this.insertLoad(propagatedResultType, propagatedResultAddr);
    }

    // Record this propagation hop in the error return trace, if tracing is enabled for this file
    if this.sourceFile.errorReturnTracing {
        this.generateErrTraceCall(this.stdFunctionManager.getErrTracePushFct(), cast<ASTNode*>(node), "errtrace.hop.sig.", "errtrace.hop.file.");
    }

    // Clean up all scopes between here and the enclosing function/procedure/lambda body, then return the error
    this.generateScopeCleanupUpTo(cast<ASTNode*>(node), this.currentScope.getFunctionScope());
    this.blockAlreadyTerminated = true;
    this.insertReturn(propagatedResult);

    // Switch to exit block: unwrap the payload, which becomes the value of the whole expression
    this.switchToBlock(bExit);
    assert node.errPropUnwrapFct != nil<const model::Function*>;
    const llvm::Function unwrapFct = this.stdFunctionManager.getResultUnwrapFct(node.errPropUnwrapFct);
    const llvm::Value unwrapped = this.builder.createCall(unwrapFct, operandArgs);
    return exprResultWithPtr(unwrapped);
}

// Generate a call to an error return trace function with the signature and location of the given node
p IRGenerator.generateErrTraceCall(llvm::Function traceFct, ASTNode* node, string sigBaseName, string fileBaseName) {
    const String enclosingSignature = node.getEnclosingFunctionSignature(this.manIdx);
    const llvm::Value signature = this.createGlobalStringConst(String(sigBaseName), enclosingSignature, node.codeLoc);
    const llvm::Value fileName = this.createGlobalStringConst(String(fileBaseName), node.codeLoc.toPrettyFilePath(), node.codeLoc);
    const llvm::Value line = this.getInt32(cast<long>(node.codeLoc.line));
    const llvm::Value column = this.getInt32(cast<long>(node.codeLoc.col));
    Vector<llvm::Value> args;
    args.pushBack(signature);
    args.pushBack(fileName);
    args.pushBack(line);
    args.pushBack(column);
    this.builder.createCall(traceFct, args);
}

public f<Any> IRGenerator.visitAtomicExpr(ASTAtomicExprNode* node) {
    // If constant
    if node.constant != nil<ASTConstantNode*> {
        const llvm::Value constantValue = this.visitConst(cast<IVisitable*>(node.constant));
        return exprResultAny(exprResultWithConstant(constantValue));
    }

    // If value
    if node.value != nil<IVisitable*> {
        return this.visit(node.value);
    }

    // Is assign expression
    if node.assignExpr != nil<IVisitable*> {
        return this.visit(node.assignExpr);
    }

    this.diGenerator.setSourceLocation(cast<ASTNode*>(node));

    // Identifier (local or global variable access)
    assert !node.identifierFragments.isEmpty();

    // Get symbol table entry
    const VarAccessData& accessData = node.data.get(this.manIdx);
    const SymbolTableEntry* entry = accessData.entry;
    Scope* accessScope = accessData.accessScope;
    const Capture* capture = accessData.capture;
    assert entry != nil<const SymbolTableEntry*>;
    assert accessScope != nil<Scope*>;
    const QualType varSymbolType = entry.getQualType();
    const llvm::Type varType = varSymbolType.toLLVMType(this.sourceFile);

    // Check if external global variable
    if entry.global && accessScope.isImportedBy(this.rootScope) {
        // External global variables need to be declared and allocated in the current module
        const llvm::Value varAddress = this.module.getOrInsertGlobal(entry.name.getRaw(), varType);
        this.updateAddress(entry, varAddress);
    }

    // Check if enum item
    if accessScope.scopeType == ScopeType::ENUM {
        const ASTEnumItemNode* itemNode = downcast<ASTEnumItemNode>(entry.declNode);
        const llvm::Value constantItemValue = llvm::getConstInt(varType, cast<unsigned long>(itemNode.itemValue));
        LLVMExprResult res;
        res.constant = constantItemValue;
        res.entry = entry;
        return exprResultAny(res);
    }

    const llvm::Value address = this.getAddress(entry);
    assert !address.isNull();

    // If this is a function/procedure reference, return it as value. The fat pointer must point at a thunk that
    // carries the (ignored) leading capture-struct pointer, so it can be called through the uniform lambda ABI.
    if entry.global && (varSymbolType.is(SuperType::TY_FUNCTION) || varSymbolType.is(SuperType::TY_PROCEDURE)) {
        const llvm::Function thunk = this.getOrCreateFatFctPtrThunk(address.asFunction());
        const llvm::Value fatPtr = this.buildFatFctPtr(nil<Scope*>, llvm::Type(), thunk.asValue());
        LLVMExprResult res;
        res.ptr = fatPtr;
        res.entry = entry;
        return exprResultAny(res);
    }

    // Load the address of the referenced variable
    LLVMExprResult res;
    res.entry = entry;
    if varSymbolType.isRef() || (capture != nil<const Capture*> && capture.getMode() == CapturePassMode::BY_REFERENCE) {
        res.refPtr = address;
        return exprResultAny(res);
    }

    res.ptr = address;
    return exprResultAny(res);
}

// =========================================================== Values ============================================================

public f<Any> IRGenerator.visitValue(ASTValueNode* node) {
    this.diGenerator.setSourceLocation(cast<ASTNode*>(node));

    // Function call
    if node.fctCall != nil<IVisitable*> {
        return this.visit(node.fctCall);
    }

    // Array initialization
    if node.arrayInitialization != nil<IVisitable*> {
        return this.visit(node.arrayInitialization);
    }

    // Struct instantiation
    if node.structInstantiation != nil<IVisitable*> {
        return this.visit(node.structInstantiation);
    }

    // Lambda function
    if node.lambdaFunc != nil<IVisitable*> {
        return this.visit(node.lambdaFunc);
    }

    // Lambda procedure
    if node.lambdaProc != nil<IVisitable*> {
        return this.visit(node.lambdaProc);
    }

    // Lambda expression
    if node.lambdaExpr != nil<IVisitable*> {
        return this.visit(node.lambdaExpr);
    }

    if node.isNil {
        // Retrieve type of the nil constant
        const llvm::Type nilType = this.visitType(cast<IVisitable*>(node.nilType));
        // Create constant nil value
        const llvm::Value nilValue = llvm::getNullValue(nilType);
        // Return it
        return exprResultAny(exprResultWithConstant(nilValue));
    }

    panic(Error("Value fall-through")); // LCOV_EXCL_LINE
}

public f<Any> IRGenerator.visitConstant(ASTConstantNode* node) {
    if this.currentScope != this.rootScope {
        this.diGenerator.setSourceLocation(cast<ASTNode*>(node));
    }
    ASTNode* baseNode = cast<ASTNode*>(node);
    const CompileTimeValue compileTimeValue = baseNode.getCompileTimeValue(this.manIdx);
    const QualType evaluatedType = this.getEvaluatedType(cast<IVisitable*>(node));
    return Any(this.getConst(compileTimeValue, evaluatedType, baseNode));
}

// Check if an argument of the given type matches the expected parameter type
f<bool> matchArgType(const QualType& origExpectedTy, const QualType& origActualTy) {
    if origExpectedTy.matches(origActualTy, false, true, true) {
        return true;
    }

    // Unwrap as far as possible and remove reference wrappers if possible
    QualType expectedTy = origExpectedTy;
    QualType actualTy = origActualTy;
    unwrapBoth(expectedTy, actualTy);
    return expectedTy.matchesInterfaceImplementedByStruct(actualTy);
}

public f<Any> IRGenerator.visitFctCall(ASTFctCallNode* node) {
    // Check if this is a builtin call
    if isBuiltinFunction(node.fqFunctionName) {
        return this.visitBuiltinCall(node);
    }

    const FctCallData& data = node.data.get(this.manIdx);

    const model::Function* spiceFunc = data.callee;
    assert data.isFctPtrCall() || spiceFunc != nil<const model::Function*>; // If not a function pointer call, we must have a function
    String mangledName;
    if !data.isFctPtrCall() {
        mangledName = spiceFunc.getMangledName();
    }

    // Get entry of the first fragment
    const SymbolTableEntry* firstFragEntry = this.currentScope.lookup(node.functionNameFragments.front());

    // Get this type
    Vector<llvm::Value> argValues;
    llvm::Value thisPtr;
    if data.isMethodCall() {
        assert !data.isCtorCall();

        // Retrieve entry of the first fragment
        assert firstFragEntry != nil<const SymbolTableEntry*>;
        const QualType& firstFragQualType = firstFragEntry.getQualType();
        const QualType baseType = firstFragQualType.getBase();
        assert baseType.is(SuperType::TY_STRUCT) || baseType.is(SuperType::TY_INTERFACE);
        QualType structType = baseType;

        // Get address of the referenced variable / struct instance
        thisPtr = this.getAddress(firstFragEntry);
        assert !thisPtr.isNull();

        // Auto de-reference 'this' pointer
        QualType firstFragmentType = firstFragEntry.getQualType();
        this.autoDeReferencePtr(thisPtr, firstFragmentType);
        llvm::Type structTy = baseType.toLLVMType(this.sourceFile);

        // Traverse through structs - the first fragment is already looked up and the last one is the function name
        for unsigned long i = 1l; i < node.functionNameFragments.getSize() - 1l; i++ {
            const String& identifier = node.functionNameFragments.get(i);
            // Retrieve field entry, also looking through composed fields
            Struct* spiceStruct = structType.getStruct(cast<ASTNode*>(node));
            assert spiceStruct != nil<Struct*>;
            Vector<unsigned long> indexPath;
            const SymbolTableEntry* fieldEntry = spiceStruct.lookupInComposedFields(identifier, indexPath);
            assert fieldEntry != nil<const SymbolTableEntry*>;
            QualType fieldEntryType = fieldEntry.getQualType();
            const QualType fieldBaseType = fieldEntryType.getBase();
            assert fieldBaseType.is(SuperType::TY_STRUCT) || fieldBaseType.is(SuperType::TY_INTERFACE);
            // Get struct type
            structType = fieldBaseType;
            // Get address of field. If the field was found directly (no composition involved), keep using the
            // single-index helper, since it elides the GEP entirely for fields at offset 0. Otherwise, step through
            // all composed fields on the way in a single GEP.
            if indexPath.getSize() == 1l {
                thisPtr = this.insertStructGEP(structTy, thisPtr, cast<unsigned int>(indexPath.front()));
            } else {
                Vector<llvm::Value> indices;
                indices.pushBack(this.getInt64(0l));
                foreach const unsigned long index : indexPath {
                    indices.pushBack(this.getInt32(cast<long>(index)));
                }
                thisPtr = this.insertInBoundsGEP(structTy, thisPtr, indices);
            }
            // Auto de-reference pointer and get new struct type
            this.autoDeReferencePtr(thisPtr, fieldEntryType);
            const QualType newBaseType = fieldEntryType.getBase();
            structTy = newBaseType.toLLVMType(this.sourceFile);
        }

        // Methods, that are inherited from an interface default method, expect a pointer to the interface part of the struct
        if spiceFunc != nil<const model::Function*> && spiceFunc.isInheritedDefaultMethod() {
            thisPtr = this.getUpcastedStructPtr(thisPtr, spiceFunc.defaultMethod.thisType, structType);
        }

        // Add 'this' pointer to the front of the argument list
        argValues.pushBack(thisPtr);
    }

    if data.isCtorCall() {
        assert !data.isMethodCall();

        const llvm::Type thisType = spiceFunc.thisType.toLLVMType(this.sourceFile);
        thisPtr = this.insertAlloca(thisType);

        // Add 'this' pointer to the front of the argument list
        argValues.pushBack(thisPtr);
    }

    // Every callable behind a fat function pointer uses the same calling convention: the capture-struct pointer
    // (fat ptr slot 1) is always passed as the trailing argument, after all real arguments, regardless of whether the
    // target actually captures. Non-capturing lambdas and plain function references ignore it. Passing captures last
    // (instead of first) keeps fat ptr slot 0 directly callable through a plain C calling convention, so a Spice
    // function or lambda cast to a raw pointer can be handed to a C API as a callback without shifting its arguments.
    llvm::Value fctPtr;

    // Get arg values
    if node.hasArgs {
        const Vector<IVisitable*>& args = node.argLst.args;
        argValues.reserve(args.getSize());
        QualTypeList paramSTypes;
        if data.isFctPtrCall() {
            const QualType& firstFragQualType = firstFragEntry.getQualType();
            const QualType firstFragBaseType = firstFragQualType.getBase();
            paramSTypes = firstFragBaseType.getFunctionParamTypes();
        } else {
            paramSTypes = spiceFunc.getParamTypes();
        }
        assert paramSTypes.getSize() == args.getSize();
        for unsigned long i = 0l; i < args.getSize(); i++ {
            IVisitable* argNode = args.get(i);
            const ArgInfo& argInfo = node.argLst.argInfos.get(i);
            const model::Function* copyCtor = argInfo.copyCtor;

            const QualType& expectedSTy = paramSTypes.get(i);
            const QualType actualSTy = this.getEvaluatedType(argNode);

            if matchArgType(expectedSTy, actualSTy) {
                // Resolve address if actual type is reference or a decaying array, otherwise value
                if actualSTy.isRef() || expectedSTy.isDecayedArray() {
                    argValues.pushBack(this.resolveAddress(argNode));
                } else if copyCtor != nil<const model::Function*> {
                    assert !actualSTy.isTriviallyCopyable(cast<ASTNode*>(node));
                    const llvm::Value originalPtr = this.resolveAddress(argNode);

                    // Generate copy ctor call
                    const llvm::Type valueType = actualSTy.toLLVMType(this.sourceFile);
                    const llvm::Value valueCopyPtr = this.insertAlloca(valueType, String("arg.copy"));
                    Vector<llvm::Value> ctorArgs;
                    ctorArgs.pushBack(originalPtr);
                    this.generateCtorOrDtorCall(valueCopyPtr, copyCtor, ctorArgs);
                    const llvm::Value newValue = this.insertLoad(valueType, valueCopyPtr);

                    // Attach address of copy to anonymous symbol
                    const SymbolTableEntry* anonymousSymbol = this.currentScope.symbolTable.lookupAnonymous(getASTNode(argNode), SIZE_MAX);
                    this.updateAddress(anonymousSymbol, valueCopyPtr);

                    argValues.pushBack(newValue);
                } else {
                    argValues.pushBack(this.resolveValue(argNode));
                }
            } else if expectedSTy.isRef() && matchArgType(expectedSTy.getContained(), actualSTy) { // Matches with ref
                const llvm::Value argAddress = this.resolveAddress(argNode);
                argValues.pushBack(argAddress);
            } else if actualSTy.isRef() && matchArgType(expectedSTy, actualSTy.getContained()) { // Matches with ref
                const llvm::Value argAddress = this.resolveValue(argNode);
                argValues.pushBack(argAddress);
            } else { // Need implicit cast
                const llvm::Value argAddress = this.resolveAddress(argNode);
                argValues.pushBack(this.doImplicitCast(argAddress, expectedSTy, actualSTy));
            }

            // Decayed array params expect the address of a writable array, which not all of the paths above produce
            if expectedSTy.isDecayedArray() {
                llvm::Value& argValue = argValues.back();
                argValue = this.materializeDecayedArrayArg(argValue, expectedSTy);
            }
        }
    }

    // Append the trailing capture-struct pointer for fat function pointer calls (see the ABI note above)
    if data.isFctPtrCall() {
        llvm::Value fatPtr = this.getAddress(firstFragEntry);
        // The fat pointer might be reached via pointers or references (e.g. a param of type f<int>()** or f<int>()&)
        QualType fatPtrType = firstFragEntry.getQualType();
        this.autoDeReferencePtr(fatPtr, fatPtrType);
        // Remember the address of the function pointer slot for the call below
        fctPtr = this.insertStructGEP(this.llvmTypes.lambdaFatPtrType, fatPtr, 0);
        // Load the captures pointer and add it to the argument list as the trailing argument
        const llvm::Value capturesPtrPtr = this.insertStructGEP(this.llvmTypes.lambdaFatPtrType, fatPtr, 1);
        const llvm::Value capturesPtr = this.insertLoad(this.builder.getPtrTy(), capturesPtrPtr, false, String(CAPTURES_PARAM_NAME));
        argValues.pushBack(capturesPtr);
    }

    // Retrieve return and param types
    QualType returnSType = QualType(SuperType::TY_DYN);
    QualTypeList paramSTypes;
    if data.isFctPtrCall() {
        const QualType& firstFragQualType = firstFragEntry.getQualType();
        const QualType firstFragBaseType = firstFragQualType.getBase();
        if firstFragQualType.isBase(SuperType::TY_FUNCTION) {
            returnSType = firstFragBaseType.getFunctionReturnType();
        }
        paramSTypes = firstFragBaseType.getFunctionParamTypes();
    } else {
        returnSType = spiceFunc.returnType;
        paramSTypes = spiceFunc.getParamTypes();
    }

    // Function is not defined in the current module -> declare it
    llvm::Type fctType;
    const llvm::Function existingFct = this.module.getFunction(mangledName.getRaw());
    if !data.isFctPtrCall() && !existingFct.isNull() {
        fctType = existingFct.getFunctionType();
    } else {
        // Get arg types
        Vector<llvm::Type> argTypes;
        if data.isMethodCall() || data.isCtorCall() {
            argTypes.pushBack(this.builder.getPtrTy()); // This pointer
        }
        foreach const QualType& paramType : paramSTypes {
            argTypes.pushBack(paramType.getParamLLVMType(this.sourceFile));
        }
        if data.isFctPtrCall() {
            argTypes.pushBack(this.builder.getPtrTy()); // Trailing capture pointer (always present in the uniform lambda ABI)
        }

        fctType = this.getFunctionType(returnSType, argTypes);
        if !data.isFctPtrCall() && !data.isVirtualMethodCall() {
            this.module.getOrInsertFunction(mangledName.getRaw(), fctType);
            const ReturnABIInfo returnABI = this.getReturnABIInfo(returnSType);
            if returnABI.isIndirect() {
                this.addSRetParamAttrs(this.module.getFunction(mangledName.getRaw()), returnABI.memoryType);
            }
        }
    }
    assert !fctType.isNull();

    // Retrieve the callee
    llvm::Value callee;
    if data.isVirtualMethodCall() {
        assert data.callee.isVirtual;
        assert !thisPtr.isNull();
        // Load VTable
        const llvm::Value vtablePtr = this.insertLoad(this.builder.getPtrTy(), thisPtr, false, String("vtable.addr"));
        const unsigned long vtableIndex = data.callee.vtableIndex;
        // Lookup function pointer in VTable
        fctPtr = this.insertInBoundsGEP(this.builder.getPtrTy(), vtablePtr, this.builder.getInt64(vtableIndex), String("vfct.addr"));
        callee = this.insertLoad(this.builder.getPtrTy(), fctPtr, false, String("fct"));
    } else if data.isFctPtrCall() {
        assert !fctPtr.isNull(); // Already dereferenced above, where the captures pointer is loaded
        callee = this.insertLoad(this.builder.getPtrTy(), fctPtr, false, String("fct"));
    } else {
        // Get callee function
        const llvm::Function calleeFct = this.module.getFunction(mangledName.getRaw());
        assert !calleeFct.isNull();
        callee = calleeFct.asValue();
    }

    // Generate function call. If the value is returned via memory or coerced, the call result lives in memory
    llvm::Value resultAddr;
    const llvm::Value callInst = this.insertCall(fctType, callee, argValues, returnSType, resultAddr);

    // Set argument and return value attributes
    if !data.isFctPtrCall() {
        this.setCallArgAttrs(callInst, spiceFunc, paramSTypes, this.getArgOffset(returnSType));
        this.setCallReturnValAttrs(callInst, returnSType);
    }

    // Start a fresh error return trace at this call site, since it is where a new error was just put into existence
    if node.isErrorTraceOrigin {
        this.generateErrTraceCall(this.stdFunctionManager.getErrTraceResetFct(), cast<ASTNode*>(node), "errtrace.origin.sig.", "errtrace.origin.file.");
    }

    // Attach address to anonymous symbol to keep track of de-allocation
    const SymbolTableEntry* anonymousSymbol = nil<const SymbolTableEntry*>;
    llvm::Value resultPtr;
    if returnSType.is(SuperType::TY_STRUCT) || data.isCtorCall() {
        anonymousSymbol = this.currentScope.symbolTable.lookupAnonymous(cast<ASTNode*>(node));
        if anonymousSymbol != nil<const SymbolTableEntry*> {
            if data.isCtorCall() {
                this.updateAddress(anonymousSymbol, thisPtr);
            } else {
                resultPtr = resultAddr;
                if resultPtr.isNull() {
                    resultPtr = this.insertAlloca(callInst.getType());
                    this.insertStore(callInst, resultPtr);
                }
                this.updateAddress(anonymousSymbol, resultPtr);
            }
        }
    }

    LLVMExprResult res;
    res.entry = anonymousSymbol;

    // In case this is a constructor call, return the thisPtr as pointer
    if data.isCtorCall() {
        res.ptr = thisPtr;
        res.refPtr = resultPtr;
        return exprResultAny(res);
    }

    // In case this is a callee, returning a reference, return the address
    if returnSType.isRef() {
        res.ptr = callInst;
        res.refPtr = resultPtr;
        return exprResultAny(res);
    }

    // In case the value is returned via memory or coerced, return its address
    if !resultAddr.isNull() {
        res.ptr = resultAddr;
        return exprResultAny(res);
    }

    // Otherwise return the value
    res.value = callInst;
    res.ptr = resultPtr;
    return exprResultAny(res);
}

p IRGenerator.setCallArgAttrs(llvm::Value callInst, const model::Function* spiceFunc, const QualTypeList& paramSTypes,
                              unsigned int argOffset = 0) {
    const bool isFctPtr = spiceFunc == nil<const model::Function*>;
    const bool isMethod = !isFctPtr && !spiceFunc.thisType.is(SuperType::TY_DYN);
    const unsigned long expectedParamCount = isMethod || isFctPtr ? paramSTypes.getSize() + 1l : paramSTypes.getSize();
    for unsigned long i = 0l; i < expectedParamCount; i++ {
        QualType paramType = QualType(SuperType::TY_INVALID);
        if i == 0l && isMethod {
            paramType = spiceFunc.thisType.toPtr(nil<ASTNode*>);
        } else {
            paramType = paramSTypes.get(isMethod ? i - 1l : i);
        }
        const unsigned int argNo = argOffset + cast<unsigned int>(i);

        // NoUndef attribute
        callInst.addCallParamAttr(argNo, "noundef");

        if paramType.isPtr() {
            const QualType pointeeSType = paramType.getContained();
            const llvm::Type pointeeType = pointeeSType.toLLVMType(this.sourceFile);
            assert !pointeeType.isNull();
            // NonNull and dereferenceable attributes. Only 'this' is guaranteed to point to a valid object, other pointers may be nil
            if i == 0l && isMethod {
                callInst.addCallParamAttr(argNo, "nonnull");
                callInst.addCallDereferenceableParamAttr(argNo, this.module.getTypeStoreSize(pointeeType));
            }
            // Alignment attribute
            callInst.addCallParamAttr(argNo, "align", cast<unsigned long>(this.module.getABITypeAlign(pointeeType)));
        }

        // ZExt or SExt attribute
        const string extAttrKind = this.getExtAttrKindForType(paramType);
        if extAttrKind != nil<string> {
            callInst.addCallParamAttr(argNo, extAttrKind);
        }
    }
}

p IRGenerator.setCallReturnValAttrs(llvm::Value callInst, const QualType& returnType) {
    if returnType.is(SuperType::TY_DYN) {
        return;
    }

    // Values, that are returned via memory, have attributes on the sret argument. Coerced values might contain padding
    const ReturnABIInfo returnABI = this.getReturnABIInfo(returnType);
    if !returnABI.isDirect() {
        return;
    }

    // NoUndef attribute
    callInst.addCallRetAttr("noundef");
    // ZExt or SExt attribute
    const string extAttrKind = this.getExtAttrKindForType(returnType);
    if extAttrKind != nil<string> {
        callInst.addCallRetAttr(extAttrKind);
    }
}

public f<Any> IRGenerator.visitArrayInitialization(ASTArrayInitializationNode* node) {
    // Return immediately if the initialization is empty
    if node.actualSize == 0l {
        LLVMExprResult res;
        res.node = cast<IVisitable*>(node);
        return exprResultAny(res);
    }

    // Visit array items
    bool canBeConstant = true;
    Vector<LLVMExprResult> itemResults;
    itemResults.reserve(node.actualSize);
    foreach IVisitable* itemNode : node.itemLst.args {
        LLVMExprResult item = this.visitExpr(itemNode);
        canBeConstant = canBeConstant && !item.constant.isNull();
        item.node = itemNode;
        itemResults.pushBack(item);
    }

    // Get LLVM type of item and array
    assert !itemResults.isEmpty();
    const QualType firstItemSTy = this.getEvaluatedType(node.itemLst.args.front());
    const llvm::Type itemType = firstItemSTy.toLLVMType(this.sourceFile);
    const llvm::Type arrayType = llvm::getArrayType(itemType, node.actualSize);

    if canBeConstant { // All items are constants, so we can create a global constant array
        // Collect constants
        Vector<llvm::Value> constants;
        foreach const LLVMExprResult& exprResult : itemResults {
            // Delete potential constant globals, that were already created a layer below
            const llvm::Type constantType = exprResult.constant.getType();
            if constantType.isArrayTy() {
                const String nestedGlobalName = exprResult.ptr.getName();
                llvm::Value nestedGlobal = this.module.getNamedGlobal(nestedGlobalName.getRaw());
                nestedGlobal.eraseGlobalFromParent();
            }
            constants.pushBack(exprResult.constant);
        }

        // Create global array
        const llvm::Value constantArray = llvm::getConstArray(itemType, constants);
        const llvm::Value arrayAddr = this.createGlobalConst(String(ANON_GLOBAL_ARRAY_NAME), constantArray);

        LLVMExprResult res;
        res.constant = constantArray;
        res.ptr = arrayAddr;
        return exprResultAny(res);
    }

    // We have non-immediate values as items, so we need to take normal arrays as fallback
    const llvm::Value arrayAddr = this.insertAlloca(arrayType);

    // Retrieve address of first item
    const llvm::Value firstItemAddress = this.insertInBoundsGEP(arrayType, arrayAddr, this.getInt64(0l));

    // Store all array items at their corresponding offsets
    llvm::Value currentItemAddress = firstItemAddress;
    for unsigned long i = 0l; i < itemResults.getSize(); i++ {
        LLVMExprResult& exprResult = itemResults.get(i);
        const llvm::Value itemValue = this.resolveValue(exprResult.node, exprResult);
        // Retrieve current item address
        if i >= 1l {
            currentItemAddress = this.insertInBoundsGEP(itemType, currentItemAddress, this.getInt64(1l));
        }
        // Store the item value
        const bool storeVolatile = exprResult.entry != nil<const SymbolTableEntry*> && exprResult.entry.isVolatile;
        this.insertStore(itemValue, currentItemAddress, storeVolatile);
    }

    return exprResultAny(exprResultWithPtr(arrayAddr));
}

public f<Any> IRGenerator.visitStructInstantiation(ASTStructInstantiationNode* node) {
    // Get struct object
    const Struct* spiceStruct = node.instantiatedStructs.get(this.manIdx);
    assert spiceStruct != nil<const Struct*>;
    const QualTypeList& fieldTypes = spiceStruct.fieldTypes;

    // Can only be constant if none of the fields is of type reference
    bool canBeConstant = !spiceStruct.hasReferenceFields();

    // Get struct type
    assert spiceStruct.entry != nil<SymbolTableEntry*>;
    const QualType& structEntryType = spiceStruct.entry.getQualType();
    const llvm::Type structType = structEntryType.toLLVMType(this.sourceFile);
    assert !structType.isNull();

    if node.fieldLst == nil<ASTArgLstNode*> {
        const llvm::Value constantStruct = this.getDefaultValueForSymbolType(structEntryType);
        return exprResultAny(exprResultWithConstant(constantStruct));
    }

    // Visit struct field values
    Vector<LLVMExprResult> fieldValueResults;
    fieldValueResults.reserve(spiceStruct.fieldTypes.getSize());
    foreach IVisitable* fieldValueNode : node.fieldLst.args {
        LLVMExprResult fieldValue = this.visitExpr(fieldValueNode);
        fieldValue.node = fieldValueNode;
        fieldValueResults.pushBack(fieldValue);
        canBeConstant = canBeConstant && !fieldValue.constant.isNull();
    }

    if canBeConstant { // All field values are constants, so we can create a global constant struct instantiation
        // Collect constants
        Vector<llvm::Value> constants;
        // The VTable address point for the synthesized vtable pointer
        if spiceStruct.hasSynthesizedVTablePtr() {
            constants.pushBack(this.getVTableAddressPoint(&spiceStruct.structBase));
        }
        // For each interface a nullptr
        foreach const QualType& interfaceType : spiceStruct.interfaceTypes {
            constants.pushBack(this.getDefaultValueForSymbolType(interfaceType));
        }
        // Constant value for each field
        foreach const LLVMExprResult& exprResult : fieldValueResults {
            constants.pushBack(exprResult.constant);
        }

        // Create global constant struct
        const llvm::Value constantStruct = llvm::getConstNamedStruct(structType, constants);

        return exprResultAny(exprResultWithConstant(constantStruct));
    }

    // We have at least one non-immediate value, so we need to take normal struct instantiation as fallback
    const llvm::Value structAddr = this.insertAlloca(structType);
    const unsigned long interfaceCount = spiceStruct.interfaceTypes.getSize();
    const unsigned long fieldCount = spiceStruct.fieldTypes.getSize();
    unsigned long i = 0l;

    // Store the VTable address point for the synthesized vtable pointer
    if spiceStruct.hasSynthesizedVTablePtr() {
        this.insertStore(this.getVTableAddressPoint(&spiceStruct.structBase), structAddr);
    }

    // Store interface values at their corresponding offsets
    while i < interfaceCount {
        const QualType& interfaceType = spiceStruct.interfaceTypes.get(i);
        // Get field value
        const llvm::Value itemValue = this.getDefaultValueForSymbolType(interfaceType);
        // Get field address
        const llvm::Value currentFieldAddress = this.insertStructGEP(structType, structAddr, cast<unsigned int>(spiceStruct.getFieldElementIndex(i)));
        // Store the item value
        this.insertStore(itemValue, currentFieldAddress);
        i++;
    }

    // Store all field values at their corresponding offsets
    const Vector<model::Function*>& fieldCopyCtors = node.fieldCopyCtors.get(this.manIdx);
    while i < interfaceCount + fieldCount {
        LLVMExprResult& exprResult = fieldValueResults.get(i);
        const QualType& fieldType = fieldTypes.get(i);
        // Get field value
        llvm::Value itemValue;
        const model::Function* copyCtor = fieldCopyCtors.get(i);
        if fieldType.isRef() {
            itemValue = this.resolveAddress(exprResult);
        } else if copyCtor != nil<const model::Function*> {
            // Deep-copy the value into the field via its copy ctor: the source is not consumed/moved here, so the
            // caller keeps its own copy alive and destructs it independently - a raw value copy would alias its
            // owned heap resources and lead to a double-free once one of the two is destructed.
            const llvm::Value originalPtr = this.resolveAddress(exprResult);
            const llvm::Type fieldLLVMType = fieldType.toLLVMType(this.sourceFile);
            const llvm::Value fieldCopyPtr = this.insertAlloca(fieldLLVMType, String("field.copy"));
            Vector<llvm::Value> ctorArgs;
            ctorArgs.pushBack(originalPtr);
            this.generateCtorOrDtorCall(fieldCopyPtr, copyCtor, ctorArgs);
            itemValue = this.insertLoad(fieldLLVMType, fieldCopyPtr);
        } else {
            itemValue = this.resolveValue(exprResult.node, exprResult);
        }
        // Get field address
        const llvm::Value currentFieldAddress = this.insertStructGEP(structType, structAddr, cast<unsigned int>(spiceStruct.getFieldElementIndex(i)));
        // Store the item value
        const bool storeVolatile = exprResult.entry != nil<const SymbolTableEntry*> && exprResult.entry.isVolatile;
        this.insertStore(itemValue, currentFieldAddress, storeVolatile);
        i++;
    }

    // Attach address to anonymous symbol to keep track of de-allocation
    const SymbolTableEntry* returnSymbol = this.currentScope.symbolTable.lookupAnonymous(cast<ASTNode*>(node));
    if returnSymbol != nil<const SymbolTableEntry*> {
        this.updateAddress(returnSymbol, structAddr);
    }

    return exprResultAny(exprResultWithPtr(structAddr));
}

/**
 * Shared implementation of visitLambdaFunc, visitLambdaProc and visitLambdaExpr. The differences are marked below.
 *
 * @param node Lambda node
 * @param lambdaBase Lambda base node
 * @param spiceFunc Manifestation of the lambda (a copy, since the mangle suffix may be set)
 * @param isFunction Whether the lambda returns a value
 * @param body Body of the lambda (statement list), or nil for lambda expressions
 * @param lambdaExpr Expression of a lambda expression, or nil for lambda functions/procedures
 * @param setMangleSuffix Whether to set the mangle suffix to the manifestation index (lambda functions/procedures)
 * @return Fat pointer to the lambda
 */
f<Any> IRGenerator.visitLambda(ASTNode* node, ASTLambdaBaseNode* lambdaBase, model::Function& spiceFunc, bool isFunction, IVisitable* body, IVisitable* lambdaExpr, bool setMangleSuffix, const String& scopeId) {
    ParamInfoList paramInfoList;
    Vector<llvm::Type> paramTypes;

    // Change scope
    Scope* bodyScope = this.currentScope.getChildScope(scopeId);
    this.currentScope = bodyScope;

    // Every lambda uniformly takes a trailing capture-struct pointer as its last argument, even when it captures
    // nothing. This keeps the calling convention of all lambdas (and plain function pointers) identical, so a lambda
    // can be stored, retrieved and called without the call site knowing statically whether it captures. A
    // non-capturing lambda simply ignores the passed (poison) pointer. Passing captures last (rather than first) keeps
    // fat ptr slot 0 directly callable through a plain C calling convention (e.g. when handed to a C API as a callback).
    const CaptureMap& captures = bodyScope.symbolTable.captures;
    const bool hasCaptures = !captures.isEmpty();
    llvm::Type capturesStructType;
    if hasCaptures {
        capturesStructType = this.buildCapturesContainerType(captures);
    }

    // Visit parameters
    unsigned long argIdx = 0l;
    if lambdaBase.hasParams {
        ASTParamLstNode* paramLst = downcast<ASTParamLstNode>(lambdaBase.paramLst);
        const unsigned long numOfParams = spiceFunc.paramList.getSize();
        const QualTypeList spiceFuncParamTypes = spiceFunc.getParamTypes();
        paramInfoList.reserve(numOfParams + 1l);
        paramTypes.reserve(numOfParams + 1l);
        while argIdx < numOfParams {
            const ASTDeclStmtNode* param = paramLst.params.get(argIdx);
            // Get symbol table entry of param
            const SymbolTableEntry* paramSymbol = this.currentScope.lookupStrict(param.varName);
            assert paramSymbol != nil<const SymbolTableEntry*>;
            // Retrieve type of param
            const QualType& paramSType = spiceFuncParamTypes.get(argIdx);
            const llvm::Type paramType = paramSType.getParamLLVMType(this.sourceFile);
            // Add it to the lists
            paramInfoList.pushBack(ParamInfo{param.varName, paramSymbol});
            paramTypes.pushBack(paramType);
            argIdx++;
        }
    }

    // Append the trailing capture-struct pointer (always passed as pointer)
    paramInfoList.pushBack(ParamInfo{String(CAPTURES_PARAM_NAME), nil<const SymbolTableEntry*>});
    paramTypes.pushBack(this.builder.getPtrTy());
    const QualType returnSType = isFunction ? spiceFunc.returnType : QualType(SuperType::TY_DYN);
    const unsigned int argOffset = this.getArgOffset(returnSType);
    const unsigned int capturesArgIdx = argOffset + cast<unsigned int>(paramTypes.getSize()) - 1;

    // Get return type
    llvm::Type returnType = this.builder.getVoidTy();
    if isFunction {
        returnType = spiceFunc.returnType.toLLVMType(this.sourceFile);
    }

    // Create function or implement declared function
    if setMangleSuffix {
        spiceFunc.mangleSuffix = "." + toString(this.manIdx);
    }
    const String mangledName = spiceFunc.getMangledName();
    const llvm::Type funcType = this.getFunctionType(returnSType, paramTypes);
    this.module.getOrInsertFunction(mangledName.getRaw(), funcType);
    llvm::Function lambda = this.module.getFunction(mangledName.getRaw());

    // Set attributes to function
    lambda.setLinkage(llvm::LLVMLinkage::InternalLinkage);
    this.addCommonFctAttrs(lambda);
    this.enableFunctionInstrumentation(lambda);
    const ReturnABIInfo returnABI = this.getReturnABIInfo(returnSType);
    if returnABI.isIndirect() {
        this.addSRetParamAttrs(lambda, returnABI.memoryType);
    }

    // In case of captures, add attribute to captures argument
    if hasCaptures {
        lambda.addParamAttr(capturesArgIdx, "noundef");
        lambda.addParamAttr(capturesArgIdx, "nonnull");
        lambda.addDereferenceableParamAttr(capturesArgIdx, cast<unsigned long>(this.module.getPointerSize()));
    }

    // Add debug info
    this.diGenerator.generateFunctionDebugInfo(lambda, &spiceFunc, true);
    this.diGenerator.setSourceLocation(node);

    // Save alloca insert markers
    const llvm::BasicBlock allocaInsertBlockOrig = this.allocaInsertBlock;
    const llvm::Value allocaInsertInstOrig = this.allocaInsertInst;
    const llvm::BasicBlock bOrig = this.builder.getInsertBlock();

    // Create entry block
    const llvm::BasicBlock bEntry = this.createBlock();
    this.switchToBlock(bEntry, lambda);

    // Reset alloca insert markers to this block
    this.allocaInsertBlock = bEntry;
    this.allocaInsertInst = llvm::Value();

    // Declare result variable
    const SymbolTableEntry* resultEntry = nil<const SymbolTableEntry*>;
    if body != nil<IVisitable*> && isFunction {
        resultEntry = this.currentScope.lookupStrict(String(RETURN_VARIABLE_NAME));
        assert resultEntry != nil<const SymbolTableEntry*>;
        if resultEntry.isInitialized() {
            // If the value is returned via memory, the result variable lives in the caller's memory
            llvm::Value resultAddr = getSRetArg(lambda);
            if resultAddr.isNull() {
                resultAddr = this.insertAlloca(returnType, String(RETURN_VARIABLE_NAME));
            }
            this.updateAddress(resultEntry, resultAddr);
            // Generate debug info
            this.diGenerator.generateLocalVarDebugInfo(String(RETURN_VARIABLE_NAME), resultAddr);
        }
    }

    // Store function argument values. The sret parameter is skipped
    llvm::Value captureStructPtrPtr;
    const unsigned int argCount = lambda.argSize() - argOffset;
    const Vector<llvm::Type> funcParamTypes = funcType.getParamTypes();
    for unsigned int argNumber = 0; argNumber < argCount; argNumber++ {
        const llvm::Value arg = lambda.getArg(argOffset + argNumber);
        // Get parameter info
        const ParamInfo& paramInfo = paramInfoList.get(argNumber);
        const SymbolTableEntry* paramSymbol = paramInfo.entry;
        // Decayed array params already carry the address of the array, so they do not need a local copy
        if this.bindDecayedArrayParam(arg, argNumber, paramInfo.name, paramSymbol) {
            continue;
        }
        // Allocate space for it
        const llvm::Type paramType = funcParamTypes.get(argOffset + argNumber);
        const llvm::Value paramAddress = this.insertAlloca(paramType, paramInfo.name);
        // Update the symbol table entry
        const bool isCapturesStruct = argOffset + argNumber == capturesArgIdx;
        if isCapturesStruct {
            captureStructPtrPtr = paramAddress;
        } else {
            this.updateAddress(paramSymbol, paramAddress);
        }
        // Generate debug info
        if !isCapturesStruct {
            this.diGenerator.generateLocalVarDebugInfo(paramInfo.name, paramAddress, cast<unsigned long>(argNumber) + 1l);
        }
        // Store the value at the new address
        this.insertStore(arg, paramAddress);
    }

    // Store the default values for optional function args
    if lambdaBase.paramLst != nil<IVisitable*> {
        ASTParamLstNode* paramLst = downcast<ASTParamLstNode>(lambdaBase.paramLst);
        while argIdx < paramLst.params.getSize() {
            this.visit(cast<IVisitable*>(paramLst.params.get(argIdx)));
            argIdx++;
        }
    }

    // Extract captures from captures struct
    if hasCaptures {
        assert !paramInfoList.isEmpty();
        this.unpackCapturesToLocalVariables(captures, captureStructPtrPtr, capturesStructType);
    }

    if body != nil<IVisitable*> {
        // Visit body
        this.visit(body);

        // Create return statement if the block is not terminated yet
        if !this.blockAlreadyTerminated {
            if isFunction {
                llvm::Value res = this.getDefaultValueForSymbolType(spiceFunc.returnType);
                if resultEntry.isInitialized() {
                    const llvm::Value resultAddr = this.getAddress(resultEntry);
                    res = resultAddr.isSameAs(getSRetArg(lambda)) ? llvm::Value() : this.insertLoad(returnType, resultAddr);
                }
                this.insertReturn(res);
            } else {
                this.builder.createRetVoid();
            }
        }
    } else {
        // Visit lambda expression
        const llvm::Value exprResult = this.resolveValue(lambdaExpr);
        this.insertReturn(exprResult);
    }

    // Pop capture addresses
    if hasCaptures {
        foreach Pair<const String&, const Capture&> capture : captures {
            const Capture& captureValue = capture.getSecond();
            this.popAddress(captureValue.capturedSymbol);
        }
    }

    // Conclude debug info for function
    this.diGenerator.concludeFunctionDebugInfo();
    this.diGenerator.setSourceLocation(node);

    // Restore alloca insert markers
    this.builder.setInsertPoint(bOrig);
    this.blockAlreadyTerminated = false;
    this.allocaInsertBlock = allocaInsertBlockOrig;
    this.allocaInsertInst = allocaInsertInstOrig;

    // Change back to original scope
    this.currentScope = this.currentScope.parent;

    // Verify function
    this.verifyFunction(lambda, node.codeLoc);

    // Captures, create a struct { <fct-ptr>, <capture struct ptr> }
    const llvm::Value res = this.buildFatFctPtr(bodyScope, capturesStructType, lambda.asValue());

    LLVMExprResult exprResult;
    exprResult.ptr = res;
    exprResult.node = node.visitable;
    return exprResultAny(exprResult);
}

public f<Any> IRGenerator.visitLambdaFunc(ASTLambdaFuncNode* node) {
    model::Function spiceFunc = node.manifestations.get(this.manIdx);
    return this.visitLambda(cast<ASTNode*>(node), &node.node, spiceFunc, true, node.body, nil<IVisitable*>, true, node.getScopeId());
}

public f<Any> IRGenerator.visitLambdaProc(ASTLambdaProcNode* node) {
    model::Function spiceFunc = node.manifestations.get(this.manIdx);
    return this.visitLambda(cast<ASTNode*>(node), &node.node, spiceFunc, false, node.body, nil<IVisitable*>, true, node.getScopeId());
}

public f<Any> IRGenerator.visitLambdaExpr(ASTLambdaExprNode* node) {
    model::Function spiceFunc = node.manifestations.get(this.manIdx);
    return this.visitLambda(cast<ASTNode*>(node), &node.node, spiceFunc, spiceFunc.isFunction(), nil<IVisitable*>, node.lambdaExpr, false, node.getScopeId());
}

public f<Any> IRGenerator.visitDataType(ASTDataTypeNode* node) {
    // Retrieve symbol type
    const QualType symbolType = this.getEvaluatedType(cast<IVisitable*>(node));
    assert !symbolType.is(SuperType::TY_DYN); // Symbol type should not be dyn anymore at this point
    return Any(symbolType.toLLVMType(this.sourceFile));
}

f<llvm::Function> IRGenerator.getOrCreateFatFctPtrThunk(llvm::Function target) {
    // Plain function/procedure references are stored in fat function pointers and called through the uniform lambda
    // calling convention, which always passes a trailing capture-struct pointer. A named function does not have that
    // parameter, so we wrap it in a thunk that has the extra (ignored) pointer and forwards to the real function.
    const String thunkName = target.getName() + ".fatthunk";
    const llvm::Function existing = this.module.getFunction(thunkName.getRaw());
    if !existing.isNull() {
        return existing;
    }

    // Build the thunk signature: the target's signature with an additional trailing capture-struct pointer
    const llvm::Type targetType = target.getFunctionType();
    const Vector<llvm::Type> targetParamTypes = targetType.getParamTypes();
    Vector<llvm::Type> paramTypes;
    paramTypes.reserve(targetParamTypes.getSize() + 1l);
    foreach const llvm::Type& paramType : targetParamTypes {
        paramTypes.pushBack(paramType);
    }
    paramTypes.pushBack(this.builder.getPtrTy()); // Ignored captures pointer
    const llvm::Type thunkType = llvm::getFunctionType(targetType.getReturnType(), paramTypes, targetType.isFunctionVarArg());

    const llvm::Function thunk = this.module.createFunction(thunkType, llvm::LLVMLinkage::PrivateLinkage, thunkName.getRaw());
    this.addCommonFctAttrs(thunk);

    // Save insert markers, because we emit the thunk body in the middle of generating another function
    const llvm::BasicBlock bOrig = this.builder.getInsertBlock();
    const llvm::BasicBlock allocaInsertBlockOrig = this.allocaInsertBlock;
    const llvm::Value allocaInsertInstOrig = this.allocaInsertInst;

    const llvm::BasicBlock bEntry = this.createBlock(String("entry"));
    this.switchToBlock(bEntry, thunk);

    // Forward all arguments except the trailing (ignored) captures pointer
    Vector<llvm::Value> fwdArgs;
    fwdArgs.reserve(targetParamTypes.getSize());
    for unsigned int i = 0; i < cast<unsigned int>(targetParamTypes.getSize()); i++ {
        fwdArgs.pushBack(thunk.getArg(i));
    }
    const llvm::Value call = this.builder.createCall(target, fwdArgs);
    // Forward the sret pointer, if the target returns via memory
    const llvm::Value targetSRetArg = getSRetArg(target);
    if !targetSRetArg.isNull() {
        const llvm::Type sretType = target.getParamTypeAttr(0, "sret");
        this.addSRetParamAttrs(thunk, sretType);
        this.addSRetCallParamAttrs(call, sretType);
    }
    const llvm::Type targetReturnType = targetType.getReturnType();
    if targetReturnType.isVoidTy() {
        this.builder.createRetVoid();
    } else {
        this.builder.createRet(call);
    }

    // Restore insert markers
    this.builder.setInsertPoint(bOrig);
    this.blockAlreadyTerminated = false;
    this.allocaInsertBlock = allocaInsertBlockOrig;
    this.allocaInsertInst = allocaInsertInstOrig;

    return thunk;
}

f<llvm::Value> IRGenerator.buildFatFctPtr(Scope* bodyScope, llvm::Type capturesStructType, llvm::Value lambda) {
    // Create capture struct if required
    llvm::Value capturesPtr;
    // Byte size of the owned capture struct. This is only non-zero if the captures live in a dedicated
    // (stack-allocated) struct that the std Lambda type needs to relocate to the heap to take ownership.
    // A single capture stored inline in the capturePtr slot, or no captures at all, leaves this at 0.
    unsigned long captureStructSize = 0l;
    if !capturesStructType.isNull() {
        assert bodyScope != nil<Scope*>;
        const CaptureMap& captures = bodyScope.symbolTable.captures;
        // If we have a single capture of ptr type, we can directly store it into the fat ptr. Otherwise, we need a stack allocated
        // struct to store the captures in a memory-efficient manner and store a pointer to that struct to the fat ptr.
        if capturesStructType.isPointerTy() {
            assert captures.getSize() == 1l;
            foreach Pair<const String&, const Capture&> captureEntry : captures {
                const Capture& capture = captureEntry.getSecond();
                if capture.getMode() == CapturePassMode::BY_VALUE {
                    const QualType& capturedType = capture.capturedSymbol.getQualType();
                    const llvm::Type varType = capturedType.toLLVMType(this.sourceFile);
                    capturesPtr = this.insertLoad(varType, this.getAddress(capture.capturedSymbol));
                } else {
                    capturesPtr = this.getAddress(capture.capturedSymbol);
                }
            }
        } else {
            capturesPtr = this.insertAlloca(capturesStructType, String(CAPTURES_PARAM_NAME));
            captureStructSize = this.module.getTypeAllocSize(capturesStructType);
            unsigned int captureIdx = 0;
            foreach Pair<const String&, const Capture&> captureEntry : captures {
                const Capture& capture = captureEntry.getSecond();
                const SymbolTableEntry* capturedEntry = capture.capturedSymbol;
                // Get address or value of captured variable, depending on the capturing mode
                llvm::Value capturedValue = this.getAddress(capturedEntry);
                assert !capturedValue.isNull();
                if capture.getMode() == CapturePassMode::BY_VALUE {
                    const QualType& capturedType = capturedEntry.getQualType();
                    const llvm::Type captureType = capturedType.toLLVMType(this.sourceFile);
                    capturedValue = this.insertLoad(captureType, capturedValue);
                }
                // Store it in the capture struct
                const llvm::Value captureAddress = this.insertStructGEP(capturesStructType, capturesPtr, captureIdx);
                this.insertStore(capturedValue, captureAddress);
                captureIdx++;
            }
        }
    }

    // Create fat pointer
    const llvm::Value fatFctPtr = this.insertAlloca(this.llvmTypes.lambdaFatPtrType, String("fat.ptr"));
    const llvm::Value fctPtr = this.insertStructGEP(this.llvmTypes.lambdaFatPtrType, fatFctPtr, 0);
    this.insertStore(lambda, fctPtr);
    const llvm::Value capturePtr = this.insertStructGEP(this.llvmTypes.lambdaFatPtrType, fatFctPtr, 1);
    // The uniform lambda calling convention always loads and passes this slot, so it must hold a defined value even
    // when there are no captures. A null pointer is passed to (and ignored by) non-capturing targets.
    this.insertStore(!capturesPtr.isNull() ? capturesPtr : llvm::getNullValue(this.builder.getPtrTy()), capturePtr);
    const llvm::Value captureSizePtr = this.insertStructGEP(this.llvmTypes.lambdaFatPtrType, fatFctPtr, 2);
    this.insertStore(this.builder.getInt64(captureStructSize), captureSizePtr);

    return fatFctPtr;
}

f<llvm::Type> IRGenerator.buildCapturesContainerType(const CaptureMap& captures) {
    assert !captures.isEmpty();

    // If we have only one capture that is a ptr, we can just use that ptr type
    if captures.getSize() == 1l {
        foreach Pair<const String&, const Capture&> captureEntry : captures {
            const Capture& capture = captureEntry.getSecond();
            const QualType& capturedType = capture.capturedSymbol.getQualType();
            if capturedType.isPtr() || capture.getMode() == CapturePassMode::BY_REFERENCE {
                return this.builder.getPtrTy();
            }
        }
    }

    // Create captures struct type
    Vector<llvm::Type> captureTypes;
    foreach Pair<const String&, const Capture&> captureEntry : captures {
        const Capture& c = captureEntry.getSecond();
        if c.getMode() == CapturePassMode::BY_VALUE {
            const QualType& capturedType = c.capturedSymbol.getQualType();
            captureTypes.pushBack(capturedType.toLLVMType(this.sourceFile));
        } else {
            captureTypes.pushBack(this.builder.getPtrTy());
        }
    }
    return llvm::getStructType(*this.context, captureTypes);
}

p IRGenerator.unpackCapturesToLocalVariables(const CaptureMap& captures, llvm::Value val, llvm::Type structType) {
    assert !captures.isEmpty();
    // Debug info attached to a computed address gets dropped by the backend, so the debug info of all captures is attached
    // to the stack slot of the captures ptr (val) instead. The address ops lead from there to the capture. By reference
    // captures hold the address of the captured variable, so they need one more deref.
    // If we have only one capture that is a ptr, we can just load the ptr
    if captures.getSize() == 1l {
        foreach Pair<const String&, const Capture&> captureEntry : captures {
            const Capture& firstCapture = captureEntry.getSecond();
            const QualType& capturedType = firstCapture.capturedSymbol.getQualType();
            if capturedType.isPtr() || firstCapture.getMode() == CapturePassMode::BY_REFERENCE {
                // Interpret capturesPtr as ptr to the first and only capture
                const llvm::Value captureAddress = val;
                this.pushAddress(firstCapture.capturedSymbol, captureAddress);
                // Generate debug info
                Vector<unsigned long> addressOps;
                if firstCapture.getMode() == CapturePassMode::BY_REFERENCE {
                    addressOps.pushBack(llvm::DW_OP_DEREF);
                }
                this.diGenerator.generateLocalVarDebugInfo(firstCapture.getName(), val, SIZE_MAX, addressOps);
                return;
            }
        }
    }

    // Interpret capturesPtr as ptr to the captures struct
    const llvm::Value capturesPtr = this.insertLoad(this.builder.getPtrTy(), val);

    unsigned int captureIdx = 0;
    foreach Pair<const String&, const Capture&> captureEntry : captures {
        const String& name = captureEntry.getFirst();
        const Capture& capture = captureEntry.getSecond();
        const String valueName = capture.getMode() == CapturePassMode::BY_REFERENCE ? name + ".addr" : name;
        const llvm::Value captureAddress = this.insertStructGEP(structType, capturesPtr, captureIdx, valueName);
        this.pushAddress(capture.capturedSymbol, captureAddress);
        // Generate debug info
        const unsigned long offset = this.module.getStructElementOffset(structType, captureIdx);
        Vector<unsigned long> addressOps;
        addressOps.pushBack(llvm::DW_OP_DEREF);
        addressOps.pushBack(llvm::DW_OP_PLUS_UCONST);
        addressOps.pushBack(offset);
        if capture.getMode() == CapturePassMode::BY_REFERENCE {
            addressOps.pushBack(llvm::DW_OP_DEREF);
        }
        this.diGenerator.generateLocalVarDebugInfo(capture.getName(), val, SIZE_MAX, addressOps);
        captureIdx++;
    }
}

// ====================================================== Builtin functions ======================================================

f<Any> IRGenerator.visitBuiltinCall(ASTFctCallNode* node) {
    // If we have a compile time value, but the computation is still there, we can simply use this constant value
    ASTNode* baseNode = cast<ASTNode*>(node);
    if baseNode.hasCompileTimeValue(this.manIdx) {
        const CompileTimeValue compileTimeValue = baseNode.getCompileTimeValue(this.manIdx);
        const QualType evaluatedType = this.getEvaluatedType(cast<IVisitable*>(node));
        const llvm::Value value = this.getConst(compileTimeValue, evaluatedType, baseNode);
        return exprResultAny(exprResultWithConstant(value));
    }

    // If we need to perform runtime actions, call the specified IRGenerator delegate
    const String& name = node.fqFunctionName;
    if name == BUILTIN_FCT_NAME_PRINTF { return this.visitBuiltinPrintfCall(node); }
    if name == BUILTIN_FCT_NAME_LEN { return this.visitBuiltinLenCall(node); }
    if name == BUILTIN_FCT_NAME_PANIC { return this.visitBuiltinPanicCall(node); }
    if name == BUILTIN_FCT_NAME_SYSCALL { return this.visitBuiltinSyscallCall(node); }
    if name == BUILTIN_FCT_NAME_NEW { return this.visitBuiltinNewCall(node); }
    if name == BUILTIN_FCT_NAME_PLACEMENT_NEW { return this.visitBuiltinPlacementNewCall(node); }
    if name == BUILTIN_FCT_NAME_ERR_TRACE_BUFFER { return this.visitBuiltinErrTraceBufferCall(node); }
    if name == BUILTIN_FCT_NAME_STDERR { return this.visitBuiltinStdErrCall(node); }
    if name == BUILTIN_FCT_NAME_FRAME_ADDRESS { return this.visitBuiltinFrameAddressCall(node); }
    panic(Error("Builtin function not implemented!")); // LCOV_EXCL_LINE
}

f<Any> IRGenerator.visitBuiltinPrintfCall(ASTFctCallNode* node) {
    // Retrieve templated string
    assert node.hasArgs;
    IVisitable* firstArg = node.argLst.args.front();
    const QualType firstArgType = this.getEvaluatedType(firstArg);
    assert firstArgType.is(SuperType::TY_STRING) && this.hasCompileTimeValue(firstArg);
    const CompileTimeValue firstArgValue = this.getCompileTimeValue(firstArg);
    const unsigned long stringOffset = firstArgValue.getStringValueOffset();
    const String templatedString = this.resourceManager.compileTimeStringValues.get(stringOffset);

    // Push the template string as first argument
    Vector<llvm::Value> printfArgs;
    const llvm::Value templateString = this.createGlobalStringConst(String("printf.str."), templatedString, node.codeLoc);
    printfArgs.pushBack(templateString);

    // Collect replacement arguments
    for unsigned long argIdx = 1l; argIdx < node.argLst.args.getSize(); argIdx++ {
        IVisitable* arg = node.argLst.args.get(argIdx);
        // Retrieve type of argument
        const QualType argSymbolType = this.getEvaluatedType(arg);
        const QualType argBaseType = argSymbolType.getBase();

        // Re-map some values
        llvm::Value argVal;
        if argSymbolType.isArray() {
            // ToDo: Check if GEP can be removed
            const llvm::Value argValPtr = this.resolveAddress(arg);
            Vector<llvm::Value> indices;
            indices.pushBack(this.getInt64(0l));
            indices.pushBack(this.getInt32(0l));
            const llvm::Type argType = argSymbolType.toLLVMType(this.sourceFile);
            argVal = this.insertInBoundsGEP(argType, argValPtr, indices);
        } else if argBaseType.isStringObj() {
            llvm::Value argValPtr = this.resolveAddress(arg);
            const llvm::Type argBaseLLVMType = argBaseType.toLLVMType(this.sourceFile);
            argValPtr = this.insertStructGEP(argBaseLLVMType, argValPtr, 0);
            argVal = this.insertLoad(this.builder.getPtrTy(), argValPtr);
        } else {
            argVal = this.resolveValue(arg);
        }

        // Extend all integer types lower than 32 bit to 32 bit
        const QualType argTypeNoRef = argSymbolType.removeReferenceWrapper();
        const dyn smallIntTypes = [SuperType::TY_SHORT, SuperType::TY_BYTE, SuperType::TY_CHAR, SuperType::TY_BOOL];
        if argTypeNoRef.isOneOf(smallIntTypes, len(smallIntTypes)) {
            argVal = this.builder.createIntCast(argVal, this.builder.getInt32Ty(), argTypeNoRef.isSigned());
        }

        printfArgs.pushBack(argVal);
    }

    // Call printf function
    const llvm::Function printfFct = this.stdFunctionManager.getPrintfFct();
    llvm::Value callInst = this.builder.createCall(printfFct, printfArgs);

    // Add noundef attribute to return value and all arguments
    callInst.addCallRetAttr("noundef");
    for unsigned int i = 0; i < cast<unsigned int>(printfArgs.getSize()); i++ {
        callInst.addCallParamAttr(i, "noundef");
    }

    return exprResultAny(exprResultWithValue(callInst));
}

f<Any> IRGenerator.visitBuiltinLenCall(ASTFctCallNode* node) {
    assert node.fqFunctionName == BUILTIN_FCT_NAME_LEN;

    // Check if the length is fixed and known via the symbol type
    IVisitable* argNode = node.argLst.args.front();
    QualType symbolType = this.getEvaluatedType(argNode);
    symbolType = symbolType.removeReferenceWrapper();
    assert symbolType.is(SuperType::TY_STRING);

    const llvm::Function getRawLengthFct = this.stdFunctionManager.getStringGetRawLengthStringFct();
    Vector<llvm::Value> args;
    args.pushBack(this.resolveValue(argNode));
    const llvm::Value lengthValue = this.builder.createCall(getRawLengthFct, args);
    return exprResultAny(exprResultWithValue(lengthValue));
}

f<Any> IRGenerator.visitBuiltinPanicCall(ASTFctCallNode* node) {
    assert node.fqFunctionName == BUILTIN_FCT_NAME_PANIC;

    const llvm::Type ptrTy = this.builder.getPtrTy();

    // Get value for stderr
    const llvm::Value stdErr = this.getStdErrValue();

    // Create constant for error message
    ASTNode* baseNode = cast<ASTNode*>(node);
    const String codeLoc = node.codeLoc.toPrettyString();
    const String templateStr = "Program panicked at " + codeLoc + ": %s\n" + baseNode.getErrorMessage() + "\n";
    const String globalName = this.getUnusedGlobalName(String(ANON_GLOBAL_STRING_NAME));
    llvm::Value globalString = this.module.createGlobalString(templateStr, globalName.getRaw());

    // If the output should be comparable, fix alignment to 4 bytes
    if this.cliOptions.comparableOutput {
        globalString.setAlignment(4);
    }

    // Get actual error message
    assert node.hasArgs;
    IVisitable* assignExpr = node.argLst.args.front();
    const llvm::Value errorObjPtr = this.resolveAddress(assignExpr);
    const QualType errorObjType = this.getEvaluatedType(assignExpr);
    const llvm::Type errorObjTy = errorObjType.toLLVMType(this.sourceFile);
    const llvm::Value errorMessagePtr = this.insertStructGEP(errorObjTy, errorObjPtr, 1);
    const llvm::Value errorMessage = this.insertLoad(ptrTy, errorMessagePtr);

    // Print the error message to stderr
    const llvm::Function fprintfFct = this.stdFunctionManager.getFPrintfFct();
    Vector<llvm::Value> fprintfArgs;
    fprintfArgs.pushBack(stdErr);
    fprintfArgs.pushBack(globalString);
    fprintfArgs.pushBack(errorMessage);
    this.builder.createCall(fprintfFct, fprintfArgs);

    // Print the recorded error return trace to stderr. A no-op unless error return tracing was enabled somewhere
    // along the propagation chain that produced this error - see error_trace_rt.spice.
    const Vector<llvm::Value> noArgs;
    this.builder.createCall(this.stdFunctionManager.getErrTraceDumpFct(), noArgs);

    // Print the stack trace of the panic. Emitted ahead of the scope cleanup, which is not part of what led to the panic.
    if this.cliOptions.printsStackTraceOnAbort() {
        Vector<llvm::Value> dumpArgs;
        dumpArgs.pushBack(this.builder.getTrue());
        dumpArgs.pushBack(this.builder.getFalse());
        this.builder.createCall(this.stdFunctionManager.getDumpStacktraceFct(), dumpArgs);
    }

    // Cleanup the scope before calling exit()
    // Unreachable below counts as terminator
    this.terminateBlock(baseNode.getNextOuterStmtLst());

    // Generate call to exit()
    const llvm::Function exitFct = this.stdFunctionManager.getExitFct();
    Vector<llvm::Value> exitArgs;
    exitArgs.pushBack(this.getInt32(cast<long>(EXIT_FAILURE)));
    this.builder.createCall(exitFct, exitArgs);
    // Create unreachable instruction
    this.builder.createUnreachable();

    return Any();
}

f<Any> IRGenerator.visitBuiltinSyscallCall(ASTFctCallNode* node) {
    assert node.fqFunctionName == BUILTIN_FCT_NAME_SYSCALL;

    // Determine the required number of operands.
    // (We assume at least one argument is provided: the syscall number)
    assert node.hasArgs;
    const unsigned int requiredRegs = cast<unsigned int>(node.argLst.args.getSize());
    assert requiredRegs >= 1 && requiredRegs <= 7;

    // Create the asm and constraint strings based on the required number of registers.
    const String asmString = this.getSysCallAsmString(requiredRegs);
    const String constraints = this.getSysCallConstraintString(requiredRegs);

    // Create the LLVM function type for the inline asm with only the needed operands.
    // On i386, the registers are only 32 bits wide and with six args the syscall number is passed via memory.
    const bool isX86 = this.cliOptions.targetTriple.isX86();
    const bool passSysCallNumberViaMemory = isX86 && requiredRegs == 7;
    const llvm::Type int64Ty = this.builder.getInt64Ty();
    const llvm::Type regTy = isX86 ? this.builder.getInt32Ty() : int64Ty;
    Vector<llvm::Type> argTypes;
    for unsigned int i = 0; i < requiredRegs; i++ {
        argTypes.pushBack(i == 0 && passSysCallNumberViaMemory ? this.builder.getPtrTy() : regTy);
    }
    const llvm::Type fctType = llvm::getFunctionType(regTy, argTypes, false);
    const llvm::Value inlineAsm = llvm::getInlineAsm(fctType, asmString, constraints, true);

    // Build the argument list (each provided argument is converted to the register type).
    Vector<llvm::Value> argValues;
    argValues.reserve(requiredRegs);
    for unsigned int i = 0; i < requiredRegs; i++ {
        IVisitable* argNode = node.argLst.args.get(i);
        const QualType argType = this.getEvaluatedType(argNode);
        if argType.is(SuperType::TY_PTR) || argType.is(SuperType::TY_STRING) {
            argValues.pushBack(this.builder.createPtrToInt(this.resolveValue(argNode), regTy));
        } else {
            argValues.pushBack(this.builder.createZExtOrTrunc(this.resolveValue(argNode), regTy));
        }
    }
    if passSysCallNumberViaMemory {
        const llvm::Value sysCallNumberPtr = this.insertAlloca(regTy, String("syscall.number"));
        this.insertStore(argValues.front(), sysCallNumberPtr);
        llvm::Value& firstArg = argValues.front();
        firstArg = sysCallNumberPtr;
    }

    // Generate the call using only the required number of arguments.
    llvm::Value call = this.builder.createCall(fctType, inlineAsm, argValues);
    if passSysCallNumberViaMemory {
        call.addCallParamTypeAttr(0, "elementtype", regTy);
    }
    const llvm::Value res = this.builder.createSExtOrTrunc(call, int64Ty);

    return exprResultAny(exprResultWithValue(res));
}

f<Any> IRGenerator.visitBuiltinNewCall(ASTFctCallNode* node) {
    assert node.fqFunctionName == BUILTIN_FCT_NAME_NEW;

    const FctCallData& data = node.data.get(this.manIdx);
    const QualType& templateType = data.templateTypes.front();

    // Allocate sizeof(T) bytes on the heap
    const llvm::Type llvmType = templateType.toLLVMType(this.sourceFile);
    const unsigned long typeSize = this.module.getTypeAllocSize(llvmType);
    const llvm::Function allocFct = this.stdFunctionManager.getAllocUnsafeLongFct();
    Vector<llvm::Value> allocArgs;
    allocArgs.pushBack(this.builder.getInt64(typeSize));
    const llvm::Value targetPtr = this.builder.createCall(allocFct, allocArgs);

    // Call the constructor if one was resolved during type checking
    const model::Function* ctor = data.callee;
    if ctor != nil<const model::Function*> {
        Vector<llvm::Value> ctorArgValues;
        if node.hasArgs {
            const QualTypeList paramTypes = ctor.getParamTypes();
            for unsigned long i = 0l; i < node.argLst.args.getSize(); i++ {
                IVisitable* argNode = node.argLst.args.get(i);
                const QualType& paramType = paramTypes.get(i);
                if paramType.isRef() {
                    ctorArgValues.pushBack(this.resolveAddress(argNode));
                } else {
                    ctorArgValues.pushBack(this.resolveValue(argNode));
                }
            }
        }
        this.generateCtorOrDtorCall(targetPtr, ctor, ctorArgValues);
    } else {
        llvm::Value initVal;
        if node.hasArgs {
            initVal = this.resolveValue(node.argLst.args.front());
        } else {
            initVal = this.getDefaultValueForSymbolType(templateType);
        }
        this.insertStore(initVal, targetPtr);
    }

    return exprResultAny(exprResultWithValue(targetPtr));
}

f<Any> IRGenerator.visitBuiltinPlacementNewCall(ASTFctCallNode* node) {
    assert node.fqFunctionName == BUILTIN_FCT_NAME_PLACEMENT_NEW;

    const FctCallData& data = node.data.get(this.manIdx);

    // Resolve the target address from the first argument (the byte* pointer)
    const llvm::Value targetPtr = this.resolveValue(node.argLst.args.front());

    // Call the constructor if one was resolved during type checking
    const model::Function* ctor = data.callee;
    if ctor != nil<const model::Function*> {
        Vector<llvm::Value> ctorArgValues;
        const QualTypeList paramTypes = ctor.getParamTypes();
        for unsigned long i = 1l; i < node.argLst.args.getSize(); i++ {
            IVisitable* argNode = node.argLst.args.get(i);
            const QualType& paramType = paramTypes.get(i - 1l);
            if paramType.isRef() {
                ctorArgValues.pushBack(this.resolveAddress(argNode));
            } else {
                ctorArgValues.pushBack(this.resolveValue(argNode));
            }
        }
        this.generateCtorOrDtorCall(targetPtr, ctor, ctorArgValues);
    } else {
        const QualType& templateType = data.templateTypes.front();
        const Vector<IVisitable*>& args = node.argLst.args;
        llvm::Value initVal;
        if args.getSize() > 1l {
            initVal = this.resolveValue(args.get(1l));
        } else {
            initVal = this.getDefaultValueForSymbolType(templateType);
        }
        this.insertStore(initVal, targetPtr);
    }

    return exprResultAny(exprResultWithValue(targetPtr));
}

f<Any> IRGenerator.visitBuiltinErrTraceBufferCall(ASTFctCallNode* node) {
    assert node.fqFunctionName == BUILTIN_FCT_NAME_ERR_TRACE_BUFFER;

    // Get or create the thread-local ErrorTraceBuffer instance for this module. It is only ever referenced from
    // within error_trace_rt.spice's own wrapper procedures (all compiled into this same module), so internal
    // linkage is enough - no other module ever needs to see this symbol.
    const string tlsGlobalName = "__spice_errTraceBufferTLS";
    llvm::Value tlsBuffer = this.module.getNamedGlobal(tlsGlobalName);
    if tlsBuffer.isNull() {
        const QualType evaluatedType = this.getEvaluatedType(cast<IVisitable*>(node));
        const QualType bufferSType = evaluatedType.removeReferenceWrapper();
        const llvm::Type bufferType = bufferSType.toLLVMType(this.sourceFile);
        const llvm::Value zeroInit = llvm::getNullValue(bufferType);
        tlsBuffer = this.module.addGlobal(bufferType, tlsGlobalName);
        tlsBuffer.setConstant(false);
        tlsBuffer.setLinkage(llvm::LLVMLinkage::InternalLinkage);
        tlsBuffer.setInitializer(zeroInit);
        tlsBuffer.setThreadLocal(true);
    }

    return exprResultAny(exprResultWithPtr(tlsBuffer));
}

f<Any> IRGenerator.visitBuiltinStdErrCall(ASTFctCallNode* node) {
    assert node.fqFunctionName == BUILTIN_FCT_NAME_STDERR;

    return exprResultAny(exprResultWithValue(this.getStdErrValue()));
}

/**
 * Emits a call to LLVM's target-independent 'llvm.frameaddress' intrinsic at level 0, yielding the frame address
 * (saved frame-pointer slot) of whichever Spice function this builtin call is inlined into - the same value as
 * C's `__builtin_frame_address(0)`.
 *
 * Frame pointers are kept for every Spice function we emit (see 'frame-pointer' in IRGenerator::addCommonFctAttrs),
 * so the returned address is a real frame address. That does NOT make a frame-pointer chain walkable in general:
 * the layout of the slots around it is target- and ABI-specific, and on Windows x64 in particular there is no
 * saved-frame-pointer chain at all, since the frame pointer points into the middle of the frame and unwinding goes
 * through the .pdata/.xdata tables instead. Anything that needs an actual call stack must go through the platform
 * unwinder rather than walking from this value.
 */
f<Any> IRGenerator.visitBuiltinFrameAddressCall(ASTFctCallNode* node) {
    assert node.fqFunctionName == BUILTIN_FCT_NAME_FRAME_ADDRESS;

    Vector<llvm::Type> overloadTypes;
    overloadTypes.pushBack(this.builder.getPtrTy());
    const llvm::Function frameAddressFct = this.module.getIntrinsicDeclaration("llvm.frameaddress", overloadTypes);
    // Level 0 = this frame; LLVM does not guarantee levels > 0 work on every target.
    Vector<llvm::Value> args;
    args.pushBack(this.getInt32(0l));
    const llvm::Value frameAddress = this.builder.createCall(frameAddressFct, args);

    return exprResultAny(exprResultWithValue(frameAddress));
}

/**
 * Retrieves the process's stderr stream (FILE*). Spice has no syntax for declaring an external variable, so this
 * reaches the real libc symbol directly, the same way on every platform: an ACRT accessor call on Windows, and
 * the platform-specific extern global everywhere else.
 */
f<llvm::Value> IRGenerator.getStdErrValue() {
    const llvm::Type ptrTy = this.builder.getPtrTy();

    if this.cliOptions.targetTriple.isOSWindows() {
        const llvm::Function getAcrtIOFuncFct = this.stdFunctionManager.getAcrtIOFuncFct();
        Vector<llvm::Value> args;
        args.pushBack(this.getInt32(2l)); // Constant for stderr
        return this.builder.createCall(getAcrtIOFuncFct, args);
    }

    const string globalName = this.cliOptions.targetTriple.isOSDarwin() ? "__stderrp" : "stderr";
    llvm::Value stdErrPtr = this.module.getNamedGlobal(globalName);
    if stdErrPtr.isNull() {
        stdErrPtr = this.module.getOrInsertGlobal(globalName, ptrTy);
        stdErrPtr.setLinkage(llvm::LLVMLinkage::ExternalLinkage);
        stdErrPtr.setUnnamedAddr(llvm::LLVMUnnamedAddr::LocalUnnamedAddr);
        stdErrPtr.setAlignment(8);
    }
    return this.insertLoad(ptrTy, stdErrPtr);
}

// ===================================================== Implicit functions ======================================================

f<llvm::Value> IRGenerator.doImplicitCast(llvm::Value src, const QualType& origDstSTy, const QualType& origSrcSTy) {
    assert !origSrcSTy.matches(origDstSTy, false, false, false); // We only need to cast implicitly, if the types do not match exactly
    QualType dstSTy = origDstSTy;
    QualType srcSTy = origSrcSTy;

    // Unpack the pointers until a pointer of another type is met
    unsigned long loadCounter = 0l;
    while srcSTy.isPtr() {
        src = this.insertLoad(srcSTy, src);
        srcSTy = srcSTy.getContained();
        dstSTy = dstSTy.getContained();
        loadCounter++;
    }
    // GEP or bit-cast
    if dstSTy.isArray() && srcSTy.isArray() { // Special case that is used for passing arrays as pointer to functions
        Vector<llvm::Value> indices;
        indices.pushBack(this.getInt64(0l));
        indices.pushBack(this.getInt32(0l));
        src = this.insertInBoundsGEP(srcSTy.toLLVMType(this.sourceFile), src, indices);
    } else {
        src = this.insertLoad(srcSTy, src);
        src = this.builder.createBitCast(src, dstSTy.toLLVMType(this.sourceFile));
    }
    // Pack the pointers together again
    while loadCounter > 0l {
        const llvm::Value newActualArg = this.insertAlloca(srcSTy);
        this.insertStore(src, newActualArg);
        src = newActualArg;
        loadCounter--;
    }
    return src;
}

public f<llvm::Value> IRGenerator.getUpcastedStructPtr(llvm::Value structPtr, const QualType& dstType, const QualType& srcType) {
    // Adjusts a pointer to a struct instance so it points at the embedded subobject the destination type
    // refers to. This backs the explicit 'cast<Base*>(derived)' / 'cast<Interface*>(struct)' conversions.
    // When the struct carries a vtable prefix (because it implements interfaces), the composed base no longer
    // sits at offset 0, so the pointer has to be advanced via a GEP. For subobjects that already sit at offset
    // 0 (e.g. the leading interface field), insertStructGEP() with index 0 is a no-op and returns the pointer
    // unchanged, so no superfluous IR is emitted. If the given pair of types is not such an upcast, the
    // pointer is returned unchanged.
    QualType dstPointee = dstType.removeReferenceWrapper();
    QualType srcPointee = srcType.removeReferenceWrapper();
    // Both sides are pointers ('structPtr' is the pointer value itself), so look one level deeper
    if dstPointee.isPtr() && srcPointee.isPtr() {
        dstPointee = dstPointee.getContained();
        srcPointee = srcPointee.getContained();
    }
    // Bail out if this is not an interface/composed-base upcast that requires a pointer adjustment
    if !srcPointee.is(SuperType::TY_STRUCT) {
        return structPtr;
    }
    if !dstPointee.matchesInterfaceImplementedByStruct(srcPointee) && !dstPointee.matchesComposedBaseOfStruct(srcPointee) {
        return structPtr;
    }

    QualType walkType = srcPointee;
    while !walkType.matches(dstPointee, false, true, true) {
        assert walkType.is(SuperType::TY_STRUCT);
        Scope* structScope = walkType.getBodyScope();
        assert structScope != nil<Scope*>;
        const Struct* spiceStruct = walkType.getStruct(nil<ASTNode*>);
        assert spiceStruct != nil<const Struct*>;
        const llvm::Type llvmStructType = walkType.toLLVMType(this.sourceFile);
        // Implicit (interface) fields are inserted before the explicit fields, so their count is the difference
        // between the total field count and the number of explicit fields.
        const unsigned long implicitFieldCount = structScope.getFieldCount() - spiceStruct.fieldTypes.getSize();

        // Case 1: the destination is an interface implemented directly by the struct -> step into its implicit field
        if dstPointee.is(SuperType::TY_INTERFACE) {
            bool found = false;
            for unsigned long i = 0l; i < implicitFieldCount; i++ {
                const SymbolTableEntry* implicitField = structScope.lookupField(cast<unsigned int>(i));
                if dstPointee.matches(implicitField.getQualType(), false, true, true) {
                    structPtr = this.insertStructGEP(llvmStructType, structPtr, cast<unsigned int>(spiceStruct.getFieldElementIndex(implicitField.orderIndex)));
                    found = true;
                    break;
                }
            }
            assert found;
            return structPtr;
        }

        // Case 2: the destination is a composed base struct -> step into the first explicit (composed) field
        const SymbolTableEntry* baseField = structScope.lookupField(cast<unsigned int>(implicitFieldCount));
        assert baseField != nil<const SymbolTableEntry*>;
        const QualType& baseFieldType = baseField.getQualType();
        assert baseFieldType.isComposition();
        structPtr = this.insertStructGEP(llvmStructType, structPtr, cast<unsigned int>(spiceStruct.getFieldElementIndex(baseField.orderIndex)));
        walkType = baseFieldType;
    }
    return structPtr;
}

/**
 * Generate cleanup code (dtor calls, deallocations, lifetime end markers) for the scope of the given statement list, which is
 * the current scope
 *
 * @param node Statement list of the scope
 * @param returnedLocal Local variable, that is handed over to the caller by a return statement. It must not be destructed.
 *                      Nil if there is none.
 */
p IRGenerator.generateScopeCleanup(ASTStmtLstNode* node, SymbolTableEntry* returnedLocal = nil<SymbolTableEntry*>) {
    this.generateScopeCleanup(node.resourcesToCleanup.get(this.manIdx), this.currentScope, node.closingBraceCodeLoc, returnedLocal);
}

/**
 * Generate cleanup code (dtor calls, deallocations, lifetime end markers) for the given scope
 *
 * @param resources Resources to clean up, as determined by the type checker
 * @param scope Scope to clean up
 * @param codeLoc Code location to attribute the cleanup code to
 * @param returnedLocal Local variable, that is handed over to the caller by a return statement. It must not be destructed.
 *                      Nil if there is none.
 */
p IRGenerator.generateScopeCleanup(const ResourcesForManifestationToCleanup& resources, Scope* scope, const CodeLoc& codeLoc, SymbolTableEntry* returnedLocal = nil<SymbolTableEntry*>) {
    this.diGenerator.setSourceLocation(codeLoc);

    // Do not clean up if the block is already terminated
    if this.blockAlreadyTerminated {
        return;
    }

    // Call all dtor functions
    const Vector<llvm::Value> noArgs;
    foreach const Pair<SymbolTableEntry*, model::Function*>& dtorToCall : resources.dtorFunctionsToCall {
        if dtorToCall.getFirst() != returnedLocal {
            this.generateCtorOrDtorCall(dtorToCall.getFirst(), dtorToCall.getSecond(), noArgs);
        }
    }

    // Deallocate all heap variables that go out of scope and are currently owned
    foreach const SymbolTableEntry* entry : resources.heapVarsToFree {
        this.generateDeallocCall(this.getAddress(entry));
    }

    // Generate lifetime end markers
    if this.cliOptions.useLifetimeMarkers {
        const Vector<SymbolTableEntry*> varsGoingOutOfScope = scope.getVarsGoingOutOfScope();
        foreach const SymbolTableEntry* var : varsGoingOutOfScope {
            const llvm::Value address = this.getAddress(var);
            // Only allocas get a lifetime start marker and llvm.lifetime.end rejects anything else. This excludes e.g. the phi
            // of a ternary with a reference result, which refers to the storage of one of its operands.
            if !address.isNull() && address.isAllocaInst() {
                this.createLifetimeMarker("llvm.lifetime.end", address);
            }
        }
    }
}

/**
 * Generate cleanup code for the head scope of a for or foreach loop, which holds the variables declared in the head of the
 * loop. Those live for the whole loop, so this is generated where the loop is left, not at the end of each round.
 *
 * @param loopNode For or foreach loop node
 * @param headScope Head scope of the loop
 * @param returnedLocal Local variable, that is handed over to the caller by a return statement. It must not be destructed.
 *                      Nil if there is none.
 */
p IRGenerator.generateLoopHeadCleanup(ASTNode* loopNode, Scope* headScope, SymbolTableEntry* returnedLocal = nil<SymbolTableEntry*>) {
    assert headScope.scopeType == ScopeType::LOOP_HEAD;
    if loopNode.kind == ASTNodeKind::FOR_LOOP {
        ASTForLoopNode* forLoopNode = downcast<ASTForLoopNode>(loopNode);
        const ASTStmtLstNode* body = downcast<ASTStmtLstNode>(getASTNode(forLoopNode.body));
        const ResourcesForManifestationToCleanup& resources = forLoopNode.headResourcesToCleanup.get(this.manIdx);
        this.generateScopeCleanup(resources, headScope, body.closingBraceCodeLoc, returnedLocal);
    } else {
        assert loopNode.kind == ASTNodeKind::FOREACH_LOOP;
        ASTForeachLoopNode* foreachLoopNode = downcast<ASTForeachLoopNode>(loopNode);
        const ASTStmtLstNode* body = downcast<ASTStmtLstNode>(getASTNode(foreachLoopNode.body));
        const ResourcesForManifestationToCleanup& resources = foreachLoopNode.headResourcesToCleanup.get(this.manIdx);
        this.generateScopeCleanup(resources, headScope, body.closingBraceCodeLoc, returnedLocal);
    }
}

/**
 * Generate the dtor calls for the temporaries of an expression scope. Those were determined by the type checker.
 *
 * @param exprScope Expression scope to generate the dtor calls for
 * @param node Expression the scope belongs to
 */
p IRGenerator.generateTemporariesCleanup(const Scope* exprScope, ASTNode* node) {
    if exprScope.temporaryDtorsToCall.isEmpty() {
        return;
    }
    this.diGenerator.setSourceLocation(node);
    const Vector<llvm::Value> noArgs;
    foreach const Pair<SymbolTableEntry*, model::Function*>& dtorToCall : exprScope.temporaryDtorsToCall {
        this.generateCtorOrDtorCall(dtorToCall.getFirst(), dtorToCall.getSecond(), noArgs);
    }
}

/**
 * Get the if, while, do-while, for or foreach statement, if the given node is part of its header, e.g. of its condition.
 *
 * The IR for a header is generated within the scope of its statement, but the header is not part of the body of the statement.
 * Hence, the nearest statement list of a node in the header is the one around the statement, and not the one of that scope.
 *
 * @param node Node to check
 * @return Statement, whose header the node is part of. Nil if the node is not part of a header
 */
f<ASTNode*> getStatementOfHeader(const ASTNode* node) {
    ASTNode* ancestor = node.parent;
    while ancestor != nil<ASTNode*> {
        if ancestor.kind == ASTNodeKind::STMT_LST {
            return nil<ASTNode*>; // The node is part of a body
        }
        const ASTNodeKind kind = ancestor.kind;
        if kind == ASTNodeKind::IF_STMT || kind == ASTNodeKind::WHILE_LOOP || kind == ASTNodeKind::DO_WHILE_LOOP || kind == ASTNodeKind::FOR_LOOP || kind == ASTNodeKind::FOREACH_LOOP {
            return ancestor;
        }
        ancestor = ancestor.parent;
    }
    return nil<ASTNode*>;
}

/**
 * Generate cleanup code (dtor calls, deallocations) for every scope between the given node (exclusive) and the given
 * target scope (inclusive). This is required for jumps that leave more than one scope at once (e.g. break/continue/return),
 * since those skip the normal fall-through cleanup that visitStmtLst() generates for each of the enclosing scopes.
 *
 * The jump can also originate from the middle of an expression (the error propagation operator), which is evaluated in scopes
 * that have no statement list to pair with the scope. These are handled first, so that the scopes and statement lists match up
 * for the rest of the way.
 *
 * @param node Node the jump originates from
 * @param targetScope Outermost scope that is left by the jump; cleanup is generated for this scope as well
 * @param returnedLocal Local variable, that is handed over to the caller by the jump (a return statement). It must not be
 *                      destructed. Nil if there is none.
 */
p IRGenerator.generateScopeCleanupUpTo(ASTNode* node, const Scope* targetScope, SymbolTableEntry* returnedLocal = nil<SymbolTableEntry*>) {
    assert targetScope != nil<const Scope*>;
    Scope* scopeLevel = this.currentScope;

    // Leave the expression scopes, which hold the temporaries of the expression that is evaluated. Only the ones that were already
    // constructed are destructed here, since the others do not have an address yet
    while scopeLevel.scopeType == ScopeType::EXPR_BODY {
        this.generateTemporariesCleanup(scopeLevel, node);
        scopeLevel = scopeLevel.parent;
    }

    // Leave the scope of the statement, if the jump originates from its header. The body was not entered yet, or it was already
    // left, so there is nothing of it to clean up. The head of a for or foreach loop has a scope of its own though, which holds
    // the variables the head declares. Those are alive while the head is evaluated.
    ASTNode* headerStatement = getStatementOfHeader(node);
    if scopeLevel != targetScope && headerStatement != nil<ASTNode*> {
        if scopeLevel.scopeType == ScopeType::LOOP_HEAD {
            this.generateLoopHeadCleanup(headerStatement, scopeLevel, returnedLocal);
        }
        scopeLevel = scopeLevel.parent;
    }

    ASTStmtLstNode* scope = node.getNextOuterStmtLst();
    while true {
        this.generateScopeCleanup(scope.resourcesToCleanup.get(this.manIdx), scopeLevel, scope.closingBraceCodeLoc, returnedLocal);
        if scopeLevel == targetScope {
            break;
        }
        assert scope.parent != nil<ASTNode*> && scopeLevel.parent != nil<Scope*>;
        scopeLevel = scopeLevel.parent;
        // The head of a for or foreach loop is a scope of its own, which has no statement list. The loop owns the statement list
        // of its body, which was cleaned up just now
        if scopeLevel.scopeType == ScopeType::LOOP_HEAD {
            this.generateLoopHeadCleanup(scope.parent, scopeLevel, returnedLocal);
            assert scopeLevel != targetScope && scopeLevel.parent != nil<Scope*>;
            scopeLevel = scopeLevel.parent;
        }
        scope = scope.parent.getNextOuterStmtLst();
    }
}

p IRGenerator.generateFctDecl(const model::Function* fct, const Vector<llvm::Value>& args) {
    // Retrieve metadata for the function
    const String mangledName = fct.getMangledName();

    // Function is not defined in the current module -> declare it
    const llvm::Function existingFct = this.module.getFunction(mangledName.getRaw());
    if existingFct.isNull() {
        Vector<llvm::Type> paramTypes;
        foreach const llvm::Value& argValue : args {
            paramTypes.pushBack(argValue.getType());
        }
        assert fct.isProcedure();
        const llvm::Type fctType = llvm::getFunctionType(this.builder.getVoidTy(), paramTypes, false);
        this.module.getOrInsertFunction(mangledName.getRaw(), fctType);

        if fct.isMethod() {
            // Get callee function
            llvm::Function callee = this.module.getFunction(mangledName.getRaw());
            assert !callee.isNull();

            // Set attributes to 'this' param
            // Get 'this' entry
            const SymbolTableEntry* thisEntry = fct.bodyScope.lookupStrict(String(THIS_VARIABLE_NAME));
            assert thisEntry != nil<const SymbolTableEntry*>;
            const QualType& thisType = thisEntry.getQualType();
            const QualType structSType = thisType.getContained();
            const llvm::Type structType = structSType.toLLVMType(this.sourceFile);
            assert !structType.isNull();
            callee.addParamAttr(0, "noundef");
            callee.addParamAttr(0, "nonnull");
            callee.addDereferenceableParamAttr(0, this.module.getTypeStoreSize(structType));
            callee.addParamAttr(0, "align", cast<unsigned long>(this.module.getABITypeAlign(structType)));
        }
    }
}

#[ignoreUnusedReturnValue]
f<llvm::Value> IRGenerator.generateFctCall(const model::Function* fct, const Vector<llvm::Value>& args) {
    // Retrieve metadata for the function
    const String mangledName = fct.getMangledName();

    // Get callee function
    const llvm::Function callee = this.module.getFunction(mangledName.getRaw());
    assert !callee.isNull();

    // Generate function call
    llvm::Value callInst = this.builder.createCall(callee, args);

    // Set attributes to 'this' param
    if fct.isMethod() {
        // Get 'this' entry
        const SymbolTableEntry* thisEntry = fct.bodyScope.lookupStrict(String(THIS_VARIABLE_NAME));
        assert thisEntry != nil<const SymbolTableEntry*>;
        const QualType& thisType = thisEntry.getQualType();
        const QualType structSType = thisType.getContained();
        const llvm::Type structType = structSType.toLLVMType(this.sourceFile);
        assert !structType.isNull();
        callInst.addCallParamAttr(0, "noundef");
        callInst.addCallParamAttr(0, "nonnull");
        callInst.addCallDereferenceableParamAttr(0, this.module.getTypeStoreSize(structType));
        callInst.addCallParamAttr(0, "align", cast<unsigned long>(this.module.getABITypeAlign(structType)));
    }

    return callInst;
}

p IRGenerator.generateProcDeclAndCall(const model::Function* proc, const Vector<llvm::Value>& args) {
    this.generateFctDecl(proc, args);
    this.generateFctCall(proc, args);
}

p IRGenerator.generateCtorOrDtorCall(const SymbolTableEntry* entry, const model::Function* ctorOrDtor, const Vector<llvm::Value>& args) {
    // Retrieve address of the struct variable. For fields this is the 'this' variable, otherwise use the normal address
    llvm::Value structAddr;
    if entry.isField() {
        // Take 'this' var as base pointer
        const SymbolTableEntry* thisVar = this.currentScope.lookupStrict(String(THIS_VARIABLE_NAME));
        assert thisVar != nil<const SymbolTableEntry*>;
        const QualType& thisVarType = thisVar.getQualType();
        assert thisVarType.isPtr();
        const QualType thisStructType = thisVarType.getContained();
        assert thisStructType.is(SuperType::TY_STRUCT);
        const Struct* spiceStruct = thisStructType.getStruct(entry.declNode);
        assert spiceStruct != nil<const Struct*>;
        const llvm::Type thisType = thisStructType.toLLVMType(this.sourceFile);
        const llvm::Value thisPtr = this.insertLoad(this.builder.getPtrTy(), this.getAddress(thisVar));
        // Add field offset
        structAddr = this.insertStructGEP(thisType, thisPtr, cast<unsigned int>(spiceStruct.getFieldElementIndex(entry.orderIndex)));
    } else {
        structAddr = this.getAddress(entry);
        // For optional parameter initializers we need this exception
        if structAddr.isNull() {
            return;
        }
    }
    assert !structAddr.isNull();
    this.generateCtorOrDtorCall(structAddr, ctorOrDtor, args);
}

p IRGenerator.generateCtorOrDtorCall(llvm::Value structAddr, const model::Function* ctorOrDtor, const Vector<llvm::Value>& args) {
    // Build parameter list
    Vector<llvm::Value> argValues;
    argValues.pushBack(structAddr);
    foreach const llvm::Value& arg : args {
        argValues.pushBack(arg);
    }

    // Generate function call
    this.generateProcDeclAndCall(ctorOrDtor, argValues);
}

p IRGenerator.generateDeallocCall(llvm::Value variableAddress) {
    // Abort if the address is not set. This can happen when leaving the scope of a dtor, which already freed the heap memory
    if variableAddress.isNull() {
        return;
    }

    // In case of string runtime, call free manually. Otherwise, use the memory_rt implementation of sDealloc()
    Vector<llvm::Value> args;
    args.pushBack(variableAddress);
    if this.sourceFile.isStringRT() {
        const llvm::Function freeFct = this.stdFunctionManager.getFreeFct();
        this.builder.createCall(freeFct, args);
    } else {
        const llvm::Function deallocFct = this.stdFunctionManager.getDeallocBytePtrRefFct();
        this.builder.createCall(deallocFct, args);
    }
}

/**
 * Prologue of an implicit function or procedure. The body is generated between this prologue and endImplicitFunction() at the
 * call site.
 *
 * @param spiceFunc Spice function or procedure
 * @param isFunction Function or procedure
 * @return LLVM function or nil, if the function is unused and therefore not generated
 */
f<llvm::Function> IRGenerator.beginImplicitFunction(const model::Function* spiceFunc, bool isFunction) {
    // Only focus on method procedures
    const ASTNode* node = spiceFunc.entry.declNode;
    if isFunction {
        assert spiceFunc.isFunction();
    } else {
        assert node != nil<const ASTNode*>;
        assert spiceFunc.isProcedure();
    }

    // Only generate if used
    if !spiceFunc.used {
        return llvm::Function();
    }

    // Retrieve return type
    llvm::Type returnType = this.builder.getVoidTy();
    if isFunction {
        returnType = spiceFunc.returnType.toLLVMType(this.sourceFile);
    }

    // Get 'this' entry
    Vector<llvm::Type> paramTypes;
    const SymbolTableEntry* thisEntry = nil<const SymbolTableEntry*>;
    if spiceFunc.isMethod() {
        thisEntry = spiceFunc.bodyScope.lookupStrict(String(THIS_VARIABLE_NAME));
        assert thisEntry != nil<const SymbolTableEntry*>;
        paramTypes.pushBack(this.builder.getPtrTy());
    }

    // Get parameter types
    foreach const model::Param& param : spiceFunc.paramList {
        assert !param.isOptional;
        paramTypes.pushBack(param.qualType.toLLVMType(this.sourceFile));
    }

    // Get function linkage
    const QualType& entryType = spiceFunc.entry.getQualType();
    const bool isPublic = entryType.isPublic();

    // Create function or implement a forward declaration that an earlier call site already inserted for this mangled
    // name (e.g. another struct's ctor preamble calling this default member before it got its own definition here).
    // Unconditionally calling llvm::Function::Create would not find that declaration - LLVM auto-renames the new,
    // colliding GlobalValue instead of merging with it, leaving the original declaration (and every call to it)
    // permanently undefined.
    const String mangledName = spiceFunc.getMangledName();
    const llvm::Type fctType = llvm::getFunctionType(returnType, paramTypes, false);
    this.module.getOrInsertFunction(mangledName.getRaw(), fctType);
    llvm::Function fct = this.module.getFunction(mangledName.getRaw());
    assert fct.isEmpty();
    fct.setLinkage(this.getSymbolLinkageType(isPublic));
    fct.addFnAttr("mustprogress");
    this.addCommonFctAttrs(fct);

    // Set attributes to 'this' param
    if spiceFunc.isMethod() {
        fct.addParamAttr(0, "noundef");
        fct.addParamAttr(0, "nonnull");
        assert thisEntry != nil<const SymbolTableEntry*>;
        const QualType& thisType = thisEntry.getQualType();
        const QualType structSType = thisType.getContained();
        const llvm::Type structType = structSType.toLLVMType(this.sourceFile);
        assert !structType.isNull();
        fct.addDereferenceableParamAttr(0, this.module.getTypeStoreSize(structType));
        fct.addParamAttr(0, "align", cast<unsigned long>(this.module.getABITypeAlign(structType)));
    }

    // Add debug info
    this.diGenerator.generateFunctionDebugInfo(fct, spiceFunc);
    if node != nil<const ASTNode*> {
        this.diGenerator.setSourceLocation(node);
    }

    // Change to body scope
    this.compilerPass.changeToScope(spiceFunc.getScopeName(), ScopeType::FUNC_PROC_BODY);

    // Create entry block
    const llvm::BasicBlock bEntry = this.createBlock();
    this.switchToBlock(bEntry, fct);

    // Reset alloca insert markers to this block
    this.allocaInsertBlock = bEntry;
    this.allocaInsertInst = llvm::Value();

    // Store first argument to 'this' symbol
    if spiceFunc.isMethod() {
        assert thisEntry != nil<const SymbolTableEntry*>;
        // Allocate space for the parameter
        const llvm::Value thisAddress = this.insertAlloca(paramTypes.front(), String(THIS_VARIABLE_NAME));
        // Update the symbol table entry
        this.updateAddress(thisEntry, thisAddress);
        // Generate debug info
        this.diGenerator.generateLocalVarDebugInfo(String(THIS_VARIABLE_NAME), thisAddress, 1l);
        // Store the value at the new address
        this.insertStore(fct.getArg(0), thisAddress);
    }

    return fct;
}

/**
 * Epilogue of an implicit function or procedure, see beginImplicitFunction()
 *
 * @param spiceFunc Spice function or procedure
 * @param fct LLVM function
 * @param isFunction Function or procedure
 */
p IRGenerator.endImplicitFunction(const model::Function* spiceFunc, llvm::Function fct, bool isFunction) {
    // Create return instruction
    if !isFunction {
        this.builder.createRetVoid();
    }

    // Conclude debug info for function
    this.diGenerator.concludeFunctionDebugInfo();

    // Verify function
    // Use the code location of the declaration node if available. Otherwise, (e.g. in case of test main) use an artificial code loc
    const ASTNode* node = spiceFunc.entry.declNode;
    const CodeLoc codeLoc = node != nil<const ASTNode*> ? node.codeLoc : CodeLoc(1l, 1l, this.sourceFile.filePath.toString());
    this.verifyFunction(fct, codeLoc);

    // Change to parent scope
    this.compilerPass.changeToParentScope(ScopeType::FUNC_PROC_BODY);
}

p IRGenerator.generateCtorBodyPreamble(Scope* bodyScope) {
    // Retrieve struct scope
    Scope* structScope = bodyScope.parent;
    assert structScope != nil<Scope*>;

    // Get struct address
    const SymbolTableEntry* thisEntry = bodyScope.lookupStrict(String(THIS_VARIABLE_NAME));
    assert thisEntry != nil<const SymbolTableEntry*>;
    const llvm::Value thisPtrPtr = this.getAddress(thisEntry);
    assert !thisPtrPtr.isNull();
    llvm::Value thisPtr;
    const QualType& thisType = thisEntry.getQualType();
    const QualType structSymbolType = thisType.getBase();
    const llvm::Type structType = structSymbolType.toLLVMType(this.sourceFile);

    // Store VTable to first struct field if required
    const Struct* spiceStruct = structSymbolType.getStruct(nil<ASTNode*>);
    assert spiceStruct != nil<const Struct*>;
    if !spiceStruct.vTableData.vtable.isNull() {
        assert !spiceStruct.vTableData.vtableType.isNull();
        // Store VTable to field address at index 0
        thisPtr = this.insertLoad(this.builder.getPtrTy(), thisPtrPtr);
        Vector<llvm::Value> indices;
        indices.pushBack(this.getInt64(0l));
        indices.pushBack(this.getInt32(0l));
        indices.pushBack(this.getInt32(2l));
        const llvm::Value gepResult = this.insertInBoundsGEP(spiceStruct.vTableData.vtableType, spiceStruct.vTableData.vtable, indices);
        this.insertStore(gepResult, thisPtr);
    }

    const unsigned long fieldCount = structScope.getFieldCount();
    const Vector<llvm::Value> noArgs;
    for unsigned long fieldIdx = 0l; fieldIdx < fieldCount; fieldIdx++ {
        const SymbolTableEntry* fieldSymbol = structScope.lookupField(cast<unsigned int>(fieldIdx));
        assert fieldSymbol != nil<const SymbolTableEntry*> && fieldSymbol.isField();
        if fieldSymbol.isImplicitField {
            continue;
        }

        // Call ctor for struct fields
        const QualType& fieldType = fieldSymbol.getQualType();
        const ASTFieldNode* fieldNode = downcast<ASTFieldNode>(fieldSymbol.declNode);
        if fieldType.is(SuperType::TY_STRUCT) {
            // Lookup ctor function and call if available
            Scope* matchScope = fieldType.getBodyScope();
            const ArgList noCtorArgs;
            const model::Function* ctorFunction = lookupFunction(matchScope, String(CTOR_FUNCTION_NAME), fieldType, noCtorArgs, false);
            if ctorFunction != nil<const model::Function*> {
                if thisPtr.isNull() {
                    thisPtr = this.insertLoad(this.builder.getPtrTy(), thisPtrPtr);
                }
                const llvm::Value fieldAddress = this.insertStructGEP(structType, thisPtr, cast<unsigned int>(spiceStruct.getFieldElementIndex(fieldIdx)));
                this.generateCtorOrDtorCall(fieldAddress, ctorFunction, noArgs);
            }
            continue;
        }

        // Store default field values
        if fieldNode.defaultValue != nil<IVisitable*> || this.cliOptions.buildMode != BuildMode::RELEASE {
            // Retrieve field address
            if thisPtr.isNull() {
                thisPtr = this.insertLoad(this.builder.getPtrTy(), thisPtrPtr);
            }
            const llvm::Value fieldAddress = this.insertStructGEP(structType, thisPtr, cast<unsigned int>(spiceStruct.getFieldElementIndex(fieldIdx)));
            // Retrieve default value
            llvm::Value value;
            if fieldNode.defaultValue != nil<IVisitable*> {
                // To resolve the default value, we need to temporarily change to the manifestation of the current struct instantiation
                const unsigned long oldManIdx = this.manIdx; // Save manifestation index
                this.manIdx = spiceStruct.manifestationIndex;
                value = this.resolveValue(fieldNode.defaultValue);
                this.manIdx = oldManIdx; // Restore manifestation index
            } else {
                assert this.cliOptions.buildMode == BuildMode::DEBUG || this.cliOptions.buildMode == BuildMode::TEST;
                value = this.getDefaultValueForSymbolType(fieldType);
            }
            // Store default value
            this.insertStore(value, fieldAddress);
        }
    }
}

p IRGenerator.generateDefaultCtor(const model::Function* ctorFunction) {
    assert ctorFunction.implicitDefault && ctorFunction.name == CTOR_FUNCTION_NAME;
    const llvm::Function fct = this.beginImplicitFunction(ctorFunction, false);
    if fct.isNull() {
        return;
    }
    this.generateCtorBodyPreamble(ctorFunction.bodyScope);
    this.endImplicitFunction(ctorFunction, fct, false);
}

p IRGenerator.generateCopyCtorBodyPreamble(const model::Function* copyCtorFunction) {
    // Retrieve struct scope
    Scope* structScope = copyCtorFunction.bodyScope.parent;
    assert structScope != nil<Scope*>;

    // Get struct address
    const SymbolTableEntry* thisEntry = copyCtorFunction.bodyScope.lookupStrict(String(THIS_VARIABLE_NAME));
    assert thisEntry != nil<const SymbolTableEntry*>;
    const llvm::Value thisPtrPtr = this.getAddress(thisEntry);
    assert !thisPtrPtr.isNull();
    llvm::Value thisPtr;
    const QualType& thisType = thisEntry.getQualType();
    const QualType structSType = thisType.getBase();
    const llvm::Type structType = structSType.toLLVMType(this.sourceFile);
    const Struct* spiceStruct = structSType.getStruct(nil<ASTNode*>);
    assert spiceStruct != nil<const Struct*>;

    // Retrieve the value of the original struct, which is the only function parameter
    const llvm::BasicBlock insertBlock = this.builder.getInsertBlock();
    const llvm::Function parentFct = insertBlock.getParent();
    const llvm::Value originalThisPtr = parentFct.getArg(1);

    // The synthesized vtable pointer is no field, so take it over separately
    if spiceStruct.hasSynthesizedVTablePtr() {
        thisPtr = this.insertLoad(this.builder.getPtrTy(), thisPtrPtr);
        const llvm::Value vtablePtr = this.insertLoad(this.builder.getPtrTy(), originalThisPtr);
        this.insertStore(vtablePtr, thisPtr);
    }

    const unsigned long fieldCount = structScope.getFieldCount();
    for unsigned long fieldIdx = 0l; fieldIdx < fieldCount; fieldIdx++ {
        const SymbolTableEntry* fieldSymbol = structScope.lookupField(cast<unsigned int>(fieldIdx));
        assert fieldSymbol != nil<const SymbolTableEntry*> && fieldSymbol.isField();

        // Retrieve the address of the original field (copy source)
        const llvm::Value originalFieldAddress = this.insertStructGEP(structType, originalThisPtr, cast<unsigned int>(spiceStruct.getFieldElementIndex(fieldIdx)));

        const QualType& fieldType = fieldSymbol.getQualType();

        // Call copy ctor for struct fields
        if fieldType.is(SuperType::TY_STRUCT) && !fieldType.isTriviallyCopyable(nil<ASTNode*>) {
            // Lookup copy ctor function and call if available
            Scope* matchScope = fieldType.getBodyScope();
            ArgList args;
            args.pushBack(Pair<QualType, bool>(fieldType.toConstRef(nil<ASTNode*>), false /* we have the field as storage */));
            const model::Function* copyCtor = lookupFunction(matchScope, String(CTOR_FUNCTION_NAME), fieldType, args, false);
            assert copyCtor != nil<const model::Function*>;
            Vector<llvm::Value> ctorArgs;
            ctorArgs.pushBack(originalFieldAddress);
            this.generateCtorOrDtorCall(fieldSymbol, copyCtor, ctorArgs);
            continue;
        }

        // Retrieve the address of the new field (copy dest)
        if thisPtr.isNull() {
            thisPtr = this.insertLoad(this.builder.getPtrTy(), thisPtrPtr);
        }
        const llvm::Value fieldAddress = this.insertStructGEP(structType, thisPtr, cast<unsigned int>(spiceStruct.getFieldElementIndex(fieldIdx)));

        // For owning heap fields, copy the underlying heap storage
        if fieldType.isHeap() {
            assert fieldType.isPtr();
            const QualType pointeeSType = fieldType.getContained();
            const llvm::Type pointeeType = pointeeSType.toLLVMType(this.sourceFile);

            // Retrieve original heap address
            const llvm::Value originalHeapAddress = this.insertLoad(this.builder.getPtrTy(), originalFieldAddress);

            // Initialize the new field with nullptr, so that it stays valid if the original heap address is nullptr
            this.insertStore(llvm::getNullValue(this.builder.getPtrTy()), fieldAddress);

            // Insert check for nullptr
            const llvm::BasicBlock bThen = this.createBlock(String("nullptrcheck.then"));
            const llvm::BasicBlock bExit = this.createBlock(String("nullptrcheck.exit"));
            const llvm::Value condValue = this.builder.createICmp(llvm::LLVMIntPredicate::NE, originalHeapAddress, llvm::getNullValue(this.builder.getPtrTy()));
            this.insertCondJump(condValue, bThen, bExit);

            // Fill then block
            this.switchToBlock(bThen);

            // Allocate new space on the heap
            const llvm::Function unsafeAllocFct = this.stdFunctionManager.getAllocUnsafeLongFct();
            const unsigned long typeSizeInBytes = this.module.getTypeSizeInBits(pointeeType) / 8l;
            Vector<llvm::Value> allocArgs;
            allocArgs.pushBack(this.builder.getInt64(typeSizeInBytes));
            const llvm::Value newHeapAddress = this.builder.createCall(unsafeAllocFct, allocArgs);
            this.insertStore(newHeapAddress, fieldAddress);

            // Copy data from the old heap storage to the new one
            this.generateShallowCopy(originalHeapAddress, pointeeType, newHeapAddress, false);
            this.insertJump(bExit);

            // Switch to exit block
            this.switchToBlock(bExit);

            continue;
        }

        // Shallow copy
        const llvm::Type fieldLLVMType = fieldType.toLLVMType(this.sourceFile);
        this.generateShallowCopy(originalFieldAddress, fieldLLVMType, fieldAddress, false);
    }
}

p IRGenerator.generateDefaultCopyCtor(const model::Function* copyCtorFunction) {
    assert copyCtorFunction.implicitDefault && copyCtorFunction.name == CTOR_FUNCTION_NAME;
    const llvm::Function fct = this.beginImplicitFunction(copyCtorFunction, false);
    if fct.isNull() {
        return;
    }
    this.generateCopyCtorBodyPreamble(copyCtorFunction);
    this.endImplicitFunction(copyCtorFunction, fct, false);
}

p IRGenerator.generateMoveCtorBodyPreamble(const model::Function* moveCtorFunction) {
    // Retrieve struct scope
    Scope* structScope = moveCtorFunction.bodyScope.parent;
    assert structScope != nil<Scope*>;

    // Get struct address
    const SymbolTableEntry* thisEntry = moveCtorFunction.bodyScope.lookupStrict(String(THIS_VARIABLE_NAME));
    assert thisEntry != nil<const SymbolTableEntry*>;
    const llvm::Value thisPtrPtr = this.getAddress(thisEntry);
    assert !thisPtrPtr.isNull();
    llvm::Value thisPtr;
    const QualType& thisType = thisEntry.getQualType();
    const QualType structSType = thisType.getBase();
    const llvm::Type structType = structSType.toLLVMType(this.sourceFile);
    const Struct* spiceStruct = structSType.getStruct(nil<ASTNode*>);
    assert spiceStruct != nil<const Struct*>;

    // Retrieve the value of the original (source) struct, which is the only function parameter
    const llvm::BasicBlock insertBlock = this.builder.getInsertBlock();
    const llvm::Function parentFct = insertBlock.getParent();
    const llvm::Value originalThisPtr = parentFct.getArg(1);

    // The synthesized vtable pointer is no field, so take it over separately
    if spiceStruct.hasSynthesizedVTablePtr() {
        thisPtr = this.insertLoad(this.builder.getPtrTy(), thisPtrPtr);
        const llvm::Value vtablePtr = this.insertLoad(this.builder.getPtrTy(), originalThisPtr);
        this.insertStore(vtablePtr, thisPtr);
    }

    const unsigned long fieldCount = structScope.getFieldCount();
    for unsigned long fieldIdx = 0l; fieldIdx < fieldCount; fieldIdx++ {
        const SymbolTableEntry* fieldSymbol = structScope.lookupField(cast<unsigned int>(fieldIdx));
        assert fieldSymbol != nil<const SymbolTableEntry*> && fieldSymbol.isField();

        // Retrieve the address of the original field (move source)
        const llvm::Value originalFieldAddress = this.insertStructGEP(structType, originalThisPtr, cast<unsigned int>(spiceStruct.getFieldElementIndex(fieldIdx)));

        const QualType& fieldType = fieldSymbol.getQualType();

        // Call move ctor for struct fields if available, otherwise fall back to copy or shallow copy
        if fieldType.is(SuperType::TY_STRUCT) {
            Scope* matchScope = fieldType.getBodyScope();
            // First try to find a move ctor (non-const ref param). We scan the manifestations directly via
            // findMoveCtor rather than FunctionManager::lookup with a non-const ref arg, because lookup permits
            // const-param-to-non-const-arg "constify" matching and may return the copy ctor as a false positive.
            const model::Function* moveCtor = findMoveCtor(matchScope);
            if moveCtor != nil<const model::Function*> {
                Vector<llvm::Value> ctorArgs;
                ctorArgs.pushBack(originalFieldAddress);
                this.generateCtorOrDtorCall(fieldSymbol, moveCtor, ctorArgs);
                continue;
            }
            // No move ctor: fall back to copy ctor for non-trivially copyable types
            if !fieldType.isTriviallyCopyable(nil<ASTNode*>) {
                ArgList copyArgs;
                copyArgs.pushBack(Pair<QualType, bool>(fieldType.toConstRef(nil<ASTNode*>), false));
                const model::Function* copyCtor = lookupFunction(matchScope, String(CTOR_FUNCTION_NAME), fieldType, copyArgs, false);
                assert copyCtor != nil<const model::Function*>;
                Vector<llvm::Value> ctorArgs;
                ctorArgs.pushBack(originalFieldAddress);
                this.generateCtorOrDtorCall(fieldSymbol, copyCtor, ctorArgs);
                continue;
            }
        }

        // Retrieve the address of the new field (move dest)
        if thisPtr.isNull() {
            thisPtr = this.insertLoad(this.builder.getPtrTy(), thisPtrPtr);
        }
        const llvm::Value fieldAddress = this.insertStructGEP(structType, thisPtr, cast<unsigned int>(spiceStruct.getFieldElementIndex(fieldIdx)));

        // For owning heap fields, transfer ownership: copy the pointer to the destination, and null out the source
        if fieldType.isHeap() {
            assert fieldType.isPtr();

            // Load original heap address
            const llvm::Value originalHeapAddress = this.insertLoad(this.builder.getPtrTy(), originalFieldAddress);
            // Store it in the destination field
            this.insertStore(originalHeapAddress, fieldAddress);
            // Null out the source field so its dtor does not free the storage
            this.insertStore(llvm::getNullValue(this.builder.getPtrTy()), originalFieldAddress);

            continue;
        }

        // Shallow copy non-heap, non-struct (or trivially copyable struct) fields
        const llvm::Type fieldLLVMType = fieldType.toLLVMType(this.sourceFile);
        this.generateShallowCopy(originalFieldAddress, fieldLLVMType, fieldAddress, false);
    }
}

p IRGenerator.generateDefaultMoveCtor(const model::Function* moveCtorFunction) {
    assert moveCtorFunction.implicitDefault && moveCtorFunction.name == CTOR_FUNCTION_NAME;
    const llvm::Function fct = this.beginImplicitFunction(moveCtorFunction, false);
    if fct.isNull() {
        return;
    }
    this.generateMoveCtorBodyPreamble(moveCtorFunction);
    this.endImplicitFunction(moveCtorFunction, fct, false);
}

p IRGenerator.generateDtorBodyPreamble(const model::Function* dtorFunction) {
    // Retrieve struct scope
    Scope* structScope = dtorFunction.bodyScope.parent;
    assert structScope != nil<Scope*>;

    // Get struct address
    const SymbolTableEntry* thisEntry = dtorFunction.bodyScope.lookupStrict(String(THIS_VARIABLE_NAME));
    assert thisEntry != nil<const SymbolTableEntry*>;
    const llvm::Value thisPtrPtr = this.getAddress(thisEntry);
    assert !thisPtrPtr.isNull();
    llvm::Value thisPtr;
    const QualType& thisType = thisEntry.getQualType();
    const QualType structSType = thisType.getBase();
    const llvm::Type structType = structSType.toLLVMType(this.sourceFile);
    const Struct* spiceStruct = structSType.getStruct(nil<ASTNode*>);
    assert spiceStruct != nil<const Struct*>;

    const unsigned long fieldCount = structScope.getFieldCount();
    const Vector<llvm::Value> noArgs;
    for unsigned long i = 0l; i < fieldCount; i++ {
        const unsigned long fieldIdx = fieldCount - 1l - i; // Destruct fields in reverse order
        const SymbolTableEntry* fieldSymbol = structScope.lookupField(cast<unsigned int>(fieldIdx));
        assert fieldSymbol != nil<const SymbolTableEntry*> && fieldSymbol.isField();

        // Call dtor for struct fields
        const QualType& fieldType = fieldSymbol.getQualType();
        if fieldType.is(SuperType::TY_STRUCT) {
            // Lookup dtor function and generate call if found
            const ArgList noDtorArgs;
            const model::Function* dtorFct = lookupFunction(fieldType.getBodyScope(), String(DTOR_FUNCTION_NAME), fieldType, noDtorArgs, false);
            if dtorFct != nil<const model::Function*> {
                this.generateCtorOrDtorCall(fieldSymbol, dtorFct, noArgs);
            }
            continue;
        }

        // Deallocate fields, that are stored on the heap
        if fieldType.isHeap() {
            // Retrieve field address
            if thisPtr.isNull() {
                thisPtr = this.insertLoad(this.builder.getPtrTy(), thisPtrPtr);
            }
            const llvm::Value fieldAddress = this.insertStructGEP(structType, thisPtr, cast<unsigned int>(spiceStruct.getFieldElementIndex(fieldIdx)));
            // Call dealloc function
            this.generateDeallocCall(fieldAddress);
        }
    }
}

p IRGenerator.generateDefaultDtor(const model::Function* dtorFunction) {
    assert dtorFunction.implicitDefault && dtorFunction.name == DTOR_FUNCTION_NAME;
    const llvm::Function fct = this.beginImplicitFunction(dtorFunction, false);
    if fct.isNull() {
        return;
    }
    this.generateDtorBodyPreamble(dtorFunction);
    this.endImplicitFunction(dtorFunction, fct, false);
}

p IRGenerator.generateTestMain() {
    // Collect all test functions. Iterate the source files in creation order, so that the tests of the main source file run
    // first, followed by the ones of its dependencies in import order. The order of the source file map depends on the hash
    // function
    Vector<const Vector<const model::Function*>*> tests;
    foreach const SourceFile* testSourceFile : this.resourceManager.sourceFilesInCreationOrder {
        if !testSourceFile.testFunctions.isEmpty() {
            tests.pushBack(&testSourceFile.testFunctions);
        }
    }

    // Prepare printf function
    const llvm::Function printfFct = this.stdFunctionManager.getPrintfFct();

    // Prepare success and error messages
    const CodeLoc& rootCodeLoc = *this.rootScope.codeLoc;
    const llvm::Value allStartMsg = this.createGlobalStringConst(String("allStartMsg"), String(TEST_ALL_START_MSG), rootCodeLoc);
    const llvm::Value allEndMsg = this.createGlobalStringConst(String("allEndMsg"), String(TEST_ALL_END_MSG), rootCodeLoc);
    const llvm::Value fileStartMsg = this.createGlobalStringConst(String("fileStartMsg"), String(TEST_FILE_START_MSG), rootCodeLoc);
    const llvm::Value fileEndMsg = this.createGlobalStringConst(String("fileEndMsg"), String(TEST_FILE_END_MSG), rootCodeLoc);
    const llvm::Value runMsg = this.createGlobalStringConst(String("runMsg"), String(TEST_CASE_RUN_MSG), rootCodeLoc);
    const llvm::Value successMsg = this.createGlobalStringConst(String("successMsg"), String(TEST_CASE_SUCCESS_MSG), rootCodeLoc);
    const llvm::Value errorMsg = this.createGlobalStringConst(String("errorMsg"), String(TEST_CASE_FAILED_MSG), rootCodeLoc);
    const llvm::Value skippedMsg = this.createGlobalStringConst(String("skippedMsg"), String(TEST_CASE_SKIPPED_MSG), rootCodeLoc);

    // Prepare entry for test main
    QualType functionType = QualType(SuperType::TY_FUNCTION);
    functionType.setQualifiers(getTypeQualifiersOf(SuperType::TY_FUNCTION));
    functionType.makePublic();
    SymbolTableEntry entry = SymbolTableEntry(String(MAIN_FUNCTION_NAME), functionType, this.rootScope, nil<ASTNode*>, 0l, false);

    // Prepare test main function
    const model::ParamList noParams;
    const Vector<GenericType> noTemplateTypes;
    model::Function testMain = model::Function(String(MAIN_FUNCTION_NAME), &entry, QualType(SuperType::TY_DYN), QualType(SuperType::TY_INT), noParams, noTemplateTypes, nil<ASTNode*>);
    testMain.used = true; // Mark as used to prevent removal
    testMain.implicitDefault = true;
    testMain.mangleFunctionName = false;

    // Prepare scope
    this.rootScope.createChildScope(testMain.getScopeName(), ScopeType::FUNC_PROC_BODY, nil<CodeLoc*>);

    // Generate
    const llvm::Function fct = this.beginImplicitFunction(&testMain, true);
    if fct.isNull() {
        return;
    }

    // Prepare result variable
    Vector<llvm::Value> testCaseResults;
    testCaseResults.reserve(tests.getSize());

    // Print start message
    unsigned long totalTestCount = 0l;
    foreach const Vector<const model::Function*>* innerVector : tests {
        totalTestCount += innerVector.getSize();
    }
    Vector<llvm::Value> allStartArgs;
    allStartArgs.pushBack(allStartMsg);
    allStartArgs.pushBack(this.getInt32(cast<long>(totalTestCount)));
    allStartArgs.pushBack(this.getInt32(tests.getSize()));
    this.builder.createCall(printfFct, allStartArgs);

    // Generate a call to each test function
    foreach const Vector<const model::Function*>* testSuite : tests {
        // Print test suite prologue
        const model::Function* firstTestFunction = testSuite.front();
        const String& fileName = firstTestFunction.bodyScope.sourceFile.fileName;
        const llvm::Value fileNameValue = this.createGlobalStringConst(String("fileName"), fileName, firstTestFunction.getDeclCodeLoc());
        Vector<llvm::Value> fileStartArgs;
        fileStartArgs.pushBack(fileStartMsg);
        fileStartArgs.pushBack(this.getInt32(testSuite.getSize()));
        fileStartArgs.pushBack(fileNameValue);
        this.builder.createCall(printfFct, fileStartArgs);

        foreach const model::Function* testFunction : *testSuite {
            assert testFunction.isNormalFunction();
            assert testFunction.paramList.isEmpty();

            // Retrieve attribute list for the test function
            assert testFunction.declNode.isFctOrProcDef();
            const ASTFctDefNode* fctDefNode = downcast<ASTFctDefNode>(testFunction.declNode);
            assert fctDefNode.attrs != nil<IVisitable*>;
            const ASTTopLevelDefAttrNode* topLevelDefAttrs = downcast<ASTTopLevelDefAttrNode>(fctDefNode.attrs);
            const ASTAttrLstNode* attrs = topLevelDefAttrs.attrLst;
            const CompileTimeValue testAttrValue = attrs.getAttrValueByName(String(ATTR_TEST));
            assert testAttrValue.getBoolValue(); // The test attribute must be present
            bool skipTest = false;
            if attrs.hasAttr(String(ATTR_TEST_SKIP)) {
                const CompileTimeValue testSkipAttrValue = attrs.getAttrValueByName(String(ATTR_TEST_SKIP));
                skipTest = testSkipAttrValue.getBoolValue();
            }

            // Prepare test name
            String testName = testFunction.name;
            if attrs.hasAttr(String(ATTR_TEST_NAME)) {
                const CompileTimeValue testNameAttrValue = attrs.getAttrValueByName(String(ATTR_TEST_NAME));
                const String& testNameAttr = this.resourceManager.compileTimeStringValues.get(testNameAttrValue.getStringValueOffset());
                testName += " (";
                testName += testNameAttr;
                testName += ")";
            }

            // Print test case run message
            const llvm::Value testNameValue = this.createGlobalStringConst(String("testName"), testName, testFunction.getDeclCodeLoc());
            Vector<llvm::Value> runArgs;
            runArgs.pushBack(runMsg);
            runArgs.pushBack(testNameValue);
            this.builder.createCall(printfFct, runArgs);

            if skipTest {
                // Print test case skip message
                Vector<llvm::Value> skipArgs;
                skipArgs.pushBack(skippedMsg);
                skipArgs.pushBack(testNameValue);
                this.builder.createCall(printfFct, skipArgs);
                continue;
            }

            // Test function is not defined in the current module -> declare it
            const String mangledName = testFunction.getMangledName();
            const llvm::Function existingTestFct = this.module.getFunction(mangledName.getRaw());
            if existingTestFct.isNull() {
                assert testFunction.returnType.is(SuperType::TY_BOOL);
                assert testFunction.paramList.isEmpty();
                const Vector<llvm::Type> noParamTypes;
                const llvm::Type fctType = llvm::getFunctionType(this.builder.getInt1Ty(), noParamTypes, false);
                this.module.getOrInsertFunction(mangledName.getRaw(), fctType);
            }

            // Call test function
            const llvm::Function callee = this.module.getFunction(mangledName.getRaw());
            assert !callee.isNull();
            const Vector<llvm::Value> noArgs;
            const llvm::Value testCaseResult = this.builder.createCall(callee, noArgs);
            testCaseResults.pushBack(testCaseResult);

            // Print test case result message
            const llvm::Value message = this.builder.createSelect(testCaseResult, successMsg, errorMsg);
            Vector<llvm::Value> resultArgs;
            resultArgs.pushBack(message);
            resultArgs.pushBack(testNameValue);
            this.builder.createCall(printfFct, resultArgs);
        }

        // Print test suite epilogue
        Vector<llvm::Value> fileEndArgs;
        fileEndArgs.pushBack(fileEndMsg);
        fileEndArgs.pushBack(this.getInt32(testSuite.getSize()));
        fileEndArgs.pushBack(fileNameValue);
        this.builder.createCall(printfFct, fileEndArgs);
    }

    // Print end message
    Vector<llvm::Value> allEndArgs;
    allEndArgs.pushBack(allEndMsg);
    allEndArgs.pushBack(this.getInt32(cast<long>(totalTestCount)));
    allEndArgs.pushBack(this.getInt32(tests.getSize()));
    this.builder.createCall(printfFct, allEndArgs);

    // Compute overall result
    llvm::Value overallResult = this.builder.getTrue();
    foreach const llvm::Value& testCaseResult : testCaseResults {
        overallResult = this.builder.createAnd(overallResult, testCaseResult);
    }

    // Return code must be 0 for success and 1 for failure, so we need to invert the result and zero extend to 32 bit
    const llvm::Value overallResultNegated = this.builder.createNot(overallResult);
    const llvm::Value exitCode = this.builder.createZExt(overallResultNegated, this.builder.getInt32Ty());
    this.builder.createRet(exitCode);

    this.endImplicitFunction(&testMain, fct, true);
}

// ====================================================== Target dependent =======================================================

f<String> IRGenerator.getSysCallAsmString(unsigned int numRegs) {
    const llvm::Triple& targetTriple = this.cliOptions.targetTriple;
    String asmString;

    // For each OS/architecture we have a mapping of operand index -> register.
    // Operand $0 is the result, so the inputs start at $1.
    if targetTriple.isOSDarwin() {
        if targetTriple.isX86_64() {
            const string[7] regs = ["%rax", "%rdi", "%rsi", "%rdx", "%r10", "%r8", "%r9"];
            for unsigned int i = 0; i < numRegs; i++ {
                asmString += "movq $" + toString(i + 1) + ", " + regs[i] + "\n";
                // macOS x86_64 syscall numbers are offset by 0x2000000 (BSD syscall class). "$$" emits a literal '$'.
                if i == 0 {
                    asmString += "addq $$" + toString(33554432) + ", %rax\n";
                }
            }
            asmString += "syscall\n";
        } else if targetTriple.isAArch64() {
            const string[7] regs = ["x16", "x0", "x1", "x2", "x3", "x4", "x5"];
            for unsigned int i = 0; i < numRegs; i++ {
                asmString += String("mov ") + regs[i] + ", $" + toString(i + 1) + "\n";
            }
            asmString += "svc #0x80\n";
        } else {                                                          // LCOV_EXCL_LINE
            panic(Error("Unsupported macOS target for inline assembly")); // LCOV_EXCL_LINE
        } // LCOV_EXCL_LINE
    } else if targetTriple.isOSLinux() {
        if targetTriple.isX86_64() {
            const string[7] regs = ["%rax", "%rdi", "%rsi", "%rdx", "%r10", "%r8", "%r9"];
            for unsigned int i = 0; i < numRegs; i++ {
                asmString += "movq $" + toString(i + 1) + ", " + regs[i] + "\n";
            }
            asmString += "syscall\n";
        } else if targetTriple.isX86() {
            // The operands are bound to their registers via constraints. The sixth arg belongs into ebp, which may be the frame
            // pointer. Therefore, it is passed in eax, the syscall number is passed via memory and ebp is restored afterwards.
            if numRegs == 7 {
                asmString += "pushl $1\npush %ebp\nmov %eax, %ebp\nmov 4(%esp), %eax\nint $$0x80\npop %ebp\nlea 4(%esp), %esp\n";
            } else {
                asmString += "int $$0x80\n";
            }
        } else if targetTriple.isAArch64() {
            const string[7] regs = ["x8", "x0", "x1", "x2", "x3", "x4", "x5"];
            for unsigned int i = 0; i < numRegs; i++ {
                asmString += String("mov ") + regs[i] + ", $" + toString(i + 1) + "\n";
            }
            asmString += "svc 0\n";
        } else {                                                          // LCOV_EXCL_LINE
            panic(Error("Unsupported Linux target for inline assembly")); // LCOV_EXCL_LINE
        } // LCOV_EXCL_LINE
    } else {                                                    // LCOV_EXCL_LINE
        panic(Error("Unsupported target for inline assembly")); // LCOV_EXCL_LINE
    } // LCOV_EXCL_LINE

    return asmString;
}

f<String> IRGenerator.getSysCallConstraintString(unsigned int numRegs) {
    const llvm::Triple& targetTriple = this.cliOptions.targetTriple;

    // For each OS/architecture we have a mapping of operand index -> register, plus the register holding the result.
    Vector<String> regs;
    String resultReg;
    if targetTriple.isOSDarwin() {
        if targetTriple.isX86_64() {
            const string[7] darwinX86_64Regs = ["rax", "rdi", "rsi", "rdx", "r10", "r8", "r9"];
            for unsigned int i = 0; i < 7; i++ { regs.pushBack(String(darwinX86_64Regs[i])); }
            resultReg = String("rax");
        } else if targetTriple.isAArch64() {
            const string[7] darwinAArch64Regs = ["x16", "x0", "x1", "x2", "x3", "x4", "x5"];
            for unsigned int i = 0; i < 7; i++ { regs.pushBack(String(darwinAArch64Regs[i])); }
            resultReg = String("x0");
        } else {                                                          // LCOV_EXCL_LINE
            panic(Error("Unsupported macOS target for inline assembly")); // LCOV_EXCL_LINE
        } // LCOV_EXCL_LINE
    } else if targetTriple.isOSLinux() {
        if targetTriple.isX86_64() {
            const string[7] linuxX86_64Regs = ["rax", "rdi", "rsi", "rdx", "r10", "r8", "r9"];
            for unsigned int i = 0; i < 7; i++ { regs.pushBack(String(linuxX86_64Regs[i])); }
            resultReg = String("rax");
        } else if targetTriple.isX86() {
            // i386 has too few registers to pass the operands in arbitrary ones, so each operand gets its fixed register.
            // The syscall number is tied to the result in eax. For six args, see getSysCallAsmString.
            const string[5] argRegs = ["ebx", "ecx", "edx", "esi", "edi"];
            String constraints = String("={eax},") + (numRegs == 7 ? "*m" : "0");
            const unsigned int maxReg = numRegs < 6 ? numRegs : 6;
            for unsigned int i = 1; i < maxReg; i++ {
                constraints += String(",{") + argRegs[i - 1] + "}";
            }
            if numRegs == 7 {
                constraints += ",0";
            }
            constraints += ",~{dirflag},~{fpsr},~{flags}";
            return constraints;
        } else if targetTriple.isAArch64() {
            const string[7] linuxAArch64Regs = ["x8", "x0", "x1", "x2", "x3", "x4", "x5"];
            for unsigned int i = 0; i < 7; i++ { regs.pushBack(String(linuxAArch64Regs[i])); }
            resultReg = String("x0");
        } else {                                                          // LCOV_EXCL_LINE
            panic(Error("Unsupported Linux target for inline assembly")); // LCOV_EXCL_LINE
        } // LCOV_EXCL_LINE
    } else {                                                    // LCOV_EXCL_LINE
        panic(Error("Unsupported target for inline assembly")); // LCOV_EXCL_LINE
    } // LCOV_EXCL_LINE

    // Generate a comma-separated constraint string: first the result, then the operand constraints,
    // then the clobbers of the used registers, then extra clobbers.
    // The result is early-clobber, because the asm writes the result register before all inputs are read.
    String constraints = "=&{" + resultReg + "}";
    for unsigned int i = 0; i < numRegs; i++ {
        constraints += ",r";
    }
    for unsigned int i = 0; i < numRegs; i++ {
        const String& reg = regs.get(i);
        if reg != resultReg {
            constraints += ",~{" + reg + "}";
        }
    }
    constraints += ",~{dirflag},~{fpsr},~{flags}";
    return constraints;
}

// =========================================================== VTables ===========================================================

f<llvm::Value> IRGenerator.generateTypeInfoName(StructBase* spiceStruct) {
    // Resolve mangled type info name and mangled global name
    const String globalName = mangleTypeInfoName(spiceStruct);

    // Generate global string constant
    const String mangledName = mangleTypeInfoValue(spiceStruct.name);
    llvm::Value global = this.module.createGlobalString(mangledName, globalName.getRaw());

    // If the output should be comparable, fix alignment to 4 bytes
    if this.cliOptions.comparableOutput {
        global.setAlignment(4);
    }

    const QualType& entryType = spiceStruct.entry.getQualType();
    const bool isPublic = entryType.isPublic();

    // Set global attributes
    global.setConstant(true);
    global.setUnnamedAddr(llvm::LLVMUnnamedAddr::NoUnnamedAddr);
    global.setLinkage(this.getVTableLinkageType(isPublic));
    // ToDo: Set dso_local as soon as the LLVM C API allows it (isSymbolDSOLocal(isPublic))
    this.attachComdatToSymbol(global, globalName, isPublic);

    spiceStruct.vTableData.typeInfoName = global;
    return global;
}

#[ignoreUnusedReturnValue]
f<llvm::Value> IRGenerator.generateTypeInfo(StructBase* spiceStruct) {
    // Generate type info name
    const llvm::Value typeInfoName = this.generateTypeInfoName(spiceStruct);

    // Generate LLVM type for type info
    const String mangledName = mangleTypeInfo(spiceStruct);
    const llvm::Type ptrTy = this.builder.getPtrTy();

    QualTypeList interfaceTypes;
    const QualType& entryType = spiceStruct.entry.getQualType();
    if entryType.is(SuperType::TY_STRUCT) {
        // StructBase is the first member of Struct, so both share the same address
        Struct* spiceStructWithInterfaces = nil<Struct*>;
        unsafe {
            spiceStructWithInterfaces = cast<Struct*>(spiceStruct);
        }
        interfaceTypes = spiceStructWithInterfaces.interfaceTypes;
    }

    // Build type info LLVM type
    Vector<llvm::Type> typeInfoFieldTypes;
    typeInfoFieldTypes.pushBack(ptrTy);
    typeInfoFieldTypes.pushBack(ptrTy);
    for unsigned long i = 0l; i < interfaceTypes.getSize(); i++ {
        typeInfoFieldTypes.pushBack(ptrTy);
    }
    spiceStruct.vTableData.typeInfoType = llvm::getStructType(*this.context, typeInfoFieldTypes);

    // Generate type info values
    llvm::Value typeInfoVTable = llvm::getNullValue(ptrTy);
    if !this.sourceFile.isRttiRT() {
        // Add external global pointer for TypeInfo vtable
        assert this.sourceFile.isRuntimeModuleAvailable(RuntimeModule::RTTI_RT);
        const String typeInfoMangledName = mangleVTable(String("TypeInfo"));
        const llvm::Value typeInfoExtPtr = this.module.getOrInsertGlobal(typeInfoMangledName.getRaw(), ptrTy);
        Vector<llvm::Value> indices;
        indices.pushBack(this.getInt64(2l));
        typeInfoVTable = llvm::getConstInBoundsGEP(ptrTy, typeInfoExtPtr, indices);
    }
    Vector<llvm::Value> fieldValues;
    fieldValues.pushBack(typeInfoVTable);
    fieldValues.pushBack(typeInfoName);
    foreach const QualType& interfaceType : interfaceTypes {
        const Interface* spiceInterface = interfaceType.getInterface(nil<ASTNode*>);
        assert spiceInterface != nil<const Interface*>;
        const String interfaceMangledName = mangleTypeInfo(&spiceInterface.structBase);
        const llvm::Value interfaceGlobal = this.module.getOrInsertGlobal(interfaceMangledName.getRaw(), ptrTy);
        fieldValues.pushBack(interfaceGlobal);
    }
    const llvm::Value typeInfo = llvm::getConstNamedStruct(spiceStruct.vTableData.typeInfoType, fieldValues);

    // Generate global variable
    this.module.getOrInsertGlobal(mangledName.getRaw(), spiceStruct.vTableData.typeInfoType);
    llvm::Value global = this.module.getNamedGlobal(mangledName.getRaw());
    global.setInitializer(typeInfo);

    const bool isPublic = entryType.isPublic();

    // Set global attributes
    global.setConstant(true);
    global.setUnnamedAddr(llvm::LLVMUnnamedAddr::NoUnnamedAddr);
    global.setLinkage(this.getVTableLinkageType(isPublic));
    // ToDo: Set dso_local as soon as the LLVM C API allows it (isSymbolDSOLocal(isPublic))
    global.setAlignment(8);
    this.attachComdatToSymbol(global, mangledName, isPublic);

    spiceStruct.vTableData.typeInfo = global;
    return global;
}

#[ignoreUnusedReturnValue]
f<llvm::Value> IRGenerator.generateVTable(StructBase* spiceStruct) {
    // Generate type info data structures
    this.generateTypeInfo(spiceStruct);

    // Generate VTable type
    spiceStruct.vTableData.vtableType = this.getVTableType(spiceStruct);

    const String mangledName = mangleVTable(spiceStruct);
    this.module.getOrInsertGlobal(mangledName.getRaw(), spiceStruct.vTableData.vtableType);
    llvm::Value global = this.module.getNamedGlobal(mangledName.getRaw());

    const QualType& entryType = spiceStruct.entry.getQualType();
    const bool isPublic = entryType.isPublic();

    // Set global attributes
    global.setConstant(true);
    global.setUnnamedAddr(llvm::LLVMUnnamedAddr::GlobalUnnamedAddr);
    global.setLinkage(this.getVTableLinkageType(isPublic));
    // ToDo: Set dso_local as soon as the LLVM C API allows it (isSymbolDSOLocal(isPublic))
    global.setAlignment(8);
    this.attachComdatToSymbol(global, mangledName, isPublic);

    spiceStruct.vTableData.vtable = global;
    return global;
}

p IRGenerator.generateVTableInitializer(const StructBase* spiceStruct) {
    // Retrieve virtual method count
    assert spiceStruct.scope != nil<Scope*>;
    const Vector<const model::Function*> virtualMethods = spiceStruct.scope.getVirtualMethods();

    // Generate VTable type
    const llvm::Type ptrTy = this.builder.getPtrTy();
    assert !spiceStruct.vTableData.vtableType.isNull();

    // Generate VTable values
    Vector<llvm::Value> arrayValues;
    arrayValues.pushBack(llvm::getNullValue(ptrTy)); // nullptr as safety guard
    arrayValues.pushBack(spiceStruct.vTableData.typeInfo); // TypeInfo to identify the type for the VTable
    foreach const model::Function* virtualMethod : virtualMethods {
        // Methods, that are inherited from an interface default method, are implemented by the default method
        llvm::Function llvmFunc = virtualMethod.isInheritedDefaultMethod() ? this.getOrDeclareDefaultMethod(virtualMethod.defaultMethod) : this.getLLVMFunction(virtualMethod);
        assert spiceStruct.scope.scopeType == ScopeType::INTERFACE || !llvmFunc.isNull();
        // Virtual calls expect the return type of the interface method, so methods with another return type need a thunk
        if !llvmFunc.isNull() && !virtualMethod.virtualReturnType.is(SuperType::TY_DYN) {
            llvmFunc = this.getOrCreateCovariantReturnThunk(virtualMethod, llvmFunc);
        }
        arrayValues.pushBack(!llvmFunc.isNull() ? llvmFunc.asValue() : llvm::getNullValue(ptrTy));
    }

    // Generate VTable struct
    Vector<llvm::Value> fieldValues;
    fieldValues.pushBack(llvm::getConstArray(ptrTy, arrayValues));
    const llvm::Value initializer = llvm::getConstNamedStruct(spiceStruct.vTableData.vtableType, fieldValues);

    const String mangledName = mangleVTable(spiceStruct);
    llvm::Value global = this.module.getNamedGlobal(mangledName.getRaw());
    assert !global.isNull();
    global.setInitializer(initializer);
}

f<llvm::Function> IRGenerator.getOrDeclareDefaultMethod(const model::Function* defaultMethod) {
    assert defaultMethod.isInterfaceDefaultMethod;
    // The default method might be defined in another source file or later in this one -> declare it if required
    const String mangledName = defaultMethod.getMangledName();
    const llvm::Function existing = this.module.getFunction(mangledName.getRaw());
    if !existing.isNull() {
        return existing;
    }

    Vector<llvm::Type> paramTypes;
    paramTypes.pushBack(this.builder.getPtrTy()); // This pointer
    foreach const QualType& paramType : defaultMethod.getParamTypes() {
        paramTypes.pushBack(paramType.getParamLLVMType(this.sourceFile));
    }
    const llvm::Type fctType = this.getFunctionType(defaultMethod.returnType, paramTypes);
    this.module.getOrInsertFunction(mangledName.getRaw(), fctType);
    llvm::Function fct = this.module.getFunction(mangledName.getRaw());
    const ReturnABIInfo returnABI = this.getReturnABIInfo(defaultMethod.returnType);
    if returnABI.isIndirect() {
        this.addSRetParamAttrs(fct, returnABI.memoryType);
    }
    return fct;
}

f<bool> isPublicDefaultMethod(const model::Function* function) {
    return function.isInterfaceDefaultMethod && function.thisType.isPublic();
}

/**
 * Check if the given function is emitted with external linkage and therefore visible to the linker under its mangled name.
 * Default methods of public interfaces are public, because structs in other source files can inherit them. Test functions
 * are public, because the test main calls them
 *
 * @param function Function or procedure
 * @return Exported or not
 */
public f<bool> isExportedFunction(const model::Function* function) {
    const QualType& entryType = function.entry.getQualType();
    if entryType.isPublic() || isPublicDefaultMethod(function) {
        return true;
    }
    if function.declNode.kind != ASTNodeKind::FCT_DEF {
        return false;
    }
    const ASTFctDefNode* fctDefNode = downcast<ASTFctDefNode>(function.declNode);
    if fctDefNode.node.attrs == nil<IVisitable*> {
        return false;
    }
    const ASTTopLevelDefAttrNode* attrs = downcast<ASTTopLevelDefAttrNode>(fctDefNode.node.attrs);
    const String testAttrName = String(ATTR_TEST);
    if !attrs.attrLst.hasAttr(testAttrName) {
        return false;
    }
    const CompileTimeValue testAttrValue = attrs.attrLst.getAttrValueByName(testAttrName);
    return testAttrValue.getBoolValue();
}

f<llvm::Function> IRGenerator.getOrCreateCovariantReturnThunk(const model::Function* method, llvm::Function target) {
    // A struct method may implement an interface method, that returns an interface, by returning a struct, which implements
    // this interface. Virtual calls expect the interface to be returned, which might be returned in another way than the
    // struct. Therefore, the VTable points to a thunk, that calls the method and returns the interface part of the struct.
    const String thunkName = target.getName() + ".covthunk";
    const llvm::Function existing = this.module.getFunction(thunkName.getRaw());
    if !existing.isNull() {
        return existing;
    }

    // Build the thunk signature: the target's params with the return type of the interface method
    const QualType& returnType = method.returnType;
    const QualType& virtualReturnType = method.virtualReturnType;
    const unsigned int targetArgOffset = this.getArgOffset(returnType);
    const llvm::Type targetType = target.getFunctionType();
    const Vector<llvm::Type> targetParamTypes = targetType.getParamTypes();
    Vector<llvm::Type> paramTypes;
    for unsigned long i = cast<unsigned long>(targetArgOffset); i < targetParamTypes.getSize(); i++ {
        paramTypes.pushBack(targetParamTypes.get(i));
    }
    const llvm::Type thunkType = this.getFunctionType(virtualReturnType, paramTypes);
    const llvm::Function thunk = this.module.createFunction(thunkType, llvm::LLVMLinkage::PrivateLinkage, thunkName.getRaw());
    this.addCommonFctAttrs(thunk);
    const ReturnABIInfo returnABI = this.getReturnABIInfo(virtualReturnType);
    if returnABI.isIndirect() {
        this.addSRetParamAttrs(thunk, returnABI.memoryType);
    }

    // Save insert markers, because the thunk body might be emitted in the middle of generating another function
    const llvm::BasicBlock bOrig = this.builder.getInsertBlock();
    const llvm::BasicBlock allocaInsertBlockOrig = this.allocaInsertBlock;
    const llvm::Value allocaInsertInstOrig = this.allocaInsertInst;
    const bool blockAlreadyTerminatedOrig = this.blockAlreadyTerminated;
    const llvm::Metadata debugLocOrig = this.builder.getCurrentDebugLocation();
    this.builder.setCurrentDebugLocation(llvm::Metadata{});

    const llvm::BasicBlock bEntry = this.createBlock(String("entry"));
    this.switchToBlock(bEntry, thunk);
    this.allocaInsertBlock = bEntry;
    this.allocaInsertInst = llvm::Value();

    // Forward all arguments except the sret pointer of the thunk
    const unsigned int thunkArgOffset = this.getArgOffset(virtualReturnType);
    Vector<llvm::Value> fwdArgs;
    fwdArgs.reserve(paramTypes.getSize());
    for unsigned int i = 0; i < cast<unsigned int>(paramTypes.getSize()); i++ {
        fwdArgs.pushBack(thunk.getArg(thunkArgOffset + i));
    }
    llvm::Value resultAddr;
    const llvm::Value call = this.insertCall(target, fwdArgs, returnType, resultAddr);
    if resultAddr.isNull() {
        resultAddr = this.insertAlloca(call.getType());
        this.insertStore(call, resultAddr);
    }

    // Return the interface part of the returned struct
    const llvm::Value interfacePtr = this.getUpcastedStructPtr(resultAddr, virtualReturnType, returnType);
    this.insertReturn(this.insertLoad(virtualReturnType.toLLVMType(this.sourceFile), interfacePtr));

    // Restore insert markers
    if !bOrig.isNull() {
        this.builder.setInsertPoint(bOrig);
    }
    this.builder.setCurrentDebugLocation(debugLocOrig);
    this.blockAlreadyTerminated = blockAlreadyTerminatedOrig;
    this.allocaInsertBlock = allocaInsertBlockOrig;
    this.allocaInsertInst = allocaInsertInstOrig;

    return thunk;
}

f<llvm::Type> IRGenerator.getVTableType(const StructBase* spiceStruct) {
    // Retrieve virtual method count
    const Vector<const model::Function*> virtualMethods = spiceStruct.scope.getVirtualMethods();
    const unsigned long arrayElementCount = virtualMethods.getSize() + 2l; // +2 for nullptr and TypeInfo

    const llvm::Type vtableArrayTy = llvm::getArrayType(this.builder.getPtrTy(), arrayElementCount);
    Vector<llvm::Type> vtableFieldTypes;
    vtableFieldTypes.pushBack(vtableArrayTy);
    return llvm::getStructType(*this.context, vtableFieldTypes, false);
}

f<llvm::Value> IRGenerator.getVTableAddressPoint(const StructBase* spiceStruct) {
    // Look up the VTable by name in the current module instead of using vTableData.vtable. The latter belongs to the
    // module of the source file that defines the struct, so for an imported struct a declaration is inserted instead.
    const llvm::Type vtableType = this.getVTableType(spiceStruct);
    const String mangledName = mangleVTable(spiceStruct);
    const llvm::Value vtable = this.module.getOrInsertGlobal(mangledName.getRaw(), vtableType);

    // The address point of the VTable is behind the nullptr and the TypeInfo
    Vector<llvm::Value> indices;
    indices.pushBack(this.getInt64(0l));
    indices.pushBack(this.getInt32(0l));
    indices.pushBack(this.getInt32(2l));
    return llvm::getConstInBoundsGEP(vtableType, vtable, indices);
}

// ======================================================= Instrumentation =======================================================

p IRGenerator.enableFunctionInstrumentation(llvm::Function function) {
    switch this.cliOptions.instrumentation.sanitizer {
        case Sanitizer::NONE: {} // LCOV_EXCL_LINE
        case Sanitizer::ADDRESS: { function.addFnAttr("sanitize_address"); }
        case Sanitizer::THREAD: { function.addFnAttr("sanitize_thread"); }
        case Sanitizer::MEMORY: { function.addFnAttr("sanitize_memory"); }
        case Sanitizer::TYPE: { function.addFnAttr("sanitize_type"); }
        default: { panic(Error("Unhandled sanitizer type")); } // LCOV_EXCL_LINE
    }
}
