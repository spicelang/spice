// Std imports
import "std/data/vector";
import "std/bindings/llvm/llvm" as llvm;

// Own imports
import "bootstrap/source-file";
import "bootstrap/irgenerator/abi-info";
import "bootstrap/irgenerator/ir-generator";
import "bootstrap/irgenerator/name-mangling";
import "bootstrap/model/function" as model; // Aliased, because Function clashes with llvm::Function
import "bootstrap/ast/ast-nodes";
import "bootstrap/model/generic-type";
import "bootstrap/symboltablebuilder/qual-type";
import "bootstrap/symboltablebuilder/super-type";
import "bootstrap/symboltablebuilder/symbol-table-entry";

/**
 * Helper for the IRGenerator to retrieve the declarations of functions from the C standard library, LLVM intrinsics and the
 * Spice runtime modules
 */
public type StdFunctionManager struct {
    SourceFile* sourceFile
    llvm::IRBuilder* builder
    llvm::Module* module
    IRGenerator* irGenerator
}

public p StdFunctionManager.ctor(SourceFile* sourceFile, llvm::Module* module, IRGenerator* irGenerator) {
    this.sourceFile = sourceFile;
    this.builder = &sourceFile.builder;
    this.module = module;
    this.irGenerator = irGenerator;
}

public f<llvm::Function> StdFunctionManager.getPrintfFct() {
    Vector<llvm::Type> paramTypes;
    paramTypes.pushBack(this.builder.getPtrTy());
    llvm::Function printfFct = this.getFunction("printf", this.builder.getInt32Ty(), paramTypes, true);
    // Set attributes
    printfFct.setUnnamedAddr(llvm::LLVMUnnamedAddr::LocalUnnamedAddr);
    printfFct.addFnAttr("nofree");
    printfFct.addFnAttr("nounwind");
    printfFct.addParamAttr(0, "captures", 0l); // captures(none)
    printfFct.addParamAttr(0, "noundef");
    printfFct.addParamAttr(0, "readonly");
    printfFct.addRetAttr("noundef");
    return printfFct;
}

public f<llvm::Function> StdFunctionManager.getFPrintfFct() {
    Vector<llvm::Type> paramTypes;
    paramTypes.pushBack(this.builder.getPtrTy());
    paramTypes.pushBack(this.builder.getPtrTy());
    llvm::Function fprintfFct = this.getFunction("fprintf", this.builder.getInt32Ty(), paramTypes, true);
    // Set attributes
    fprintfFct.setUnnamedAddr(llvm::LLVMUnnamedAddr::LocalUnnamedAddr);
    fprintfFct.addFnAttr("nofree");
    fprintfFct.addParamAttr(0, "captures", 0l); // captures(none)
    fprintfFct.addParamAttr(0, "noundef");
    fprintfFct.addParamAttr(1, "captures", 0l); // captures(none)
    fprintfFct.addParamAttr(1, "noundef");
    fprintfFct.addParamAttr(1, "readonly");
    fprintfFct.addRetAttr("noundef");
    return fprintfFct;
}

public f<llvm::Function> StdFunctionManager.getExitFct() {
    Vector<llvm::Type> paramTypes;
    paramTypes.pushBack(this.builder.getInt32Ty());
    llvm::Function exitFct = this.getProcedure("exit", paramTypes);
    // Set attributes
    exitFct.addFnAttr("cold");
    exitFct.addFnAttr("noreturn");
    exitFct.addFnAttr("nounwind");
    return exitFct;
}

public f<llvm::Function> StdFunctionManager.getFreeFct() {
    Vector<llvm::Type> paramTypes;
    paramTypes.pushBack(this.builder.getPtrTy());
    llvm::Function freeFct = this.getProcedure("free", paramTypes);
    // Set attributes
    freeFct.addFnAttr("nounwind");
    freeFct.addParamAttr(0, "captures", 0l); // captures(none)
    freeFct.addParamAttr(0, "noundef");
    freeFct.addParamAttr(0, "readonly");
    return freeFct;
}

public f<llvm::Function> StdFunctionManager.getMemcmpFct() {
    Vector<llvm::Type> paramTypes;
    paramTypes.pushBack(this.builder.getPtrTy());
    paramTypes.pushBack(this.builder.getPtrTy());
    paramTypes.pushBack(this.builder.getInt64Ty());
    llvm::Function memcmpFct = this.getFunction("memcmp", this.builder.getInt32Ty(), paramTypes);
    // Set attributes
    memcmpFct.addFnAttr("nounwind");
    memcmpFct.addParamAttr(0, "captures", 0l); // captures(none)
    memcmpFct.addParamAttr(0, "noundef");
    memcmpFct.addParamAttr(0, "readonly");
    memcmpFct.addParamAttr(1, "captures", 0l); // captures(none)
    memcmpFct.addParamAttr(1, "noundef");
    memcmpFct.addParamAttr(1, "readonly");
    memcmpFct.addParamAttr(2, "noundef");
    memcmpFct.addRetAttr("noundef");
    return memcmpFct;
}

public f<llvm::Function> StdFunctionManager.getMemcpyIntrinsic() {
    Vector<llvm::Type> paramTypes;
    paramTypes.pushBack(this.builder.getPtrTy());
    paramTypes.pushBack(this.builder.getPtrTy());
    paramTypes.pushBack(this.builder.getInt64Ty());
    paramTypes.pushBack(this.builder.getInt1Ty());
    llvm::Function memcpyFct = this.getProcedure("llvm.memcpy.p0.p0.i64", paramTypes);
    // Set attributes
    memcpyFct.addFnAttr("nocallback");
    memcpyFct.addFnAttr("nofree");
    memcpyFct.addFnAttr("nounwind");
    memcpyFct.addFnAttr("willreturn");
    return memcpyFct;
}

public f<llvm::Function> StdFunctionManager.getStringGetRawLengthStringFct() {
    model::ParamList paramLst;
    paramLst.pushBack(model::Param{QualType(SuperType::TY_STRING), false});
    const String mangledName = mangleStdFunction("getRawLength", QualType(SuperType::TY_LONG), paramLst);
    Vector<llvm::Type> paramTypes;
    paramTypes.pushBack(this.builder.getPtrTy());
    return this.getFunction(mangledName.getRaw(), this.builder.getInt64Ty(), paramTypes);
}

public f<llvm::Function> StdFunctionManager.getStringIsRawEqualStringStringFct() {
    model::ParamList paramLst;
    paramLst.pushBack(model::Param{QualType(SuperType::TY_STRING), false});
    paramLst.pushBack(model::Param{QualType(SuperType::TY_STRING), false});
    const String mangledName = mangleStdFunction("isRawEqual", QualType(SuperType::TY_BOOL), paramLst);
    Vector<llvm::Type> paramTypes;
    paramTypes.pushBack(this.builder.getPtrTy());
    paramTypes.pushBack(this.builder.getPtrTy());
    return this.getFunction(mangledName.getRaw(), this.builder.getInt1Ty(), paramTypes);
}

public f<llvm::Function> StdFunctionManager.getAllocUnsafeLongFct() {
    QualType unsignedLong = QualType(SuperType::TY_LONG);
    unsignedLong.makeUnsigned();
    model::ParamList paramLst;
    paramLst.pushBack(model::Param{unsignedLong, false});
    const QualType bytePtrType = QualType(SuperType::TY_BYTE);
    const String mangledName = mangleStdFunction("sAllocUnsafe", bytePtrType.toPtr(nil<ASTNode*>), paramLst);
    Vector<llvm::Type> paramTypes;
    paramTypes.pushBack(this.builder.getInt64Ty());
    return this.getFunction(mangledName.getRaw(), this.builder.getPtrTy(), paramTypes);
}

public f<llvm::Function> StdFunctionManager.getDeallocBytePtrRefFct() {
    const QualType byteType = QualType(SuperType::TY_BYTE);
    QualType heapBytePtrType = byteType.toPtr(nil<ASTNode*>);
    heapBytePtrType.makeHeap();
    model::ParamList paramLst;
    paramLst.pushBack(model::Param{heapBytePtrType.toRef(nil<ASTNode*>), false});
    const String mangledName = mangleStdFunction("sDealloc", QualType(SuperType::TY_DYN), paramLst);
    Vector<llvm::Type> paramTypes;
    paramTypes.pushBack(this.builder.getPtrTy());
    return this.getProcedure(mangledName.getRaw(), paramTypes);
}

public f<llvm::Function> StdFunctionManager.getIterateFct(const model::Function* spiceFunc) {
    const String functionName = mangleFunction(*spiceFunc);
    Vector<llvm::Type> paramTypes;
    paramTypes.pushBack(this.builder.getPtrTy());
    paramTypes.pushBack(this.builder.getInt64Ty());
    return this.getSpiceFunction(functionName.getRaw(), spiceFunc.returnType, paramTypes);
}

