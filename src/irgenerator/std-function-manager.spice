public f<llvm::Function> StdFunctionManager.getErrTraceResetFct() {
    const String mangledName = mangleStdFunction("sErrTraceReset", QualType(SuperType::TY_DYN), getErrTraceParamList());
    return this.getProcedure(mangledName.getRaw(), this.getErrTraceParamTypes());
}

public f<llvm::Function> StdFunctionManager.getErrTracePushFct() {
    const String mangledName = mangleStdFunction("sErrTracePush", QualType(SuperType::TY_DYN), getErrTraceParamList());
    return this.getProcedure(mangledName.getRaw(), this.getErrTraceParamTypes());
}

public f<llvm::Function> StdFunctionManager.getErrTraceDumpFct() {
    const model::ParamList paramLst;
    const String mangledName = mangleStdFunction("sErrTraceDump", QualType(SuperType::TY_DYN), paramLst);
    const Vector<llvm::Type> paramTypes;
    return this.getProcedure(mangledName.getRaw(), paramTypes);
}

public f<llvm::Function> StdFunctionManager.getDumpStacktraceFct() {
    // Defaults are resolved by the time a function is mangled, so the params are not optional
    model::ParamList paramLst;
    paramLst.pushBack(model::Param{QualType(SuperType::TY_BOOL), false});
    paramLst.pushBack(model::Param{QualType(SuperType::TY_BOOL), false});
    const String mangledName = mangleStdFunction("sDumpStacktrace", QualType(SuperType::TY_DYN), paramLst);
    Vector<llvm::Type> paramTypes;
    paramTypes.pushBack(this.builder.getInt1Ty());
    paramTypes.pushBack(this.builder.getInt1Ty());
    return this.getProcedure(mangledName.getRaw(), paramTypes);
}

public f<llvm::Function> StdFunctionManager.getAcrtIOFuncFct() {
    Vector<llvm::Type> paramTypes;
    paramTypes.pushBack(this.builder.getInt32Ty());
    llvm::Function stdErrPFct = this.getFunction("__acrt_iob_func", this.builder.getPtrTy(), paramTypes);
    // ToDo: Set dso_local as soon as the LLVM C API allows it
    // Set attributes
    stdErrPFct.addFnAttr("nounwind");
    stdErrPFct.addParamAttr(0, "noundef");
    stdErrPFct.addRetAttr("noundef");
    return stdErrPFct;
}

f<llvm::Function> StdFunctionManager.getFunction(string funcName, llvm::Type returnType, const Vector<llvm::Type>& args, bool varArg = false) {
    // Check if function already exists in the current module
    const llvm::Function opFct = this.module.getFunction(funcName);
    if !opFct.isNull() {
        return opFct;
    }

    // Add function to the current module
    const llvm::Type opFctTy = llvm::getFunctionType(returnType, args, varArg);
    return this.module.getOrInsertFunction(funcName, opFctTy);
}

f<llvm::Function> StdFunctionManager.getSpiceFunction(string funcName, const QualType& returnType, const Vector<llvm::Type>& args) {
    // Check if function already exists in the current module
    const llvm::Function existingFct = this.module.getFunction(funcName);
    if !existingFct.isNull() {
        return existingFct;
    }

    // Add function with the return value lowered to the calling convention of the target to the current module
    llvm::Function fct = this.module.getOrInsertFunction(funcName, this.irGenerator.getFunctionType(returnType, args));
    const ReturnABIInfo returnABI = this.irGenerator.getReturnABIInfo(returnType);
    if returnABI.isIndirect() {
        this.irGenerator.addSRetParamAttrs(fct, returnABI.memoryType);
    }
    return fct;
}

f<llvm::Function> StdFunctionManager.getProcedure(string procName, const Vector<llvm::Type>& args) {
    return this.getFunction(procName, this.builder.getVoidTy(), args, false);
}

f<Vector<llvm::Type>> StdFunctionManager.getErrTraceParamTypes() {
    Vector<llvm::Type> paramTypes;
    paramTypes.pushBack(this.builder.getPtrTy());
    paramTypes.pushBack(this.builder.getPtrTy());
    paramTypes.pushBack(this.builder.getInt32Ty());
    paramTypes.pushBack(this.builder.getInt32Ty());
    return paramTypes;
}

/**
 * Build the parameter list (string, string, unsigned int, unsigned int) of the error trace runtime functions
 *
 * @return Parameter list
 */
f<model::ParamList> getErrTraceParamList() {
    QualType unsignedInt = QualType(SuperType::TY_INT);
    unsignedInt.makeUnsigned();
    model::ParamList paramLst;
    paramLst.pushBack(model::Param{QualType(SuperType::TY_STRING), false});
    paramLst.pushBack(model::Param{QualType(SuperType::TY_STRING), false});
    paramLst.pushBack(model::Param{unsignedInt, false});
    paramLst.pushBack(model::Param{unsignedInt, false});
    return paramLst;
}

/**
 * Mangle a runtime function, that is known by its name and signature only (the host constructs a temporary Function object
 * and mangles it)
 *
 * @param name Function name
 * @param returnType Return type
 * @param paramLst Parameter list
 * @return Mangled name
 */
f<String> mangleStdFunction(string name, const QualType& returnType, const model::ParamList& paramLst) {
    const Vector<GenericType> noTemplateTypes;
    const model::Function function = model::Function(String(name), nil<SymbolTableEntry*>, QualType(SuperType::TY_DYN), returnType, paramLst, noTemplateTypes, nil<ASTNode*>);
    return mangleFunction(function);
}
