type CompileStageType enum {
    NONE,
    LEXER_AND_PARSER,
    AST_VISUALIZER,
    IMPORT_COLLECTOR,
    SYMBOL_TABLE_BUILDER,
    TYPE_CHECKER_PRE,
    TYPE_CHECKER_POST,
    DEP_GRAPH_VISUALIZER,
    IR_GENERATOR,
    IR_OPTIMIZER,
    OBJECT_EMITTER,
    FINISHED
}

type CompileStageIOType enum {
    IO_CODE,
    IO_AST,
    IO_IR,
    IO_OBJECT_FILE
}

type TimerOutput struct {
  unsigned long lexerAndParser = 0l
  unsigned long astVisualizer = 0l
  unsigned long importCollector = 0l
  unsigned long symbolTableBuilder = 0l
  unsigned long typeCheckerPre = 0l
  unsigned long typeCheckerPost = 0l
  unsigned long depGraphVisualizer = 0l
  unsigned long irGenerator = 0l
  unsigned long irOptimizer = 0l
  unsigned long objectEmitter = 0l
}

/**
 * Collects the output of the compiler for debugging
 */
public type CompilerOutput struct {
    String astString
    String symbolTableString
    String depGraphString
    String irString
    String irOptString
    String asmString
    String typesString
    String cacheStats
    public Vector<CompilerWarning> warnings
    public Vector<LintFinding> lintFindings
    TimerOutput times
}

public type NameRegistryEntry struct {
    public unsigned long typeId // Set for structs, interfaces and enums
    public SymbolTableEntry* targetEntry
    public Scope* targetScope
    public SymbolTableEntry* importEntry = nil<SymbolTableEntry*>
}

/**
 * Get the code generation opt level for the given opt level
 *
 * @param optLevel Opt level
 * @return Code generation opt level
 */
f<llvm::LLVMCodeGenOptLevel> getCodeGenOptLevel(OptLevel optLevel) {
    switch optLevel {
        case OptLevel::O0: { return llvm::LLVMCodeGenOptLevel::None; }
        case OptLevel::O1: { return llvm::LLVMCodeGenOptLevel::Less; }
        case OptLevel::O3: { return llvm::LLVMCodeGenOptLevel::Aggressive; }
        default: { return llvm::LLVMCodeGenOptLevel::Default; } // O2, Os, Oz
    }
}

/**
 * Get the LLVM relocation model for the given relocation model. PIE code is PIC for LLVM, the difference is the 'PIE Level'
 * module flag (see the IRGenerator)
 *
 * @param relocModel Relocation model, already resolved by the driver
 * @return LLVM relocation model
 */
f<llvm::LLVMRelocMode> getLLVMRelocMode(RelocModel relocModel) {
    switch relocModel {
        case RelocModel::STATIC: { return llvm::LLVMRelocMode::Static; }
        default: { return llvm::LLVMRelocMode::PIC; } // PIC, PIE
    }
}

/**
 * Get the LLVM code model for the given code model
 *
 * @param codeModel Code model
 * @return LLVM code model
 */
f<llvm::LLVMCodeModel> getLLVMCodeModel(CodeModel codeModel) {
    switch codeModel {
        case CodeModel::TINY: { return llvm::LLVMCodeModel::Tiny; }
        case CodeModel::SMALL: { return llvm::LLVMCodeModel::Small; }
        case CodeModel::KERNEL: { return llvm::LLVMCodeModel::Kernel; }
        case CodeModel::MEDIUM: { return llvm::LLVMCodeModel::Medium; }
        case CodeModel::LARGE: { return llvm::LLVMCodeModel::Large; }
        default: { return llvm::LLVMCodeModel::Default; }
    }
}

/**
 * Represents a single source file
 */
public type SourceFile struct {
    // Public fields
    public String name
    public String fileName
    public FilePath filePath
    public String fileDir
    public bool isStdFile = false
    public bool isPackageFile = false // File of an external package in the spice_packages dir. Warnings are suppressed
    public bool isMainFile = true
    public bool alwaysKeepSymbolsOnNameCollision = false
    public bool ignoreWarnings = false
    public bool explicitErrorHandling = false
    public bool errorReturnTracing = false
    public bool reVisitRequested = true
    public CompileStageType previousStage = CompileStageType::NONE
    public CompilerOutput compilerOutput
    public SourceFile* parent
    public ASTEntryNode* ast = nil<ASTEntryNode*>
    public Scope* globalScope = nil<Scope*> // Owned by the scope pool of the resource manager
    public llvm::LLVMContext context
    public llvm::IRBuilder builder
    public llvm::TargetMachine targetMachine
    public llvm::Module llvmModule
    public FilePath objectFilePath
    public String objectFileStem // Name of the object file without extension, unique within the compilation
    public Map<String, SourceFile*> dependencies // Has to be an ordered map to keep the compilation order deterministic
    public Vector<const SourceFile*> dependants
    public Map<String, NameRegistryEntry> exportedNameRegistry
    // Unqualified names that were dropped from the name registry, because multiple imports expose them. Maps each name to the
    // import entries exposing it, so that a failing lookup can point the user to the colliding imports
    public Map<String, Vector<const SymbolTableEntry*>> ambiguousNameRegistry
    public Vector<const model::Function*> testFunctions
    public GlobalResourceManager& resourceManager // Public, because Scope and SymbolTable need access
    // Private fields
    CliOptions& cliOptions
    UnorderedMap<long, llvm::Type> typeToLLVMTypeMapping // Maps the address of each type to its LLVM type
    // Number of name registry entries per target entry address, to answer isStructKnownByNameRegistry without scanning the registry
    UnorderedMap<long, unsigned long> nameRegistryTargetEntryCounts
    public unsigned int importedRuntimeModules = 0 // Public, because the RuntimeModuleManager needs access
    unsigned short totalTypeCheckerRuns = 0s
    // Cycle-safety guards: the pipeline drivers recurse over a dependency graph that may contain cycles (circular
    // imports). These flags prevent re-entering a file that is already being processed in the same stage.
    bool registriesMerged = false
    bool typeCheckerPreRunning = false
    bool typeCheckerPostRunning = false
    bool backEndStarted = false
    bool warningsCollected = false
    bool lintFindingsCollected = false
}

public p SourceFile.ctor(GlobalResourceManager &resourceManager, SourceFile* parent, const String& name, const FilePath& filePath, bool isStdFile) {
    // Copy data
    this.name = name;
    this.filePath = filePath;
    this.isStdFile = isStdFile;
    this.parent = parent;
    this.builder = llvm::IRBuilder(resourceManager.cliOptions.useLTO ? resourceManager.ltoContext : this.context);
    this.resourceManager = resourceManager;
    this.cliOptions = resourceManager.cliOptions;

    // Deduce fileName and fileDir
    const FilePath path = FilePath(filePath);
    this.fileName = path.getFileName();
    this.fileDir = path.getParentDir();
    this.objectFileStem = resourceManager.reserveObjectFileStem(path);

    // Discard value names if not required
    this.context.setDiscardValueNames(!this.cliOptions.namesForIRValues);

    // Search after selected target
    string error = nil<string>;
    const llvm::Target target = llvm::getTargetFromTriple(this.cliOptions.targetTriple, &error);
    if error != nil<string> {
        const String messageSuffix = "Selected target was not found: " + String(error);
        const CompilerError compilerError = CompilerError(CompilerErrorType::TARGET_NOT_AVAILABLE, messageSuffix.getRaw());
        abortWithError(compilerError.getMessage());
    }

    // Create target machine
    const string cpuName = resourceManager.cpuName;
    const string features = resourceManager.cpuFeatures.getRaw();
    const llvm::Triple& targetTriple = this.cliOptions.targetTriple;
    const llvm::LLVMRelocMode relocMode = getLLVMRelocMode(this.cliOptions.relocModel);
    const llvm::LLVMCodeModel codeModel = getLLVMCodeModel(this.cliOptions.codeModel);
    // The LLVM C API cannot change the codegen opt level of a target machine, so it is set right away here.
    const llvm::LLVMCodeGenOptLevel codeGenOptLevel = getCodeGenOptLevel(this.cliOptions.optLevel);
    this.targetMachine = target.createTargetMachine(targetTriple, cpuName, features, codeGenOptLevel, relocMode, codeModel);
    // Emit the assembly code with comments. This only affects the assembly code, not the object files
    this.targetMachine.setAsmVerbosity(true);
}

public p SourceFile.runParser() {
    // Check if this stage has already been done
    if this.previousStage >= CompileStageType::LEXER_AND_PARSER {
        return;
    }


    Timer timer = Timer(TimerMode::MILLIS, &this.compilerOutput.times.lexerAndParser);
    timer.start();

    // The source file must exist. Raise the same error as the lexer stage does when it cannot be read.
    if !this.filePath.exists() {
        StringStream msg;
        msg << "Source file at path '" << this.filePath.toString() << "' does not exist.";
        const String messageSuffix = msg.str();
        const CompilerError error = CompilerError(CompilerErrorType::SOURCE_FILE_NOT_FOUND, messageSuffix.getRaw());
        abortWithError(error.getMessage());
    }

    // Parse the source file
    Lexer lexer = Lexer(this.filePath);
    Parser parser = Parser(this.resourceManager, this, lexer);
    this.ast = parser.parse();
    assert this.ast != nil<ASTEntryNode*>;

    // Create the global scope
    this.globalScope = this.resourceManager.createScope(nil<Scope*>, this, ScopeType::GLOBAL, &this.ast.node.codeLoc);

    this.previousStage = CompileStageType::LEXER_AND_PARSER;
    timer.stop();
    this.printStatusMessage("Parser", CompileStageIOType::IO_CODE, CompileStageIOType::IO_AST, this.compilerOutput.times.lexerAndParser);
}

public p SourceFile.runASTVisualizer() {
    // Only execute if enabled
    if !this.cliOptions.dump.dumpAST && !this.cliOptions.testMode {
        return;
    }
    // Check if this stage has already been done
    if this.previousStage >= CompileStageType::AST_VISUALIZER {
        return;
    }

    Timer timer = Timer(TimerMode::MILLIS, &this.compilerOutput.times.astVisualizer);
    timer.start();

    // Generate dot code for this source file
    StringStream dotCode;
    this.visualizerPreamble(dotCode);
    ASTVisualizer astVisualizer = ASTVisualizer();
    Any astDotCode = astVisualizer.visit(this.ast);
    dotCode << " " << astDotCode.get<String>() << "}";

    // Dump the serialized AST string and the SVG file
    this.compilerOutput.astString = dotCode.str();

    if this.cliOptions.dump.dumpAST {
        this.visualizerOutput("AST", this.compilerOutput.astString);
    }

    this.previousStage = CompileStageType::AST_VISUALIZER;
    timer.stop();
    this.printStatusMessage("AST Visualizer", CompileStageIOType::IO_AST, CompileStageIOType::IO_AST, this.compilerOutput.times.astVisualizer);
}

public p SourceFile.runImportCollector() {
    // Skip if this stage has already been done
    if this.previousStage >= CompileStageType::IMPORT_COLLECTOR {
        return;
    }

    Timer timer = Timer(TimerMode::MILLIS, &this.compilerOutput.times.importCollector);
    timer.start();

    // Collect the imports for this source file
    ImportCollector importCollector = ImportCollector(this.resourceManager, this);
    importCollector.visit(this.ast);
    this.checkForHardError();

    this.previousStage = CompileStageType::IMPORT_COLLECTOR;

    // Run first part of pipeline for the imported source file
    foreach dyn dependency : this.dependencies {
        SourceFile* sourceFile = dependency.getSecond();
        sourceFile.runFrontEnd();
    }

    timer.stop();
    this.printStatusMessage("Import Collector", CompileStageIOType::IO_AST, CompileStageIOType::IO_AST, this.compilerOutput.times.importCollector);
}

public p SourceFile.runSymbolTableBuilder() {
    // Skip if this stage has already been done
    if this.previousStage >= CompileStageType::SYMBOL_TABLE_BUILDER {
        return;
    }

    Timer timer = Timer(TimerMode::MILLIS, &this.compilerOutput.times.symbolTableBuilder);
    timer.start();

    // Build the symbol table. The dependencies' exported name registries are merged in afterwards, in a separate pass
    // (mergeNameRegistriesRecursive), once every reachable file has built its own registry. This deferral is what makes
    // circular imports work: with a cycle, a dependency's registry is not fully populated yet at this point.
    SymbolTableBuilder symbolTableBuilder = SymbolTableBuilder(this.resourceManager, this);
    symbolTableBuilder.visit(this.ast);
    this.checkForHardError();

    this.previousStage = CompileStageType::SYMBOL_TABLE_BUILDER;
    this.resourceManager.compileProgress.finishFrontEnd();
    timer.stop();
    this.printStatusMessage("Symbol Table Builder", CompileStageIOType::IO_AST, CompileStageIOType::IO_AST, this.compilerOutput.times.symbolTableBuilder);
}

public p SourceFile.runTypeCheckerPre() { // Public for the RuntimeModuleManager
    // The typeCheckerPreRunning guard breaks the recursion on a circular import: a cyclic back-edge returns immediately
    // instead of recursing forever.
    if this.previousStage >= CompileStageType::TYPE_CHECKER_PRE || this.typeCheckerPreRunning {
        return;
    }
    this.typeCheckerPreRunning = true;

    // Type-check all dependencies first
    foreach dyn dependency : this.dependencies {
        SourceFile* sourceFile = dependency.getSecond();
        sourceFile.runTypeCheckerPre();
    }

    Timer timer = Timer(TimerMode::MILLIS, &this.compilerOutput.times.typeCheckerPre);
    timer.start();

    // Then type-check the current file
    TypeChecker typeChecker = TypeChecker(this.resourceManager, this, TypeCheckerMode::TC_MODE_PRE);
    typeChecker.visit(this.ast);
    this.checkForHardError();

    this.previousStage = CompileStageType::TYPE_CHECKER_PRE;
    this.resourceManager.compileProgress.finishTypeCheckerPre();
    this.typeCheckerPreRunning = false;
    timer.stop();
    this.printStatusMessage("Type Checker Pre", CompileStageIOType::IO_AST, CompileStageIOType::IO_AST, this.compilerOutput.times.typeCheckerPre);
}

p SourceFile.runTypeCheckerPost() {
    // Re-entrancy guard: within an import cycle, a dependency's post-run recurses back into this file's post-run. The
    // in-flight fixpoint loop below already revisits this file, so the nested call must be a no-op to avoid unbounded
    // mutual recursion. Convergence is driven by the reVisitRequested flags propagating across the cycle.
    if this.typeCheckerPostRunning {
        return;
    }

    // Nothing to do if this file already finished the post stage and nobody asked for another visit since. This is the
    // common case, because every visit of a file runs the post stage of all its dependencies again.
    if !this.reVisitRequested && this.previousStage >= CompileStageType::TYPE_CHECKER_POST {
        return;
    }

    // Skip if not all dependants finished type checking yet
    if !this.haveAllDependantsBeenTypeChecked() {
        return;
    }

    this.typeCheckerPostRunning = true;

    Timer timer = Timer(TimerMode::MILLIS, &this.compilerOutput.times.typeCheckerPost);
    timer.start();

    // Start type-checking loop. The type-checker can request a re-execution. The max number of type-checker runs is limited
    TypeChecker typeChecker = TypeChecker(this.resourceManager, this, TypeCheckerMode::TC_MODE_POST);
    unsigned short typeCheckerRuns = 0s;
    while this.reVisitRequested {
        typeCheckerRuns++;
        this.totalTypeCheckerRuns++;
        this.reVisitRequested = false;

        // Type-check the current file first. Multiple times, if requested
        timer.resume();
        typeChecker.visit(this.ast);
        this.checkForHardError();
        timer.pause();

        // Then type-check all dependencies
        foreach dyn dependency : this.dependencies {
            SourceFile* sourceFile = dependency.getSecond();
            sourceFile.runTypeCheckerPost();
        }
    }

    this.typeCheckerPostRunning = false;

    // Measure the remaining work of this stage as well. The time spent in the dependencies above is not part of it
    timer.resume();
    this.checkForSoftErrors();

    // Check if all dyn variables were type-inferred successfully
    this.globalScope.ensureSuccessfulTypeInference();

    // In debug builds, verify that the TypeChecker fully annotated the AST
    if __get_build_var<bool>("spice.is_debug") {
        this.runPostTypeCheckingVerifier();
    }

    // A revisit request can run the post stage again later on, but it only counts as progress the first time
    if this.previousStage < CompileStageType::TYPE_CHECKER_POST {
        this.resourceManager.compileProgress.finishTypeCheckerPost();
    }
    this.previousStage = CompileStageType::TYPE_CHECKER_POST;
    timer.stop();
    this.printStatusMessage("Type Checker Post", CompileStageIOType::IO_AST, CompileStageIOType::IO_AST, this.compilerOutput.times.typeCheckerPost, typeCheckerRuns);

    // Save the JSON version in the compiler output
    if this.cliOptions.dump.dumpSymbolTable || this.cliOptions.testMode {
        JsonValue* symbolTableJSON = this.globalScope.getSymbolTableJSON();
        JsonSerializer serializer = JsonSerializer(/*pretty=*/true);
        this.compilerOutput.symbolTableString = serializer.serialize(symbolTableJSON);
        deleteJsonValue(symbolTableJSON);
    }

    // Dump symbol table
    if this.cliOptions.dump.dumpSymbolTable {
        this.dumpOutput(this.compilerOutput.symbolTableString, String("Symbol Table"), String("symbol-table.json"));
    }
}

p SourceFile.runPostTypeCheckingVerifier() {
    PostTypeCheckingVerifier verifier = PostTypeCheckingVerifier(this.resourceManager, this);
    verifier.verify(this.ast);
}

public p SourceFile.runDependencyGraphVisualizer() {
    // Only execute if enabled
    if !this.cliOptions.dump.dumpDependencyGraph && !this.cliOptions.testMode { return; }
    if this.previousStage >= CompileStageType::DEP_GRAPH_VISUALIZER { return; }

    Timer timer = Timer(TimerMode::MILLIS, &this.compilerOutput.times.depGraphVisualizer);
    timer.start();

    // Generate dot code for the full dependency graph
    StringStream dotCode;
    this.visualizerPreamble(dotCode);
    DependencyGraphVisualizer depGraphVisualizer = DependencyGraphVisualizer(this.resourceManager, this);
    depGraphVisualizer.getDependencyGraph(dotCode);
    dotCode << "}";

    this.compilerOutput.depGraphString = dotCode.str();

    if this.cliOptions.dump.dumpDependencyGraph {
        this.visualizerOutput("Dependency Graph", this.compilerOutput.depGraphString);
    }

    this.previousStage = CompileStageType::DEP_GRAPH_VISUALIZER;
    timer.stop();
    this.printStatusMessage("Dependency Graph Visualizer", CompileStageIOType::IO_AST, CompileStageIOType::IO_AST, this.compilerOutput.times.depGraphVisualizer);
}

public p SourceFile.runIRGenerator() {
    // Skip if this stage has already been done
    if this.previousStage >= CompileStageType::IR_GENERATOR {
        return;
    }

    Timer timer = Timer(TimerMode::MILLIS, &this.compilerOutput.times.irGenerator);
    timer.start();
    this.resourceManager.compileProgress.startBackEndStage(BackEndStage::IR_GENERATOR);

    // Create the LLVM module for this source file
    llvm::LLVMContext& llvmContext = this.cliOptions.useLTO ? this.resourceManager.ltoContext : this.context;
    this.llvmModule = llvm::Module(this.fileName.getRaw(), llvmContext);

    // Generate this source file
    IRGenerator irGenerator = IRGenerator(this.resourceManager, this);
    irGenerator.visit(this.ast);

    // Save the ir string in the compiler output
    if this.cliOptions.dump.dumpIR || this.cliOptions.testMode {
        this.compilerOutput.irString = getIRString(&this.llvmModule, this.cliOptions);
    }

    // Dump unoptimized IR code
    if this.cliOptions.dump.dumpIR {
        this.dumpOutput(this.compilerOutput.irString, String("Unoptimized IR Code"), String("ir-code.ll"));
    }

    this.previousStage = CompileStageType::IR_GENERATOR;
    this.resourceManager.compileProgress.finishBackEndStage(BackEndStage::IR_GENERATOR);
    timer.stop();
    this.printStatusMessage("IR Generator", CompileStageIOType::IO_AST, CompileStageIOType::IO_IR, this.compilerOutput.times.irGenerator);
}

public p SourceFile.runDefaultIROptimizer() {
    assert !this.cliOptions.useLTO;

    // Skip if this stage has already been done
    if this.previousStage > CompileStageType::IR_OPTIMIZER || (this.previousStage == CompileStageType::IR_OPTIMIZER && !this.cliOptions.testMode) {
        return;
    }

    Timer timer = Timer(TimerMode::MILLIS, &this.compilerOutput.times.irOptimizer);
    timer.start();
    this.resourceManager.compileProgress.startBackEndStage(BackEndStage::IR_OPTIMIZER);

    // Optimize this source file
    IROptimizer irOptimizer = IROptimizer(this.resourceManager, this);
    irOptimizer.prepare();
    irOptimizer.optimizeDefault();

    // Save the optimized ir string in the compiler output
    if this.cliOptions.dump.dumpIR || this.cliOptions.testMode {
        this.compilerOutput.irOptString = getIRString(&this.llvmModule, this.cliOptions);
    }

    // Dump optimized IR code
    if this.cliOptions.dump.dumpIR {
        const String optLevelStr = toString(this.cliOptions.optLevel);
        this.dumpOutput(this.compilerOutput.irOptString, String("Optimized IR Code"), "ir-code-O" + optLevelStr + ".ll");
    }

    this.previousStage = CompileStageType::IR_OPTIMIZER;
    this.resourceManager.compileProgress.finishBackEndStage(BackEndStage::IR_OPTIMIZER);
    timer.stop();
    this.printStatusMessage("IR Optimizer", CompileStageIOType::IO_IR, CompileStageIOType::IO_IR, this.compilerOutput.times.irOptimizer);
}

public p SourceFile.runPreLinkIROptimizer() {
    assert this.cliOptions.useLTO;

    // Skip if this stage has already been done
    if this.previousStage >= CompileStageType::IR_OPTIMIZER {
        return;
    }

    Timer timer = Timer(TimerMode::MILLIS, &this.compilerOutput.times.irOptimizer);
    timer.start();
    this.resourceManager.compileProgress.startBackEndStage(BackEndStage::IR_OPTIMIZER);

    // Optimize this source file
    IROptimizer irOptimizer = IROptimizer(this.resourceManager, this);
    irOptimizer.prepare();
    irOptimizer.optimizePreLink();

    // Save the optimized ir string in the compiler output
    if this.cliOptions.dump.dumpIR || this.cliOptions.testMode {
        this.compilerOutput.irOptString = getIRString(&this.llvmModule, this.cliOptions);
    }

    // Dump optimized IR code
    if this.cliOptions.dump.dumpIR {
        this.dumpOutput(this.compilerOutput.irOptString, String("Optimized IR Code (pre-link)"), String("ir-code-lto-pre-link.ll"));
    }

    this.resourceManager.compileProgress.finishBackEndStage(BackEndStage::IR_OPTIMIZER);
    timer.pause();
}

public p SourceFile.runBitcodeLinker() {
    assert this.cliOptions.useLTO;

    // Skip if this is not the main source file
    if !this.isMainFile {
        return;
    }

    // Skip if this stage has already been done
    if this.previousStage >= CompileStageType::IR_OPTIMIZER {
        return;
    }

    Timer timer = Timer(TimerMode::MILLIS, &this.compilerOutput.times.irOptimizer);
    timer.resume();
    // The bitcode linker and the post-link optimizer form one stage for the whole program
    this.resourceManager.compileProgress.startBackEndStage(BackEndStage::LTO_IR_OPTIMIZER);

    // Link all source files together
    BitcodeLinker linker = BitcodeLinker(this.resourceManager);
    linker.link();

    timer.pause();
}

public p SourceFile.runPostLinkIROptimizer() {
    assert this.cliOptions.useLTO;

    // Skip if this is not the main source file
    if !this.isMainFile {
        return;
    }

    // Skip if this stage has already been done
    if this.previousStage >= CompileStageType::IR_OPTIMIZER {
        return;
    }

    Timer timer = Timer(TimerMode::MILLIS, &this.compilerOutput.times.irOptimizer);
    timer.resume();

    // Optimize LTO module
    IROptimizer irOptimizer = IROptimizer(this.resourceManager, this);
    irOptimizer.prepare();
    irOptimizer.optimizePostLink();

    // Save the optimized ir string in the compiler output
    if this.cliOptions.dump.dumpIR || this.cliOptions.testMode {
        this.compilerOutput.irOptString = getIRString(&this.resourceManager.ltoModule, this.cliOptions);
    }

    // Dump optimized IR code
    if this.cliOptions.dump.dumpIR {
        this.dumpOutput(this.compilerOutput.irOptString, String("Optimized IR Code (post-Link)"), String("ir-code-lto-post-link.ll"));
    }

    this.previousStage = CompileStageType::IR_OPTIMIZER;
    this.resourceManager.compileProgress.finishBackEndStage(BackEndStage::LTO_IR_OPTIMIZER);
    timer.stop();
    this.printStatusMessage("IR Optimizer", CompileStageIOType::IO_IR, CompileStageIOType::IO_IR, this.compilerOutput.times.irOptimizer);
}

public p SourceFile.runObjectEmitter() {
    // Skip if this stage has already been done
    if this.previousStage >= CompileStageType::OBJECT_EMITTER {
        return;
    }

    // Skip if LTO is enabled and this is not the main source file
    if this.cliOptions.useLTO && !this.isMainFile {
        return;
    }

    Timer timer = Timer(TimerMode::MILLIS, &this.compilerOutput.times.objectEmitter);
    timer.start();
    // With LTO, the main source file emits the object file for the whole program
    const BackEndStage progressStage = this.cliOptions.useLTO ? BackEndStage::LTO_OBJECT_EMITTER : BackEndStage::OBJECT_EMITTER;
    this.resourceManager.compileProgress.startBackEndStage(progressStage);

    // The code generation opt level matches the opt level, the IR was generated and optimized with. The LLVM C API cannot
    // change it afterwards, so the target machine is created with it in the constructor.

    // Deduce an object file path
    this.objectFilePath = this.getObjectFilePath();

    // Pick a concrete emitter based on the selected backend. The driver only accepts the TPDE backend, if the compiler is backed
    // by TPDE
    LLVMObjectEmitter llvmObjectEmitter = LLVMObjectEmitter(this.resourceManager, this);
    TPDEObjectEmitter tpdeObjectEmitter = TPDEObjectEmitter(this.cliOptions.useLTO ? &this.resourceManager.ltoModule : &this.llvmModule);
    IAbstractObjectEmitter* objectEmitter = &llvmObjectEmitter;
    if this.cliOptions.backend == Backend::TPDE {
        objectEmitter = &tpdeObjectEmitter;
    }

    // Emit object for this source file
    objectEmitter.emit(this.objectFilePath);

    // Save assembly string in the compiler output (TPDE emits a placeholder note)
    if this.cliOptions.isNativeTarget && (this.cliOptions.dump.dumpAssembly || this.cliOptions.testMode) {
        objectEmitter.getASMString(this.compilerOutput.asmString);
    }

    // Dump assembly code
    if this.cliOptions.dump.dumpAssembly {
        this.dumpOutput(this.compilerOutput.asmString, String("Assembly code"), String("assembly-code.s"));
    }

    // The object file is registered with the linker in concludeCompilation and not here, because this stage may run on a
    // worker thread of the parallel back end and the linker input order has to stay deterministic.

    this.previousStage = CompileStageType::OBJECT_EMITTER;
    this.resourceManager.compileProgress.finishBackEndStage(progressStage);
    timer.stop();
    this.printStatusMessage("Object Emitter", CompileStageIOType::IO_IR, CompileStageIOType::IO_OBJECT_FILE, this.compilerOutput.times.objectEmitter);
}

public p SourceFile.concludeCompilation() {
    // Skip if this stage has already been done
    if this.previousStage >= CompileStageType::FINISHED {
        return;
    }

    // Add the emitted object file to the linker objects. This happens here and not in runObjectEmitter, because
    // concludeCompilation is always driven serially and in dependency order, while the object emitter may run on a worker
    // thread of the parallel back end.
    if !this.objectFilePath.isEmpty() {
        this.resourceManager.linker.addEmittedObjectFile(this.objectFilePath);
    }

    // Save type registry as string in the compiler output
    if this.isMainFile && (this.cliOptions.dump.dumpTypes || this.cliOptions.testMode) {
        this.compilerOutput.typesString = this.resourceManager.typeRegistry.dump();
    }

    // Dump type registry
    if this.isMainFile && this.cliOptions.dump.dumpTypes {
        this.dumpOutput(this.compilerOutput.typesString, String("Type Registry"), String("type-registry.out"));
    }

    // Save cache statistics as string in the compiler output
    if this.isMainFile && (this.cliOptions.dump.dumpCacheStats || this.cliOptions.testMode) {
        this.dumpCacheStats();
    }

    // Dump lookup cache statistics
    if this.isMainFile && this.cliOptions.dump.dumpCacheStats {
        this.dumpOutput(this.compilerOutput.cacheStats, String("Cache Statistics"), String("cache-stats.out"));
    }

    if this.cliOptions.printDebugOutput {
        println("Finished compiling " + this.fileName);
    }

    this.previousStage = CompileStageType::FINISHED;
}

public p SourceFile.runFrontEnd() {
    // The front end of the main source file covers the front ends of all its (transitive) dependencies. A circular import
    // re-enters the front end of the main source file, so only measure the outermost call, which starts with its parser
    const bool measureWallTime = this.isMainFile && this.previousStage == CompileStageType::NONE;
    if measureWallTime {
        this.resourceManager.frontEndTimer.start();
    }

    this.runParser();
    if this.resourceManager.abortCompilation { return; }
    this.runASTVisualizer();
    if this.resourceManager.abortCompilation { return; }
    this.runImportCollector();
    if this.resourceManager.abortCompilation { return; }
    this.runSymbolTableBuilder();
    if this.resourceManager.abortCompilation { return; }

    if measureWallTime {
        this.resourceManager.frontEndTimer.stop();
    }
}

public p SourceFile.runMiddleEnd() {
    if this.isMainFile {
        this.resourceManager.middleEndTimer.start();
    }

    // Merge the exported name registries of all (transitive) dependencies into the respective importing files. This is
    // the deferred tail of the front-end: it must run after every reachable file has built its own registry, which is
    // why it cannot live inside the per-file front-end recursion (a circular import would otherwise merge a dependency
    // whose registry is not populated yet). runMiddleEnd is the first stage that is only ever invoked at the top level.
    this.mergeNameRegistriesRecursive();
    if this.resourceManager.abortCompilation { return; }
    // From here on, struct manifestations may be substantiated, and each of them gets its compiler-generated default
    // members decided right at that point (see TypeChecker.createImplicitDefaultMembers). Once the middle end is done,
    // every manifestation exists and was decided on, so the back end must not create any more of them.
    DefaultMemberCreationSection _;
    // We need two runs here due to generics.
    // The first run to determine all concrete function/struct/interface substantiations
    this.runTypeCheckerPre(); // Visit the dependency tree from bottom to top
    if this.resourceManager.abortCompilation { return; }
    // The second run to ensure, also generic scopes are type-checked properly
    this.runTypeCheckerPost(); // Visit the dependency tree from top to bottom in topological order
    if this.resourceManager.abortCompilation { return; }
    // The per-file convergence loop inside runTypeCheckerPost is scoped to its own call stack: a cross-file revisit
    // request that lands on a file whose loop already unwound (e.g. a recursive generic dtor chain that closes back
    // through a runtime module which was itself gated behind another, not-yet-checked importer) is otherwise dropped,
    // leaving a fully-substantiated manifestation whose body was never type-checked. Sweep every source file in the
    // program for a straggling revisit request and drive it to convergence directly, repeating until none are left.
    bool anySourceFileRevisitPending = true;
    while anySourceFileRevisitPending {
        anySourceFileRevisitPending = false;
        // Snapshot the current files before driving any of them: runTypeCheckerPost() below can itself trigger a
        // freshly-discovered runtime import (SourceFile.requestRuntimeModule -> GlobalResourceManager.createSourceFile),
        // which inserts into resourceManager.sourceFiles, so a stable list of pointers is collected first. It is taken in
        // creation order, so that the revisits happen in a deterministic order, independent of the hash function of the map.
        Vector<SourceFile*> sourceFilesSnapshot;
        foreach SourceFile* createdSourceFile : this.resourceManager.sourceFilesInCreationOrder {
            sourceFilesSnapshot.pushBack(createdSourceFile);
        }
        foreach SourceFile* sourceFile : sourceFilesSnapshot {
            if sourceFile.reVisitRequested {
                sourceFile.runTypeCheckerPost();
                anySourceFileRevisitPending = true;
            }
        }
        // A source file created mid-sweep (see above) still needs its own pass; it starts out with reVisitRequested
        // true, so re-looping picks it up via the snapshot taken on the next iteration.
        if this.resourceManager.sourceFiles.getSize() > sourceFilesSnapshot.getSize() {
            anySourceFileRevisitPending = true;
        }
    }
    if this.resourceManager.abortCompilation { return; }
    // Check that no two definitions of the program are exported under the same linker symbol name
    this.checkForExportedSymbolCollisions();
    if this.resourceManager.abortCompilation { return; }
    // Check that a freestanding program, that allocates on the heap, brings the allocator functions
    if this.isMainFile && this.cliOptions.freestanding {
        this.checkForAllocatorFunctions();
    }
    // Visualize dependency graph
    this.runDependencyGraphVisualizer();
    if this.resourceManager.abortCompilation { return; }

    if this.isMainFile {
        this.resourceManager.middleEndTimer.stop();
    }
}

p SourceFile.collectBackEndSourceFiles(Vector<SourceFile*>& backEndSourceFiles) {
    // Guard against collecting a file that already went through the back end. Circular imports form a cycle in the
    // dependency graph, so the deps-first recursion below would otherwise loop forever.
    if this.backEndStarted {
        return;
    }
    this.backEndStarted = true;

    // Collect all dependencies first, so that they end up in front of this file in the resulting list
    foreach dyn dependency : this.dependencies {
        SourceFile* sourceFile = dependency.getSecond();
        sourceFile.collectBackEndSourceFiles(backEndSourceFiles);
    }

    backEndSourceFiles.pushBack(this);
}

p SourceFile.runBackEndForThisFile() {
    this.runIRGenerator();
    if this.resourceManager.abortCompilation { return; }
    if this.cliOptions.useLTO {
        this.runPreLinkIROptimizer();
        if this.resourceManager.abortCompilation { return; }
        this.runBitcodeLinker();
        if this.resourceManager.abortCompilation { return; }
        this.runPostLinkIROptimizer();
        if this.resourceManager.abortCompilation { return; }
    } else {
        this.runDefaultIROptimizer();
        if this.resourceManager.abortCompilation { return; }
    }
    this.runObjectEmitter();
    this.releaseBackEndResources();
}

/**
 * Release the LLVM resources of this source file, as soon as its object file was emitted. Releasing them early bounds the peak memory usage to the resources of the source files, whose back end
 * runs at the moment. Nothing uses them afterwards, because the back end of each source file only works on its own resources.
 * With LTO, the modules are linked into the LTO module and the main source file emits the object file, so they are kept.
 */
p SourceFile.releaseBackEndResources() {
    if this.cliOptions.useLTO {
        return;
    }
    // The LLVM types live in the context, so forget them before. The builder and the module have to be disposed before the
    // context as well
    this.typeToLLVMTypeMapping.clear();
    this.builder.dispose();
    this.llvmModule.dispose();
    this.targetMachine.dispose();
    this.context.dispose();
}

public p SourceFile.runBackEnd() {
    if this.isMainFile {
        this.resourceManager.backEndTimer.start();
    }

    // Flatten the dependency graph into the order the back end used to recurse in: every file comes after all of its
    // dependencies, and files that already ran their back end are skipped.
    Vector<SourceFile*> backEndSourceFiles;
    this.collectBackEndSourceFiles(backEndSourceFiles);

    // Nothing to do if this file and all of its dependencies already went through the back end
    if backEndSourceFiles.isEmpty() {
        return;
    }

    // Unlike the front end and the middle end, the back end has no cross-file data dependencies: every source file owns
    // its own LLVMContext, IRBuilder, TargetMachine and llvm::Module, and references to symbols of other files are emitted
    // as declarations into the local module. So the per-file pipelines can simply be spread over a worker pool.
    // Exceptions, in which the back end stays serial:
    // - LTO, because all source files share the LTO context and module of the GlobalResourceManager
    // - dump modes, because they write to the console/output dir and their ordering is part of the user-visible output
    const bool dumpRequested = this.cliOptions.dump.dumpIR || this.cliOptions.dump.dumpAssembly || this.cliOptions.dump.dumpObjectFiles;
    const unsigned long compileJobCount = this.resourceManager.getCompileJobCount();
    const unsigned long jobCount = compileJobCount < backEndSourceFiles.getSize() ? compileJobCount : backEndSourceFiles.getSize();
    const bool runParallel = jobCount > 1ul && !this.cliOptions.useLTO && !dumpRequested;

    if runParallel {
        ThreadPool threadPool = ThreadPool(cast<unsigned short>(jobCount));
        foreach SourceFile* sourceFile : backEndSourceFiles {
            threadPool.enqueue(p() [[async]] {
                sourceFile.runBackEndForThisFile();
            });
        }
        // Enter the parallel section before the worker threads start and leave it only after all of them were joined. A
        // failing source file aborts the compilation on its worker thread (see abortWithError), which ends the process.
        ParallelSection _;
        threadPool.start();
        threadPool.join();
    } else {
        foreach SourceFile* sourceFile : backEndSourceFiles {
            sourceFile.runBackEndForThisFile();
            if this.resourceManager.abortCompilation { return; }
        }
    }
    if this.resourceManager.abortCompilation { return; }

    // Conclude the compilation of all source files. This registers the emitted object files with the linker, which has to
    // happen serially and in a fixed order to stay deterministic.
    foreach SourceFile* sourceFile : backEndSourceFiles {
        sourceFile.concludeCompilation();
    }

    if this.isMainFile {
        this.resourceManager.backEndTimer.stop();
        if this.cliOptions.printDebugOutput {
            this.dumpCompilationStats();
        }
    }
}

public p SourceFile.addDependency(SourceFile* sourceFile, const String& dependencyName) {
    // Circular imports are explicitly supported, so cycles are not rejected here. Source files are deduplicated by path
    // in GlobalResourceManager::createSourceFile, so a cyclic import resolves to the same SourceFile instance and the
    // pipeline drivers guard against re-entering a file that is already in progress.

    // Add the dependency. Do not demote the compilation root (parent == nullptr) to a non-main file.
    if sourceFile.parent != nil<SourceFile*> {
        sourceFile.isMainFile = false;
    }
    if !this.dependencies.contains(dependencyName) {
        this.dependencies.upsert(dependencyName, sourceFile);
    }

    // Add the dependant
    sourceFile.dependants.pushBack(this);
}

// Shortcuts used by the compiler passes
public f<Scope*> SourceFile.getGlobalScope() {
    return this.globalScope;
}

public f<const FilePath&> SourceFile.getFilePath() {
    return this.filePath;
}

public f<bool> SourceFile.isMainSourceFile() {
    return this.isMainFile;
}

// True if the exported name registry already maps the name to the given symbol table entry
public f<bool> SourceFile.hasNameRegistryTarget(const String& symbolName, const SymbolTableEntry* target) {
    const NameRegistryEntry* existing = this.getNameRegistryEntry(symbolName);
    return existing != nil<NameRegistryEntry*> && existing.targetEntry == target;
}

public p SourceFile.setAlwaysKeepSymbolsOnNameCollision(bool value) { this.alwaysKeepSymbolsOnNameCollision = value; }
public p SourceFile.setIgnoreWarnings(bool value) { this.ignoreWarnings = value; }
public p SourceFile.setExplicitErrorHandling(bool value) { this.explicitErrorHandling = value; }
public p SourceFile.setErrorReturnTracing(bool value) { this.errorReturnTracing = value; }

public f<bool> SourceFile.imports(const SourceFile* sourceFile) {
    foreach dyn dependency : this.dependencies {
        if dependency.getSecond() == sourceFile {
            return true;
        }
    }
    return false;
}

#[ignoreUnusedReturnValue]
public f<SourceFile*> SourceFile.requestRuntimeModule(RuntimeModule runtimeModule) {
    // Check if the module was already imported
    if this.isRuntimeModuleAvailable(runtimeModule) {
        return this.resourceManager.runtimeModuleManager.getModule(runtimeModule);
    }
    return this.resourceManager.runtimeModuleManager.requestModule(this, runtimeModule);
}

public f<bool> SourceFile.isRuntimeModuleAvailable(RuntimeModule runtimeModule) {
    return (this.importedRuntimeModules & runtimeModule) != 0;
}

public p SourceFile.addNameRegistryEntry(const String& symbolName, unsigned long typeId, SymbolTableEntry* entry, Scope* scope, bool keepNewOnCollision, SymbolTableEntry* importEntry) {
    if keepNewOnCollision || !this.exportedNameRegistry.contains(symbolName) { // Overwrite potential existing entry
        if this.exportedNameRegistry.contains(symbolName) {
            const SymbolTableEntry* oldTargetEntry = this.exportedNameRegistry.get(symbolName).targetEntry;
            this.untrackNameRegistryTargetEntry(oldTargetEntry);
            this.exportedNameRegistry.remove(symbolName);
        }
        this.exportedNameRegistry.upsert(symbolName, NameRegistryEntry{typeId, entry, scope, importEntry});
        this.trackNameRegistryTargetEntry(entry);
        if keepNewOnCollision && this.ambiguousNameRegistry.contains(symbolName) {
            this.ambiguousNameRegistry.remove(symbolName);
        }
    } else { // Name collision => we must remove the existing entry. Remember the colliding imports to report the ambiguity later
        if !this.ambiguousNameRegistry.contains(symbolName) {
            this.ambiguousNameRegistry.upsert(symbolName, Vector<const SymbolTableEntry*>());
        }
        Vector<const SymbolTableEntry*>& collidingImports = this.ambiguousNameRegistry.get(symbolName);
        collidingImports.pushBack(this.exportedNameRegistry.get(symbolName).importEntry);
        collidingImports.pushBack(importEntry);
        const SymbolTableEntry* oldTargetEntry = this.exportedNameRegistry.get(symbolName).targetEntry;
        this.untrackNameRegistryTargetEntry(oldTargetEntry);
        this.exportedNameRegistry.remove(symbolName);
    }
}

public f<const NameRegistryEntry*> SourceFile.getNameRegistryEntry(const String& symbolName) {
    if !this.exportedNameRegistry.contains(symbolName) {
        return nil<NameRegistryEntry*>;
    }

    // Resolve registry entry for the given name
    const NameRegistryEntry* entry = &this.exportedNameRegistry.get(symbolName);

    // Mark the import entry as used
    if entry.importEntry != nil<SymbolTableEntry*> {
        entry.importEntry.used = true;
    }

    return entry;
}

public f<bool> SourceFile.isAmbiguousName(const String& symbolName) {
    return this.ambiguousNameRegistry.contains(symbolName);
}

/**
 * Check if the name registry of this source file knows the struct manifestation with the given body scope
 *
 * @param bodyScope Body scope of the struct manifestation
 * @param structName Name of the struct
 * @return Known or not
 */
public f<bool> SourceFile.isStructKnownByNameRegistry(Scope* bodyScope, const String& structName) {
    if bodyScope == nil<Scope*> || bodyScope.parent == nil<Scope*> {
        return false;
    }

    // All manifestations of a struct live in the scope the struct is defined in, next to the struct's symbol table entry.
    // The name registry entry of a struct points to this symbol table entry, so we can look it up instead of scanning the
    // whole name registry
    const SymbolTableEntry* structEntry = bodyScope.parent.lookupStrict(structName);
    if structEntry == nil<const SymbolTableEntry*> || !this.nameRegistryTargetEntryCounts.contains(getEntryAddress(structEntry)) {
        return false;
    }
    const QualType& structType = structEntry.getQualType();
    if !structType.isBase(SuperType::TY_STRUCT) {
        return false;
    }

    // Check if the body scope belongs to one of the manifestations of the struct
    ASTNode* declNode = structEntry.declNode;
    if declNode.kind != ASTNodeKind::STRUCT_DEF {
        return false;
    }
    const ASTStructDefNode* structDefNode = downcast<ASTStructDefNode>(declNode);
    foreach Struct* manifestation : structDefNode.structManifestations {
        if manifestation.scope == bodyScope {
            return true;
        }
    }
    return false;
}

/**
 * Count a new name registry entry pointing to the given target entry
 *
 * @param targetEntry Target entry of the name registry entry
 */
p SourceFile.trackNameRegistryTargetEntry(const SymbolTableEntry* targetEntry) {
    if targetEntry == nil<const SymbolTableEntry*> {
        return;
    }
    const long entryAddress = getEntryAddress(targetEntry);
    if this.nameRegistryTargetEntryCounts.contains(entryAddress) {
        unsigned long& count = this.nameRegistryTargetEntryCounts.get(entryAddress);
        count++;
    } else {
        this.nameRegistryTargetEntryCounts.upsert(entryAddress, 1ul);
    }
}

/**
 * Uncount a removed name registry entry pointing to the given target entry
 *
 * @param targetEntry Target entry of the name registry entry
 */
p SourceFile.untrackNameRegistryTargetEntry(const SymbolTableEntry* targetEntry) {
    if targetEntry == nil<const SymbolTableEntry*> {
        return;
    }
    const long entryAddress = getEntryAddress(targetEntry);
    assert this.nameRegistryTargetEntryCounts.contains(entryAddress);
    unsigned long& count = this.nameRegistryTargetEntryCounts.get(entryAddress);
    count--;
    if count == 0ul {
        this.nameRegistryTargetEntryCounts.remove(entryAddress);
    }
}

/**
 * Get the address of the given symbol table entry, to use it as a map key
 *
 * @param entry Symbol table entry
 * @return Address of the entry
 */
f<long> getEntryAddress(const SymbolTableEntry* entry) {
    unsafe {
        return cast<long>(entry);
    }
}

/**
 * Build an error message for a name that is not available, because multiple imports expose it. The message lists the
 * colliding imports and suggests how to qualify the name.
 *
 * @param symbolName Ambiguous name
 * @return Error message
 */
public f<String> SourceFile.getAmbiguousNameMessage(const String& symbolName) {
    assert this.isAmbiguousName(symbolName);

    // Collect the distinct imports that expose the name. Runtime imports have no import entry and are skipped
    Vector<ASTImportDefNode*> importNodes;
    const Vector<const SymbolTableEntry*>& importEntries = this.ambiguousNameRegistry.get(symbolName);
    for unsigned long i = 0l; i < importEntries.getSize(); i++ {
        const SymbolTableEntry* importEntry = importEntries.get(i);
        if importEntry == nil<const SymbolTableEntry*> {
            continue;
        }
        const ASTImportDefNode* importNode = downcast<ASTImportDefNode>(importEntry.declNode);
        bool alreadyCollected = false;
        for unsigned long j = 0l; j < importNodes.getSize(); j++ {
            if importNodes.get(j) == importNode {
                alreadyCollected = true;
            }
        }
        if !alreadyCollected {
            importNodes.pushBack(importNode);
        }
    }

    String msg = String("'") + symbolName + "' is exposed by ";
    if importNodes.getSize() < 2l {
        msg += "multiple imports";
    } else {
        if importNodes.getSize() == 2l {
            msg += "both ";
        }
        for unsigned long i = 0l; i < importNodes.getSize(); i++ {
            if i > 0l {
                msg += i == importNodes.getSize() - 1l ? " and " : ", ";
            }
            msg += String("'") + importNodes.get(i).importPath + "'";
        }
    }

    // Suggest qualifying the name with the first import name, that can be written in source code
    for unsigned long i = 0l; i < importNodes.getSize(); i++ {
        String& importName = importNodes.get(i).importName;
        if this.isQualifiableImportName(importName) {
            msg += String(". Please qualify it, e.g. '") + importName + SCOPE_ACCESS_TOKEN + symbolName + "'";
            return msg;
        }
    }
    msg += String(". Please import one of them with an alias and qualify it, e.g. 'alias") + SCOPE_ACCESS_TOKEN + symbolName + "'";
    return msg;
}

/**
 * Check if the given import name can be used to qualify a name in source code, i.e. if it is a valid identifier.
 *
 * @param importName Import name
 * @return Qualifiable or not
 */
f<bool> SourceFile.isQualifiableImportName(String& importName) {
    if importName.isEmpty() {
        return false;
    }
    for unsigned long i = 0l; i < importName.getLength(); i++ {
        const char c = importName[i];
        const bool isLowerLetter = c >= 'a' && c <= 'z';
        const bool isIdentifierChar = isLowerLetter || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
        if !isIdentifierChar || (i == 0l && !isLowerLetter && c != '_') {
            return false;
        }
    }
    return true;
}

/**
 * Abort the compilation if a hard error was raised. Hard errors are recorded (see ErrorManager), so each stage checks for them
 * afterwards.
 */
public p SourceFile.checkForHardError() {
    const ErrorManager& errorManager = this.resourceManager.errorManager;
    if errorManager.hasHardError {
        abortWithError(errorManager.hardErrorMessage);
    }
}

/**
 * Check that no two definitions of the program are exported under the same linker symbol name. Non-public symbols get
 * internal linkage and therefore can never collide. Public ones get external linkage under a name that does not contain
 * the source file, so e.g. two public functions with the same signature in different source files would break the linking.
 * Every collision is reported as soft error.
 */
p SourceFile.checkForExportedSymbolCollisions() {
    UnorderedMap<String, ASTNode*> exportedSymbols;
    // Spice cannot hash pointers, so the visited files are identified by their file path, which is unique per source file
    UnorderedSet<String> visitedSourceFiles;
    this.registerExportedSymbols(exportedSymbols, visitedSourceFiles);
    this.checkForSoftErrors();
}

/**
 * In freestanding mode, the memory and string runtime allocate with the allocator functions of the program (see
 * TypeChecker.registerAllocatorFunction). So a program, that uses them, has to define all allocator functions. Otherwise, it
 * would only fail at link time.
 */
p SourceFile.checkForAllocatorFunctions() {
    const RuntimeModuleManager& runtimeModuleManager = this.resourceManager.runtimeModuleManager;
    const bool allocates = runtimeModuleManager.isModuleAvailable(RuntimeModule::MEMORY_RT) || runtimeModuleManager.isModuleAvailable(RuntimeModule::STRING_RT);
    if !allocates {
        return;
    }
    Vector<String> missingAttrs;
    if this.resourceManager.allocFunction == nil<model::Function*> {
        missingAttrs.pushBack(String(ATTR_CORE_COMPILER_ALLOC_FUNCTION));
    }
    if this.resourceManager.reallocFunction == nil<model::Function*> {
        missingAttrs.pushBack(String(ATTR_CORE_COMPILER_REALLOC_FUNCTION));
    }
    if this.resourceManager.deallocFunction == nil<model::Function*> {
        missingAttrs.pushBack(String(ATTR_CORE_COMPILER_DEALLOC_FUNCTION));
    }
    if missingAttrs.isEmpty() {
        return;
    }
    String message = String("The program uses heap allocations, which need allocator functions in freestanding mode. Missing: ");
    for unsigned long i = 0l; i < missingAttrs.getSize(); i++ {
        message += i == 0l ? "" : ", ";
        message += missingAttrs.get(i);
    }
    this.resourceManager.errorManager.addHardError(cast<ASTNode*>(this.ast), SemanticErrorType::MISSING_ALLOCATOR_FUNCTIONS, message, false);
    this.checkForHardError();
}

/**
 * Register the exported symbols of this source file and all its (transitive) dependencies in the given registry. This
 * covers the same source files as collectBackEndSourceFiles, so exactly the ones that end up in the linked program.
 *
 * @param exportedSymbols Registry, that maps each linker symbol name to the AST node of its definition
 * @param visitedSourceFiles File paths of the source files, that were already registered
 */
p SourceFile.registerExportedSymbols(UnorderedMap<String, ASTNode*>& exportedSymbols, UnorderedSet<String>& visitedSourceFiles) {
    // Guard against circular imports
    const String filePathStr = String(this.filePath.toString());
    if visitedSourceFiles.contains(filePathStr) {
        return;
    }
    visitedSourceFiles.insert(filePathStr);

    // Register the symbols of all dependencies first, so that a collision is reported at the definition in the importing file
    foreach dyn dependency : this.dependencies {
        SourceFile* sourceFile = dependency.getSecond();
        sourceFile.registerExportedSymbols(exportedSymbols, visitedSourceFiles);
    }

    // The symbols of the freestanding libc runtime are weak, so the program may define them as well
    if this.resourceManager.runtimeModuleManager.isModule(this, RuntimeModule::LIBC_RT) {
        return;
    }

    foreach IVisitable* topLevelDef : this.ast.topLevelDefs {
        ASTNode* node = getASTNode(topLevelDef);
        if node.kind == ASTNodeKind::GLOBAL_VAR_DEF {
            // Public globals are exported under their plain name
            const ASTGlobalVarDefNode* globalVarDef = downcast<ASTGlobalVarDefNode>(node);
            const QualType& globalVarType = globalVarDef.entry.getQualType();
            if globalVarType.isPublic() {
                this.registerExportedSymbol(exportedSymbols, globalVarDef.varName, globalVarDef.varName, node);
            }
        } else if node.kind == ASTNodeKind::FCT_DEF || node.kind == ASTNodeKind::PROC_DEF {
            ASTFctDefBaseNode* fctDef = nil<ASTFctDefBaseNode*>;
            if node.kind == ASTNodeKind::FCT_DEF {
                ASTFctDefNode* fctDefNode = downcast<ASTFctDefNode>(node);
                fctDef = &fctDefNode.node;
            } else {
                ASTProcDefNode* procDefNode = downcast<ASTProcDefNode>(node);
                fctDef = &procDefNode.node;
            }
            // Each emitted manifestation of an exported function is exported under its mangled name
            foreach const model::Function* manifestation : fctDef.manifestations {
                if manifestation.isFullySubstantiated() && isExportedFunction(manifestation, this.cliOptions.generateTestMain) {
                    this.registerExportedSymbol(exportedSymbols, manifestation.getMangledName(), manifestation.getSignature(), node);
                }
            }
        }
    }
}

/**
 * Register a single exported symbol and report a soft error if another definition is already exported under its name
 *
 * @param exportedSymbols Registry, that maps each linker symbol name to the AST node of its definition
 * @param linkerName Name of the symbol for the linker
 * @param displayName Name of the symbol for the error message
 * @param declNode Definition of the symbol
 */
p SourceFile.registerExportedSymbol(UnorderedMap<String, ASTNode*>& exportedSymbols, const String& linkerName, const String& displayName, ASTNode* declNode) {
    if !exportedSymbols.contains(linkerName) {
        exportedSymbols.upsert(linkerName, declNode);
        return;
    }
    const ASTNode* existingDeclNode = exportedSymbols.get(linkerName);
    if existingDeclNode == declNode {
        return;
    }
    const String message = "Exported symbol '" + displayName + "' collides with the exported symbol defined at " + existingDeclNode.codeLoc.toPrettyString() + ", because both have the linker name '" + linkerName + "'";
    this.resourceManager.errorManager.addSoftError(declNode, SemanticErrorType::EXPORTED_SYMBOL_COLLISION, message);
}

public p SourceFile.checkForSoftErrors() {
    // Check if there are any soft errors and if so, print them
    if !this.resourceManager.errorManager.softErrors.isEmpty() {
        String errorMessage = String("There are unresolved errors. Please fix them and recompile.");
        foreach const SoftError& error : this.resourceManager.errorManager.softErrors {
            errorMessage += "\n\n";
            errorMessage += error.message;
        }
        const CompilerError compilerError = CompilerError(CompilerErrorType::UNRESOLVED_SOFT_ERRORS, errorMessage.getRaw());
        abortWithError(compilerError.getMessage());
    }
}

public f<bool> SourceFile.isLibraryOutput() {
    return this.cliOptions.outputContainer == OutputContainer::STATIC_LIBRARY || this.cliOptions.outputContainer == OutputContainer::SHARED_LIBRARY;
}

/**
 * Get the path of the object file, that the object emitter emits for this source file. With the object file output container,
 * the object of the main source file is the output file, so it goes to the output path.
 *
 * @return Object file path
 */
public f<FilePath> SourceFile.getObjectFilePath() {
    if this.isMainFile && this.cliOptions.outputContainer == OutputContainer::OBJECT_FILE {
        return this.cliOptions.outputPath;
    }
    const string objectFileExt = getOutputFileExtension(this.cliOptions, OutputContainer::OBJECT_FILE);
    return this.cliOptions.outputDir / (this.objectFileStem + "." + objectFileExt);
}

public p SourceFile.collectAndPrintWarnings() {
    // Skip if already visited. This keeps circular imports from recursing infinitely, since the dependency graph may contain
    // cycles.
    if this.warningsCollected {
        return;
    }
    this.warningsCollected = true;
    // Print warnings for all dependencies
    foreach dyn dependency : this.dependencies {
        SourceFile* sourceFile = dependency.getSecond();
        if !sourceFile.isStdFile {
            sourceFile.collectAndPrintWarnings();
        }
    }
    // Warnings of external packages are no concern of the user
    if this.isPackageFile {
        return;
    }
    // Collect warnings for this file
    if !this.ignoreWarnings {
        this.globalScope.collectWarnings(this.compilerOutput.warnings);
    }
    // Print warnings for this file. Generic code is checked once per manifestation, so the same warning may have been added
    // multiple times. Print each of them only once
    UnorderedSet<String> printedWarnings;
    foreach dyn warning : this.compilerOutput.warnings {
        if !printedWarnings.contains(warning.warningMessage) {
            printedWarnings.insert(warning.warningMessage);
            warning.print();
        }
    }
}

public p SourceFile.collectAndPrintLintFindings() {
    // Skip if already visited. This keeps circular imports from recursing infinitely, since the dependency graph may contain
    // cycles.
    if this.lintFindingsCollected {
        return;
    }
    this.lintFindingsCollected = true;
    // Collect lint findings for all dependencies
    foreach dyn dependency : this.dependencies {
        SourceFile* sourceFile = dependency.getSecond();
        if !sourceFile.isStdFile {
            sourceFile.collectAndPrintLintFindings();
        }
    }
    // Lint findings of external packages are no concern of the user
    if this.isPackageFile {
        return;
    }
    // Collect lint findings for this file
    if !this.ignoreWarnings {
        LintPass lintPass = LintPass(this.resourceManager, this);
        this.compilerOutput.lintFindings = lintPass.lint(this.ast);
    }
    // Print lint findings for this file
    foreach dyn finding : this.compilerOutput.lintFindings {
        finding.print();
    }
}

public f<const SourceFile*> SourceFile.getRootSourceFile() {
    return this.isMainFile ? this : this.parent.getRootSourceFile();
}

/**
 * Get the LLVM context, the LLVM entities of this source file live in
 *
 * @return LLVM context
 */
public f<llvm::LLVMContext&> SourceFile.getLLVMContext() {
    return this.cliOptions.useLTO ? this.resourceManager.ltoContext : this.context;
}

/**
 * Get the LLVM type of the given type. The LLVM types are cached, so that each type gets lowered only once (e.g. named struct
 * types would otherwise be created multiple times).
 *
 * @param rawType Type
 * @return LLVM type
 */
public f<llvm::Type> SourceFile.getLLVMType(const symboltable::Type* rawType) {
    // Check if the type is already in the mapping
    long typeAddress = 0l;
    unsafe {
        typeAddress = cast<long>(rawType);
    }
    if this.typeToLLVMTypeMapping.contains(typeAddress) {
        return this.typeToLLVMTypeMapping.get(typeAddress);
    }

    // If not, generate the LLVM type
    const llvm::Type llvmType = rawType.toLLVMType(this);
    this.typeToLLVMTypeMapping.upsert(typeAddress, llvmType);
    return llvmType;
}

/**
 * Check if this source file is the given runtime module itself
 *
 * @param runtimeModule Runtime module
 * @return Is the runtime module or not
 */
public f<bool> SourceFile.isRT(RuntimeModule runtimeModule) {
    const String topLevelName = String(getIdentifyingTopLevelName(runtimeModule));
    if !this.exportedNameRegistry.contains(topLevelName) {
        return false;
    }
    const NameRegistryEntry& entry = this.exportedNameRegistry.get(topLevelName);
    return entry.targetEntry.scope == this.globalScope;
}

// Check if this source file is the string / memory / RTTI / result runtime module itself
public inline f<bool> SourceFile.isStringRT() { return this.isRT(RuntimeModule::STRING_RT); }
public inline f<bool> SourceFile.isMemoryRT() { return this.isRT(RuntimeModule::MEMORY_RT); }
public inline f<bool> SourceFile.isRttiRT() { return this.isRT(RuntimeModule::RTTI_RT); }
public inline f<bool> SourceFile.isResultRT() { return this.isRT(RuntimeModule::RESULT_RT); }

f<bool> SourceFile.haveAllDependantsBeenTypeChecked() {
    foreach const SourceFile* dependant : this.dependants {
        if dependant.totalTypeCheckerRuns != 0s {
            continue;
        }
        // Ignore dependants that are part of the same import cycle (i.e. this file transitively depends on them). They
        // cannot be type-checked before us either, so waiting on them would deadlock the whole cycle. Searching the import
        // graph is expensive, so this is only checked for dependants that were not type-checked yet.
        if !this.dependsOn(dependant) {
            return false;
        }
    }
    return true;
}

public p SourceFile.mergeNameRegistries(const SourceFile& importedSourceFile, const String& importName) { // Public for the RuntimeModuleManager
    // Retrieve import entry
    SymbolTableEntry* importEntry = this.globalScope.lookupStrict(importName);
    assert importEntry != nil<SymbolTableEntry*> || importName.startsWith("__"); // Runtime imports start with two underscores

    foreach const Pair<const String&, NameRegistryEntry&> item : importedSourceFile.exportedNameRegistry {
        const String& originalName = item.getFirst();
        const NameRegistryEntry& entry = item.getSecond();
        // Skip if we introduce a transitive dependency
        if entry.targetScope.sourceFile.globalScope != importedSourceFile.globalScope {
            continue;
        }
        // Add the fully qualified name
        String newName = importName;
        newName += SCOPE_ACCESS_TOKEN;
        newName += originalName;
        if !this.exportedNameRegistry.contains(newName) {
            this.exportedNameRegistry.upsert(newName, NameRegistryEntry{entry.typeId, entry.targetEntry, entry.targetScope, importEntry});
            this.trackNameRegistryTargetEntry(entry.targetEntry);
        }
        // Add the shortened name, considering the name collision. A symbol defined in the importing file itself always
        // shadows imported symbols of the same name. Since this merge runs after the file built its own registry (so that
        // circular imports work), we must explicitly avoid letting an import overwrite or erase such an own symbol.
        const NameRegistryEntry* existing = this.exportedNameRegistry.contains(originalName) ? &this.exportedNameRegistry.get(originalName) : nil<NameRegistryEntry*>;
        const bool existingIsOwn = existing != nil<NameRegistryEntry*> && existing.targetScope.sourceFile.globalScope == this.globalScope;
        if !existingIsOwn {
            const bool keepOnCollision = importedSourceFile.alwaysKeepSymbolsOnNameCollision;
            this.addNameRegistryEntry(originalName, entry.typeId, entry.targetEntry, entry.targetScope, keepOnCollision, importEntry);
        }
    }
}

/**
 * Recursively merge the exported name registries of all (transitive) dependencies into the respective importing source
 * files. Each file merges its direct dependencies' registries exactly once (guarded by registriesMerged), so this is
 * safe to call on overlapping subgraphs and on graphs that contain cycles (circular imports).
 *
 * Must only be called once every reachable file has built its own exported name registry (i.e. after the front-end).
 */
public p SourceFile.mergeNameRegistriesRecursive() {
    if this.registriesMerged {
        return;
    }
    this.registriesMerged = true;

    // Merge the direct dependencies' registries into this file. Their own registries are fully built by now, so the
    // order in which the reachable files are visited does not matter (even across import cycles).
    foreach dyn dependency : this.dependencies {
        const String& importName = dependency.getFirst();
        const SourceFile* sourceFile = dependency.getSecond();
        this.mergeNameRegistries(*sourceFile, importName);
    }

    // Recurse into the dependencies to cover the rest of the reachable graph
    foreach dyn dependency : this.dependencies {
        SourceFile* sourceFile = dependency.getSecond();
        sourceFile.mergeNameRegistriesRecursive();
    }
}

/**
 * Check whether this source file transitively depends on (imports) the given other source file.
 * Used to detect strongly connected components (import cycles) in the dependency graph.
 *
 * @param other Potential (transitive) dependency
 * @return true if this file reaches the other file by following dependency edges
 */
f<bool> SourceFile.dependsOn(const SourceFile* other) {
    // Spice cannot hash pointers, so the visited files are identified by their file path, which is unique per source file
    UnorderedSet<String> visited;
    Vector<const SourceFile*> worklist;
    worklist.pushBack(this);
    visited.insert(String(this.filePath.toString()));
    while !worklist.isEmpty() {
        const SourceFile* current = worklist.back();
        worklist.popBack();
        foreach dyn dep : current.dependencies {
            const SourceFile* dependency = dep.getSecond();
            if dependency == other {
                return true;
            }
            const String dependencyPath = String(dependency.filePath.toString());
            if !visited.contains(dependencyPath) {
                visited.insert(dependencyPath);
                worklist.pushBack(dependency);
            }
        }
    }
    return false;
}

p SourceFile.dumpCacheStats() {
    StringStream cacheStats;
    cacheStats << dumpFunctionLookupCacheStatistics() << "\n";
    cacheStats << dumpStructLookupCacheStatistics() << "\n";
    cacheStats << dumpInterfaceLookupCacheStatistics() << "\n";
    cacheStats << dumpUnionLookupCacheStatistics() << "\n";
    this.compilerOutput.cacheStats = cacheStats.str();
}

p SourceFile.dumpCompilationStats() {
    const unsigned long sourceFileCount = this.resourceManager.sourceFiles.getSize();
    const unsigned long totalLineCount = this.resourceManager.getTotalLineCount();
    const unsigned long totalTypeCount = this.resourceManager.typeRegistry.getTypeCount();
    const unsigned long allocatedBytes = this.resourceManager.astNodeAlloc.getTotalAllocatedSize();
    const unsigned long allocationCount = this.resourceManager.astNodeAlloc.getAllocationCount();
    const unsigned long frontEndDuration = this.resourceManager.frontEndTimer.getDurationInMillis();
    const unsigned long middleEndDuration = this.resourceManager.middleEndTimer.getDurationInMillis();
    const unsigned long backEndDuration = this.resourceManager.backEndTimer.getDurationInMillis();
    const unsigned long totalDuration = frontEndDuration + middleEndDuration + backEndDuration;
    print("\nSuccessfully compiled " + toString(sourceFileCount) + " source file(s)");
    print(" or " + toString(totalLineCount) + " lines in total.\n");
    print("Total number of blocks allocated via BlockAllocator: " + formatStorageSize(allocatedBytes));
    print(" in " + toString(allocationCount) + " allocations.\n");
    print("Total number of types: " + toString(totalTypeCount) + "\n");
    print("Total compile time: " + toString(totalDuration) + " ms (frontend: " + toString(frontEndDuration));
    print(" ms, middle end: " + toString(middleEndDuration) + " ms, backend: " + toString(backEndDuration) + " ms)\n");
}

p SourceFile.dumpOutput(const String& content, const String& caption, const String& fileSuffix) {
    if this.cliOptions.dump.dumpToFiles {
        // Dump to file
        const String dumpFileName = this.filePath.getBaseName() + "-" + fileSuffix;
        FilePath dumpFilePath = this.cliOptions.outputDir / dumpFileName;
        dumpFilePath.makeNative();
        const Result<bool> writeResult = writeFile(dumpFilePath.toString(), content.getRaw());
        if !writeResult.isOk() {
            const String messageSuffix = "Failed to open file: " + dumpFilePath.toString();
            const CompilerError error = CompilerError(CompilerErrorType::IO_ERROR, messageSuffix.getRaw());
            abortWithError(error.getMessage());
        }
    } else {
        // Dump to console
        print("\n" + caption + ":\n" + content);
    }

    // If the abort after dump is requested, set the abort compilation flag
    if this.cliOptions.dump.abortAfterDump {
        // If this is an IR dump whilst having optimization enabled, we may not abort when dumping unoptimized IR,
        // because we also have to dump the optimized IR
        if this.cliOptions.dump.dumpIR && fileSuffix == "ir-code.ll" {
            this.resourceManager.abortCompilation = this.cliOptions.optLevel == OptLevel::O0;
        } else {
            this.resourceManager.abortCompilation = true;
        }
    }
}

p SourceFile.visualizerPreamble(StringStream& output) {
    if this.isMainFile {
        output << "digraph {\n rankdir=\"TB\";\n";
    } else {
        output << "subgraph {\n";
    }
    output << " label=\"" << this.filePath.toGenericString() << "\";\n";
}

p SourceFile.visualizerOutput(const string outputNameRaw, const String& output) {
    if this.cliOptions.dump.dumpToFiles {
        // The dump file names are lower case
        const String outputName = toLower(String(outputNameRaw));

        // Check if graphviz is installed
        if !isGraphvizInstalled() {
            const CompilerError error = CompilerError(CompilerErrorType::IO_ERROR, "Please check if you have installed Graphviz and added it to the PATH variable");
            abortWithError(error.getMessage());
        }

        // Write to a dot file
        this.dumpOutput(output, outputName, outputName + ".dot");

        // Generate SVG. This only works if the dot code was dumped into a file
        print("\nGenerating SVG file ... ");
        const String dotFileName = this.filePath.getBaseName() + "-" + outputName + ".dot";
        FilePath dotFilePath = this.cliOptions.outputDir / dotFileName;
        FilePath svgFilePath = dotFilePath;
        svgFilePath.replaceExtension("svg");
        dotFilePath.makeNative();
        svgFilePath.makeNative();
        Vector<String> dotArgs;
        dotArgs.pushBack(String("-T"));
        dotArgs.pushBack(String("svg"));
        dotArgs.pushBack(String("-o"));
        dotArgs.pushBack(String(svgFilePath.toString()));
        dotArgs.pushBack(String(dotFilePath.toString()));
        const ExecResult _ = exec(String("dot"), dotArgs);
        print("done.\nSVG file can be found at: \"" + svgFilePath.toString() + "\"\n");
    } else {
        // Dump to console
        print("\nSerialized " + String(outputNameRaw) + ":\n\n" + output + "\n");
    }

    // If the abort after dump is requested, set the abort compilation flag
    if this.cliOptions.dump.abortAfterDump {
        this.resourceManager.abortCompilation = true;
    }
}

p SourceFile.printStatusMessage(const string stage, const CompileStageIOType& in, const CompileStageIOType& out, unsigned long stageRuntime, unsigned short stageRuns = 0s) {
    if this.cliOptions.printDebugOutput {
        const string[5] compilerStageIoTypeName = ["Code", "CST", "AST", "IR", "Obj"];
        // Build output string
        StringStream outputStr;
        outputStr << "[" << stage << "] for " << this.fileName << ": ";
        outputStr << compilerStageIoTypeName[cast<int>(in)] << " --> " << compilerStageIoTypeName[cast<int>(out)];
        outputStr << " (" << toString(stageRuntime) << " ms";
        if stageRuns > 0s {
            outputStr << "; " << toString(stageRuns) << " run(s)";
        }
        outputStr << ")\n";
        // Print
        print(outputStr.str());
    }
}

// ─── tests ────────────────────────────────────────────────────────────────────

#[test]
f<bool> testGetObjectFilePath() {
    const FilePath testDir = makeUniqueTestDir("spice-object-path-test");
    const FilePath mainPath = testDir / "main.spice";
    const FilePath utilsPath = testDir / "utils.spice";
    writeTestFile(mainPath, "");
    writeTestFile(utilsPath, "");

    string objectFileExt;
    FilePath execMainObjectPath;
    FilePath execUtilsObjectPath;
    FilePath objMainObjectPath;
    FilePath objUtilsObjectPath;
    {
        // Source files look up an LLVM target, so use the native one
        CliOptions cliOptions;
        cliOptions.targetTriple = llvm::normalizeTargetTriple(llvm::getDefaultTargetTriple());
        cliOptions.isNativeTarget = true;
        cliOptions.outputDir = testDir;
        cliOptions.outputPath = testDir / "custom-name.o";
        objectFileExt = getOutputFileExtension(cliOptions, OutputContainer::OBJECT_FILE);
        GlobalResourceManager resourceManager = GlobalResourceManager(cliOptions);
        SourceFile* mainFile = resourceManager.createSourceFile(nil<SourceFile*>, String("main"), mainPath, false);
        SourceFile* utils = resourceManager.createSourceFile(mainFile, String("utils"), utilsPath, false);
        utils.isMainFile = false;

        // When linking, every source file emits its object file into the output dir
        cliOptions.outputContainer = OutputContainer::EXECUTABLE;
        execMainObjectPath = mainFile.getObjectFilePath();
        execUtilsObjectPath = utils.getObjectFilePath();
        // With the object file output container, the object of the main source file is the output file
        cliOptions.outputContainer = OutputContainer::OBJECT_FILE;
        objMainObjectPath = mainFile.getObjectFilePath();
        objUtilsObjectPath = utils.getObjectFilePath();
    }

    // Clean up before asserting, so that a failure does not leave the files behind
    removeTestDir(testDir);
    FilePath expectedMainObjectPath = testDir / "main.spice";
    expectedMainObjectPath.replaceExtension(objectFileExt);
    FilePath expectedUtilsObjectPath = testDir / "utils.spice";
    expectedUtilsObjectPath.replaceExtension(objectFileExt);
    assert execMainObjectPath == expectedMainObjectPath;
    assert execUtilsObjectPath == expectedUtilsObjectPath;
    assert objMainObjectPath == testDir / "custom-name.o";
    assert objUtilsObjectPath == expectedUtilsObjectPath;
    return true;
}

#[test]
f<bool> testPackageFilesAreMarked() {
    const FilePath testDir = makeUniqueTestDir("spice-package-file-test");
    const FilePath packageDir = testDir / "spice_packages" / "pkg";
    createTestDirs(packageDir);
    const FilePath mainPath = testDir / "main.spice";
    writeTestFile(mainPath, "import \"spice_packages/pkg/entry\" as entry;\nimport \"own\" as own;\n\nf<int> main() {}\n");
    writeTestFile(testDir / "own.spice", "");
    writeTestFile(testDir / "shared.spice", "");
    // Relative imports of package files stay in the package, '@/' imports reach the code of the user
    writeTestFile(packageDir / "entry.spice", "import \"helper\" as helper;\nimport \"@/shared\" as shared;\n");
    writeTestFile(packageDir / "helper.spice", "");

    bool mainIsPackageFile;
    bool ownIsPackageFile;
    bool entryIsPackageFile;
    bool helperIsPackageFile;
    bool sharedIsPackageFile;
    {
        // Source files look up an LLVM target, so use the native one
        CliOptions cliOptions;
        cliOptions.targetTriple = llvm::normalizeTargetTriple(llvm::getDefaultTargetTriple());
        cliOptions.isNativeTarget = true;
        cliOptions.mainSourceFile = mainPath;
        GlobalResourceManager resourceManager = GlobalResourceManager(cliOptions);
        SourceFile* mainFile = resourceManager.createSourceFile(nil<SourceFile*>, String("main"), mainPath, false);
        mainFile.runFrontEnd();
        SourceFile* entry = mainFile.dependencies.get(String("entry"));
        mainIsPackageFile = mainFile.isPackageFile;
        ownIsPackageFile = mainFile.dependencies.get(String("own")).isPackageFile;
        entryIsPackageFile = entry.isPackageFile;
        helperIsPackageFile = entry.dependencies.get(String("helper")).isPackageFile;
        sharedIsPackageFile = entry.dependencies.get(String("shared")).isPackageFile;
    }

    // Clean up before asserting, so that a failure does not leave the files behind
    removeTestDir(testDir);
    assert !mainIsPackageFile;
    assert !ownIsPackageFile;
    assert entryIsPackageFile;
    assert helperIsPackageFile;
    assert !sharedIsPackageFile;
    return true;
}
