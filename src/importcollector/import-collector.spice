// Std imports
import "std/type/any";
import "std/data/vector";
import "std/io/filepath";

// Own imports
import "@/compiler-pass";
import "@/ast/ast-nodes";
import "@/ast/attributes";
import "@/ast/abstract-ast-visitor-intf";
import "@/exception/error-manager";
import "@/exception/semantic-error";
import "@/global/global-resource-manager";
import "@/source-file";
import "@/symboltablebuilder/symbol-table-entry";
import "@/util/system-util";

// Dir, that Spice Shaker installs the external packages to
const string PACKAGES_DIR_PREFIX = "spice_packages/";
const string PACKAGES_DIR_INFIX = "/spice_packages/";

/**
 * Jobs:
 * - Visit the import statements of a source file and register the imported files as dependencies to the current one
 */
public type ImportCollector struct : IAbstractAstVisitor {
    compose public CompilerPass compilerPass
}

public p ImportCollector.ctor(GlobalResourceManager& resourceManager, SourceFile* sourceFile) {
    this.compilerPass = CompilerPass(resourceManager, sourceFile);
}

public f<Any> ImportCollector.visitEntry(ASTEntryNode* node) {
    // Visit all module attributes
    foreach IVisitable* attr : node.modAttrs {
        this.visit(attr);
    }

    // Visit all import defs
    foreach IVisitable* importDef : node.importDefs {
        this.visit(importDef);
    }

    return Any();
}

public f<Any> ImportCollector.visitImportDef(ASTImportDefNode* node) {
    // Validate the import path before resolving it against any base directory. Import paths must be relative and
    // must not contain parent-directory ('..') components. Otherwise a malicious source file could escape the
    // std/project roots (e.g. 'import "../../../etc/x"' or 'import "std/../../../etc/x"') and read
    // arbitrary files, or worse, smuggle shell metacharacters into a filename that later ends up in a linker
    // invocation.
    ASTNode* baseNode = cast<ASTNode*>(node);
    ErrorManager& errorManager = this.resourceManager.getErrorManager();
    const FilePath& ownFilePath = this.sourceFile.getFilePath();
    const FilePath importPathRelative = FilePath(node.importPath);
    if importPathRelative.hasRootPath() {
        errorManager.addHardError(baseNode, SemanticErrorType::INVALID_IMPORT_PATH, "Import paths must be relative, but '" + node.importPath + "' is not");
        return Any();
    }
    if importPathRelative.hasParentDirComponent() {
        errorManager.addHardError(baseNode, SemanticErrorType::INVALID_IMPORT_PATH, "Import paths must not contain parent-directory ('..') components: '" + node.importPath + "'");
        return Any();
    }

    const bool isStd = node.importPath.startsWith("std/");
    // Imports with the '@/' prefix are resolved against the dir of the main source file, independent of the dir of the
    // importing source file
    const bool isMainRelative = node.importPath.startsWith("@/");

    // Determine the root dir, that the import is resolved against, and the path of the imported file within it
    const String ownFileDir = ownFilePath.getParentDir();
    FilePath rootDir;
    String pathInRootDir = node.importPath;
    if isStd { // Include source file from standard library
        rootDir = getStdDir();
        pathInRootDir = node.importPath.getSubstring(node.importPath.find("std/") + 4l);
    } else if isMainRelative { // Include own source file, relative to the main source file
        rootDir = FilePath(this.cliOptions.mainSourceFile.getParentDir());
        pathInRootDir = node.importPath.getSubstring(2ul);
    } else { // Include own source file, relative to the importing source file
        rootDir = FilePath(ownFileDir);
    }
    FilePath basePath = rootDir / pathInRootDir;

    // Check which source file to import
    const String stem = basePath.getFileName();
    Vector<FilePath> candidatePaths;
    const FilePath importPath = resolvePlatformSpecificSourceFile(this.cliOptions, basePath, ownFilePath, candidatePaths);
    if importPath.isEmpty() {
        String errorMessage = "The source file '" + stem + ".spice' was not found\n\n";
        errorMessage += "The following paths were checked with descending priority:";
        foreach const FilePath& candidatePath : candidatePaths {
            const String displayedPath = this.cliOptions.comparableOutput ? candidatePath.getFileName() : String(candidatePath.toGenericString());
            errorMessage += "\n- " + displayedPath;
        }
        errorManager.addHardError(baseNode, SemanticErrorType::IMPORTED_FILE_NOT_EXISTING, errorMessage);
        return Any();
    }

    // The lexical '..'-component check above only rejects traversal spelled out in the import path itself. A
    // same-looking relative import can still resolve outside the intended std/project root if a
    // directory along the way is a symlink. Canonicalize the resolved file and its intended base directory
    // (this also resolves symlinks) and reject the import unless the former stays contained in the latter.
    // A source file given as a bare filename (e.g. 'spice build main.spice') has an empty parent dir; treat that
    // as the current directory, since that is what the empty path already means to every other join above.
    FilePath intendedRoot = rootDir;
    if !isStd && rootDir.isEmpty() {
        intendedRoot = FilePath(String("."));
    }
    const FilePath allowedRoot = intendedRoot.canonical();
    const FilePath canonicalImportPath = importPath.canonical();
    const String allowedRootPrefix = String(allowedRoot.toGenericString()) + "/";
    const String canonicalImportPathStr = String(canonicalImportPath.toGenericString());
    const bool isContained = allowedRoot == canonicalImportPath || canonicalImportPathStr.startsWith(allowedRootPrefix.getRaw());
    if !isContained {
        errorManager.addHardError(baseNode, SemanticErrorType::INVALID_IMPORT_PATH, "Import path '" + node.importPath + "' escapes the permitted directory tree");
        return Any();
    }

    // Check if the import already exists
    if this.rootScope.lookupStrict(node.importName) != nil<SymbolTableEntry*> {
        errorManager.addHardError(baseNode, SemanticErrorType::DUPLICATE_IMPORT_NAME, "Duplicate import '" + node.importName + "'");
        return Any();
    }

    // Create symbol for import
    node.entry = this.rootScope.insert(node.importName, baseNode);

    // Create the imported source file
    SourceFile* importedSourceFile = this.resourceManager.createSourceFile(this.sourceFile, node.importName, importPath, isStd);
    // Files of external packages, installed by Spice Shaker to the spice_packages dir, are no concern of the user. A file
    // belongs to a package if the import path goes through a spice_packages dir or if a package file imports it relatively.
    // '@/' imports of package files resolve against the main source file dir, so they reach code of the user
    const bool importsIntoPackagesDir = pathInRootDir.startsWith(PACKAGES_DIR_PREFIX) || pathInRootDir.contains(PACKAGES_DIR_INFIX);
    if !isStd && (importsIntoPackagesDir || (!isMainRelative && this.sourceFile.isPackageFile)) {
        importedSourceFile.isPackageFile = true;
    }
    // Register it as a dependency to the current source file
    this.sourceFile.addDependency(importedSourceFile, node.importName);

    return Any();
}

public f<Any> ImportCollector.visitModAttr(ASTModAttrNode* node) {
    // !!! Only bool attributes allowed here, due to missing attribute value checks being executed in a later stage !!!

    // core.compiler.keep-on-name-collision
    if node.attrLst.hasAttr(String(ATTR_CORE_COMPILER_KEEP_ON_NAME_COLLISION)) {
        const CompileTimeValue keepOnCollisionAttrValue = node.attrLst.getAttrValueByName(String(ATTR_CORE_COMPILER_KEEP_ON_NAME_COLLISION));
        const bool keepOnCollision = keepOnCollisionAttrValue.getBoolValue();
        this.sourceFile.setAlwaysKeepSymbolsOnNameCollision(keepOnCollision);
    }

    // core.compiler.warnings.ignore
    if node.attrLst.hasAttr(String(ATTR_CORE_COMPILER_WARNINGS_IGNORE)) {
        const CompileTimeValue ignoreWarningsAttrValue = node.attrLst.getAttrValueByName(String(ATTR_CORE_COMPILER_WARNINGS_IGNORE));
        const bool ignoreWarnings = ignoreWarningsAttrValue.getBoolValue();
        this.sourceFile.setIgnoreWarnings(ignoreWarnings);
    }

    // core.compiler.explicitErrorHandling
    if node.attrLst.hasAttr(String(ATTR_CORE_COMPILER_EXPLICIT_ERROR_HANDLING)) {
        const CompileTimeValue explicitErrorHandlingAttrValue = node.attrLst.getAttrValueByName(String(ATTR_CORE_COMPILER_EXPLICIT_ERROR_HANDLING));
        const bool explicitErrorHandling = explicitErrorHandlingAttrValue.getBoolValue();
        this.sourceFile.setExplicitErrorHandling(explicitErrorHandling);
    }

    // core.compiler.errorReturnTracing
    if node.attrLst.hasAttr(String(ATTR_CORE_COMPILER_ERROR_RETURN_TRACING)) {
        const CompileTimeValue errorReturnTracingAttrValue = node.attrLst.getAttrValueByName(String(ATTR_CORE_COMPILER_ERROR_RETURN_TRACING));
        const bool errorReturnTracing = errorReturnTracingAttrValue.getBoolValue();
        this.sourceFile.setErrorReturnTracing(errorReturnTracing);
    }

    return Any();
}
