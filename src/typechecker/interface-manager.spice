// Std imports
import "std/data/map";
import "std/data/unordered-map";
import "std/data/vector";
import "std/data/pair";
import "std/math/hash";

// Own imports
import "bootstrap/exception/error-manager";
import "bootstrap/exception/semantic-error";
import "bootstrap/ast/ast-nodes";
import "bootstrap/model/interface";
import "bootstrap/model/function";
import "bootstrap/model/generic-type";
import "bootstrap/symboltablebuilder/qual-type";
import "bootstrap/symboltablebuilder/super-type";
import "bootstrap/symboltablebuilder/scope";
import "bootstrap/symboltablebuilder/symbol-table-entry";
import "bootstrap/typechecker/type-matcher";
import "bootstrap/typechecker/function-manager";
import "bootstrap/util/custom-hash-functions";
import "bootstrap/util/lookup-cache";
import "bootstrap/util/concurrency";

// Type aliases
public type InterfaceManifestationList alias UnorderedMap</*mangledName=*/String, Interface>;
// Keyed by the interface name and its declaration code location, like the other registries. CodeLoc alone cannot be ordered by
// std/data/red-black-tree (Spice cannot overload '<').
public type InterfaceRegistry alias Map</*interfaceId=*/String, /*manifestationList=*/InterfaceManifestationList>;

/**
 * Insert an interface declaration into the given scope
 *
 * @param insertScope Scope to insert the interface into
 * @param spiceInterface Interface to insert
 * @param nodeInterfaceList List to collect the inserted manifestation into (owned by the declaration node)
 * @return Inserted interface manifestation
 */
#[ignoreUnusedReturnValue]
public f<Interface*> insertInterface(Scope* insertScope, Interface& spiceInterface, Vector<Interface*>* nodeInterfaceList) {
    // Open a new manifestation list. Which gets filled by the substantiated manifestations of the interface
    const String interfaceId = spiceInterface.name + ":" + spiceInterface.declNode.codeLoc.toString();
    // Keep an existing manifestation list
    if !insertScope.interfaces.contains(interfaceId) {
        insertScope.interfaces.insert(interfaceId, InterfaceManifestationList());
    }

    // Save substantiation in declaration node
    Interface* substantiation = insertSubstantiation(insertScope, spiceInterface, spiceInterface.declNode);
    nodeInterfaceList.pushBack(substantiation);

    return substantiation;
}

f<Interface*> insertSubstantiation(Scope* insertScope, Interface& newManifestation, const ASTNode* declNode) {
    const String signature = newManifestation.structBase.getSignature();

    // Retrieve the matching manifestation list of the scope
    const String interfaceId = newManifestation.name + ":" + declNode.codeLoc.toString();
    assert insertScope.interfaces.contains(interfaceId);
    InterfaceManifestationList& manifestationList = insertScope.interfaces.get(interfaceId);

    // Add substantiated interface
    newManifestation.manifestationIndex = manifestationList.getSize();
    manifestationList.upsert(signature, newManifestation);
    return &manifestationList.get(signature);
}

// Address of the active interface lookup cache. Spice only supports globals of primitive type, so the cache is owned by the
// global resource manager and its address is stored here.
long ACTIVE_INTERFACE_LOOKUP_CACHE_ADDRESS = 0l;

/**
 * Make the given lookup cache the active one. The interface lookup operates on it.
 *
 * @param cache Lookup cache
 */
public p setActiveInterfaceLookupCache(LookupCache<Interface>* cache) {
    unsafe {
        ACTIVE_INTERFACE_LOOKUP_CACHE_ADDRESS = cast<long>(cast<byte*>(cache));
    }
}

/**
 * Get the active interface lookup cache
 *
 * @return Active lookup cache
 */
f<LookupCache<Interface>*> getActiveInterfaceLookupCache() {
    LookupCache<Interface>* cache = nil<LookupCache<Interface>*>;
    unsafe {
        cache = cast<LookupCache<Interface>*>(cast<byte*>(ACTIVE_INTERFACE_LOOKUP_CACHE_ADDRESS));
    }
    assert cache != nil<LookupCache<Interface>*>;
    return cache;
}

/**
 * Check if there is an interface in this scope, fulfilling all given requirements and if found, return it.
 * If more than one interface matches the requirement, this is reported (see ToDo below).
 *
 * @param matchScope Scope to match against
 * @param reqName Interface name requirement
 * @param reqTemplateTypes Template types to substantiate generic types
 * @param node Instantiation AST node for printing error messages
 * @return Matched interface or nil
 */
public f<Interface*> matchInterface(Scope* matchScope, const String& reqName, const QualTypeList& reqTemplateTypes, const ASTNode* node) {
    // The IR generator reaches this from the worker threads of the parallel back end
    ConditionalLock _lock = ConditionalLock(getSymbolRegistryMutex());

    // Do cache lookup
    LookupCache<Interface>* cache = getActiveInterfaceLookupCache();
    const Hash cacheKey = getInterfaceCacheKey(matchScope, reqName, reqTemplateTypes);
    if cache.lookupCache.contains(cacheKey) {
        cache.lookupCacheHits++;
        return cache.lookupCache.get(cacheKey);
    }
    cache.lookupCacheMisses++;

    // Loop over interface registry to find interfaces, that match the requirements of the instantiation
    Vector<Interface*> matches;
    foreach Pair<const String&, InterfaceManifestationList&> defEntry : matchScope.interfaces {
        const String& interfaceId = defEntry.getFirst();
        foreach Pair<const String&, Interface&> manEntry : defEntry.getSecond() {
            const String& mangledName = manEntry.getFirst();
            const Interface& presetInterface = manEntry.getSecond();
            // Skip generic and newly inserted substantiations to prevent double matching of an interface
            if presetInterface.structBase.isGenericSubstantiation() || presetInterface.isNewlyInserted {
                continue;
            }

            // Copy the interface to be able to substantiate types
            Interface candidate = presetInterface;

            // Check name requirement
            if !matchName(candidate, reqName) {
                break; // Leave the whole manifestation list, because all manifestations in this list have the same name
            }

            // Prepare mapping table from generic type name to concrete type
            candidate.typeMapping.clear();

            // Check template types requirement
            if !matchTemplateTypes(candidate, reqTemplateTypes, candidate.typeMapping, node) {
                continue; // Leave this manifestation and continue with the next one
            }

            // Map signatures from generic to concrete
            substantiateSignatures(candidate, candidate.typeMapping, node);

            // We found a match! -> Set the actual candidate and its entry to used
            candidate.used = true;
            candidate.entry.used = true;

            // Check if it needs to be substantiated
            if presetInterface.templateTypes.isEmpty() {
                assert matchScope.interfaces.contains(interfaceId);
                InterfaceManifestationList& interfaceManifestations = matchScope.interfaces.get(interfaceId);
                assert interfaceManifestations.contains(mangledName);
                Interface* ifaceMatch = &interfaceManifestations.get(mangledName);
                ifaceMatch.used = true;
                matches.pushBack(ifaceMatch);
                continue; // Match was successful -> match the next interface
            }

            // Check if we already have this manifestation and can simply re-use it
            const String candidateSignature = candidate.structBase.getSignature();
            InterfaceManifestationList& defManifestations = defEntry.getSecond();
            if defManifestations.contains(candidateSignature) {
                Interface& existingManifestation = defManifestations.get(candidateSignature);
                existingManifestation.used = true;
                matches.pushBack(&existingManifestation);
                break; // Leave the whole manifestation list to not double-match the manifestation
            }

            // Insert the substantiated version if required
            Interface* substantiatedInterface = insertSubstantiation(matchScope, candidate, presetInterface.declNode);
            InterfaceManifestationList& presetManifestations = matchScope.interfaces.get(interfaceId);
            Interface& presetManifestation = presetManifestations.get(mangledName);
            substantiatedInterface.genericPreset = &presetManifestation.structBase;
            ASTInterfaceDefNode* interfaceDefNode = downcast<ASTInterfaceDefNode>(substantiatedInterface.structBase.declNode);
            interfaceDefNode.interfaceManifestations.pushBack(substantiatedInterface);
            substantiatedInterface.isNewlyInserted = true; // To not iterate over it in the same matching

            // Copy interface entry
            const String newSignature = substantiatedInterface.structBase.getSignature();
            matchScope.lookupStrict(substantiatedInterface.name).used = true;
            substantiatedInterface.entry = matchScope.symbolTable.copySymbol(substantiatedInterface.name, newSignature);
            assert substantiatedInterface.entry != nil<SymbolTableEntry*>;

            // Copy interface scope
            const String oldScopeName = presetInterface.getScopeName();
            const String newScopeName = substantiatedInterface.getScopeName();
            matchScope.copyChildScope(oldScopeName, newScopeName);
            substantiatedInterface.scope = matchScope.getChildScope(newScopeName);
            assert substantiatedInterface.scope != nil<Scope*>;
            substantiatedInterface.scope.isGenericScope = false;

            // Attach the template types to the new interface entry
            const QualType& oldEntryType = substantiatedInterface.entry.getQualType();
            const QualTypeList concreteTemplateTypes = substantiatedInterface.structBase.getTemplateTypes();
            const QualType entryTypeWithTemplates = oldEntryType.getWithTemplateTypes(concreteTemplateTypes);
            const QualType entryType = entryTypeWithTemplates.getWithBodyScope(substantiatedInterface.scope);
            substantiatedInterface.entry.updateType(entryType, true);

            // Add to matched interfaces
            matches.pushBack(substantiatedInterface);
            // Leave the manifestation list: the remaining manifestations are substantiations, which are skipped anyway, and
            // iterating the hash table further after inserting into it could visit the generic preset a second time
            break;
        }
    }

    // If no matches were found, return a nil
    if matches.isEmpty() {
        return nil<Interface*>;
    }

    // Check if more than one interface matches the requirements
    if matches.getSize() > 1l {
        throwSemanticError(node, SemanticErrorType::INTERFACE_AMBIGUITY, String("Multiple interfaces match the requested signature"));
        // The compilation is aborted after this stage. Until then, deterministically pick the first candidate
    }
    Interface* matchedInterface = matches.front();
    matchedInterface.isNewlyInserted = false;

    // Insert into cache
    cache.lookupCache.upsert(cacheKey, matchedInterface);

    return matchedInterface;
}

/**
 * Checks if the matching candidate fulfills the name requirement
 */
f<bool> matchName(const Interface& candidate, const String& reqName) {
    return candidate.name == reqName;
}

/**
 * Checks if the matching candidate fulfills the template types requirement
 */
f<bool> matchTemplateTypes(Interface& candidate, const QualTypeList& reqTemplateTypes, TypeMapping& typeMapping, const ASTNode* node) {
    // Check if the number of types match
    if reqTemplateTypes.getSize() != candidate.templateTypes.getSize() {
        return false;
    }


    // Loop over all template types
    foreach unsigned long i, GenericType& candidateTemplateType : candidate.templateTypes {
        QualType& candidateType = candidateTemplateType.qualType;
        const QualType& reqType = reqTemplateTypes.get(i);

        // Check if the requested template type matches the candidate template type. The type mapping may be extended
        if !matchRequestedToCandidateType(candidateType, reqType, typeMapping, candidate.templateTypes, true, false) {
            return false;
        }

        // Substantiate the candidate param type, based on the type mapping
        if candidateType.hasAnyGenericParts() {
            substantiateTypeWithTypeMapping(candidateType, typeMapping, node);
        }
    }

    return true;
}

/**
 * Come up with the concrete signatures, by applying the type mapping onto the generic signatures
 */
p substantiateSignatures(Interface& candidate, const TypeMapping& typeMapping, const ASTNode* node) {
    // Loop over all signatures and substantiate the generic ones
    foreach Function* method : candidate.methods {
        // Skip methods, that are already fully substantiated
        if method.isFullySubstantiated() {
            continue;
        }

        // Substantiate return type
        if method.isNormalFunction() {
            substantiateReturnType(*method, typeMapping, node);
        }

        // Substantiate param types
        foreach Param& param : method.paramList {
            if param.qualType.isBase(SuperType::TY_GENERIC) {
                substantiateTypeWithTypeMapping(param.qualType, typeMapping, node);
            }
        }
    }
}


/**
 * Calculate the cache key for the interface lookup cache
 *
 * @param scope Scope to match against
 * @param name Interface name requirement
 * @param templateTypes Template types to substantiate generic types
 * @return Cache key
 */
f<Hash> getInterfaceCacheKey(const Scope* scope, const String& name, const QualTypeList& templateTypes) {
    Hash hash = 0ul;
    hashCombine64(hash, hashPointer(scope));
    hashCombine64(hash, hash(name));
    hashCombine64(hash, hashQualTypeList(templateTypes));
    return hash;
}

/**
 * Dump usage statistics for the lookup cache
 */
public f<String> dumpInterfaceLookupCacheStatistics() {
    LookupCache<Interface>* cache = getActiveInterfaceLookupCache();
    return cache.dumpLookupCacheStatistics("InterfaceManager");
}
