/**
 * The CacheManager is responsible for caching and restoring compiled source files and executables.
 * It stores compiled object files and metadata in a cache directory and restores them on subsequent
 * compilations when the source code and compile options have not changed.
 */
public type CacheManager struct {
    CliOptions& cliOptions
}

public p CacheManager.ctor(CliOptions& cliOptions) {
    this.cliOptions = cliOptions;
}

/**
 * Compute a cache key for the given source code and transitive dependency cache keys.
 * The key is derived by hashing the source code, various CLI option fields, and the
 * sorted list of dependency cache keys.
 *
 * @param sourceCode Source code of the file
 * @param depCacheKeys Transitive dependency cache keys
 * @return Cache key as a decimal string
 */
public f<String> CacheManager.computeCacheKey(const String& sourceCode, const Vector<String>& depCacheKeys) {
    StringStream components;
    // Hash the source text
    components << toString(cast<long>(hash(sourceCode)));
    // Fold in CLI option fields that affect codegen
    components << toString(this.cliOptions.buildMode);
    components << toString(this.cliOptions.optLevel);
    components << toString(this.cliOptions.instrumentation.sanitizer);
    components << toString(this.cliOptions.instrumentation.debugInfoLevel);
    components << toString(this.cliOptions.instrumentation.codeCoverage);
    components << this.cliOptions.targetTriple.value;
    components << toString(this.cliOptions.useLTO);
    components << toString(this.cliOptions.keepFramePointers);
    components << toString(this.cliOptions.useNativeFeatures);
    components << toString(this.cliOptions.outputContainer);
    // Fold in sorted dep keys so any change in a dependency invalidates this entry too
    Vector<String> sortedDepKeys = depCacheKeys;
    // Insertion sort for determinism
    for long i = 1l; i < sortedDepKeys.getSize(); i++ {
        const String key = sortedDepKeys.get(cast<unsigned long>(i));
        long insertPos = i;
        while insertPos > 0l && isStringLess(key, sortedDepKeys.get(cast<unsigned long>(insertPos - 1l))) {
            insertPos--;
        }
        if insertPos < i {
            sortedDepKeys.removeAt(cast<unsigned long>(i));
            sortedDepKeys.insertAt(cast<unsigned long>(insertPos), key);
        }
    }
    for unsigned long k = 0l; k < sortedDepKeys.getSize(); k++ {
        components << sortedDepKeys.get(k);
    }
    return toString(cast<long>(hash(components.str())));
}

/**
 * Derive the cache key of a module's object file from its source key and the generic manifestations
 * emitted into it. Importers decide which instantiations exist, so the source key alone cannot tell
 * such objects apart.
 *
 * @param sourceCacheKey Key from computeCacheKey()
 * @param manifestations Fingerprint from Scope::collectManifestationFingerprint()
 * @return Cache key of the object file
 */
public f<String> CacheManager.foldManifestations(const String& sourceCacheKey, const StringStream& manifestations) {
    const Hash seed = combineHashes(hash(sourceCacheKey), hash(manifestations.str()));
    return toString(cast<long>(seed));
}

/**
 * Look up the cached object file and metadata for the given source file. If a cache hit is found,
 * populates cachedObjectFilePaths, sourceLinkerFlags, and sourceAdditionalSourcePaths on the source
 * file and returns true. Returns false on any miss.
 *
 * @param sourceFile Source file to look up
 * @return true if a cache hit was found and restored, false otherwise
 */
public f<bool> CacheManager.lookupSourceFile(SourceFile* sourceFile) {
    const string objExt = getOutputFileExtension(this.cliOptions, OutputContainer::OBJECT_FILE);
    StringStream metaPathSS;
    metaPathSS << this.cliOptions.cacheDir.toString() << "/" << sourceFile.cacheKey << ".json";
    StringStream objPathSS;
    objPathSS << this.cliOptions.cacheDir.toString() << "/" << sourceFile.cacheKey << "." << objExt;
    const String metaPathStr = metaPathSS.str();
    const String objPathStr = objPathSS.str();

    // Check if both files exist
    if !fileExists(metaPathStr.getRaw()) || !fileExists(objPathStr.getRaw()) {
        return false;
    }

    // Read metadata file
    const Result<String> readResult = readFile(metaPathStr.getRaw());
    if !readResult.isOk() {
        return false;
    }
    const String metaContent = readResult.unwrap();
    const Result<JsonValue*> parseResult = parseJson(metaContent);
    if !parseResult.isOk() {
        return false;
    }
    JsonValue* metadata = parseResult.unwrap();

    // Verify all transitive dependency object files exist. They are not linked from here: the cache is only looked up after
    // the middle end, so every dependency (incl. the runtime modules, which are requested while building the symbol table) is
    // part of the compilation and registers its own object in concludeCompilation. A dependency can even end up with a
    // different key than the one recorded here, as its key covers the generic instantiations, that its importers request.
    // Linking the recorded object as well would then link the dependency twice. With LTO, only the main file is cached, so
    // this check keeps it from being restored.
    if metadata.hasField("dependencies") {
        JsonValue* deps = metadata.getField("dependencies");
        const unsigned long numDeps = deps.getArraySize();
        for unsigned long di = 0l; di < numDeps; di++ {
            JsonValue* depItem = deps.getArrayItem(di);
            const String depKey = depItem.getString();
            StringStream depObjSS;
            depObjSS << this.cliOptions.cacheDir.toString() << "/" << depKey << "." << objExt;
            const String depObjStr = depObjSS.str();
            if !fileExists(depObjStr.getRaw()) {
                deleteJsonValue(metadata);
                return false;
            }
        }
    }

    // Add this file's own object file
    sourceFile.cachedObjectFilePaths.pushBack(FilePath(objPathStr));

    // Restore linker flags
    if metadata.hasField("linkerFlags") {
        JsonValue* flags = metadata.getField("linkerFlags");
        const unsigned long numFlags = flags.getArraySize();
        for unsigned long fi = 0l; fi < numFlags; fi++ {
            JsonValue* flagItem = flags.getArrayItem(fi);
            sourceFile.sourceLinkerFlags.pushBack(flagItem.getString());
        }
    }

    // Restore additional source paths
    if metadata.hasField("additionalSourcePaths") {
        JsonValue* paths = metadata.getField("additionalSourcePaths");
        const unsigned long numPaths = paths.getArraySize();
        for unsigned long pi = 0l; pi < numPaths; pi++ {
            JsonValue* pathItem = paths.getArrayItem(pi);
            sourceFile.sourceAdditionalSourcePaths.pushBack(FilePath(pathItem.getString()));
        }
    }

    deleteJsonValue(metadata);
    return true;
}

/**
 * Cache the compiled object file and metadata for the given source file.
 *
 * @param sourceFile Source file to cache
 */
public p CacheManager.cacheSourceFile(const SourceFile* sourceFile) {
    // Don't cache if LTO is enabled and this isn't the main file (no object file produced)
    if this.cliOptions.useLTO && !sourceFile.isMainFile {
        return;
    }

    // Determine source object file path (mirrors runObjectEmitter's path logic)
    StringStream sourceObjSS;
    const String fileName = sourceFile.filePath.getFileName();
    sourceObjSS << this.cliOptions.outputDir.toString() << "/" << fileName;
    const String sourceObjBase = sourceObjSS.str();
    // Replace or append .o extension: strip existing extension if present, then add .o
    const long dotPos = fileName.rfind('.');
    StringStream cachedObjNameSS;
    if dotPos >= 0l {
        const String stem = fileName.getSubstring(0l, dotPos);
        cachedObjNameSS << this.cliOptions.outputDir.toString() << "/" << stem << ".o";
    } else {
        cachedObjNameSS << sourceObjBase << ".o";
    }
    const String sourceObjPath = cachedObjNameSS.str();

    // Verify source object file exists
    if !fileExists(sourceObjPath.getRaw()) {
        return;
    }

    // Determine cache paths
    const string objExt = getOutputFileExtension(this.cliOptions, OutputContainer::OBJECT_FILE);
    StringStream cacheObjSS;
    cacheObjSS << this.cliOptions.cacheDir.toString() << "/" << sourceFile.cacheKey << "." << objExt;
    StringStream cacheMetaSS;
    cacheMetaSS << this.cliOptions.cacheDir.toString() << "/" << sourceFile.cacheKey << ".json";
    const String cacheObjPath = cacheObjSS.str();
    const String cacheMetaPath = cacheMetaSS.str();

    // Ensure cache directory exists
    if mkDirs(this.cliOptions.cacheDir.toString(), 493) != 0 { // 0755 = 493
        return;
    }

    // Copy object file to cache
    if !copyFile(sourceObjPath, cacheObjPath) {
        return;
    }

    // Collect all transitive dependency cache keys, linker flags, and additional source paths. The dependency cache keys are
    // only used to verify that the objects of the dependencies are still cached (see lookupSourceFile)
    Vector<String> depCacheKeys;
    Vector<String> allLinkerFlags;
    Vector<String> allAdditionalSourcePaths;

    // Seed with this file's own linker flags and additional source paths
    for unsigned long i = 0l; i < sourceFile.sourceLinkerFlags.getSize(); i++ {
        allLinkerFlags.pushBack(sourceFile.sourceLinkerFlags.get(i));
    }
    for unsigned long i = 0l; i < sourceFile.sourceAdditionalSourcePaths.getSize(); i++ {
        const FilePath srcPath = sourceFile.sourceAdditionalSourcePaths.get(i);
        allAdditionalSourcePaths.pushBack(String(srcPath.toGenericString()));
    }

    // BFS over dependencies
    Vector<String> visited;
    Vector<const SourceFile*> worklist;
    foreach dyn depEntry : sourceFile.dependencies {
        worklist.pushBack(depEntry.getSecond());
    }
    while !worklist.isEmpty() {
        const SourceFile* dep = worklist.get(0l);
        worklist.removeAt(cast<unsigned long>(0l));
        // Check if already visited
        bool alreadyVisited = false;
        for unsigned long vi = 0l; vi < visited.getSize(); vi++ {
            if visited.get(vi) == dep.cacheKey {
                alreadyVisited = true;
                break;
            }
        }
        if alreadyVisited { continue; }
        visited.pushBack(dep.cacheKey);
        depCacheKeys.pushBack(dep.cacheKey);
        for unsigned long fi = 0l; fi < dep.sourceLinkerFlags.getSize(); fi++ {
            allLinkerFlags.pushBack(dep.sourceLinkerFlags.get(fi));
        }
        for unsigned long pi = 0l; pi < dep.sourceAdditionalSourcePaths.getSize(); pi++ {
            const FilePath depPath = dep.sourceAdditionalSourcePaths.get(pi);
            allAdditionalSourcePaths.pushBack(String(depPath.toGenericString()));
        }
        foreach dyn transEntry : dep.dependencies {
            worklist.pushBack(transEntry.getSecond());
        }
    }

    // Build metadata JSON
    JsonValue* metadata = __new<JsonValue>(JsonValueKind::JSON_OBJECT);

    // "additionalSourcePaths"
    JsonValue* addlSourcesArr = __new<JsonValue>(JsonValueKind::JSON_ARRAY);
    for unsigned long i = 0l; i < allAdditionalSourcePaths.getSize(); i++ {
        addlSourcesArr.addArrayItem(__new<JsonValue>(allAdditionalSourcePaths.get(i)));
    }
    setJsonField(metadata, String("additionalSourcePaths"), addlSourcesArr);

    // "cacheKey"
    setJsonField(metadata, String("cacheKey"), __new<JsonValue>(sourceFile.cacheKey));

    // "dependencies"
    JsonValue* depsArr = __new<JsonValue>(JsonValueKind::JSON_ARRAY);
    for unsigned long i = 0l; i < depCacheKeys.getSize(); i++ {
        depsArr.addArrayItem(__new<JsonValue>(depCacheKeys.get(i)));
    }
    setJsonField(metadata, String("dependencies"), depsArr);

    // "fileName"
    setJsonField(metadata, String("fileName"), __new<JsonValue>(String(sourceFile.fileName)));

    // "linkerFlags"
    JsonValue* flagsArr = __new<JsonValue>(JsonValueKind::JSON_ARRAY);
    for unsigned long i = 0l; i < allLinkerFlags.getSize(); i++ {
        flagsArr.addArrayItem(__new<JsonValue>(allLinkerFlags.get(i)));
    }
    setJsonField(metadata, String("linkerFlags"), flagsArr);

    // "sourceFile"
    setJsonField(metadata, String("sourceFile"), __new<JsonValue>(String(sourceFile.filePath.toGenericString())));

    // Serialize and write
    JsonSerializer serializer = JsonSerializer();
    const String metaJson = serializer.serialize(metadata);
    deleteJsonValue(metadata);
    // A failure to write the metadata file is not fatal. The cache entry will just not be found later on
    const Result<bool> _ = writeFile(cacheMetaPath.getRaw(), metaJson.getRaw());
}

/**
 * Hash the content of a file. Returns "missing:<path>" if the file cannot be opened.
 *
 * @param path Path to the file
 * @return Hash as decimal string
 */
f<String> CacheManager.hashLinkedFile(const String& path) {
    if !fileExists(path.getRaw()) {
        return "missing:" + path;
    }
    const Result<String> readResult = readFile(path.getRaw());
    if !readResult.isOk() {
        return "missing:" + path;
    }
    return toString(cast<long>(hash(readResult.unwrap())));
}

/**
 * Compute a cache key for the linked executable from the given inputs.
 *
 * @param objectFileCacheKeys Cache keys of all linked object files
 * @param linkerFlags Linker flags used in the link step
 * @param additionalSourcePaths Additional C/C++ source paths linked in
 * @return Executable cache key as decimal string
 */
f<String> CacheManager.computeExecutableCacheKey(const Vector<String>& objectFileCacheKeys, const Vector<String>& linkerFlags, const Vector<String>& additionalSourcePaths) {
    StringStream components;
    for unsigned long i = 0l; i < objectFileCacheKeys.getSize(); i++ {
        components << objectFileCacheKeys.get(i);
    }
    for unsigned long i = 0l; i < linkerFlags.getSize(); i++ {
        components << linkerFlags.get(i);
    }
    // Sort additional source paths for determinism
    Vector<String> sortedPaths = additionalSourcePaths;
    for long i = 1l; i < sortedPaths.getSize(); i++ {
        const String pathKey = sortedPaths.get(cast<unsigned long>(i));
        long insertPos = i;
        while insertPos > 0l && isStringLess(pathKey, sortedPaths.get(cast<unsigned long>(insertPos - 1l))) {
            insertPos--;
        }
        if insertPos < i {
            sortedPaths.removeAt(cast<unsigned long>(i));
            sortedPaths.insertAt(cast<unsigned long>(insertPos), pathKey);
        }
    }
    for unsigned long i = 0l; i < sortedPaths.getSize(); i++ {
        const String& sp = sortedPaths.get(i);
        components << sp << "\0";
        components << this.hashLinkedFile(sp);
    }
    components << toString(this.cliOptions.outputContainer);
    components << toString(this.cliOptions.staticLinking);
    return toString(cast<long>(hash(components.str())));
}

/**
 * Look up a cached executable for the given set of inputs.
 *
 * @param objectFileCacheKeys Cache keys of all object files
 * @param linkerFlags Linker flags
 * @param additionalSourcePaths Additional source paths
 * @param cachedExecutablePath Output: path to the cached executable if found
 * @return true if a cached executable was found
 */
f<bool> CacheManager.lookupExecutable(const Vector<String>& objectFileCacheKeys, const Vector<String>& linkerFlags, const Vector<String>& additionalSourcePaths, FilePath& cachedExecutablePath) {
    const String execCacheKey = this.computeExecutableCacheKey(objectFileCacheKeys, linkerFlags, additionalSourcePaths);
    // Determine extension
    StringStream execNameSS;
    execNameSS << this.cliOptions.cacheDir.toString() << "/" << execCacheKey;
    const string extension = getOutputFileExtension(this.cliOptions, this.cliOptions.outputContainer);
    if len(extension) > 0 {
        execNameSS << "." << extension;
    }
    const String execPath = execNameSS.str();
    if !fileExists(execPath.getRaw()) {
        return false;
    }
    cachedExecutablePath = FilePath(execPath);
    return true;
}

/**
 * Cache the linked executable.
 *
 * @param objectFileCacheKeys Cache keys of all object files
 * @param linkerFlags Linker flags
 * @param additionalSourcePaths Additional source paths
 * @param executablePath Path to the produced executable
 */
p CacheManager.cacheExecutable(const Vector<String>& objectFileCacheKeys, const Vector<String>& linkerFlags, const Vector<String>& additionalSourcePaths, const FilePath& executablePath) {
    const String execCacheKey = this.computeExecutableCacheKey(objectFileCacheKeys, linkerFlags, additionalSourcePaths);
    StringStream cachedExecSS;
    cachedExecSS << this.cliOptions.cacheDir.toString() << "/" << execCacheKey;
    const string extension = getOutputFileExtension(this.cliOptions, this.cliOptions.outputContainer);
    if len(extension) > 0 {
        cachedExecSS << "." << extension;
    }
    const String cachedExecPath = cachedExecSS.str();
    const String execPathStr = String(executablePath.toString());
    if !fileExists(execPathStr.getRaw()) {
        return;
    }
    if mkDirs(this.cliOptions.cacheDir.toString(), 493) != 0 {
        return;
    }
    const bool _ = copyFile(execPathStr, cachedExecPath); // Errors are ignored
}

/**
 * Link the executable or restore it from the cache.
 *
 * @param resourceManager Global resource manager
 */
public p CacheManager.linkOrRestoreExecutable(GlobalResourceManager& resourceManager) {
    // Collect object file cache keys and additional source paths across all source files
    Vector<String> objectFileCacheKeys;
    Vector<String> additionalSourcePaths;
    // Use the creation order, so that the executable cache key does not depend on the hash function of the source file map
    foreach SourceFile* sf : resourceManager.sourceFilesInCreationOrder {
        objectFileCacheKeys.pushBack(sf.cacheKey);
        for unsigned long i = 0l; i < sf.sourceAdditionalSourcePaths.getSize(); i++ {
            const FilePath sfPath = sf.sourceAdditionalSourcePaths.get(i);
            additionalSourcePaths.pushBack(String(sfPath.toGenericString()));
        }
    }

    // Check if we have a cached executable
    FilePath cachedExecutablePath;
    if !this.cliOptions.ignoreCache && this.lookupExecutable(objectFileCacheKeys, resourceManager.linker.linkerFlags, additionalSourcePaths, cachedExecutablePath) {
        // Restore cached executable: ensure output directory exists and copy the file
        const String outputPathStr = String(resourceManager.linker.outputPath.toString());
        // Create parent directory
        const long lastSlash = outputPathStr.rfind('/');
        if lastSlash >= 0l {
            const String parentDir = outputPathStr.getSubstring(0l, lastSlash);
            const int _ = mkDirs(parentDir.getRaw(), 493);
        }
        const bool _ = copyFile(String(cachedExecutablePath.toString()), outputPathStr); // Errors are ignored
    } else {
        // Link and optionally cache the result
        resourceManager.linker.run();
        if !this.cliOptions.ignoreCache {
            this.cacheExecutable(objectFileCacheKeys, resourceManager.linker.linkerFlags, additionalSourcePaths, resourceManager.linker.outputPath);
        }
    }
}

// ─── tests ────────────────────────────────────────────────────────────────────

const string TEST_SOURCE = "f<int> main() { return 0; }";

f<Vector<String>> makeKeys(const string key) {
    Vector<String> keys;
    keys.pushBack(String(key));
    return keys;
}

f<Vector<String>> makeKeys(const string key1, const string key2) {
    Vector<String> keys = makeKeys(key1);
    keys.pushBack(String(key2));
    return keys;
}

f<Vector<String>> makeKeys(const string key1, const string key2, const string key3) {
    Vector<String> keys = makeKeys(key1, key2);
    keys.pushBack(String(key3));
    return keys;
}

// Compute the cache key of the test source with a cache manager for the given cli options
f<String> computeTestCacheKey(CliOptions& cliOptions) {
    CacheManager manager = CacheManager(cliOptions);
    return manager.computeCacheKey(String(TEST_SOURCE), Vector<String>());
}

f<String> foldTestManifestations(CacheManager& manager, const String& sourceKey, const string manifestations) {
    const StringStream fingerprint = StringStream(manifestations);
    return manager.foldManifestations(sourceKey, fingerprint);
}

#[test]
f<bool> testComputeCacheKey() {
    CliOptions cliOptions;
    CacheManager manager = CacheManager(cliOptions);
    const Vector<String> noDeps;

    // Deterministic
    assert manager.computeCacheKey(String(TEST_SOURCE), noDeps) == manager.computeCacheKey(String(TEST_SOURCE), noDeps);
    // Different for different content
    assert manager.computeCacheKey(String(TEST_SOURCE), noDeps) != manager.computeCacheKey(String("f<int> main() { return 1; }"), noDeps);

    // Different for the dep cache keys
    const String keyNoDeps = manager.computeCacheKey(String(TEST_SOURCE), noDeps);
    const String keyWithDep = manager.computeCacheKey(String(TEST_SOURCE), makeKeys("dep-v1"));
    const String keyWithDepChanged = manager.computeCacheKey(String(TEST_SOURCE), makeKeys("dep-v2"));
    assert keyNoDeps != keyWithDep;
    assert keyWithDep != keyWithDepChanged;

    // Dep cache keys must be sorted internally, so call sites do not need to provide a particular order. This matters because
    // dep traversal order is not stable across builds
    assert manager.computeCacheKey(String(TEST_SOURCE), makeKeys("a", "b", "c")) == manager.computeCacheKey(String(TEST_SOURCE), makeKeys("c", "a", "b"));
    return true;
}

#[test]
f<bool> testComputeCacheKeyDiffersForCliOptions() {
    CliOptions cliOptions;

    // Build mode
    cliOptions.buildMode = BuildMode::DEBUG;
    const String keyDebug = computeTestCacheKey(cliOptions);
    cliOptions.buildMode = BuildMode::RELEASE;
    assert keyDebug != computeTestCacheKey(cliOptions);

    // Opt level
    cliOptions.optLevel = OptLevel::O0;
    const String keyO0 = computeTestCacheKey(cliOptions);
    cliOptions.optLevel = OptLevel::O3;
    assert keyO0 != computeTestCacheKey(cliOptions);

    // Sanitizer
    cliOptions.instrumentation.sanitizer = Sanitizer::NONE;
    const String keyNone = computeTestCacheKey(cliOptions);
    cliOptions.instrumentation.sanitizer = Sanitizer::ADDRESS;
    assert keyNone != computeTestCacheKey(cliOptions);

    // Debug info
    cliOptions.instrumentation.debugInfoLevel = DebugInfoLevel::NONE;
    const String keyNoDebug = computeTestCacheKey(cliOptions);
    cliOptions.instrumentation.debugInfoLevel = DebugInfoLevel::LINE_ONLY;
    const String keyLineOnly = computeTestCacheKey(cliOptions);
    cliOptions.instrumentation.debugInfoLevel = DebugInfoLevel::FULL;
    const String keyFullDebug = computeTestCacheKey(cliOptions);
    assert keyNoDebug != keyLineOnly;
    assert keyNoDebug != keyFullDebug;
    assert keyLineOnly != keyFullDebug;

    // LTO
    cliOptions.useLTO = false;
    const String keyNoLto = computeTestCacheKey(cliOptions);
    cliOptions.useLTO = true;
    assert keyNoLto != computeTestCacheKey(cliOptions);

    // Frame pointers
    cliOptions.keepFramePointers = false;
    const String keyNoFramePointers = computeTestCacheKey(cliOptions);
    cliOptions.keepFramePointers = true;
    assert keyNoFramePointers != computeTestCacheKey(cliOptions);

    // Native features
    cliOptions.useNativeFeatures = false;
    const String keyGeneric = computeTestCacheKey(cliOptions);
    cliOptions.useNativeFeatures = true;
    assert keyGeneric != computeTestCacheKey(cliOptions);
    return true;
}

#[test]
f<bool> testFoldManifestations() {
    CliOptions cliOptions;
    CacheManager manager = CacheManager(cliOptions);
    const String sourceKey = manager.computeCacheKey(String(TEST_SOURCE), Vector<String>());

    // Deterministic
    assert foldTestManifestations(manager, sourceKey, "Fidentity<int>\n") == foldTestManifestations(manager, sourceKey, "Fidentity<int>\n");

    // Different for different manifestations
    const String none = foldTestManifestations(manager, sourceKey, "");
    const String one = foldTestManifestations(manager, sourceKey, "Fidentity<int>\n");
    const String other = foldTestManifestations(manager, sourceKey, "Fidentity<long>\n");
    const String unused = foldTestManifestations(manager, sourceKey, "fidentity<int>\n"); // Lowercase tag: exists, but is unused
    assert none != one;
    assert one != other;
    assert one != unused;

    // Different for different source keys
    const String otherSourceKey = manager.computeCacheKey(String("f<int> main() { return 1; }"), Vector<String>());
    assert foldTestManifestations(manager, sourceKey, "Fidentity<int>\n") != foldTestManifestations(manager, otherSourceKey, "Fidentity<int>\n");
    return true;
}

#[test]
f<bool> testDependencyChangeInvalidatesDependentCacheKey() {
    // Provokes the bug that was fixed: before transitive dep cache keys were folded into a file's own cache key, a dependent
    // whose source text was unchanged would keep cache-hitting against a stale object file even when one of its dependencies
    // had been edited - causing the linker to consume out-of-date code
    CliOptions cliOptions;
    CacheManager manager = CacheManager(cliOptions);
    const String mathSrc = String("f<int> add(int a, int b) { return a + b; }");
    const String utilsSrc = String("import \"math\"; f<int> helper(int x) { return add(x, 1); }");
    const String mathKeyV1 = manager.computeCacheKey(mathSrc, Vector<String>());
    const String utilsKeyV1 = manager.computeCacheKey(utilsSrc, makeKeys(mathKeyV1.getRaw()));

    // The dependent's own source text didn't change - only the dependency did
    const String mathKeyV2 = manager.computeCacheKey(String("f<int> add(int a, int b) { return a + b + 0; }"), Vector<String>());
    assert mathKeyV1 != mathKeyV2;

    // The fold makes the dependent's cache key a function of the dependency's cache key, so utils now misses too
    const String utilsKeyV2 = manager.computeCacheKey(utilsSrc, makeKeys(mathKeyV2.getRaw()));
    assert utilsKeyV1 != utilsKeyV2;

    // Without any dep change the dependent's cache key stays stable, so we don't pay unnecessary rebuilds
    assert utilsKeyV1 == manager.computeCacheKey(utilsSrc, makeKeys(mathKeyV1.getRaw()));
    return true;
}

#[test]
f<bool> testCacheExecutable() {
    CliOptions cliOptions;
    const FilePath cacheDir = makeUniqueTestDir("spice-cache-test");
    const FilePath outputDir = makeUniqueTestDir("spice-cache-test");
    cliOptions.cacheDir = cacheDir;
    cliOptions.outputDir = outputDir;
    CacheManager manager = CacheManager(cliOptions);
    const Vector<String> objectKeys = makeKeys("obj-1", "obj-2");
    const Vector<String> linkerFlags = makeKeys("-lm", "-lpthread");
    const Vector<String> noAdditionalSources;

    // Miss on an empty cache
    FilePath resolved;
    assert !manager.lookupExecutable(makeKeys("key-a", "key-b"), makeKeys("-lm"), noAdditionalSources, resolved);
    assert resolved.isEmpty();

    // Caching a non-existing executable is a no-op
    const FilePath missingExecutable = outputDir / "does-not-exist";
    manager.cacheExecutable(objectKeys, linkerFlags, noAdditionalSources, missingExecutable);
    assert !manager.lookupExecutable(objectKeys, linkerFlags, noAdditionalSources, resolved);

    // Round trip
    const FilePath executablePath = outputDir / "my-program";
    writeTestFile(executablePath, "executable-bytes");
    manager.cacheExecutable(objectKeys, linkerFlags, noAdditionalSources, executablePath);
    assert manager.lookupExecutable(objectKeys, linkerFlags, noAdditionalSources, resolved);
    assert resolved.exists();
    const FilePath resolvedParent = FilePath(resolved.getParentDir());
    assert resolvedParent.equivalent(cacheDir);

    // Misses when the object keys or the linker flags differ
    assert !manager.lookupExecutable(makeKeys("obj-1", "obj-3"), linkerFlags, noAdditionalSources, resolved);
    assert !manager.lookupExecutable(objectKeys, makeKeys("-lpthread"), noAdditionalSources, resolved);

    // Misses when static linking or the output container differ
    cliOptions.staticLinking = true;
    assert !manager.lookupExecutable(objectKeys, linkerFlags, noAdditionalSources, resolved);
    cliOptions.staticLinking = false;
    cliOptions.outputContainer = OutputContainer::SHARED_LIBRARY;
    assert !manager.lookupExecutable(objectKeys, linkerFlags, noAdditionalSources, resolved);
    cliOptions.outputContainer = OutputContainer::EXECUTABLE;
    assert manager.lookupExecutable(objectKeys, linkerFlags, noAdditionalSources, resolved);

    removeTestDir(cacheDir);
    removeTestDir(outputDir);
    return true;
}

#[test]
f<bool> testLookupExecutableMissesWhenAdditionalSourceContentChanges() {
    CliOptions cliOptions;
    const FilePath cacheDir = makeUniqueTestDir("spice-cache-test");
    const FilePath outputDir = makeUniqueTestDir("spice-cache-test");
    cliOptions.cacheDir = cacheDir;
    cliOptions.outputDir = outputDir;
    CacheManager manager = CacheManager(cliOptions);

    // C/C++ files referenced via @core.linker.additionalSource must contribute to the executable cache key, otherwise editing
    // them would silently keep serving the previously linked binary
    const FilePath additionalSource = outputDir / "extra.c";
    writeTestFile(additionalSource, "int compute() { return 1; }\n");
    const FilePath executablePath = outputDir / "program";
    writeTestFile(executablePath, "executable-bytes");
    const Vector<String> objectKeys = makeKeys("obj-1");
    const Vector<String> linkerFlags = makeKeys("-lm");
    const Vector<String> additionalSources = makeKeys(additionalSource.toGenericString());

    manager.cacheExecutable(objectKeys, linkerFlags, additionalSources, executablePath);
    FilePath resolved;
    assert manager.lookupExecutable(objectKeys, linkerFlags, additionalSources, resolved);

    // Editing the additional source must invalidate the cached executable
    writeTestFile(additionalSource, "int compute() { return 2; }\n");
    assert !manager.lookupExecutable(objectKeys, linkerFlags, additionalSources, resolved);

    removeTestDir(cacheDir);
    removeTestDir(outputDir);
    return true;
}

// Make the given cli options target the native target, so that source files can look up an LLVM target
p setupNativeTarget(CliOptions& cliOptions) {
    cliOptions.targetTriple = llvm::normalizeTargetTriple(llvm::getDefaultTargetTriple());
    cliOptions.isNativeTarget = true;
}

// Look up the given source file in the cache. Reset the lookup output fields beforehand, since they accumulate on each call
f<bool> lookupTestSourceFile(CacheManager& manager, SourceFile* sourceFile) {
    sourceFile.cachedObjectFilePaths.clear();
    sourceFile.sourceLinkerFlags.clear();
    sourceFile.sourceAdditionalSourcePaths.clear();
    return manager.lookupSourceFile(sourceFile);
}

// Walks through a 3-file dependency chain (main -> utils -> math) using the real cache-key folding behavior, caches every file,
// then mutates math's source and verifies that the change cascades into utils and main: their cache keys move with the dep, so
// all three miss and must be recompiled
#[test]
f<bool> testMultiFileDependencyChangeForcesRecompilation() {
    CliOptions cliOptions;
    const FilePath cacheDir = makeUniqueTestDir("spice-cache-test");
    const FilePath outputDir = makeUniqueTestDir("spice-cache-test");
    cliOptions.cacheDir = cacheDir;
    cliOptions.outputDir = outputDir;
    setupNativeTarget(cliOptions);

    // Place stub source files on disk (their contents are irrelevant: cache keys are derived from the in-memory sources below
    // and assigned to SourceFile.cacheKey directly)
    const FilePath mathPath = outputDir / "math.spice";
    const FilePath utilsPath = outputDir / "utils.spice";
    const FilePath mainPath = outputDir / "main.spice";
    writeTestFile(mathPath, "");
    writeTestFile(utilsPath, "");
    writeTestFile(mainPath, "");

    {
        // The GlobalResourceManager owns a CacheManager wired to the cli options
        GlobalResourceManager resourceManager = GlobalResourceManager(cliOptions);
        CacheManager& manager = resourceManager.cacheManager;

        SourceFile* math = resourceManager.createSourceFile(nil<SourceFile*>, String("math"), mathPath, false);
        SourceFile* utils = resourceManager.createSourceFile(nil<SourceFile*>, String("utils"), utilsPath, false);
        SourceFile* mainFile = resourceManager.createSourceFile(nil<SourceFile*>, String("main"), mainPath, false);
        math.isMainFile = false;
        utils.isMainFile = false;
        mainFile.isMainFile = true;

        // Wire up the dependency chain: main -> utils -> math
        utils.addDependency(math, String("math"));
        mainFile.addDependency(utils, String("utils"));

        // Assign cache keys as the import collector would: each file's key folds in its transitive dep cache keys, so changes
        // to any dep propagate up the chain
        const String mathSrcV1 = String("f<int> add(int a, int b) { return a + b; }");
        const String utilsSrc = String("import \"math\"; f<int> helper(int x) { return add(x, 1); }");
        const String mainSrc = String("import \"utils\"; f<int> main() { return helper(41); }");
        math.cacheKey = manager.computeCacheKey(mathSrcV1, Vector<String>());
        utils.cacheKey = manager.computeCacheKey(utilsSrc, makeKeys(math.cacheKey.getRaw()));
        mainFile.cacheKey = manager.computeCacheKey(mainSrc, makeKeys(utils.cacheKey.getRaw(), math.cacheKey.getRaw()));

        // Pretend the back end emitted object files into the output dir (cacheSourceFile picks them up there)
        writeTestFile(outputDir / "math.o", "math-v1-obj");
        writeTestFile(outputDir / "utils.o", "utils-obj");
        writeTestFile(outputDir / "main.o", "main-obj");
        manager.cacheSourceFile(math);
        manager.cacheSourceFile(utils);
        manager.cacheSourceFile(mainFile);

        // Phase 1: nothing changed since caching - every file hits and only restores its own object. The objects of the deps
        // are registered by the deps themselves, since every dep is part of the compilation
        assert lookupTestSourceFile(manager, math);
        assert math.cachedObjectFilePaths.getSize() == 1l; // math.o
        assert lookupTestSourceFile(manager, utils);
        assert utils.cachedObjectFilePaths.getSize() == 1l; // utils.o
        assert lookupTestSourceFile(manager, mainFile);
        assert mainFile.cachedObjectFilePaths.getSize() == 1l; // main.o

        // Phase 2: math's source changes -> its cache key changes -> utils and main keys also change (because the fold pulls
        // in the new math key transitively). All three miss and recompile
        const String oldMathKey = math.cacheKey;
        const String oldUtilsKey = utils.cacheKey;
        const String oldMainKey = mainFile.cacheKey;
        const String mathSrcV2 = String("f<int> add(int a, int b) { return a + b + 0; }");
        math.cacheKey = manager.computeCacheKey(mathSrcV2, Vector<String>());
        utils.cacheKey = manager.computeCacheKey(utilsSrc, makeKeys(math.cacheKey.getRaw()));
        mainFile.cacheKey = manager.computeCacheKey(mainSrc, makeKeys(utils.cacheKey.getRaw(), math.cacheKey.getRaw()));
        assert oldMathKey != math.cacheKey;
        assert oldUtilsKey != utils.cacheKey;
        assert oldMainKey != mainFile.cacheKey;
        assert !lookupTestSourceFile(manager, math);
        assert !lookupTestSourceFile(manager, utils);
        assert !lookupTestSourceFile(manager, mainFile);
    }

    removeTestDir(cacheDir);
    removeTestDir(outputDir);
    return true;
}

// Outcome of compiling a program in a fresh GlobalResourceManager
type CompileOutcome struct {
    bool mainRestored
    bool depRestored
    bool depExposesSymbol
    String depCacheKey
}

// Compile the given program in a fresh GlobalResourceManager, which stands in for a new compiler process. The back end emits
// the object files, but nothing is linked
f<CompileOutcome> compileTestProgram(CliOptions& cliOptions, const FilePath& programPath, const string depName, const string depSymbol) {
    GlobalResourceManager resourceManager = GlobalResourceManager(cliOptions);
    SourceFile* mainFile = resourceManager.createSourceFile(nil<SourceFile*>, String(MAIN_FILE_NAME), programPath, false);
    mainFile.runFrontEnd();
    assert !resourceManager.abortCompilation;

    // Symbols of a file that ends up cache-restored must be exposed regardless
    SourceFile* depFile = mainFile.dependencies.get(String(depName));
    const bool depExposesSymbol = depFile.getNameRegistryEntry(String(depSymbol)) != nil<const NameRegistryEntry*>;

    mainFile.runMiddleEnd();
    assert !resourceManager.abortCompilation;
    assert resourceManager.errorManager.softErrors.isEmpty();

    // Restorability depends on the generic manifestations, so it is decided in the back end
    mainFile.runBackEnd();
    assert !resourceManager.abortCompilation;
    return CompileOutcome{mainFile.restoredFromCache, depFile.restoredFromCache, depExposesSymbol, depFile.cacheKey};
}

// Compile a two-file program once to populate the cache, then edit only the dependent file's source and recompile in a fresh
// GlobalResourceManager. The unchanged dependency must hit the cache for its object file, but its exported symbols still have
// to be resolvable by the dependent, since the dependent itself isn't a cache hit and needs to type-check against them
#[test]
f<bool> testCacheHitDependencyStillExposesSymbolsToChangedDependent() {
    CliOptions cliOptions;
    const FilePath cacheDir = makeUniqueTestDir("spice-cache-test");
    const FilePath outputDir = makeUniqueTestDir("spice-cache-test");
    cliOptions.cacheDir = cacheDir;
    cliOptions.outputDir = outputDir;
    setupNativeTarget(cliOptions);

    // The dependency stays untouched across both compiler runs
    const FilePath mainPath = outputDir / "main.spice";
    writeTestFile(outputDir / "math.spice", "public f<int> add(int a, int b) {\n    return a + b;\n}\n");
    writeTestFile(mainPath, "import \"math\";\n\nf<int> main() {\n    return add(1, 2);\n}\n");

    // First run: compiles both files from scratch and populates the cache
    const CompileOutcome first = compileTestProgram(cliOptions, mainPath, "math", "add");
    assert first.depExposesSymbol;
    assert !first.depRestored;

    // Edit only main.spice. math.spice is unchanged, so it must still cache-hit on the next run
    writeTestFile(mainPath, "import \"math\";\n\nf<int> main() {\n    return add(1, 2) + 1;\n}\n");
    const CompileOutcome second = compileTestProgram(cliOptions, mainPath, "math", "add");
    assert second.depExposesSymbol;
    assert second.depRestored;
    assert !second.mainRestored;

    removeTestDir(cacheDir);
    removeTestDir(outputDir);
    return true;
}

// Issue #1393: an object cached for a program that did not need a generic instantiation must not be reused for one that does
#[test]
f<bool> testCachedModuleObjectIsNotReusedForImporterNeedingOtherInstantiations() {
    CliOptions cliOptions;
    const FilePath cacheDir = makeUniqueTestDir("spice-cache-test");
    const FilePath outputDir = makeUniqueTestDir("spice-cache-test");
    cliOptions.cacheDir = cacheDir;
    cliOptions.outputDir = outputDir;
    setupNativeTarget(cliOptions);

    // A generic module and two programs importing it, of which only the second instantiates it
    const FilePath programA = outputDir / "a.spice";
    const FilePath programB = outputDir / "b.spice";
    writeTestFile(outputDir / "lib.spice", "type T dyn;\n\npublic f<T> identity<T>(T value) {\n    return value;\n}\n");
    writeTestFile(programA, "import \"lib\";\n\nf<int> main() {\n    return 0;\n}\n");
    writeTestFile(programB, "import \"lib\";\n\nf<int> main() {\n    return identity(0);\n}\n");

    // A needs no instantiation of 'identity'
    const CompileOutcome firstA = compileTestProgram(cliOptions, programA, "lib", "identity");
    assert !firstA.depRestored;

    // B needs 'identity<int>', which the object cached for A lacks
    const CompileOutcome firstB = compileTestProgram(cliOptions, programB, "lib", "identity");
    assert !firstB.depRestored;
    assert firstA.depCacheKey != firstB.depCacheKey;

    // Both objects coexist in the cache, so neither program invalidates the other
    const CompileOutcome secondA = compileTestProgram(cliOptions, programA, "lib", "identity");
    assert secondA.depRestored;
    assert firstA.depCacheKey == secondA.depCacheKey;
    const CompileOutcome secondB = compileTestProgram(cliOptions, programB, "lib", "identity");
    assert secondB.depRestored;
    assert firstB.depCacheKey == secondB.depCacheKey;

    removeTestDir(cacheDir);
    removeTestDir(outputDir);
    return true;
}

// A cache-restored file must not link the objects of its dependencies, that are recorded in its cache entry. A dependency's
// key covers the generic instantiations, that its importers request, so it can differ from the recorded one in another
// program. The dependency then registers its current object, and linking the recorded one as well defines its symbols twice.
#[test]
f<bool> testCacheRestoredDependantDoesNotLinkStaleDependencyObject() {
    CliOptions cliOptions;
    const FilePath cacheDir = makeUniqueTestDir("spice-cache-test");
    const FilePath outputDir = makeUniqueTestDir("spice-cache-test");
    cliOptions.cacheDir = cacheDir;
    cliOptions.outputDir = outputDir;
    setupNativeTarget(cliOptions);

    // A generic module, a module using it without instantiating anything, and two programs importing both, of which only the
    // second instantiates the generic function
    writeTestFile(outputDir / "lib.spice", "type T dyn;\n\npublic f<T> identity<T>(T value) {\n    return value;\n}\n\npublic f<int> answer() {\n    return 42;\n}\n");
    writeTestFile(outputDir / "util.spice", "import \"lib\";\n\npublic f<int> helper() {\n    return answer();\n}\n");
    writeTestFile(outputDir / "a.spice", "import \"lib\";\nimport \"util\";\n\nf<int> main() {\n    return helper();\n}\n");
    writeTestFile(outputDir / "b.spice", "import \"lib\";\nimport \"util\";\n\nf<int> main() {\n    return identity(helper());\n}\n");

    // A populates the cache. Its entry for util records the key of lib without any instantiation
    const CompileOutcome outcomeOfA = compileTestProgram(cliOptions, outputDir / "a.spice", "lib", "identity");

    // B needs 'identity<int>', so lib gets another key and is compiled again, while util is restored from the cache
    bool libRestored;
    String libKeyOfB;
    bool utilRestored;
    bool staleLibObjectLinked = false;
    unsigned long linkedFileCount;
    unsigned long sourceFileCount;
    {
        GlobalResourceManager resourceManager = GlobalResourceManager(cliOptions);
        SourceFile* mainFile = resourceManager.createSourceFile(nil<SourceFile*>, String(MAIN_FILE_NAME), outputDir / "b.spice", false);
        mainFile.runFrontEnd();
        mainFile.runMiddleEnd();
        assert resourceManager.errorManager.softErrors.isEmpty();
        mainFile.runBackEnd();
        assert !resourceManager.abortCompilation;
        const SourceFile* libFile = mainFile.dependencies.get(String("lib"));
        const SourceFile* utilFile = mainFile.dependencies.get(String("util"));
        libRestored = libFile.restoredFromCache;
        libKeyOfB = libFile.cacheKey;
        utilRestored = utilFile.restoredFromCache;

        // Build the path of the object of lib, that A cached, like lookupSourceFile does
        StringStream staleLibObjectPath;
        staleLibObjectPath << cacheDir.toString() << "/" << outcomeOfA.depCacheKey << "." << getOutputFileExtension(cliOptions, OutputContainer::OBJECT_FILE);
        const FilePath staleLibObject = FilePath(staleLibObjectPath.str());
        foreach const FilePath& linkedFile : resourceManager.linker.linkedFiles {
            if linkedFile == staleLibObject {
                staleLibObjectLinked = true;
            }
        }
        linkedFileCount = resourceManager.linker.linkedFiles.getSize();
        sourceFileCount = resourceManager.sourceFiles.getSize();
    }

    removeTestDir(cacheDir);
    removeTestDir(outputDir);
    assert !libRestored;
    assert libKeyOfB != outcomeOfA.depCacheKey;
    assert utilRestored;
    // The object of lib, that A cached, is not linked. Every source file contributes exactly its own object
    assert !staleLibObjectLinked;
    assert linkedFileCount == sourceFileCount;
    return true;
}
