// Std imports
import "std/data/unordered-map";
import "std/data/vector";

// Own imports
import "@/source-file";
import "@/util/system-util";
import "@/global/global-resource-manager";
import "@/symboltablebuilder/qual-type";

// Constants
const string STRING_RT_IMPORT_NAME = "__rt_string";
const string RESULT_RT_IMPORT_NAME = "__rt_result";
const string ERROR_RT_IMPORT_NAME = "__rt_error";
const string ERROR_TRACE_RT_IMPORT_NAME = "__rt_error_trace";
const string MEMORY_RT_IMPORT_NAME = "__rt_memory";
const string RTTI_RT_IMPORT_NAME = "__rt_rtti";
const string STACK_TRACE_RT_IMPORT_NAME = "__rt_stack_trace";
const string LIBC_RT_IMPORT_NAME = "__rt_libc";

public type RuntimeModule enum {
    STRING_RT = 1,
    RESULT_RT = 2,
    ERROR_RT = 4,
    ERROR_TRACE_RT = 8,
    MEMORY_RT = 16,
    RTTI_RT = 32,
    STACK_TRACE_RT = 64,
    LIBC_RT = 128 // Freestanding mode only: the C functions, that the other runtime modules and the LLVM back end call
}

/**
 * Get the runtime module, that is required when using the type with the given name
 *
 * @param typeName Type name
 * @param runtimeModule Receives the runtime module, if found
 * @return True if the type requires a runtime module
 */
public f<bool> getRuntimeModuleForTypeName(const String& typeName, RuntimeModule& runtimeModule) {
    if typeName == STROBJ_NAME {
        runtimeModule = RuntimeModule::STRING_RT;
    } else if typeName == RESULTOBJ_NAME {
        runtimeModule = RuntimeModule::RESULT_RT;
    } else if typeName == ERROBJ_NAME {
        runtimeModule = RuntimeModule::ERROR_RT;
    } else {
        return false;
    }
    return true;
}

/**
 * Get the runtime module, that is required when calling the function with the given name
 *
 * @param functionName Function name
 * @param runtimeModule Receives the runtime module, if found
 * @return True if the function requires a runtime module
 */
public f<bool> getRuntimeModuleForFunctionName(const String& functionName, RuntimeModule& runtimeModule) {
    // Memory RT
    if functionName == "sAlloc" || functionName == "sAllocUnsafe" || functionName == "sRealloc" || functionName == "sReallocUnsafe"
        || functionName == "sCopy" || functionName == "sCopyUnsafe" || functionName == "sMove" || functionName == "sDestruct"
        || functionName == "sDealloc" || functionName == "sDelete" || functionName == "sCompare" {
        runtimeModule = RuntimeModule::MEMORY_RT;
    } else if functionName == "ok" || functionName == "err" { // Result RT
        runtimeModule = RuntimeModule::RESULT_RT;
    } else if functionName == "sErrTraceReset" || functionName == "sErrTracePush" || functionName == "sErrTraceDump" { // Error Trace RT
        runtimeModule = RuntimeModule::ERROR_TRACE_RT;
    } else if functionName == "sDumpStacktrace" || functionName == "sGetStacktrace" { // Stack Trace RT
        runtimeModule = RuntimeModule::STACK_TRACE_RT;
    } else {
        return false;
    }
    return true;
}

type ModuleNamePair struct {
    string importName
    string fileName
}

public type RuntimeModuleManager struct {
    GlobalResourceManager &resourceManager
    UnorderedMap<RuntimeModule, SourceFile *> modules // Runtime modules, that were requested
    // Source files, that are runtime modules by their path. Unlike modules, this also contains the explicitly imported and
    // the still loading runtime modules, so that they know that they are the runtime module themselves
    UnorderedMap<RuntimeModule, SourceFile *> moduleFiles
}

public p RuntimeModuleManager.ctor(GlobalResourceManager &resourceManager) {
    this.resourceManager = resourceManager;
}

public f<SourceFile *> RuntimeModuleManager.requestModule(SourceFile* parentSourceFile, RuntimeModule requestedModule) {
    const String importName = String(this.resolveNamePair(requestedModule).importName);

    // Check if the requested module is available already, if not load it
    dyn rtFile = this.isModuleAvailable(requestedModule) ? this.getModule(requestedModule) : this.loadModule(parentSourceFile, requestedModule);

    // Add the dependency to the parent source file
    parentSourceFile.addDependency(rtFile, importName);
    assert parentSourceFile.dependencies.contains(importName);
    SourceFile* runtimeFile = parentSourceFile.dependencies.get(importName);
    this.modules.upsert(requestedModule, runtimeFile);

    // Merge the module name registry with the one of the source file
    parentSourceFile.mergeNameRegistries(*rtFile, importName);

    // Tell the source file, that the requested runtime has been imported
    parentSourceFile.importedRuntimeModules |= requestedModule;

    return runtimeFile;
}

public f<SourceFile *> RuntimeModuleManager.getModule(RuntimeModule requestedModule) {
    assert this.modules.contains(requestedModule);
    return this.modules.get(requestedModule);
}

public f<bool> RuntimeModuleManager.isModuleAvailable(RuntimeModule requestedModule) {
    return this.modules.contains(requestedModule);
}

/**
 * Check if the given source file is the given runtime module, identified by its path. This does not depend on the
 * names, that the source file defines
 *
 * @param sourceFile Source file
 * @param runtimeModule Runtime module
 * @return Is the runtime module or not
 */
public f<bool> RuntimeModuleManager.isRuntimeModule(const SourceFile* sourceFile, RuntimeModule runtimeModule) {
    return this.moduleFiles.contains(runtimeModule) && this.moduleFiles.get(runtimeModule) == sourceFile;
}

/**
 * Register the given source file as runtime module, if it is the variant of a runtime module, that loadModule resolves
 * for the current target. This also covers runtime files, that are imported explicitly instead of being requested, so
 * that they know that they are the runtime module themselves
 *
 * @param sourceFile Newly created std source file
 */
public p RuntimeModuleManager.registerIfRuntimeModule(SourceFile* sourceFile) {
    // Only the files directly in the runtime dir can be runtime modules
    const FilePath runtimeDir = getStdDir() / "runtime";
    FilePath parentDir = FilePath(sourceFile.filePath.getParentDir());
    if !parentDir.equivalent(runtimeDir) {
        return;
    }

    const RuntimeModule[8] runtimeModules = [
        RuntimeModule::STRING_RT, RuntimeModule::RESULT_RT, RuntimeModule::ERROR_RT, RuntimeModule::ERROR_TRACE_RT,
        RuntimeModule::MEMORY_RT, RuntimeModule::RTTI_RT, RuntimeModule::STACK_TRACE_RT, RuntimeModule::LIBC_RT
    ];
    for unsigned int i = 0u; i < len(runtimeModules); i++ {
        const RuntimeModule runtimeModule = runtimeModules[i];
        const ModuleNamePair namePair = this.resolveNamePair(runtimeModule);
        const FilePath basePath = runtimeDir / String(namePair.fileName);
        Vector<FilePath> candidatePaths;
        const FilePath modulePath = resolvePlatformSpecificSourceFile(this.resourceManager.cliOptions, basePath, FilePath(), candidatePaths);
        if !modulePath.isEmpty() && modulePath.equivalent(sourceFile.filePath) {
            this.moduleFiles.upsert(runtimeModule, sourceFile);
            return;
        }
    }
}

public f<SourceFile *> RuntimeModuleManager.loadModule(SourceFile* parentSourceFile, RuntimeModule requestedModule) {
    const ModuleNamePair namePair = this.resolveNamePair(requestedModule);
    // Runtime modules are resolved like imports, so the platform specific variants (e.g. error_rt_freestanding.spice) win
    const FilePath basePath = getStdDir() / "runtime" / String(namePair.fileName);
    Vector<FilePath> candidatePaths;
    const FilePath filePath = resolvePlatformSpecificSourceFile(this.resourceManager.cliOptions, basePath, parentSourceFile.filePath, candidatePaths);
    assert !filePath.isEmpty();
    assert filePath != parentSourceFile.filePath;

    // Instruct the global resource manager to create a new source file
    SourceFile* moduleSourceFile = this.resourceManager.createSourceFile(parentSourceFile, String(namePair.importName), filePath, true);
    moduleSourceFile.isMainFile = false;

    // Run frontend and first type checker run for the loaded source file
    moduleSourceFile.runFrontEnd();
    // Merge the runtime module's own dependency registries (deferred tail of the front-end, see SourceFile.runMiddleEnd)
    moduleSourceFile.mergeNameRegistriesRecursive();
    moduleSourceFile.runTypeCheckerPre();

    return moduleSourceFile;
}

public f<ModuleNamePair> RuntimeModuleManager.resolveNamePair(RuntimeModule requestedModule) {
    switch requestedModule {
        case RuntimeModule::STRING_RT: {
            return ModuleNamePair{STRING_RT_IMPORT_NAME, "string_rt"};
        }
        case RuntimeModule::RESULT_RT: {
            return ModuleNamePair{RESULT_RT_IMPORT_NAME, "result_rt"};
        }
        case RuntimeModule::ERROR_RT: {
            return ModuleNamePair{ERROR_RT_IMPORT_NAME, "error_rt"};
        }
        case RuntimeModule::ERROR_TRACE_RT: {
            return ModuleNamePair{ERROR_TRACE_RT_IMPORT_NAME, "error_trace_rt"};
        }
        case RuntimeModule::MEMORY_RT: {
            return ModuleNamePair{MEMORY_RT_IMPORT_NAME, "memory_rt"};
        }
        case RuntimeModule::RTTI_RT: {
            return ModuleNamePair{RTTI_RT_IMPORT_NAME, "rtti_rt"};
        }
        case RuntimeModule::STACK_TRACE_RT: {
            return ModuleNamePair{STACK_TRACE_RT_IMPORT_NAME, "stack_trace_rt"};
        }
        case RuntimeModule::LIBC_RT: {
            return ModuleNamePair{LIBC_RT_IMPORT_NAME, "libc_rt"};
        }
        default: {                                            // LCOV_EXCL_LINE
            panic(Error("Requested unknown runtime module")); // LCOV_EXCL_LINE
        }                                                     // LCOV_EXCL_LINE
    }
}