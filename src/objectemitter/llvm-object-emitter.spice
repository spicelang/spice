// Std imports
import "std/io/filepath";
import "std/bindings/llvm/llvm" as llvm;

// Own imports
import "@/exception/fatal-error";
import "@/compiler-pass";
import "@/source-file";
import "@/exception/compiler-error";
import "@/global/global-resource-manager";
import "@/objectemitter/abstract-object-emitter";
import "@/util/compiler-warning";

/**
 * Emits the object file or the assembly code of a module with the LLVM codegen backend
 */
public type LLVMObjectEmitter struct : IAbstractObjectEmitter {
    compose public CompilerPass compilerPass
    llvm::Module* module
}

public p LLVMObjectEmitter.ctor(GlobalResourceManager& resourceManager, SourceFile* sourceFile) {
    this.compilerPass = CompilerPass(resourceManager, sourceFile);
    this.module = this.cliOptions.useLTO ? &resourceManager.ltoModule : &sourceFile.llvmModule;
}

public p LLVMObjectEmitter.emit(const FilePath& objectPath) {
    const string objectPathString = objectPath.toString();

    // Collect the diagnostics of the backend (e.g. for invalid inline assembly), since the default diagnostic handler of LLVM
    // would exit the process on errors
    llvm::LLVMContext& context = this.sourceFile.getLLVMContext();
    llvm::DiagnosticCollector diagnostics;
    context.setDiagnosticCollector(&diagnostics);

    // Emit object file
    String errorMessage;
    const bool emitFailed = this.sourceFile.targetMachine.emitToFileWithError(*this.module, objectPathString, llvm::LLVMCodeGenFileType::ObjectFile, errorMessage);
    context.resetDiagnosticHandler();
    this.reportDiagnostics(diagnostics);
    if emitFailed {
        const String messageSuffix = "File '" + String(objectPathString) + "' could not be opened";                 // LCOV_EXCL_LINE
        const CompilerError error = CompilerError(CompilerErrorType::CANT_OPEN_OUTPUT_FILE, messageSuffix.getRaw()); // LCOV_EXCL_LINE
        abortWithError(error.getMessage());                                                                        // LCOV_EXCL_LINE
    } // LCOV_EXCL_LINE
}

/**
 * Print the warnings of the backend and abort the compilation on errors
 *
 * @param diagnostics Diagnostics of the backend
 */
p LLVMObjectEmitter.reportDiagnostics(const llvm::DiagnosticCollector& diagnostics) {
    if !this.sourceFile.ignoreWarnings {
        foreach const String& warningMessage : diagnostics.warnings {
            CompilerWarning warning = CompilerWarning(CompilerWarningType::BACKEND_WARNING, warningMessage.getRaw());
            warning.print();
        }
    }
    if !diagnostics.errors.isEmpty() {
        String message;
        foreach const String& diagnosticMessage : diagnostics.errors {
            if !message.isEmpty() {
                message += "\n";
            }
            message += diagnosticMessage;
        }
        const CompilerError error = CompilerError(CompilerErrorType::BACKEND_ERROR, message.getRaw());
        abortWithError(error.getMessage());
    }
}

public p LLVMObjectEmitter.getASMString(String& output) {
    if this.sourceFile.targetMachine.emitToString(*this.module, llvm::LLVMCodeGenFileType::AssemblyFile, output) {
        const CompilerError error = CompilerError(CompilerErrorType::WRONG_OUTPUT_TYPE, "Target machine can't emit a file of this type"); // LCOV_EXCL_LINE
        abortWithError(error.getMessage());                                                                                              // LCOV_EXCL_LINE
    } // LCOV_EXCL_LINE
}
