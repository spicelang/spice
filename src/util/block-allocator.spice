// Std imports
import "std/data/vector";
import "std/os/system";

// Own imports
import "bootstrap/util/memory";

type Base dyn;
type T dyn;

public type BlockAllocator<Base> struct {
    IMemoryManager& memoryManager
    // The heap qualifier is re-applied via a cast wherever a block is allocated, used or freed.
    Vector<byte*> memoryBlocks
    Vector<Base*> allocatedObjects
    unsigned long blockSize
    unsigned long offsetInBlock = 0l
}

public p BlockAllocator.ctor(IMemoryManager& memoryManager, unsigned long blockSize = 0l) {
    this.memoryManager = memoryManager;
    this.blockSize = blockSize == 0l ? cast<unsigned long>(getPageSize()) : blockSize;
    // We do not allow allocating objects that exceed the block size
    assert sizeof<Base>() <= this.blockSize;
    // Allocate the first block
    this.allocateNewBlock();
}

public p BlockAllocator.dtor() {
    // Destruct all objects. We dereference here so that the destructor of the pointed-to object (the
    // 'Base' value, e.g. ASTNode) runs. Passing the pointer itself would instantiate sDestruct for a
    // pointer type, which is trivially destructible and would therefore be a no-op.
    foreach Base* ptr : this.allocatedObjects {
        sDestruct(*ptr);
    }
    this.allocatedObjects.clear();

    // Free all memory blocks
    foreach byte* block : this.memoryBlocks {
        unsafe {
            this.memoryManager.deallocate(cast<heap byte*>(block));
        }
    }
    this.memoryBlocks.clear();
}

/**
 * Reserve uninitialized, correctly sized storage for an object of type T within the current block
 * (allocating a new block if required) and return a typed pointer to it. The caller is responsible
 * for constructing the object in place (e.g. via __placement_new). Returning raw storage instead of
 * copying a prebuilt object means T does not need to be copyable.
 */
public f<T*> BlockAllocator.reserve<T>() {
    // We do not allow allocating objects that exceed the block size
    const unsigned long objSize = sizeof<T>();
    assert objSize <= this.blockSize;

    // Check if we need a new block
    if this.offsetInBlock + objSize > this.blockSize {
        this.allocateNewBlock();
    }

    // Compute the destination address inside the current block. We deliberately operate on a plain
    // (non-heap) byte* here: a named 'heap byte*' local would be treated as an owning pointer and freed
    // again at scope exit, double-freeing the block that is owned by 'memoryBlocks'.
    T* ptr;
    unsafe {
        byte* destAddr = this.memoryBlocks.back();
        destAddr += this.offsetInBlock;
        ptr = cast<T*>(destAddr);
    }

    // Track the object so it can be destructed in the allocator's dtor and update the offset to be ready
    // to store the next object. The object is not constructed yet, but its address is already stable.
    Base* basePtr = cast<Base*>(ptr);
    this.allocatedObjects.pushBack(basePtr);
    this.offsetInBlock += objSize;
    return ptr;
}

/**
 * Hand the reserved objects over to the caller, which is then responsible for destructing them. The memory blocks stay owned by
 * the allocator. Pools of objects, whose concrete types compose Base (e.g. the AST nodes), need this, because the dtor of the
 * allocator can only destruct them as Base, which would leak the members of the concrete types.
 *
 * @return Pointers to all objects, which were reserved via this allocator
 */
public f<Vector<Base*>> BlockAllocator.releaseObjects() {
    Vector<Base*> objects = this.allocatedObjects;
    this.allocatedObjects.clear();
    return objects;
}

/**
 * Get the total number of bytes, which were allocated for memory blocks
 *
 * @return Total allocated size in bytes
 */
public f<unsigned long> BlockAllocator.getTotalAllocatedSize() {
    return this.memoryBlocks.getSize() * this.blockSize;
}

/**
 * Get the number of objects, which were reserved via this allocator
 *
 * @return Number of allocations
 */
public f<unsigned long> BlockAllocator.getAllocationCount() {
    return this.allocatedObjects.getSize();
}

public p BlockAllocator.allocateNewBlock() {
    // Allocate a new block and immediately reinterpret it as a plain byte*. The 'memoryManager.allocate'
    // result is a 'heap byte*'; binding it to a named local would make it an owning pointer that is freed
    // again at scope exit. By casting the temporary inline we transfer the raw address into 'memoryBlocks'
    // without the compiler inserting an auto-free. The block is freed manually in the dtor.
    byte* rawPtr;
    unsafe {
        rawPtr = cast<byte*>(this.memoryManager.allocate(this.blockSize));
    }
    if rawPtr == nil<byte*> {
        panic(Error("Could not allocate memory block for BlockAllocator."));
    }

    // Store pointer and reset offset
    this.memoryBlocks.pushBack(rawPtr);
    this.offsetInBlock = 0l;
}
// ─── tests ────────────────────────────────────────────────────────────────────

// Number of destructed dummy nodes. Spice only supports globals of primitive type, so the counter lives here
unsigned long DESTRUCTED_DUMMY_NODES = 0l;

type DummyNode struct {
    unsigned long line
    unsigned long col
}

public p DummyNode.ctor(unsigned long line, unsigned long col) {
    this.line = line;
    this.col = col;
}

public p DummyNode.dtor() {
    unsafe {
        DESTRUCTED_DUMMY_NODES++;
    }
}

// Memory manager, that counts the allocated and deallocated blocks
type CountingMemoryManager struct : IMemoryManager {
    DefaultMemoryManager defaultMemoryManager
    unsigned long allocations = 0l
    unsigned long deallocations = 0l
}

public f<heap byte*> CountingMemoryManager.allocate(unsigned long size) {
    this.allocations++;
    return this.defaultMemoryManager.allocate(size);
}

public p CountingMemoryManager.deallocate(heap byte*& ptr) {
    this.deallocations++;
    this.defaultMemoryManager.deallocate(ptr);
}

// Allocate the given number of dummy nodes with an allocator of the given block size and check that they are intact and
// destructed together with the allocator
f<bool> allocateDummyNodes(unsigned long nodeCount, unsigned long blockSize, unsigned long nodesPerBlock) {
    DESTRUCTED_DUMMY_NODES = 0l;
    CountingMemoryManager memoryManager;
    {
        BlockAllocator<DummyNode> alloc = BlockAllocator<DummyNode>(memoryManager, blockSize);

        // Allocate nodes
        Vector<DummyNode*> nodes;
        for unsigned long i = 0l; i < nodeCount; i++ {
            DummyNode* node = alloc.reserve<DummyNode>();
            assert node != nil<DummyNode*>;
            unsafe {
                __placement_new<DummyNode>(node, i, 1l);
            }
            nodes.pushBack(node);
        }

        // Check that no node was overwritten by a later one
        for unsigned long i = 0l; i < nodeCount; i++ {
            DummyNode* node = nodes.get(i);
            assert node.line == i;
            assert node.col == 1l;
        }

        // Check if stats are correct
        const unsigned long blockCount = (nodeCount + nodesPerBlock - 1l) / nodesPerBlock;
        assert alloc.getAllocationCount() == nodeCount;
        assert alloc.getTotalAllocatedSize() == blockCount * blockSize;
        assert memoryManager.allocations == blockCount;
        assert memoryManager.deallocations == 0l;

        // Block allocator gets destructed here and with that, all allocated nodes should be destructed
    }
    assert DESTRUCTED_DUMMY_NODES == nodeCount;
    assert memoryManager.deallocations == memoryManager.allocations;
    return true;
}

#[test]
f<bool> testBlockAllocatorLarge() {
    // Create allocator, that can hold 5 nodes per block
    return allocateDummyNodes(100000l, sizeof<DummyNode>() * 5l, 5l);
}

#[test]
f<bool> testBlockAllocatorUnevenBlockSize() {
    // Create allocator, that can hold 4.5 nodes per block
    return allocateDummyNodes(1000l, sizeof<DummyNode>() * 9l / 2l, 4l);
}

#[test]
f<bool> testBlockAllocatorReleaseObjects() {
    unsafe {
        DESTRUCTED_DUMMY_NODES = 0l;
    }
    DefaultMemoryManager memoryManager;
    Vector<DummyNode*> released;
    {
        BlockAllocator<DummyNode> alloc = BlockAllocator<DummyNode>(memoryManager, sizeof<DummyNode>() * 2l);
        for unsigned long i = 0l; i < 5l; i++ {
            DummyNode* node = alloc.reserve<DummyNode>();
            unsafe {
                __placement_new<DummyNode>(node, i, 1l);
            }
        }
        // The caller becomes responsible for destructing the released objects, so the allocator must not do it anymore
        released = alloc.releaseObjects();
        assert released.getSize() == 5l;
        assert alloc.getAllocationCount() == 0l;
        foreach DummyNode* node : released {
            sDestruct(*node);
        }
    }
    unsafe {
        assert DESTRUCTED_DUMMY_NODES == 5l;
    }
    return true;
}
