// Std imports
import "std/data/unordered-map";
import "std/math/hash";
import "std/text/stringstream";
import "std/type/type-conversion";

// Generic type defs
type T dyn;

/**
 * Lookup cache of a manager (FunctionManager, StructManager, ...). Spice only supports globals of primitive type, so the cache
 * and its statistics are kept in the global resource manager, which clears them when it is destroyed.
 */
public type LookupCache<T> struct {
    public UnorderedMap<Hash, T*> lookupCache
    public unsigned long lookupCacheHits = 0l
    public unsigned long lookupCacheMisses = 0l
    // Requests that did not match anything, with the registry version at that time (only used by the FunctionManager)
    public UnorderedMap</*cacheKey=*/Hash, /*registryVersion=*/unsigned long> noMatchCache
    // Increased whenever a new entry is inserted (only used by the FunctionManager)
    public unsigned long registryVersion = 0l
}

/**
 * Clear the lookup cache
 */
public p LookupCache.cleanup() {
    this.lookupCache.clear();
    this.noMatchCache.clear();
    this.registryVersion = 0l;
    this.lookupCacheHits = 0l;
    this.lookupCacheMisses = 0l;
}

/**
 * Dump usage statistics for the lookup cache
 *
 * @param managerName Name of the manager, the cache belongs to
 * @return Statistics string
 */
public f<String> LookupCache.dumpLookupCacheStatistics(const string managerName) {
    StringStream stats;
    stats << managerName << " lookup cache statistics:\n";
    stats << "  lookup cache entries: " << toString(this.lookupCache.getSize()) << "\n";
    stats << "  lookup cache hits: " << toString(this.lookupCacheHits) << "\n";
    stats << "  lookup cache misses: " << toString(this.lookupCacheMisses) << "\n";
    return stats.str();
}
