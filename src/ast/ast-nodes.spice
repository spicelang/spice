public const string OP_FCT_PREFIX = "op.";
public const string OP_FCT_PLUS = "op.plus";
public const string OP_FCT_MINUS = "op.minus";
public const string OP_FCT_MUL = "op.mul";
public const string OP_FCT_DIV = "op.div";
