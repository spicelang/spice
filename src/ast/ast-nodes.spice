// ========================================================== DeclStmtNode =======================================================
// Declared before ParamLstNode (which composes a Vector<ASTDeclStmtNode*> below) since parseParamLst
// back-annotates each param's 'isFctParam' field directly (not via dispatch), so the list needs to stay
// concretely typed, which in turn needs DeclStmtNode defined first (same-file ordering rule).

public type ASTDeclStmtNode struct : IVisitable {
    compose public ASTStmtNode node

    public String varName
    public ASTDataTypeNode* dataType = nil<ASTDataTypeNode*>
    public bool hasAssignment = false
    public IVisitable* assignExpr = nil<IVisitable*>
    public bool isFctParam = false
    public bool isForEachItem = false
    public bool isCtorCallRequired = false // For struct, in case there are reference fields, we need to call a user-defined ctor
    public Vector<SymbolTableEntry*> entries
    public Function* calledInitCtor = nil<Function*>
    public Function* calledCopyCtor = nil<Function*>
}

public p ASTDeclStmtNode.ctor(CodeLoc codeLoc) {
    this.node = ASTStmtNode(codeLoc);
    this.kind = ASTNodeKind::DECL_STMT;
}
public f<Any> ASTDeclStmtNode.accept(IAbstractAstVisitor* visitor) {
    return visitor.visitDeclStmt(this);
}


