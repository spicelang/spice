// ========================================================== FctCallNode ========================================================

public type FctCallType enum {
    TYPE_ORDINARY,
    TYPE_METHOD,
    TYPE_CTOR,
    TYPE_FCT_PTR
}

public type FctCallData struct {
    public FctCallType callType = FctCallType::TYPE_ORDINARY
    public bool isImported = false
    public QualTypeList templateTypes
    public QualType thisType // Is filled if method or ctor call
    public ArgList args
    public const Function* callee = nil<const Function*> // Stays nil if function pointer call
    public Scope* calleeParentScope = nil<Scope*>
    public CompileTimeValue compileTimeValue
    public bool compileTimeValueSet = false
}

public p FctCallData.ctor() {
    this.thisType = QualType(SuperType::TY_DYN);
}

public f<bool> FctCallData.isOrdinaryCall() { return this.callType == FctCallType::TYPE_ORDINARY; }
public f<bool> FctCallData.isMethodCall() { return this.callType == FctCallType::TYPE_METHOD; }
public f<bool> FctCallData.isVirtualMethodCall() { return this.isMethodCall() && this.thisType.isBase(SuperType::TY_INTERFACE); }
public f<bool> FctCallData.isCtorCall() { return this.callType == FctCallType::TYPE_CTOR; }
public f<bool> FctCallData.isFctPtrCall() { return this.callType == FctCallType::TYPE_FCT_PTR; }

public p FctCallData.setCompileTimeValue(const CompileTimeValue& value) {
    this.compileTimeValue = value;
    this.compileTimeValueSet = true;
}

public f<bool> FctCallData.hasCompileTimeValue() { return this.compileTimeValueSet; }

public type ASTFctCallNode struct : IVisitable {
    compose public ASTExprNode node

    public ASTTypeLstNode* templateTypeLst = nil<ASTTypeLstNode*>
    public ASTArgLstNode* argLst = nil<ASTArgLstNode*>
    public bool hasArgs = false
    public bool hasTemplateTypes = false
    public String fqFunctionName
    public Vector<String> functionNameFragments
    public Vector<FctCallData> data
    public bool isErrorTraceOrigin = false // Set if this is a direct call to err<T>(...), and error return tracing is enabled
}

public p ASTFctCallNode.ctor(CodeLoc codeLoc) {
    this.node = ASTExprNode(codeLoc);
    this.kind = ASTNodeKind::FCT_CALL;
}
public f<Any> ASTFctCallNode.accept(IAbstractAstVisitor* visitor) {
    return visitor.visitFctCall(this);
}

/**
 * Check if right above the closest assign expression ancestor is a statement node
 *
 * @return Has return value receiver or not
 */
public f<bool> ASTFctCallNode.hasReturnValueReceiver() {
    ASTNode* current = this.parent;
    while current.kind != ASTNodeKind::ASSIGN_EXPR {
        if current.kind == ASTNodeKind::EXPR_STMT {
            return false;
        }
        // The call is (part of) an argument of another call, so the return value is used
        if current.kind == ASTNodeKind::ARG_LST {
            return true;
        }
        // Incrementing or decrementing the returned value counts as a use
        if current.kind == ASTNodeKind::PREFIX_UNARY_EXPR {
            const PrefixUnaryOp op = downcast<ASTPrefixUnaryExprNode>(current).op;
            if op == PrefixUnaryOp::OP_PLUS_PLUS || op == PrefixUnaryOp::OP_MINUS_MINUS {
                return true;
            }
        }
        if current.kind == ASTNodeKind::POSTFIX_UNARY_EXPR {
            const PostfixUnaryOp op = downcast<ASTPostfixUnaryExprNode>(current).op;
            if op == PostfixUnaryOp::OP_PLUS_PLUS || op == PostfixUnaryOp::OP_MINUS_MINUS {
                return true;
            }
        }
        // As soon as we have a node with more than one child, we know that the return value is used
        if current.children.getSize() > 1l {
            return true;
        }
        current = current.parent;
    }
    // Also check the condition of the assign expression
    const ASTNode* assignExprParent = current.parent;
    return current.children.getSize() > 1l || assignExprParent.kind != ASTNodeKind::EXPR_STMT;
}


