public const string OP_FCT_POSTFIX_MINUS_MINUS = "op.minusminus.post";
public const string OP_FCT_SUBSCRIPT = "op.subscript";
public const string OP_FCT_ASSIGN = "op.assign";

/**
 * Saves a constant value for an AST node to realize features like array-out-of-bounds checks
 *
 * The compiler reads across the members of a compile time value, e.g. the longValue of an int constant in compile time
 * arithmetic, or the boolValue of a non-bool condition. Spice unions are tagged and panic when an inactive field is read,
 * so an untagged union is emulated here: all members share 8 bytes of storage and each member is a view on them, which
 * reads and writes only its own bytes.
 */
public type CompileTimeValue struct {
    long storage = 0l
}

// Address of the shared storage, the members are views on
inline f<byte*> CompileTimeValue.getStorageAddress() {
    unsafe {
        return cast<byte*>(&this.storage);
    }
}

public f<double> CompileTimeValue.getDoubleValue() {
    unsafe {
        const double* valuePtr = cast<double*>(this.getStorageAddress());
        return *valuePtr;
    }
}
public p CompileTimeValue.setDoubleValue(double value) {
    unsafe {
        double* valuePtr = cast<double*>(this.getStorageAddress());
        *valuePtr = value;
    }
}

public f<int> CompileTimeValue.getIntValue() {
    unsafe {
        const int* valuePtr = cast<int*>(this.getStorageAddress());
        return *valuePtr;
    }
}
public p CompileTimeValue.setIntValue(int value) {
    unsafe {
        int* valuePtr = cast<int*>(this.getStorageAddress());
        *valuePtr = value;
    }
}

public f<short> CompileTimeValue.getShortValue() {
    unsafe {
        const short* valuePtr = cast<short*>(this.getStorageAddress());
        return *valuePtr;
    }
}
public p CompileTimeValue.setShortValue(short value) {
    unsafe {
        short* valuePtr = cast<short*>(this.getStorageAddress());
        *valuePtr = value;
    }
}

public f<long> CompileTimeValue.getLongValue() {
    return this.storage;
}
public p CompileTimeValue.setLongValue(long value) {
    this.storage = value;
}

public f<char> CompileTimeValue.getCharValue() {
    unsafe {
        const char* valuePtr = cast<char*>(this.getStorageAddress());
        return *valuePtr;
    }
}
public p CompileTimeValue.setCharValue(char value) {
    unsafe {
        char* valuePtr = cast<char*>(this.getStorageAddress());
        *valuePtr = value;
    }
}

// Offset into vector of strings in GlobalResourceManager
public f<unsigned long> CompileTimeValue.getStringValueOffset() {
    unsafe {
        const unsigned long* valuePtr = cast<unsigned long*>(this.getStorageAddress());
        return *valuePtr;
    }
}
public p CompileTimeValue.setStringValueOffset(unsigned long value) {
    unsafe {
        unsigned long* valuePtr = cast<unsigned long*>(this.getStorageAddress());
        *valuePtr = value;
    }
}

// A bool occupies one byte, which is interpreted like a C++ bool (any non-zero value is true)
public f<bool> CompileTimeValue.getBoolValue() {
    unsafe {
        const byte* valuePtr = this.getStorageAddress();
        return *valuePtr != cast<byte>(0);
    }
}
public p CompileTimeValue.setBoolValue(bool value) {
    unsafe {
        byte* valuePtr = this.getStorageAddress();
        *valuePtr = value ? cast<byte>(1) : cast<byte>(0);
    }
}

public type IVisitable interface {
    public f<Any> accept(IAbstractAstVisitor*);
    public f<const CodeLoc&> getCodeLoc();
    // Address of the composed ASTNode. It is not typed as ASTNode*, because ASTNode is declared after this interface (and
    // needs it for its 'visitable' field). Use getASTNode(IVisitable*) to retrieve the typed pointer.
    public f<byte*> getASTNodeAddress();
}

// ========================================================= ASTNodeKind =========================================================

/**
 * Kind of a concrete AST node. Spice has no virtual dispatch through a struct, so the functions below, that depend on the
 * concrete node (e.g. returnsOnAllControlPaths), switch over the kind of the node instead.
 */
public type ASTNodeKind enum {
    INVALID,
    ENTRY,
    CONSTANT,
    ATTR,
    ATTR_LST,
    QUALIFIER,
    QUALIFIER_LST,
    CUSTOM_DATA_TYPE,
    BASE_DATA_TYPE,
    DATA_TYPE,
    TYPE_LST,
    MAIN_FCT_DEF,
    FCT_NAME,
    FCT_DEF,
    PROC_DEF,
    STRUCT_DEF,
    INTERFACE_DEF,
    UNION_DEF,
    ENUM_DEF,
    GENERIC_TYPE_DEF,
    ALIAS_DEF,
    GLOBAL_VAR_DEF,
    EXT_DECL,
    IMPORT_DEF,
    UNSAFE_BLOCK,
    FOR_LOOP,
    FOREACH_LOOP,
    WHILE_LOOP,
    DO_WHILE_LOOP,
    IF_STMT,
    ELSE_STMT,
    SWITCH_STMT,
    CASE_BRANCH,
    DEFAULT_BRANCH,
    ANONYMOUS_BLOCK_STMT,
    STMT_LST,
    TYPE_LST_WITH_ELLIPSIS,
    TYPE_ALTS_LST,
    DECL_STMT,
    PARAM_LST,
    ARG_LST,
    ENUM_ITEM,
    ENUM_ITEM_LST,
    FIELD,
    SIGNATURE,
    EXPR_STMT,
    MOD_ATTR,
    TOP_LEVEL_DEF_ATTR,
    LAMBDA_ATTR,
    CASE_CONSTANT,
    RETURN_STMT,
    BREAK_STMT,
    CONTINUE_STMT,
    FALLTHROUGH_STMT,
    ASSERT_STMT,
    ASSIGN_EXPR,
    TERNARY_EXPR,
    LOGICAL_OR_EXPR,
    LOGICAL_AND_EXPR,
    BITWISE_OR_EXPR,
    BITWISE_XOR_EXPR,
    BITWISE_AND_EXPR,
    EQUALITY_EXPR,
    RELATIONAL_EXPR,
    SHIFT_EXPR,
    ADDITIVE_EXPR,
    MULTIPLICATIVE_EXPR,
    CAST_EXPR,
    PREFIX_UNARY_EXPR,
    POSTFIX_UNARY_EXPR,
    ATOMIC_EXPR,
    VALUE,
    FCT_CALL,
    ARRAY_INITIALIZATION,
    STRUCT_INSTANTIATION,
    LAMBDA_FUNC,
    LAMBDA_PROC,
    LAMBDA_EXPR,
    FUNCTION_DATA_TYPE
}

// =========================================================== ASTNode ===========================================================

public type ASTNode struct {
    public ASTNode* parent = nil<ASTNode*>
    public Vector<ASTNode*> children
    public CodeLoc codeLoc
    // The node as an IVisitable*, set by the parser when it creates the node. A plain ASTNode* cannot be dispatched
    // on (Spice has no virtual dispatch through a struct), so generic child traversal goes through this pointer.
    public IVisitable* visitable = nil<IVisitable*>
    // Kind of the concrete node. Set by the constructor of the concrete node
    public ASTNodeKind kind = ASTNodeKind::INVALID
    // Whether the node is an expression / statement node. Set by the constructors of ASTExprNode / ASTStmtNode
    public bool isExprNode = false
    public bool isStmtNode = false
}

public p ASTNode.ctor(const CodeLoc& codeLoc) {
    this.codeLoc = codeLoc;
}

// Explicit destructor. AST nodes only ever live inside the BlockAllocator pool and are released via
// destructASTNode(), which destructs them as their concrete node type. This destructor then runs as part of
// the destruction of the composed node base. Defining it explicitly makes sure it is generated. The composed
// 'children' vector only holds non-owning pointers, so it is enough to let the implicitly appended member
// destruction free the vector storage.
public p ASTNode.dtor() {}

public f<Any> ASTNode.accept(IAbstractAstVisitor* _) { // LCOV_EXCL_LINE
    assert false;                                      // LCOV_EXCL_LINE - Concrete node types must override accept()
    return Any();                                      // LCOV_EXCL_LINE
}                                                      // LCOV_EXCL_LINE

// Register a child node and set its parent to this node.
public p ASTNode.addChild(ASTNode* child) {
    assert child != nil<ASTNode*>;
    child.parent = this;
    this.children.pushBack(child);
}

public f<const Vector<ASTNode*>&> ASTNode.getChildren() {
    return this.children;
}

// Number of chars of context, that an error message shows around the erroneous code
const long ERROR_MESSAGE_CONTEXT = 20l;

// Whether the given char can be part of an identifier or keyword
f<bool> isIdentifierChar(char c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
}

// Get the text of the source code interval [start, stop] (both inclusive), clamped to the source code
f<String> getSourceText(const String& sourceCode, long start, long stop) {
    const long size = cast<long>(sourceCode.getLength());
    if stop >= size { stop = size - 1l; }
    if start < 0l || start >= size || stop < start { return String(); }
    return sourceCode.getSubstring(cast<unsigned long>(start), stop - start + 1l);
}

// Get the char at the given offset of the source code
f<char> getSourceChar(const String& sourceCode, long idx) {
    const String text = getSourceText(sourceCode, idx, idx);
    if text.isEmpty() { return '\0'; }
    const string rawText = text.getRaw();
    char c = '\0';
    unsafe { c = rawText[0]; }
    return c;
}

// Get the length of the interval [start, stop]
f<long> getIntervalLength(long start, long stop) {
    return stop < start ? 0l : stop - start + 1l;
}

/**
 * Get the error message snippet of this node: the source code line of the node with some context around it, and a marker
 * below the code of the node.
 *
 * Note: The nodes do not know their source file, so the source code is read from the file, the code location points to.
 *
 * @return Error message snippet
 */
public f<String> ASTNode.getErrorMessage() {
    // Without a source interval (e.g. for nodes that were not created by the parser), there is no snippet to show
    if this.codeLoc.sourceIntervalStart < 0l || len(this.codeLoc.sourceFilePath) == 0 {
        return String();
    }
    Result<String> sourceCodeResult = readFile(this.codeLoc.sourceFilePath);
    if !sourceCodeResult.isOk() {
        return String();
    }
    const String sourceCode = sourceCodeResult.unwrap();
    const long inputSize = cast<long>(sourceCode.getLength());
    const long sourceIntervalStart = this.codeLoc.sourceIntervalStart;
    const long sourceIntervalStop = this.codeLoc.sourceIntervalStop;
    long extStart = sourceIntervalStart;
    long extStop = sourceIntervalStop;

    // If we have a multi-line interval, only use the first line
    const String nodeText = getSourceText(sourceCode, extStart, extStop);
    const long newLineOffset = nodeText.find('\n');
    if newLineOffset != -1l {
        extStop = extStart + newLineOffset;
    }
    const long nodeEnd = extStop;

    long markerIndentation = 0l;
    while markerIndentation < ERROR_MESSAGE_CONTEXT {
        extStart--;
        const String extText = getSourceText(sourceCode, extStart, extStop);
        if extStart < 0l || extText.find('\n') != -1l {
            extStart++;
            break;
        }
        markerIndentation++;
    }
    for long suffixContext = 0l; suffixContext < ERROR_MESSAGE_CONTEXT; suffixContext++ {
        extStop++;
        const String extText = getSourceText(sourceCode, extStart, extStop);
        if extStop > inputSize || extText.find('\n') != -1l {
            extStop--;
            break;
        }
    }

    // The context size is only a rough suggestion. Do not cut the context in the middle of an identifier or keyword
    while extStart > 0l && isIdentifierChar(getSourceChar(sourceCode, extStart - 1l)) && isIdentifierChar(getSourceChar(sourceCode, extStart)) {
        extStart--;
        markerIndentation++;
    }
    while extStop + 1l < inputSize && isIdentifierChar(getSourceChar(sourceCode, extStop)) && isIdentifierChar(getSourceChar(sourceCode, extStop + 1l)) {
        extStop++;
    }

    // Trim start
    while getSourceChar(sourceCode, extStart) == ' ' {
        extStart++;
        markerIndentation--;
    }

    // Trim end
    if getSourceChar(sourceCode, extStop) == '\n' {
        extStop--;
    }
    while extStop > nodeEnd && getSourceChar(sourceCode, extStop) == ' ' {
        extStop--;
    }

    const String lineNumberStr = toString(this.codeLoc.line);
    markerIndentation += cast<long>(lineNumberStr.getLength()) + 2l;

    // Build error message
    String errorMessage = lineNumberStr + "  " + getSourceText(sourceCode, extStart, extStop) + "\n";
    for long i = 0l; i < markerIndentation; i++ {
        errorMessage += ' ';
    }
    const long sourceIntervalLength = getIntervalLength(sourceIntervalStart, sourceIntervalStop);
    const long extIntervalLength = getIntervalLength(extStart, extStop);
    const long markerLength = sourceIntervalLength < extIntervalLength ? sourceIntervalLength : extIntervalLength;
    for long i = 0l; i < markerLength; i++ {
        errorMessage += '^';
    }
    return errorMessage;
}

/**
 * Dispatch to all registered children of a node. Passes use this as the default behavior of every visit method they do not
 * implement themselves.
 *
 * @param node Node whose children should be visited
 * @param visitor Visitor to dispatch to
 */
public f<Any> visitChildrenOf(ASTNode* node, IAbstractAstVisitor* visitor) {
    foreach ASTNode* child : node.children {
        assert child != nil<ASTNode*>;
        assert child.visitable != nil<IVisitable*>;
        const Any _ = child.visitable.accept(visitor);
    }
    return Any();
}

// ========================================================== EntryNode ==========================================================

public type ASTEntryNode struct : IVisitable {
    compose public ASTNode node

    public Vector<IVisitable*> modAttrs
    public Vector<IVisitable*> importDefs
    public Vector<IVisitable*> topLevelDefs
    public Vector<IVisitable*> switchStmts // All switch statements of this file for quick access, not part of the children
}

public p ASTEntryNode.ctor(CodeLoc codeLoc) {
    this.node = ASTNode(codeLoc);
    this.kind = ASTNodeKind::ENTRY;
}
public f<Any> ASTEntryNode.accept(IAbstractAstVisitor* visitor) {
    return visitor.visitEntry(this);
}

// ======================================================= TopLevelDefNode =======================================================

public type ASTTopLevelDefNode struct {
    compose public ASTNode node
}

public p ASTTopLevelDefNode.ctor(CodeLoc codeLoc) {
    this.node = ASTNode(codeLoc);
}

// =========================================================== StmtNode ==========================================================

public type ASTStmtNode struct {
    compose public ASTNode node
    public bool unreachable = false
}

public p ASTStmtNode.ctor(CodeLoc codeLoc) {
    this.node = ASTNode(codeLoc);
    this.isStmtNode = true;
}

// =========================================================== ExprNode ==========================================================

public type ASTExprNode struct {
    compose public ASTNode node
    QualTypeList symbolTypes
}

public p ASTExprNode.ctor(CodeLoc codeLoc) {
    this.node = ASTNode(codeLoc);
    this.isExprNode = true;
}

// Defined after ASTExprNode, because it accesses the symbol types of expression nodes
public p ASTNode.resizeToNumberOfManifestations(unsigned long manifestationCount) {
    // Reserve this node
    if this.isExprNode {
        ASTExprNode* exprNode = asExprNode(this);
        // Reserve exactly the required capacity on the first fill. Most nodes have a single manifestation, but a vector grows to
        // the initial capacity of several items on its first insertion. Later fills (revisits, that add manifestations) keep the
        // geometric growth of the vector, to not reallocate on every revisit. The same applies to customItemsInitialization
        if exprNode.symbolTypes.isEmpty() {
            exprNode.symbolTypes.reserve(manifestationCount);
        }
        while exprNode.symbolTypes.getSize() < manifestationCount {
            exprNode.symbolTypes.pushBack(QualType(SuperType::TY_INVALID));
        }
    }
    // Resize children
    foreach ASTNode* child : this.children {
        assert child != nil<ASTNode*>;
        child.resizeToNumberOfManifestations(manifestationCount);
    }
    // Do custom work
    customItemsInitialization(this, manifestationCount);
}

#[ignoreUnusedReturnValue]
public f<QualType> ASTExprNode.setEvaluatedSymbolType(const QualType& symbolType, unsigned long idx) {
    assert this.symbolTypes.getSize() > idx;
    QualType& slot = this.symbolTypes.get(idx);
    slot = symbolType;
    return symbolType;
}

public f<const QualType&> ASTExprNode.getEvaluatedSymbolType(unsigned long idx) {
    if !this.symbolTypes.isEmpty() {
        const QualType& symbolType = this.symbolTypes.get(idx);
        if !symbolType.is(SuperType::TY_INVALID) {
            return symbolType;
        }
    }
    if this.children.getSize() != 1l {
        panic(Error("Cannot deduce evaluated symbol type"));
    }
    ASTExprNode* expr = asExprNode(this.children.front());
    return expr.getEvaluatedSymbolType(idx);
}

// Id of the expression scope, that holds the temporaries of this expression. Only some expressions have such a scope.
public f<String> ASTExprNode.getExprScopeId() {
    return String("expr:") + this.codeLoc.toString();
}

/**
 * Get the expression node base of an AST node. ASTExprNode composes ASTNode as its first member and has no interface, so
 * both share the same address.
 *
 * @param node AST node, which must be an expression node
 * @return Expression node base
 */
public f<ASTExprNode*> asExprNode(ASTNode* node) {
    assert node.isExprNode;
    ASTExprNode* exprNode = nil<ASTExprNode*>;
    unsafe {
        exprNode = cast<ASTExprNode*>(node);
    }
    return exprNode;
}

/**
 * Get the statement node base of an AST node. ASTStmtNode composes ASTNode as its first member and has no interface, so
 * both share the same address.
 *
 * @param node AST node, which must be a statement node
 * @return Statement node base
 */
public f<ASTStmtNode*> asStmtNode(ASTNode* node) {
    assert node.isStmtNode;
    ASTStmtNode* stmtNode = nil<ASTStmtNode*>;
    unsafe {
        stmtNode = cast<ASTStmtNode*>(node);
    }
    return stmtNode;
}

// The node types below are declared here, ahead of the top-level-def/stmt nodes that reference them,
// because Spice requires a struct/interface to be defined before use within the same file (no forward
// declarations). Each one is either a leaf (no struct-pointer fields of its own) or only references
// other nodes already defined above/within this same block.

// ========================================================== ConstantNode =======================================================

public type PrimitiveValueType enum {
    TYPE_NONE,
    TYPE_DOUBLE,
    TYPE_INT,
    TYPE_SHORT,
    TYPE_LONG,
    TYPE_CHAR,
    TYPE_STRING,
    TYPE_BOOL
}

public type ASTConstantNode struct : IVisitable {
    compose public ASTExprNode node
    public PrimitiveValueType primitiveValueType = PrimitiveValueType::TYPE_NONE
    public bool isUnsigned = false // Only set for integer literals with an 'u' suffix (e.g. 1u, 1us, 1ul)
    public CompileTimeValue compileTimeValue
}

public p ASTConstantNode.ctor(CodeLoc codeLoc) {
    this.node = ASTExprNode(codeLoc);
    this.kind = ASTNodeKind::CONSTANT;
}
public f<Any> ASTConstantNode.accept(IAbstractAstVisitor* visitor) {
    return visitor.visitConstant(this);
}

// ============================================================ AttrNode =========================================================

public type ASTAttrNode struct : IVisitable {
    compose public ASTNode node
    public String key
    // Defaults to TARGET_INVALID / ATTR_TYPE_INVALID (both enum ordinal 0) without naming the enum value
    // here: attributes.spice imports this file, so resolving AttrTarget::TARGET_INVALID as a field default
    // can hit a 'used before declared' error depending on which file is the compile entry point.
    public AttrTarget target
    public AttrType attrType
    public ASTConstantNode* value = nil<ASTConstantNode*>
}

public p ASTAttrNode.ctor(CodeLoc codeLoc) {
    this.node = ASTNode(codeLoc);
    this.kind = ASTNodeKind::ATTR;
}
public f<Any> ASTAttrNode.accept(IAbstractAstVisitor* visitor) {
    return visitor.visitAttr(this);
}

// Returns the attribute's compile-time value, or nil if it was declared without one (bool attributes
// default to 'true' when omitted; callers apply that default themselves).
public f<const CompileTimeValue*> ASTAttrNode.getValue() {
    if this.value == nil<ASTConstantNode*> {
        return nil<const CompileTimeValue*>;
    }
    return &this.value.compileTimeValue;
}

// ========================================================== AttrLstNode ========================================================

public type ASTAttrLstNode struct : IVisitable {
    compose public ASTNode node
    public Vector<ASTAttrNode*> attributes
}

public p ASTAttrLstNode.ctor(CodeLoc codeLoc) {
    this.node = ASTNode(codeLoc);
    this.kind = ASTNodeKind::ATTR_LST;
}
public f<Any> ASTAttrLstNode.accept(IAbstractAstVisitor* visitor) {
    return visitor.visitAttrLst(this);
}

public f<bool> ASTAttrLstNode.hasAttr(const String& key) {
    foreach const ASTAttrNode* attr : this.attributes {
        if attr.key == key {
            return true;
        }
    }
    return false;
}

// Returns the attribute's values by copy (CompileTimeValue is a small, trivially-copyable union), so
// there is no shared/static-storage lifetime to manage for the synthesized default-bool fallback below.
public f<Vector<CompileTimeValue>> ASTAttrLstNode.getAttrValuesByName(const String& key) {
    Vector<CompileTimeValue> attributeValues;
    foreach const ASTAttrNode* attr : this.attributes {
        if attr.key != key {
            continue;
        }
        const CompileTimeValue* value = attr.getValue();
        if value == nil<const CompileTimeValue*> {
            // Attribute given without a value defaults to boolValue = true (bool attributes only)
            CompileTimeValue defaultValue;
            defaultValue.setBoolValue(true);
            attributeValues.pushBack(defaultValue);
        } else {
            attributeValues.pushBack(*value);
        }
    }
    return attributeValues;
}

// Precondition: hasAttr(key) must be true (matches every call site in ImportCollector/SymbolTableBuilder,
// which always guard with hasAttr first).
public f<CompileTimeValue> ASTAttrLstNode.getAttrValueByName(const String& key) {
    const Vector<CompileTimeValue> values = this.getAttrValuesByName(key);
    assert !values.isEmpty();
    return values.get(values.getSize() - 1l);
}

