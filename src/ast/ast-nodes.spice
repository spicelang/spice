    compose public ASTExprNode node

    public ASTTypeLstNode* templateTypeLst = nil<ASTTypeLstNode*>
    public ASTArgLstNode* fieldLst = nil<ASTArgLstNode*>
    public bool hasTemplateTypes = false
    public String fqStructName
    public Vector<String> structNameFragments
    public Vector<Struct*> instantiatedStructs
    // Per-manifestation (the struct itself may be/depend on a generic type, e.g. inside a generic function), per-field
    // copy ctor to call for a field value that needs to be deep-copied instead of raw-stored. Kept here rather than on
    // the (manifestation-unaware) shared fieldLst.argInfos, since a struct literal inside a generic function is
    // re-type-checked once per manifestation and each needs its own copy-ctor set.
    public Vector<Vector<Function*>> fieldCopyCtors
}

public p ASTStructInstantiationNode.ctor(CodeLoc codeLoc) {
    this.node = ASTExprNode(codeLoc);
    this.kind = ASTNodeKind::STRUCT_INSTANTIATION;
}
public f<Any> ASTStructInstantiationNode.accept(IAbstractAstVisitor* visitor) {
    return visitor.visitStructInstantiation(this);
}


// ========================================================= LambdaBaseNode ======================================================

public type ASTLambdaBaseNode struct {
    compose public ASTExprNode node
    public IVisitable* paramLst = nil<IVisitable*>
    public bool hasParams = false
    public Scope* bodyScope = nil<Scope*>
    public Vector<Function> manifestations
}

/**
 * Get the lambda base of a lambda node. All lambda nodes compose ASTLambdaBaseNode as their first member, which composes
 * ASTExprNode and therefore ASTNode as its first member, so they all share the same address.
 *
 * @param node AST node, which must be a lambda node
 * @return Lambda base node
 */
public f<ASTLambdaBaseNode*> asLambdaBaseNode(ASTNode* node) {
    assert node.kind == ASTNodeKind::LAMBDA_FUNC || node.kind == ASTNodeKind::LAMBDA_PROC || node.kind == ASTNodeKind::LAMBDA_EXPR;
    ASTLambdaBaseNode* lambdaBaseNode = nil<ASTLambdaBaseNode*>;
    unsafe {
        lambdaBaseNode = cast<ASTLambdaBaseNode*>(node);
    }
    return lambdaBaseNode;
}

public p ASTLambdaBaseNode.ctor(CodeLoc codeLoc) {
    this.node = ASTExprNode(codeLoc);
}

// ========================================================= LambdaFuncNode ======================================================

public type ASTLambdaFuncNode struct : IVisitable {
    compose public ASTLambdaBaseNode node

    public ASTDataTypeNode* returnType = nil<ASTDataTypeNode*>
    public ASTLambdaAttrNode* lambdaAttr = nil<ASTLambdaAttrNode*>
    public IVisitable* body = nil<IVisitable*>
}

public p ASTLambdaFuncNode.ctor(CodeLoc codeLoc) {
    this.node = ASTLambdaBaseNode(codeLoc);
    this.kind = ASTNodeKind::LAMBDA_FUNC;
}
public f<Any> ASTLambdaFuncNode.accept(IAbstractAstVisitor* visitor) {
    return visitor.visitLambdaFunc(this);
}

public f<String> ASTLambdaFuncNode.getScopeId() {
    return String("lambda:") + this.codeLoc.toString();
}


// ========================================================= LambdaProcNode ======================================================

public type ASTLambdaProcNode struct : IVisitable {
