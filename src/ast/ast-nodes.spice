    public ASTLambdaAttrNode* lambdaAttr = nil<ASTLambdaAttrNode*>
    public IVisitable* body = nil<IVisitable*>
}

public p ASTLambdaProcNode.ctor(CodeLoc codeLoc) {
    this.node = ASTLambdaBaseNode(codeLoc);
    this.kind = ASTNodeKind::LAMBDA_PROC;
}
public f<Any> ASTLambdaProcNode.accept(IAbstractAstVisitor* visitor) {
    return visitor.visitLambdaProc(this);
}

public f<String> ASTLambdaProcNode.getScopeId() {
    return String("lambda:") + this.codeLoc.toString();
}


// ========================================================= LambdaExprNode =======================================================

public type ASTLambdaExprNode struct : IVisitable {
