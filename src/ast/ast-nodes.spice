public const string OP_FCT_GREATER = "op.greater";
public const string OP_FCT_LESS_EQUAL = "op.lessequal";
public const string OP_FCT_GREATER_EQUAL = "op.greaterequal";
public const string OP_FCT_SHL = "op.shl";
public const string OP_FCT_SHR = "op.shr";
public const string OP_FCT_BITWISE_AND = "op.bitwiseand";
