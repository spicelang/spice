/**
 * Address of an AST node, which is used as key for maps that are keyed by AST node (e.g. nodeToNodeId)
 *
 * @param node AST node
 * @return Address of the node
 */
public f<long> getNodeAddress(const ASTNode* node) {
    long address = 0l;
    unsafe {
        address = cast<long>(cast<byte*>(node));
    }
    return address;
}

/**
 * Name of the scope that holds the temporaries of an expression.
 *
 * @param expr Expression
 * @return Scope id
 */
public f<String> getExprScopeId(IVisitable* expr) {
    const CodeLoc& codeLoc = expr.getCodeLoc();
    return String("expr:") + codeLoc.toString();
}
