// Std imports
import "std/text/stringstream";
import "std/data/vector";
import "std/io/filepath";

// Own imports
import "bootstrap/global/global-resource-manager";
import "bootstrap/compiler-pass";
import "bootstrap/source-file";
import "bootstrap/reader/code-loc";

/**
 * Visualizer for the import dependency graph. Mirrors the DependencyGraphVisualizer of the former host compiler.
 *
 * Jobs:
 * - Walk the SourceFile dependency tree starting from the main file
 * - Emit one Graphviz dot node per source file, one edge per import relationship
 */
public type DependencyGraphVisualizer struct {
    compose public CompilerPass compilerPass
    Vector<SourceFile*> printedFiles
}

public p DependencyGraphVisualizer.ctor(GlobalResourceManager& resourceManager, SourceFile* sourceFile) {
    this.compilerPass = CompilerPass(resourceManager, sourceFile);
    this.printedFiles = Vector<SourceFile*>();
}

/**
 * Entry point: generate the dependency graph dot code starting from the root source file.
 *
 * @param output Output stream to write the dot node/edge lines into
 */
public p DependencyGraphVisualizer.getDependencyGraph(StringStream& output) {
    assert this.sourceFile.isMainFile;
    this.printedFiles.clear();
    this.getDependencyGraphNode(output, this.sourceFile);
}

/**
 * Recursively emit dot nodes and edges for currentSourceFile and its transitive dependencies.
 *
 * @param output            Output stream
 * @param currentSourceFile Source file to emit
 */
p DependencyGraphVisualizer.getDependencyGraphNode(StringStream& output, SourceFile* currentSourceFile) {
    // Skip if already printed (handles diamonds / shared dependencies)
    foreach SourceFile* printedFile : this.printedFiles {
        if printedFile == currentSourceFile {
            return;
        }
    }
    this.printedFiles.pushBack(currentSourceFile);

    // Emit a node for this source file using a path relative to the main file. Like std::filesystem::relative() of the host,
    // both paths are resolved to their canonical form first, so symlinks along the way (e.g. to the std) do not matter
    const String mainFilePath = String(this.sourceFile.filePath.toString());
    const String nodeId = getRelativePath(String(currentSourceFile.filePath.toString()), mainFilePath);
    output << " \"" << nodeId << "\" [color=\"lightgreen\",label=\"" << currentSourceFile.fileName << "\"];\n";

    // Recurse into dependencies and emit edges
    foreach dyn depEntry : currentSourceFile.dependencies {
        SourceFile* dependency = depEntry.getSecond();
        this.getDependencyGraphNode(output, dependency);
        const String depNodeId = getRelativePath(String(dependency.filePath.toString()), mainFilePath);
        output << " \"" << nodeId << "\" -> \"" << depNodeId << "\";\n";
    }
}
