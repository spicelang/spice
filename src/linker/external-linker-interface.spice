// Std imports
import "std/data/vector";
import "std/io/filepath";
import "std/io/file";
import "std/data/unordered-map";
import "std/os/mutex";
import "std/os/thread";
import "std/type/type-conversion";
import "std/text/string-ext";
import "std/bindings/llvm/llvm" as llvm;

// Own imports
import "@/exception/fatal-error";
import "@/driver";
import "@/util/system-util";
import "@/util/compile-progress";
import "@/exception/compiler-error";
import "@/exception/linker-error";

/**
 * Compilation of an additional source to an object file
 */
type AdditionalSourceCompilation struct {
    FilePath additionalSource
    String linkerInvokerPath
    Vector<String> args
    FilePath objectFilePath
    ExecResult result
}

public type ExternalLinkerInterface struct {
    CliOptions& cliOptions
    // The following members are public to be observable from tests
    public Vector<FilePath> linkedFiles
    public Vector<String> linkerFlags
    public FilePath outputPath
    public bool linkLibMath = false
    Mutex linkLibMathMutex // The IR generator requests libm linkage from the worker threads of the parallel back end
    Vector<FilePath> additionalSourcePaths
    // Object files, that the compiler emitted itself. Only these are intermediary, so only these get cleaned up after linking
    Vector<FilePath> emittedObjectFiles
    // Expanding a linker flag may run commands (backtick substitutions), so every flag is only expanded once
    UnorderedMap<String, Vector<String>> expandedLinkerFlags
    // Compilations of additional sources, that were started early to overlap with the back end
    Vector<AdditionalSourceCompilation> additionalSourceCompilations
    Vector<Thread> additionalSourceCompilationThreads
}

public p ExternalLinkerInterface.ctor(CliOptions& cliOptions) {
    this.cliOptions = cliOptions;
    this.outputPath = cliOptions.outputPath;
}

public p ExternalLinkerInterface.dtor() {
    // The compilation threads write into the members of this linker, so wait for them before it goes away. This is only
    // relevant, if the compilation was aborted before the linker ran.
    this.joinAdditionalSourceCompilationThreads();
}

/**
 * Prepare the linker for the linking process by assembling the required linker flags
 */
public p ExternalLinkerInterface.prepare() {
    // Freestanding mode: no host crt files and no libc. Executables are linked statically, because there is no dynamic loader.
    // WebAssembly modules are always self-contained, so they need no '-static'
    const bool isFreestanding = this.cliOptions.freestanding;
    if isFreestanding {
        this.addLinkerFlag("-nostdlib");
    }

    // Static or shared linking
    if this.cliOptions.outputContainer == OutputContainer::SHARED_LIBRARY {
        this.addLinkerFlag("-shared");
    } else if isFreestanding && !this.isTargetWasm() {
        this.addLinkerFlag("-static");
    } else if this.cliOptions.staticLinking {
        // A static PIE on Linux, so that static executables get ASLR for their image as well. This needs all linked archives
        // to be position independent (see setup-deps.py and the release workflow for the archives of the compiler itself)
        const bool isExecutable = this.cliOptions.outputContainer == OutputContainer::EXECUTABLE;
        const bool staticPie = this.isTargetLinux() && isExecutable && this.cliOptions.isPositionIndependent();
        this.addLinkerFlag(staticPie ? "-static-pie" : "-static");
    }

    // Windows linkers stamp the link time into the PE header. Leave it out, so that the same input always links to the same
    // binary (reproducible builds, bootstrap fixed point)
    if this.isTargetWindows() {
        this.addLinkerFlag("-Wl,--no-insert-timestamp");
    }

    // Full RELRO on Linux: resolve all symbols at load time ('now') and remap the relocation sections, including the GOT, as
    // read-only afterwards ('relro'). This takes away the GOT overwrite primitive of memory corruption exploits. There is no
    // dynamic loader in freestanding mode, that could do this.
    if this.isTargetLinux() && !isFreestanding && (this.cliOptions.outputContainer == OutputContainer::EXECUTABLE || this.cliOptions.outputContainer == OutputContainer::SHARED_LIBRARY) {
        this.addLinkerFlag("-Wl,-z,relro");
        this.addLinkerFlag("-Wl,-z,now");
    }

    // A freestanding WebAssembly module is a library for its host, e.g. a browser, so it has no entry point. Clang would make
    // _initialize the entry point of a shared library, which comes from the libc of the WebAssembly toolchain
    if isFreestanding && this.isTargetWasm() {
        this.addLinkerFlag("-Wl,--no-entry");
    }

    // The following flags only make sense if we want to emit an executable
    if this.cliOptions.outputContainer != OutputContainer::EXECUTABLE {
        return;
    }

    // Position independent executable on Linux, if the code is generated position independent (see the 'PIE Level' module
    // flag). Request it explicitly either way, instead of relying on the default of the linker invoker, which differs between
    // distributions. Static executables are linked with '-static-pie' or '-static' above.
    if this.isTargetLinux() && !this.cliOptions.staticLinking && !isFreestanding {
        this.addLinkerFlag(this.cliOptions.isPositionIndependent() ? "-pie" : "-no-pie");
    }

    // Stripping symbols, on request only: the symbol table is what a run-time symbolizer such as the stack trace runtime
    // resolves addresses against, so a stripped executable prints nothing but addresses. Darwin is excluded, because its
    // linker has no equivalent of '-Wl,-s'.
    if this.cliOptions.stripSymbols && !this.isTargetDarwin() {
        this.addLinkerFlag("-Wl,-s");
    }

    // Sanitizers
    switch this.cliOptions.instrumentation.sanitizer {
        case Sanitizer::ADDRESS: {
            this.addLinkerFlag("-fsanitize=address");
        }
        case Sanitizer::THREAD: {
            this.addLinkerFlag("-fsanitize=thread");
        }
        case Sanitizer::MEMORY: {
            this.addLinkerFlag("-fsanitize=memory");
            this.requestLibMathLinkage();
        }
        case Sanitizer::TYPE: {
            this.addLinkerFlag("-fsanitize=type");
        }
    }

    // Code coverage
    if this.cliOptions.instrumentation.codeCoverage {
        this.addLinkerFlag("--coverage");
    }

    // A freestanding WebAssembly module exports all its symbols to its host. Hosted ones (e.g. for WASI) get their entry point
    // and exports from the libc of the WebAssembly toolchain
    if isFreestanding && this.isTargetWasm() {
        this.addLinkerFlag("-Wl,--export-all");
    }
}

/**
 * Run the linker or archiver, depending on the requested output container
 */
public p ExternalLinkerInterface.run() {
    switch this.cliOptions.outputContainer {
        case OutputContainer::EXECUTABLE, OutputContainer::SHARED_LIBRARY: {
            this.link();
        }
        case OutputContainer::STATIC_LIBRARY: {
            this.archive();
        }
        case OutputContainer::OBJECT_FILE: {
            // No linking necessary
        }
        default: {
            panic(Error("Unknown output container"));
        }
    }
}

/**
 * Cleanup intermediary object files
 */
public p ExternalLinkerInterface.cleanup() {
    // Wait for additional source compilations, that are still running (e.g. because the linker did not need them)
    this.joinAdditionalSourceCompilationThreads();

    // Cleanup intermediary object files
    if this.cliOptions.outputContainer == OutputContainer::OBJECT_FILE || this.cliOptions.dump.dumpToFiles {
        return;
    }
    foreach const AdditionalSourceCompilation& compilation : this.additionalSourceCompilations {
        if compilation.objectFilePath.exists() {
            const bool deleted = deleteFile(compilation.objectFilePath.toString());
            assert deleted;
        }
    }
    foreach const FilePath& path : this.emittedObjectFiles {
        const bool deleted = deleteFile(path.toString());
        assert deleted;
    }
}

/**
 * Link the object files to an executable or shared library
 */
p ExternalLinkerInterface.link() {
    assert !this.outputPath.isEmpty();

    // Find the linker invoker and linker
    const ExternalBinaryFinderResult linkerInvoker = findLinkerInvoker();
    const bool isGccInvoker = linkerInvoker.name == "gcc";
    const ExternalBinaryFinderResult linker = findLinker(this.cliOptions, isGccInvoker);
    const bool isClangInvoker = linkerInvoker.name == "clang";
    // GCC does not implement MemorySanitizer or TypeSanitizer
    const Sanitizer sanitizer = this.cliOptions.instrumentation.sanitizer;
    if !isClangInvoker && (sanitizer == Sanitizer::MEMORY || sanitizer == Sanitizer::TYPE) {
        const string msg = "Memory and type sanitizers require clang as the linker invoker, but 'gcc' was selected";
        const LinkerError error = LinkerError(LinkerErrorType::SANITIZER_NOT_SUPPORTED_BY_LINKER_INVOKER, msg);
        abortWithError(error.getMessage());
    }

    // Build the linker argument vector. Each entry is passed verbatim to the linker invoker (no shell), so file paths can
    // never be re-interpreted as shell syntax - this is what prevents command injection via attacker-controlled object-file
    // or output paths.
    Vector<String> args = this.getInvokerArgs(linker, isGccInvoker);
    // Append output path
    args.pushBack(String("-o"));
    args.pushBack(String(this.outputPath.toString()));
    // Append object files first, so that '-l' archive flags added below are searched for symbols that are already
    // undefined at the point they appear in the command. Additional sources are compiled to object files first, which
    // mostly happened in the background.
    this.joinAdditionalSourceCompilationThreads();
    foreach const FilePath& objectFilePath : this.linkedFiles {
        if this.isAdditionalSource(objectFilePath) {
            const FilePath compiledObjectFilePath = this.compileAdditionalSource(objectFilePath);
            args.pushBack(String(compiledObjectFilePath.toString()));
        } else {
            args.pushBack(String(objectFilePath.toString()));
        }
    }
    // Append the std's runtime library search path and the linker flags
    const Vector<String> trailingArgs = this.getTrailingArgs();
    foreach const String& trailingArg : trailingArgs {
        args.pushBack(trailingArg);
    }
    if this.linkLibMath {
        args.pushBack(String("-lm"));
    }
    // '-nostdlib' leaves out the builtins of the compiler runtime as well, so they are linked explicitly in freestanding mode,
    // if the linker invoker can find them. Otherwise, the user passes them via 'core.linker.flag'
    if this.cliOptions.freestanding {
        const String builtinsLibrary = this.findBuiltinsLibrary(linkerInvoker);
        if !builtinsLibrary.isEmpty() {
            args.pushBack(builtinsLibrary);
        }
    }
    // The linker script is passed verbatim, not as linker flag, so that its path is not expanded like the flags of the attributes
    if !this.cliOptions.linkerScript.isEmpty() {
        args.pushBack(String("-T"));
        args.pushBack(String(this.cliOptions.linkerScript.toString()));
    }

    // Print status message
    if this.cliOptions.printDebugOutput {
        const String command = renderCommandForDisplay(linkerInvoker.path, args);
        printf("\nLinking with: %s (invoker) / %s (linker)", linkerInvoker.name, linker.name);
        printf("\nLinker command: %s", command.getRaw());
        printf("\nEmitting executable to path: %s\n", this.outputPath.toString());
    }

    // Call the linker
    this.runTool(linkerInvoker.path, args, "Linker", "Linking");
}

/**
 * Get the leading arguments for the linker invoker, that select the linker and the target
 *
 * @param linker Linker
 * @param isGccInvoker Whether the linker invoker is GCC
 * @return Leading arguments
 */
f<Vector<String>> ExternalLinkerInterface.getInvokerArgs(const ExternalBinaryFinderResult& linker, bool isGccInvoker) {
    Vector<String> args;
    // GCC 16 dropped '-fuse-ld=ld'; skip when using GCC with the default BFD linker
    if !isGccInvoker || linker.name != "ld" {
        args.pushBack("-fuse-ld=" + linker.path);
    }
    // '--target=' is clang-only; GCC uses target-specific toolchain prefixes instead
    if !isGccInvoker {
        args.pushBack(String("--target=") + this.getInvokerTargetTriple());
    }
    return args;
}

/**
 * Get the target triple for the linker invoker. Clang only links for a target without OS itself, if the triple names an
 * environment (e.g. aarch64-none-elf or thumbv7em-none-eabihf). Otherwise, it hands the linking over to GCC, which cannot
 * link for other targets than the host. So ELF is requested explicitly for triples like x86_64-unknown-none. The emitted
 * code does not depend on it.
 *
 * @return Target triple for the linker invoker
 */
f<String> ExternalLinkerInterface.getInvokerTargetTriple() {
    const llvm::Triple& triple = this.cliOptions.targetTriple;
    if this.cliOptions.targetHasOs || this.isTargetWasm() {
        return String(triple.value);
    }
    const llvm::Triple normalizedTriple = triple.normalize();
    const Vector<String> fragments = split(String(normalizedTriple.value), '-');
    if fragments.getSize() != 3l {
        return String(triple.value);
    }
    return String(normalizedTriple.value) + "-elf";
}

/**
 * Find the builtins library of the compiler runtime for the target: compiler-rt for clang, libgcc for GCC. LLVM emits calls into
 * it for operations, that the target has no instructions for, e.g. __udivti3, __aeabi_* or soft-float arithmetic. The linker
 * invoker reports the path, where it would look for the library. It only exists, if the runtime was built for the target.
 *
 * @param linkerInvoker Linker invoker
 * @return Path of the builtins library or an empty string, if it does not exist for the target
 */
f<String> ExternalLinkerInterface.findBuiltinsLibrary(const ExternalBinaryFinderResult& linkerInvoker) {
    const Vector<String> args = this.getBuiltinsLibraryQueryArgs(linkerInvoker.name == "clang");
    const ExecResult queryResult = exec(linkerInvoker.path, args);
    if queryResult.exitCode != 0 {
        return String();
    }
    const String path = queryResult.output.trim();
    if path.isEmpty() || !fileExists(path.getRaw()) {
        return String();
    }
    return path;
}

/**
 * Get the arguments for the linker invoker to print the path of the builtins library of the compiler runtime for the target
 *
 * @param isClangInvoker Whether the linker invoker is clang
 * @return Query arguments
 */
f<Vector<String>> ExternalLinkerInterface.getBuiltinsLibraryQueryArgs(bool isClangInvoker) {
    Vector<String> args;
    // GCC prints its libgcc. It has no '--target=' option and only links for the host anyway
    if isClangInvoker {
        args.pushBack(String("--target=") + this.getInvokerTargetTriple());
        args.pushBack(String("--rtlib=compiler-rt"));
    }
    args.pushBack(String("-print-libgcc-file-name"));
    return args;
}

/**
 * Get the trailing arguments for the linker invoker: the library search path of the std and the expanded linker flags
 *
 * @return Trailing arguments
 */
f<Vector<String>> ExternalLinkerInterface.getTrailingArgs() {
    Vector<String> args;
    // Append the std's own library search path, so the runtime modules can link against the static support libraries that
    // ship with the std (currently std/runtime/lib/libbacktrace.a). It goes ahead of the linker flags below, because search
    // directories are tried in the order given. Passed verbatim rather than through expandLinkerFlag(), so that a std path
    // containing '$' or a backtick is not mistaken for a variable reference or a command substitution. Only for a native
    // build: those archives are built for the machine the std was installed on, so offering them while linking for another
    // target can only ever produce a mismatch.
    if this.cliOptions.isNativeTarget {
        const FilePath stdRuntimeLibDir = getStdRuntimeLibDir();
        if !stdRuntimeLibDir.isEmpty() {
            args.pushBack(String("-L") + stdRuntimeLibDir.toString());
        }
    }
    // Append linker flags, expanding any environment-variable references or backtick command substitutions they may
    // contain (e.g. std bindings using "-L$LLVM_LIB_DIR" or "`pkg-config --cflags --libs libcurl`"); a single flag can
    // expand into several argv entries. They go behind the object files (libraries must follow the objects that reference
    // them). A static link gets the static flags from pkg-config.
    foreach const String& linkerFlag : this.linkerFlags {
        if !this.expandedLinkerFlags.contains(linkerFlag) {
            this.expandedLinkerFlags.upsert(linkerFlag, expandLinkerFlag(linkerFlag, this.cliOptions.staticLinking));
        }
        const Vector<String>& expandedFlags = this.expandedLinkerFlags.get(linkerFlag);
        foreach const String& expandedFlag : expandedFlags {
            args.pushBack(expandedFlag);
        }
    }

    return args;
}

/**
 * Get the arguments for the linker invoker to compile an additional source to an object file. These are the arguments, that
 * the linker invoker would use to compile the additional source as part of the link command, without the ones that only
 * affect linking.
 *
 * @param additionalSource Additional source file
 * @param objectFilePath Path of the object file to emit
 * @return Compile arguments
 */
f<Vector<String>> ExternalLinkerInterface.getAdditionalSourceCompileArgs(const FilePath& additionalSource, const FilePath& objectFilePath) {
    const ExternalBinaryFinderResult linkerInvoker = findLinkerInvoker();
    const bool isGccInvoker = linkerInvoker.name == "gcc";
    const ExternalBinaryFinderResult linker = findLinker(this.cliOptions, isGccInvoker);
    Vector<String> args;
    appendCompileArgs(args, this.getInvokerArgs(linker, isGccInvoker));
    // Position independent code on Linux, because the object file is linked into a PIE or a shared library
    if this.isTargetLinux() {
        args.pushBack(String("-fPIC"));
    }
    args.pushBack(String("-c"));
    args.pushBack(String("-o"));
    args.pushBack(String(objectFilePath.toString()));
    args.pushBack(String(additionalSource.toString()));
    appendCompileArgs(args, this.getTrailingArgs());
    return args;
}

/**
 * Append the given linker invoker arguments to the compile arguments of an additional source, except the ones that only
 * affect linking. The linker invoker ignores those when compiling with '-c', but warns about each of them. Arguments, that
 * affect compiling as well (e.g. '-I', '-D', '-pthread', '-fsanitize=...' or '--coverage'), are kept.
 *
 * @param compileArgs Compile arguments to append to
 * @param invokerArgs Linker invoker arguments
 */
p appendCompileArgs(Vector<String>& compileArgs, const Vector<String>& invokerArgs) {
    bool skipNext = false;
    foreach const String& arg : invokerArgs {
        if skipNext {
            skipNext = false;
            continue;
        }
        // '-Xlinker' passes the next argument on to the linker
        if arg == "-Xlinker" {
            skipNext = true;
            continue;
        }
        if !isLinkOnlyArg(arg) {
            compileArgs.pushBack(arg);
        }
    }
}

/**
 * Check if the given linker invoker argument only affects linking
 *
 * @param arg Linker invoker argument
 * @return Link only or not
 */
f<bool> isLinkOnlyArg(const String& arg) {
    // Linker inputs, like archives, shared libraries or object files
    if !arg.startsWith("-") {
        return true;
    }
    // Libraries, library search paths, linker options and the linker selection
    if arg.startsWith("-l") || arg.startsWith("-L") || arg.startsWith("-Wl,") || arg.startsWith("-fuse-ld=") {
        return true;
    }
    const string[7] linkOnlyFlags = ["-shared", "-static", "-static-pie", "-pie", "-no-pie", "-rdynamic", "-nostdlib"];
    for unsigned int i = 0; i < len(linkOnlyFlags); i++ {
        if arg == linkOnlyFlags[i] {
            return true;
        }
    }
    return false;
}

/**
 * Get the path of the object file, an additional source is compiled to
 *
 * @param additionalSource Additional source file
 * @return Object file path
 */
f<FilePath> ExternalLinkerInterface.getAdditionalSourceObjectFilePath(const FilePath& additionalSource) {
    // Additional sources with the same file name may come from different directories, so add the index of the source
    unsigned long index = 0l;
    while index < this.additionalSourcePaths.getSize() && this.additionalSourcePaths.get(index) != additionalSource {
        index++;
    }
    const string objFileExt = getOutputFileExtension(this.cliOptions, OutputContainer::OBJECT_FILE);
    const String fileName = additionalSource.getFileName() + "." + toString(index) + "." + objFileExt;
    return this.cliOptions.outputDir / fileName;
}

/**
 * Check if the given linked file is an additional source
 *
 * @param path Path of the linked file
 * @return Additional source or not
 */
f<bool> ExternalLinkerInterface.isAdditionalSource(const FilePath& path) {
    foreach const FilePath& additionalSource : this.additionalSourcePaths {
        if additionalSource == path {
            return true;
        }
    }
    return false;
}

/**
 * Start compiling the additional sources to object files in the background, so that this overlaps with the back end. The
 * linker waits for the results and only compiles an additional source again, if its compile arguments changed in the
 * meantime.
 */
public p ExternalLinkerInterface.startAdditionalSourceCompilation() {
    if this.cliOptions.outputContainer != OutputContainer::EXECUTABLE && this.cliOptions.outputContainer != OutputContainer::SHARED_LIBRARY {
        return;
    }
    if !this.additionalSourceCompilations.isEmpty() {
        return;
    }

    const ExternalBinaryFinderResult linkerInvoker = findLinkerInvoker();
    foreach const FilePath& additionalSource : this.additionalSourcePaths {
        AdditionalSourceCompilation compilation;
        compilation.additionalSource = additionalSource;
        compilation.linkerInvokerPath = linkerInvoker.path;
        compilation.objectFilePath = this.getAdditionalSourceObjectFilePath(additionalSource);
        compilation.args = this.getAdditionalSourceCompileArgs(additionalSource, compilation.objectFilePath);
        this.additionalSourceCompilations.pushBack(compilation);
    }

    // Start the threads only after all compilations were added, so that no compilation is relocated while a thread works on it
    this.additionalSourceCompilationThreads.reserve(this.additionalSourceCompilations.getSize());
    for unsigned long i = 0l; i < this.additionalSourceCompilations.getSize(); i++ {
        AdditionalSourceCompilation* compilation = &this.additionalSourceCompilations.get(i);
        this.additionalSourceCompilationThreads.pushBack(Thread(p() [[async]] {
            compilation.result = exec(compilation.linkerInvokerPath, compilation.args, true);
        }));
        Thread& thread = this.additionalSourceCompilationThreads.back();
        thread.run();
    }
}

/**
 * Wait for the additional source compilations, that run in the background
 */
p ExternalLinkerInterface.joinAdditionalSourceCompilationThreads() {
    foreach Thread& thread : this.additionalSourceCompilationThreads {
        thread.join();
    }
    this.additionalSourceCompilationThreads.clear();
}

/**
 * Compile an additional source to an object file or take the result of the compilation, that ran in the background
 *
 * @param additionalSource Additional source file
 * @return Object file path
 */
f<FilePath> ExternalLinkerInterface.compileAdditionalSource(const FilePath& additionalSource) {
    const FilePath objectFilePath = this.getAdditionalSourceObjectFilePath(additionalSource);
    const Vector<String> args = this.getAdditionalSourceCompileArgs(additionalSource, objectFilePath);

    // Compile it now, if it was not compiled in the background or with different arguments
    AdditionalSourceCompilation* compilation = nil<AdditionalSourceCompilation*>;
    foreach AdditionalSourceCompilation& existingCompilation : this.additionalSourceCompilations {
        if existingCompilation.additionalSource == additionalSource {
            compilation = &existingCompilation;
            break;
        }
    }
    if compilation == nil<AdditionalSourceCompilation*> || !areArgsEqual(compilation.args, args) {
        if compilation == nil<AdditionalSourceCompilation*> {
            AdditionalSourceCompilation newCompilation;
            newCompilation.additionalSource = additionalSource;
            this.additionalSourceCompilations.pushBack(newCompilation);
            compilation = &this.additionalSourceCompilations.back();
        }
        const ExternalBinaryFinderResult linkerInvoker = findLinkerInvoker();
        // Assign via a reference: fields reached via a pointer might be uninitialized memory, so the compiler does not
        // destruct their old values on assignment. The result of a background compilation would leak then
        AdditionalSourceCompilation& recompilation = *compilation;
        recompilation.linkerInvokerPath = linkerInvoker.path;
        recompilation.objectFilePath = objectFilePath;
        recompilation.args = args;
        recompilation.result = exec(recompilation.linkerInvokerPath, recompilation.args, true);
    }

    // Check for compile error
    if compilation.result.exitCode != 0 {
        const String command = renderCommandForDisplay(compilation.linkerInvokerPath, compilation.args);
        const String msg = "Compiling the additional source '" + additionalSource.toString() + "' failed\nCompile command: " + command + "\n" + compilation.result.output;
        const LinkerError error = LinkerError(LinkerErrorType::LINKER_ERROR, msg.getRaw());
        abortWithError(error.getMessage());
    }
    return objectFilePath;
}

/**
 * Check if two argument lists are equal. The equality operator of Vector compares the raw bytes of the items, which does not
 * work for Strings.
 *
 * @param lhs First argument list
 * @param rhs Second argument list
 * @return Equal or not
 */
f<bool> areArgsEqual(const Vector<String>& lhs, const Vector<String>& rhs) {
    if lhs.getSize() != rhs.getSize() {
        return false;
    }
    for unsigned long i = 0l; i < lhs.getSize(); i++ {
        const String& lhsArg = lhs.get(i);
        const String& rhsArg = rhs.get(i);
        if lhsArg != rhsArg {
            return false;
        }
    }
    return true;
}

/**
 * Archive the object files to a static library
 */
p ExternalLinkerInterface.archive() {
    assert !this.outputPath.isEmpty();

    // Find the archiver
    const ExternalBinaryFinderResult archiver = findArchiver();

    // Build the archiver argument vector (passed verbatim, no shell involved)
    Vector<String> args;
    if archiver.name == "llvm-lib" || archiver.name == "lib" {
        // The archivers on Windows only understand the MSVC syntax
        args.pushBack(String("/OUT:") + this.outputPath.toString());
    } else {
        args.pushBack(String("rcs")); // r = insert files into archive; c = create archive if not existing; s = create archive index
        args.pushBack(String(this.outputPath.toString()));
    }
    foreach const FilePath& path : this.linkedFiles {
        args.pushBack(String(path.toString()));
    }

    // Print status message
    if this.cliOptions.printDebugOutput {
        const String command = renderCommandForDisplay(archiver.path, args);
        printf("\nArchiving with: %s", archiver.name);
        printf("\nArchiver command: %s", command.getRaw());
        printf("\nEmitting static library to path: %s\n", this.outputPath.toString());
    }

    // Call the archiver
    this.runTool(archiver.path, args, "Archiver", "Archiving");
}

/**
 * Run the linker invoker or the archiver and abort with a linker error, if it fails
 *
 * @param toolPath Path to the tool
 * @param args Arguments for the tool
 * @param toolName Name of the tool for the error message, e.g. "Linker"
 * @param activityName Name of the activity for the debug output, e.g. "Linking"
 */
p ExternalLinkerInterface.runTool(const String& toolPath, const Vector<String>& args, string toolName, string activityName) {
    // While the progress bar is shown, also capture the stderr of the tool, so that it does not end up behind the bar. It is
    // printed after removing the bar, if the tool fails
    const bool captureStdErr = isCompileProgressActive();
    const ExecResult result = exec(toolPath, args, captureStdErr);

    // Check for error
    if result.exitCode != 0 {
        if captureStdErr {
            printAboveActiveCompileProgress(result.output);
        }
        const String command = renderCommandForDisplay(toolPath, args);
        const String msg = String(toolName) + " exited with non-zero exit code\n" + toolName + " command: " + command;
        const LinkerError error = LinkerError(LinkerErrorType::LINKER_ERROR, msg.getRaw());
        abortWithError(error.getMessage());
    }

    // The captured output of a successful run (e.g. linker warnings) would be lost otherwise
    if captureStdErr && !result.output.isEmpty() {
        printAboveActiveCompileProgress(result.output);
    }

    // Print the result if appropriate
    if this.cliOptions.printDebugOutput && !result.output.isEmpty() {
        printf("%s result: %s\n\n", activityName, result.output.getRaw());
    }
}

/**
 * Add another object file to be linked when calling 'run()'
 *
 * @param path Path to the object file
 */
public p ExternalLinkerInterface.addFileToLinkage(const FilePath& path) {
    // Skip files that are already registered
    foreach const FilePath& linkedFile : this.linkedFiles {
        if linkedFile == path {
            return;
        }
    }
    this.linkedFiles.pushBack(path);
}

/**
 * Add an object file, that the compiler emitted itself, to be linked when calling 'run()'. Unlike other linked files, it is
 * intermediary and gets deleted on cleanup.
 *
 * @param path Path to the emitted object file
 */
public p ExternalLinkerInterface.addEmittedObjectFile(const FilePath& path) {
    this.addFileToLinkage(path);
    // Source files with the same file name emit to the same object file path, which must only be deleted once
    foreach const FilePath& emittedObjectFile : this.emittedObjectFiles {
        if emittedObjectFile == path {
            return;
        }
    }
    this.emittedObjectFiles.pushBack(path);
}

/**
 * Add another linker flag for the call to the linker executable
 *
 * @param linkerFlag Linker flag
 */
public p ExternalLinkerInterface.addLinkerFlag(string linkerFlag) {
    this.addLinkerFlag(String(linkerFlag));
}

/**
 * Add another linker flag for the call to the linker executable
 *
 * @param linkerFlag Linker flag
 */
public p ExternalLinkerInterface.addLinkerFlag(const String& linkerFlag) {
    // Group boundary markers must not be deduplicated: each archive group gets its own pair, and deduplication would
    // collapse multiple groups into one misplaced pair.
    if linkerFlag != "-Wl,--start-group" && linkerFlag != "-Wl,--end-group" {
        foreach const String& existingFlag : this.linkerFlags {
            if existingFlag == linkerFlag {
                return;
            }
        }
    }
    this.linkerFlags.pushBack(linkerFlag);
}

/**
 * Add another source file to compile and link in (C or C++)
 *
 * @param additionalSource Additional source file
 */
public p ExternalLinkerInterface.addAdditionalSourcePath(const FilePath& additionalSource) {
    // Check if the file exists
    if !additionalSource.exists() {
        const String msg = "The additional source file '" + additionalSource.toGenericString() + "' does not exist";
        const CompilerError error = CompilerError(CompilerErrorType::IO_ERROR, msg.getRaw());
        abortWithError(error.getMessage());
    }

    // Add the file to the linker
    const FilePath canonicalAdditionalSource = additionalSource.canonical();
    this.addFileToLinkage(canonicalAdditionalSource);
    if !this.isAdditionalSource(canonicalAdditionalSource) {
        this.additionalSourcePaths.pushBack(canonicalAdditionalSource);
    }
}

/**
 * Link against libmath a.k.a. -lm
 */
public p ExternalLinkerInterface.requestLibMathLinkage() {
    LockGuard _ = LockGuard(this.linkLibMathMutex);
    this.linkLibMath = true;
}

/**
 * Check if the configured target is a WebAssembly target
 *
 * @return Whether the target is WebAssembly
 */
f<bool> ExternalLinkerInterface.isTargetWasm() {
    return this.cliOptions.targetTriple.isWasm();
}

/**
 * Check if the configured target is a Linux based target
 *
 * @return Whether the target is Linux based
 */
f<bool> ExternalLinkerInterface.isTargetLinux() {
    return this.cliOptions.targetTriple.isOSLinux();
}

/**
 * Check if the configured target is a Darwin (macOS) based target
 *
 * @return Whether the target is Darwin based
 */
f<bool> ExternalLinkerInterface.isTargetDarwin() {    // LCOV_EXCL_LINE - coverage runs on x86_64
    return this.cliOptions.targetTriple.isOSDarwin(); // LCOV_EXCL_LINE - coverage runs on x86_64
}                                                     // LCOV_EXCL_LINE - coverage runs on x86_64

/**
 * Check if the configured target is a Windows based target
 *
 * @return Whether the target is Windows based
 */
f<bool> ExternalLinkerInterface.isTargetWindows() {
    return this.cliOptions.targetTriple.isOSWindows();
}

#[test]
f<bool> testAppendCompileArgs() {
    Vector<String> invokerArgs;
    // Kept, because they affect compiling
    invokerArgs.pushBack(String("--target=x86_64-unknown-linux-gnu"));
    invokerArgs.pushBack(String("-I/opt/llvm/include"));
    invokerArgs.pushBack(String("-DNDEBUG"));
    invokerArgs.pushBack(String("-pthread"));
    invokerArgs.pushBack(String("-fsanitize=address"));
    invokerArgs.pushBack(String("--coverage"));
    // Left out, because they only affect linking
    invokerArgs.pushBack(String("-fuse-ld=/usr/bin/ld.lld"));
    invokerArgs.pushBack(String("-L/opt/llvm/lib"));
    invokerArgs.pushBack(String("-lLLVMCore"));
    invokerArgs.pushBack(String("-Wl,--start-group"));
    invokerArgs.pushBack(String("/opt/tpde/lib/libtpde.a"));
    invokerArgs.pushBack(String("-Xlinker"));
    invokerArgs.pushBack(String("--no-undefined"));
    invokerArgs.pushBack(String("-pie"));
    invokerArgs.pushBack(String("-static-pie"));
    invokerArgs.pushBack(String("-shared"));

    Vector<String> compileArgs;
    compileArgs.pushBack(String("-c"));
    appendCompileArgs(compileArgs, invokerArgs);
    assert compileArgs.getSize() == 7l;
    assert compileArgs.get(0l) == "-c";
    assert compileArgs.get(1l) == "--target=x86_64-unknown-linux-gnu";
    assert compileArgs.get(2l) == "-I/opt/llvm/include";
    assert compileArgs.get(3l) == "-DNDEBUG";
    assert compileArgs.get(4l) == "-pthread";
    assert compileArgs.get(5l) == "-fsanitize=address";
    assert compileArgs.get(6l) == "--coverage";
    return true;
}

// Whether the linker flags of the given linker contain the given flag
f<bool> hasLinkerFlag(const ExternalLinkerInterface& linker, string flag) {
    foreach const String& linkerFlag : linker.linkerFlags {
        if linkerFlag == flag {
            return true;
        }
    }
    return false;
}

#[test]
f<bool> testFreestandingLinkerSetup() {
    // A hosted Linux executable is a PIE with full RELRO
    CliOptions hostedOptions;
    hostedOptions.targetTriple = llvm::Triple("x86_64-unknown-linux-gnu");
    hostedOptions.relocModel = RelocModel::PIE;
    ExternalLinkerInterface hostedLinker = ExternalLinkerInterface(hostedOptions);
    hostedLinker.prepare();
    assert !hasLinkerFlag(hostedLinker, "-nostdlib");
    assert hasLinkerFlag(hostedLinker, "-pie");
    assert hasLinkerFlag(hostedLinker, "-Wl,-z,relro");
    assert hostedLinker.getInvokerTargetTriple() == "x86_64-unknown-linux-gnu";

    // A freestanding executable has neither libc, nor a dynamic loader
    CliOptions freestandingOptions;
    freestandingOptions.targetTriple = llvm::Triple("x86_64-unknown-linux-gnu");
    freestandingOptions.freestanding = true;
    freestandingOptions.relocModel = RelocModel::STATIC;
    ExternalLinkerInterface freestandingLinker = ExternalLinkerInterface(freestandingOptions);
    freestandingLinker.prepare();
    assert hasLinkerFlag(freestandingLinker, "-nostdlib");
    assert hasLinkerFlag(freestandingLinker, "-static");
    assert !hasLinkerFlag(freestandingLinker, "-pie");
    assert !hasLinkerFlag(freestandingLinker, "-no-pie");
    assert !hasLinkerFlag(freestandingLinker, "-Wl,-z,relro");
    assert !hasLinkerFlag(freestandingLinker, "-Wl,-z,now");
    assert freestandingLinker.getInvokerTargetTriple() == "x86_64-unknown-linux-gnu";

    // Clang only links for a target without OS itself, if the triple names an environment
    CliOptions bareMetalOptions;
    bareMetalOptions.freestanding = true;
    bareMetalOptions.targetHasOs = false;
    bareMetalOptions.targetTriple = llvm::Triple("x86_64-unknown-none");
    ExternalLinkerInterface bareMetalLinker = ExternalLinkerInterface(bareMetalOptions);
    assert bareMetalLinker.getInvokerTargetTriple() == "x86_64-unknown-none-elf";
    bareMetalOptions.targetTriple = llvm::Triple("aarch64-none-elf");
    assert bareMetalLinker.getInvokerTargetTriple() == "aarch64-none-elf";
    bareMetalOptions.targetTriple = llvm::Triple("thumbv7em-none-eabihf");
    assert bareMetalLinker.getInvokerTargetTriple() == "thumbv7em-none-eabihf";
    // Wasm is never ELF
    bareMetalOptions.targetTriple = llvm::Triple("wasm32-unknown-unknown");
    assert bareMetalLinker.getInvokerTargetTriple() == "wasm32-unknown-unknown";
    return true;
}

#[test]
f<bool> testWasmLinkerSetup() {
    // A freestanding WebAssembly module has no entry point and exports all symbols. It is self-contained without '-static'
    CliOptions freestandingOptions;
    freestandingOptions.freestanding = true;
    freestandingOptions.targetHasOs = false;
    freestandingOptions.targetTriple = llvm::Triple("wasm32-unknown-unknown");
    ExternalLinkerInterface freestandingLinker = ExternalLinkerInterface(freestandingOptions);
    freestandingLinker.prepare();
    assert hasLinkerFlag(freestandingLinker, "-nostdlib");
    assert hasLinkerFlag(freestandingLinker, "-Wl,--no-entry");
    assert hasLinkerFlag(freestandingLinker, "-Wl,--export-all");
    assert !hasLinkerFlag(freestandingLinker, "-static");
    assert freestandingLinker.getInvokerTargetTriple() == "wasm32-unknown-unknown";

    // A freestanding WebAssembly shared library has no entry point either, but only exports its public symbols
    CliOptions libraryOptions;
    libraryOptions.freestanding = true;
    libraryOptions.targetHasOs = false;
    libraryOptions.targetTriple = llvm::Triple("wasm32-unknown-unknown");
    libraryOptions.outputContainer = OutputContainer::SHARED_LIBRARY;
    ExternalLinkerInterface libraryLinker = ExternalLinkerInterface(libraryOptions);
    libraryLinker.prepare();
    assert hasLinkerFlag(libraryLinker, "-nostdlib");
    assert hasLinkerFlag(libraryLinker, "-shared");
    assert hasLinkerFlag(libraryLinker, "-Wl,--no-entry");
    assert !hasLinkerFlag(libraryLinker, "-Wl,--export-all");

    // A hosted WebAssembly module (e.g. for WASI) is linked against the libc of the WebAssembly toolchain
    CliOptions hostedOptions;
    hostedOptions.targetTriple = llvm::Triple("wasm32-unknown-wasi");
    ExternalLinkerInterface hostedLinker = ExternalLinkerInterface(hostedOptions);
    hostedLinker.prepare();
    assert !hasLinkerFlag(hostedLinker, "-nostdlib");
    assert !hasLinkerFlag(hostedLinker, "-Wl,--no-entry");
    assert !hasLinkerFlag(hostedLinker, "-Wl,--export-all");
    return true;
}

#[test]
f<bool> testBuiltinsLibraryQueryArgs() {
    CliOptions options;
    options.freestanding = true;
    options.targetHasOs = false;
    options.targetTriple = llvm::Triple("aarch64-none-elf");
    ExternalLinkerInterface linker = ExternalLinkerInterface(options);
    // Clang reports the compiler-rt builtins for the target
    const Vector<String> clangArgs = linker.getBuiltinsLibraryQueryArgs(true);
    assert clangArgs.getSize() == 3l;
    assert clangArgs.get(0l) == "--target=aarch64-none-elf";
    assert clangArgs.get(1l) == "--rtlib=compiler-rt";
    assert clangArgs.get(2l) == "-print-libgcc-file-name";
    // The same target triple as for linking, so x86_64-unknown-none gets the bare-metal toolchain of clang as well
    options.targetTriple = llvm::Triple("x86_64-unknown-none");
    const Vector<String> bareMetalArgs = linker.getBuiltinsLibraryQueryArgs(true);
    assert bareMetalArgs.get(0l) == "--target=x86_64-unknown-none-elf";
    // GCC reports its libgcc for the host
    const Vector<String> gccArgs = linker.getBuiltinsLibraryQueryArgs(false);
    assert gccArgs.getSize() == 1l;
    assert gccArgs.get(0l) == "-print-libgcc-file-name";
    return true;
}
