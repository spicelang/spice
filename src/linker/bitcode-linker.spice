// Std imports
import "std/data/pair";
import "std/bindings/llvm/llvm" as llvm;

// Own imports
import "bootstrap/compiler-pass";
import "bootstrap/source-file";
import "bootstrap/global/global-resource-manager";

/**
 * Links the modules of all source files into the LTO module
 */
public type BitcodeLinker struct {
    compose public CompilerPass compilerPass
}

public p BitcodeLinker.ctor(GlobalResourceManager& resourceManager) {
    this.compilerPass = CompilerPass(resourceManager);
}

public p BitcodeLinker.link() {
    // Link all source file modules in. Use the creation order, because the order of the source file map depends on the hash
    // function, and the link order shows in the LTO module
    foreach SourceFile* sourceFile : this.resourceManager.sourceFilesInCreationOrder {
        const bool failed = this.resourceManager.ltoModule.linkInModule(sourceFile.llvmModule);
        assert !failed;
    }
}
