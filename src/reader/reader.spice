// Std imports
import "std/io/filepath";
import "std/io/file";

// Own imports
import "bootstrap/exception/compiler-error";
import "bootstrap/exception/fatal-error";
import "bootstrap/reader/code-loc";
import "bootstrap/util/test-util";

public type Reader struct {
    File file
    FilePath filePath
    char curChar = '\0'
    CodeLoc curCodeLoc
    String sourceCode // All chars, that were read so far
    unsigned long curOffset = 0l // Offset of the current char within the source code
    // One char lookahead buffer, filled by peekChar()
    char peekedChar = '\0'
    bool hasPeekedChar = false
}

public p Reader.ctor(const FilePath& inputPath) {
    this.filePath = inputPath;
    this.curCodeLoc = CodeLoc(1l, 0l, inputPath.toString());

    // Open the file input stream
    Result<File> result = openFile(inputPath.toString(), MODE_READ);
    if !result.isOk() {
        const String messageSuffix = "Source file at path '" + inputPath.toString() + "' cannot be opened.";
        const CompilerError error = CompilerError(CompilerErrorType::IO_ERROR, messageSuffix.getRaw());
        abortWithError(error.getMessage());
    }
    this.file = result.unwrap();

    // Read the first character
    this.advance();
}

/**
 * Get the previously read character
 *
 * @return char Last character
 */
public inline f<char> Reader.getChar() {
    return this.curChar;
}

/**
 * Get the code location of the previously read character
 *
 * @return CodeLoc Code location
 */
public inline f<CodeLoc&> Reader.getCodeLoc() {
    return this.curCodeLoc;
}

/**
 * Peek the character after the previously read character without consuming it
 *
 * @return char Next character
 */
public f<char> Reader.peekChar() {
    if !this.hasPeekedChar {
        if this.file.isEOF() {
            return '\0';
        }
        this.peekedChar = this.file.readChar();
        this.hasPeekedChar = true;
    }
    return this.peekedChar;
}

/**
 * Advance the reader by one character
 */
public p Reader.advance() {
    assert !this.isEOF();
    if this.hasPeekedChar {
        this.curChar = this.peekedChar;
        this.hasPeekedChar = false;
    } else {
        this.curChar = this.file.readChar();
    }
    // Keep track of the source code, so that parts of it can be retrieved later on
    this.curOffset = this.sourceCode.getLength();
    if !this.isEOF() {
        this.sourceCode += this.curChar;
    }
    if this.curChar == '\n' {
        this.curCodeLoc.line++;
        this.curCodeLoc.col = 0l;
    } else if !this.isUtf8ContinuationByte(this.curChar) {
        // Count code points instead of bytes
        this.curCodeLoc.col++;
    }
}

/**
 * Check if the given char is a continuation byte of a multibyte UTF-8 sequence (0b10xxxxxx)
 *
 * @param c Char to check
 * @return Continuation byte or not
 */
inline f<bool> Reader.isUtf8ContinuationByte(char c) {
    const int byteValue = cast<int>(cast<byte>(c));
    return (byteValue & 0xC0) == 0x80;
}

/**
 * Get the offset of the current char within the source code
 *
 * @return Offset in bytes
 */
public inline f<unsigned long> Reader.getOffset() {
    return this.curOffset;
}

/**
 * Get a part of the source code, that was read so far
 *
 * @param startOffset Offset of the first char
 * @param endOffset Offset after the last char
 * @return Source code snippet
 */
public f<String> Reader.getSourceCode(unsigned long startOffset, unsigned long endOffset) {
    assert startOffset <= endOffset;
    return this.sourceCode.getSubstring(startOffset, cast<long>(endOffset - startOffset));
}

/**
 * Advance the reader by one character and check if this char equals the expected.
 *
 * @param c Expected char
 */
public inline p Reader.expect(char c) {
    assert this.curChar == c;
    this.advance();
}

/**
 * Check if we are at the end of the input file
 *
 * @return At the end or not
 */
public inline f<bool> Reader.isEOF() {
    // If a char was peeked, the current char is no EOF, even if the file reached its end while peeking
    if this.hasPeekedChar {
        return false;
    }
    return this.file.isEOF();
}
// ─── tests ────────────────────────────────────────────────────────────────────

#[test]
f<bool> testReaderReadsFileContent() {
    const FilePath testDir = makeUniqueTestDir("spice-reader-test");
    const FilePath testFilePath = testDir / "file.txt";
    const string expectedContent = "This is some test content\nLine 2\n\nLine 4";
    writeTestFile(testFilePath, expectedContent);

    // Read the whole file
    Reader reader = Reader(testFilePath);
    while !reader.isEOF() {
        reader.advance();
    }
    const String content = reader.getSourceCode(0l, getRawLength(expectedContent));
    const CodeLoc& endCodeLoc = reader.getCodeLoc();
    const unsigned long endLine = endCodeLoc.line;

    // Peek a char without consuming it
    Reader peekingReader = Reader(testFilePath);
    const char firstChar = peekingReader.getChar();
    const char peekedChar = peekingReader.peekChar();
    const char charAfterPeek = peekingReader.getChar();
    peekingReader.advance();
    const char secondChar = peekingReader.getChar();
    const CodeLoc& secondCodeLoc = peekingReader.getCodeLoc();
    const unsigned long secondLine = secondCodeLoc.line;
    const unsigned long secondCol = secondCodeLoc.col;

    // Clean up before asserting, so that a failure does not leave the file behind
    removeTestDir(testDir);
    assert content == expectedContent;
    assert endLine == 4l;
    assert firstChar == 'T';
    assert peekedChar == 'h';
    assert charAfterPeek == 'T';
    assert secondChar == 'h';
    assert secondLine == 1l;
    assert secondCol == 2l;
    return true;
}
