/media/test-project/*
!/media/test-project/*.*
/media/test-project/*.exe

# LLVM
/llvm

# Vendored libbacktrace: its out-of-tree build dir, and the archive and license setup-deps.py puts in the std tree
/deps/libbacktrace-build
/std/runtime/lib
/std/runtime/LICENSES

# Vendored TPDE: its out-of-tree build dir, and the libraries, headers and licenses setup-deps.py --tpde puts in the std tree
/deps/tpde-build
/std/bindings/tpde/lib
/std/bindings/tpde/include
/std/bindings/tpde/LICENSES

# FASTBuild
*.fdb

