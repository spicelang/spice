# Build output
/build
/coverage
/cmake-*
spice.exe
spice

# Release workflow staging dirs (downloaded compiler binaries, Docker build context libs)
/bin
/docker-libs

# CLion
/.idea

# Spice build outputs
/media/test-project/*
!/media/test-project/*.*
/media/test-project/*.exe

# LLVM
/llvm

# Vendored libbacktrace: the archive and license setup-deps.py puts in the std tree. Its build dir (deps/libbacktrace/build)
# is excluded in the submodule
/std/runtime/lib
/std/runtime/LICENSES

# Vendored TPDE: the libraries, headers and licenses setup-deps.py --tpde puts in the std tree. Its build dir (deps/tpde/build)
# is ignored by the submodule
/std/bindings/tpde/lib
/std/bindings/tpde/include
/std/bindings/tpde/LICENSES

# Zensical
docs/site

# Auto-generated std library reference (produced by tools/generate_std_docs.py)
docs/docs/std

# Python bytecode
__pycache__/

# Packages of the compiler sources, that Spice Shaker installs from src/spice.lock
/src/spice_packages/
